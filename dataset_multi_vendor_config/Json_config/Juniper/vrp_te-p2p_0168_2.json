    "set tunnels mpls traffic-eng tunnel tun200 interface ge-0/0/0.0 bandwidth 100000 priority 77 explicit-name PATH1": {
        "template": "set tunnels mpls traffic-eng tunnel [parameter1] interface [parameter2] bandwidth [parameter3] priority [parameter4] explicit-name [parameter5]",
        "command": "set tunnels mpls traffic-eng tunnel tun200 interface ge-0/0/0.0 bandwidth 100000 priority 77 explicit-name PATH1",
        "explanation": "配置MPLS流量工程隧道的参数。",
        "parameters": [
            {
                "name": "tunnel-name",
                "type": "string",
                "explanation": "隧道的名称。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "隧道使用的接口。"
            },
            {
                "name": "bandwidth",
                "type": "integer",
                "explanation": "隧道的带宽，单位是kbps。"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "隧道的优先级。"
            },
            {
                "name": "explicit-name",
                "type": "string",
                "explanation": "隧道的显式路径名称。"
            }
        ]
    },
