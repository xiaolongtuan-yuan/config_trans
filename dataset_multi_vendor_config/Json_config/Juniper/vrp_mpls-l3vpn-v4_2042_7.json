{
    "set system host-name CE4": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE4",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 family inet address 172.16.2.1/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-0/0/0 unit 0 family inet address 172.16.2.1/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set protocols bgp group external-peers type external": {
        "template": "set protocols bgp group [parameter1] type [parameter2]",
        "command": "set protocols bgp group external-peers type external",
        "explanation": "配置BGP组的类型为外部。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "BGP组的类型，例如external。"
            }
        ]
    },
    "set protocols bgp group external-peers peer-as 100": {
        "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
        "command": "set protocols bgp group external-peers peer-as 100",
        "explanation": "配置BGP组的对等AS号。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "peer-as",
                "type": "integer",
                "explanation": "对等AS号。"
            }
        ]
    },
    "set protocols bgp group external-peers neighbor 172.16.2.2": {
        "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
        "command": "set protocols bgp group external-peers neighbor 172.16.2.2",
        "explanation": "配置BGP组的邻居地址。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "neighbor-address",
                "type": "string",
                "explanation": "邻居的IP地址。"
            }
        ]
    },
    "set protocols bgp group external-peers family inet unicast": {
        "template": "set protocols bgp group [parameter1] family inet [parameter2]",
        "command": "set protocols bgp group external-peers family inet unicast",
        "explanation": "启用BGP的IPv4单播地址族。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "address-family",
                "type": "string",
                "explanation": "地址族类型，例如unicast。"
            }
        ]
    },
    "set protocols bgp group external-peers export export-connected": {
        "template": "set protocols bgp group [parameter1] export [parameter2]",
        "command": "set protocols bgp group external-peers export export-connected",
        "explanation": "重新分发已连接的路由。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "export-policy",
                "type": "string",
                "explanation": "导出策略名称。"
            }
        ]
    },
    "set routing-options forwarding-table export export-connected": {
        "template": "set routing-options forwarding-table export [parameter1]",
        "command": "set routing-options forwarding-table export export-connected",
        "explanation": "配置不进行同步。",
        "parameters": [
            {
                "name": "export-policy",
                "type": "string",
                "explanation": "导出策略名称。"
            }
        ]
    },
    "set policy-options policy-statement export-connected from protocol direct": {
        "template": "set policy-options policy-statement [parameter1] from protocol [parameter2]",
        "command": "set policy-options policy-statement export-connected from protocol direct",
        "explanation": "定义策略以重新分发已连接的路由到BGP。",
        "parameters": [
            {
                "name": "policy-statement",
                "type": "string",
                "explanation": "策略声明名称。"
            },
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型，例如direct。"
            }
        ]
    },
    "set policy-options policy-statement export-connected then accept": {
        "template": "set policy-options policy-statement [parameter1] then [parameter2]",
        "command": "set policy-options policy-statement export-connected then accept",
        "explanation": "定义策略动作。",
        "parameters": [
            {
                "name": "policy-statement",
                "type": "string",
                "explanation": "策略声明名称。"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "策略动作，例如accept。"
            }
        ]
    }
}