{
  "set system": {
    "set system host-name CE4": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE4",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set vlans": {
    "set vlans vlan200 vlan-id 200": {
      "template": "set vlans [parameter1] vlan-id [parameter2]",
      "command": "set vlans vlan200 vlan-id 200",
      "explanation": "配置VLAN的ID。",
      "parameters": [
        {
          "name": "vlan-name",
          "type": "string",
          "explanation": "VLAN的名称。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols rstp": {
      "template": "set protocols [parameter1]",
      "command": "set protocols rstp",
      "explanation": "启用RSTP协议。",
      "parameters": [
        {
          "name": "protocol",
          "type": "string",
          "explanation": "启用的协议名称。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 200": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 200",
      "explanation": "配置接口的VLAN成员。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号。"
        }
      ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-block": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching bpdu-block",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-block",
      "explanation": "在接口上启用BPDU阻塞。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号。"
        }
      ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
      "explanation": "配置接口的模式为trunk。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号。"
        },
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式，例如trunk。"
        }
      ]
    }
  }
}