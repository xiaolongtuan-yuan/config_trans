{
  "set system": {
    "set system host-name CE2": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-1/0/0 unit 0 family inet": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet",
      "command": "set interfaces ge-1/0/0 unit 0 family inet",
      "explanation": "配置接口的IPv4协议族。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "set interfaces ge-1/0/0 description \"GigabitEthernet1/0/0\"": {
      "template": "set interfaces [parameter1] description [parameter2]",
      "command": "set interfaces ge-1/0/0 description \"GigabitEthernet1/0/0\"",
      "explanation": "配置接口的描述信息。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/0。"
        },
        {
          "name": "description",
          "type": "string",
          "explanation": "接口的描述信息，用于标识或说明接口的用途。"
        }
      ]
    },
    "set interfaces ge-1/0/0 disable": {
      "template": "set interfaces [parameter1] disable",
      "command": "set interfaces ge-1/0/0 disable",
      "explanation": "禁用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/0。"
        }
      ]
    }
  }
}