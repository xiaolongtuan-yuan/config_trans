{
  "set system": {
    "set system host-name CE2": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set vlans": {
    "set vlans vlan100 vlan-id 100": {
      "template": "set vlans [parameter1] vlan-id [parameter2]",
      "command": "set vlans vlan100 vlan-id 100",
      "explanation": "配置VLAN的ID。",
      "parameters": [
        {
          "name": "vlan-name",
          "type": "string",
          "explanation": "VLAN的名称。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols rstp": {
      "template": "set protocols rstp",
      "command": "set protocols rstp",
      "explanation": "启用RSTP协议。",
      "parameters": []
    },
    "set protocols rstp interface ge-1/0/1 bpdu-block": {
      "template": "set protocols rstp interface [parameter1] bpdu-block",
      "command": "set protocols rstp interface ge-1/0/1 bpdu-block",
      "explanation": "在指定接口上启用BPDU阻塞功能。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching",
      "explanation": "配置接口为以太网交换模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 100": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 100",
      "explanation": "将接口加入指定的VLAN。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号。"
        }
      ]
    },
    "set interfaces ge-1/0/1 disable": {
      "template": "set interfaces [parameter1] disable",
      "command": "set interfaces ge-1/0/1 disable",
      "explanation": "禁用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        }
      ]
    },
    "set interfaces ge-1/0/1 enable": {
      "template": "set interfaces [parameter1] enable",
      "command": "set interfaces ge-1/0/1 enable",
      "explanation": "启用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        }
      ]
    }
  }
}