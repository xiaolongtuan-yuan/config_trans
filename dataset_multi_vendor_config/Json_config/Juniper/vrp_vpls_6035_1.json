{
  "host-name": {
    "host-name CE2": {
      "template": "host-name [parameter1]",
      "command": "host-name CE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "interface": {
    "interface ge-0/0/0": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0",
      "explanation": "进入指定接口的配置模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "description GigabitEthernet": {
      "template": "description [parameter1]",
      "command": "description GigabitEthernet",
      "explanation": "为接口添加描述信息。",
      "parameters": [
        {
          "name": "description",
          "type": "string",
          "explanation": "接口的描述信息。"
        }
      ]
    },
    "shutdown no": {
      "template": "shutdown [parameter1]",
      "command": "shutdown no",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "shutdown",
          "type": "string",
          "explanation": "控制接口的启用状态，'no'表示启用接口。"
        }
      ]
    },
    "ipv4 address 10.1.1.2/24": {
      "template": "ipv4 address [parameter1]/[parameter2]",
      "command": "ipv4 address 10.1.1.2/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "exit": {
      "template": "exit",
      "command": "exit",
      "explanation": "退出当前配置模式。",
      "parameters": []
    }
  }
}