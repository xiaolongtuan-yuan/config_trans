{
    "set system host-name PE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set chassis efm enable": {
        "template": "set chassis efm [parameter1]",
        "command": "set chassis efm enable",
        "explanation": "启用设备的EFM（Ethernet in the First Mile）功能。",
        "parameters": [
            {
                "name": "efm",
                "type": "string",
                "explanation": "EFM功能的启用状态。"
            }
        ]
    },
    "set interfaces ge-2/0/1 disable": {
        "template": "set interfaces [parameter1] [parameter2]",
        "command": "set interfaces ge-2/0/1 disable",
        "explanation": "禁用指定接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-2/0/1。"
            },
            {
                "name": "state",
                "type": "string",
                "explanation": "接口的状态，disable表示禁用。"
            }
        ]
    },
    "set interfaces ge-2/0/1 efm enable": {
        "template": "set interfaces [parameter1] efm [parameter2]",
        "command": "set interfaces ge-2/0/1 efm enable",
        "explanation": "在指定接口上启用EFM功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-2/0/1。"
            },
            {
                "name": "efm",
                "type": "string",
                "explanation": "EFM功能的启用状态。"
            }
        ]
    }
}