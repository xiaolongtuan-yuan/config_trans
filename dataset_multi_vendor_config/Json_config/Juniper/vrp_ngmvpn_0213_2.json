    "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:2::2/64": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:2::2/64",
        "explanation": "配置接口的IPv6地址及前缀长度。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            }
        ]
    },
