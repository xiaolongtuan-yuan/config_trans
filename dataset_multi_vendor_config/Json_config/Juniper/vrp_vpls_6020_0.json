{
  "host-name": {
    "host-name CE1": {
      "template": "host-name [parameter1]",
      "command": "host-name CE1",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "interface gigabit-ethernet1/0/0.1": {
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口，使其处于活动状态。",
      "parameters": []
    },
    "encapsulation dot1q 10": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 10",
      "explanation": "配置接口的802.1Q封装，指定VLAN ID。",
      "parameters": [
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN ID，用于标识不同的虚拟局域网。"
        }
      ]
    },
    "ip address 10.1.1.1 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.1.1 255.255.255.0",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "string",
          "explanation": "IPv4子网掩码，用于定义网络的大小。"
        }
      ]
    }
  }
}