{
  "set system": {
    "set system host-name CE2": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "interface gigabit-ether1/0/0": {
    "interface gigabit-ether1/0/0 no shutdown": {
      "template": "interface [parameter1] no shutdown",
      "command": "interface gigabit-ether1/0/0 no shutdown",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如gigabit-ether1/0/0。"
        }
      ]
    }
  },
  "interface gigabit-ether1/0/0.1": {
    "interface gigabit-ether1/0/0.1 no shutdown": {
      "template": "interface [parameter1] no shutdown",
      "command": "interface gigabit-ether1/0/0.1 no shutdown",
      "explanation": "启用子接口。",
      "parameters": [
        {
          "name": "sub-interface",
          "type": "string",
          "explanation": "子接口名称，例如gigabit-ether1/0/0.1。"
        }
      ]
    },
    "interface gigabit-ether1/0/0.1 unit 0 family inet address 10.1.1.2/30": {
      "template": "interface [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "interface gigabit-ether1/0/0.1 unit 0 family inet address 10.1.1.2/30",
      "explanation": "配置子接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "sub-interface",
          "type": "string",
          "explanation": "子接口名称，例如gigabit-ether1/0/0.1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给子接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  }
}