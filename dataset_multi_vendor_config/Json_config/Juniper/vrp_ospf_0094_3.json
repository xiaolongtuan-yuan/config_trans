{
  "set system": {
    "set system host-name DeviceD": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name DeviceD",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols ospf area 0.0.0.2 interface ge-0/0/0": {
      "template": "set protocols ospf area [parameter1] interface [parameter2]",
      "command": "set protocols ospf area 0.0.0.2 interface ge-0/0/0",
      "explanation": "配置OSPF协议，指定区域和接口。",
      "parameters": [
        {
          "name": "area",
          "type": "string",
          "explanation": "OSPF区域ID。"
        },
        {
          "name": "interface",
          "type": "string",
          "explanation": "参与OSPF协议的接口名称。"
        }
      ]
    },
    "set protocols ospf area 0.0.0.2 interface ge-0/0/1": {
      "template": "set protocols ospf area [parameter1] interface [parameter2]",
      "command": "set protocols ospf area 0.0.0.2 interface ge-0/0/1",
      "explanation": "配置OSPF协议，指定区域和接口。",
      "parameters": [
        {
          "name": "area",
          "type": "string",
          "explanation": "OSPF区域ID。"
        },
        {
          "name": "interface",
          "type": "string",
          "explanation": "参与OSPF协议的接口名称。"
        }
      ]
    }
  },
  "set routing-options": {
    "set routing-options router-id 4.4.4.4": {
      "template": "set routing-options router-id [parameter1]",
      "command": "set routing-options router-id 4.4.4.4",
      "explanation": "配置路由器的ID。",
      "parameters": [
        {
          "name": "router-id",
          "type": "string",
          "explanation": "路由器的唯一标识符。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-0/0/0 unit 0 family inet address 192.168.2.2/24": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.2.2/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "set interfaces ge-0/0/0 enable": {
      "template": "set interfaces [parameter1] enable",
      "command": "set interfaces ge-0/0/0 enable",
      "explanation": "启用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "set interfaces ge-0/0/1 unit 0 family inet address 172.17.1.1/24": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces ge-0/0/1 unit 0 family inet address 172.17.1.1/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "set interfaces ge-0/0/1 enable": {
      "template": "set interfaces [parameter1] enable",
      "command": "set interfaces ge-0/0/1 enable",
      "explanation": "启用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        }
      ]
    }
  }
}