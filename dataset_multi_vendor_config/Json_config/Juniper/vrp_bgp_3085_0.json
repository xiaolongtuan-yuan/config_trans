{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 10.20.1.1/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.20.1.1/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set routing-options router-id 1.1.1.1": {
        "template": "set routing-options router-id [parameter1]",
        "command": "set routing-options router-id 1.1.1.1",
        "explanation": "配置路由器的ID。",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "路由器的唯一标识符，用于BGP等协议中。"
            }
        ]
    },
    "set protocols bgp group EBGP type external": {
        "template": "set protocols bgp group [parameter1] type [parameter2]",
        "command": "set protocols bgp group EBGP type external",
        "explanation": "配置BGP组的类型为外部。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "BGP组的类型，例如external。"
            }
        ]
    },
    "set protocols bgp group EBGP local-address 10.20.1.1": {
        "template": "set protocols bgp group [parameter1] local-address [parameter2]",
        "command": "set protocols bgp group EBGP local-address 10.20.1.1",
        "explanation": "配置BGP组的本地地址。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "local-address",
                "type": "string",
                "explanation": "BGP组的本地地址。"
            }
        ]
    },
    "set protocols bgp group EBGP neighbor 10.20.1.2 peer-as 200": {
        "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
        "command": "set protocols bgp group EBGP neighbor 10.20.1.2 peer-as 200",
        "explanation": "配置BGP组的邻居及其AS号。",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "BGP组的名称。"
            },
            {
                "name": "neighbor-address",
                "type": "string",
                "explanation": "邻居的IP地址。"
            },
            {
                "name": "peer-as",
                "type": "integer",
                "explanation": "邻居的AS号。"
            }
        ]
    },
    "set protocols bgp group EBGP authentication-key \"$9$encrypted-password\"": {
        "template": "set protocols bgp group [parameter1] authentication-key [parameter2]",
