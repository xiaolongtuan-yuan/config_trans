{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set protocols ptp clock-domain 1": {
        "template": "set protocols ptp clock-domain [parameter1]",
        "command": "set protocols ptp clock-domain 1",
        "explanation": "配置PTP时钟域。",
        "parameters": [
            {
                "name": "clock-domain",
                "type": "integer",
                "explanation": "PTP时钟域的编号。"
            }
        ]
    },
    "set protocols ptp clock-domain 1 device-type server": {
        "template": "set protocols ptp clock-domain [parameter1] device-type [parameter2]",
        "command": "set protocols ptp clock-domain 1 device-type server",
        "explanation": "配置PTP时钟域的设备类型为服务器。",
        "parameters": [
            {
                "name": "clock-domain",
                "type": "integer",
                "explanation": "PTP时钟域的编号。"
            },
            {
                "name": "device-type",
                "type": "string",
                "explanation": "设备类型，例如server或client。"
            }
        ]
    },
    "set protocols ptp clock-domain 1 local-ip 1.1.1.1": {
        "template": "set protocols ptp clock-domain [parameter1] local-ip [parameter2]",
        "command": "set protocols ptp clock-domain 1 local-ip 1.1.1.1",
        "explanation": "配置PTP时钟域的本地IP地址。",
        "parameters": [
            {
                "name": "clock-domain",
                "type": "integer",
                "explanation": "PTP时钟域的编号。"
            },
            {
                "name": "local-ip",
                "type": "string",
                "explanation": "本地IP地址。"
            }
        ]
    },
    "set protocols ptp clock-domain 1 unicast-negotiate enable": {
        "template": "set protocols ptp clock-domain [parameter1] unicast-negotiate [parameter2]",
        "command": "set protocols ptp clock-domain 1 unicast-negotiate enable",
        "explanation": "启用PTP时钟域的单播协商功能。",
        "parameters": [
            {
                "name": "clock-domain",
                "type": "integer",
                "explanation": "PTP时钟域的编号。"
            },
            {
                "name": "unicast-negotiate",
                "type": "string",
                "explanation": "单播协商功能的启用状态，例如enable或disable。"
            }
        ]
    },
    "set interfaces lo0 unit 0 family inet address 1.1.1.1/32": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces lo0 unit 0 family inet address 1.1.1.1/32",
        "explanation": "配置环回接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如lo0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "commit": {
        "template": "commit",
        "command": "commit",
        "explanation": "提交配置更改，使其生效。",
        "parameters": []
    }
}