        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "string",
          "explanation": "IPv4子网掩码。"
        }
      ]
    },
