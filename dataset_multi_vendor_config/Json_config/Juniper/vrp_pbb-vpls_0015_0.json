{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ae0 unit 0 family ethernet-switching port-mode trunk": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
        "command": "set interfaces ae0 unit 0 family ethernet-switching port-mode trunk",
        "explanation": "配置接口的以太网交换模式为trunk。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "port-mode",
                "type": "string",
                "explanation": "接口的端口模式，例如trunk。"
            }
        ]
    },
    "set interfaces ae0 unit 10 encapsulation vlan-id 10": {
        "template": "set interfaces [parameter1] unit [parameter2] encapsulation vlan-id [parameter3]",
        "command": "set interfaces ae0 unit 10 encapsulation vlan-id 10",
        "explanation": "配置接口的VLAN封装。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，用于标识不同的VLAN。"
            }
        ]
    },
    "set interfaces ae0 unit 10 family inet address 10.1.1.1/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ae0 unit 10 family inet address 10.1.1.1/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae0。"
            },
            {
                "name": "unit",
                "type": "integer",
