{
    "set interfaces eth0 unit 0 family ethernet-switching port-mode trunk": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
        "command": "set interfaces eth0 unit 0 family ethernet-switching port-mode trunk",
        "explanation": "配置以太网接口的交换模式为trunk。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如eth0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "port-mode",
                "type": "string",
                "explanation": "接口的交换模式，例如trunk。"
            }
        ]
    },
