{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set vlans vlan-10 vlan-id 10": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan-10 vlan-id 10",
        "explanation": "配置VLAN的ID。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号。"
            }
        ]
    },
    "set interfaces ae1 aggregated-ether-options": {
        "template": "set interfaces [parameter1] aggregated-ether-options",
        "command": "set interfaces ae1 aggregated-ether-options",
        "explanation": "配置聚合以太网接口的选项。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "聚合以太网接口名称，例如ae1。"
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "选择接口进行配置。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            }
        ]
    },
    "set interfaces ge-1/0/0 enable": {
        "template": "set interfaces [parameter1] enable",
        "command": "set interfaces ge-1/0/0 enable",
        "explanation": "启用指定接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            }
        ]
    },
    "set interfaces ge-1/0/0 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-1/0/0 ether-options 802.3ad ae1",
        "explanation": "配置接口的以太网选项，将其加入到指定的聚合以太网接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "聚合以太网接口名称，例如ae1。"
            }
        ]
    }
}