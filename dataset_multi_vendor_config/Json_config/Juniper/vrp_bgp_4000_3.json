{
    "set system host-name DeviceD": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceD",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 192.168.3.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.3.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"": {
        "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
        "command": "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"",
        "explanation": "配置接口的描述信息。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "description",
                "type": "string",
                "explanation": "接口的描述信息。"
            }
        ]
    },
    "set routing-options autonomous-system 200": {
        "template": "set routing-options autonomous-system [parameter1]",
