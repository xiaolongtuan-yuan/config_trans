    "set protocols rstp bridge-priority 10": {
        "template": "set protocols rstp bridge-priority [parameter1]",
        "command": "set protocols rstp bridge-priority 10",
        "explanation": "配置RSTP协议的桥优先级。",
        "parameters": [
            {
                "name": "bridge-priority",
                "type": "integer",
