        "template": "set interfaces [parameter1] unit [parameter2] family inet dhcp-relay server [parameter3]",
        "command": "set interfaces irb unit 10 family inet dhcp-relay server 2.2.2.2",
        "explanation": "配置IRB接口的DHCP中继服务器地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如irb。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "dhcp-server-address",
                "type": "string",
                "explanation": "DHCP服务器的IP地址。"
            }
        ]
    },
