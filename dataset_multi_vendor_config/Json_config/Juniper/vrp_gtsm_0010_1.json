        "parameters": [
            {
                "name": "ospf-process-id",
                "type": "integer",
                "explanation": "OSPF进程ID。"
            },
            {
                "name": "area-id",
                "type": "string",
                "explanation": "OSPF区域的ID。"
            },
            {
                "name": "network",
                "type": "string",
                "explanation": "属于该OSPF区域的网络地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "网络地址的子网掩码位数。"
            }
        ]
    },
