        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set protocols ospf 1 router-id 2.2.2.2": {
        "template": "set protocols ospf [parameter1] router-id [parameter2]",
        "command": "set protocols ospf 1 router-id 2.2.2.2",
        "explanation": "配置OSPF协议的Router ID。",
        "parameters": [
            {
                "name": "ospf-process-id",
                "type": "integer",
                "explanation": "OSPF进程ID。"
            },
            {
                "name": "router-id",
                "type": "string",
                "explanation": "OSPF路由器的ID，用于唯一标识OSPF路由器。"
            }
        ]
    },
