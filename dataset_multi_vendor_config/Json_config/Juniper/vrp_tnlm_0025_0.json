{
  "set system": {
    "set system host-name CE1": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE1",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/24": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "interfaces lo0 unit 0 family inet address 5.5.5.5/32": {
      "template": "interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "interfaces lo0 unit 0 family inet address 5.5.5.5/32",
      "explanation": "配置环回接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如lo0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols bgp as 65001": {
      "template": "set protocols bgp as [parameter1]",
      "command": "set protocols bgp as 65001",
      "explanation": "配置BGP协议的自治系统号。",
      "parameters": [
        {
          "name": "as-number",
          "type": "integer",
          "explanation": "BGP自治系统号。"
        }
      ]
    },
    "set protocols bgp peer 10.1.1.2 as-number 100": {
      "template": "set protocols bgp peer [parameter1] as-number [parameter2]",
      "command": "set protocols bgp peer 10.1.1.2 as-number 100",
      "explanation": "配置BGP对等体及其自治系统号。",
      "parameters": [
        {
          "name": "peer-ip",
          "type": "string",
          "explanation": "BGP对等体的IP地址。"
        },
        {
          "name": "as-number",
          "type": "integer",
          "explanation": "对等体的自治系统号。"
        }
      ]
    },
    "set protocols bgp accept-reachability-all": {
      "template": "set protocols bgp accept-reachability-all",
      "command": "set protocols bgp accept-reachability-all",
      "explanation": "配置BGP接受所有可达性信息。",
      "parameters": []
    },
    "set protocols bgp synchronize no": {
      "template": "set protocols bgp synchronize [parameter1]",
      "command": "set protocols bgp synchronize no",
      "explanation": "配置BGP不同步。",
      "parameters": [
        {
          "name": "synchronize",
          "type": "boolean",
          "explanation": "是否同步BGP和IGP路由。"
        }
      ]
    },
    "set protocols bgp network 5.5.5.5/32": {
      "template": "set protocols bgp network [parameter1]/[parameter2]",
      "command": "set protocols bgp network 5.5.5.5/32",
      "explanation": "配置BGP通告的网络。",
      "parameters": [
        {
          "name": "network",
          "type": "string",
          "explanation": "要通告的网络地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "网络地址的子网掩码位数。"
        }
      ]
    },
    "set protocols bgp neighbor 10.1.1.2 activate": {
      "template": "set protocols bgp neighbor [parameter1] activate",
      "command": "set protocols bgp neighbor 10.1.1.2 activate",
      "explanation": "激活BGP邻居。",
      "parameters": [
        {
          "name": "neighbor-ip",
          "type": "string",
          "explanation": "BGP邻居的IP地址。"
        }
      ]
    }
  }
}