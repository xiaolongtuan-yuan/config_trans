{
    "set system name-hostname Router-Name": {
        "template": "set system name-hostname [parameter1]",
        "command": "set system name-hostname Router-Name",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ethernet0 unit 0 family inet address 192.168.1.1/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ethernet0 unit 0 family inet address 192.168.1.1/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ethernet0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set routing-options static route 0.0.0.0/0 next-hop 192.168.1.2": {
        "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set routing-options static route 0.0.0.0/0 next-hop 192.168.1.2",
        "explanation": "配置静态路由，指定下一跳地址。",
        "parameters": [
            {
                "name": "destination-ip",
                "type": "string",
                "explanation": "目标IP地址。"
            },
            {
                "name": "destination-mask",
                "type": "integer",
                "explanation": "目标IP地址的子网掩码位数。"
            },
            {
                "name": "next-hop-ip",
                "type": "string",
                "explanation": "下一跳的IP地址。"
            }
        ]
    }
}