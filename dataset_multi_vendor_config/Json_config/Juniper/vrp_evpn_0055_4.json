{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set vlans vlan100 vlan-id 100": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan100 vlan-id 100",
        "explanation": "配置VLAN的ID。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号。"
            }
        ]
    },
    "set vlans vlan100 l3-interface irb.10": {
        "template": "set vlans [parameter1] l3-interface [parameter2]",
        "command": "set vlans vlan100 l3-interface irb.10",
        "explanation": "配置VLAN的三层接口。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称。"
            },
            {
                "name": "l3-interface",
                "type": "string",
                "explanation": "三层接口的名称。"
            }
        ]
    },
    "set interfaces irb unit 10 family inet address 192.168.1.12/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces irb unit 10 family inet address 192.168.1.12/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如irb。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
