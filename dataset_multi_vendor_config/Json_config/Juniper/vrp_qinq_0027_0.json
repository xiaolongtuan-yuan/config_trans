{
    "set system host-name PE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
        "explanation": "配置接口为以太网交换模式，并设置接口模式为trunk。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "interface-mode",
                "type": "string",
                "explanation": "接口模式，例如trunk。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 1 vlan-id 100": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 1 vlan-id 100",
        "explanation": "配置接口单元的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，用于标识不同的VLAN。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 1 family inet address 10.1.1.254/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/1 unit 1 family inet address 10.1.1.254/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 1 proxy-arp restricted": {
        "template": "set interfaces [parameter1] unit [parameter2] proxy-arp [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 1 proxy-arp restricted",
        "explanation": "配置接口单元的代理ARP为受限模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "proxy-arp-mode",
                "type": "string",
                "explanation": "代理ARP模式，例如restricted。"
            }
        ]
    },
    "activate interfaces ge-1/0/1": {
        "template": "activate interfaces [parameter1]",
        "command": "activate interfaces ge-1/0/1",
        "explanation": "激活指定接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            }
        ]
    },
    "deactivate interfaces ge-1/0/1 unit 1 proxy-arp": {
        "template": "deactivate interfaces [parameter1] unit [parameter2] proxy-arp",
        "command": "deactivate interfaces ge-1/0/1 unit 1 proxy-arp",
        "explanation": "停用接口单元的代理ARP功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    }
}