{
  "host-name": {
    "host-name CE1": {
      "template": "host-name [parameter1]",
      "command": "host-name CE1",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "interface": {
    "interface ge-0/0/0": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0",
      "explanation": "进入指定接口的配置模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "interface ge-0/0/0 description Connected to Core Network": {
      "template": "interface [parameter1] description [parameter2]",
      "command": "interface ge-0/0/0 description Connected to Core Network",
      "explanation": "为接口添加描述信息。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "description",
          "type": "string",
          "explanation": "接口的描述信息。"
        }
      ]
    },
    "interface ge-0/0/0 no shutdown": {
      "template": "interface [parameter1] no shutdown",
      "command": "interface ge-0/0/0 no shutdown",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "interface ge-0/0/0.10": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0.10",
      "explanation": "进入指定子接口的配置模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        }
      ]
    },
    "interface ge-0/0/0.10 encapsulation dot1q 10": {
      "template": "interface [parameter1] encapsulation dot1q [parameter2]",
      "command": "interface ge-0/0/0.10 encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为dot1q，并指定VLAN ID。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN ID，用于标识不同的VLAN。"
        }
      ]
    },
    "interface ge-0/0/0.10 unit 10": {
      "template": "interface [parameter1] unit [parameter2]",
      "command": "interface ge-0/0/0.10 unit 10",
      "explanation": "配置子接口的单元号。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "interface ge-0/0/0.10 family inet": {
      "template": "interface [parameter1] family inet",
      "command": "interface ge-0/0/0.10 family inet",
      "explanation": "配置子接口支持IPv4协议。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        }
      ]
    },
    "interface ge-0/0/0.10 family inet address 10.1.1.1/24": {
      "template": "interface [parameter1] family inet address [parameter2]/[parameter3]",
      "command": "interface ge-0/0/0.10 family inet address 10.1.1.1/24",
      "explanation": "为子接口配置IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给子接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "interface ge-0/0/0.10 no shutdown": {
      "template": "interface [parameter1] no shutdown",
      "command": "interface ge-0/0/0.10 no shutdown",
      "explanation": "启用子接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        }
      ]
    }
  }
}