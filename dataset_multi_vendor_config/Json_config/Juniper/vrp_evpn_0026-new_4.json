{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set vlans vlan2 vlan-id 2": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan2 vlan-id 2",
        "explanation": "配置VLAN的ID。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号。"
            }
        ]
    },
    "set interfaces vlan unit 2 family inet address 192.168.1.11/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces vlan unit 2 family inet address 192.168.1.11/24",
        "explanation": "配置VLAN接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如vlan。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ae10 aggregated-ether-options lacp active": {
        "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
        "command": "set interfaces ae10 aggregated-ether-options lacp active",
        "explanation": "配置聚合接口的LACP模式为主动模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            },
            {
                "name": "lacp-mode",
                "type": "string",
                "explanation": "LACP的模式，active表示主动模式。"
            }
        ]
    },
    "set interfaces ae10 aggregated-ether-options lacp periodic fast": {
        "template": "set interfaces [parameter1] aggregated-ether-options lacp periodic [parameter2]",
        "command": "set interfaces ae10 aggregated-ether-options lacp periodic fast",
        "explanation": "配置聚合接口的LACP周期为快速模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            },
            {
                "name": "lacp-periodic",
                "type": "string",
                "explanation": "LACP的周期模式，fast表示快速模式。"
            }
        ]
    },
    "set interfaces ae10 unit 0 family ethernet-switching vlan members vlan2": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
        "command": "set interfaces ae10 unit 0 family ethernet-switching vlan members vlan2",
        "explanation": "配置聚合接口的VLAN成员。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-members",
                "type": "string",
                "explanation": "VLAN成员名称，例如vlan2。"
            }
        ]
    },
    "set interfaces ge-1/0/0 ether-options 802.3ad ae10": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-1/0/0 ether-options 802.3ad ae10",
        "explanation": "配置物理接口加入聚合接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "物理接口名称，例如ge-1/0/0。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            }
        ]
    },
    "set interfaces ge-2/0/0 ether-options 802.3ad ae10": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-2/0/0 ether-options 802.3ad ae10",
        "explanation": "配置物理接口加入聚合接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "物理接口名称，例如ge-2/0/0。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            }
        ]
    }
}