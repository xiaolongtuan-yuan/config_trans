  "set interfaces": {
    "set interfaces ge-1/0/1 unit 0 family inet address 10.0.0.1/24": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.0.0.1/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
