{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ae1 unit 0 family inet6 address 2001:DB8:1::2/64": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
        "command": "set interfaces ae1 unit 0 family inet6 address 2001:DB8:1::2/64",
        "explanation": "配置接口的IPv6地址及前缀长度。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            }
        ]
    },
    "set interfaces ge-3/0/0 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-3/0/0 ether-options 802.3ad ae1",
        "explanation": "配置接口的以太网选项，将其加入链路聚合组。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "链路聚合组名称，例如ae1。"
            }
        ]
    },
    "set interfaces ge-3/0/0 disable false": {
        "template": "set interfaces [parameter1] disable [parameter2]",
        "command": "set interfaces ge-3/0/0 disable false",
        "explanation": "启用接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "disable",
                "type": "boolean",
                "explanation": "是否禁用接口，false表示启用。"
            }
        ]
    },
    "set interfaces ge-3/0/1 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-3/0/1 ether-options 802.3ad ae1",
        "explanation": "配置接口的以太网选项，将其加入链路聚合组。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/1。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "链路聚合组名称，例如ae1。"
            }
        ]
    },
    "set interfaces ge-3/0/1 disable false": {
        "template": "set interfaces [parameter1] disable [parameter2]",
        "command": "set interfaces ge-3/0/1 disable false",
        "explanation": "启用接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/1。"
            },
            {
                "name": "disable",
                "type": "boolean",
                "explanation": "是否禁用接口，false表示启用。"
            }
        ]
    },
    "set protocols bfd interface ae1 minimum-interval 10": {
        "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
        "command": "set protocols bfd interface ae1 minimum-interval 10",
        "explanation": "配置BFD协议在指定接口上的最小发送间隔。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "minimum-interval",
                "type": "integer",
                "explanation": "最小发送间隔时间，单位为毫秒。"
            }
        ]
    },
    "set protocols bfd interface ae1 minimum-receive-interval 10": {
        "template": "set protocols bfd interface [parameter1] minimum-receive-interval [parameter2]",
        "command": "set protocols bfd interface ae1 minimum-receive-interval 10",
        "explanation": "配置BFD协议在指定接口上的最小接收间隔。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "minimum-receive-interval",
                "type": "integer",
                "explanation": "最小接收间隔时间，单位为毫秒。"
            }
        ]
    },
    "set protocols bfd interface ae1 neighbor 2001:DB8:1::1 local-address 2001:DB8:1::2": {
        "template": "set protocols bfd interface [parameter1] neighbor [parameter2] local-address [parameter3]",
        "command": "set protocols bfd interface ae1 neighbor 2001:DB8:1::1 local-address 2001:DB8:1::2",
        "explanation": "配置BFD协议在指定接口上的邻居地址及本地地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "neighbor-address",
                "type": "string",
                "explanation": "邻居的IPv6地址。"
            },
            {
                "name": "local-address",
                "type": "string",
                "explanation": "本地的IPv6地址。"
            }
        ]
    }
}