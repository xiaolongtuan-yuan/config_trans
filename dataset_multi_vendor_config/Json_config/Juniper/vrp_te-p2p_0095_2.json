        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如gigabitethernet1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "family",
                "type": "string",
                "explanation": "接口家族类型，例如mpls。"
            }
        ]
    },
