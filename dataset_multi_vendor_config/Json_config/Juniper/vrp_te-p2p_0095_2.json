        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set protocols ldp enabled": {
        "template": "set protocols ldp [parameter1]",
        "command": "set protocols ldp enabled",
        "explanation": "启用LDP协议。",
        "parameters": [
            {
                "name": "ldp",
                "type": "string",
                "explanation": "指定LDP协议。"
            },
            {
                "name": "enabled",
                "type": "boolean",
                "explanation": "启用或禁用LDP协议。"
            }
        ]
    },
    "set interfaces gigabitethernet1/0/0 unit 0 family mpls": {
        "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
        "command": "set interfaces gigabitethernet1/0/0 unit 0 family mpls",
