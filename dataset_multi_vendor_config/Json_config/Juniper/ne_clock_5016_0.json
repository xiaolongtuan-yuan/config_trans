{
  "set system": {
    "set system host-name DeviceA": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name DeviceA",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    },
    "set system clock ssm control enable": {
      "template": "set system clock ssm control [parameter1]",
      "command": "set system clock ssm control enable",
      "explanation": "启用系统时钟的SSM控制。",
      "parameters": [
        {
          "name": "control",
          "type": "string",
          "explanation": "控制选项，例如enable或disable。"
        }
      ]
    },
    "set system clock source 2Mbps": {
      "template": "set system clock source [parameter1]",
      "command": "set system clock source 2Mbps",
      "explanation": "配置系统时钟的源类型。",
      "parameters": [
        {
          "name": "source",
          "type": "string",
          "explanation": "时钟源类型，例如2Mbps。"
        }
      ]
    },
    "set system clock id 1": {
      "template": "set system clock id [parameter1]",
      "command": "set system clock id 1",
      "explanation": "配置系统时钟的ID。",
      "parameters": [
        {
          "name": "id",
          "type": "integer",
          "explanation": "时钟ID，用于标识时钟源。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-0/0/0 clock sync enable": {
      "template": "set interfaces [parameter1] clock sync [parameter2]",
      "command": "set interfaces ge-0/0/0 clock sync enable",
      "explanation": "启用接口的时钟同步功能。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "sync",
          "type": "string",
          "explanation": "同步选项，例如enable或disable。"
        }
      ]
    },
    "set interfaces ge-0/0/0 clock id 2": {
      "template": "set interfaces [parameter1] clock id [parameter2]",
      "command": "set interfaces ge-0/0/0 clock id 2",
      "explanation": "配置接口的时钟ID。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "id",
          "type": "integer",
          "explanation": "时钟ID，用于标识时钟源。"
        }
      ]
    },
    "set interfaces ge-0/0/1 clock sync enable": {
      "template": "set interfaces [parameter1] clock sync [parameter2]",
      "command": "set interfaces ge-0/0/1 clock sync enable",
      "explanation": "启用接口的时钟同步功能。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        },
        {
          "name": "sync",
          "type": "string",
          "explanation": "同步选项，例如enable或disable。"
        }
      ]
    },
    "set interfaces ge-0/0/1 clock priority 3": {
      "template": "set interfaces [parameter1] clock priority [parameter2]",
      "command": "set interfaces ge-0/0/1 clock priority 3",
      "explanation": "配置接口的时钟优先级。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        },
        {
          "name": "priority",
          "type": "integer",
          "explanation": "时钟优先级，数值越小优先级越高。"
        }
      ]
    },
    "set interfaces ge-0/0/1 clock id 3": {
      "template": "set interfaces [parameter1] clock id [parameter2]",
      "command": "set interfaces ge-0/0/1 clock id 3",
      "explanation": "配置接口的时钟ID。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        },
        {
          "name": "id",
          "type": "integer",
          "explanation": "时钟ID，用于标识时钟源。"
        }
      ]
    }
  }
}