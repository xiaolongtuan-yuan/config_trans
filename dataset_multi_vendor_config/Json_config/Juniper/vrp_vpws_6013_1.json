{
  "set system": {
    "set system host-name PE2": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name PE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols mpls": {
      "template": "set protocols mpls",
      "command": "set protocols mpls",
      "explanation": "启用MPLS协议。",
      "parameters": []
    },
    "set protocols ldp interface Serial3/0/1:1": {
      "template": "set protocols ldp interface [parameter1]",
      "command": "set protocols ldp interface Serial3/0/1:1",
      "explanation": "在指定接口上启用LDP协议。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如Serial3/0/1:1。"
        }
      ]
    },
    "set protocols ldp interface Serial3/0/1:2": {
      "template": "set protocols ldp interface [parameter1]",
      "command": "set protocols ldp interface Serial3/0/1:2",
      "explanation": "在指定接口上启用LDP协议。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如Serial3/0/1:2。"
        }
      ]
    },
    "set protocols ospf area 0.0.0.0 interface ge-2/0/0.0": {
      "template": "set protocols ospf area [parameter1] interface [parameter2]",
      "command": "set protocols ospf area 0.0.0.0 interface ge-2/0/0.0",
      "explanation": "在指定区域和接口上启用OSPF协议。",
      "parameters": [
        {
          "name": "area",
          "type": "string",
          "explanation": "OSPF区域ID。"
        },
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-2/0/0.0。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces serial-3_0_1 unit 1 family ppp": {
      "template": "set interfaces [parameter1] unit [parameter2] family ppp",
      "command": "set interfaces serial-3_0_1 unit 1 family ppp",
      "explanation": "配置接口的PPP协议。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如serial-3_0_1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "set interfaces serial-3_0_1 unit 2 family ppp": {
      "template": "set interfaces [parameter1] unit [parameter2] family ppp",
      "command": "set interfaces serial-3_0_1 unit 2 family ppp",
      "explanation": "配置接口的PPP协议。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如serial-3_0_1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "set interfaces ge-2/0/0 link-detect": {
      "template": "set interfaces [parameter1] link-detect",
      "command": "set interfaces ge-2/0/0 link-detect",
      "explanation": "启用接口的链路检测功能。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-2/0/0。"
        }
      ]
    },
    "set interfaces ge-2/0/0 unit 0family inet address 10.2.2.2/24": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces ge-2/0/0 unit 0family inet address 10.2.2.2/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-2/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  },
  "set routing-options": {
    "set routing-options static route 0.0.0.0/0 next-hop 10.2.2.1": {
      "template": "set routing-options static route [parameter1] next-hop [parameter2]",
      "command": "set routing-options static route 0.0.0.0/0 next-hop 10.2.2.1",
      "explanation": "配置静态路由。",
      "parameters": [
        {
          "name": "route",
          "type": "string",
          "explanation": "目标网络地址及掩码。"
        },
        {
          "name": "next-hop",
          "type": "string",
          "explanation": "下一跳地址。"
        }
      ]
    }
  }
}