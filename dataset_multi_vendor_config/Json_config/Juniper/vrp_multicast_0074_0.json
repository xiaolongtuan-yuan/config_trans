        "command": "set routing-options prefix-list list-df 192.168.0.0/16 through 192.168.255.255/32",
        "explanation": "配置路由选项的前缀列表，指定IP地址范围。",
        "parameters": [
            {
                "name": "prefix-list-name",
                "type": "string",
