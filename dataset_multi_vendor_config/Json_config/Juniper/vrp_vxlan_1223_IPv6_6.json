{
    "set routing-options static route 0.0.0.0/0 next-hop 10.0.1.1": {
        "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set routing-options static route 0.0.0.0/0 next-hop 10.0.1.1",
        "explanation": "配置静态路由，指定目的网络和下一跳地址。",
        "parameters": [
            {
                "name": "destination-network",
                "type": "string",
                "explanation": "目的网络地址，例如0.0.0.0。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "目的网络的前缀长度，例如0表示默认路由。"
            },
            {
                "name": "next-hop-address",
                "type": "string",
                "explanation": "下一跳的IP地址，数据包将被转发到这个地址。"
            }
        ]
    }
}