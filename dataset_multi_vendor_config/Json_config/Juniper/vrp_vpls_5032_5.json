{
    "set system host-name CE3": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE3",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 1 encapsulation vlan-bridge": {
        "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
        "command": "set interfaces ge-1/0/0 unit 1 encapsulation vlan-bridge",
        "explanation": "配置接口的封装类型为VLAN桥接。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "接口的封装类型，例如vlan-bridge。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 1 vlan-id 10": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/0 unit 1 vlan-id 10",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的标识号。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 1 family inet address 10.1.1.3/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 1 family inet address 10.1.1.3/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    }
}