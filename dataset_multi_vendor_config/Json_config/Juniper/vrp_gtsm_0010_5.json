{
    "set system host-name DeviceF": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceF",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set routing-options router-id 6.6.6.6": {
        "template": "set routing-options router-id [parameter1]",
        "command": "set routing-options router-id 6.6.6.6",
        "explanation": "配置路由器的ID。",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "路由器的唯一标识符，通常为一个IP地址。"
            }
        ]
    },
    "set interfaces ge-2/0/0 unit 0 family inet address 172.17.1.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-2/0/0 unit 0 family inet address 172.17.1.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-2/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set protocols ospf area 0.0.0.2 interface ge-2/0/0": {
        "template": "set protocols ospf area [parameter1] interface [parameter2]",
        "command": "set protocols ospf area 0.0.0.2 interface ge-2/0/0",
        "explanation": "配置OSPF协议的接口。",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF区域ID。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "参与OSPF协议的接口名称。"
            }
        ]
    },
    "set protocols ospf area 0.0.0.2 interface ge-2/0/0 interface-type broadcast": {
        "template": "set protocols ospf area [parameter1] interface [parameter2] interface-type [parameter3]",
        "command": "set protocols ospf area 0.0.0.2 interface ge-2/0/0 interface-type broadcast",
        "explanation": "配置OSPF接口的类型。",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF区域ID。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "参与OSPF协议的接口名称。"
            },
            {
                "name": "interface-type",
                "type": "string",
                "explanation": "接口类型，例如broadcast。"
            }
        ]
    },
    "set protocols ospf ttl-security hops 4": {
        "template": "set protocols ospf ttl-security hops [parameter1]",
        "command": "set protocols ospf ttl-security hops 4",
        "explanation": "配置OSPF协议的TTL安全跳数。",
        "parameters": [
            {
                "name": "hops",
                "type": "integer",
                "explanation": "TTL安全跳数，用于防止OSPF协议的路由欺骗。"
            }
        ]
    }
}