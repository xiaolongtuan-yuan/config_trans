{
  "host-name": {
    "host-name CE1": {
      "template": "host-name [parameter1]",
      "command": "host-name CE1",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "interface": {
    "interface ge-0/0/0": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0",
      "explanation": "进入指定接口的配置模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "description GigabitEthernet to 10.10.1.0/24 network": {
      "template": "description [parameter1]",
      "command": "description GigabitEthernet to 10.10.1.0/24 network",
      "explanation": "为接口添加描述信息。",
      "parameters": [
        {
          "name": "description",
          "type": "string",
          "explanation": "接口的描述信息，用于说明接口的用途或连接的网络。"
        }
      ]
    },
    "ip address 10.10.1.1/24": {
      "template": "ip address [parameter1]/[parameter2]",
      "command": "ip address 10.10.1.1/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  }
}