{
  "set system": {
    "set system host-name DeviceB": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name DeviceB",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces pos-1/0/0 unit 0 family inet address 10.1.1.2/30": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
      "command": "set interfaces pos-1/0/0 unit 0 family inet address 10.1.1.2/30",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如pos-1/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    },
    "set interfaces pos-1/0/0 encapsulation ppp": {
      "template": "set interfaces [parameter1] encapsulation [parameter2]",
      "command": "set interfaces pos-1/0/0 encapsulation ppp",
      "explanation": "配置接口的封装类型。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如pos-1/0/0。"
        },
        {
          "name": "encapsulation",
          "type": "string",
          "explanation": "封装类型，例如ppp。"
        }
      ]
    },
    "set interfaces pos-1/0/0 clocking external": {
      "template": "set interfaces [parameter1] clocking [parameter2]",
      "command": "set interfaces pos-1/0/0 clocking external",
      "explanation": "配置接口的时钟源。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如pos-1/0/0。"
        },
        {
          "name": "clocking",
          "type": "string",
          "explanation": "时钟源类型，例如external。"
        }
      ]
    },
    "set interfaces pos-1/0/0 unit 0 disable": {
      "template": "set interfaces [parameter1] unit [parameter2] disable",
      "command": "set interfaces pos-1/0/0 unit 0 disable",
      "explanation": "禁用接口的指定单元。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如pos-1/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    }
  },
  "set chassis": {
    "set chassis fpc 0 pic 0 clocking line": {
      "template": "set chassis fpc [parameter1] pic [parameter2] clocking [parameter3]",
      "command": "set chassis fpc 0 pic 0 clocking line",
      "explanation": "配置FPC和PIC的时钟源。",
      "parameters": [
        {
          "name": "fpc",
          "type": "integer",
          "explanation": "FPC编号。"
        },
        {
          "name": "pic",
          "type": "integer",
          "explanation": "PIC编号。"
        },
        {
          "name": "clocking",
          "type": "string",
          "explanation": "时钟源类型，例如line。"
        }
      ]
    }
  }
}