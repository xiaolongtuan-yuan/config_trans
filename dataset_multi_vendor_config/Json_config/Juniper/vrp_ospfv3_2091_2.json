{
    "set system host-name DeviceC": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-3/0/0 unit 0 family inet6 address 2001:DB8:3::1/64": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
        "command": "set interfaces ge-3/0/0 unit 0 family inet6 address 2001:DB8:3::1/64",
        "explanation": "配置接口的IPv6地址及前缀长度。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ipv6-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            }
        ]
    },
    "set interfaces ge-3/0/0 unit 0 family inet6 ospf area 0.0.0.1": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 ospf area [parameter3]",
        "command": "set interfaces ge-3/0/0 unit 0 family inet6 ospf area 0.0.0.1",
        "explanation": "配置接口的IPv6 OSPF区域。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ospf-area",
                "type": "string",
                "explanation": "OSPF区域标识符。"
            }
        ]
    },
    "set protocols ospf3 instance-id 1": {
        "template": "set protocols ospf3 instance-id [parameter1]",
        "command": "set protocols ospf3 instance-id 1",
        "explanation": "配置OSPFv3实例ID。",
        "parameters": [
            {
                "name": "instance-id",
                "type": "integer",
                "explanation": "OSPFv3实例的唯一标识符。"
            }
        ]
    },
    "set protocols ospf3 area 0.0.0.1 interface ge-3/0/0.0": {
        "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
        "command": "set protocols ospf3 area 0.0.0.1 interface ge-3/0/0.0",
        "explanation": "配置OSPFv3区域与接口的关联。",
        "parameters": [
            {
                "name": "ospf-area",
                "type": "string",
                "explanation": "OSPFv3区域标识符。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0.0。"
            }
        ]
    },
    "set protocols ospf3 router-id 4.4.4.4": {
        "template": "set protocols ospf3 router-id [parameter1]",
        "command": "set protocols ospf3 router-id 4.4.4.4",
        "explanation": "配置OSPFv3的路由器ID。",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "OSPFv3路由器的唯一标识符。"
            }
        ]
    }
}