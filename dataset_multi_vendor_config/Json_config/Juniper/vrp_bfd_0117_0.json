{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ae1 unit 0 family inet address 10.1.1.1/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ae1 unit 0 family inet address 10.1.1.1/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ge-3/0/0 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-3/0/0 ether-options 802.3ad ae1",
        "explanation": "配置接口的以太网选项，使其加入链路聚合组。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "链路聚合组名称，例如ae1。"
            }
        ]
    },
    "set interfaces ge-3/0/0 disable false": {
        "template": "set interfaces [parameter1] disable [parameter2]",
        "command": "set interfaces ge-3/0/0 disable false",
        "explanation": "启用接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/0。"
            },
            {
                "name": "disable",
                "type": "boolean",
                "explanation": "是否禁用接口，false表示启用。"
            }
        ]
    },
    "set interfaces ge-3/0/1 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-3/0/1 ether-options 802.3ad ae1",
        "explanation": "配置接口的以太网选项，使其加入链路聚合组。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/1。"
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "链路聚合组名称，例如ae1。"
            }
        ]
    },
    "set interfaces ge-3/0/1 disable false": {
        "template": "set interfaces [parameter1] disable [parameter2]",
        "command": "set interfaces ge-3/0/1 disable false",
        "explanation": "启用接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-3/0/1。"
            },
            {
                "name": "disable",
                "type": "boolean",
                "explanation": "是否禁用接口，false表示启用。"
            }
        ]
    },
    "set protocols bfd minimum-interval 10": {
        "template": "set protocols bfd minimum-interval [parameter1]",
        "command": "set protocols bfd minimum-interval 10",
        "explanation": "配置BFD协议的最小间隔时间。",
        "parameters": [
            {
                "name": "minimum-interval",
                "type": "integer",
                "explanation": "BFD协议的最小间隔时间，单位为毫秒。"
            }
        ]
    },
    "set protocols bfd multiplier 3": {
        "template": "set protocols bfd multiplier [parameter1]",
        "command": "set protocols bfd multiplier 3",
        "explanation": "配置BFD协议的乘数。",
        "parameters": [
            {
                "name": "multiplier",
                "type": "integer",
                "explanation": "BFD协议的乘数，用于计算检测时间。"
            }
        ]
    },
    "set protocols bfd interface ae1 destination 10.1.1.2": {
        "template": "set protocols bfd interface [parameter1] destination [parameter2]",
        "command": "set protocols bfd interface ae1 destination 10.1.1.2",
        "explanation": "配置BFD协议的接口目标地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "destination-address",
                "type": "string",
                "explanation": "BFD协议的目标地址。"
            }
        ]
    },
    "set protocols bfd interface ae1 source 10.1.1.1": {
        "template": "set protocols bfd interface [parameter1] source [parameter2]",
        "command": "set protocols bfd interface ae1 source 10.1.1.1",
        "explanation": "配置BFD协议的接口源地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ae1。"
            },
            {
                "name": "source-address",
                "type": "string",
                "explanation": "BFD协议的源地址。"
            }
        ]
    }
}