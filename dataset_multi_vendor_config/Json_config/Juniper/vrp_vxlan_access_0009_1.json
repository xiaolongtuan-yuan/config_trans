{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 0 family ethernet-switching": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
        "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching",
        "explanation": "配置接口为以太网交换模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
    "set interfaces lo0 unit 0 family inet address 1.1.1.2/32": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces lo0 unit 0 family inet address 1.1.1.2/32",
        "explanation": "配置环回接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如lo0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ne0 unit 0 family vlangroup tagged 10 evpn": {
        "template": "set interfaces [parameter1] unit [parameter2] family vlangroup tagged [parameter3] evpn",
        "command": "set interfaces ne0 unit 0 family vlangroup tagged 10 evpn",
        "explanation": "配置接口的VLAN组及EVPN。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ne0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，用于标识特定的VLAN。"
            }
        ]
    },
    "set protocols bgp group pe peer-address 1.1.1.1 type internal": {
        "template": "set protocols bgp group [parameter1] peer-address [parameter2] type [parameter3]",
        "command": "set protocols bgp group pe peer-address 1.1.1.1 type internal",
        "explanation": "配置BGP协议的组、对等体地址及类型。",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP组名称。"
            },
            {
                "name": "peer-address",
                "type": "string",
                "explanation": "对等体的IP地址。"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "BGP对等体类型，例如internal。"
            }
        ]
    },
    "set routing-instances evpn instance-type evpn": {
        "template": "set routing-instances [parameter1] instance-type [parameter2]",
        "command": "set routing-instances evpn instance-type evpn",
        "explanation": "配置路由实例的类型为EVPN。",
        "parameters": [
            {
                "name": "instance",
                "type": "string",
                "explanation": "路由实例名称。"
            },
            {
                "name": "instance-type",
                "type": "string",
                "explanation": "路由实例的类型，例如evpn。"
            }
        ]
    },
    "set forwarding-options encapsulation l2evpn": {
        "template": "set forwarding-options encapsulation [parameter1]",
        "command": "set forwarding-options encapsulation l2evpn",
        "explanation": "配置转发选项的封装类型为L2EVPN。",
        "parameters": [
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "封装类型，例如l2evpn。"
            }
        ]
    },
    "set routes static route 1.1.1.1/32 next-hop 192.168.1.1": {
        "template": "set routes static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set routes static route 1.1.1.1/32 next-hop 192.168.1.1",
        "explanation": "配置静态路由及下一跳地址。",
        "parameters": [
            {
                "name": "route",
                "type": "string",
                "explanation": "目标网络地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "网络前缀长度。"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳地址。"
            }
        ]
    }
