        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/1。"
        }
      ]
    },
    "set interfaces ae10 aggregated-ether-options lacp active": {
      "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
      "command": "set interfaces ae10 aggregated-ether-options lacp active",
      "explanation": "配置聚合接口的以太网选项，启用LACP并设置为主动模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "聚合接口名称，例如ae10。"
        },
        {
          "name": "lacp-mode",
          "type": "string",
