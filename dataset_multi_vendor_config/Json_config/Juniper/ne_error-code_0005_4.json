      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
      "command": "set interfaces ae10 unit 0 family ethernet-switching vlan members 10",
      "explanation": "配置聚合接口的以太网交换选项，指定VLAN成员。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "聚合接口名称，例如ae10。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN ID，指定接口所属的VLAN。"
        }
      ]
    },
