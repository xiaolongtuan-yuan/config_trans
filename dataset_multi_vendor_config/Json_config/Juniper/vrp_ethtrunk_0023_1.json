{
  "set system": {
    "set system host-name PE2": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name PE2",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ae1 aggregated-ether-options link-speed 1g": {
      "template": "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]",
      "command": "set interfaces ae1 aggregated-ether-options link-speed 1g",
      "explanation": "配置聚合接口的链路速度。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ae1。"
        },
        {
          "name": "link-speed",
          "type": "string",
          "explanation": "链路速度，例如1g表示1Gbps。"
        }
      ]
    },
    "set interfaces ae1 aggregated-ether-options lacp active": {
      "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
      "command": "set interfaces ae1 aggregated-ether-options lacp active",
      "explanation": "配置LACP（链路聚合控制协议）为主动模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ae1。"
        },
        {
          "name": "lacp-mode",
          "type": "string",
          "explanation": "LACP模式，active表示主动模式。"
        }
      ]
    },
    "set interfaces ae1 aggregated-ether-options lacp port-priority 100": {
      "template": "set interfaces [parameter1] aggregated-ether-options lacp port-priority [parameter2]",
      "command": "set interfaces ae1 aggregated-ether-options lacp port-priority 100",
      "explanation": "配置LACP端口优先级。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ae1。"
        },
        {
          "name": "port-priority",
          "type": "integer",
          "explanation": "LACP端口优先级，数值越小优先级越高。"
        }
      ]
    },
    "set interfaces ae1 unit 0 family ethernet-switching interface-mode trunk": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
      "command": "set interfaces ae1 unit 0 family ethernet-switching interface-mode trunk",
      "explanation": "配置接口的以太网交换模式为trunk。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ae1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "interface-mode",
          "type": "string",
          "explanation": "接口模式，trunk表示允许多个VLAN通过。"
        }
      ]
    },
    "set interfaces ae1 unit 0 family ethernet-switching vlan members all": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
      "command": "set interfaces ae1 unit 0 family ethernet-switching vlan members all",
      "explanation": "配置接口允许所有VLAN通过。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ae1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "vlan-members",
          "type": "string",
          "explanation": "VLAN成员，all表示允许所有VLAN通过。"
        }
      ]
    },
    "set interfaces ge-1/0/1 ether-options 802.3ad ae1": {
      "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
      "command": "set interfaces ge-1/0/1 ether-options 802.3ad ae1",
      "explanation": "配置接口加入链路聚合组。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "aggregated-interface",
          "type": "string",
          "explanation": "聚合接口名称，例如ae1。"
        }
      ]
    },
    "set interfaces ge-1/0/1 disable false": {
      "template": "set interfaces [parameter1] disable [parameter2]",
      "command": "set interfaces ge-1/0/1 disable false",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "disable",
          "type": "boolean",
          "explanation": "是否禁用接口，false表示启用。"
        }
      ]
    },
    "set interfaces ge-2/0/1 ether-options 802.3ad ae1": {
      "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
      "command": "set interfaces ge-2/0/1 ether-options 802.3ad ae1",
      "explanation": "配置接口加入链路聚合组。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-2/0/1。"
        },
        {
          "name": "aggregated-interface",
          "type": "string",
          "explanation": "聚合接口名称，例如ae1。"
        }
      ]
    },
    "set interfaces ge-2/0/1 disable false": {
      "template": "set interfaces [parameter1] disable [parameter2]",
      "command": "set interfaces ge-2/0/1 disable false",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-2/0/1。"
        },
        {
          "name": "disable",
          "type": "boolean",
          "explanation": "是否禁用接口，false表示启用。"
        }
      ]
    },
    "set interfaces ge-3/0/0 ether-options 802.3ad ae1": {
      "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
      "command": "set interfaces ge-3/0/0 ether-options 802.3ad ae1",
      "explanation": "配置接口加入链路聚合组。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-3/0/0。"
        },
        {
          "name": "aggregated-interface",
          "type": "string",
          "explanation": "聚合接口名称，例如ae1。"
        }
      ]
    },
    "set interfaces ge-3/0/0 disable false": {
      "template": "set interfaces [parameter1] disable [parameter2]",
      "command": "set interfaces ge-3/0/0 disable false",
      "explanation": "启用接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-3/0/0。"
        },
        {
          "name": "disable",
          "type": "boolean",
          "explanation": "是否禁用接口，false表示启用。"
        }
      ]
    },
    "set interfaces ge-3/0/0 aggregated-ether-options lacp port-priority 150": {
      "template": "set interfaces [parameter1] aggregated-ether-options lacp port-priority [parameter2]",
      "command": "set interfaces ge-3/0/0 aggregated-ether-options lacp port-priority 150",
      "explanation": "配置LACP端口优先级。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-3/0/0。"
        },
        {
          "name": "port-priority",
          "type": "integer",
          "explanation": "LACP端口优先级，数值越小优先级越高。"
        }
      ]
    }
  }
}