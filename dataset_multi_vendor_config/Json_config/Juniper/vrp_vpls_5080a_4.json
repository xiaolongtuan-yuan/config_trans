{
  "interface ge-0/0/0": {
    "interface ge-0/0/0 unit 10": {
      "template": "interface [parameter1] unit [parameter2]",
      "command": "interface ge-0/0/0 unit 10",
      "explanation": "配置接口的单元号。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "interface ge-0/0/0 unit 10 family ethernet-switching": {
      "template": "interface [parameter1] unit [parameter2] family ethernet-switching",
      "command": "interface ge-0/0/0 unit 10 family ethernet-switching",
      "explanation": "配置接口的以太网交换功能。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "interface ge-0/0/0 unit 10 ip address 10.1.1.2/24": {
      "template": "interface [parameter1] unit [parameter2] ip address [parameter3]/[parameter4]",
      "command": "interface ge-0/0/0 unit 10 ip address 10.1.1.2/24",
      "explanation": "配置接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  }
}