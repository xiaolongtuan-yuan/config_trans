        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "encapsulation-type",
                "type": "string",
                "explanation": "封装类型，例如ppp。"
            }
        ]
    },
