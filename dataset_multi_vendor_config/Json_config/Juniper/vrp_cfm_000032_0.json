{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 1 vlan-id 10": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/0 unit 1 vlan-id 10",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，用于标识接口所属的VLAN。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 1 family inet": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet",
        "command": "set interfaces ge-1/0/0 unit 1 family inet",
        "explanation": "配置接口支持IPv4协议族。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    }
}