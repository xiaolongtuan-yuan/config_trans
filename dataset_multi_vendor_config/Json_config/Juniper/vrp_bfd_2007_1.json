{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set routing-options rib inet6.0 static": {
        "template": "set routing-options rib [parameter1] static",
        "command": "set routing-options rib inet6.0 static",
        "explanation": "配置IPv6路由信息库（RIB）为静态路由。",
        "parameters": [
            {
                "name": "rib",
                "type": "string",
                "explanation": "路由信息库名称，例如inet6.0。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::2/64": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::2/64",
        "explanation": "配置接口的IPv6地址及前缀长度。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            }
        ]
    },
    "set interfaces ge-2/0/0 unit 0 family inet6 address 2001:db8:2::1/64": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
        "command": "set interfaces ge-2/0/0 unit 0 family inet6 address 2001:db8:2::1/64",
        "explanation": "配置接口的IPv6地址及前缀长度。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-2/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            }
        ]
    },
    "set protocols ospf3 area 0.0.0.0 interface ge-1/0/0": {
        "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
        "command": "set protocols ospf3 area 0.0.0.0 interface ge-1/0/0",
        "explanation": "配置OSPFv3区域及接口。",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPFv3区域ID，例如0.0.0.0。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            }
        ]
    },
    "set protocols ospf3 area 0.0.0.0 interface ge-2/0/0": {
        "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
        "command": "set protocols ospf3 area 0.0.0.0 interface ge-2/0/0",
        "explanation": "配置OSPFv3区域及接口。",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPFv3区域ID，例如0.0.0.0。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-2/0/0。"
            }
        ]
    },
    "set protocols ospf3 router-id 2.2.2.2": {
        "template": "set protocols ospf3 router-id [parameter1]",
        "command": "set protocols ospf3 router-id 2.2.2.2",
        "explanation": "配置OSPFv3路由器的ID。",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "OSPFv3路由器的ID，例如2.2.2.2。"
            }
        ]
    }
