{
  "host-name": {
    "host-name CE1": {
      "template": "host-name [parameter1]",
      "command": "host-name CE1",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "vlan": {
    "vlan 10": {
      "template": "vlan [parameter1]",
      "command": "vlan 10",
      "explanation": "创建或指定VLAN。",
      "parameters": [
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号，用于标识不同的VLAN。"
        }
      ]
    }
  },
  "interface": {
    "interface ge-0/0/0": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0",
      "explanation": "进入指定接口的配置模式。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "interface ge-0/0/0 shutdown": {
      "template": "interface [parameter1] shutdown",
      "command": "interface ge-0/0/0 shutdown",
      "explanation": "关闭指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        }
      ]
    },
    "interface ge-0/0/0.10": {
      "template": "interface [parameter1]",
      "command": "interface ge-0/0/0.10",
      "explanation": "进入指定子接口的配置模式。",
      "parameters": [
        {
          "name": "sub-interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        }
      ]
    },
    "interface ge-0/0/0.10 encapsulation dot1q 10": {
      "template": "interface [parameter1] encapsulation dot1q [parameter2]",
      "command": "interface ge-0/0/0.10 encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为802.1Q，并指定VLAN ID。",
      "parameters": [
        {
          "name": "sub-interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号，用于标识不同的VLAN。"
        }
      ]
    },
    "interface ge-0/0/0.10 ip address 10.1.1.1/24": {
      "template": "interface [parameter1] ip address [parameter2]/[parameter3]",
      "command": "interface ge-0/0/0.10 ip address 10.1.1.1/24",
      "explanation": "配置子接口的IPv4地址及子网掩码。",
      "parameters": [
        {
          "name": "sub-interface",
          "type": "string",
          "explanation": "子接口名称，例如ge-0/0/0.10。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给子接口的IPv4地址。"
        },
        {
          "name": "subnet-mask",
          "type": "integer",
          "explanation": "IPv4子网掩码的位数。"
        }
      ]
    }
  }
}