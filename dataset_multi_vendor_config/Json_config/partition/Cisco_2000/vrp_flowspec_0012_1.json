{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/1/0",
        "explanation": "配置接口 'GigabitEthernet0/1/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.2 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.2.1.2，AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.2 activate",
                "explanation": "激活邻居 10.2.1.2 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] route-map [parameter2] [parameter3]": {
                "template": "neighbor [parameter1] route-map [parameter2] [parameter3]",
                "command": "neighbor 10.2.1.2 route-map RM-NO-VALIDATION out",
                "explanation": "为邻居 10.2.1.2 配置出方向的 route-map 'RM-NO-VALIDATION'",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "route-map 名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "应用方向"
                    }
                ]
            }
        }
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map RM-NO-VALIDATION permit 10",
        "explanation": "配置 route-map 'RM-NO-VALIDATION'，序列号为 10，动作为允许",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "route-map 名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set peer-validation [parameter1]": {
            "template": "set peer-validation [parameter1]",
            "command": "set peer-validation disable",
            "explanation": "设置对等体验证为禁用",
            "parameters": [
                {
                    "name": "peer-validation",
                    "type": "string",
                    "explanation": "对等体验证状态"
                }
            ]
        }
    }
}