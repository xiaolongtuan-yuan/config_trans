{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "批量创建 VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建 VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif2",
        "explanation": "配置 VLAN 接口 'Vlanif2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.12 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.12，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口配置为二层接口",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许 VLAN 2 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 10 mode active",
            "explanation": "将接口加入到端口通道 10 并设置为主动模式",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "端口通道号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "端口通道模式"
                }
            ]
        }
    }
}