{
    "username [parameter1] password [parameter2] [parameter3]": {
        "template": "username [parameter1] password [parameter2] [parameter3]",
        "command": "username huawei password 0 @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "创建用户名为 'huawei' 的用户，并设置密码为 '@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%'，密码类型为 0（明文）",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password type",
                "type": "integer",
                "explanation": "密码类型，0 表示明文"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "ip ftp username [parameter1]": {
        "template": "ip ftp username [parameter1]",
        "command": "ip ftp username huawei",
        "explanation": "设置 FTP 用户名为 'huawei'",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "FTP 用户名"
            }
        ]
    },
    "ip ftp password [parameter1]": {
        "template": "ip ftp password [parameter1]",
        "command": "ip ftp password @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "设置 FTP 密码为 '@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%'",
        "parameters": [
            {
                "name": "password",
                "type": "string",
                "explanation": "FTP 密码"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip ftp source-interface [parameter1]": {
        "template": "ip ftp source-interface [parameter1]",
        "command": "ip ftp source-interface loopback 0",
        "explanation": "设置 FTP 的源接口为 'loopback 0'",
        "parameters": [
            {
                "name": "source interface",
                "type": "string",
                "explanation": "源接口"
            }
        ]
    },
    "ftp server enable": {
        "template": "ftp server enable",
        "command": "ftp server enable",
        "explanation": "启用 FTP 服务器功能",
        "parameters": []
    }
}