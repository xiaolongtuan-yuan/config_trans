{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial1/0/0",
        "explanation": "配置接口 'Serial1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation [parameter1]": {
            "template": "encapsulation [parameter1]",
            "command": "encapsulation frame-relay",
            "explanation": "设置封装类型为 frame-relay",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "frame-relay interface-dlci [parameter1]": {
            "template": "frame-relay interface-dlci [parameter1]",
            "command": "frame-relay interface-dlci 100",
            "explanation": "配置帧中继接口的 DLCI 号码",
            "parameters": [
                {
                    "name": "dlci number",
                    "type": "integer",
                    "explanation": "DLCI 号码"
                }
            ]
        }
    },
    "interface [parameter1] [parameter2]": {
        "template": "interface [parameter1] [parameter2]",
        "command": "interface Serial1/0/0.1 point-to-point",
        "explanation": "配置子接口 'Serial1/0/0.1'，类型为点对点",
        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "subinterface type",
                "type": "string",
                "explanation": "子接口类型"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}