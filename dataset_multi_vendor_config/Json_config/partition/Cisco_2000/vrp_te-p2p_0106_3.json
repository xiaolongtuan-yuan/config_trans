{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRD",
        "explanation": "设置设备的主机名为 'LSRD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制使用 'Loopback1' 接口的 IP 地址作为 MPLS LDP 的路由器 ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "进入 MPLS LDP 配置模式",
        "parameters": [],
        "mpls traffic-eng": {
            "template": "mpls traffic-eng",
            "command": "mpls traffic-eng",
            "explanation": "启用 MPLS 流量工程",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入 OSPF 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "opaque-lsa enable": {
            "template": "opaque-lsa enable",
            "command": "opaque-lsa enable",
            "explanation": "启用 OSPF 不透明 LSA",
            "parameters": []
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 3.2.1.0 0.0.0.255 area 0",
            "explanation": "将网络 3.2.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 4.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 4.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        },
        "mpls traffic-eng": {
            "template": "mpls traffic-eng",
            "command": "mpls traffic-eng",
            "explanation": "在接口上启用 MPLS 流量工程",
            "parameters": []
        },
        "mpls rsvp-te": {
            "template": "mpls rsvp-te",
            "command": "mpls rsvp-te",
            "explanation": "在接口上启用 MPLS RSVP-TE",
            "parameters": []
        }
    }
}