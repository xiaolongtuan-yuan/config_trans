{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname routerE",
        "explanation": "设置设备的主机名为 'routerE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置ISIS路由协议，实例编号为1",
        "parameters": [
            {
                "name": "router process ID",
                "type": "integer",
                "explanation": "ISIS路由器进程ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0005.00",
            "explanation": "配置ISIS的NET地址",
            "parameters": [
                {
                    "name": "NET address",
                    "type": "string",
                    "explanation": "ISIS的NET地址"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置ISIS的类型为Level-1（区域内）",
            "parameters": [
                {
                    "name": "ISIS level type",
                    "type": "string",
                    "explanation": "ISIS的层级类型，level-1或level-2"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.20.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置ISIS的网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "ISIS的网络类型，如point-to-point"
                }
            ]
        }
    }
}