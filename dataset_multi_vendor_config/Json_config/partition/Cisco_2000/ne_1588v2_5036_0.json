{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp": {
        "template": "ptp",
        "command": "ptp",
        "explanation": "进入 PTP 配置模式",
        "parameters": [],
        "ptp profile [parameter1]": {
            "template": "ptp profile [parameter1]",
            "command": "ptp profile default",
            "explanation": "选择默认的 PTP 配置文件",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "配置文件名称"
                }
            ],
            "device-type [parameter1]": {
                "template": "device-type [parameter1]",
                "command": "device-type server",
                "explanation": "设置设备类型为服务器",
                "parameters": [
                    {
                        "name": "device type",
                        "type": "string",
                        "explanation": "设备类型，如 server、client 等"
                    }
                ]
            },
            "local-ip [parameter1]": {
                "template": "local-ip [parameter1]",
                "command": "local-ip 1.1.1.1",
                "explanation": "设置本地 IP 地址",
                "parameters": [
                    {
                        "name": "ip address",
                        "type": "IPv4",
                        "explanation": "本地 IP 地址"
                    }
                ]
            },
            "unicast-negotiate [parameter1]": {
                "template": "unicast-negotiate [parameter1]",
                "command": "unicast-negotiate enable",
                "explanation": "启用单播协商",
                "parameters": [
                    {
                        "name": "enable/disable",
                        "type": "string",
                        "explanation": "启用或禁用单播协商"
                    }
                ]
            },
            "end": {
                "template": "end",
                "command": "end",
                "explanation": "结束当前配置模式",
                "parameters": []
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置 Loopback0 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}