{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.0.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ntp authentication-key [parameter1] md5 [parameter2]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2]",
        "command": "ntp authentication-key 42 md5 %#%#m:fVJfk*r&3x\"1J`21^K`Y;LH;B+g(t2<ZX^}Q_~%#%#",
        "explanation": "配置NTP认证密钥，ID为42，使用MD5加密，密钥为指定字符串",
        "parameters": [
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "密钥ID"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "密钥"
            }
        ]
    },
    "ntp trusted-key [parameter1]": {
        "template": "ntp trusted-key [parameter1]",
        "command": "ntp trusted-key 42",
        "explanation": "将ID为42的密钥标记为受信任的NTP密钥",
        "parameters": [
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "密钥ID"
            }
        ]
    },
    "ntp server [parameter1] key [parameter2]": {
        "template": "ntp server [parameter1] key [parameter2]",
        "command": "ntp server 10.0.0.1 key 42",
        "explanation": "配置NTP服务器地址为10.0.0.1，并使用ID为42的密钥进行认证",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP服务器地址"
            },
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "密钥ID"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}