{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置OSPF路由器的ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "bfd all-interfaces": {
            "template": "bfd all-interfaces",
            "command": "bfd all-interfaces",
            "explanation": "在所有接口上启用BFD",
            "parameters": []
        },
        "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 500 min_rx 500 multiplier 4",
            "explanation": "配置BFD的发送间隔为500ms，接收间隔为500ms，乘数为4",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "发送间隔(ms)"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "接收间隔(ms)"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.0 0.0.0.255 area 0",
            "explanation": "将网络2.2.2.0/24加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 2.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 500 min_rx 500 multiplier 4",
            "explanation": "配置BFD的发送间隔为500ms，接收间隔为500ms，乘数为4",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "发送间隔(ms)"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "接收间隔(ms)"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        }
    }
}