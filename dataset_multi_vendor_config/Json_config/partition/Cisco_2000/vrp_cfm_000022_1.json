{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2-4",
        "explanation": "创建 VLAN 2 到 4",
        "parameters": [
            {
                "name": "vlan range",
                "type": "range",
                "explanation": "VLAN 范围"
            }
        ]
    },
    "cfm": {
        "template": "cfm",
        "command": "cfm",
        "explanation": "进入 CFM 配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2-4",
            "explanation": "允许 VLAN 2 到 4 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan range",
                    "type": "range",
                    "explanation": "允许通过的 VLAN 范围"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md1 level 6",
        "explanation": "配置 CFM 维护域 'md1' 的级别为 6",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "维护域级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "配置维护关联 'ma1'",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep crosscheck [parameter1]": {
                "template": "mep crosscheck [parameter1]",
                "command": "mep crosscheck mpid",
                "explanation": "配置 MEP 交叉检查 MPID",
                "parameters": [
                    {
                        "name": "mpid",
                        "type": "string",
                        "explanation": "MPID"
                    }
                ]
            },
            "mep ccm-interval [parameter1]": {
                "template": "mep ccm-interval [parameter1]",
                "command": "mep ccm-interval 10",
                "explanation": "配置 MEP CCM 间隔为 10 毫秒",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "CCM 间隔时间"
                    }
                ]
            },
            "mep ais": {
                "template": "mep ais",
                "command": "mep ais",
                "explanation": "启用 MEP AIS",
                "parameters": []
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}