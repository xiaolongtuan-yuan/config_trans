                "explanation": "动作（permit/deny）"
            },
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IP 地址"
            }
        ]
    },
    "ip prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4] le [parameter5]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4] le [parameter5]",
        "command": "ip prefix-list prefix2 seq 20 permit 0.0.0.0/0 le 32",
