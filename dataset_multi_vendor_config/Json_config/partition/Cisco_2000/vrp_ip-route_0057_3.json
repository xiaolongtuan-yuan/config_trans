        "parameters": [
            {
                "name": "route map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "match ip address [parameter1]": {
            "template": "match ip address [parameter1]",
            "command": "match ip address prefix1",
            "explanation": "匹配 IP 地址前缀列表 'prefix1'",
            "parameters": [
                {
                    "name": "prefix list name",
                    "type": "string",
                    "explanation": "前缀列表名称"
                }
            ]
        }
