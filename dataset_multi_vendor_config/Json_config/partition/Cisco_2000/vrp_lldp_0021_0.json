{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "lldp run": {
        "template": "lldp run",
        "command": "lldp run",
        "explanation": "启用LLDP（链路层发现协议）",
        "parameters": []
    },
    "lldp timer [parameter1]": {
        "template": "lldp timer [parameter1]",
        "command": "lldp timer 60",
        "explanation": "设置LLDP定时器为60秒",
        "parameters": [
            {
                "name": "timer value",
                "type": "integer",
                "explanation": "定时器值，单位为秒"
            }
        ]
    },
    "lldp holdtime [parameter1]": {
        "template": "lldp holdtime [parameter1]",
        "command": "lldp holdtime 9",
        "explanation": "设置LLDP保持时间为9秒",
        "parameters": [
            {
                "name": "holdtime value",
                "type": "integer",
                "explanation": "保持时间值，单位为秒"
            }
        ]
    },
    "lldp reinit [parameter1]": {
        "template": "lldp reinit [parameter1]",
        "command": "lldp reinit 3",
        "explanation": "设置LLDP重新初始化时间为3秒",
        "parameters": [
            {
                "name": "reinit value",
                "type": "integer",
                "explanation": "重新初始化时间值，单位为秒"
            }
        ]
    },
    "lldp tx-hold [parameter1]": {
        "template": "lldp tx-hold [parameter1]",
        "command": "lldp tx-hold 3",
        "explanation": "设置LLDP传输保持时间为3",
        "parameters": [
            {
                "name": "tx-hold value",
                "type": "integer",
                "explanation": "传输保持时间值"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.10.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "lldp management-address [parameter1]": {
        "template": "lldp management-address [parameter1]",
        "command": "lldp management-address 10.10.10.1",
        "explanation": "设置LLDP管理地址为10.10.10.1",
        "parameters": [
            {
                "name": "management address",
                "type": "IPv4",
                "explanation": "管理地址"
            }
        ]
    }
}