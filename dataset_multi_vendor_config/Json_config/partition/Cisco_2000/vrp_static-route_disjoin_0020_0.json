    "ip route-static bfd [parameter1] local-address [parameter2]": {
        "template": "ip route-static bfd [parameter1] local-address [parameter2]",
        "command": "ip route-static bfd 10.10.1.2 local-address 10.10.1.1",
        "explanation": "配置静态路由，使用 BFD 检测到 10.10.1.2 的连通性，本地地址为 10.10.1.1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "local address",
                "type": "IPv4",
                "explanation": "本地地址"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3] bfd enable": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] bfd enable",
        "command": "ip route-static 2.2.2.2 32 10.10.1.2 bfd enable",
        "explanation": "配置静态路由到 2.2.2.2/32，下一跳为 10.10.1.2，并启用 BFD 检测",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
