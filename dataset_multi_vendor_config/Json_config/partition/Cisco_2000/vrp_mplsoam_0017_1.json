        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP转发",
            "parameters": []
        },
        "mpls traffic-eng": {
            "template": "mpls traffic-eng",
            "command": "mpls traffic-eng",
            "explanation": "在接口上启用MPLS流量工程",
            "parameters": []
        },
        "ip unnumbered [parameter1]": {
            "template": "ip unnumbered [parameter1]",
            "command": "ip unnumbered Loopback1",
            "explanation": "配置隧道接口使用环回接口Loopback1的IP地址",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "环回接口名"
                }
            ]
        },
        "tunnel mode mpls traffic-eng": {
            "template": "tunnel mode mpls traffic-eng",
            "command": "tunnel mode mpls traffic-eng",
            "explanation": "配置隧道模式为MPLS流量工程",
            "parameters": []
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 10.2.1.2",
            "explanation": "配置隧道目的地址为10.2.1.2",
            "parameters": [
                {
                    "name": "destination",
                    "type": "IPv4",
                    "explanation": "隧道目的地址"
                }
            ]
        },
        "tunnel mpls traffic-eng path-option [parameter1]": {
            "template": "tunnel mpls traffic-eng path-option [parameter1]",
            "command": "tunnel mpls traffic-eng path-option 10",
            "explanation": "配置隧道使用MPLS流量工程路径选项10",
            "parameters": [
                {
                    "name": "path-option",
                    "type": "integer",
                    "explanation": "路径选项编号"
                }
            ]
        }
    },
    "mpls traffic-eng path-option [parameter1] explicit name [parameter2]": {
        "template": "mpls traffic-eng path-option [parameter1] explicit name [parameter2]",
        "command": "mpls traffic-eng path-option 10 explicit name Tunnel10",
        "explanation": "配置MPLS流量工程路径选项10，明确指定名称为Tunnel10",
        "parameters": [
            {
                "name": "path-option",
                "type": "integer",
                "explanation": "路径选项编号"
            },
            {
                "name": "name",
                "type": "string",
                "explanation": "隧道名称"
            }
        ]
    },
    "mpls traffic-eng autoroute announce": {
        "template": "mpls traffic-eng autoroute announce",
        "command": "mpls traffic-eng autoroute announce",
        "explanation": "启用MPLS流量工程自动路由通告",
        "parameters": []
    },
    "ip explicit-path name [parameter1]": {
        "template": "ip explicit-path name [parameter1]",
        "command": "ip explicit-path name Tunnel10",
        "explanation": "配置显式路径名称为Tunnel10",
        "parameters": [
            {
                "name": "name",
                "type": "string",
                "explanation": "显式路径名称"
            }
        ],
        "next-address [parameter1]": {
            "template": "next-address [parameter1]",
            "command": "next-address 10.2.1.2",
            "explanation": "配置显式路径的下一个地址为10.2.1.2",
            "parameters": [
                {
                    "name": "next-address",
                    "type": "IPv4",
                    "explanation": "下一个地址"
                }
            ]
        }
    }
