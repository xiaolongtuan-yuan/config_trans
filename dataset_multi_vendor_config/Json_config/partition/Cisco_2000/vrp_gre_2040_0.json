{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建 VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "启用 IS-IS 路由协议",
        "parameters": [],
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置 IS-IS 类型为 Level-1",
            "parameters": [
                {
                    "name": "is-type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 50.0000.0000.0001.00",
            "explanation": "设置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan10",
        "explanation": "配置 VLAN 10 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.21.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.21.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "设置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "设置接口模式为访问模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source Loopback1",
            "explanation": "设置隧道源接口为 'Loopback1'",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 4.4.4.9",
            "explanation": "设置隧道目的地址为 4.4.4.9",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 20",
        "explanation": "启用 OSPF 路由协议，进程 ID 为 20",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 5.5.5.9 0.0.0.0 area 0",
            "explanation": "将网络 5.5.5.9/32 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}