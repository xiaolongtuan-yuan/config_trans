{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp server [parameter1] key [parameter2]": {
        "template": "ntp server [parameter1] key [parameter2]",
        "command": "ntp server 10.0.1.31 key 16",
        "explanation": "配置NTP服务器地址为10.0.1.31，并使用密钥16进行认证",
        "parameters": [
            {
                "name": "ntp server",
                "type": "IPv4",
                "explanation": "NTP服务器地址"
            },
            {
                "name": "key",
                "type": "integer",
                "explanation": "认证密钥ID"
            }
        ]
    },
    "ntp authenticate": {
        "template": "ntp authenticate",
        "command": "ntp authenticate",
        "explanation": "启用NTP认证",
        "parameters": []
    },
    "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]",
        "command": "ntp authentication-key 16 md5 7 06111F2F1A2A0B1C2D",
        "explanation": "配置NTP认证密钥16，使用MD5加密，密钥值为06111F2F1A2A0B1C2D",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "认证密钥ID"
            },
            {
                "name": "encryption type",
                "type": "string",
                "explanation": "加密类型"
            },
            {
                "name": "key value",
                "type": "string",
                "explanation": "密钥值"
            }
        ]
    },
    "ntp master [parameter1]": {
        "template": "ntp master [parameter1]",
        "command": "ntp master 3",
        "explanation": "配置设备为NTP主时钟，层级为3",
        "parameters": [
            {
                "name": "stratum",
                "type": "integer",
                "explanation": "NTP层级"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.1.31 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.1.31，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ntp broadcast client": {
            "template": "ntp broadcast client",
            "command": "ntp broadcast client",
            "explanation": "配置接口为NTP广播客户端",
            "parameters": []
        }
    },
    "ntp source [parameter1]": {
        "template": "ntp source [parameter1]",
        "command": "ntp source GigabitEthernet1/0/0",
        "explanation": "配置NTP源接口为GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}