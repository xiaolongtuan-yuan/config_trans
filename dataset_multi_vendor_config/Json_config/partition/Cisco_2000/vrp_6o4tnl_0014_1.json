{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:101:101::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:101:101::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode ipv6ip 6rd",
            "explanation": "设置隧道模式为 IPv6 over IPv4 with 6RD",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                },
                {
                    "name": "extension",
                    "type": "string",
                    "explanation": "隧道模式的扩展"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source GigabitEthernet1/0/1",
            "explanation": "指定隧道的源接口为 GigabitEthernet1/0/1",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "tunnel 6rd prefix [parameter1]": {
            "template": "tunnel 6rd prefix [parameter1]",
            "command": "tunnel 6rd prefix 2001:db8::/32",
            "explanation": "配置 6RD 前缀为 2001:db8::/32",
            "parameters": [
                {
                    "name": "6rd prefix",
                    "type": "IPv6",
                    "explanation": "6RD 前缀"
                }
            ]
        },
        "tunnel 6rd prefix-length [parameter1]": {
            "template": "tunnel 6rd prefix-length [parameter1]",
            "command": "tunnel 6rd prefix-length 8",
            "explanation": "设置 6RD 前缀长度为 8位",
            "parameters": [
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "tunnel 6rd border-relay [parameter1]": {
            "template": "tunnel 6rd border-relay [parameter1]",
            "command": "tunnel 6rd border-relay 10.1.1.2",
            "explanation": "指定 6RD 边界中继路由器的 IPv4 地址为 10.1.1.2",
            "parameters": [
                {
                    "name": "border relay address",
                    "type": "IPv4",
                    "explanation": "边界中继路由器的 IPv4 地址"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route 2001:db8::/32 Tunnel1",
        "explanation": "配置 IPv6 路由，将目的地为 2001:db8::/32 的流量通过隧道接口 Tunnel1 转发",
        "parameters": [
            {
                "name": "destination prefix",
                "type": "IPv6",
                "explanation": "目的地前缀"
            },
            {
                "name": "next hop interface",
                "type": "string",
                "explanation": "下一跳接口"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}