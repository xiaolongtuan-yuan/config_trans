{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "name [parameter1]": {
            "template": "name [parameter1]",
            "command": "name VLAN100",
            "explanation": "为 VLAN 100 设置名称为 'VLAN100'",
            "parameters": [
                {
                    "name": "vlan name",
                    "type": "string",
                    "explanation": "VLAN 名称"
                }
            ]
        }
    },
    "spanning-tree vlan [parameter1] root primary": {
        "template": "spanning-tree vlan [parameter1] root primary",
        "command": "spanning-tree vlan 100,200 root primary",
        "explanation": "配置 VLAN 100 和 200 的生成树根桥为主根",
        "parameters": [
            {
                "name": "vlan list",
                "type": "list",
                "explanation": "VLAN 列表"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100,200",
            "explanation": "允许 VLAN 100 和 200 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "list",
                    "explanation": "VLAN 列表"
                }
            ]
        },
        "spanning-tree portfast [parameter1]": {
            "template": "spanning-tree portfast [parameter1]",
            "command": "spanning-tree portfast disable",
            "explanation": "禁用接口的 PortFast 功能",
            "parameters": [
                {
                    "name": "portfast state",
                    "type": "string",
                    "explanation": "PortFast 状态"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}