{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree vlan [parameter1] priority [parameter2]": {
        "template": "spanning-tree vlan [parameter1] priority [parameter2]",
        "command": "spanning-tree vlan 1-20 priority 8192",
        "explanation": "设置 VLAN 1-20 的生成树优先级为 8192",
        "parameters": [
            {
                "name": "vlan range",
                "type": "range",
                "explanation": "VLAN 范围"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "生成树优先级"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode pvst",
        "explanation": "设置生成树模式为 PVST (Per-VLAN Spanning Tree)",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树模式"
            }
        ]
    },
    "spanning-tree vlan [parameter1] root [parameter2]": {
        "template": "spanning-tree vlan [parameter1] root [parameter2]",
        "command": "spanning-tree vlan 1-10 root secondary",
        "explanation": "设置 VLAN 1-10 的生成树根桥为次根",
        "parameters": [
            {
                "name": "vlan range",
                "type": "range",
                "explanation": "VLAN 范围"
            },
            {
                "name": "root type",
                "type": "string",
                "explanation": "根桥类型"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建桥接域 10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为交换端口",
            "parameters": []
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "启用 PortFast 特性，使接口在连接时立即进入转发状态",
            "parameters": []
        },
        "spanning-tree guard root": {
            "template": "spanning-tree guard root",
            "command": "spanning-tree guard root",
            "explanation": "启用根保护，防止接口成为根端口",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1-20",
            "explanation": "配置子接口的 802.1Q 封装，VLAN 范围为 1-20",
            "parameters": [
                {
                    "name": "vlan range",
                    "type": "range",
                    "explanation": "VLAN 范围"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域 10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}