{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device1",
        "explanation": "设置设备的主机名为 'Device1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.50.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.50.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 6.6.6.6 255.255.255.255 192.168.50.2",
        "explanation": "配置静态路由，目的地址为 6.6.6.6/32，下一跳为 192.168.50.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}