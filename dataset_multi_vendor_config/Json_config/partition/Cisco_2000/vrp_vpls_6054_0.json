        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名称"
            }
        ],
        "service ma [parameter1]": {
            "template": "service ma [parameter1]",
            "command": "service ma ma1",
            "explanation": "配置服务 MA 'ma1'",
            "parameters": [
                {
                    "name": "service ma name",
                    "type": "string",
                    "explanation": "服务 MA 名称"
                }
            ],
            "vlan [parameter1]": {
                "template": "vlan [parameter1]",
                "command": "vlan 10",
                "explanation": "配置 VLAN 10",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep id [parameter1] interface [parameter2] direction [parameter3]": {
                "template": "mep id [parameter1] interface [parameter2] direction [parameter3]",
                "command": "mep id 1 interface GigabitEthernet1/0/0 direction transmit",
                "explanation": "配置 MEP ID 1，接口为 GigabitEthernet1/0/0，方向为传输",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep id [parameter1] ccm-send": {
                "template": "mep id [parameter1] ccm-send",
                "command": "mep id 1 ccm-send",
