                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep id [parameter1]": {
                "template": "remote-mep id [parameter1]",
                "command": "remote-mep id 2",
                "explanation": "配置远程 MEP ID 2",
                "parameters": [
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程 MEP ID"
                    }
                ]
            },
            "remote-mep id [parameter1] ccm-receive": {
                "template": "remote-mep id [parameter1] ccm-receive",
                "command": "remote-mep id 2 ccm-receive",
                "explanation": "配置远程 MEP ID 2 接收 CCM",
                "parameters": [
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程 MEP ID"
                    }
                ]
