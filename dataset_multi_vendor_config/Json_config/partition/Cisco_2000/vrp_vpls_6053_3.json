{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ASBR2",
        "explanation": "设置设备的主机名为 'ASBR2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置MPLS标签分发协议为LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.30.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.30.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP转发",
            "parameters": []
        },
        "mpls ldp autoconfig": {
            "template": "mpls ldp autoconfig",
            "command": "mpls ldp autoconfig",
            "explanation": "在接口上自动配置LDP",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置BGP路由进程，AS号为200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 4.4.4.4 remote-as 200",
            "explanation": "配置BGP邻居，IP地址为4.4.4.4，AS号为200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 10.20.1.1 update-source GigabitEthernet1/0/0",
            "explanation": "配置BGP邻居10.20.1.1的更新源为接口GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的IP地址"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "更新源接口名"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入IPv4地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 4.4.4.4 activate",
                "explanation": "激活BGP邻居4.4.4.4的IPv4地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的IP地址"
                    }
                ]
            },
            "neighbor [parameter1] route-policy [parameter2] [parameter3]": {
                "template": "neighbor [parameter1] route-policy [parameter2] [parameter3]",
                "command": "neighbor 4.4.4.4 route-policy policy1 out",
                "explanation": "为BGP邻居4.4.4.4的出站路由应用路由策略policy1",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的IP地址"
                    },
                    {
                        "name": "route policy",
                        "type": "string",
                        "explanation": "路由策略名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "策略应用方向"
                    }
                ]
            },
            "neighbor [parameter1] send-label": {
                "template": "neighbor [parameter1] send-label",
                "command": "neighbor 4.4.4.4 send-label",
                "explanation": "向BGP邻居4.4.4.4发送MPLS标签",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的IP地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF路由进程，进程号为1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 3.3.3.3 0.0.0.0 area 0",
            "explanation": "将IP地址3.3.3.3/32加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map policy1 permit 10",
        "explanation": "配置路由策略policy1，序列号为10，动作为允许",
        "parameters": [
            {
                "name": "route map name",
                "type": "string",
                "explanation": "路由策略名"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "match mpls-label": {
            "template": "match mpls-label",
            "command": "match mpls-label",
            "explanation": "匹配MPLS标签",
            "parameters": []
        },
        "set mpls-label": {
            "template": "set mpls-label",
            "command": "set mpls-label",
            "explanation": "设置MPLS标签",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}