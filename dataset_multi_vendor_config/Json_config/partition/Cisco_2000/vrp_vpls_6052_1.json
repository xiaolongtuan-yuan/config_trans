{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制使用 Loopback1 接口的 IP 地址作为 LDP 的 Router ID",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 10",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect vfi [parameter1]": {
            "template": "xconnect vfi [parameter1]",
            "command": "xconnect vfi bgpad1",
            "explanation": "将子接口连接到虚拟转发实例 'bgpad1'",
            "parameters": [
                {
                    "name": "VFI name",
                    "type": "string",
                    "explanation": "虚拟转发实例名"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 路由进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2.2.2.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 2.2.2.2，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 2.2.2.2 update-source Loopback1",
            "explanation": "配置 BGP 更新源为 Loopback1 接口",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "更新源接口"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 和 IGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2.2.2.2 activate",
                "explanation": "在 IPv4 地址族下激活邻居 2.2.2.2",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            }
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family l2vpn vpls",
            "explanation": "进入 L2VPN VPLS 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                },
                {
                    "name": "sub-address family",
                    "type": "string",
                    "explanation": "子地址族"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2.2.2.2 activate",
                "explanation": "在 L2VPN VPLS 地址族下激活邻居 2.2.2.2",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 路由进程，进程号为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.1.1 0.0.0.0 area 0",
            "explanation": "在 OSPF 中宣告网络 1.1.1.1/32 属于区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
