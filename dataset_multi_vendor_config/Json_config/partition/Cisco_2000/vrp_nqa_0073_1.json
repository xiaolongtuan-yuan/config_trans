{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip domain lookup": {
        "template": "ip domain lookup",
        "command": "ip domain lookup",
        "explanation": "启用域名解析功能",
        "parameters": []
    },
    "ip name-server [parameter1]": {
        "template": "ip name-server [parameter1]",
        "command": "ip name-server 10.3.1.1",
        "explanation": "配置DNS服务器地址为10.3.1.1",
        "parameters": [
            {
                "name": "DNS server address",
                "type": "IPv4",
                "explanation": "DNS服务器地址"
            }
        ]
    },
    "ip sla [parameter1]": {
        "template": "ip sla [parameter1]",
        "command": "ip sla 1",
        "explanation": "配置IP SLA实例1",
        "parameters": [
            {
                "name": "SLA instance number",
                "type": "integer",
                "explanation": "SLA实例编号"
            }
        ],
        "dns [parameter1]": {
            "template": "dns [parameter1]",
            "command": "dns www.Server.com",
            "explanation": "配置DNS测试的目标域名为www.Server.com",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "域名"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]": {
        "template": "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]",
        "command": "ip sla schedule 1 life forever start-time now",
        "explanation": "配置IP SLA实例1的调度，生命周期为永久，立即开始",
        "parameters": [
            {
                "name": "SLA instance number",
                "type": "integer",
                "explanation": "SLA实例编号"
            },
            {
                "name": "life",
                "type": "string",
                "explanation": "生命周期"
            },
            {
                "name": "start-time",
                "type": "string",
                "explanation": "开始时间"
            }
        ]
    }
}