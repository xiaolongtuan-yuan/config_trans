{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入 VLAN 2 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ethernet cfm": {
        "template": "ethernet cfm",
        "command": "ethernet cfm",
        "explanation": "进入以太网连接故障管理（CFM）配置模式",
        "parameters": [],
        "cfm version [parameter1]": {
            "template": "cfm version [parameter1]",
            "command": "cfm version 0",
            "explanation": "设置 CFM 版本为 0",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "CFM 版本"
                }
            ]
        },
        "cfm domain [parameter1]": {
            "template": "cfm domain [parameter1]",
            "command": "cfm domain default",
            "explanation": "进入默认 CFM 域的配置模式",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "CFM 域名"
                }
            ],
            "service cfm": {
                "template": "service cfm",
                "command": "service cfm",
                "explanation": "在 CFM 域中启用服务",
                "parameters": []
            }
        },
        "mep domain [parameter1]": {
            "template": "mep domain [parameter1]",
            "command": "mep domain md3",
            "explanation": "进入维护端点（MEP）域 'md3' 的配置模式",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "MEP 域名"
                }
            ],
            "mep ma [parameter1]": {
                "template": "mep ma [parameter1]",
                "command": "mep ma ma3",
                "explanation": "进入维护关联（MA）'ma3' 的配置模式",
                "parameters": [
                    {
                        "name": "ma name",
                        "type": "string",
                        "explanation": "维护关联名"
                    }
                ],
                "mep interface [parameter1]": {
                    "template": "mep interface [parameter1]",
                    "command": "mep interface GigabitEthernet1/0/1",
                    "explanation": "指定 MEP 的接口为 'GigabitEthernet1/0/1'",
                    "parameters": [
                        {
                            "name": "interface name",
                            "type": "string",
                            "explanation": "接口名"
                        }
                    ]
                },
                "mep id [parameter1] mep-direction [parameter2]": {
                    "template": "mep id [parameter1] mep-direction [parameter2]",
                    "command": "mep id 4 mep-direction transmit",
                    "explanation": "配置 MEP ID 为 4，方向为传输",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        },
                        {
                            "name": "direction",
                            "type": "string",
                            "explanation": "MEP 方向"
                        }
                    ]
                },
                "ccm-send mep-id [parameter1] enable": {
                    "template": "ccm-send mep-id [parameter1] enable",
                    "command": "ccm-send mep-id 4 enable",
                    "explanation": "启用 MEP ID 为 4 的连续性检查消息（CCM）发送",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        }
                    ]
                },
                "ccm-receive mep-id [parameter1] enable": {
                    "template": "ccm-receive mep-id [parameter1] enable",
                    "command": "ccm-receive mep-id 3 enable",
                    "explanation": "启用 MEP ID 为 3 的连续性检查消息（CCM）接收",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        }
                    ]
                },
                "mep test [parameter1] mep-src-id [parameter2] mep-dst-id [parameter3]": {
                    "template": "mep test [parameter1] mep-src-id [parameter2] mep-dst-id [parameter3]",
                    "command": "mep test 1 mep-src-id 4 mep-dst-id 3",
                    "explanation": "配置 MEP 测试，测试 ID 为 1，源 MEP ID 为 4，目的 MEP ID 为 3",
                    "parameters": [
                        {
                            "name": "test id",
                            "type": "integer",
                            "explanation": "测试 ID"
                        },
                        {
                            "name": "source mep id",
                            "type": "integer",
                            "explanation": "源 MEP ID"
                        },
                        {
                            "name": "destination mep id",
                            "type": "integer",
                            "explanation": "目的 MEP ID"
                        }
                    ]
                },
                "loss-measurement dual-ended test-id [parameter1]": {
                    "template": "loss-measurement dual-ended test-id [parameter1]",
                    "command": "loss-measurement dual-ended test-id 1",
                    "explanation": "启用双端丢失测量，测试 ID 为 1",
                    "parameters": [
                        {
                            "name": "test id",
                            "type": "integer",
                            "explanation": "测试 ID"
                        }
                    ]
                }
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许 VLAN 2 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    }
}