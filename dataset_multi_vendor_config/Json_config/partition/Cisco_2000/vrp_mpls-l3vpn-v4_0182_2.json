{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ASBR1",
        "explanation": "设置设备的主机名为 'ASBR1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 路由进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 192.168.1.2 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 192.168.1.2，远程 AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.1.2 activate",
                "explanation": "激活邻居 192.168.1.2 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        },
        "address-family ipv4 labeled-unicast": {
            "template": "address-family ipv4 labeled-unicast",
            "command": "address-family ipv4 labeled-unicast",
            "explanation": "进入 IPv4 标签单播地址族配置模式",
            "parameters": [],
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 1.1.1.9 mask 255.255.255.255",
                "explanation": "在 BGP 中通告网络 1.1.1.9/32",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.1.2 activate",
                "explanation": "激活邻居 192.168.1.2 的 IPv4 标签单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 路由进程，进程 ID 为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "进程 ID"
            }
        ],
        "redistribute bgp [parameter1] subnets": {
            "template": "redistribute bgp [parameter1] subnets",
            "command": "redistribute bgp 100 subnets",
            "explanation": "将 BGP 100 的路由重分发到 OSPF 中，包括子网",
            "parameters": [
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.9 0.0.0.0 area 0",
            "explanation": "将网络 2.2.2.9/32 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    }
}