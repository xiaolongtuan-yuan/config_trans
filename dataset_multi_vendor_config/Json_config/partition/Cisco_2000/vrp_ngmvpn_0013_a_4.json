{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用稀疏模式的PIM（协议独立组播）",
            "parameters": []
        },
        "ip igmp version [parameter1]": {
            "template": "ip igmp version [parameter1]",
            "command": "ip igmp version 3",
            "explanation": "在接口上启用IGMP版本3",
            "parameters": [
                {
                    "name": "IGMP version",
                    "type": "integer",
                    "explanation": "IGMP版本"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 2",
        "explanation": "启用OSPF进程2",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 6.6.6.6 0.0.0.0 area 0",
            "explanation": "将6.6.6.6/32网络加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ip pim rp-address [parameter1]": {
        "template": "ip pim rp-address [parameter1]",
        "command": "ip pim rp-address 1.1.1.1",
        "explanation": "配置PIM的RP（Rendezvous Point）地址为1.1.1.1",
        "parameters": [
            {
                "name": "RP address",
                "type": "IPv4",
                "explanation": "RP地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}