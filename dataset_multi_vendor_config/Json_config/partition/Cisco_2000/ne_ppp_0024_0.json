{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "配置接口 'Lmpif1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "service-module type [parameter1]": {
            "template": "service-module type [parameter1]",
            "command": "service-module type pppoe-client",
            "explanation": "配置接口为 PPPoE 客户端类型",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "类型"
                }
            ]
        },
        "pppoe-client dial-pool-number [parameter1]": {
            "template": "pppoe-client dial-pool-number [parameter1]",
            "command": "pppoe-client dial-pool-number 1",
            "explanation": "配置 PPPoE 客户端使用拨号池 1",
            "parameters": [
                {
                    "name": "dial-pool-number",
                    "type": "integer",
                    "explanation": "拨号池编号"
                }
            ]
        }
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "启用 AAA 新模型",
        "parameters": []
    },
    "aaa authentication ppp default group [parameter1]": {
        "template": "aaa authentication ppp default group [parameter1]",
        "command": "aaa authentication ppp default group local",
        "explanation": "配置 PPP 默认使用本地组进行认证",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "组名"
            }
        ]
    },
    "aaa authorization network default group [parameter1]": {
        "template": "aaa authorization network default group [parameter1]",
        "command": "aaa authorization network default group local",
        "explanation": "配置网络服务默认使用本地组进行授权",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "组名"
            }
        ]
    },
    "username [parameter1] password [parameter2]": {
        "template": "username [parameter1] password [parameter2]",
        "command": "username rtb password 0 @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
        "explanation": "配置用户 'rtb' 的密码",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "dialer-list [parameter1] protocol [parameter2] [parameter3]": {
        "template": "dialer-list [parameter1] protocol [parameter2] [parameter3]",
        "command": "dialer-list 1 protocol ip permit",
        "explanation": "配置拨号列表 1 允许 IP 协议",
        "parameters": [
            {
                "name": "dialer-list number",
                "type": "integer",
                "explanation": "拨号列表编号"
            },
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作"
            }
        ]
    },
    "ip local pool [parameter1] [parameter2] [parameter3]": {
        "template": "ip local pool [parameter1] [parameter2] [parameter3]",
        "command": "ip local pool pool1 10.110.0.2 10.110.0.254",
        "explanation": "配置本地 IP 地址池 'pool1'，范围从 10.110.0.2 到 10.110.0.254",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "地址池名称"
            },
            {
                "name": "start ip",
                "type": "IPv4",
                "explanation": "起始 IP 地址"
            },
            {
                "name": "end ip",
                "type": "IPv4",
                "explanation": "结束 IP 地址"
            }
        ]
    }
}