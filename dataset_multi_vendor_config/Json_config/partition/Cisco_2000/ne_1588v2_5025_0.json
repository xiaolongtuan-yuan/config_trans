{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp domain [parameter1]": {
        "template": "ptp domain [parameter1]",
        "command": "ptp domain 1",
        "explanation": "配置PTP域为1",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "PTP域编号"
            }
        ]
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type bc",
        "explanation": "设置PTP设备类型为边界时钟",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "设备类型"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.0.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为172.16.0.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ptp clock-domain [parameter1]": {
            "template": "ptp clock-domain [parameter1]",
            "command": "ptp clock-domain 1",
            "explanation": "配置PTP时钟域为1",
            "parameters": [
                {
                    "name": "clock domain number",
                    "type": "integer",
                    "explanation": "时钟域编号"
                }
            ]
        },
        "ptp delay-mechanism [parameter1]": {
            "template": "ptp delay-mechanism [parameter1]",
            "command": "ptp delay-mechanism pdelay",
            "explanation": "配置PTP延迟机制为pdelay",
            "parameters": [
                {
                    "name": "delay mechanism",
                    "type": "string",
                    "explanation": "延迟机制类型"
                }
            ]
        },
        "ptp announce receipt-timeout [parameter1]": {
            "template": "ptp announce receipt-timeout [parameter1]",
            "command": "ptp announce receipt-timeout 10",
            "explanation": "设置PTP公告接收超时时间为10秒",
            "parameters": [
                {
                    "name": "timeout value",
                    "type": "integer",
                    "explanation": "超时时间（秒）"
                }
            ]
        },
        "ptp min_pdelay_req_interval [parameter1]": {
            "template": "ptp min_pdelay_req_interval [parameter1]",
            "command": "ptp min_pdelay_req_interval 10",
            "explanation": "设置最小pdelay请求间隔为10秒",
            "parameters": [
                {
                    "name": "interval value",
                    "type": "integer",
                    "explanation": "间隔时间（秒）"
                }
            ]
        },
        "ptp udp-egress source-ip [parameter1] destination-ip [parameter2]": {
            "template": "ptp udp-egress source-ip [parameter1] destination-ip [parameter2]",
            "command": "ptp udp-egress source-ip 172.16.0.2 destination-ip 172.16.0.1",
            "explanation": "配置PTP UDP出口的源IP和目标IP",
            "parameters": [
                {
                    "name": "source-ip",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "destination-ip",
                    "type": "IPv4",
                    "explanation": "目标IP地址"
                }
            ]
        },
        "ptp udp-egress destination-mac [parameter1]": {
            "template": "ptp udp-egress destination-mac [parameter1]",
            "command": "ptp udp-egress destination-mac 00e0.fc11.1111",
            "explanation": "配置PTP UDP出口的目标MAC地址",
            "parameters": [
                {
                    "name": "destination-mac",
                    "type": "MAC",
                    "explanation": "目标MAC地址"
                }
            ]
        },
        "ptp announce-drop enable": {
            "template": "ptp announce-drop enable",
            "command": "ptp announce-drop enable",
            "explanation": "启用PTP公告丢弃功能",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入OSPF路由器配置模式，进程ID为1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.0.0 0.0.0.255 area 0",
            "explanation": "将网络172.16.0.0/24加入OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域编号"
                }
            ]
        }
    }
}