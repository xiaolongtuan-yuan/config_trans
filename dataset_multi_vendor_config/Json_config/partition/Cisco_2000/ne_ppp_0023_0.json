            "parameters": [
                {
                    "name": "authentication type",
                    "type": "string",
                    "explanation": "认证类型"
                }
            ]
        },
        "ppp chap hostname [parameter1]": {
            "template": "ppp chap hostname [parameter1]",
            "command": "ppp chap hostname rta",
            "explanation": "设置 PPP CHAP 的主机名为 'rta'",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "主机名"
                }
            ]
        }
    },
