            "explanation": "设置封装类型为 PPP",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.110.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
