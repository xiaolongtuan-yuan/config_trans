        "template": "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]",
        "command": "ip sla schedule 1 life forever start-time now",
        "explanation": "配置 IP SLA 操作 1 的调度，生命周期为永久，立即开始",
        "parameters": [
            {
                "name": "operation number",
                "type": "integer",
                "explanation": "IP SLA 操作号"
            },
            {
                "name": "life",
                "type": "string",
                "explanation": "生命周期"
            },
            {
                "name": "start time",
                "type": "string",
                "explanation": "开始时间"
            }
        ]
    },
