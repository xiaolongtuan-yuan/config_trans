        "template": "ip sla auto discovery bfd",
        "command": "ip sla auto discovery bfd",
        "explanation": "启用 IP SLA 自动发现 BFD",
        "parameters": []
    },
    "bfd interval min_rx [parameter1] min_tx [parameter2] multiplier [parameter3]": {
        "template": "bfd interval min_rx [parameter1] min_tx [parameter2] multiplier [parameter3]",
        "command": "bfd interval min_rx 150 min_tx 150 multiplier 3",
        "explanation": "配置 BFD 间隔，最小接收间隔为 150 毫秒，最小发送间隔为 150 毫秒，乘数为 3",
        "parameters": [
            {
                "name": "minimum receive interval",
                "type": "integer",
                "explanation": "最小接收间隔（毫秒）"
            },
            {
                "name": "minimum transmit interval",
                "type": "integer",
                "explanation": "最小发送间隔（毫秒）"
            },
            {
                "name": "multiplier",
                "type": "integer",
                "explanation": "乘数"
            }
        ]
    },
