                },
                {
                    "name": "bfd session",
                    "type": "integer",
                    "explanation": "BFD 会话号"
                },
                {
                    "name": "priority decrement",
                    "type": "integer",
                    "explanation": "优先级降低值"
                }
            ]
        }
    },
    "track [parameter1] bfd": {
        "template": "track [parameter1] bfd",
        "command": "track 1 bfd",
