{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "强制使用 Loopback0 接口的 IP 地址作为 MPLS LDP 的路由器 ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议名称"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由进程配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0001.0000.0000.0004.00",
            "explanation": "配置 IS-IS 的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置 IS-IS 路由器的类型为 Level-1",
            "parameters": [
                {
                    "name": "IS type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.18.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.18.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        },
        "isis metric-style [parameter1]": {
            "template": "isis metric-style [parameter1]",
            "command": "isis metric-style wide",
            "explanation": "配置 IS-IS 使用宽度量风格",
            "parameters": [
                {
                    "name": "metric style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "isis prefix-sid-index [parameter1]": {
            "template": "isis prefix-sid-index [parameter1]",
            "command": "isis prefix-sid-index 20",
            "explanation": "配置 IS-IS 前缀 SID 索引为 20",
            "parameters": [
                {
                    "name": "prefix SID index",
                    "type": "integer",
                    "explanation": "前缀 SID 索引"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
