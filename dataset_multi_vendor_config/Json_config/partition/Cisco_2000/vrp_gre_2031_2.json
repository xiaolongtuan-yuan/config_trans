{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/0",
        "explanation": "配置接口 'GigabitEthernet 1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.21.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.21.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到 GRE 隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol gre",
            "explanation": "设置隧道协议为 GRE",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 172.21.1.2",
            "explanation": "设置隧道源地址为 172.21.1.2",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 172.20.1.1",
            "explanation": "设置隧道目的地址为 172.20.1.1",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPF 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域 ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.21.1.0 0.0.0.255",
                "explanation": "在 OSPF 中通告网络 172.21.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.1.1.0 255.255.255.0 Tunnel1",
        "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳为 Tunnel1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}