{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::2/96",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1::2，前缀长度为 96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        }
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route ::/0 GigabitEthernet1/0/0",
        "explanation": "配置 IPv6 默认路由，下一跳为接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "destination prefix",
                "type": "IPv6",
                "explanation": "目标前缀"
            },
            {
                "name": "next hop interface",
                "type": "string",
                "explanation": "下一跳接口"
            }
        ]
    },
    "ipv6 router ripng [parameter1]": {
        "template": "ipv6 router ripng [parameter1]",
        "command": "ipv6 router ripng 1",
        "explanation": "启用 RIPng 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程 ID"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}