{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname client002",
        "explanation": "设置设备的主机名为 'client002'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置接口 'GigabitEthernet0/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.3 255.255.0.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.3.3，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip ssh version [parameter1]": {
        "template": "ip ssh version [parameter1]",
        "command": "ip ssh version 2",
        "explanation": "设置 SSH 版本为 2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "SSH 版本号"
            }
        ]
    },
    "line vty [parameter1] [parameter2]": {
        "template": "line vty [parameter1] [parameter2]",
        "command": "line vty 0 4",
        "explanation": "配置虚拟终端线路 0 到 4",
        "parameters": [
            {
                "name": "start line number",
                "type": "integer",
                "explanation": "起始线路号"
            },
            {
                "name": "end line number",
                "type": "integer",
                "explanation": "结束线路号"
            }
        ],
        "transport input [parameter1]": {
            "template": "transport input [parameter1]",
            "command": "transport input ssh",
            "explanation": "设置输入传输协议为 SSH",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "传输协议"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}