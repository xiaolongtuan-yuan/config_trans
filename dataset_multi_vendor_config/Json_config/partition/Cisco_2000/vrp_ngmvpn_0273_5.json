{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 multicast-routing": {
        "template": "ipv6 multicast-routing",
        "command": "ipv6 multicast-routing",
        "explanation": "启用 IPv6 组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:3::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:3::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0",
            "explanation": "将接口加入到 OSPFv3 进程 1 的区域 0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPFv3 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        },
        "ipv6 pim sparse-mode": {
            "template": "ipv6 pim sparse-mode",
            "command": "ipv6 pim sparse-mode",
            "explanation": "在接口上启用 IPv6 PIM 稀疏模式",
            "parameters": []
        },
        "ipv6 mld join-group [parameter1] source [parameter2]": {
            "template": "ipv6 mld join-group [parameter1] source [parameter2]",
            "command": "ipv6 mld join-group FF3E::1 source 2001:DB8:5::2",
            "explanation": "配置接口加入 IPv6 MLD 组 FF3E::1，并指定源地址为 2001:DB8:5::2",
            "parameters": [
                {
                    "name": "mld group address",
                    "type": "IPv6",
                    "explanation": "MLD 组地址"
                },
                {
                    "name": "source address",
                    "type": "IPv6",
                    "explanation": "源地址"
                }
            ]
        }
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "配置 OSPFv3 进程 1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 10.0.0.4",
            "explanation": "设置 OSPFv3 进程 1 的 Router ID 为 10.0.0.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "area [parameter1] range [parameter2]": {
            "template": "area [parameter1] range [parameter2]",
            "command": "area 0 range 2001:db8:3::/64",
            "explanation": "在 OSPFv3 进程 1 的区域 0 中汇总地址 2001:db8:3::/64",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                },
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "ipv6 pim rp-address [parameter1]": {
        "template": "ipv6 pim rp-address [parameter1]",
        "command": "ipv6 pim rp-address 2001:db8:6::3",
        "explanation": "配置 IPv6 PIM 的 RP 地址为 2001:db8:6::3",
        "parameters": [
            {
                "name": "rp address",
                "type": "IPv6",
                "explanation": "RP 地址"
            }
        ]
    }
}