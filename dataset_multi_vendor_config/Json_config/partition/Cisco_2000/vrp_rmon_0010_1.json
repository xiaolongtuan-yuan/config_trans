{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device",
        "explanation": "设置设备的主机名为 'Device'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.2.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.2.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 10.1.1.0 255.255.255.0 10.2.2.2",
        "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳地址为 10.2.2.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "snmp-server community [parameter1] [parameter2]": {
        "template": "snmp-server community [parameter1] [parameter2]",
        "command": "snmp-server community public RO",
        "explanation": "配置 SNMP 社区字符串为 'public'，权限为只读（RO）",
        "parameters": [
            {
                "name": "community string",
                "type": "string",
                "explanation": "SNMP 社区字符串"
            },
            {
                "name": "permission",
                "type": "string",
                "explanation": "权限类型（RO 为只读，RW 为读写）"
            }
        ]
    },
    "snmp-server host [parameter1] [parameter2]": {
        "template": "snmp-server host [parameter1] [parameter2]",
        "command": "snmp-server host 10.1.1.1 public",
        "explanation": "配置 SNMP 通知发送到主机 10.1.1.1，使用社区字符串 'public'",
        "parameters": [
            {
                "name": "host address",
                "type": "IPv4",
                "explanation": "SNMP 通知接收主机的地址"
            },
            {
                "name": "community string",
                "type": "string",
                "explanation": "SNMP 社区字符串"
            }
        ]
    },
    "rmon event [parameter1] log trap [parameter2] description [parameter3] owner [parameter4]": {
        "template": "rmon event [parameter1] log trap [parameter2] description [parameter3] owner [parameter4]",
        "command": "rmon event 1 log trap public description \"Alarm of interface\" owner userA",
        "explanation": "配置 RMON 事件，事件编号为 1，记录日志并发送 trap，使用社区字符串 'public'，描述为 'Alarm of interface'，所有者为 'userA'",
        "parameters": [
            {
                "name": "event number",
                "type": "integer",
                "explanation": "事件编号"
            },
            {
                "name": "community string",
                "type": "string",
                "explanation": "SNMP 社区字符串"
            },
            {
                "name": "description",
                "type": "string",
                "explanation": "事件描述"
            },
            {
                "name": "owner",
                "type": "string",
                "explanation": "事件所有者"
            }
        ]
    },
    "rmon alarm [parameter1] [parameter2] [parameter3] absolute rising-threshold [parameter4] [parameter5] falling-threshold [parameter6] [parameter7] owner [parameter8]": {
        "template": "rmon alarm [parameter1] [parameter2] [parameter3] absolute rising-threshold [parameter4] [parameter5] falling-threshold [parameter6] [parameter7] owner [parameter8]",
        "command": "rmon alarm 1 ifInOctets.3 5 absolute rising-threshold 1000 1 falling-threshold 100 1 owner userA",
        "explanation": "配置 RMON 告警，告警编号为 1，监控对象为 ifInOctets.3，采样间隔为 5 秒，绝对采样，上升阈值为 1000，事件编号为 1，下降阈值为 100，事件编号为 1，所有者为 'userA'",
        "parameters": [
            {
                "name": "alarm number",
                "type": "integer",
                "explanation": "告警编号"
            },
            {
                "name": "monitored object",
                "type": "string",
                "explanation": "监控对象"
            },
            {
                "name": "sampling interval",
                "type": "integer",
                "explanation": "采样间隔（秒）"
            },
            {
                "name": "rising threshold",
                "type": "integer",
                "explanation": "上升阈值"
            },
            {
                "name": "rising event number",
                "type": "integer",
                "explanation": "上升事件编号"
            },
            {
                "name": "falling threshold",
                "type": "integer",
                "explanation": "下降阈值"
            },
            {
                "name": "falling event number",
                "type": "integer",
                "explanation": "下降事件编号"
            },
            {
                "name": "owner",
                "type": "string",
                "explanation": "告警所有者"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}