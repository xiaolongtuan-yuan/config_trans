{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程，进程号为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "IS-IS 进程号"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 00.0000.0000.0002.00",
            "explanation": "配置 IS-IS 网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip sla monitor [parameter1]": {
            "template": "ip sla monitor [parameter1]",
            "command": "ip sla monitor 1",
            "explanation": "在接口上启用 IP SLA 监控，监控操作号为 1",
            "parameters": [
                {
                    "name": "operation number",
                    "type": "integer",
                    "explanation": "操作号"
                }
            ]
        }
    },
    "ip sla [parameter1]": {
        "template": "ip sla [parameter1]",
        "command": "ip sla 1",
        "explanation": "配置 IP SLA 操作，操作号为 1",
        "parameters": [
            {
                "name": "operation number",
                "type": "integer",
                "explanation": "操作号"
            }
        ],
        "tcp-connect host [parameter1] port [parameter2]": {
            "template": "tcp-connect host [parameter1] port [parameter2]",
            "command": "tcp-connect host 10.1.1.1 port 4000",
            "explanation": "配置 IP SLA 操作为 TCP 连接测试，目标主机为 10.1.1.1，端口为 4000",
            "parameters": [
                {
                    "name": "host",
                    "type": "IPv4",
                    "explanation": "目标主机地址"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "目标端口"
                }
            ]
        },
        "frequency [parameter1]": {
            "template": "frequency [parameter1]",
            "command": "frequency daily",
            "explanation": "设置 IP SLA 操作的频率为每天一次",
            "parameters": [
                {
                    "name": "frequency",
                    "type": "string",
                    "explanation": "操作频率"
                }
            ]
        },
        "start-time [parameter1]": {
            "template": "start-time [parameter1]",
            "command": "start-time 10:00",
            "explanation": "设置 IP SLA 操作的开始时间为 10:00",
            "parameters": [
                {
                    "name": "start time",
                    "type": "time",
                    "explanation": "开始时间"
                }
            ]
        },
        "end-time [parameter1]": {
            "template": "end-time [parameter1]",
            "command": "end-time 10:30",
            "explanation": "设置 IP SLA 操作的结束时间为 10:30",
            "parameters": [
                {
                    "name": "end time",
                    "type": "time",
                    "explanation": "结束时间"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    },
    "write memory": {
        "template": "write memory",
        "command": "write memory",
        "explanation": "将当前配置保存到 NVRAM",
        "parameters": []
    }
}