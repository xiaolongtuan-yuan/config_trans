{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4] track [parameter5]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4] track [parameter5]",
        "command": "ip route 1.1.1.1 255.255.255.255 GigabitEthernet1/0/1 172.16.1.2 track 1",
        "explanation": "配置静态路由，目的地址为 1.1.1.1/32，下一跳为 172.16.1.2，出接口为 GigabitEthernet1/0/1，并启用跟踪对象 1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "destination mask",
                "type": "IPv4",
                "explanation": "目的地址的子网掩码"
            },
            {
                "name": "next-hop interface",
                "type": "string",
                "explanation": "下一跳出接口"
            },
            {
                "name": "next-hop address",
                "type": "IPv4",
                "explanation": "下一跳地址"
            },
            {
                "name": "track object",
                "type": "integer",
                "explanation": "跟踪对象编号"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}