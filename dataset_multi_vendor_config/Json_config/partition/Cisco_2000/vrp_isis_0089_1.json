{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "isis circuit-level [parameter1]": {
            "template": "isis circuit-level [parameter1]",
            "command": "isis circuit-level level-1",
            "explanation": "配置 IS-IS 电路级别为 level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS 级别"
                }
            ]
        },
        "ipv6 unicast-routing": {
            "template": "ipv6 unicast-routing",
            "command": "ipv6 unicast-routing",
            "explanation": "启用 IPv6 单播路由",
            "parameters": []
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0002.00",
            "explanation": "配置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1] [parameter2]": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8:2::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:2::2，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "ipv6 router isis [parameter1]": {
            "template": "ipv6 router isis [parameter1]",
            "command": "ipv6 router isis 1",
            "explanation": "在接口上启用 IS-IS 路由进程 1 的 IPv6 路由",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS 进程 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}