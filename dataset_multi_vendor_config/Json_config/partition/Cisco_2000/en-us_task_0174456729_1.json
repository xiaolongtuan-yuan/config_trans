{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置标签协议为LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签协议名称"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "启用MPLS IP功能",
        "parameters": []
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "设置LDP路由器ID为Loopback1，并强制使用",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称"
            },
            {
                "name": "force",
                "type": "keyword",
                "explanation": "强制使用指定的接口作为路由器ID"
            }
        ]
    },
    "router [parameter1]": {
        "template": "router [parameter1]",
        "command": "router isis",
        "explanation": "进入ISIS路由器配置模式",
        "parameters": [
            {
                "name": "routing protocol",
                "type": "string",
                "explanation": "路由协议名称"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0002.00",
            "explanation": "配置ISIS的NET地址",
            "parameters": [
                {
                    "name": "net address",
                    "type": "string",
                    "explanation": "ISIS的NET地址"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置ISIS的类型为Level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS的层级类型"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置度量风格为宽度量",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "度量风格类型"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置ISIS网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        },
        "isis metric [parameter1]": {
            "template": "isis metric [parameter1]",
            "command": "isis metric 10",
            "explanation": "设置ISIS的度量值为10",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值"
                }
            ]
        }
    }
}