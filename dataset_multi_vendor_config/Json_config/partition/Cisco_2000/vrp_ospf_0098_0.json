{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip ospf [parameter1] area [parameter2]": {
            "template": "ip ospf [parameter1] area [parameter2]",
            "command": "ip ospf 1 area 0.0.0.0",
            "explanation": "将接口加入 OSPF 进程 1，区域 0.0.0.0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 1.1.1.1",
            "explanation": "设置 OSPF 路由器的 ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF 路由器 ID"
                }
            ]
        },
        "maximum-paths [parameter1]": {
            "template": "maximum-paths [parameter1]",
            "command": "maximum-paths 2",
            "explanation": "设置 OSPF 最大路径数为 2",
            "parameters": [
                {
                    "name": "maximum paths",
                    "type": "integer",
                    "explanation": "最大路径数"
                }
            ]
        }
    },
    "network [parameter1] [parameter2] area [parameter3]": {
        "template": "network [parameter1] [parameter2] area [parameter3]",
        "command": "network 10.1.1.0 0.0.0.255 area 0.0.0.0",
        "explanation": "将网络 10.1.1.0/24 加入 OSPF 区域 0.0.0.0",
        "parameters": [
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            },
            {
                "name": "wildcard mask",
                "type": "IPv4",
                "explanation": "通配符掩码"
            },
            {
                "name": "area id",
                "type": "IPv4",
                "explanation": "OSPF 区域 ID"
            }
        ]
    }
}