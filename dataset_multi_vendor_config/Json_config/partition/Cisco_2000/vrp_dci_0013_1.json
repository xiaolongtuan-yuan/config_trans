            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居 1.1.1.1，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.1 update-source Loopback1",
            "explanation": "配置 BGP 邻居 1.1.1.1 使用 Loopback1 作为更新源",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "更新源接口名"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
            "explanation": "配置 IPv4 单播地址族",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 1.1.1.1 activate",
                "explanation": "激活邻居 1.1.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] route-reflector-client": {
                "template": "neighbor [parameter1] route-reflector-client",
                "command": "neighbor 1.1.1.1 route-reflector-client",
                "explanation": "配置邻居 1.1.1.1 为路由反射器客户端",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程号为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程号"
            }
        ],
        "mpls traffic-eng area": {
            "template": "mpls traffic-eng area",
            "command": "mpls traffic-eng area",
            "explanation": "在 OSPF 区域中启用 MPLS 流量工程",
            "parameters": []
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.2 0.0.0.0 area 0",
            "explanation": "将网络 2.2.2.2/32 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "mpls traffic-eng router-id [parameter1]": {
        "template": "mpls traffic-eng router-id [parameter1]",
        "command": "mpls traffic-eng router-id Loopback1",
        "explanation": "配置 MPLS 流量工程的路由器 ID 为 Loopback1 接口的 IP 地址",
        "parameters": [
            {
                "name": "router ID",
                "type": "string",
                "explanation": "路由器 ID"
            }
        ]
    }
