                "template": "neighbor [parameter1] route-map [parameter2] [parameter3]",
                "command": "neighbor 11.1.1.2 route-map policy1 out",
                "explanation": "对 BGP 邻居 11.1.1.2 的出站路由应用路由映射 policy1",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（in/out）"
                    }
                ]
            },
            "neighbor [parameter1] send-label": {
                "template": "neighbor [parameter1] send-label",
                "command": "neighbor 11.1.1.2 send-label",
                "explanation": "向 BGP 邻居 11.1.1.2 发送 MPLS 标签",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
