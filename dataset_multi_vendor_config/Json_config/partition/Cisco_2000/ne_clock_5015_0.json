{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "network-clock synchronization enable": {
        "template": "network-clock synchronization enable",
        "command": "network-clock synchronization enable",
        "explanation": "启用网络时钟同步",
        "parameters": []
    },
    "network-clock select [parameter1] [parameter2]": {
        "template": "network-clock select [parameter1] [parameter2]",
        "command": "network-clock select 1 BITS0",
        "explanation": "选择时钟源 1 为 BITS0",
        "parameters": [
            {
                "name": "时钟源编号",
                "type": "integer",
                "explanation": "时钟源的编号"
            },
            {
                "name": "时钟源名称",
                "type": "string",
                "explanation": "时钟源的名称"
            }
        ]
    },
    "network-clock select [parameter1] output [parameter2]": {
        "template": "network-clock select [parameter1] output [parameter2]",
        "command": "network-clock select 1 output 2M",
        "explanation": "选择时钟源 1 的输出为 2M",
        "parameters": [
            {
                "name": "时钟源编号",
                "type": "integer",
                "explanation": "时钟源的编号"
            },
            {
                "name": "输出类型",
                "type": "string",
                "explanation": "输出的时钟频率"
            }
        ]
    },
    "network-clock priority [parameter1] [parameter2] [parameter3]": {
        "template": "network-clock priority [parameter1] [parameter2] [parameter3]",
        "command": "network-clock priority 1 1 BITS0",
        "explanation": "设置时钟源 1 的优先级为 1，名称为 BITS0",
        "parameters": [
            {
                "name": "时钟源编号",
                "type": "integer",
                "explanation": "时钟源的编号"
            },
            {
                "name": "优先级",
                "type": "integer",
                "explanation": "时钟源的优先级"
            },
            {
                "name": "时钟源名称",
                "type": "string",
                "explanation": "时钟源的名称"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock source [parameter1]": {
            "template": "clock source [parameter1]",
            "command": "clock source BITS0",
            "explanation": "设置时钟源为 BITS0",
            "parameters": [
                {
                    "name": "时钟源名称",
                    "type": "string",
                    "explanation": "时钟源的名称"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 2",
            "explanation": "设置时钟优先级为 2",
            "parameters": [
                {
                    "name": "优先级",
                    "type": "integer",
                    "explanation": "时钟优先级"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}