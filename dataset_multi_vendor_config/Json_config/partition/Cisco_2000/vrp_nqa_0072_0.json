{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.11 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.11，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "ip sla [parameter1]": {
        "template": "ip sla [parameter1]",
        "command": "ip sla 1",
        "explanation": "配置 IP SLA 实例 1",
        "parameters": [
            {
                "name": "sla id",
                "type": "integer",
                "explanation": "SLA 实例 ID"
            }
        ],
        "icmp-echo [parameter1] source-ip [parameter2]": {
            "template": "icmp-echo [parameter1] source-ip [parameter2]",
            "command": "icmp-echo 10.1.1.10 source-ip 10.1.2.1",
            "explanation": "配置 ICMP echo 操作，目标地址为 10.1.1.10，源地址为 10.1.2.1",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目标 IPv4 地址"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "源 IPv4 地址"
                }
            ]
        },
        "frequency [parameter1]": {
            "template": "frequency [parameter1]",
            "command": "frequency 600",
            "explanation": "设置操作频率为 600 秒",
            "parameters": [
                {
                    "name": "frequency",
                    "type": "integer",
                    "explanation": "操作频率（秒）"
                }
            ]
        },
        "threshold [parameter1]": {
            "template": "threshold [parameter1]",
            "command": "threshold 200",
            "explanation": "设置操作阈值为 200 毫秒",
            "parameters": [
                {
                    "name": "threshold",
                    "type": "integer",
                    "explanation": "操作阈值（毫秒）"
                }
            ]
        },
        "timeout [parameter1]": {
            "template": "timeout [parameter1]",
            "command": "timeout 1000",
            "explanation": "设置操作超时为 1000 毫秒",
            "parameters": [
                {
                    "name": "timeout",
                    "type": "integer",
                    "explanation": "操作超时（毫秒）"
                }
            ]
        },
        "tag [parameter1]": {
            "template": "tag [parameter1]",
            "command": "tag admin",
            "explanation": "为操作设置标签 'admin'",
            "parameters": [
                {
                    "name": "tag",
                    "type": "string",
                    "explanation": "操作标签"
                }
            ]
        }
    },
    "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]": {
        "template": "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]",
        "command": "ip sla schedule 1 life forever start-time now",
        "explanation": "调度 IP SLA 实例 1 永久运行，立即开始",
        "parameters": [
            {
                "name": "sla id",
                "type": "integer",
                "explanation": "SLA 实例 ID"
            },
            {
                "name": "life",
                "type": "string",
                "explanation": "生命周期"
            },
            {
                "name": "start-time",
                "type": "string",
                "explanation": "开始时间"
            }
        ]
    },
    "ip ftp source-interface [parameter1]": {
        "template": "ip ftp source-interface [parameter1]",
        "command": "ip ftp source-interface GigabitEthernet2/0/0",
        "explanation": "设置 FTP 源接口为 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "source interface",
                "type": "string",
                "explanation": "源接口名"
            }
        ]
    },
    "ip ftp username [parameter1]": {
        "template": "ip ftp username [parameter1]",
        "command": "ip ftp username ftp",
        "explanation": "设置 FTP 用户名为 'ftp'",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            }
        ]
    },
    "ip ftp password [parameter1]": {
        "template": "ip ftp password [parameter1]",
        "command": "ip ftp password %^%#`P'|9L1x62lN*b+C~wMTT|$EA7+z0XOFC_,B$M+\"%^%#",
        "explanation": "设置 FTP 密码",
        "parameters": [
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "ip ftp server [parameter1]": {
        "template": "ip ftp server [parameter1]",
        "command": "ip ftp server 10.1.2.8",
        "explanation": "设置 FTP 服务器地址为 10.1.2.8",
        "parameters": [
            {
                "name": "server ip",
                "type": "IPv4",
                "explanation": "FTP 服务器 IPv4 地址"
            }
        ]
    },
    "ip ftp filename [parameter1]": {
        "template": "ip ftp filename [parameter1]",
        "command": "ip ftp filename test1",
        "explanation": "设置 FTP 文件名为 'test1'",
        "parameters": [
            {
                "name": "filename",
                "type": "string",
                "explanation": "文件名"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
