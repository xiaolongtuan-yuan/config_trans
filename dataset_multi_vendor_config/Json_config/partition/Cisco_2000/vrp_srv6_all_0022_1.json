{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程，进程号为 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程号"
            }
        ],
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置 IS-IS 路由类型为 Level-1",
            "parameters": [
                {
                    "name": "IS-IS level",
                    "type": "string",
                    "explanation": "IS-IS 路由类型"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置 IS-IS 的度量风格为 wide",
            "parameters": [
                {
                    "name": "metric style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0000.0002.00",
            "explanation": "设置 IS-IS 的网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "ipv6 unicast-routing": {
            "template": "ipv6 unicast-routing",
            "command": "ipv6 unicast-routing",
            "explanation": "启用 IPv6 单播路由",
            "parameters": []
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:10::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:10::2，前缀长度为 64",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "isis ipv6 enable": {
            "template": "isis ipv6 enable",
            "command": "isis ipv6 enable",
            "explanation": "在接口上启用 IS-IS 的 IPv6 功能",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}