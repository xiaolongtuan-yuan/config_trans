{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceT",
        "explanation": "设置设备的主机名为 'DeviceT'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4] [parameter5]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4] [parameter5]",
        "command": "ip route 172.17.1.0 255.255.255.0 GigabitEthernet2/0/0 192.168.10.2 40",
        "explanation": "配置静态路由，目的网络为 172.17.1.0/24，下一跳为 192.168.10.2，出接口为 GigabitEthernet2/0/0，管理距离为 40",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "administrative distance",
                "type": "integer",
                "explanation": "管理距离"
            }
        ]
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route 172.17.1.0 255.255.255.0 GigabitEthernet3/0/0 192.168.20.2",
        "explanation": "配置静态路由，目的网络为 172.17.1.0/24，下一跳为 192.168.20.2，出接口为 GigabitEthernet3/0/0",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    }
}