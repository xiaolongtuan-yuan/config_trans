{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Spoke1",
        "explanation": "设置设备的主机名为 'Spoke1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.10 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.2.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode gre ip",
            "explanation": "设置隧道模式为 GRE over IP",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source Loopback0",
            "explanation": "设置隧道的源接口为 Loopback0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 172.16.1.1",
            "explanation": "设置隧道的目的地址为 172.16.1.1",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile <IPSEC_PROFILE_NAME>",
            "explanation": "为隧道配置 IPSec 保护，使用指定的 IPSec 配置文件",
            "parameters": [
                {
                    "name": "ipsec profile name",
                    "type": "string",
                    "explanation": "IPSec 配置文件名"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.2",
            "explanation": "设置 OSPF 路由器的 ID 为 172.16.1.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "passive-interface default": {
            "template": "passive-interface default",
            "command": "passive-interface default",
            "explanation": "默认情况下，所有接口都设置为被动模式",
            "parameters": []
        },
        "no passive-interface [parameter1]": {
            "template": "no passive-interface [parameter1]",
            "command": "no passive-interface GigabitEthernet1/0/0",
            "explanation": "将接口 GigabitEthernet1/0/0 设置为非被动模式",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0",
            "explanation": "将网络 172.16.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    }
}