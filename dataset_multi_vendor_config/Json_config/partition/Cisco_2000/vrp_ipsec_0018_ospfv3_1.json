    "crypto isakmp key [parameter1] address [parameter2]": {
        "template": "crypto isakmp key [parameter1] address [parameter2]",
        "command": "crypto isakmp key %#%#<}j/@XSE9JZT5]2\"T#]2\"T<}j/@XSE9JZT5>%#%# address <peer IP>",
        "explanation": "配置 ISAKMP 预共享密钥和对端 IP 地址",
        "parameters": [
            {
                "name": "pre-shared key",
                "type": "string",
