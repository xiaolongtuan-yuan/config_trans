            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6链路本地地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0.0.0.0",
            "explanation": "在接口上启用IPv6 OSPF，进程ID为1，区域ID为0.0.0.0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        },
        "ipv6 pim sparse-mode": {
            "template": "ipv6 pim sparse-mode",
            "command": "ipv6 pim sparse-mode",
            "explanation": "在接口上启用IPv6 PIM稀疏模式",
            "parameters": []
        }
    },
    "ipv6 pim rp-candidate [parameter1] group-list [parameter2]": {
        "template": "ipv6 pim rp-candidate [parameter1] group-list [parameter2]",
        "command": "ipv6 pim rp-candidate Loopback0 group-list 2001:db8:7::7",
        "explanation": "配置Loopback0接口为IPv6 PIM RP候选，组地址为2001:db8:7::7",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "group address",
                "type": "IPv6",
                "explanation": "组地址"
            }
        ]
    },
    "ipv6 pim bsr-candidate [parameter1]": {
        "template": "ipv6 pim bsr-candidate [parameter1]",
        "command": "ipv6 pim bsr-candidate Loopback0",
