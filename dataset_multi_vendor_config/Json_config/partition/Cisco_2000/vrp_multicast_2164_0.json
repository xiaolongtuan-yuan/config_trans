            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 address [parameter1] link-local": {
            "template": "ipv6 address [parameter1] link-local",
            "command": "ipv6 address FE80::2 link-local",
