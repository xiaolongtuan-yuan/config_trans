{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:2::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "ipv6 bfd [parameter1] bind peer-ipv6 [parameter2] source-ipv6 [parameter3]": {
        "template": "ipv6 bfd [parameter1] bind peer-ipv6 [parameter2] source-ipv6 [parameter3]",
        "command": "ipv6 bfd aa bind peer-ipv6 2001:db8:3::2 source-ipv6 2001:db8:1::1",
        "explanation": "配置 IPv6 BFD 会话，绑定对端 IPv6 地址为 2001:db8:3::2，源 IPv6 地址为 2001:db8:1::1",
        "parameters": [
            {
                "name": "BFD session name",
                "type": "string",
                "explanation": "BFD 会话名称"
            },
            {
                "name": "peer IPv6 address",
                "type": "IPv6",
                "explanation": "对端 IPv6 地址"
            },
            {
                "name": "source IPv6 address",
                "type": "IPv6",
                "explanation": "源 IPv6 地址"
            }
        ],
        "bfd [parameter1] discriminator local [parameter2]": {
            "template": "bfd [parameter1] discriminator local [parameter2]",
            "command": "bfd aa discriminator local 10",
            "explanation": "配置 BFD 会话的本地标识符为 10",
            "parameters": [
                {
                    "name": "BFD session name",
                    "type": "string",
                    "explanation": "BFD 会话名称"
                },
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地标识符"
                }
            ]
        },
        "bfd [parameter1] discriminator remote [parameter2]": {
            "template": "bfd [parameter1] discriminator remote [parameter2]",
            "command": "bfd aa discriminator remote 20",
            "explanation": "配置 BFD 会话的远端标识符为 20",
            "parameters": [
                {
                    "name": "BFD session name",
                    "type": "string",
                    "explanation": "BFD 会话名称"
                },
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端标识符"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route 2001:db8:6::/64 GigabitEthernet1/0/2 2001:db8:1::2",
        "explanation": "配置 IPv6 静态路由，目的网络为 2001:db8:6::/64，出接口为 GigabitEthernet1/0/2，下一跳地址为 2001:db8:1::2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv6",
                "explanation": "目的网络"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next-hop address",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}