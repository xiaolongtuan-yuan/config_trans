{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识符"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM（连通性故障管理）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口的交换端口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "端口模式（trunk或access）"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许VLAN 10通过trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许的VLAN标识符"
                }
            ]
        }
    },
    "ethernet cfm md [parameter1] level [parameter2]": {
        "template": "ethernet cfm md [parameter1] level [parameter2]",
        "command": "ethernet cfm md md1 level 6",
        "explanation": "配置CFM域md1，级别为6",
        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "域级别"
            }
        ]
    },
    "ethernet cfm ma [parameter1]": {
        "template": "ethernet cfm ma [parameter1]",
        "command": "ethernet cfm ma ma1",
        "explanation": "配置CFM维护关联ma1",
        "parameters": [
            {
                "name": "ma name",
                "type": "string",
                "explanation": "维护关联名称"
            }
        ],
        "ethernet cfm ma [parameter1] vlan [parameter2]": {
            "template": "ethernet cfm ma [parameter1] vlan [parameter2]",
            "command": "ethernet cfm ma ma1 vlan 10",
            "explanation": "将VLAN 10关联到维护关联ma1",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "关联的VLAN标识符"
                }
            ]
        },
        "ethernet cfm ma [parameter1] mep mep-id [parameter2] interface [parameter3]": {
            "template": "ethernet cfm ma [parameter1] mep mep-id [parameter2] interface [parameter3]",
            "command": "ethernet cfm ma ma1 mep mep-id 2 interface GigabitEthernet1/0/1",
            "explanation": "在接口GigabitEthernet1/0/1上配置MEP ID 2 for MA ma1",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP标识符"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "ethernet cfm ma [parameter1] mep mep-id [parameter2] ccm-send": {
            "template": "ethernet cfm ma [parameter1] mep mep-id [parameter2] ccm-send",
            "command": "ethernet cfm ma ma1 mep mep-id 2 ccm-send",
            "explanation": "配置MEP ID 2 for MA ma1发送CCM",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP标识符"
                }
            ]
        },
        "ethernet cfm ma [parameter1] remote-mep mep-id [parameter2]": {
            "template": "ethernet cfm ma [parameter1] remote-mep mep-id [parameter2]",
            "command": "ethernet cfm ma ma1 remote-mep mep-id 1",
            "explanation": "配置远程MEP ID 1 for MA ma1",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "远程MEP标识符"
                }
            ]
        },
        "ethernet cfm ma [parameter1] remote-mep mep-id [parameter2] ccm-receive": {
            "template": "ethernet cfm ma [parameter1] remote-mep mep-id [parameter2] ccm-receive",
            "command": "ethernet cfm ma ma1 remote-mep mep-id 1 ccm-receive",
            "explanation": "配置接收来自远程MEP ID 1 for MA ma1的CCM",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "远程MEP标识符"
                }
            ]
        }
    }
}