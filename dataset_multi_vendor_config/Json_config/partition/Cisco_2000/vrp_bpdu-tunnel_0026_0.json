{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN 的标识符"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "配置生成树协议模式为快速 PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许 VLAN 100 通过 trunk 接口",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "允许通过的 VLAN 标识符"
                }
            ]
        },
        "spanning-tree bpdufilter [parameter1]": {
            "template": "spanning-tree bpdufilter [parameter1]",
            "command": "spanning-tree bpdufilter enable",
            "explanation": "启用 BPDU 过滤功能",
            "parameters": [
                {
                    "name": "status",
                    "type": "string",
                    "explanation": "BPDU 过滤状态"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}