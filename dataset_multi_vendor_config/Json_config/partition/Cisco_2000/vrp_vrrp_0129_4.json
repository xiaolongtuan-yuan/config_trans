{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "设置 MPLS LDP 的路由器 ID 为 Loopback1 接口的 IP 地址，并强制使用",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "mpls l2vpn": {
        "template": "mpls l2vpn",
        "command": "mpls l2vpn",
        "explanation": "启用 MPLS L2VPN 功能",
        "parameters": []
    },
    "vsi [parameter1] static": {
        "template": "vsi [parameter1] static",
        "command": "vsi ldp1 static",
        "explanation": "创建名为 'ldp1' 的 VSI（虚拟交换实例），并设置为静态模式",
        "parameters": [
            {
                "name": "vsi name",
                "type": "string",
                "explanation": "VSI 名称"
            }
        ]
    },
    "peer [parameter1] pw-id [parameter2]": {
        "template": "peer [parameter1] pw-id [parameter2]",
        "command": "peer 3.3.3.3 pw-id 100",
        "explanation": "配置对等体 3.3.3.3 的伪线 ID 为 100",
        "parameters": [
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对等体 IP 地址"
            },
            {
                "name": "pseudo-wire id",
                "type": "integer",
                "explanation": "伪线 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "配置接口 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect vfi [parameter1]": {
            "template": "xconnect vfi [parameter1]",
            "command": "xconnect vfi ldp1",
            "explanation": "将子接口连接到 VFI 'ldp1'",
            "parameters": [
                {
                    "name": "vfi name",
                    "type": "string",
                    "explanation": "VFI 名称"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.35.5 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.35.5，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 功能",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP 功能",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 5.5.5.5 0.0.0.0 area 0",
            "explanation": "将 IP 地址 5.5.5.5 加入 OSPF 区域 0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IP 地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    }
}