{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "设置生成树协议模式为快速PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "spanning-tree vlan [parameter1] root [parameter2]": {
        "template": "spanning-tree vlan [parameter1] root [parameter2]",
        "command": "spanning-tree vlan 1-10 root primary",
        "explanation": "设置VLAN 1-10的生成树根桥为主根",
        "parameters": [
            {
                "name": "vlan range",
                "type": "string",
                "explanation": "VLAN范围"
            },
            {
                "name": "root type",
                "type": "string",
                "explanation": "根桥类型"
            }
        ]
    },
    "spanning-tree pathcost method [parameter1]": {
        "template": "spanning-tree pathcost method [parameter1]",
        "command": "spanning-tree pathcost method long",
        "explanation": "设置生成树路径成本计算方法为长",
        "parameters": [
            {
                "name": "method",
                "type": "string",
                "explanation": "路径成本计算方法"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "启用PortFast特性，使接口立即进入转发状态",
            "parameters": []
        },
        "spanning-tree guard root": {
            "template": "spanning-tree guard root",
            "command": "spanning-tree guard root",
            "explanation": "启用根保护，防止接口成为根端口",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1-20",
            "explanation": "配置子接口的802.1Q封装，VLAN范围为1-20",
            "parameters": [
                {
                    "name": "vlan range",
                    "type": "string",
                    "explanation": "VLAN范围"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域10",
            "parameters": [
                {
                    "name": "bridge domain",
                    "type": "integer",
                    "explanation": "桥接域"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}