{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Hub",
        "explanation": "设置设备的主机名为 'Hub'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.10，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode gre multipoint",
            "explanation": "设置隧道模式为GRE多点",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "ip nhrp map multicast dynamic": {
            "template": "ip nhrp map multicast dynamic",
            "command": "ip nhrp map multicast dynamic",
            "explanation": "配置NHRP映射多播地址动态",
            "parameters": []
        },
        "ip nhrp network-id [parameter1]": {
            "template": "ip nhrp network-id [parameter1]",
            "command": "ip nhrp network-id 1",
            "explanation": "设置NHRP网络ID为1",
            "parameters": [
                {
                    "name": "network-id",
                    "type": "integer",
                    "explanation": "网络ID"
                }
            ]
        },
        "ip nhrp nhs [parameter1]": {
            "template": "ip nhrp nhs [parameter1]",
            "command": "ip nhrp nhs 172.16.1.2",
            "explanation": "配置NHRP下一跳服务器为172.16.1.2",
            "parameters": [
                {
                    "name": "nhs-address",
                    "type": "IPv4",
                    "explanation": "下一跳服务器地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 2",
        "explanation": "进入OSPF路由进程配置模式，进程ID为2",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 10.1.1.10",
            "explanation": "设置OSPF路由器ID为10.1.1.10",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.1.0 0.0.0.255 area 0",
            "explanation": "将网络10.1.1.0/24加入OSPF区域0",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard-mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域ID"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 192.168.1.0 255.255.255.0 172.16.1.2",
        "explanation": "配置静态路由到192.168.1.0网络，下一跳为172.16.1.2",
        "parameters": [
            {
                "name": "destination-network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet-mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next-hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    }
}