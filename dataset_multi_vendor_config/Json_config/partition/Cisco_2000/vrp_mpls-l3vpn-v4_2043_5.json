{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 21.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 21.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 300",
        "explanation": "配置 BGP 路由进程，AS 号为 300",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 21.1.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居 21.1.1.1，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 6.6.6.9 update-source Loopback1",
            "explanation": "配置 BGP 邻居 6.6.6.9 的更新源为 Loopback1 接口",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "更新源接口"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "单播"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 21.1.1.1 activate",
                "explanation": "激活 BGP 邻居 21.1.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-policy [parameter2] [parameter3]": {
                "template": "neighbor [parameter1] route-policy [parameter2] [parameter3]",
                "command": "neighbor 21.1.1.1 route-policy policy1 out",
                "explanation": "为 BGP 邻居 21.1.1.1 的出站路由应用路由策略 policy1",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    },
                    {
                        "name": "route policy",
                        "type": "string",
                        "explanation": "路由策略名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（in/out）"
                    }
                ]
            },
            "neighbor [parameter1] send-label": {
                "template": "neighbor [parameter1] send-label",
                "command": "neighbor 21.1.1.1 send-label",
                "explanation": "向 BGP 邻居 21.1.1.1 发送 MPLS 标签",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 路由进程，进程号为 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 5.5.5.9 0.0.0.0 area 0",
            "explanation": "将 IP 地址 5.5.5.9 的接口加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network ip",
                    "type": "IPv4",
                    "explanation": "网络 IP 地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map policy1 permit 10",
        "explanation": "配置路由策略 policy1，允许序列号为 10 的条目",
        "parameters": [
            {
                "name": "route map name",
                "type": "string",
                "explanation": "路由策略名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set mpls label": {
            "template": "set mpls label",
            "command": "set mpls label",
            "explanation": "设置 MPLS 标签",
            "parameters": []
        },
        "match mpls label": {
            "template": "match mpls label",
            "command": "match mpls label",
            "explanation": "匹配 MPLS 标签",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
