{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 路由器，AS 号为 200",
        "parameters": [
            {
                "name": "autonomous system number",
                "type": "integer",
                "explanation": "BGP 的自治系统编号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居 1.1.1.1，其自治系统            编号为 100",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "remote-as number",
                    "type": "integer",
                    "explanation": "邻居的自治系统编号"
                }
            ]
        },
        "neighbor [parameter1] ebgp-multihop [parameter2]": {
            "template": "neighbor [parameter1] ebgp-multihop [parameter2]",
            "command": "neighbor 1.1.1.1 ebgp-multihop 2",
            "explanation": "允许与邻居 1.1.1.1 进行 EBGP 多跳，跳数为 2",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "hop-count",
                    "type": "integer",
                    "explanation": "允许的跳数"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.1 update-source Loopback0",
            "explanation": "指定向邻居 1.1.1.1 发送更新消息的源接口为 Loopback0",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名称"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 与 IGP 的同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 2.2.2.2 mask 255.255.255.255",
                "explanation": "宣告网络 2.2.2.2/32 到 BGP",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "network mask",
                        "type": "IPv4",
                        "explanation": "网络掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 1.1.1.1 activate",
                "explanation": "激活与邻居 1.1.1.1 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-map [parameter2] out": {
                "template": "neighbor [parameter1] route-map [parameter2] out",
                "command": "neighbor 1.1.1.1 route-map aa out",
                "explanation": "在向邻居 1.1.1.1 发送路由时应用路由映射 'aa'",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "应用方向（out）"
                    }
                ]
            },
            "neighbor [parameter1] send-community": {
                "template": "neighbor [parameter1] send-community",
                "command": "neighbor 1.1.1.1 send-community",
                "explanation": "向邻居 1.1.1.1 发送团体属性",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程 ID 为 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.2 0.0.0.0 area 0",
            "explanation": "将网络 2.2.2.2/32 归属于 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "route-map [parameter1] permit [parameter2]": {
        "template": "route-map [parameter1] permit [parameter2]",
        "command": "route-map aa permit 10",
        "explanation": "创建一个名为 'aa' 的路由映射，序列号为 10，允许匹配的路由",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "路由映射的序列号"
            }
        ],
        "match ip address prefix-list [parameter1]": {
            "template": "match ip address prefix-list [parameter1]",
            "command": "match ip address prefix-list bb",
            "explanation": "匹配前缀列表 'bb' 中的 IP 地址",
            "parameters": [
                {
                    "name": "prefix-list name",
                    "type": "string",
                    "explanation": "前缀列表名称"
                }
            ]
        },
        "set community [parameter1]": {
            "template": "set community [parameter1]",
            "command": "set community 10:10",
            "explanation": "设置社区属性为 10:10",
            "parameters": [
                {
                    "name": "community string",
                    "type": "string",
                    "explanation": "社区字符串"
                }
            ]
        }
    },
    "ip prefix-list [parameter1] seq [parameter2] permit [parameter3]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] permit [parameter3]",
        "command": "ip prefix-list bb seq 10 permit 10.1.1.1/32",
        "explanation": "创建前缀列表 'bb'，序列号 10，允许 10.1.1.1/32",
        "parameters": [
            {
                "name": "prefix-list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit 或 deny）"
            },
            {
                "name": "prefix",
                "type": "IPv4 with mask",
                "explanation": "IP 前缀和掩码"
            }
        ]
    }
}