                "explanation": "动作（允许或拒绝）"
            },
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            },
            {
                "name": "source",
                "type": "string",
                "explanation": "源地址"
            },
            {
                "name": "destination",
                "type": "string",
                "explanation": "目的地址"
            }
        ]
    },
