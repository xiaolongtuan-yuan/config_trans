{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname routerB",
        "explanation": "设置设备的主机名为 'routerB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel1",
        "explanation": "配置接口 'Port-channel1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.40.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 1 mode on",
            "explanation": "将接口加入通道组1，模式为on",
            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "通道组模式"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route 10.1.1.0 255.255.255.0 GigabitEthernet2/0/0 10.30.1.1",
        "explanation": "配置静态路由，目标网络10.1.1.0/24，下一跳接口GigabitEthernet2/0/0，下一跳IP10.30.1.1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目标网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出站接口"
            },
            {
                "name": "next hop ip",
                "type": "IPv4",
                "explanation": "下一跳IP地址"
            }
        ]
    }
}