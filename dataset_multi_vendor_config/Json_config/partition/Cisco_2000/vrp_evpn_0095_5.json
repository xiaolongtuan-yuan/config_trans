{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge irb": {
        "template": "bridge irb",
        "command": "bridge irb",
        "explanation": "启用集成路由和桥接功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel10",
        "explanation": "配置接口 'Port-channel10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 100",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 100",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "bridge-group [parameter1]": {
            "template": "bridge-group [parameter1]",
            "command": "bridge-group 10",
            "explanation": "将接口加入到桥接组 10",
            "parameters": [
                {
                    "name": "bridge group number",
                    "type": "integer",
                    "explanation": "桥接组编号"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 10 mode on",
            "explanation": "将接口加入到通道组 10，并设置模式为 on",
            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "通道组模式"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}