{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1000::2/24",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1000::2，前缀长度为 24",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf cost [parameter1]": {
            "template": "ipv6 ospf cost [parameter1]",
            "command": "ipv6 ospf cost 5",
            "explanation": "设置接口的 OSPF 成本为 5",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "OSPF 成本"
                }
            ]
        }
    },
    "ipv6 router ospf [parameter1]": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "配置 OSPFv3 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPF 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用 BFD",
            "parameters": []
        },
        "bfd all-interfaces frr-binding": {
            "template": "bfd all-interfaces frr-binding",
            "command": "bfd all-interfaces frr-binding",
            "explanation": "在所有接口上启用 BFD 与 FRR 的绑定",
            "parameters": []
        },
        "frr": {
            "template": "frr",
            "command": "frr",
            "explanation": "配置 FRR 相关设置",
            "parameters": [],
            "loop-free-alternate": {
                "template": "loop-free-alternate",
                "command": "loop-free-alternate",
                "explanation": "启用无环备用路径",
                "parameters": []
            }
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 1",
            "explanation": "配置 OSPF 区域 1",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}