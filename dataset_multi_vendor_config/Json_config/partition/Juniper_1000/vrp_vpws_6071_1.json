{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching trunk allowed-vlan [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching trunk allowed-vlan [parameter3]",
            "command": "set interfaces xe-1/0/0 unit 0 family ethernet-switching trunk allowed-vlan 10",
            "explanation": "配置接口为以太网交换模式，并允许指定的VLAN通过。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如xe-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "允许通过的VLAN ID。"
                }
            ]
        }
    },
    "delete interfaces": {
        "template": "delete interfaces",
        "delete interfaces [parameter1]": {
            "template": "delete interfaces [parameter1]",
            "command": "delete interfaces ge-1/0/0",
            "explanation": "删除指定接口的配置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols cfm domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4] ccm-send interval [parameter5] remote-mep mep-id [parameter6] ccm-receive": {
            "template": "set protocols cfm domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4] ccm-send interval [parameter5] remote-mep mep-id [parameter6] ccm-receive",
            "command": "set protocols cfm domain md1 mep-id 2 interface xe-1/0/0 direction both ccm-send interval 1 remote-mep mep-id 3 ccm-receive",
            "explanation": "配置CFM（Connectivity Fault Management）协议的域、MEP（Maintenance End Point）ID、接口、方向、CCM发送间隔以及远程MEP的MEP ID和CCM接收。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如xe-1/0/0。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "MEP的方向，可以是up、down或both。"
                },
                {
                    "name": "ccm-send-interval",
                    "type": "integer",
                    "explanation": "CCM发送间隔，单位为秒。"
                },
                {
                    "name": "remote-mep-id",
                    "type": "integer",
                    "explanation": "远程MEP的ID。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4] ccmsend interval [parameter5] remote-mep mep-id [parameter6] ccmmreceive": {
            "template": "set protocols cfm domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4] ccmsend interval [parameter5] remote-mep mep-id [parameter6] ccmmreceive",
            "command": "set protocols cfm domain md2 mep-id 4 interface xe-2/0/0 direction both ccmsend interval 1 remote-mep mep-id 3 ccmmreceive",
            "explanation": "配置CFM（Connectivity Fault Management）协议的域、MEP（Maintenance End Point）ID、接口、方向、CCM发送间隔以及远程MEP的MEP ID和CCM接收。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如xe-2/0/0。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "MEP的方向，可以是up、down或both。"
                },
                {
                    "name": "ccm-send-interval",
                    "type": "integer",
                    "explanation": "CCM发送间隔，单位为秒。"
                },
                {
                    "name": "remote-mep-id",
                    "type": "integer",
                    "explanation": "远程MEP的ID。"
                }
            ]
        }
    }
}