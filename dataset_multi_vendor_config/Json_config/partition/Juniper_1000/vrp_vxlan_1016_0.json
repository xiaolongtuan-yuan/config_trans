{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vxlan vni [parameter2]": {
            "template": "set bridge-domains [parameter1] vxlan vni [parameter2]",
            "command": "set bridge-domains bd-10 vxlan vni 5010",
            "explanation": "配置桥接域的VXLAN VNI。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符。"
                }
            ]
        },
        "set bridge-domains [parameter1] interface [parameter2]": {
            "template": "set bridge-domains [parameter1] interface [parameter2]",
            "command": "set bridge-domains bd-10 interface ge-0/0/2.1",
            "explanation": "将接口添加到桥接域。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，包括单元号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2]": {
            "template": "set interfaces [parameter1] unit [parameter2]",
            "command": "set interfaces ge-0/0/2 unit 0",
            "explanation": "配置接口的单元号。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 1 encapsulation vlan-bridge",
            "explanation": "配置子接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-bridge。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 1 vlan-id 10",
            "explanation": "配置子接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN标识符。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vxlan local-tunnel-endpoint [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vxlan local-tunnel-endpoint [parameter3]",
            "command": "set interfaces lt-0/0/0 unit 1 vxlan local-tunnel-endpoint lo0.1",
            "explanation": "配置NVE接口的本地隧道端点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lt-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "local-tunnel-endpoint",
                    "type": "string",
                    "explanation": "本地隧道端点接口名称，包括单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vxlan vni [parameter3] group [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vxlan vni [parameter3] group [parameter4]",
            "command": "set interfaces lt-0/0/0 unit 1 vxlan vni 5010 group 239.1.1.1",
            "explanation": "配置NVE接口的VXLAN VNI和组播组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lt-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "组播组地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.1",
            "explanation": "配置OSPF区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域标识符。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，包括单元号。"
                }
            ]
        }
    }
}