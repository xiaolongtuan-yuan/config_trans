{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan11 vlan-id 11",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols igmp-snooping": {
            "template": "set protocols igmp-snooping",
            "command": "set protocols igmp-snooping",
            "explanation": "启用IGMP Snooping功能。",
            "parameters": []
        },
        "set protocols mpls label-switched-path protocol [parameter1]": {
            "template": "set protocols mpls label-switched-path protocol [parameter1]",
            "command": "set protocols mpls label-switched-path protocol ldp",
            "explanation": "配置MPLS标签交换路径的协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型，例如LDP。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1] force": {
            "template": "set protocols mpls ldp router-id [parameter1] force",
            "command": "set protocols mpls ldp router-id lo0.0 force",
            "explanation": "强制设置LDP的路由器ID为指定接口的IP地址。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器ID，通常为接口的IP地址。"
                }
            ]
        },
        "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] pw-id [parameter3]": {
            "template": "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] pw-id [parameter3]",
            "command": "set protocols mpls l2circuit neighbor 1.1.1.1 interface vsi1 pw-id 100",
            "explanation": "配置MPLS L2电路的邻居、接口和伪线ID。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "pw-id",
                    "type": "integer",
                    "explanation": "伪线ID。"
                }
            ]
        },
        "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] multicast service-policy input limit-unicast [parameter3]": {
            "template": "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] multicast service-policy input limit-unicast [parameter3]",
            "command": "set protocols mpls l2circuit neighbor 1.1.1.1 interface vsi1 multicast service-policy input limit-unicast 10",
            "explanation": "配置MPLS L2电路的邻居、接口、多播服务策略和单播限制。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "limit-unicast",
                    "type": "integer",
                    "explanation": "单播流量的限制值。"
                }
            ]
        },
        "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] virtual-circuit-id [parameter3]": {
            "template": "set protocols mpls l2circuit neighbor [parameter1] interface [parameter2] virtual-circuit-id [parameter3]",
            "command": "set protocols mpls l2circuit neighbor 1.1.1.1 interface ge-1/0/0.11 virtual-circuit-id 100",
            "explanation": "配置MPLS L2电路的邻居、接口和虚拟电路ID。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "virtual-circuit-id",
                    "type": "integer",
                    "explanation": "虚拟电路ID。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/1",
            "explanation": "在指定接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols mpls ldp interface [parameter1]": {
            "template": "set protocols mpls ldp interface [parameter1]",
            "command": "set protocols mpls ldp interface ge-1/0/1",
            "explanation": "在指定接口上启用LDP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface lo0.0",
            "explanation": "在指定OSPF区域中启用接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2]": {
            "template": "set interfaces [parameter1] unit [parameter2]",
            "command": "set interfaces ge-1/0/0 unit 0",
            "explanation": "配置接口的单元号。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 11 vlan-id 11",
            "explanation": "配置接口的单元号和VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}