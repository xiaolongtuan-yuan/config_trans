{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "启用MPLS LDP协议。",
            "parameters": []
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 2.2.2.9",
            "explanation": "配置MPLS LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP协议的路由器ID。"
                }
            ]
        },
        "set protocols isis level [parameter1] net [parameter2]": {
            "template": "set protocols isis level [parameter1] net [parameter2]",
            "command": "set protocols isis level 2 net 10.0000.0000.0002.00",
            "explanation": "配置IS-IS协议的Level 2网络实体标题。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题，用于标识IS-IS网络中的设备。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-0/0/0.0",
            "explanation": "在指定接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set protocols mpls lsp-trigger [parameter1]": {
            "template": "set protocols mpls lsp-trigger [parameter1]",
            "command": "set protocols mpls lsp-trigger all",
            "explanation": "配置MPLS LSP触发策略。",
            "parameters": [
                {
                    "name": "trigger",
                    "type": "string",
                    "explanation": "LSP触发策略，例如all表示所有路由都触发LSP创建。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] mpls",
            "command": "set interfaces ge-0/0/0 unit 0 mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}