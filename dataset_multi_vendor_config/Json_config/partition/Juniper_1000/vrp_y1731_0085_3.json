{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 1 family ethernet-switching vlan members 1",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，标识VLAN成员。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family forwarding evpn vfi [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family forwarding evpn vfi [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 1 family forwarding evpn vfi evpn-xp-pe1",
            "explanation": "配置接口的EVPN转发VFI。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vfi",
                    "type": "string",
                    "explanation": "EVPN VFI名称，用于标识EVPN转发实例。"
                }
            ]
        },
        "set interfaces [parameter1] family inet address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] family inet address [parameter2]/[parameter3]",
            "command": "set interfaces lo0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family evpn vni [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family evpn vni [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 0 family evpn vni vxlan",
            "explanation": "配置接口的EVPN VNI。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vni",
                    "type": "string",
                    "explanation": "EVPN VNI名称，用于标识EVPN网络实例。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options ldp enable": {
            "template": "set forwarding-options ldp enable",
            "command": "set forwarding-options ldp enable",
            "explanation": "启用LDP转发选项。",
            "parameters": []
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp peer [parameter1] as [parameter2]": {
            "template": "set protocols bgp peer [parameter1] as [parameter2]",
            "command": "set protocols bgp peer 1.1.1.1 as 100",
            "explanation": "配置BGP对等体及其AS号。",
            "parameters": [
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP对等体的AS号。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] peer-as [parameter2] remote-as [parameter3] update-source [parameter4]": {
            "template": "set protocols bgp peer-group [parameter1] peer-as [parameter2] remote-as [parameter3] update-source [parameter4]",
            "command": "set protocols bgp peer-group peer1 peer-as 100 remote-as 100 update-source lo0",
            "explanation": "配置BGP对等体组及其属性。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等体组名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体组的本地AS号。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "对等体组的远程AS号。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口，例如lo0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-0/0/2.0",
            "explanation": "配置OSPF区域及其接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2.0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 10.2.1.0/24",
            "explanation": "配置OSPF区域的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols evpn peer-group [parameter1] type [parameter2]": {
            "template": "set protocols evpn peer-group [parameter1] type [parameter2]",
            "command": "set protocols evpn peer-group evpn-xp-pe1 type ixia",
            "explanation": "配置EVPN对等体组的类型。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "EVPN对等体组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "对等体组的类型，例如ixia。"
                }
            ]
        },
        "set protocols evpn peer-group [parameter1] peer-ip [parameter2]": {
            "template": "set protocols evpn peer-group [parameter1] peer-ip [parameter2]",
            "command": "set protocols evpn peer-group evpn-xp-pe1 peer-ip 1.1.1.1",
            "explanation": "配置EVPN对等体组的对等体IP地址。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "EVPN对等体组名称。"
                },
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols evpn peer-group [parameter1] local-as [parameter2]": {
            "template": "set protocols evpn peer-group [parameter1] local-as [parameter2]",
            "command": "set protocols evpn peer-group evpn-xp-pe1 local-as 100",
            "explanation": "配置EVPN对等体组的本地AS号。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "EVPN对等体组名称。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set protocols evpn vfi [parameter1] interface [parameter2]": {
            "template": "set protocols evpn vfi [parameter1] interface [parameter2]",
            "command": "set protocols evpn vfi default interface ge-0/0/2.0",
            "explanation": "配置EVPN VFI的默认接口。",
            "parameters": [
                {
                    "name": "vfi",
                    "type": "string",
                    "explanation": "EVPN VFI名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2.0。"
                }
            ]
        }
    },
    "set evpn": {
        "template": "set evpn",
        "set evpn encapsulation [parameter1]": {
            "template": "set evpn encapsulation [parameter1]",
            "command": "set evpn encapsulation vxlan",
            "explanation": "配置EVPN的封装类型。",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vxlan。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vrf forwarding [parameter2]": {
            "template": "set vlans [parameter1] vrf forwarding [parameter2]",
            "command": "set vlans vlanname vrf forwarding mpls-ldp",
            "explanation": "配置VLAN的VRF转发。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "vrf",
                    "type": "string",
                    "explanation": "VRF名称，例如mpls-ldp。"
                }
            ]
        }
    },
    "set ethernet-cfm": {
        "template": "set ethernet-cfm",
        "set ethernet-cfm domain [parameter1]": {
            "template": "set ethernet-cfm domain [parameter1]",
            "command": "set ethernet-cfm domain md1",
            "explanation": "配置以太网CFM域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域名称。"
                }
            ]
        },
        "set ethernet-cfm domain [parameter1] maintenance-association [parameter2] eth-mep [parameter3] external-id [parameter4]": {
            "template": "set ethernet-cfm domain [parameter1] maintenance-association [parameter2] eth-mep [parameter3] external-id [parameter4]",
            "command": "set ethernet-cfm domain md1 maintenance-association ma1 eth-mep 1 external-id local",
            "explanation": "配置以太网CFM域的维护关联及其MEP。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "eth-mep",
                    "type": "integer",
                    "explanation": "以太网MEP ID。"
                },
                {
                    "name": "external-id",
                    "type": "string",
                    "explanation": "外部ID，例如local。"
                }
            ]
        },
        "set ethernet-cfm domain [parameter1] maintenance-association [parameter2] eth-mep [parameter3] ccm-send [parameter4] remote-mep [parameter5] ccm-receive [parameter6] test-id [parameter7] mep [parameter8] remote-mep [parameter9] loss-measure [parameter10]": {
            "template": "set ethernet-cfm domain [parameter1] maintenance-association [parameter2] eth-mep [parameter3] ccm-send [parameter4] remote-mep [parameter5] ccm-receive [parameter6] test-id [parameter7] mep [parameter8] remote-mep [parameter9] loss-measure [parameter10]",
            "command": "set ethernet-cfm domain md1 maintenance-assication ma1 eth-mep 3 ccm-send enable remote-mep 4 ccm-receive enable test-id 2 mep 3 remote-mep 4 loss-measure dual-ended-continuous",
            "explanation": "配置以太网CFM域的维护关联及其MEP的CCM发送和接收设置。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "eth-mep",
                    "type": "integer",
                    "explanation": "以太网MEP ID。"
                },
                {
                    "name": "ccm-send",
                    "type": "string",
                    "explanation": "CCM发送设置，例如enable。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP ID。"
                },
                {
                    "name": "ccm-receive",
                    "type": "string",
                    "explanation": "CCM接收设置，例如enable。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP ID。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP ID。"
                },
                {
                    "name": "loss-measure",
                    "type": "string",
                    "explanation": "丢失测量类型，例如dual-ended-continuous。"
                }
            ]
        }
    }
}