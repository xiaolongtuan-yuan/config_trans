{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan-2 vlan-id 2",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set ethernet-switching-options": {
        "template": "set ethernet-switching-options",
        "set ethernet-switching-options aging-time [parameter1]": {
            "template": "set ethernet-switching-options aging-time [parameter1]",
            "command": "set ethernet-switching-options aging-time 500",
            "explanation": "配置以太网交换选项中的老化时间。",
            "parameters": [
                {
                    "name": "aging-time",
                    "type": "integer",
                    "explanation": "MAC地址表项的老化时间，单位为秒。"
                }
            ]
        },
        "set ethernet-switching-options secure-access-port interface [parameter1] static-mac [parameter2] vlan [parameter3]": {
            "template": "set ethernet-switching-options secure-access-port interface [parameter1] static-mac [parameter2] vlan [parameter3]",
            "command": "set ethernet-switching-options secure-access-port interface ge-0/0/1 static-mac 00:e0:fc:12:34:58 vlan vlan-2",
            "explanation": "配置安全接入端口的静态MAC地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "static-mac",
                    "type": "string",
                    "explanation": "静态MAC地址。"
                },
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching interface-mode access",
            "explanation": "配置接口的以太网交换模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如接入模式(access)。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members vlan-2",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员名称。"
                }
            ]
        }
    }
}