{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 10.1.1.0/24 next-hop 10.2.1.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination-network",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "目标网络的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd interface [parameter1]": {
            "template": "set protocols bfd interface [parameter1]",
            "command": "set protocols bfd interface all",
            "explanation": "在所有接口上启用BFD协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] local-discriminator [parameter2]": {
            "template": "set protocols bfd interface [parameter1] local-discriminator [parameter2]",
            "command": "set protocols bfd interface all local-discriminator 20",
            "explanation": "配置BFD会话的本地标识符。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "BFD会话的本地标识符。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] remote-discriminator [parameter2]": {
            "template": "set protocols bfd interface [parameter1] remote-discriminator [parameter2]",
            "command": "set protocols bfd interface all remote-discriminator 10",
            "explanation": "配置BFD会话的远端标识符。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "remote-discriminator",
                    "type": "integer",
                    "explanation": "BFD会话的远端标识符。"
                }
            ]
        },
        "set protocols bfd neighbor [parameter1]": {
            "template": "set protocols bfd neighbor [parameter1]",
            "command": "set protocols bfd neighbor 10.1.1.1",
            "explanation": "配置BFD邻居。",
            "parameters": [
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BFD邻居的IP地址。"
                }
            ]
        }
    }
}