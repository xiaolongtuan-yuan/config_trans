{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members vlan10",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员名称。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols cfm target [parameter1]": {
            "template": "set protocols cfm target [parameter1]",
            "command": "set protocols cfm target md1",
            "explanation": "配置CFM目标。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                }
            ]
        },
        "set protocols cfm target [parameter1] level [parameter2]": {
            "template": "set protocols cfm target [parameter1] level [parameter2]",
            "command": "set protocols cfm target md1 level 6",
            "explanation": "配置CFM目标的级别。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "CFM目标的级别。"
                }
            ]
        },
        "set protocols cfm target [parameter1] maintenance-association [parameter2] vlan [parameter3]": {
            "template": "set protocols cfm target [parameter1] maintenance-association [parameter2] vlan [parameter3]",
            "command": "set protocols cfm target md1 maintenance-association ma1 vlan 10",
            "explanation": "配置CFM目标的维护关联的VLAN。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set protocols cfm target [parameter1] maintenance-association [parameter2] mep [parameter3] interface [parameter4] direction [parameter5]": {
            "template": "set protocols cfm target [parameter1] maintenance-association [parameter2] mep [parameter3] interface [parameter4] direction [parameter5]",
            "command": "set protocols cfm target md1 maintenance-association ma1 mep 1 interface ge-0/0/1 direction outward",
            "explanation": "配置CFM目标的维护关联的MEP接口和方向。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "MEP的方向，例如outward。"
                }
            ]
        },
        "set protocols cfm target [parameter1] maintenance-association [parameter2] mep [parameter3] send-ccm": {
            "template": "set protocols cfm target [parameter1] maintenance-association [parameter2] mep [parameter3] send-ccm",
            "command": "set protocols cfm target md1 maintenance-association ma1 mep 1 send-ccm",
            "explanation": "配置CFM目标的维护关联的MEP发送CCM。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                }
            ]
        },
        "set protocols cfm target [parameter1] maintenance-association [parameter2] remote-mep [parameter3]": {
            "template": "set protocols cfm target [parameter1] maintenance-association [parameter2] remote-mep [parameter3]",
            "command": "set protocols cfm target md1 maintenance-association ma1 remote-mep 2",
            "explanation": "配置CFM目标的维护关联的远程MEP。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP的ID号。"
                }
            ]
        },
        "set protocols cfm target [parameter1] maintenance-association [parameter2] remote-mep [parameter3] receive-ccm": {
            "template": "set protocols cfm target [parameter1] maintenance-association [parameter2] remote-mep [parameter3] receive-ccm",
            "command": "set protocols cfm target md1 maintenance-association ma1 remote-mep 2 receive-ccm",
            "explanation": "配置CFM目标的维护关联的远程MEP接收CCM。",
            "parameters": [
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "CFM目标名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP的ID号。"
                }
            ]
        }
    }
}