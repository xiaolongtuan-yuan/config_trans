{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] virtual-address [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] virtual-address [parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 vrrp group 1 virtual-address 10.1.1.111",
            "explanation": "配置VRRP组的虚拟地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "virtual-address",
                    "type": "string",
                    "explanation": "VRRP组的虚拟IP地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] priority [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] priority [parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 vrrp group 1 priority 120",
            "explanation": "配置VRRP组的优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "VRRP组的优先级，数值越大优先级越高。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] track [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vrrp group [parameter3] track [parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 vrrp group 1 track ge-0/0/0",
            "explanation": "配置VRRP组跟踪接口状态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "track-interface",
                    "type": "string",
                    "explanation": "被跟踪的接口名称。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 10.1.3.0/24",
            "explanation": "配置OSPF协议的区域及网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号，例如0.0.0.0。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols ospf default-information originate": {
            "template": "set protocols ospf default-information originate",
            "command": "set protocols ospf default-information originate",
            "explanation": "配置OSPF协议默认路由的生成。",
            "parameters": []
        },
        "set protocols ospf import-route direct": {
            "template": "set protocols ospf import-route direct",
            "command": "set protocols ospf import-route direct",
            "explanation": "配置OSPF协议导入直连路由。",
            "parameters": []
        }
    }
}