{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces eth0 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如eth0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 192.168.1.2",
            "explanation": "配置静态路由，指定默认路由的下一跳地址。",
            "parameters": [
                {
                    "name": "destination-ip",
                    "type": "string",
                    "explanation": "目标IP地址，0.0.0.0表示默认路由。"
                },
                {
                    "name": "destination-mask",
                    "type": "integer",
                    "explanation": "目标IP地址的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳的IP地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 192.168.1.0/24",
            "explanation": "配置OSPF协议，指定OSPF区域和网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network-ip",
                    "type": "string",
                    "explanation": "网络IP地址。"
                },
                {
                    "name": "network-mask",
                    "type": "integer",
                    "explanation": "网络子网掩码的位数。"
                }
            ]
        }
    }
}