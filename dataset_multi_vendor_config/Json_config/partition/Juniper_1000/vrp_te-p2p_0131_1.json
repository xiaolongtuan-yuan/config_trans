{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 3.3.3.3/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group pe1 type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-address [parameter2]",
            "command": "set protocols bgp group pe1 peer-address 1.1.1.1",
            "explanation": "配置BGP组的对等地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 10.2.1.0/24",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域的编号。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络的IP地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] path-option [parameter2] explicit-name [parameter3]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] path-option [parameter2] explicit-name [parameter3]",
            "command": "set protocols mpls traffic-eng tunnels tunnel1 path-option 1 explicit-name topology-type1",
            "explanation": "配置MPLS流量工程的隧道路径选项。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道的名称。"
                },
                {
                    "name": "path-option",
                    "type": "integer",
                    "explanation": "路径选项的编号。"
                },
                {
                    "name": "explicit-name",
                    "type": "string",
                    "explanation": "显式路径的名称。"
                }
            ]
        },
        "set protocols bfd template [parameter1] min-tx-interval [parameter2] min-rx-interval [parameter3]": {
            "template": "set protocols bfd template [parameter1] min-tx-interval [parameter2] min-rx-interval [parameter3]",
            "command": "set protocols bfd template pe-to-pe1 min-tx-interval 100 min-rx-interval 100",
            "explanation": "配置BFD模板的最小传输间隔和最小接收间隔。",
            "parameters": [
                {
                    "name": "template-name",
                    "type": "string",
                    "explanation": "BFD模板的名称。"
                },
                {
                    "name": "min-tx-interval",
                    "type": "integer",
                    "explanation": "最小传输间隔，单位为毫秒。"
                },
                {
                    "name": "min-rx-interval",
                    "type": "integer",
                    "explanation": "最小接收间隔，单位为毫秒。"
                }
            ]
        },
        "set protocols bfd association [parameter1] destination [parameter2] source [parameter3] discard-lsp-locally discriminator local [parameter4] discriminator remote [parameter5]": {
            "template": "set protocols bfd association [parameter1] destination [parameter2] source [parameter3] discard-lsp-locally discriminator local [parameter4] discriminator remote [parameter5]",
            "command": "set protocols bfd association pe-to-pe1 destination 1.1.1.1 source 3.3.3.3 discard-lsp-locally discriminator local 21 discriminator remote 12",
            "explanation": "配置BFD关联的目的地、源地址、本地和远程鉴别器。",
            "parameters": [
                {
                    "name": "association-name",
                    "type": "string",
                    "explanation": "BFD关联的名称。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的地的IP地址。"
                },
                {
                    "name": "source",
                    "type": "string",
                    "explanation": "源地址的IP地址。"
                },
                {
                    "name": "discard-lsp-locally",
                    "type": "boolean",
                    "explanation": "是否在本地丢弃LSP。"
                },
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "本地鉴别器的编号。"
                },
                {
                    "name": "remote-discriminator",
                    "type": "integer",
                    "explanation": "远程鉴别器的编号。"
                }
            ]
        }
    }
}