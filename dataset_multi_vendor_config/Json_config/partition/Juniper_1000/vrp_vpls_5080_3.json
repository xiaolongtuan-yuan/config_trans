            "template": "set protocols ospf traffic-engineering options [parameter1]",
            "command": "set protocols ospf traffic-engineering options fg-keep-forwarding",
            "explanation": "配置OSPF流量工程的选项。",
            "parameters": [
                {
                    "name": "options",
                    "type": "string",
                    "explanation": "OSPF流量工程的选项。"
                }
            ]
        },
