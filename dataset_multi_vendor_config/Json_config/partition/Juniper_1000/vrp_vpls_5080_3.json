            "template": "set protocols ospf database-creation router-id [parameter1]",
            "command": "set protocols ospf database-creation router-id 3.3.3.9",
            "explanation": "配置OSPF数据库创建的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
