{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name SPE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp enable": {
            "template": "set protocols ldp enable",
            "command": "set protocols ldp enable",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set protocols ospf 1 area 0 interface lo0.0",
            "explanation": "配置OSPF协议，指定区域和接口。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        }
    },
    "set forwarding-label": {
        "template": "set forwarding-label",
        "set forwarding-label protocol [parameter1]": {
            "template": "set forwarding-label protocol [parameter1]",
            "command": "set forwarding-label protocol ldp",
            "explanation": "配置转发标签协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "转发标签协议，例如ldp。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options label policy [parameter1]": {
            "template": "set forwarding-options label policy [parameter1]",
            "command": "set forwarding-options label policy label",
            "explanation": "配置转发选项的标签策略。",
            "parameters": [
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "标签策略名称。"
                }
            ]
        },
        "set forwarding-options mac-learning vlan [parameter1] time [parameter2] disable": {
            "template": "set forwarding-options mac-learning vlan [parameter1] time [parameter2] disable",
            "command": "set forwarding-options mac-learning vlan v100 time 300 disable",
            "explanation": "配置指定VLAN的MAC学习功能，设置超时时间并禁用。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称或ID。"
                },
                {
                    "name": "time",
                    "type": "integer",
                    "explanation": "超时时间，单位为秒。"
                }
            ]
        },
        "set forwarding-options mpls ip interface [parameter1] unit [parameter2]": {
            "template": "set forwarding-options mpls ip interface [parameter1] unit [parameter2]",
            "command": "set forwarding-options mpls ip interface ge-0/0/0 unit 0",
            "explanation": "配置MPLS转发选项，指定接口和单元号。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] interfaces [parameter2]": {
            "template": "set vlans [parameter1] interfaces [parameter2]",
            "command": "set vlans v100 interfaces ge-0/0/0",
            "explanation": "配置VLAN的接口。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称或ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set vlans [parameter1] tagged [parameter2]": {
            "template": "set vlans [parameter1] tagged [parameter2]",
            "command": "set vlans v100 tagged ge-0/0/1",
            "explanation": "配置VLAN的标记接口。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称或ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "标记的接口名称，例如ge-0/0/1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family l2-bridge vlan [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2-bridge vlan [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family l2-bridge vlan v100",
            "explanation": "配置接口的L2桥接VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称或ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.10.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] vlan-id [parameter2]": {
            "template": "set routing-instances [parameter1] vlan-id [parameter2]",
            "command": "set routing-instances test vlan-id 100",
            "explanation": "配置路由实例的VLAN ID。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances test instance-type vplc",
            "explanation": "配置路由实例的类型。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例类型，例如vplc。"
                }
            ]
        },
        "set routing-instances [parameter1] forwarding-options mac-address-table learning disable": {
            "template": "set routing-instances [parameter1] forwarding-options mac-address-table learning disable",
            "command": "set routing-instances test forwarding-options mac-address-table learning disable",
            "explanation": "禁用路由实例的MAC地址表学习功能。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                }
            ]
        },
        "set routing-instances [parameter1] members [parameter2]": {
            "template": "set routing-instances [parameter1] members [parameter2]",
            "command": "set routing-instances test members ge-0/0/0.0",
            "explanation": "配置路由实例的成员接口。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "成员接口名称，例如ge-0/0/0.0。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}