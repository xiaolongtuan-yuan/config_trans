{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name HUAWEI",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system radius-server [parameter1] port [parameter2] secret [parameter3]": {
            "template": "set system radius-server [parameter1] port [parameter2] secret [parameter3]",
            "command": "set system radius-server 192.168.7.249 port 1812 secret \"$9$02050D480809\"",
            "explanation": "配置RADIUS服务器的IP地址、端口和共享密钥。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的端口号。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与RADIUS服务器通信的共享密钥。"
                }
            ]
        },
        "set system radius-server [parameter1] accounting-port [parameter2]": {
            "template": "set system radius-server [parameter1] accounting-port [parameter2]",
            "command": "set system radius-server 192.168.7.249 accounting-port 1813",
            "explanation": "配置RADIUS服务器的IP地址和计费端口。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "accounting-port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set system accounting events [parameter1]": {
            "template": "set system accounting events [parameter1]",
            "command": "set system accounting events start-stop",
            "explanation": "配置系统计费事件。",
            "parameters": [
                {
                    "name": "events",
                    "type": "string",
                    "explanation": "计费事件类型，例如start-stop。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols dot1x authenticator authentication-profile-name [parameter1]": {
            "template": "set protocols dot1x authenticator authentication-profile-name [parameter1]",
            "command": "set protocols dot1x authenticator authentication-profile-name default",
            "explanation": "配置802.1X认证的认证配置文件名称。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "认证配置文件的名称。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access profile [parameter1] authentication-order [parameter2]": {
            "template": "set access profile [parameter1] authentication-order [parameter2]",
            "command": "set access profile default authentication-order radius",
            "explanation": "配置访问配置文件的认证顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set access profile [parameter1] accounting order [parameter2]": {
            "template": "set access profile [parameter1] accounting order [parameter2]",
            "command": "set access profile default accounting order radius",
            "explanation": "配置访问配置文件的计费顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "accounting-method",
                    "type": "string",
                    "explanation": "计费方法，例如radius。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]": {
            "template": "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]",
            "command": "set access address-assignment pool pool1 family inet network 10.82.0.0/24",
            "explanation": "配置地址分配池的网络地址和子网掩码。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet router [parameter2]": {
            "template": "set access address-assignment pool [parameter1] family inet router [parameter2]",
            "command": "set access address-assignment pool pool1 family inet router 10.82.0.1",
            "explanation": "配置地址分配池的默认网关。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "router-address",
                    "type": "string",
                    "explanation": "默认网关的IP地址。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet dns-server [parameter2]": {
            "template": "set access address-assignment pool [parameter1] family inet dns-server [parameter2]",
            "command": "set access address-assignment pool pool1 family inet dns-server 192.168.7.252",
            "explanation": "配置地址分配池的DNS服务器地址。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "dns-server",
                    "type": "string",
                    "explanation": "DNS服务器的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.10.7.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-1/0/1 unit 0 disable",
            "explanation": "禁用接口的某个单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 2 vlan-id 100",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-1/0/2 unit 2 family ethernet-switching",
            "explanation": "配置接口单元支持以太网交换。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] domain-type [parameter2]": {
            "template": "set bridge-domains [parameter1] domain-type [parameter2]",
            "command": "set bridge-domains bridge-1 domain-type bridge",
            "explanation": "配置桥接域的类型。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域的名称。"
                },
                {
                    "name": "domain-type",
                    "type": "string",
                    "explanation": "桥接域的类型，例如bridge。"
                }
            ]
        },
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains bridge-1 vlan-id 100",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options bridge-routing-instance [parameter1] protocols [parameter2]": {
            "template": "set routing-options bridge-routing-instance [parameter1] protocols [parameter2]",
            "command": "set routing-options bridge-routing-instance bridge-1 protocols rstp",
            "explanation": "配置桥接路由实例的协议。",
            "parameters": [
                {
                    "name": "bridge-routing-instance",
                    "type": "string",
                    "explanation": "桥接路由实例的名称。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议名称，例如rstp。"
                }
            ]
        },
        "set routing-options bridge-routing-instance [parameter1] route [parameter2]/[parameter3] next-hop [parameter4]": {
            "template": "set routing-options bridge-routing-instance [parameter1] route [parameter2]/[parameter3] next-hop [parameter4]",
            "command": "set routing-options bridge-routing-instance bridge-1 route 10.82.0.0/24 next-hop bvi.1",
            "explanation": "配置桥接路由实例的路由。",
            "parameters": [
                {
                    "name": "bridge-routing-instance",
                    "type": "string",
                    "explanation": "桥接路由实例的名称。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}