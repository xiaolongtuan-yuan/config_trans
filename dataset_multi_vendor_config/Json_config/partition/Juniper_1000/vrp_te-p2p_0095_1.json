{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-distribution-protocol [parameter1]": {
            "template": "set protocols mpls label-distribution-protocol [parameter1]",
            "command": "set protocols mpls label-distribution-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set protocols ospf 1 area 0 interface gigabit-0/0/0.0",
            "explanation": "在OSPF进程1的区域0中启用接口gigabit-0/0/0.0。",
            "parameters": [
                {
                    "name": "ospf-process",
                    "type": "integer",
                    "explanation": "OSPF进程号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set protocols ospf 1 area 0 network 192.168.1.0/24",
            "explanation": "在OSPF进程1的区域0中宣告网络192.168.1.0/24。",
            "parameters": [
                {
                    "name": "ospf-process",
                    "type": "integer",
                    "explanation": "OSPF进程号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "宣告的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols mpls traffic-engineering bandwidth [parameter1] for-administrative-group [parameter2]": {
            "template": "set protocols mpls traffic-engineering bandwidth [parameter1] for-administrative-group [parameter2]",
            "command": "set protocols mpls traffic-engineering bandwidth 100000 for-administrative-group 10101",
            "explanation": "配置MPLS流量工程的带宽和管理组。",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "带宽值，单位kbps。"
                },
                {
                    "name": "administrative-group",
                    "type": "integer",
                    "explanation": "管理组号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching",
            "explanation": "配置接口为以太网交换模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}