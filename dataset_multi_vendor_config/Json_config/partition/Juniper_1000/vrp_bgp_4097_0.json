{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis instance [parameter1] router-id [parameter2]": {
            "template": "set protocols isis instance [parameter1] router-id [parameter2]",
            "command": "set protocols isis instance 1 router-id 10.0.0.1",
            "explanation": "配置ISIS协议的实例及其路由器ID。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "integer",
                    "explanation": "ISIS协议的实例编号。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于ISIS协议中标识路由器。"
                }
            ]
        },
        "set protocols isis instance [parameter1] net [parameter2]": {
            "template": "set protocols isis instance [parameter1] net [parameter2]",
            "command": "set protocols isis instance 1 net 49.0001.0000.0000.0001.00",
            "explanation": "配置ISIS协议的实例及其网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "integer",
                    "explanation": "ISIS协议的实例编号。"
                },
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于ISIS协议中标识网络。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-2/0/0.0",
            "explanation": "在ISIS协议中启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称及其单元号，例如ge-2/0/0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}