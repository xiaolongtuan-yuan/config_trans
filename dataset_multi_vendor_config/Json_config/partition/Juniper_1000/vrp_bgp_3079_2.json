{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.10.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 300",
            "explanation": "配置路由选项中的自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "自治系统号，用于标识网络中的自治系统。"
                }
            ]
        },
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 3.3.3.3",
            "explanation": "配置路由选项中的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识网络中的路由器。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group neighbor-100 type external",
            "explanation": "配置BGP协议的组类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group neighbor-100 peer-as 100",
            "explanation": "配置BGP组的对等体自治系统号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group neighbor-100 neighbor 10.10.1.1",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from prefix-list [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from prefix-list [parameter3]",
            "command": "set policy-options policy-statement dampen-policy term 10 from prefix-list prefix-a",
            "explanation": "配置策略选项中的策略声明，指定从哪个前缀列表匹配。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略声明的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略声明的术语编号。"
                },
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表的名称。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then damping [parameter3] [parameter4] [parameter5] [parameter6]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then damping [parameter3] [parameter4] [parameter5] [parameter6]",
            "command": "set policy-options policy-statement dampen-policy term 10 then damping 10 1000 2000 5000",
            "explanation": "配置策略选项中的策略声明，指定阻尼参数。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略声明的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略声明的术语编号。"
                },
                {
                    "name": "half-life",
                    "type": "integer",
                    "explanation": "阻尼的半衰期。"
                },
                {
                    "name": "reuse",
                    "type": "integer",
                    "explanation": "阻尼的重用阈值。"
                },
                {
                    "name": "suppress",
                    "type": "integer",
                    "explanation": "阻尼的抑制阈值。"
                },
                {
                    "name": "max-suppress-time",
                    "type": "integer",
                    "explanation": "阻尼的最大抑制时间。"
                }
            ]
        },
        "set policy-options prefix-list [parameter1] [parameter2]": {
            "template": "set policy-options prefix-list [parameter1] [parameter2]",
            "command": "set policy-options prefix-list prefix-a 8.0.0.0/8",
            "explanation": "配置策略选项中的前缀列表。",
            "parameters": [
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表的名称。"
                },
                {
                    "name": "prefix",
                    "type": "string",
                    "explanation": "前缀地址及掩码。"
                }
            ]
        }
    }
}