{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp local-as [parameter1]": {
            "template": "set protocols bgp local-as [parameter1]",
            "command": "set protocols bgp local-as 65002",
            "explanation": "配置BGP协议的本地AS号。",
            "parameters": [
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地自治系统号，用于标识设备所在的自治系统。"
                }
            ]
        },
        "set protocols bgp router-id [parameter1]": {
            "template": "set protocols bgp router-id [parameter1]",
            "command": "set protocols bgp router-id 2.2.2.2",
            "explanation": "配置BGP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的唯一标识符，通常为一个IPv4地址。"
                }
            ]
        },
        "set protocols bgp confederation identifier [parameter1]": {
            "template": "set protocols bgp confederation identifier [parameter1]",
            "command": "set protocols bgp confederation identifier 200",
            "explanation": "配置BGP联盟的标识符。",
            "parameters": [
                {
                    "name": "identifier",
                    "type": "integer",
                    "explanation": "联盟的标识符，用于标识BGP联盟。"
                }
            ]
        },
        "set protocols bgp confederation peers [parameter1]": {
            "template": "set protocols bgp confederation peers [parameter1]",
            "command": "set protocols bgp confederation peers 65001",
            "explanation": "配置BGP联盟的同伴AS号。",
            "parameters": [
                {
                    "name": "peers",
                    "type": "integer",
                    "explanation": "联盟同伴的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group CONFED-PEER type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal表示内部组。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group CONFED-PEER peer-as 65001",
            "explanation": "配置BGP组的同伴AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "同伴的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family inet unicast": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family inet unicast",
            "command": "set protocols bgp group CONFED-PEER neighbor 10.1.1.1 family inet unicast",
            "explanation": "配置BGP组的邻居及其地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IPv4地址。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，例如inet表示IPv4。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "指定为单播地址族。"
                }
            ]
        }
    }
}