{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp interface [parameter1]": {
            "template": "set protocols ptp interface [parameter1]",
            "command": "set protocols ptp interface all",
            "explanation": "配置PTP协议在所有接口上启用。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "指定PTP协议启用的接口，'all'表示所有接口。"
                }
            ]
        },
        "set protocols ptp clock-source [parameter1] input-type [parameter2]": {
            "template": "set protocols ptp clock-source [parameter1] input-type [parameter2]",
            "command": "set protocols ptp clock-source bits1 input-type 1pps",
            "explanation": "配置PTP时钟源的输入类型。",
            "parameters": [
                {
                    "name": "clock-source",
                    "type": "string",
                    "explanation": "时钟源名称。"
                },
                {
                    "name": "input-type",
                    "type": "string",
                    "explanation": "时钟源的输入类型，例如1pps。"
                }
            ]
        },
        "set protocols ptp clock-source [parameter1] priority [parameter2]": {
            "template": "set protocols ptp clock-source [parameter1] priority [parameter2]",
            "command": "set protocols ptp clock-source bits1 priority 2",
            "explanation": "配置PTP时钟源的优先级。",
            "parameters": [
                {
                    "name": "clock-source",
                    "type": "string",
                    "explanation": "时钟源名称。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟源的优先级，数值越小优先级越高。"
                }
            ]
        },
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 1",
            "explanation": "配置PTP协议的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP协议的域编号。"
                }
            ]
        },
        "set protocols ptp device-type [parameter1]": {
            "template": "set protocols ptp device-type [parameter1]",
            "command": "set protocols ptp device-type boundary-clock",
            "explanation": "配置PTP设备类型为边界时钟。",
            "parameters": [
                {
                    "name": "device-type",
                    "type": "string",
                    "explanation": "PTP设备类型，例如boundary-clock。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0.0",
            "explanation": "配置OSPF协议在指定区域的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 172.16.0.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ptp enable": {
            "template": "set interfaces [parameter1] unit [parameter2] ptp enable",
            "command": "set interfaces ge-1/0/0 unit 0 ptp enable",
            "explanation": "在接口上启用PTP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ptp delay-mechanism [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ptp delay-mechanism [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 ptp delay-mechanism pdelay",
            "explanation": "配置PTP协议的延迟机制。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "delay-mechanism",
                    "type": "string",
                    "explanation": "PTP协议的延迟机制，例如pdelay。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] disable [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 disable false",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "是否禁用接口，false表示启用。"
                }
            ]
        }
    }
}