{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Spoke1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.2.10/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel source ge-0/0/1",
            "explanation": "配置隧道接口的源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道源接口名称，例如ge-0/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel destination 172.16.1.1",
            "explanation": "配置隧道接口的目的地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "隧道目的地址。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 200",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group bgp-group type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group bgp-group neighbor 172.16.1.1 peer-as 100",
            "explanation": "配置BGP邻居及其自治系统号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group bgp-group local-address 172.16.1.2",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group bgp-group family inet unicast",
            "explanation": "配置BGP组的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group bgp-group export ospf-to-bgp",
            "explanation": "配置BGP组导出策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-2/0/0",
            "explanation": "配置OSPF区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement ospf-to-bgp term 1 from protocol ospf",
            "explanation": "配置策略语句的匹配条件为OSPF协议。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议类型，例如ospf。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement ospf-to-bgp term 1 then accept",
            "explanation": "配置策略语句的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "策略动作，例如accept。"
                }
            ]
        }
    }
}