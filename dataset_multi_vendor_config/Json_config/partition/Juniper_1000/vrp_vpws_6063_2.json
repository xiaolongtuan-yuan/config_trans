{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp neighbor [parameter1] remote-as [parameter2]": {
            "template": "set protocols ldp neighbor [parameter1] remote-as [parameter2]",
            "command": "set protocols ldp neighbor 2.2.2.9 remote-as 100",
            "explanation": "配置LDP协议邻居及其远程AS号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "LDP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "远程自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-address [parameter2] as [parameter3]": {
            "template": "set protocols bgp group [parameter1] peer-address [parameter2] as [parameter3]",
            "command": "set protocols bgp group test peer-address 2.2.2.9 as 100",
            "explanation": "配置BGP协议的组、对等体地址及其AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] update-source [parameter2]": {
            "template": "set protocols bgp group [parameter1] update-source [parameter2]",
            "command": "set protocols bgp group test update-source lo0.0",
            "explanation": "配置BGP协议的更新源。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源的接口名称。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 1.1.1.9",
            "explanation": "配置OSPF协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器ID。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]",
            "command": "set protocols ospf area 0 network 1.1.1.9/32",
            "explanation": "配置OSPF协议的区域网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ip address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ip address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family ip address 10.10.1.1/24",
            "explanation": "配置接口的IP地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IP地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IP子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 1.1.1.9/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ip": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ip",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls ip",
            "explanation": "在接口上启用MPLS IP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set forwarding-plane": {
        "template": "set forwarding-plane",
        "set forwarding-plane l2vPN vpnsid [parameter1]": {
            "template": "set forwarding-plane l2vPN vpnsid [parameter1]",
            "command": "set forwarding-plane l2vPN vpnsid 100",
            "explanation": "配置L2VPN的VPNSID。",
            "parameters": [
                {
                    "name": "vpnsid",
                    "type": "integer",
                    "explanation": "L2VPN的VPNSID值。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vfi",
            "explanation": "配置路由实例的类型为VFI。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vfi。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target export [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target export [parameter2]",
            "command": "set routing-instances vpn1 vrf-target export route-target:100:1",
            "explanation": "配置路由实例的VRF目标导出。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标值，格式为route-target:AS:NN。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target import [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target import [parameter2]",
            "command": "set routing-instances vpn1 vrf-target import route-target:100:1",
            "explanation": "配置路由实例的VRF目标导入。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标值，格式为route-target:AS:NN。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2] member": {
            "template": "set routing-instances [parameter1] interface [parameter2] member",
            "command": "set routing-instances vpn1 interface ge-0/0/0.0 member",
            "explanation": "将接口添加到路由实例中。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}