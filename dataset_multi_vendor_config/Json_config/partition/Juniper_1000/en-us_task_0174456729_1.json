{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 2.2.2.9",
            "explanation": "配置MPLS LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP的路由器ID，用于标识LDP会话的源地址。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2]": {
            "template": "set protocols isis interface [parameter1] level [parameter2]",
            "command": "set protocols isis interface all level 1",
            "explanation": "在所有接口上启用IS-IS协议，并设置为Level 1。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，1表示Level 1。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0000.0000.0002.00",
            "explanation": "配置IS-IS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "IS-IS的网络实体标题，用于标识IS-IS路由域。"
                }
            ]
        },
        "set protocols isis metric [parameter1]": {
            "template": "set protocols isis metric [parameter1]",
            "command": "set protocols isis metric wide",
            "explanation": "配置IS-IS使用宽度量。",
            "parameters": [
                {
                    "name": "metric",
                    "type": "string",
                    "explanation": "度量类型，'wide'表示宽度量。"
                }
            ]
        },
        "set protocols isis interface [parameter1] metric [parameter2]": {
            "template": "set protocols isis interface [parameter1] metric [parameter2]",
            "command": "set protocols isis interface lo0 metric 10",
            "explanation": "配置环回接口的IS-IS度量值。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "IS-IS的度量值。"
                }
            ]
        },
        "set protocols mpls segment-routing": {
            "template": "set protocols mpls segment-routing",
            "command": "set protocols mpls segment-routing",
            "explanation": "启用MPLS分段路由功能。",
            "parameters": []
        },
        "set protocols mpls global-block [parameter1] [parameter2]": {
            "template": "set protocols mpls global-block [parameter1] [parameter2]",
            "command": "set protocols mpls global-block 16000 23999",
            "explanation": "配置MPLS全局标签块范围。",
            "parameters": [
                {
                    "name": "start-label",
                    "type": "integer",
                    "explanation": "标签块的起始标签值。"
                },
                {
                    "name": "end-label",
                    "type": "integer",
                    "explanation": "标签块的结束标签值。"
                }
            ]
        },
        "set protocols isis fast-reroute level [parameter1] loop-free-alternate": {
            "template": "set protocols isis fast-reroute level [parameter1] loop-free-alternate",
            "command": "set protocols isis fast-reroute level 1 loop-free-alternate",
            "explanation": "在IS-IS Level 1启用无环备用路径快速重路由。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，1表示Level 1。"
                }
            ]
        },
        "set protocols isis fast-reroute level [parameter1] ti-lfa": {
            "template": "set protocols isis fast-reroute level [parameter1] ti-lfa",
            "command": "set protocols isis fast-reroute level 1 ti-lfa",
            "explanation": "在IS-IS Level 1启用TI-LFA快速重路由。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，1表示Level 1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.9/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}