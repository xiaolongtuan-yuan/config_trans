{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system clock source [parameter1]": {
            "template": "set system clock source [parameter1]",
            "command": "set system clock source ptp",
            "explanation": "配置系统时钟源为PTP。",
            "parameters": [
                {
                    "name": "source",
                    "type": "string",
                    "explanation": "时钟源类型，例如ptp。"
                }
            ]
        },
        "set system clock source priority [parameter1]": {
            "template": "set system clock source priority [parameter1]",
            "command": "set system clock source priority 1",
            "explanation": "配置系统时钟源的优先级。",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟源的优先级，数值越小优先级越高。"
                }
            ]
        },
        "set system clock source input [parameter1] [parameter2]": {
            "template": "set system clock source input [parameter1] [parameter2]",
            "command": "set system clock source input ptp-source PRC",
            "explanation": "配置系统时钟源的输入源。",
            "parameters": [
                {
                    "name": "input-type",
                    "type": "string",
                    "explanation": "输入源类型，例如ptp-source。"
                },
                {
                    "name": "input-name",
                    "type": "string",
                    "explanation": "输入源名称，例如PRC。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 1",
            "explanation": "配置PTP协议的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域的编号。"
                }
            ]
        },
        "set protocols ptp clock-domain [parameter1]": {
            "template": "set protocols ptp clock-domain [parameter1]",
            "command": "set protocols ptp clock-domain 1",
            "explanation": "配置PTP协议的时钟域。",
            "parameters": [
                {
                    "name": "clock-domain",
                    "type": "integer",
                    "explanation": "PTP时钟域的编号。"
                }
            ]
        },
        "set protocols ptp enable": {
            "template": "set protocols ptp enable",
            "command": "set protocols ptp enable",
            "explanation": "启用PTP协议。",
            "parameters": []
        },
        "set protocols ptp transport [parameter1]": {
            "template": "set protocols ptp transport [parameter1]",
            "command": "set protocols ptp transport unicast",
            "explanation": "配置PTP协议的传输模式为单播。",
            "parameters": [
                {
                    "name": "transport",
                    "type": "string",
                    "explanation": "PTP传输模式，例如unicast。"
                }
            ]
        },
        "set protocols ptp unicast-destination [parameter1]": {
            "template": "set protocols ptp unicast-destination [parameter1]",
            "command": "set protocols ptp unicast-destination 1.1.1.1",
            "explanation": "配置PTP协议的单播目的地址。",
            "parameters": [
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "单播目的地址，例如1.1.1.1。"
                }
            ]
        },
        "set protocols ptp announce-interval [parameter1]": {
            "template": "set protocols ptp announce-interval [parameter1]",
            "command": "set protocols ptp announce-interval 12",
            "explanation": "配置PTP协议的公告间隔。",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "公告间隔的时间，单位为秒。"
                }
            ]
        },
        "set protocols ptp sync-interval [parameter1]": {
            "template": "set protocols ptp sync-interval [parameter1]",
            "command": "set protocols ptp sync-interval 4",
            "explanation": "配置PTP协议的同步间隔。",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "同步间隔的时间，单位为秒。"
                }
            ]
        },
        "set protocols ptp delay-interval [parameter1]": {
            "template": "set protocols ptp delay-interval [parameter1]",
            "command": "set protocols ptp delay-interval 6",
            "explanation": "配置PTP协议的延迟间隔。",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "延迟间隔的时间，单位为秒。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}