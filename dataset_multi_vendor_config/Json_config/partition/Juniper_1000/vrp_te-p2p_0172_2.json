{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRc",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set mpls": {
        "template": "set mpls",
        "set mpls lsr-id [parameter1]": {
            "template": "set mpls lsr-id [parameter1]",
            "command": "set mpls lsr-id 3.3.3.3",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "MPLS的LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        }
    },
    "set forwardingmpls": {
        "template": "set forwardingmpls",
        "set forwardingmpls [parameter1]": {
            "template": "set forwardingmpls [parameter1]",
            "command": "set forwardingmpls enable",
            "explanation": "启用MPLS转发功能。",
            "parameters": [
                {
                    "name": "enable",
                    "type": "boolean",
                    "explanation": "启用或禁用MPLS转发功能。"
                }
            ]
        }
    },
    "set interface": {
        "template": "set interface",
        "set interface [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interface [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interface gig0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gig0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-options ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-options ospf 1 area 0 network 3.3.3.3/32",
            "explanation": "配置OSPF路由协议的特定区域内的网络。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options label-switched-path [parameter1] [parameter2] metric [parameter3]": {
            "template": "set forwarding-options label-switched-path [parameter1] [parameter2] metric [parameter3]",
            "command": "set forwarding-options label-switched-path rtid LSRc metric 1",
            "explanation": "配置标签交换路径的度量值。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "rtid",
                    "type": "string",
                    "explanation": "路由标识符。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "路径的度量值。"
                }
            ]
        }
    }
}