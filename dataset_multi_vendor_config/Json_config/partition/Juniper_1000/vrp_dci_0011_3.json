{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name GW2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.30.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，internal表示内部。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 7.7.7.7",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group internal neighbor 6.6.6.6 peer-as 65420",
            "explanation": "配置BGP组的邻居及其对等AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast": {
            "template": "set protocols bgp group [parameter1] family inet unicast",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组支持IPv4单播。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group internal export redistribute-ospf",
            "explanation": "配置BGP组使用指定的策略进行路由导出。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "policy-name",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 6.6.6.6",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-2/0/0.0",
            "explanation": "配置OSPF区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] passive": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] passive",
            "command": "set protocols ospf area 0 interface lo0.1 passive",
            "explanation": "配置OSPF区域内的接口为被动模式。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols ospf export [parameter1]": {
            "template": "set protocols ospf export [parameter1]",
            "command": "set protocols ospf export redistribute-bgp",
            "explanation": "配置OSPF使用指定的策略进行路由导出。",
            "parameters": [
                {
                    "name": "policy-name",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                }
            ]
        },
        "set protocols ospf no-nssa-abr": {
            "template": "set protocols ospf no-nssa-abr",
            "command": "set protocols ospf no-nssa-abr",
            "explanation": "配置OSPF不将NSSA区域作为ABR。",
            "parameters": []
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65420",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "设备的自治系统号。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement redistribute-ospf term 1 from protocol ospf",
            "explanation": "配置策略语句的匹配条件为来自OSPF协议。",
            "parameters": [
                {
                    "name": "policy-name",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的项号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议名称。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then accept": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then accept",
            "command": "set policy-options policy-statement redistribute-ospf term 1 then accept",
            "explanation": "配置策略语句的操作为接受。",
            "parameters": [
                {
                    "name": "policy-name",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的项号。"
                }
            ]
        }
    }
}