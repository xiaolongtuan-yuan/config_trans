{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "启用MPLS LDP协议。",
            "parameters": []
        },
        "set protocols mpls traffic-eng tunnels auto announce": {
            "template": "set protocols mpls traffic-eng tunnels auto announce",
            "command": "set protocols mpls traffic-eng tunnels auto announce",
            "explanation": "配置MPLS流量工程隧道自动通告。",
            "parameters": []
        },
        "set protocols mpls traffic-eng tunnels auto destination": {
            "template": "set protocols mpls traffic-eng tunnels auto destination",
            "command": "set protocols mpls traffic-eng tunnels auto destination",
            "explanation": "配置MPLS流量工程隧道自动目的地。",
            "parameters": []
        },
        "set protocols ospf [parameter1] area [parameter2]": {
            "template": "set protocols ospf [parameter1] area [parameter2]",
            "command": "set protocols ospf 1 area 0",
            "explanation": "配置OSPF协议的进程ID和区域ID。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area-id",
                    "type": "integer",
                    "explanation": "OSPF区域ID。"
                }
            ]
        },
        "set protocols ospf [parameter1] router-id [parameter2]": {
            "template": "set protocols ospf [parameter1] router-id [parameter2]",
            "command": "set protocols ospf 1 router-id 2.2.2.2",
            "explanation": "配置OSPF协议的进程ID和路由器ID。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器ID。"
                }
            ]
        },
        "set protocols ospf network [parameter1]/[parameter2] area [parameter3]": {
            "template": "set protocols ospf network [parameter1]/[parameter2] area [parameter3]",
            "command": "set protocols ospf network 3.1.1.0/24 area 0",
            "explanation": "配置OSPF网络地址及子网掩码，并指定区域ID。",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "area-id",
                    "type": "integer",
                    "explanation": "OSPF区域ID。"
                }
            ]
        },
        "set protocols mpls traffic-eng passive-interface default": {
            "template": "set protocols mpls traffic-eng passive-interface default",
            "command": "set protocols mpls traffic-eng passive-interface default",
            "explanation": "配置MPLS流量工程默认被动接口。",
            "parameters": []
        },
        "set protocols mpls traffic-eng fast-rsvp": {
            "template": "set protocols mpls traffic-eng fast-rsvp",
            "command": "set protocols mpls traffic-eng fast-rsvp",
            "explanation": "启用MPLS流量工程快速RSVP。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 3.2.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1]-unit-[parameter2] mpls traffic-eng tunnels": {
            "template": "set interfaces [parameter1]-unit-[parameter2] mpls traffic-eng tunnels",
            "command": "set interfaces ge-0/0/0-unit-0 mpls traffic-eng tunnels",
            "explanation": "配置接口的MPLS流量工程隧道。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1]-unit-[parameter2] mpls traffic-eng rsvp": {
            "template": "set interfaces [parameter1]-unit-[parameter2] mpls traffic-eng rsvp",
