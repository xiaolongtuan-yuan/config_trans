            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1]_unit_[parameter2] mpls traffic-eng rsvp": {
            "template": "set interfaces [parameter1]_unit_[parameter2] mpls traffic-eng rsvp",
            "command": "set interfaces ge-0/0/1_unit_0 mpls traffic-eng rsvp",
            "explanation": "配置接口的MPLS流量工程RSVP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
