{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSR-A",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp discover peer [parameter1]": {
            "template": "set protocols ldp discover peer [parameter1]",
            "command": "set protocols ldp discover peer 10.1.1.2",
            "explanation": "配置LDP协议发现对等体。",
            "parameters": [
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-0/0/0.0",
            "explanation": "在指定接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set protocols isis enable": {
            "template": "set protocols isis enable",
            "command": "set protocols isis enable",
            "explanation": "启用IS-IS协议。",
            "parameters": []
        },
        "set protocols isis network [parameter1]": {
            "template": "set protocols isis network [parameter1]",
            "command": "set protocols isis network p2p",
            "explanation": "配置IS-IS网络类型为点对点。",
            "parameters": [
                {
                    "name": "network-type",
                    "type": "string",
                    "explanation": "网络类型，例如p2p。"
                }
            ]
        },
        "set protocols isis interface [parameter1] [parameter2]": {
            "template": "set protocols isis interface [parameter1] [parameter2]",
            "command": "set protocols isis interface lo0.0 p2p",
            "explanation": "在指定接口上配置IS-IS网络类型为点对点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                },
                {
                    "name": "network-type",
                    "type": "string",
                    "explanation": "网络类型，例如p2p。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls ipmpls traffic-eng tunnels isis ptp enable": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ipmpls traffic-eng tunnels isis ptp enable",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls ipmpls traffic-eng tunnels isis ptp enable",
            "explanation": "在指定接口上启用MPLS流量工程隧道和IS-IS点对点协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "在指定接口上配置MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ipv4 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ipv4 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family ipv4 address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 1.1.1.1/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet unnumbered [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet unnumbered [parameter3]",
            "command": "set interfaces tun0 unit 0 family inet unnumbered lo0.0",
            "explanation": "配置隧道接口使用环回接口的IP地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如tun0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "unnumbered-interface",
                    "type": "string",
                    "explanation": "使用其IP地址的接口名称，例如lo0.0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls traffic-eng tunnel-id [parameter3] bandwidth [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls traffic-eng tunnel-id [parameter3] bandwidth [parameter4]",
            "command": "set interfaces tun0 unit 0 family mpls traffic-eng tunnel-id 1 bandwidth 20000",
            "explanation": "配置MPLS流量工程隧道的ID和带宽。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如tun0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "tunnel-id",
                    "type": "integer",
                    "explanation": "隧道的唯一标识符。"
                },
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "隧道的带宽，单位是kbps。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65000",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances r1 instance-type vrf",
            "explanation": "配置路由实例的类型。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        }
    },
    "set policies": {
        "template": "set policies",
        "set policies from [parameter1] to [parameter2]": {
            "template": "set policies from [parameter1] to [parameter2]",
            "command": "set policies from l2-tunnel to mpls-traffic-eng",
            "explanation": "配置策略，指定从一种类型到另一种类型的流量处理方式。",
            "parameters": [
                {
                    "name": "from-type",
                    "type": "string",
                    "explanation": "流量的来源类型，例如l2-tunnel。"
                },
                {
                    "name": "to-type",
                    "type": "string",
                    "explanation": "流量的目标类型，例如mpls-traffic-eng。"
                }
            ]
        }
    },
    "set forwarding-table": {
        "template": "set forwarding-table",
        "set forwarding-table route [parameter1] next-hop [parameter2] interface [parameter3] flags [parameter4]": {
            "template": "set forwarding-table route [parameter1] next-hop [parameter2] interface [parameter3] flags [parameter4]",
            "command": "set forwarding-table route 5.5.5.5 next-hop 1.1.1.1 interface ge-0/0/0.0 flags [oam]",
            "explanation": "配置转发表中的路由，指定下一跳和接口。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标IP地址。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "出接口名称，例如ge-0/0/0.0。"
                },
                {
                    "name": "flags",
                    "type": "array",
                    "explanation": "路由的标志，例如oam。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options ldp protocol label": {
            "template": "set forwarding-options ldp protocol label",
            "command": "set forwarding-options ldp protocol label",
            "explanation": "配置LDP协议的标签转发选项。",
            "parameters": []
        }
    }
}