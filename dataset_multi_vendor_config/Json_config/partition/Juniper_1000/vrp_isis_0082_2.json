{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 1",
            "explanation": "配置IS-IS协议的级别为1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols isis level [parameter1]-wide-metrics-only": {
            "template": "set protocols isis level [parameter1]-wide-metrics-only",
            "command": "set protocols isis level 1-wide-metrics-only",
            "explanation": "配置IS-IS协议级别1仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis level [parameter1] disable hello-padding": {
            "template": "set protocols isis level [parameter1] disable hello-padding",
            "command": "set protocols isis level 1 disable hello-padding",
            "explanation": "在IS-IS协议级别1上禁用Hello包的填充。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis no-adjacency-check": {
            "template": "set protocols isis no-adjacency-check",
            "command": "set protocols isis no-adjacency-check",
            "explanation": "禁用IS-IS协议的邻接检查。",
            "parameters": []
        },
        "set protocols isis iso-address [parameter1]": {
            "template": "set protocols isis iso-address [parameter1]",
            "command": "set protocols isis iso-address 49.0000.0000.0000.0003.00",
            "explanation": "配置IS-IS协议的ISO地址。",
            "parameters": [
                {
                    "name": "iso-address",
                    "type": "string",
                    "explanation": "IS-IS协议的ISO地址。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2] metric [parameter3]": {
            "template": "set protocols isis interface [parameter1] level [parameter2] metric [parameter3]",
            "command": "set protocols isis interface ge-1/0/0 level 1 metric 10",
            "explanation": "在指定接口上配置IS-IS协议级别1的度量值。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "IS-IS协议的度量值。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.3/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family iso": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso",
            "command": "set interfaces ge-1/0/0 unit 0 family iso",
            "explanation": "在接口上启用ISO协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] point-to-point": {
            "template": "set interfaces [parameter1] unit [parameter2] point-to-point",
            "command": "set interfaces ge-1/0/0 unit 0 point-to-point",
            "explanation": "配置接口为点对点类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}