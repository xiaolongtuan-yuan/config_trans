{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Spoke1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.2.10/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 tunnel source lo0",
            "explanation": "配置隧道源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道源接口名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 tunnel destination 172.16.1.1",
            "explanation": "配置隧道目的地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "隧道目的地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 encapsulation gre",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation-type",
                    "type": "string",
                    "explanation": "封装类型，例如gre。"
                }
            ]
        },
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-1/0/0 enable",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ipsec-policy [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ipsec-policy [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 ipsec-policy <IPSEC_PROFILE_NAME>",
            "explanation": "配置接口的IPSec策略。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipsec-policy",
                    "type": "string",
                    "explanation": "IPSec策略名称。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface gr-0/0/0.0",
            "explanation": "配置OSPF区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域标识。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/0.0。"
                }
            ]
        },
        "set protocols ospf passive-interface [parameter1]": {
            "template": "set protocols ospf passive-interface [parameter1]",
            "command": "set protocols ospf passive-interface ge-1/0/0.0",
            "explanation": "配置OSPF被动接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 172.16.1.2",
            "explanation": "配置OSPF路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器的ID。"
                }
            ]
        }
    }
}