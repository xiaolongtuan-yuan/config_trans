{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 0",
            "explanation": "配置PTP协议的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP协议的域编号。"
                }
            ]
        },
        "set protocols ptp clock-domain [parameter1]": {
            "template": "set protocols ptp clock-domain [parameter1]",
            "command": "set protocols ptp clock-domain 0",
            "explanation": "配置PTP协议的时钟域。",
            "parameters": [
                {
                    "name": "clock-domain",
                    "type": "integer",
                    "explanation": "PTP协议的时钟域编号。"
                }
            ]
        },
        "set protocols ptp device-type [parameter1]": {
            "template": "set protocols ptp device-type [parameter1]",
            "command": "set protocols ptp device-type server",
            "explanation": "配置PTP协议的设备类型。",
            "parameters": [
                {
                    "name": "device-type",
                    "type": "string",
                    "explanation": "PTP协议的设备类型，例如server。"
                }
            ]
        },
        "set protocols ptp unicast": {
            "template": "set protocols ptp unicast",
            "command": "set protocols ptp unicast",
            "explanation": "配置PTP协议使用单播模式。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改，使配置生效。",
            "parameters": []
        }
    }
}