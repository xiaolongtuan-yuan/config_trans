{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system ntp authentication-key [parameter1] type [parameter2] key [parameter3]": {
            "template": "set system ntp authentication-key [parameter1] type [parameter2] key [parameter3]",
            "command": "set system ntp authentication-key 42 type sha256 key \"$%#%#>hD8))_H-XZVut2u3!_0lq3,+Ph=:OE}pX;T2M'9%#%#\"",
            "explanation": "配置NTP认证密钥及其类型和密钥值。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP认证密钥的ID。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "认证密钥的类型，例如sha256。"
                },
                {
                    "name": "key",
                    "type": "string",
                    "explanation": "认证密钥的值。"
                }
            ]
        },
        "set system ntp trusted-key [parameter1]": {
            "template": "set system ntp trusted-key [parameter1]",
            "command": "set system ntp trusted-key 42",
            "explanation": "配置信任的NTP认证密钥。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "信任的NTP认证密钥的ID。"
                }
            ]
        },
        "set system ntp server [parameter1] key [parameter2]": {
            "template": "set system ntp server [parameter1] key [parameter2]",
            "command": "set system ntp server 2.2.2.2 key 42",
            "explanation": "配置NTP服务器地址及使用的认证密钥。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                },
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "用于认证的密钥ID。"
                }
            ]
        },
        "set system ntp server [parameter1]": {
            "template": "set system ntp server [parameter1]",
            "command": "set system ntp server 10.0.0.1",
            "explanation": "配置NTP服务器地址。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                }
            ]
        },
        "set system ntp authentication": {
            "template": "set system ntp authentication",
            "command": "set system ntp authentication",
            "explanation": "启用NTP认证。",
            "parameters": []
        },
        "set system ntp source-address [parameter1]": {
            "template": "set system ntp source-address [parameter1]",
            "command": "set system ntp source-address ge-1/0/0",
            "explanation": "配置NTP报文的源地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，用于指定NTP报文的源地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.0.0.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "配置OSPF区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，包括单元号，例如ge-1/0/0.0。"
                }
            ]
        }
    }
}