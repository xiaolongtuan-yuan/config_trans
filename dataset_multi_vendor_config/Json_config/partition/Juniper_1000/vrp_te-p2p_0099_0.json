{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family internet-protocol-v4 unnumbered": {
            "template": "set interfaces [parameter1] unit [parameter2] family internet-protocol-v4 unnumbered",
            "command": "set interfaces lo0 unit 0 family internet-protocol-v4 unnumbered",
            "explanation": "配置环回接口的IPv4地址为未编号，即不分配具体的IP地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet",
            "command": "set interfaces ge-0/0/0 unit 254 family inet",
            "explanation": "配置接口的IPv4协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 254 description Connected to Service Instance 001",
            "explanation": "为接口单元添加描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口单元的描述信息。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances management instance-type virtual-router",
            "explanation": "配置路由实例的类型为虚拟路由器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如virtual-router。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-table-id [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-table-id [parameter2]",
            "command": "set routing-instances management vrf-table-id 253",
            "explanation": "为路由实例配置VRF表ID。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-table-id",
                    "type": "integer",
                    "explanation": "VRF表的ID。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances service-instance001 interface ge-0/0/0.0",
            "explanation": "为路由实例配置接口。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances service-instance001 route-distinguisher 1:1",
            "explanation": "为路由实例配置路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同的VPN路由。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] peer-as [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] peer-as [parameter3]",
            "command": "set routing-instances service-instance001 protocols bgp group bgp-group1 peer-as 65000",
            "explanation": "为路由实例配置BGP组的对等AS号。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] local-as [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] local-as [parameter3]",
            "command": "set routing-instances service-instance001 protocols bgp group bgp-group1 local-as 65000",
            "explanation": "为路由实例配置BGP组的本地AS号。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols static route [parameter2] next-hop [parameter3] dev [parameter4]": {
            "template": "set routing-instances [parameter1] protocols static route [parameter2] next-hop [parameter3] dev [parameter4]",
            "command": "set routing-instances service-instance001 protocols static route 0.0.0.0/0 next-hop 192.168.1.1 dev ge-0/0/0",
            "explanation": "为路由实例配置静态路由。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目的网络。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                },
                {
                    "name": "device",
                    "type": "string",
                    "explanation": "出接口名称。"
                }
            ]
        }
    },
