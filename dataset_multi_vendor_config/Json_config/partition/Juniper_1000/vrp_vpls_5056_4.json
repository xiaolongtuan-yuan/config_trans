{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching trunk-ports [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching trunk-ports [parameter3]",
            "command": "set interfaces eth0 unit 10 family ethernet-switching trunk-ports [Ethernet1/0/0 Ethernet1/0/1]",
            "explanation": "配置以太网交换接口的trunk端口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如eth0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "trunk-ports",
                    "type": "list",
                    "explanation": "trunk端口列表，用于指定哪些端口属于该trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 5.5.5.5/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] family inet address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] family inet address [parameter2]/[parameter3]",
            "command": "set interfaces ge-0/0/2 family inet address 192.168.60.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 5.5.5.5/32",
            "explanation": "配置OSPF协议的区域及网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options l2vpns ldp [parameter1]": {
            "template": "set forwarding-options l2vpns ldp [parameter1]",
            "command": "set forwarding-options l2vpns ldp enable",
            "explanation": "启用L2VPNs的LDP功能。",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "启用或禁用LDP功能。"
                }
            ]
        },
        "set forwarding-options l2vpns ldp sync [parameter1]": {
            "template": "set forwarding-options l2vpns ldp sync [parameter1]",
            "command": "set forwarding-options l2vpns ldp sync enable",
            "explanation": "启用L2VPNs的LDP同步功能。",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "启用或禁用LDP同步功能。"
                }
            ]
        },
        "set forwarding-options l2vpns vn-segment-type [parameter1]": {
            "template": "set forwarding-options l2vpns vn-segment-type [parameter1]",
            "command": "set forwarding-options l2vpns vn-segment-type vlans",
            "explanation": "配置L2VPNs的VN段类型为VLANs。",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "VN段类型，例如vlans。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] interface [parameter2]": {
            "template": "set vlans [parameter1] interface [parameter2]",
            "command": "set vlans vlan-1 interface ge-0/0/0",
            "explanation": "将接口分配给VLAN。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set vlans [parameter1] forwarding-mode [parameter2]": {
            "template": "set vlans [parameter1] forwarding-mode [parameter2]",
            "command": "set vlans vlan-1 forwarding-mode transparent",
            "explanation": "配置VLAN的转发模式为透明模式。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "转发模式，例如transparent。"
                }
            ]
        }
    },
    "set mpls": {
        "template": "set mpls",
        "set mpls lsr-id [parameter1]": {
            "template": "set mpls lsr-id [parameter1]",
            "command": "set mpls lsr-id 5.5.5.5",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        }
    }
}