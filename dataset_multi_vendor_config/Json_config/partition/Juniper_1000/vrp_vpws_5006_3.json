{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface gigabit-ethernet1/0/0",
            "explanation": "配置LDP协议在指定接口上启用。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/0。"
                }
            ]
        },
        "set protocols ldp mpls enable interface [parameter1]": {
            "template": "set protocols ldp mpls enable interface [parameter1]",
            "command": "set protocols ldp mpls enable interface gigabit-ethernet1/0/0",
            "explanation": "在指定接口上启用LDP协议的MPLS功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/0。"
                }
            ]
        },
        "set protocols mpls ldp neighbor [parameter1]": {
            "template": "set protocols mpls ldp neighbor [parameter1]",
            "command": "set protocols mpls ldp neighbor 1.1.1.9",
            "explanation": "配置MPLS LDP邻居。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options routers ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-options routers ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-options routers ospf 1 area 0 network 3.3.3.9/32",
            "explanation": "配置OSPF路由协议，指定区域和网络。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set forwarding": {
        "template": "set forwarding",
        "set forwarding l2-circuit label-engine mpls-label-proto [parameter1]": {
            "template": "set forwarding l2-circuit label-engine mpls-label-proto [parameter1]",
            "command": "set forwarding l2-circuit label-engine mpls-label-proto ldp",
            "explanation": "配置L2电路的标签引擎使用MPLS标签协议LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "使用的协议，例如ldp。"
                }
            ]
        },
        "set forwarding l2circuit [parameter1] encap mpls neighbor [parameter2] peer-ip [parameter3]": {
            "template": "set forwarding l2circuit [parameter1] encap mpls neighbor [parameter2] peer-ip [parameter3]",
            "command": "set forwarding l2circuit 200 encap mpls neighbor 1.1.1.9 peer-ip 100",
            "explanation": "配置L2电路的封装类型、邻居和peer IP。",
            "parameters": [
                {
                    "name": "circuit-id",
                    "type": "integer",
                    "explanation": "L2电路的ID。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-ip",
                    "type": "integer",
                    "explanation": "peer的IP地址。"
                }
            ]
        }
    }
}