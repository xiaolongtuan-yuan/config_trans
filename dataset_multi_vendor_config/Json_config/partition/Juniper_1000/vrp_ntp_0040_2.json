{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system ntp authentication-key [parameter1] md5 [parameter2]": {
            "template": "set system ntp authentication-key [parameter1] md5 [parameter2]",
            "command": "set system ntp authentication-key 42 md5 %#%#m:fVJfk*r&3x\"1J`21^K`Y;LH;B+g(t2<ZX^}Q_~%#%#",
            "explanation": "配置NTP认证密钥，使用MD5加密。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP认证密钥的ID。"
                },
                {
                    "name": "key",
                    "type": "string",
                    "explanation": "NTP认证密钥的值，使用MD5加密。"
                }
            ]
        },
        "set system ntp trusted-key [parameter1]": {
            "template": "set system ntp trusted-key [parameter1]",
            "command": "set system ntp trusted-key 42",
            "explanation": "配置NTP信任的密钥ID。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP信任的密钥ID。"
                }
            ]
        },
        "set system ntp server [parameter1] key [parameter2]": {
            "template": "set system ntp server [parameter1] key [parameter2]",
            "command": "set system ntp server 10.0.0.1 key 42",
            "explanation": "配置NTP服务器地址及使用的密钥ID。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                },
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "用于与NTP服务器通信的密钥ID。"
                }
            ]
        },
        "set system ntp authentication enable": {
            "template": "set system ntp authentication enable",
            "command": "set system ntp authentication enable",
            "explanation": "启用NTP认证功能。",
            "parameters": []
        },
        "set system ntp authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]": {
            "template": "set system ntp authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]",
            "command": "set system ntp authentication-keyid 42 authentication-mode hmac-sha256 cipher %#%#m:fVJfk*r&3x\"1J`21^K`Y;LH;B+g(t2<ZX^}Q_~%#%#",
            "explanation": "配置NTP认证密钥ID的认证模式和加密密钥。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP认证密钥的ID。"
                },
                {
                    "name": "authentication-mode",
                    "type": "string",
                    "explanation": "NTP认证模式，例如hmac-sha256。"
                },
                {
                    "name": "cipher",
                    "type": "string",
                    "explanation": "NTP认证密钥的加密值。"
                }
            ]
        },
        "set system ntp reliable authentication-keyid [parameter1]": {
            "template": "set system ntp reliable authentication-keyid [parameter1]",
            "command": "set system ntp reliable authentication-keyid 42",
            "explanation": "配置NTP可靠认证的密钥ID。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP可靠认证的密钥ID。"
                }
            ]
        },
        "set system ntp unicast-server [parameter1] authentication-keyid [parameter2]": {
            "template": "set system ntp unicast-server [parameter1] authentication-keyid [parameter2]",
            "command": "set system ntp unicast-server 10.0.0.1 authentication-keyid 42",
            "explanation": "配置NTP单播服务器地址及使用的认证密钥ID。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "NTP单播服务器的IP地址。"
                },
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "用于与NTP单播服务器通信的认证密钥ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.0.0.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改，使其生效。",
            "parameters": []
        }
    }
}