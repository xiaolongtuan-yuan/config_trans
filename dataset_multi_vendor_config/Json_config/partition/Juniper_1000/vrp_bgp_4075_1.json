{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] description [parameter2]": {
            "template": "set interfaces [parameter1] description [parameter2]",
            "command": "set interfaces ge-1/0/0 description \"Active Interface\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65010",
            "explanation": "配置路由选项中的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set protocols bgp": {
        "template": "set protocols bgp",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 2.2.2.2",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 10.1.1.2",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] route-reflector-client": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] route-reflector-client",
            "command": "set protocols bgp group internal neighbor 10.1.4.2 route-reflector-client",
            "explanation": "配置BGP邻居为路由反射器客户端。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "route-reflector-client",
                    "type": "boolean",
                    "explanation": "标记邻居为路由反射器客户端。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet。"
                },
                {
                    "name": "unicast",
                    "type": "boolean",
                    "explanation": "标记地址族为单播。"
                }
            ]
        }
    }
}