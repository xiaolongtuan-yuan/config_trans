{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.0.0.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-0/0/0.0",
            "explanation": "配置OSPF协议在指定区域的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        }
    },
    "set system": {
        "template": "set system",
        "set system ntp authentication-key [parameter1] type [parameter2] value [parameter3]": {
            "template": "set system ntp authentication-key [parameter1] type [parameter2] value [parameter3]",
            "command": "set system ntp authentication-key 42 type md5 value \"%#%#>hD8))_H-XZVut2u3!_0lq3,+Ph=:OE}pX;T2M'9%#%#\"",
            "explanation": "配置NTP认证密钥。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "NTP认证密钥的ID。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "认证类型，例如md5。"
                },
                {
                    "name": "value",
                    "type": "string",
                    "explanation": "认证密钥的值。"
                }
            ]
        },
        "set system ntp trusted-key [parameter1]": {
            "template": "set system ntp trusted-key [parameter1]",
            "command": "set system ntp trusted-key 42",
            "explanation": "配置信任的NTP密钥。",
            "parameters": [
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "信任的NTP密钥的ID。"
                }
            ]
        },
        "set system ntp server [parameter1] key [parameter2] interface [parameter3]": {
            "template": "set system ntp server [parameter1] key [parameter2] interface [parameter3]",
            "command": "set system ntp server 2.2.2.2 key 42 interface ge-0/0/0.0",
            "explanation": "配置NTP服务器及使用的密钥和接口。",
            "parameters": [
                {
                    "name": "server",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                },
                {
                    "name": "key-id",
                    "type": "integer",
                    "explanation": "用于认证的NTP密钥的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "用于NTP通信的接口名称。"
                }
            ]
        }
    }
}