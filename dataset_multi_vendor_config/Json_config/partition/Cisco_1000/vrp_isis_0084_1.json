{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0002.00",
            "explanation": "设置 IS-IS 网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置 IS-IS 度量风格为 wide",
            "parameters": [
                {
                    "name": "metric style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置 IS-IS 类型为 level-1",
            "parameters": [
                {
                    "name": "IS type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "设置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65008",
        "explanation": "配置 BGP 路由进程 65008",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 1.1.1.1",
            "explanation": "设置 BGP 路由器 ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.2 remote-as 65009",
            "explanation": "配置 BGP 邻居 10.2.1.2，远程 AS 号为 65009",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 10.2.1.0 mask 255.255.255.0",
                "explanation": "在 BGP 中通告网络 10.2.1.0，子网掩码为 255.255.255.0",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.2 activate",
                "explanation": "激活 BGP 邻居 10.2.1.2 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-map [parameter2] in": {
                "template": "neighbor [parameter1] route-map [parameter2] in",
                "command": "neighbor 10.2.1.2 route-map RTC in",
                "explanation": "对来自 BGP 邻居 10.2.1.2 的路由应用入站路由映射 RTC",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    },
                    {
                        "name": "route map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    }
                ]
            }
        }
    },
    "ip as-path access-list [parameter1] permit [parameter2]": {
        "template": "ip as-path access-list [parameter1] permit [parameter2]",
        "command": "ip as-path access-list 1 permit ^65009$",
        "explanation": "配置 AS 路径访问列表 1，允许 AS 路径以 65009 结尾的 BGP 路由",
        "parameters": [
            {
                "name": "access list number",
                "type": "integer",
                "explanation": "访问列表编号"
            },
            {
                "name": "AS path regex",
                "type": "string",
                "explanation": "AS 路径正则表达式"
            }
        ]
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map RTC permit 10",
        "explanation": "配置路由映射 RTC，序列号为 10，操作为允许",
        "parameters": [
            {
                "name": "route map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "操作（允许/拒绝）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "match as-path [parameter1]": {
            "template": "match as-path [parameter1]",
            "command": "match as-path 1",
            "explanation": "匹配 AS 路径访问列表 1",
            "parameters": [
                {
                    "name": "access list number",
                    "type": "integer",
                    "explanation": "访问列表编号"
                }
            ]
        },
        "set metric [parameter1]": {
            "template": "set metric [parameter1]",
            "command": "set metric 20",
            "explanation": "设置路由的度量为 20",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值"
                }
            ]
        }
    }
}