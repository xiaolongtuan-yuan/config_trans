{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由协议配置模式",
        "parameters": [],
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "设置 IS-IS 实例为 Level-1 类型",
            "parameters": [
                {
                    "name": "IS-IS level",
                    "type": "string",
                    "explanation": "IS-IS 级别，Level-1 或 Level-2"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0002.00",
            "explanation": "配置 IS-IS 的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题，用于标识 IS-IS 实例"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置 IS-IS 接口网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型，点对点或广播"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}