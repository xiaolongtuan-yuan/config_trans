        "parameters": []
    },
    "is-type [parameter1]": {
        "template": "is-type [parameter1]",
        "command": "is-type level-1",
        "explanation": "设置IS-IS类型为Level-1",
        "parameters": [
            {
                "name": "level type",
                "type": "string",
                "explanation": "IS-IS层次类型，level-1表示仅在区域内"
            }
        ]
    },
    "isis wide-metrics-only": {
        "template": "isis wide-metrics-only",
        "command": "isis wide-metrics-only",
        "explanation": "仅使用宽度量",
        "parameters": []
    },
    "net [parameter1]": {
        "template": "net [parameter1]",
        "command": "net 49.0000.0000.0002.00",
        "explanation": "配置IS-IS的NET地址",
        "parameters": [
            {
                "name": "net address",
                "type": "string",
                "explanation": "IS-IS网络实体标题（NET）地址"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用IPv6单播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:10::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:10::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址及前缀长度"
                }
            ]
        },
        "ipv6 router isis [parameter1]": {
            "template": "ipv6 router isis [parameter1]",
            "command": "ipv6 router isis 1",
            "explanation": "在接口上启用IS-IS进程1的IPv6路由",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "配置接口的IPv4地址为2.2.2.2，子网掩码为255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
