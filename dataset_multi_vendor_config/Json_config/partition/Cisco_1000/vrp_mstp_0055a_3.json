{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE4",
        "explanation": "设置设备的主机名为 'PE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode legacy",
        "explanation": "设置生成树模式为 'legacy'",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树模式"
            }
        ]
    },
    "spanning-tree vlan [parameter1] priority [parameter2]": {
        "template": "spanning-tree vlan [parameter1] priority [parameter2]",
        "command": "spanning-tree vlan 1-10 priority 32768",
        "explanation": "设置 VLAN 1-10 的生成树优先级为 32768",
        "parameters": [
            {
                "name": "vlan range",
                "type": "string",
                "explanation": "VLAN 范围"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "生成树优先级"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥接域 10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Ethernet1/0/1",
        "explanation": "配置接口 'Ethernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为交换端口",
            "parameters": []
        },
        "spanning-tree portfast [parameter1]": {
            "template": "spanning-tree portfast [parameter1]",
            "command": "spanning-tree portfast disable",
            "explanation": "禁用接口的 PortFast 功能",
            "parameters": [
                {
                    "name": "portfast state",
                    "type": "string",
                    "explanation": "PortFast 状态"
                }
            ]
        },
        "spanning-tree cost [parameter1]": {
            "template": "spanning-tree cost [parameter1]",
            "command": "spanning-tree cost 20000",
            "explanation": "设置接口的生成树路径成本为 20000",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "生成树路径成本"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1-20",
            "explanation": "配置子接口的 802.1Q 封装，允许 VLAN 1-20",
            "parameters": [
                {
                    "name": "vlan range",
                    "type": "string",
                    "explanation": "VLAN 范围"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域 10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}