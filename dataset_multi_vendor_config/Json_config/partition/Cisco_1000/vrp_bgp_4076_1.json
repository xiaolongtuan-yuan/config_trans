{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65002",
        "explanation": "配置 BGP 路由进程，AS 号为 65002",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 2.2.2.2",
            "explanation": "设置 BGP 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "bgp confederation identifier [parameter1]": {
            "template": "bgp confederation identifier [parameter1]",
            "command": "bgp confederation identifier 200",
            "explanation": "设置 BGP 联盟标识符为 200",
            "parameters": [
                {
                    "name": "confederation identifier",
                    "type": "integer",
                    "explanation": "联盟标识符"
                }
            ]
        },
        "bgp confederation peers [parameter1]": {
            "template": "bgp confederation peers [parameter1]",
            "command": "bgp confederation peers 65001",
            "explanation": "设置 BGP 联盟对等体为 AS 65001",
            "parameters": [
                {
                    "name": "peer AS number",
                    "type": "integer",
                    "explanation": "对等体 AS 号"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.1 remote-as 65001",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.1，远程 AS 号为 65001",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程 AS 号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.1 activate",
                "explanation": "激活与邻居 10.1.1.1 的 BGP 会话",
                "parameters": [
                    {
                        "name": "neighbor IP address",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}