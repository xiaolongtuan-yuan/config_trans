{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRB",
        "explanation": "设置设备的主机名为 'LSRB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用 MPLS LDP（标签分发协议）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.2 0.0.0.0 area 0",
            "explanation": "将 2.2.2.2/32 网络加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "ip prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]",
        "command": "ip prefix-list FilterOnTransit seq 10 permit 4.4.4.4/32",
        "explanation": "配置 IP 前缀列表 'FilterOnTransit'，序列号 10，允许 4.4.4.4/32",
        "parameters": [
            {
                "name": "prefix-list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit 或 deny）"
            },
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            }
        ]
    }
}