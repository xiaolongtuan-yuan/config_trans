{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "配置 BGP 路由器，AS 号为 65410",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.2 remote-as 100",
            "explanation": "配置邻居路由器的 IP 地址和其 AS 号",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居路由器的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统编号"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                },
                {
                    "name": "subtype",
                    "type": "string",
                    "explanation": "子类型"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用同步（在某些路由协议中，如 BGP 和 IGP 之间的同步）",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 10.1.1.0 mask 255.255.255.0",
                "explanation": "宣告网络 10.1.1.0/24 到 BGP",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.2 activate",
                "explanation": "激活与邻居的会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居路由器的 IP 地址"
                    }
                ]
            }
        }
    }
}