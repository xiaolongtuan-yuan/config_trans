{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "设置设备的系统名称为 'Spoke2'",
        "parameters": [
            {
                "name": "system name",
                "type": "string",
                "explanation": "设备的系统名称"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "启用NHRP（Next Hop Resolution Protocol）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.3.10，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel mode [parameter1]": {
            "template": "tunnel mode [parameter1]",
            "command": "tunnel mode gre",
            "explanation": "设置隧道模式为GRE",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source GigabitEthernet1/0/0",
            "explanation": "设置隧道源接口为GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination [IP address of the spoke2 hub]",
            "explanation": "设置隧道目的地址为spoke2 hub的IP地址",
            "parameters": [
                {
                    "name": "destination IP",
                    "type": "IPv4",
                    "explanation": "隧道目的IP地址"
                }
            ]
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile [IPsec profile name]",
            "explanation": "设置隧道保护使用指定的IPsec配置文件",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "IPsec配置文件名"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF进程1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.3",
            "explanation": "设置OSPF路由器ID为172.16.1.3",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0",
            "explanation": "将网络172.16.1.0/24划入区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        },
        "neighbor [parameter1] weight [parameter2]": {
            "template": "neighbor [parameter1] weight [parameter2]",
            "command": "neighbor [IP address of the spoke2 hub] weight 1",
            "explanation": "设置邻居的权重为1",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居IP地址"
                },
                {
                    "name": "weight",
                    "type": "integer",
                    "explanation": "权重值"
                }
            ]
        }
    }
}