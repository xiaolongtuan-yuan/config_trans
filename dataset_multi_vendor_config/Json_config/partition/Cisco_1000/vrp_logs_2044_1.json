{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device",
        "explanation": "设置设备的主机名为 'Device'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "logging trap [parameter1]": {
        "template": "logging trap [parameter1]",
        "command": "logging trap informational",
        "explanation": "设置系统日志的陷阱级别为 'informational'",
        "parameters": [
            {
                "name": "trap level",
                "type": "string",
                "explanation": "陷阱级别"
            }
        ]
    },
    "logging source-interface [parameter1]": {
        "template": "logging source-interface [parameter1]",
        "command": "logging source-interface GigabitEthernet1/0/0",
        "explanation": "设置系统日志的源接口为 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "snmp-server community [parameter1] [parameter2]": {
        "template": "snmp-server community [parameter1] [parameter2]",
        "command": "snmp-server community public RO",
        "explanation": "配置 SNMP 社区字符串为 'public'，权限为只读（RO）",
        "parameters": [
            {
                "name": "community string",
                "type": "string",
                "explanation": "SNMP 社区字符串"
            },
            {
                "name": "permission",
                "type": "string",
                "explanation": "权限类型（RO 或 RW）"
            }
        ]
    },
    "snmp-server host [parameter1] version [parameter2] [parameter3]": {
        "template": "snmp-server host [parameter1] version [parameter2] [parameter3]",
        "command": "snmp-server host 10.1.1.1 version 2c public",
        "explanation": "配置 SNMP 服务器主机为 '10.1.1.1'，使用版本 '2c'，社区字符串为 'public'",
        "parameters": [
            {
                "name": "host address",
                "type": "IPv4",
                "explanation": "SNMP 服务器主机地址"
            },
            {
                "name": "version",
                "type": "string",
                "explanation": "SNMP 版本"
            },
            {
                "name": "community string",
                "type": "string",
                "explanation": "SNMP 社区字符串"
            }
        ]
    },
    "snmp-server enable traps": {
        "template": "snmp-server enable traps",
        "command": "snmp-server enable traps",
        "explanation": "启用 SNMP 陷阱",
        "parameters": []
    }
}