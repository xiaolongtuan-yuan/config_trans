                    "template": "loss-measure synthetic test-id [parameter1] receive-timeout [parameter2]",
                    "command": "loss-measure synthetic test-id 1 receive-timeout 300",
                    "explanation": "配置合成丢失测量，测试 ID 为 1，接收超时为 300 毫秒",
                    "parameters": [
                        {
                            "name": "test id",
                            "type": "integer",
                            "explanation": "测试 ID"
