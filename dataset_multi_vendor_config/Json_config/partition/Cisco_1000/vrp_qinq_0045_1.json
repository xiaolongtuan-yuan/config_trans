{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.9",
            "explanation": "设置 OSPF 路由器的 ID 为 2.2.2.9",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.9 0.0.0.0 area 0",
            "explanation": "将网络 2.2.2.9/32 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "mpls ldp router-id [parameter1]": {
        "template": "mpls ldp router-id [parameter1]",
        "command": "mpls ldp router-id 2.2.2.9",
        "explanation": "设置 MPLS LDP 路由器的 ID 为 2.2.2.9",
        "parameters": [
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.17.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用 PIM 稀疏模式",
            "parameters": []
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        },
        "mpls ldp auto-config": {
            "template": "mpls ldp auto-config",
            "command": "mpls ldp auto-config",
            "explanation": "在接口上启用 MPLS LDP 自动配置",
            "parameters": []
        }
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用 IP 组播路由",
        "parameters": []
    },
    "ip pim rp-candidate [parameter1] group-list [parameter2]": {
        "template": "ip pim rp-candidate [parameter1] group-list [parameter2]",
        "command": "ip pim rp-candidate Loopback1 group-list 224.0.0.0/4",
        "explanation": "配置 Loopback1 接口为 RP 候选，组播组范围为 224.0.0.0/4",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "group address",
                "type": "IPv4",
                "explanation": "组播组地址"
            }
        ]
    },
    "ip pim autorp listener": {
        "template": "ip pim autorp listener",
        "command": "ip pim autorp listener",
        "explanation": "启用 Auto-RP 监听功能",
        "parameters": []
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}