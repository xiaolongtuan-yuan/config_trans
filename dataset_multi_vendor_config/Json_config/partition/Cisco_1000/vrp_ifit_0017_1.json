        "parameters": [
            {
                "name": "clock source",
                "type": "string",
                "explanation": "时钟源名称"
            }
        ]
    },
    "clock source [parameter1] synchronization enable": {
        "template": "clock source [parameter1] synchronization enable",
        "command": "clock source bits0 synchronization enable",
