        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "privilege level",
                "type": "integer",
                "explanation": "用户的权限级别"
            }
        ]
    },
    "username [parameter1] service ssh": {
        "template": "username [parameter1] service ssh",
