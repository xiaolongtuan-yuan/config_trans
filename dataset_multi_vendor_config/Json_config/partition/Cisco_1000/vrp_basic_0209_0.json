{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname SSH_Server",
        "explanation": "设置设备的主机名为 'SSH_Server'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置接口 'GigabitEthernet0/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.0.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "crypto key generate rsa modulus [parameter1]": {
        "template": "crypto key generate rsa modulus [parameter1]",
        "command": "crypto key generate rsa modulus 2048",
        "explanation": "生成一个2048位的RSA密钥",
        "parameters": [
            {
                "name": "modulus size",
                "type": "integer",
                "explanation": "RSA密钥的模数大小（位数）"
            }
        ]
    },
    "crypto pki trustpoint [parameter1]": {
        "template": "crypto pki trustpoint [parameter1]",
        "command": "crypto pki trustpoint TP",
        "explanation": "创建或配置一个名为 'TP' 的信任点",
        "parameters": [
            {
                "name": "trustpoint name",
                "type": "string",
                "explanation": "信任点的名称"
            }
        ],
        "enrollment selfsigned": {
            "template": "enrollment selfsigned",
            "command": "enrollment selfsigned",
            "explanation": "指定信任点使用自签名证书",
            "parameters": []
        },
        "subject-name [parameter1]": {
            "template": "subject-name [parameter1]",
            "command": "subject-name cn=SSH_Server",
            "explanation": "设置证书的主题名称为 'cn=SSH_Server'",
            "parameters": [
                {
                    "name": "subject name",
                    "type": "string",
                    "explanation": "证书的主题名称"
                }
            ]
        },
        "rsakeypair [parameter1]": {
            "template": "rsakeypair [parameter1]",
            "command": "rsakeypair TP",
            "explanation": "指定与信任点关联的RSA密钥对",
            "parameters": [
                {
                    "name": "keypair name",
                    "type": "string",
                    "explanation": "RSA密钥对的名称"
                }
            ]
        }
    },
    "ip ssh version [parameter1]": {
        "template": "ip ssh version [parameter1]",
        "command": "ip ssh version 2",
        "explanation": "设置SSH协议版本为2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "SSH协议版本"
            }
        ]
    },
    "ip ssh source-interface [parameter1]": {
        "template": "ip ssh source-interface [parameter1]",
        "command": "ip ssh source-interface Loopback0",
        "explanation": "指定SSH会话的源接口为Loopback0",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "源接口的名称"
            }
        ]
    },
    "username [parameter1] password [parameter2]": {
        "template": "username [parameter1] password [parameter2]",
        "command": "username client001 password 0 @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "创建用户 'client001' 并设置密码",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "用户密码（明文）"
            }
        ]
    },
    "username [parameter1] privilege [parameter2]": {
        "template": "username [parameter1] privilege [parameter2]",
        "command": "username client001 privilege 3",
