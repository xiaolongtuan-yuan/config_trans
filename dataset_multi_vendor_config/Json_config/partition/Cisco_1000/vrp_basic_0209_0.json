        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            }
        ]
    },
    "username [parameter1] algorithm-type [parameter2]": {
        "template": "username [parameter1] algorithm-type [parameter2]",
        "command": "username client002 algorithm-type sm2",
        "explanation": "设置用户 'client002' 的算法类型为SM2",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "algorithm type",
                "type": "string",
                "explanation": "加密算法类型"
            }
        ]
    },
    "username [parameter1] sm2-key [parameter2]": {
        "template": "username [parameter1] sm2-key [parameter2]",
        "command": "username client002 sm2-key sm2key001",
