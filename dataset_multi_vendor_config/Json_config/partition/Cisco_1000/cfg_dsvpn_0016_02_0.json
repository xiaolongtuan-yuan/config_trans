{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Hub",
        "explanation": "设置设备的主机名为 'Hub'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode gre ip",
            "explanation": "设置隧道模式为 GRE over IP",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source Loopback0",
            "explanation": "设置隧道的源接口为 Loopback0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination <destination IP address>",
            "explanation": "设置隧道的目的地 IP 地址",
            "parameters": [
                {
                    "name": "destination IP address",
                    "type": "IPv4",
                    "explanation": "目的地 IP 地址"
                }
            ]
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile <IPSec profile name>",
            "explanation": "为隧道配置 IPSec 保护，使用指定的 IPSec 配置文件",
            "parameters": [
                {
                    "name": "IPSec profile name",
                    "type": "string",
                    "explanation": "IPSec 配置文件名"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "设置 OSPF 进程 1 的 Router ID 为 172.16.1.1",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0",
            "explanation": "配置 OSPF 区域 0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "在 OSPF 区域 0 中宣告网络 172.16.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    }
}