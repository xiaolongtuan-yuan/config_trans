{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1.1",
        "explanation": "配置接口 'GigabitEthernet3/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 200",
            "explanation": "配置接口的封装类型为 dot1Q，VLAN ID 为 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "cfm": {
            "template": "cfm",
            "command": "cfm",
            "explanation": "启用 CFM（Connectivity Fault Management）功能",
            "parameters": []
        },
        "cfm md [parameter1]": {
            "template": "cfm md [parameter1]",
            "command": "cfm md md3",
            "explanation": "配置 CFM 的维护域（Maintenance Domain）为 'md3'",
            "parameters": [
                {
                    "name": "Maintenance Domain",
                    "type": "string",
                    "explanation": "维护域名"
                }
            ]
        },
        "cfm ma [parameter1] md [parameter2]": {
            "template": "cfm ma [parameter1] md [parameter2]",
            "command": "cfm ma ma3 md md3",
            "explanation": "配置 CFM 的维护关联（Maintenance Association）为 'ma3'，并关联到维护域 'md3'",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "Maintenance Domain",
                    "type": "string",
                    "explanation": "维护域名"
                }
            ]
        },
        "cfm ma [parameter1] mep [parameter2]": {
            "template": "cfm ma [parameter1] mep [parameter2]",
            "command": "cfm ma ma3 mep 3",
            "explanation": "配置 CFM 的维护关联 'ma3' 的维护端点（Maintenance End Point）为 3",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "MEP ID",
                    "type": "integer",
                    "explanation": "维护端点ID"
                }
            ]
        },
        "cfm ma [parameter1] mep [parameter2] ccm-send": {
            "template": "cfm ma [parameter1] mep [parameter2] ccm-send",
            "command": "cfm ma ma3 mep 3 ccm-send",
            "explanation": "配置 CFM 的维护关联 'ma3' 的维护端点 3 发送 CCM（Continuity Check Message）",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "MEP ID",
                    "type": "integer",
                    "explanation": "维护端点ID"
                }
            ]
        },
        "cfm ma [parameter1] remote-mep [parameter2]": {
            "template": "cfm ma [parameter1] remote-mep [parameter2]",
            "command": "cfm ma ma3 remote-mep 4",
            "explanation": "配置 CFM 的维护关联 'ma3' 的远程维护端点（Remote Maintenance End Point）为 4",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "Remote MEP ID",
                    "type": "integer",
                    "explanation": "远程维护端点ID"
                }
            ]
        },
        "cfm ma [parameter1] remote-mep [parameter2] ccm-receive": {
            "template": "cfm ma [parameter1] remote-mep [parameter2] ccm-receive",
            "command": "cfm ma ma3 remote-mep 4 ccm-receive",
            "explanation": "配置 CFM 的维护关联 'ma3' 的远程维护端点 4 接收 CCM（Continuity Check Message）",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "Remote MEP ID",
                    "type": "integer",
                    "explanation": "远程维护端点ID"
                }
            ]
        },
        "cfm ma [parameter1] test [parameter2] mep [parameter3] remote-mep [parameter4]": {
            "template": "cfm ma [parameter1] test [parameter2] mep [parameter3] remote-mep [parameter4]",
            "command": "cfm ma ma3 test 1 mep 3 remote-mep 4",
            "explanation": "在 CFM 的维护关联 'ma3' 上，使用测试 ID 1，从维护端点 3 向远程维护端点 4 发送测试消息",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                },
                {
                    "name": "Test ID",
                    "type": "integer",
                    "explanation": "测试ID"
                },
                {
                    "name": "MEP ID",
                    "type": "integer",
                    "explanation": "维护端点ID"
                },
                {
                    "name": "Remote MEP ID",
                    "type": "integer",
                    "explanation": "远程维护端点ID"
                }
            ]
        }
    }
}