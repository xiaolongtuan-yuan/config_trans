{
    "enable": {
        "template": "enable",
        "command": "enable",
        "explanation": "进入特权模式",
        "parameters": []
    },
    "configure terminal": {
        "template": "configure terminal",
        "command": "configure terminal",
        "explanation": "进入全局配置模式",
        "parameters": []
    },
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.2.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65002",
        "explanation": "配置 BGP 进程，AS 号为 65002",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.2 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.2.1.2，远程 AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "network [parameter1] mask [parameter2]": {
            "template": "network [parameter1] mask [parameter2]",
            "command": "network 22.22.22.22 mask 255.255.255.255",
            "explanation": "在 BGP 中通告网络 22.22.22.22，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 和 IGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.2 activate",
                "explanation": "激活邻居 10.2.1.2 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式并返回到特权模式",
        "parameters": []
    },
    "write memory": {
        "template": "write memory",
        "command": "write memory",
        "explanation": "保存当前配置到 NVRAM",
        "parameters": []
    }
}