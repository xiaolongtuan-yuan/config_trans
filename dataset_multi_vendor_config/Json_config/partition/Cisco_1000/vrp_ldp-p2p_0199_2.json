{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRC",
        "explanation": "设置设备的主机名为 'LSRC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "mpls traffic-eng tunnel destination [parameter1]": {
            "template": "mpls traffic-eng tunnel destination [parameter1]",
            "command": "mpls traffic-eng tunnel destination 192.168.3.6",
            "explanation": "配置 MPLS 流量工程隧道的目标地址为 192.168.3.6",
            "parameters": [
                {
                    "name": "destination",
                    "type": "IPv4",
                    "explanation": "目标地址"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.9 255.255.255.255",
            "explanation": "配置环回接口的 IPv4 地址为 192.168.3.9，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.2.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.2.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF 区域"
                }
            ]
        }
    },
    "mpls traffic-eng": {
        "template": "mpls traffic-eng",
        "command": "mpls traffic-eng",
        "explanation": "启用 MPLS 流量工程",
        "parameters": []
    },
    "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]": {
        "template": "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]",
        "command": "tunnel mpls traffic-eng path-option 1 explicit name AtoC",
        "explanation": "配置 MPLS 流量工程隧道的路径选项 1 为显式路径，名称为 AtoC",
        "parameters": [
            {
                "name": "path-option",
                "type": "integer",
                "explanation": "路径选项编号"
            },
            {
                "name": "name",
                "type": "string",
                "explanation": "路径名称"
            }
        ]
    },
    "explicit-route label [parameter1] [parameter2]": {
        "template": "explicit-route label [parameter1] [parameter2]",
        "command": "explicit-route label 40 GigabitEthernet1/0/0",
        "explanation": "配置显式路由的标签为 40，出接口为 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "label",
                "type": "integer",
                "explanation": "标签值"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}