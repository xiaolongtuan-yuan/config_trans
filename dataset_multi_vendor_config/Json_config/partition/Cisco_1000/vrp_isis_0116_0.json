{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0001.0000.0000.0001.00",
            "explanation": "配置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ipv4 address [parameter1] [parameter2]": {
            "template": "ipv4 address [parameter1] [parameter2]",
            "command": "ipv4 address 10.0.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8::1/64",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "mpls ldp autoconfig": {
            "template": "mpls ldp autoconfig",
            "command": "mpls ldp autoconfig",
            "explanation": "在接口上自动配置 MPLS LDP",
            "parameters": []
        },
        "igmp join-group [parameter1]": {
            "template": "igmp join-group [parameter1]",
            "command": "igmp join-group 224.0.0.1",
            "explanation": "配置接口加入 IGMP 组播组 224.0.0.1",
            "parameters": [
                {
                    "name": "group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    }
}