        "parameters": [
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "MEP 标识符"
            },
            {
                "name": "test-id",
                "type": "integer",
                "explanation": "测试 ID"
            },
            {
                "name": "measurement type",
                "type": "string",
                "explanation": "测量类型"
