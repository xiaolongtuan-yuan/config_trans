    "aaa accounting exec [parameter1] [parameter2] group [parameter3]": {
        "template": "aaa accounting exec [parameter1] [parameter2] group [parameter3]",
        "command": "aaa accounting exec default start-stop group tacacs+",
        "explanation": "配置默认的执行会计记录，使用TACACS+，记录开始和停止事件",
        "parameters": [
            {
                "name": "list name",
                "type": "string",
                "explanation": "会计列表名称"
            },
            {
                "name": "record type",
                "type": "string",
                "explanation": "记录类型，如start-stop"
            },
            {
                "name": "method",
                "type": "string",
                "explanation": "会计方法"
            }
        ]
    },
