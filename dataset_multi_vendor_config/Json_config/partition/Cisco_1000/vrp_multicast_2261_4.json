{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no switchport": {
            "template": "no switchport",
            "command": "no switchport",
            "explanation": "将接口设置为三层模式（路由模式）",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "ip igmp join-group [parameter1]": {
            "template": "ip igmp join-group [parameter1]",
            "command": "ip igmp join-group 228.0.0.1",
            "explanation": "加入组播组 228.0.0.1",
            "parameters": [
                {
                    "name": "multicast group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 2",
        "explanation": "启用OSPF进程2",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.3.0 0.0.0.255 area 0",
            "explanation": "将网络 10.1.3.0/24 加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ip pim rp-address [parameter1]": {
        "template": "ip pim rp-address [parameter1]",
        "command": "ip pim rp-address 4.4.4.4",
        "explanation": "配置PIM的RP（Rendezvous Point）地址为4.4.4.4",
        "parameters": [
            {
                "name": "RP address",
                "type": "IPv4",
                "explanation": "RP地址"
            }
        ]
    }
}