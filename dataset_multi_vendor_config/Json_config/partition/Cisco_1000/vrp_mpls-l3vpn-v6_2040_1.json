{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制设置 MPLS LDP 的路由器 ID 为 Loopback1 接口的 IP 地址",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用 MPLS LDP 功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv4 address [parameter1] [parameter2]": {
            "template": "ipv4 address [parameter1] [parameter2]",
            "command": "ipv4 address 10.11.11.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.11.11.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用 IS-IS 进程 1",
            "parameters": [
                {
                    "name": "IS-IS process",
                    "type": "integer",
                    "explanation": "IS-IS 进程号"
                }
            ]
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP 功能",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}