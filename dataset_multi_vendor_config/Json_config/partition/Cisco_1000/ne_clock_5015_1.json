{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp clock-period [parameter1]": {
        "template": "ntp clock-period [parameter1]",
        "command": "ntp clock-period 3600",
        "explanation": "设置 NTP 时钟周期为 3600",
        "parameters": [
            {
                "name": "clock period",
                "type": "integer",
                "explanation": "时钟周期值"
            }
        ]
    },
    "ntp server [parameter1]": {
        "template": "ntp server [parameter1]",
        "command": "ntp server 10.0.0.1",
        "explanation": "配置 NTP 服务器地址为 10.0.0.1",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP 服务器的 IP 地址"
            }
        ]
    },
    "clock timezone [parameter1] [parameter2]": {
        "template": "clock timezone [parameter1] [parameter2]",
        "command": "clock timezone PST -8",
        "explanation": "设置时区为 PST，偏移量为 -8 小时",
        "parameters": [
            {
                "name": "time zone name",
                "type": "string",
                "explanation": "时区名称"
            },
            {
                "name": "offset",
                "type": "integer",
                "explanation": "时区偏移量（小时）"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ntp enable": {
            "template": "ntp enable",
            "command": "ntp enable",
            "explanation": "在接口上启用 NTP",
            "parameters": []
        },
        "ntp clock-period [parameter1]": {
            "template": "ntp clock-period [parameter1]",
            "command": "ntp clock-period 3600",
            "explanation": "设置接口的 NTP 时钟周期为 3600",
            "parameters": [
                {
                    "name": "clock period",
                    "type": "integer",
                    "explanation": "时钟周期值"
                }
            ]
        },
        "ntp server [parameter1] prefer": {
            "template": "ntp server [parameter1] prefer",
            "command": "ntp server 10.0.0.1 prefer",
            "explanation": "配置优先的 NTP 服务器地址为 10.0.0.1",
            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "NTP 服务器的 IP 地址"
                },
                {
                    "name": "prefer",
                    "type": "keyword",
                    "explanation": "标记该服务器为优先"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级为 1",
            "parameters": [
                {
                    "name": "priority level",
                    "type": "integer",
                    "explanation": "时钟优先级数值"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}