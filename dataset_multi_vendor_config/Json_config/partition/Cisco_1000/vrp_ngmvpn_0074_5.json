{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "配置接口 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.4.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.4.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "ip igmp join-group [parameter1]": {
            "template": "ip igmp join-group [parameter1]",
            "command": "ip igmp join-group 239.0.0.1",
            "explanation": "加入组播组239.0.0.1",
            "parameters": [
                {
                    "name": "group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65004",
        "explanation": "配置BGP进程，AS号为65004",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 192.168.2.1 remote-as 200",
            "explanation": "配置BGP邻居，IP地址为192.168.2.1，远程AS号为200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居IP地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入IPv4地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用BGP同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 192.168.2.0 mask 255.255.255.0",
                "explanation": "在BGP中通告网络192.168.2.0，子网掩码为255.255.255.0",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.2.1 activate",
                "explanation": "激活BGP邻居192.168.2.1的IPv4地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居IP地址"
                    }
                ]
            },
            "neighbor [parameter1] route-map [parameter2] in": {
                "template": "neighbor [parameter1] route-map [parameter2] in",
                "command": "neighbor 192.168.2.1 route-map DIRECT in",
                "explanation": "对来自邻居192.168.2.1的路由应用名为DIRECT的路由映射",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居IP地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    }
                ]
            }
        }
    },
    "ip pim rp-address [parameter1]": {
        "template": "ip pim rp-address [parameter1]",
        "command": "ip pim rp-address 192.168.3.1",
        "explanation": "配置PIM RP地址为192.168.3.1",
        "parameters": [
            {
                "name": "RP address",
                "type": "IPv4",
                "explanation": "RP地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}