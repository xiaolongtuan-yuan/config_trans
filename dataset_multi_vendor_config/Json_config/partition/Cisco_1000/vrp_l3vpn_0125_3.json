{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Server",
        "explanation": "设置设备的主机名为 'Server'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.2.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 1",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 1",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 路由进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 4.4.4.4",
            "explanation": "配置 BGP 路由器的 ID 为 4.4.4.4",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.3.1 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.2.3.1，AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 33.33.33.33 mask 255.255.255.255",
                "explanation": "在 BGP 中宣告网络 33.33.33.33/32",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "redistribute [parameter1]": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "重分发直连路由到 BGP",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "源协议"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.3.1 activate",
                "explanation": "激活邻居 10.2.3.1 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 路由进程，进程 ID 为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 4.4.4.4 0.0.0.0 area 0",
            "explanation": "在 OSPF 中宣告网络 4.4.4.4/32，区域为 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 33.33.33.33 255.255.255.255 Null0",
        "explanation": "配置静态路由，目的网络为 33.33.33.33/32，下一跳为 Null0 接口",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}