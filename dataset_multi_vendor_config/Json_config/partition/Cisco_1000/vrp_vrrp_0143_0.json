{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "standby [parameter1] ip [parameter2]": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 1 ip 192.168.1.1",
            "explanation": "配置 HSRP 组 1 的虚拟 IP 地址为 192.168.1.1",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "virtual ip address",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "standby [parameter1] priority [parameter2]": {
            "template": "standby [parameter1] priority [parameter2]",
            "command": "standby 1 priority 120",
            "explanation": "设置 HSRP 组 1 的优先级为 120",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "standby [parameter1] preempt delay minimum [parameter2]": {
            "template": "standby [parameter1] preempt delay minimum [parameter2]",
            "command": "standby 1 preempt delay minimum 20",
            "explanation": "配置 HSRP 组 1 的抢占延迟最小为 20 秒",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "delay",
                    "type": "integer",
                    "explanation": "延迟时间（秒）"
                }
            ]
        }
    }
}