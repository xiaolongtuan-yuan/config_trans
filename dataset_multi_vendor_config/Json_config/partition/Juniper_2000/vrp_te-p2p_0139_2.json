{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRc",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system statistics metrik-style [parameter1]": {
            "template": "set system statistics metrik-style [parameter1]",
            "command": "set system statistics metrik-style wide",
            "explanation": "配置系统统计信息的显示风格。",
            "parameters": [
                {
                    "name": "metrik-style",
                    "type": "string",
                    "explanation": "统计信息的显示风格，例如wide。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols mpls traffic-eng tunnels [parameter1]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1]",
            "command": "set protocols mpls traffic-eng tunnels enabled",
            "explanation": "启用MPLS流量工程的隧道功能。",
            "parameters": [
                {
                    "name": "tunnels",
                    "type": "string",
                    "explanation": "隧道功能的状态，例如enabled。"
                }
            ]
        },
        "set protocols mpls rsvp-te te-tunnel-id-range [parameter1]": {
            "template": "set protocols mpls rsvp-te te-tunnel-id-range [parameter1]",
            "command": "set protocols mpls rsvp-te te-tunnel-id-range 1-20",
            "explanation": "配置MPLS RSVP-TE隧道的ID范围。",
            "parameters": [
                {
                    "name": "te-tunnel-id-range",
                    "type": "string",
                    "explanation": "隧道ID的范围，例如1-20。"
                }
            ]
        },
        "set protocols mpls traffic-eng bandwidth [parameter1] interface [parameter2]": {
            "template": "set protocols mpls traffic-eng bandwidth [parameter1] interface [parameter2]",
            "command": "set protocols mpls traffic-eng bandwidth 10000 interface ge-1/0/2.0",
            "explanation": "配置MPLS流量工程的带宽及接口。",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "带宽值，单位为kbps。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.0。"
                }
            ]
        }
    },
    "set forwarding-mpls": {
        "template": "set forwarding-mpls",
        "set forwarding-mpls label protocol [parameter1]": {
            "template": "set forwarding-mpls label protocol [parameter1]",
            "command": "set forwarding-mpls label protocol ldp",
            "explanation": "配置MPLS转发的标签分发协议。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] interface [parameter2] unit [parameter3] family inet address [parameter4]/[parameter5]": {
            "template": "set routing-instances [parameter1] interface [parameter2] unit [parameter3] family inet address [parameter4]/[parameter5]",
            "command": "set routing-instances net interface ge-1/0/2 unit 0 family inet address 10.3.1.2/24",
            "explanation": "配置路由实例的接口IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称，例如net。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set routing-instances [parameter1] protocol isis [parameter2]": {
            "template": "set routing-instances [parameter1] protocol isis [parameter2]",
            "command": "set routing-instances net protocol isis level-2-only",
            "explanation": "配置路由实例的IS-IS协议为仅Level-2。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称，例如net。"
                },
                {
                    "name": "isis-level",
                    "type": "string",
                    "explanation": "IS-IS协议的级别，例如level-2-only。"
                }
            ]
        },
        "set routing-instances [parameter1] protocol isis": {
            "template": "set routing-instances [parameter1] protocol isis",
            "command": "set routing-instances net protocol isis",
            "explanation": "在路由实例中启用IS-IS协议。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称，例如net。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 3.3.3.3/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}