{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options lacp active",
            "explanation": "配置聚合接口的LACP选项为主动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                },
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP模式，active表示主动模式。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3] family inet address [parameter4]/[parameter5]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3] family inet address [parameter4]/[parameter5]",
            "command": "set interfaces ae10 unit 100 vlan-id 100 family inet address 10.1.1.1/24",
            "explanation": "配置聚合接口的VLAN ID及IPv4地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/0 ether-options 802.3ad ae10",
            "explanation": "将物理接口加入到指定的聚合接口中。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "物理接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        }
    }
}