{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "启用MPLS LDP协议。",
            "parameters": []
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id lo0.0",
            "explanation": "配置LDP协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的Router ID，通常为环回接口的地址。"
                }
            ]
        },
        "set protocols mpls traffic-engineering": {
            "template": "set protocols mpls traffic-engineering",
            "command": "set protocols mpls traffic-engineering",
            "explanation": "启用MPLS流量工程。",
            "parameters": []
        },
        "set protocols mpls traffic-engineering lsp [parameter1] destination [parameter2]": {
            "template": "set protocols mpls traffic-engineering lsp [parameter1] destination [parameter2]",
            "command": "set protocols mpls traffic-engineering lsp tunnel-1 destination 3.2.1.2",
            "explanation": "配置MPLS流量工程的LSP隧道目的地。",
            "parameters": [
                {
                    "name": "lsp-name",
                    "type": "string",
                    "explanation": "LSP隧道的名称。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "LSP隧道的目的地地址。"
                }
            ]
        },
        "set protocols mpls traffic-engineering lsp [parameter1] autoroute announce": {
            "template": "set protocols mpls traffic-engineering lsp [parameter1] autoroute announce",
            "command": "set protocols mpls traffic-engineering lsp tunnel-1 autoroute announce",
            "explanation": "配置LSP隧道的自动路由宣告。",
            "parameters": [
                {
                    "name": "lsp-name",
                    "type": "string",
                    "explanation": "LSP隧道的名称。"
                }
            ]
        },
        "set protocols mpls traffic-engineering refresh-interval [parameter1]": {
            "template": "set protocols mpls traffic-engineering refresh-interval [parameter1]",
            "command": "set protocols mpls traffic-engineering refresh-interval 5",
            "explanation": "配置MPLS流量工程的刷新间隔。",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "刷新间隔时间，单位为秒。"
                }
            ]
        },
        "set protocols mpls static-lsp [parameter1] transit ingress-label [parameter2] nexthop [parameter3] egress-label [parameter4]": {
            "template": "set protocols mpls static-lsp [parameter1] transit ingress-label [parameter2] nexthop [parameter3] egress-label [parameter4]",
            "command": "set protocols mpls static-lsp lsp1 transit ingress-label 20 nexthop 3.2.1.2 egress-label 40",
            "explanation": "配置静态LSP的传输路径。",
            "parameters": [
                {
                    "name": "lsp-name",
                    "type": "string",
                    "explanation": "静态LSP的名称。"
                },
                {
                    "name": "ingress-label",
                    "type": "integer",
                    "explanation": "入口标签。"
                },
                {
                    "name": "nexthop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                },
                {
                    "name": "egress-label",
                    "type": "integer",
                    "explanation": "出口标签。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 2.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mpls traffic-engineering": {
            "template": "set interfaces [parameter1] unit [parameter2] mpls traffic-engineering",
            "command": "set interfaces ge-1/0/0 unit 0 mpls traffic-engineering",
            "explanation": "配置接口的MPLS流量工程。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 1.1.1.1/32 next-hop 2.1.1.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目的网络的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}