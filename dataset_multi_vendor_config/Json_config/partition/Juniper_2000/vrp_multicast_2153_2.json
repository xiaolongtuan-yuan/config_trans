{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast no-reverse-path-check": {
            "template": "set routing-options multicast no-reverse-path-check",
            "command": "set routing-options multicast no-reverse-path-check",
            "explanation": "禁用多播的反向路径检查。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.3.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-1/0/0.0 mode sparse",
            "explanation": "配置PIM协议在指定接口上的模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse。"
                }
            ]
        },
        "set protocols igmp-snooping vlan [parameter1] interface [parameter2] static-group [parameter3]": {
            "template": "set protocols igmp-snooping vlan [parameter1] interface [parameter2] static-group [parameter3]",
            "command": "set protocols igmp-snooping vlan default interface ge-3/0/0.0 static-group 224.0.0.1",
            "explanation": "配置IGMP Snooping在指定VLAN和接口上的静态组播组。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称，例如default。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/0.0。"
                },
                {
                    "name": "group-address",
                    "type": "string",
                    "explanation": "静态组播组地址，例如224.0.0.1。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "配置OSPF协议在指定区域和接口上的运行。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号，例如0。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols pim rp local address [parameter1]": {
            "template": "set protocols pim rp local address [parameter1]",
            "command": "set protocols pim rp local address 1.1.1.1",
            "explanation": "配置PIM协议的本地RP地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "RP地址，例如1.1.1.1。"
                }
            ]
        },
        "set protocols pim rp static address [parameter1]": {
            "template": "set protocols pim rp static address [parameter1]",
            "command": "set protocols pim rp static address 2.2.2.2",
            "explanation": "配置PIM协议的静态RP地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "RP地址，例如2.2.2.2。"
                }
            ]
        },
        "set protocols pim bsr candidate [parameter1]": {
            "template": "set protocols pim bsr candidate [parameter1]",
            "command": "set protocols pim bsr candidate lo0.0",
            "explanation": "配置PIM协议的BSR候选接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        }
    }
}