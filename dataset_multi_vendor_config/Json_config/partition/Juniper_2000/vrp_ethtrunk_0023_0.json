{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis aggregated-devices ethernet device-count [parameter1]": {
            "template": "set chassis aggregated-devices ethernet device-count [parameter1]",
            "command": "set chassis aggregated-devices ethernet device-count 1",
            "explanation": "配置聚合设备的以太网设备数量。",
            "parameters": [
                {
                    "name": "device-count",
                    "type": "integer",
                    "explanation": "聚合设备中以太网设备的数量。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] ether-options 802.3ad lacp system-priority [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad lacp system-priority [parameter2]",
            "command": "set interfaces ge-1/0/1 ether-options 802.3ad lacp system-priority 100",
            "explanation": "配置接口的以太网选项为802.3ad，并设置LACP的系统优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "system-priority",
                    "type": "integer",
                    "explanation": "LACP的系统优先级，数值越小优先级越高。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols lacp system-priority [parameter1]": {
            "template": "set protocols lacp system-priority [parameter1]",
            "command": "set protocols lacp system-priority 100",
            "explanation": "配置LACP的系统优先级。",
            "parameters": [
                {
                    "name": "system-priority",
                    "type": "integer",
                    "explanation": "LACP的系统优先级，数值越小优先级越高。"
                }
            ]
        }
    }
}