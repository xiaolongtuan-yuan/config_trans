{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system static-host-mapping [parameter1] inet [parameter2]": {
            "template": "set system static-host-mapping [parameter1] inet [parameter2]",
            "command": "set system static-host-mapping host.com inet 10.100.1.2",
            "explanation": "配置静态主机映射，将主机名映射到指定的IPv4地址。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "主机名，用于映射到指定的IPv4地址。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "与主机名对应的IPv4地址。"
                }
            ]
        }
    }
}