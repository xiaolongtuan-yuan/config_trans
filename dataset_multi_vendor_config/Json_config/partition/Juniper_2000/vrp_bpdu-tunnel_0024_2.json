{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols [parameter1]": {
            "template": "set protocols [parameter1]",
            "command": "set protocols rstp",
            "explanation": "启用RSTP（快速生成树协议）。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "启用的协议名称，例如rstp。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching",
            "explanation": "配置接口为以太网交换模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "接口的协议族，例如ethernet-switching。"
                }
            ]
        },
        "set interfaces [parameter1] disable [parameter2]": {
            "template": "set interfaces [parameter1] disable [parameter2]",
            "command": "set interfaces ge-1/0/1 disable false",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "是否禁用接口，false表示启用。"
                }
            ]
        }
    }
}