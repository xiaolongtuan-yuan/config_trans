{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn1 route-distinguisher 100:1",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同VPN的路由。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target [parameter2]",
            "command": "set routing-instances vpn1 vrf-target target:1:1",
            "explanation": "配置路由实例的VRF目标。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由的导入和导出。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances vpn1 interface ge-2/0/0.0",
            "explanation": "将接口绑定到路由实例。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] family [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] family [parameter3]",
            "command": "set routing-instances vpn1 protocols bgp group vpn1-family family inet unicast",
            "explanation": "配置路由实例的BGP组支持IPv4单播。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，例如inet unicast。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] export [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] export [parameter3]",
            "command": "set routing-instances vpn1 protocols bgp group vpn1-family export policy-vpn1",
            "explanation": "配置路由实例的BGP组导出策略。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略的名称。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external type external",
            "explanation": "配置BGP组类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group external local-address 1.1.1.9",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址，用于BGP会话。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group external neighbor 2.2.2.9 peer-as 100",
            "explanation": "配置BGP组的邻居及其AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family [parameter2]": {
            "template": "set protocols bgp group [parameter1] family [parameter2]",
            "command": "set protocols bgp group external family inet unicast",
            "explanation": "配置BGP组支持IPv4单播。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，例如inet unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group vpn-family export policy-vpn1-export",
            "explanation": "配置BGP组的导出策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略的名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface all",
            "explanation": "在OSPF区域0的所有接口上启用OSPF。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.10.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet6 address 2001:db8:1::2/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    }
}