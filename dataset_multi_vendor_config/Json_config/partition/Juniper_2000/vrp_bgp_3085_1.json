{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security authentication-key-chains key-chain [parameter1] key [parameter2] secret [parameter3]": {
            "template": "set security authentication-key-chains key-chain [parameter1] key [parameter2] secret [parameter3]",
            "command": "set security authentication-key-chains key-chain Huawei key 1 secret \"$9$150D0F00001F480B5F5058171A1A1A\"",
            "explanation": "配置认证密钥链中的密钥及其秘密值。",
            "parameters": [
                {
                    "name": "key-chain",
                    "type": "string",
                    "explanation": "密钥链名称。"
                },
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "密钥编号。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "密钥的秘密值。"
                }
            ]
        },
        "set security authentication-key-chains key-chain [parameter1] key [parameter2] start-time [parameter3]": {
            "template": "set security authentication-key-chains key-chain [parameter1] key [parameter2] start-time [parameter3]",
            "command": "set security authentication-key-chains key-chain Huawei key 1 start-time \"00:00:00\"",
            "explanation": "配置密钥的生效时间。",
            "parameters": [
                {
                    "name": "key-chain",
                    "type": "string",
                    "explanation": "密钥链名称。"
                },
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "密钥编号。"
                },
                {
                    "name": "start-time",
                    "type": "string",
                    "explanation": "密钥的生效时间。"
                }
            ]
        },
        "set security authentication-key-chains key-chain [parameter1] key [parameter2] end-time [parameter3]": {
            "template": "set security authentication-key-chains key-chain [parameter1] key [parameter2] end-time [parameter3]",
            "command": "set security authentication-key-chains key-chain Huawei key 1 end-time \"00:30:00\"",
            "explanation": "配置密钥的失效时间。",
            "parameters": [
                {
                    "name": "key-chain",
                    "type": "string",
                    "explanation": "密钥链名称。"
                },
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "密钥编号。"
                },
                {
                    "name": "end-time",
                    "type": "string",
                    "explanation": "密钥的失效时间。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.20.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 200",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号。"
                }
            ]
        },
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 2.2.2.2",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group EBGP-100 type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group EBGP-100 peer-as 100",
            "explanation": "配置BGP组的对等体自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group EBGP-100 neighbor 10.20.1.1",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] authentication-key [parameter2]": {
            "template": "set protocols bgp group [parameter1] authentication-key [parameter2]",
            "command": "set protocols bgp group EBGP-100 authentication-key \"$9$150D0F00001F480B5F5058171A1A1A\"",
            "explanation": "配置BGP组的认证密钥。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "authentication-key",
                    "type": "string",
                    "explanation": "认证密钥。"
                }
            ]
        },
        "set protocols bgp group [parameter1] hold-time [parameter2]": {
            "template": "set protocols bgp group [parameter1] hold-time [parameter2]",
            "command": "set protocols bgp group EBGP-100 hold-time 11",
            "explanation": "配置BGP组的保持时间。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "hold-time",
                    "type": "integer",
                    "explanation": "保持时间，单位为秒。"
                }
            ]
        },
        "set protocols bgp group [parameter1] keepalive [parameter2]": {
            "template": "set protocols bgp group [parameter1] keepalive [parameter2]",
            "command": "set protocols bgp group EBGP-100 keepalive 12",
            "explanation": "配置BGP组的保持活动时间。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "keepalive",
                    "type": "integer",
                    "explanation": "保持活动时间，单位为秒。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family [parameter2] [parameter3]": {
            "template": "set protocols bgp group [parameter1] family [parameter2] [parameter3]",
            "command": "set protocols bgp group EBGP-100 family inet unicast",
            "explanation": "配置BGP组支持的地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        }
    }
}