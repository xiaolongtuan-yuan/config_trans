{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE-Bc",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast-routing": {
            "template": "set routing-options multicast-routing",
            "command": "set routing-options multicast-routing",
            "explanation": "启用多播路由功能。",
            "parameters": []
        },
        "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]": {
            "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
            "command": "set routing-options rib inet.0 static route 10.0.0.0/8 next-hop direct",
            "explanation": "配置静态路由，指定下一跳为直接连接。",
            "parameters": [
                {
                    "name": "rib",
                    "type": "string",
                    "explanation": "路由信息库名称，例如inet.0。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，这里指定为direct表示直接连接。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.110.11.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-0/0/0 mode sparse",
            "explanation": "配置PIM协议在指定接口上的模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] version [parameter2]": {
            "template": "set protocols igmp interface [parameter1] version [parameter2]",
            "command": "set protocols igmp interface ge-0/0/0 version 3",
            "explanation": "配置IGMP协议在指定接口上的版本。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "IGMP版本号。"
                }
            ]
        },
        "set protocols rip group [parameter1] version [parameter2]": {
            "template": "set protocols rip group [parameter1] version [parameter2]",
            "command": "set protocols rip group external version 2",
            "explanation": "配置RIP协议组的版本。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "RIP组名称。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "RIP版本号。"
                }
            ]
        },
        "set protocols rip group [parameter1] network [parameter2]": {
            "template": "set protocols rip group [parameter1] network [parameter2]",
            "command": "set protocols rip group external network 10.0.0.0/8",
            "explanation": "配置RIP协议组所通告的网络。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "RIP组名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    }
}