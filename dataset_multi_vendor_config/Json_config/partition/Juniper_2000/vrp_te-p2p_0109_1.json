{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp neighbor [parameter1]": {
            "template": "set protocols ldp neighbor [parameter1]",
            "command": "set protocols ldp neighbor 10.49.0.1",
            "explanation": "配置LDP协议的邻居。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "LDP邻居的IP地址。"
                }
            ]
        },
        "set protocols mpls label-mode [parameter1]": {
            "template": "set protocols mpls label-mode [parameter1]",
            "command": "set protocols mpls label-mode per-interface",
            "explanation": "配置MPLS标签模式为每接口模式。",
            "parameters": [
                {
                    "name": "label-mode",
                    "type": "string",
                    "explanation": "MPLS标签模式，例如per-interface。"
                }
            ]
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS的IP功能。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/29",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] template traffic-eng tunNEL [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] template traffic-eng tunNEL [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 template traffic-eng tunNEL 1",
            "explanation": "配置接口的流量工程模板。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "template-name",
                    "type": "string",
                    "explanation": "流量工程模板名称。"
                },
                {
                    "name": "tunnel-id",
                    "type": "integer",
                    "explanation": "隧道ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options isis network point-to-point [parameter1]/[parameter2]": {
            "template": "set routing-options isis network point-to-point [parameter1]/[parameter2]",
            "command": "set routing-options isis network point-to-point 10.1.1.0/29",
            "explanation": "配置ISIS协议的网络类型为点对点，并指定网络地址及子网掩码。",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security forwarding-plane-controls tunneling-traffic-eng [parameter1]": {
            "template": "set security forwarding-plane-controls tunneling-traffic-eng [parameter1]",
            "command": "set security forwarding-plane-controls tunneling-traffic-eng level-1",
            "explanation": "配置安全转发平面控制的流量工程隧道级别为1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "流量工程隧道的级别。"
                }
            ]
        }
    }
}