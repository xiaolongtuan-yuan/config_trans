{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/2 unit 0 family inet6 address 2001:db8:101:101::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel mode [parameter3]",
            "command": "set interfaces gr-0/0/3 unit 0 tunnel mode gre6rd",
            "explanation": "配置隧道模式为GRE6RD。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式，例如gre6rd。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]",
            "command": "set interfaces gr-0/0/3 unit 0 tunnel source ge-0/0/1",
            "explanation": "配置隧道的源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道的源接口名称，例如ge-0/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel sixrd-prefix [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel sixrd-prefix [parameter3]",
            "command": "set interfaces gr-0/0/3 unit 0 tunnel sixrd-prefix 2001:db8::/32",
            "explanation": "配置6RD隧道的前缀。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "sixrd-prefix",
                    "type": "string",
                    "explanation": "6RD隧道的前缀，例如2001:db8::/32。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel sixrd-prefix-length [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel sixrd-prefix-length [parameter3]",
            "command": "set interfaces gr-0/0/3 unit 0 tunnel sixrd-prefix-length 8",
            "explanation": "配置6RD隧道的前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "sixrd-prefix-length",
                    "type": "integer",
                    "explanation": "6RD隧道的前缀长度，例如8。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel border-relay [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel border-relay [parameter3]",
            "command": "set interfaces gr-0/0/3 unit 0 tunnel border-relay 10.1.1.2",
            "explanation": "配置6RD隧道的边界中继地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "border-relay",
                    "type": "string",
                    "explanation": "6RD隧道的边界中继地址，例如10.1.1.2。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]": {
            "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
            "command": "set routing-options rib inet6.0 static route 2001:db8::/32 next-hop gr-0/0/3.0",
            "explanation": "配置静态路由，指定下一跳地址。",
            "parameters": [
                {
                    "name": "rib",
                    "type": "string",
                    "explanation": "路由信息库名称，例如inet6.0。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址，例如2001:db8::/32。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，例如gr-0/0/3.0。"
                }
            ]
        }
    }
}