{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSR-E",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-1/0/1",
            "explanation": "在指定接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set protocols rsvp interface [parameter1]": {
            "template": "set protocols rsvp interface [parameter1]",
            "command": "set protocols rsvp interface ge-1/0/1",
            "explanation": "在指定接口上启用RSVP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.1.3.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router isis [parameter1] level-2-only metric-style [parameter2]": {
            "template": "set routing-options router isis [parameter1] level-2-only metric-style [parameter2]",
            "command": "set routing-options router isis 49.0001.0050.0500.5005.00 level-2-only metric-style wide",
            "explanation": "配置IS-IS路由协议，指定路由器ID，仅使用level-2，并设置度量风格为wide。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "IS-IS路由器的ID。"
                },
                {
                    "name": "metric-style",
                    "type": "string",
                    "explanation": "度量风格，例如wide。"
                }
            ]
        }
    },
    "set forwarding-plane": {
        "template": "set forwarding-plane",
        "set forwarding-plane mpls traffic-eng tunnels": {
            "template": "set forwarding-plane mpls traffic-eng tunnels",
            "command": "set forwarding-plane mpls traffic-eng tunnels",
            "explanation": "启用MPLS流量工程隧道。",
            "parameters": []
        }
    }
}