{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 1 family inet address 2.2.2.9/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/1 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/1.0",
            "explanation": "在MPLS协议中启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.0。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-1/0/1.0",
            "explanation": "在LDP协议中启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.0。"
                }
            ]
        },
        "set protocols mpls lsr-id [parameter1]": {
            "template": "set protocols mpls lsr-id [parameter1]",
            "command": "set protocols mpls lsr-id 1.1.1.9",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "MPLS的LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        },
        "set protocols ldp transport-address [parameter1]": {
            "template": "set protocols ldp transport-address [parameter1]",
            "command": "set protocols ldp transport-address 1.1.1.9",
            "explanation": "配置LDP的传输地址。",
            "parameters": [
                {
                    "name": "transport-address",
                    "type": "string",
                    "explanation": "LDP的传输地址，用于LDP会话的建立。"
                }
            ]
        }
    }
}