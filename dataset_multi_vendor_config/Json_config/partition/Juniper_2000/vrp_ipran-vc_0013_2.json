{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name MasterA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd": {
            "template": "set protocols bfd",
            "command": "set protocols bfd",
            "explanation": "启用BFD协议。",
            "parameters": []
        },
        "set protocols vrrp group [parameter1] virtual-address [parameter2]": {
            "template": "set protocols vrrp group [parameter1] virtual-address [parameter2]",
            "command": "set protocols vrrp group 1 virtual-address 3.3.3.3",
            "explanation": "配置VRRP组的虚拟IP地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "virtual-address",
                    "type": "string",
                    "explanation": "VRRP组的虚拟IP地址。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] track-interface [parameter2]": {
            "template": "set protocols vrrp group [parameter1] track-interface [parameter2]",
            "command": "set protocols vrrp group 1 track-interface ge-0/0/1",
            "explanation": "配置VRRP组跟踪的接口。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "track-interface",
                    "type": "string",
                    "explanation": "被跟踪的接口名称。"
                }
            ]
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 1",
            "explanation": "配置IS-IS协议的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示Level 1。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0001.0555.5555.5502.00",
            "explanation": "配置IS-IS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识IS-IS网络中的路由器。"
                }
            ]
        },
        "set protocols isis metric-style [parameter1]": {
            "template": "set protocols isis metric-style [parameter1]",
            "command": "set protocols isis metric-style wide",
            "explanation": "配置IS-IS的度量风格为wide。",
            "parameters": [
                {
                    "name": "metric-style",
                    "type": "string",
                    "explanation": "度量风格，wide表示使用宽度量。"
                }
            ]
        },
        "set protocols isis auto-cost reference-bandwidth [parameter1]": {
            "template": "set protocols isis auto-cost reference-bandwidth [parameter1]",
            "command": "set protocols isis auto-cost reference-bandwidth 1000000",
            "explanation": "配置IS-IS的自动成本参考带宽。",
            "parameters": [
                {
                    "name": "reference-bandwidth",
                    "type": "integer",
                    "explanation": "参考带宽，单位为Mbps。"
                }
            ]
        },
        "set protocols isis address-family [parameter1] [parameter2]": {
            "template": "set protocols isis address-family [parameter1] [parameter2]",
            "command": "set protocols isis address-family ipv4 unicast",
            "explanation": "配置IS-IS的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如ipv4。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "单播类型。"
                }
            ]
        },
        "set protocols isis redistribute [parameter1]": {
            "template": "set protocols isis redistribute [parameter1]",
            "command": "set protocols isis redistribute connected",
            "explanation": "配置IS-IS重分发直连路由。",
            "parameters": [
                {
                    "name": "redistribute",
                    "type": "string",
                    "explanation": "重分发的路由类型，connected表示直连路由。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.1.3.2/30",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/1 unit 0 family mpls",
            "explanation": "配置接口的MPLS家族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family isis network [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family isis network [parameter3]",
            "command": "set interfaces lo0 unit 0 family isis network point-to-point",
            "explanation": "配置环回接口的IS-IS网络类型为点对点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络类型，point-to-point表示点对点。"
                }
            ]
        }
    }
}