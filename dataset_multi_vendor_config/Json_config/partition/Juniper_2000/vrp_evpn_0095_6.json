{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set vlans [parameter1] l3-interface [parameter2]": {
            "template": "set vlans [parameter1] l3-interface [parameter2]",
            "command": "set vlans vlan10 l3-interface irb.10",
            "explanation": "配置VLAN的三层接口。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "l3-interface",
                    "type": "string",
                    "explanation": "三层接口的名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ae10 unit 0 family ethernet-switching vlan members 100",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "integer",
                    "explanation": "VLAN成员ID。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options link-speed 1g",
            "explanation": "配置聚合以太网接口的链路速度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "link-speed",
                    "type": "string",
                    "explanation": "链路速度，例如1g。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options lacp active",
            "explanation": "配置聚合以太网接口的LACP模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP模式，例如active。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-1/0/0 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项，将其加入指定的聚合组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching",
            "explanation": "配置接口的以太网交换功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 1 vlan-id 100",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 1 family bridge interface-mode access",
            "explanation": "配置接口单元的桥接模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family bridge bridge-domain [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family bridge bridge-domain [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 1 family bridge bridge-domain 10",
            "explanation": "配置接口单元的桥接域。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域号。"
                }
            ]
        }
    }
}