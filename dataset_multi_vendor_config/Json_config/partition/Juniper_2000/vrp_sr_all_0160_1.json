            "parameters": []
        },
        "set protocols mpls traffic-engineering load-share min-utilization [parameter1] maximum-paths [parameter2]": {
            "template": "set protocols mpls traffic-engineering load-share min-utilization [parameter1] maximum-paths [parameter2]",
            "command": "set protocols mpls traffic-engineering load-share min-utilization 10 maximum-paths 16",
            "explanation": "配置MPLS流量工程的负载共享参数，包括最小利用率和最大路径数。",
            "parameters": [
                {
                    "name": "min-utilization",
                    "type": "integer",
