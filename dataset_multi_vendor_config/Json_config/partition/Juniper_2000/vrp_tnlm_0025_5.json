{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interface": {
        "template": "set interface",
        "set interface [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interface [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interface ge-0/0/0 unit 0 family inet address 10.2.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instance": {
        "template": "set routing-instance",
        "set routing-instance [parameter1] routing-options autonomous-system [parameter2]": {
            "template": "set routing-instance [parameter1] routing-options autonomous-system [parameter2]",
            "command": "set routing-instance default-ri routing-options autonomous-system 65002",
            "explanation": "配置路由实例的自治系统号。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称，例如default-ri。"
                },
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "自治系统号，用于标识一个自治系统。"
                }
            ]
        }
    },
    "set protocols bgp": {
        "template": "set protocols bgp",
        "set protocols bgp neighbor [parameter1] remote-as [parameter2]": {
            "template": "set protocols bgp neighbor [parameter1] remote-as [parameter2]",
            "command": "set protocols bgp neighbor 10.2.1.2 remote-as 200",
            "explanation": "配置BGP邻居的远程自治系统号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的远程自治系统号。"
                }
            ]
        },
        "set protocols bgp neighbor [parameter1] activate": {
            "template": "set protocols bgp neighbor [parameter1] activate",
            "command": "set protocols bgp neighbor 10.2.1.2 activate",
            "explanation": "激活BGP邻居。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp neighbor [parameter1] address-family ipv4 unicast": {
            "template": "set protocols bgp neighbor [parameter1] address-family ipv4 unicast",
            "command": "set protocols bgp neighbor 10.2.1.2 address-family ipv4 unicast",
            "explanation": "为BGP邻居配置IPv4单播地址族。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp neighbor [parameter1] sync": {
            "template": "set protocols bgp neighbor [parameter1] sync",
            "command": "set protocols bgp neighbor 10.2.1.2 sync",
            "explanation": "配置BGP邻居同步。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        }
    }
}