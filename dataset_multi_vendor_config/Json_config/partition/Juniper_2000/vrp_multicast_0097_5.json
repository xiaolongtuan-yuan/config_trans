{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceF",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast-routing": {
            "template": "set routing-options multicast-routing",
            "command": "set routing-options multicast-routing",
            "explanation": "启用多播路由功能。",
            "parameters": []
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] disable": {
            "template": "set protocols isis level [parameter1] disable",
            "command": "set protocols isis level 1 disable",
            "explanation": "禁用IS-IS协议的Level 1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示Level 1。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0006.00",
            "explanation": "配置IS-IS协议的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识IS-IS网络中的设备。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] join-group [parameter2]": {
            "template": "set protocols igmp interface [parameter1] join-group [parameter2]",
            "command": "set protocols igmp interface ge-1/0/0.0 join-group 224.0.0.0",
            "explanation": "配置IGMP协议在指定接口上加入指定的多播组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                },
                {
                    "name": "group-address",
                    "type": "string",
                    "explanation": "多播组地址，例如224.0.0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.110.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] primary": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] primary",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.110.2.2/24 primary",
            "explanation": "配置接口的IPv4地址及子网掩码，并设置为主地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pim sparse-mode": {
            "template": "set interfaces [parameter1] unit [parameter2] pim sparse-mode",
            "command": "set interfaces ge-1/0/0 unit 0 pim sparse-mode",
            "explanation": "在指定接口上启用PIM稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}