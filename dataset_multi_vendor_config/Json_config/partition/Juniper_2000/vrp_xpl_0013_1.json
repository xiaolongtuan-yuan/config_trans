{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 1.1.5.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 1.1.5.1",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        }
    },
    "set protocols bgp": {
        "template": "set protocols bgp",
        "set protocols bgp peer-group [parameter1]": {
            "template": "set protocols bgp peer-group [parameter1]",
            "command": "set protocols bgp peer-group PEERS",
            "explanation": "配置BGP对等组。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] remote-as [parameter2]": {
            "template": "set protocols bgp peer-group [parameter1] remote-as [parameter2]",
            "command": "set protocols bgp peer-group PEERS remote-as 200",
            "explanation": "配置BGP对等组的远程AS号。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "远程AS号，用于标识对等方的自治系统。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] neighbor-address [parameter2] activate": {
            "template": "set protocols bgp peer-group [parameter1] neighbor-address [parameter2] activate",
            "command": "set protocols bgp peer-group PEERS neighbor-address 1.1.3.1 activate",
            "explanation": "激活BGP对等组中的特定邻居。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group PEERS type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal表示内部BGP。"
                }
            ]
        }
    }
}