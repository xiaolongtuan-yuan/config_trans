{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-distribution-protocol [parameter1]": {
            "template": "set protocols mpls label-distribution-protocol [parameter1]",
            "command": "set protocols mpls label-distribution-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1] force": {
            "template": "set protocols mpls ldp router-id [parameter1] force",
            "command": "set protocols mpls ldp router-id 4.4.4.4 force",
            "explanation": "强制配置MPLS LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP的路由器ID。"
                }
            ]
        },
        "set protocols ospf area [parameter1] range [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] range [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 range 4.4.4.4/32",
            "explanation": "配置OSPF区域0的范围。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "IP地址范围。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS家族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "接口协议家族，例如mpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] label pw-id [parameter3] remote-node [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] label pw-id [parameter3] remote-node [parameter4]",
            "command": "set interfaces ge-1/0/0 unit 100 label pw-id 100 remote-node 3.3.3.3",
            "explanation": "配置接口的伪线ID和远程节点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "pw-id",
                    "type": "integer",
                    "explanation": "伪线ID。"
                },
                {
                    "name": "remote-node",
                    "type": "string",
                    "explanation": "远程节点的IP地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 4.4.4.4/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 4.4.4.4",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID。"
                }
            ]
        }
    }
}