{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] description [parameter2]": {
            "template": "set interfaces [parameter1] description [parameter2]",
            "command": "set interfaces ae10 description \"PE2_to_PE1\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ae10 unit 0 family ethernet-switching vlan members all",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员，可以是特定的VLAN ID或'all'表示所有VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options link-speed 1g",
            "explanation": "配置聚合以太网接口的链路速度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "link-speed",
                    "type": "string",
                    "explanation": "链路速度，例如1g表示1Gbps。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options lacp active",
            "explanation": "配置聚合以太网接口的LACP模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP模式，例如active表示主动模式。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces ae10.1 encapsulation vlan-bridge",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.1。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-bridge。"
                }
            ]
        },
        "set interfaces [parameter1] vlan-id [parameter2]": {
            "template": "set interfaces [parameter1] vlan-id [parameter2]",
            "command": "set interfaces ae10.1 vlan-id 1",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] family inet address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] family inet address [parameter2]/[parameter3]",
            "command": "set interfaces ae10.1 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.1。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] family mpls": {
            "template": "set interfaces [parameter1] family mpls",
            "command": "set interfaces ae10.1 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.1。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-1/0/1 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项，将其加入到指定的聚合组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching",
            "explanation": "配置接口的以太网交换协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/1 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-2/0/1 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd interface [parameter1] local-address [parameter2]": {
            "template": "set protocols bfd interface [parameter1] local-address [parameter2]",
            "command": "set protocols bfd interface ge-2/0/1 local-address 2.2.2.9",
            "explanation": "配置BFD协议的本地地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BFD协议的本地地址。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] neighbor [parameter2]": {
            "template": "set protocols bfd interface [parameter1] neighbor [parameter2]",
            "command": "set protocols bfd interface ge-2/0/1 neighbor 1.1.1.9",
            "explanation": "配置BFD协议的邻居地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BFD协议的邻居地址。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] multiplier [parameter2]",
            "command": "set protocols bfd interface ge-2/0/1 multiplier 30",
            "explanation": "配置BFD协议的检测倍数。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD协议的检测倍数。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] minimum-interval [parameter2]": {
            "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
            "command": "set protocols bfd interface ge-2/0/1 minimum-interval 9",
            "explanation": "配置BFD协议的最小检测间隔。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "BFD协议的最小检测间隔，单位为毫秒。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-2/0/1",
            "explanation": "配置MPLS协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-2/0/1",
            "explanation": "配置LDP协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                }
            ]
        },
        "set protocols ldp targeted-session [parameter1]": {
            "template": "set protocols ldp targeted-session [parameter1]",
            "command": "set protocols ldp targeted-session 1.1.1.9",
            "explanation": "配置LDP协议的目标会话。",
            "parameters": [
                {
                    "name": "target-address",
                    "type": "string",
                    "explanation": "目标会话的地址。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface lo0.1",
            "explanation": "配置OSPF协议的区域接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
