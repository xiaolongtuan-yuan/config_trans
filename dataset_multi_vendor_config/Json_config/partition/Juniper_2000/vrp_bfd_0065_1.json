{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd interface [parameter1] minimum-interval [parameter2]": {
            "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 minimum-interval 120",
            "explanation": "配置BFD协议在指定接口上的最小间隔时间。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "BFD协议的最小间隔时间，单位为毫秒。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] multiplier [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 multiplier 3",
            "explanation": "配置BFD协议在指定接口上的乘数。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD协议的乘数，用于计算检测时间。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] neighbor [parameter2]": {
            "template": "set protocols bfd interface [parameter1] neighbor [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 neighbor 10.1.1.1",
            "explanation": "配置BFD协议的邻居地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BFD协议的邻居IP地址。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bfd interface [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bfd interface ge-1/0/0 neighbor 10.1.1.1 remote-as 10",
            "explanation": "配置BFD协议的邻居远程AS号。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BFD协议的邻居IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "邻居的远程AS号。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] neighbor [parameter2] local-as [parameter3]": {
            "template": "set protocols bfd interface [parameter1] neighbor [parameter2] local-as [parameter3]",
            "command": "set protocols bfd interface ge-1/0/0 neighbor 10.1.1.1 local-as 20",
            "explanation": "配置BFD协议的本地AS号。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BFD协议的邻居IP地址。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地的AS号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}