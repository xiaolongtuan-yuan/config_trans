{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family instance-name [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family instance-name [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family instance-name \"GigabitEthernet1/0/0\"",
            "explanation": "配置接口的实例名称。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "接口的实例名称。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 10.1.1.1/32 next-hop gigabit-ethernet1/0/0",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目标网络地址的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址或接口。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls traffic-eng tunnel tun-id [parameter1] label [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnel tun-id [parameter1] label [parameter2]",
            "command": "set protocols mpls traffic-eng tunnel tun-id 100 label 100",
            "explanation": "配置MPLS流量工程隧道的标签。",
            "parameters": [
                {
                    "name": "tunnel-id",
                    "type": "integer",
                    "explanation": "隧道的唯一标识符。"
                },
                {
                    "name": "label",
                    "type": "integer",
                    "explanation": "分配给隧道的标签。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnel tun-id [parameter1] mode [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnel tun-id [parameter1] mode [parameter2]",
            "command": "set protocols mpls traffic-eng tunnel tun-id 100 mode ip",
            "explanation": "配置MPLS流量工程隧道的模式。",
            "parameters": [
                {
                    "name": "tunnel-id",
                    "type": "integer",
                    "explanation": "隧道的唯一标识符。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道的模式，例如ip。"
                }
            ]
        }
    }
}