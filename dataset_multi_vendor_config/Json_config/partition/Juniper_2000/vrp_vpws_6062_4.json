{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols ldp router-id [parameter1] force": {
            "template": "set protocols ldp router-id [parameter1] force",
            "command": "set protocols ldp router-id loopback1 force",
            "explanation": "强制设置LDP协议的Router ID为指定的环回接口地址。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的Router ID，通常为环回接口地址。"
                }
            ]
        },
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "在MPLS协议下启用LDP。",
            "parameters": []
        },
        "set protocols mpls vprn vpni [parameter1] manual vpi [parameter2]": {
            "template": "set protocols mpls vprn vpni [parameter1] manual vpi [parameter2]",
            "command": "set protocols mpls vprn vpni vpn1 manual vpi 100",
            "explanation": "在MPLS VPRN VPNI下手动配置VPI。",
            "parameters": [
                {
                    "name": "vpn-name",
                    "type": "string",
                    "explanation": "VPN的名称。"
                },
                {
                    "name": "vpi",
                    "type": "integer",
                    "explanation": "虚拟路径标识符。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group ipv4-internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，如internal或external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] remote-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] remote-as [parameter2]",
            "command": "set protocols bgp group 1.1.1.9 remote-as 100",
            "explanation": "配置BGP组的远程AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "远程AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group 1.1.1.9 local-address loopback1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址，通常为环回接口地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group 1.1.1.9 export external",
            "explanation": "配置BGP组导出外部路由。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略，如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] activate": {
            "template": "set protocols bgp group [parameter1] activate",
            "command": "set protocols bgp group 1.1.1.9 activate",
            "explanation": "激活BGP组。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-2/0/0",
            "explanation": "在OSPF区域0下配置接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces po1.0 unit 0 family inet address 192.168.10.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如po1.0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpni instance-type vprn",
            "explanation": "配置路由实例的类型为VPRN。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，如VPRN。"
                }
            ]
        },
        "set routing-instances [parameter1] vrrp-group [parameter2] interface [parameter3]": {
            "template": "set routing-instances [parameter1] vrrp-group [parameter2] interface [parameter3]",
            "command": "set routing-instances vpni vrrp-group 1 interface ge-2/0/0.0",
            "explanation": "在路由实例下配置VRRP组及其关联的接口。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrrp-group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "关联的接口名称。"
                }
            ]
        }
    },
    "set routes": {
        "template": "set routes",
        "set routes static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routes static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routes static route 3.3.3.9/32 next-hop self",
            "explanation": "配置静态路由，指定下一跳为自身。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "网络前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，self表示自身。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id loopback1",
            "explanation": "配置路由器的Router ID为指定的环回接口地址。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的Router ID，通常为环回接口地址。"
                }
            ]
        }
    }
}