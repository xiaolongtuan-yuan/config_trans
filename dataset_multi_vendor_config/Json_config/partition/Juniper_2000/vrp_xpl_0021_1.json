{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] address [parameter2]/[parameter3]",
            "command": "set interfaces gigabit-ethernet3/0/0 address 1.1.5.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet3/0/0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp [parameter1]": {
            "template": "set protocols bgp [parameter1]",
            "command": "set protocols bgp 100",
            "explanation": "配置BGP协议的AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] peers [parameter2] as [parameter3]": {
            "template": "set protocols bgp [parameter1] peers [parameter2] as [parameter3]",
            "command": "set protocols bgp 100 peers 1.1.3.1 as 200",
            "explanation": "配置BGP对等体的IP地址及其AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                },
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] peer [parameter2] enable": {
            "template": "set protocols bgp [parameter1] peer [parameter2] enable",
            "command": "set protocols bgp 100 peer 1.1.3.1 enable",
            "explanation": "启用与指定BGP对等体的会话。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                },
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp 100 neighbor 1.1.3.1 remote-as 200",
            "explanation": "配置BGP邻居的IP地址及其远程AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的远程自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] address-family [parameter2] [parameter3]": {
            "template": "set protocols bgp [parameter1] address-family [parameter2] [parameter3]",
            "command": "set protocols bgp 100 address-family ipv4 unicast",
            "explanation": "配置BGP协议的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如ipv4。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "指定为单播传输。"
                }
            ]
        },
        "set protocols bgp [parameter1] neighbor [parameter2] activate": {
            "template": "set protocols bgp [parameter1] neighbor [parameter2] activate",
            "command": "set protocols bgp 100 neighbor 1.1.3.1 activate",
            "explanation": "激活与指定BGP邻居的会话。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的自治系统号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options synchronization [parameter1]": {
            "template": "set routing-options synchronization [parameter1]",
            "command": "set routing-options synchronization disable",
            "explanation": "禁用路由同步功能。",
            "parameters": [
                {
                    "name": "synchronization",
                    "type": "string",
                    "explanation": "路由同步功能的启用或禁用状态。"
                }
            ]
        }
    }
}