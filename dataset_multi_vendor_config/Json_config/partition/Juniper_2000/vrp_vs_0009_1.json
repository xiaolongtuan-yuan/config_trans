{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis fpc [parameter1] pic [parameter2] virtual-services [parameter3] description [parameter4]": {
            "template": "set chassis fpc [parameter1] pic [parameter2] virtual-services [parameter3] description [parameter4]",
            "command": "set chassis fpc 0 pic 0 virtual-services vs1 description \"vs1\"",
            "explanation": "配置虚拟服务的描述信息。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "Flexible PIC Concentrator (FPC) 编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "Physical Interface Card (PIC) 编号。"
                },
                {
                    "name": "virtual-service",
                    "type": "string",
                    "explanation": "虚拟服务的名称。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "虚拟服务的描述信息。"
                }
            ]
        },
        "set chassis fpc [parameter1] pic [parameter2] virtual-services [parameter3] interface [parameter4]": {
            "template": "set chassis fpc [parameter1] pic [parameter2] virtual-services [parameter3] interface [parameter4]",
            "command": "set chassis fpc 0 pic 0 virtual-services vs1 interface ge-3/0/2",
            "explanation": "配置虚拟服务绑定的接口。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "Flexible PIC Concentrator (FPC) 编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "Physical Interface Card (PIC) 编号。"
                },
                {
                    "name": "virtual-service",
                    "type": "string",
                    "explanation": "虚拟服务的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "绑定的接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-3/0/2 unit 0 family ethernet-switching interface-mode access",
            "explanation": "配置接口的以太网交换模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如access。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-3/0/2 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/2。"
                }
            ]
        }
    }
}