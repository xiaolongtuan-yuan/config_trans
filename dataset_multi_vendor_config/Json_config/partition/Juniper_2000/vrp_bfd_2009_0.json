            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static": {
            "template": "set routing-options static",
            "command": "set routing-options static",
            "explanation": "配置静态路由选项。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.2.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 1 vlan-id 100",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols vrrp group [parameter1] interface [parameter2]": {
            "template": "set protocols vrrp group [parameter1] interface [parameter2]",
            "command": "set protocols vrrp group 1 interface ge-2/0/0.1",
            "explanation": "配置VRRP组的接口。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.1。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] virtual-address [parameter2]": {
            "template": "set protocols vrrp group [parameter1] virtual-address [parameter2]",
            "command": "set protocols vrrp group 1 virtual-address 10.1.1.100",
            "explanation": "配置VRRP组的虚拟地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "virtual-address",
                    "type": "string",
                    "explanation": "VRRP组的虚拟IP地址。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] priority [parameter2]": {
            "template": "set protocols vrrp group [parameter1] priority [parameter2]",
            "command": "set protocols vrrp group 1 priority 160",
            "explanation": "配置VRRP组的优先级。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "VRRP组的优先级，数值越大优先级越高。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] preempt": {
            "template": "set protocols vrrp group [parameter1] preempt",
            "command": "set protocols vrrp group 1 preempt",
            "explanation": "配置VRRP组的抢占模式。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] track bfd-session": {
            "template": "set protocols vrrp group [parameter1] track bfd-session",
            "command": "set protocols vrrp group 1 track bfd-session",
            "explanation": "配置VRRP组跟踪BFD会话。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组的编号。"
                }
            ]
        },
        "set protocols bfd interface [parameter1]": {
            "template": "set protocols bfd interface [parameter1]",
            "command": "set protocols bfd interface ge-2/0/0.1",
            "explanation": "配置BFD协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.1。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] minimum-interval [parameter2]": {
            "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
            "command": "set protocols bfd interface ge-2/0/0.1 minimum-interval 100",
            "explanation": "配置BFD协议的最小间隔时间。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.1。"
                },
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "BFD协议的最小间隔时间，单位为毫秒。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] multiplier [parameter2]",
            "command": "set protocols bfd interface ge-2/0/0.1 multiplier 3",
            "explanation": "配置BFD协议的乘数。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.1。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD协议的乘数，用于计算检测时间。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "配置OSPF协议的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
