{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASG2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system time-zone [parameter1]": {
            "template": "set system time-zone [parameter1]",
            "command": "set system time-zone UTC",
            "explanation": "配置设备的时区。",
            "parameters": [
                {
                    "name": "timezone",
                    "type": "string",
                    "explanation": "设备的时区设置，例如UTC。"
                }
            ]
        },
        "set system clock source [parameter1]": {
            "template": "set system clock source [parameter1]",
            "command": "set system clock source internal",
            "explanation": "配置设备的时钟源。",
            "parameters": [
                {
                    "name": "source",
                    "type": "string",
                    "explanation": "时钟源类型，例如internal。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 255",
            "explanation": "配置PTP协议的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP协议的域编号。"
                }
            ]
        },
        "set protocols ptp priority [parameter1]": {
            "template": "set protocols ptp priority [parameter1]",
            "command": "set protocols ptp priority 1",
            "explanation": "配置PTP协议的优先级。",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "PTP协议的优先级值。"
                }
            ]
        },
        "set protocols ptp mode [parameter1]": {
            "template": "set protocols ptp mode [parameter1]",
            "command": "set protocols ptp mode boundary",
            "explanation": "配置PTP协议的模式。",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PTP协议的模式，例如boundary。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp clock-source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp clock-source [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp clock-source ptp",
            "explanation": "配置接口的PTP时钟源。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "clock-source",
                    "type": "string",
                    "explanation": "PTP时钟源类型，例如ptp。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp mode [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp mode boundary",
            "explanation": "配置接口的PTP模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PTP模式，例如boundary。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp domain [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp domain [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp domain 255",
            "explanation": "配置接口的PTP域。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域编号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp gps-glonass-model": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp gps-glonass-model",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp gps-glonass-model",
            "explanation": "配置接口的PTP GPS/GLONASS模型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp cable-delay [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp cable-delay [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp cable-delay 60",
            "explanation": "配置接口的PTP电缆延迟。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "cable-delay",
                    "type": "integer",
                    "explanation": "PTP电缆延迟时间，单位为纳秒。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp delay-mechanism [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching ptp delay-mechanism [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching ptp delay-mechanism delay",
            "explanation": "配置接口的PTP延迟机制。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "delay-mechanism",
                    "type": "string",
                    "explanation": "PTP延迟机制类型，例如delay。"
                }
            ]
        }
    }
}