{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols l2vpn": {
            "template": "set protocols l2vpn",
            "command": "set protocols l2vpn",
            "explanation": "启用L2VPN协议。",
            "parameters": []
        },
        "set protocols bgp group neighbor [parameter1] as [parameter2]": {
            "template": "set protocols bgp group neighbor [parameter1] as [parameter2]",
            "command": "set protocols bgp group neighbor 1.1.1.9 as 100",
            "explanation": "配置BGP邻居及其AS号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group neighbor [parameter1] update-source [parameter2]": {
            "template": "set protocols bgp group neighbor [parameter1] update-source [parameter2]",
            "command": "set protocols bgp group neighbor 1.1.1.9 update-source lo0.0",
            "explanation": "配置BGP更新源接口。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "用于BGP更新的源接口。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "配置OSPF区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称及单元号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
