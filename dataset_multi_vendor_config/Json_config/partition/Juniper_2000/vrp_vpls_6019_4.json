            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family l2vlan protocol [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2vlan protocol [parameter3]",
            "command": "set interfaces gigabit-ethernet2/0/0 unit 1 family l2vlan protocol vxlan",
