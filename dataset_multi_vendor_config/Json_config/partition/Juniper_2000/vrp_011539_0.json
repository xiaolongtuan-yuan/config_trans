{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 vlan-id 2",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 encapsulation vlan-ccc",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-ccc。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/2 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如mpls。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0",
            "explanation": "配置OSPF协议的区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-1/0/2.0",
            "explanation": "配置LDP协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.0。"
                }
            ]
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 2.2.2.2",
            "explanation": "配置LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP路由器ID。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan-ccc-instance-2 vlan-id 2",
            "explanation": "配置VLAN的VLAN ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称，例如vlan-ccc-instance-2。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set vlans [parameter1] interface [parameter2]": {
            "template": "set vlans [parameter1] interface [parameter2]",
            "command": "set vlans vlan-ccc-instance-2 interface ge-1/0/1.1",
            "explanation": "配置VLAN的接口。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称，例如vlan-ccc-instance-2。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains vfi-ldp1 vlan-id none",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如vfi-ldp1。"
                },
                {
                    "name": "vlan-id",
                    "type": "string",
                    "explanation": "VLAN ID，none表示不配置VLAN ID。"
                }
            ]
        },
        "set bridge-domains [parameter1] routing-interface [parameter2]": {
            "template": "set bridge-domains [parameter1] routing-interface [parameter2]",
            "command": "set bridge-domains vfi-ldp1 routing-interface lo0.0",
            "explanation": "配置桥接域的路由接口。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如vfi-ldp1。"
                },
                {
                    "name": "routing-interface",
                    "type": "string",
                    "explanation": "路由接口名称，例如lo0.0。"
                }
            ]
        },
        "set bridge-domains [parameter1] interface [parameter2]": {
            "template": "set bridge-domains [parameter1] interface [parameter2]",
            "command": "set bridge-domains vfi-ldp1 interface ge-1/0/1.1",
            "explanation": "配置桥接域的接口。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如vfi-ldp1。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                }
            ]
        }
    },
    "set ethernet-cfm": {
        "template": "set ethernet-cfm",
        "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] level [parameter3]": {
            "template": "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] level [parameter3]",
            "command": "set ethernet-cfm maintenance-domain md1 maintenance-association ma1 level 0",
            "explanation": "配置以太网CFM的维护域和维护关联的级别。",
            "parameters": [
                {
                    "name": "maintenance-domain",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称，例如ma1。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "维护级别，例如0。"
                }
            ]
        },
        "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] encapsulation vlan [parameter4]": {
            "template": "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] encapsulation vlan [parameter4]",
            "command": "set ethernet-cfm maintenance-domain md1 maintenance-association ma1 service-instance 1 encapsulation vlan 2",
            "explanation": "配置以太网CFM的服务实例的封装类型。",
            "parameters": [
                {
                    "name": "maintenance-domain",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称，例如ma1。"
                },
                {
                    "name": "service-instance",
                    "type": "integer",
                    "explanation": "服务实例ID，例如1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，例如2。"
                }
            ]
        },
        "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] remote-mep [parameter4] interface [parameter5]": {
            "template": "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] remote-mep [parameter4] interface [parameter5]",
            "command": "set ethernet-cfm maintenance-domain md1 maintenance-association ma1 service-instance 1 remote-mep 2 interface ge-1/0/1.1",
            "explanation": "配置以太网CFM的服务实例的远程MEP及接口。",
            "parameters": [
                {
                    "name": "maintenance-domain",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称，例如ma1。"
                },
                {
                    "name": "service-instance",
                    "type": "integer",
                    "explanation": "服务实例ID，例如1。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP ID，例如2。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                }
            ]
        },
        "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] continuity-check interval [parameter4] loss-threshold [parameter5]": {
            "template": "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] continuity-check interval [parameter4] loss-threshold [parameter5]",
            "command": "set ethernet-cfm maintenance-domain md1 maintenance-association ma1 service-instance 1 continuity-check interval 1000ms loss-threshold 20",
            "explanation": "配置以太网CFM的服务实例的连续性检查间隔及丢包阈值。",
            "parameters": [
                {
                    "name": "maintenance-domain",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称，例如ma1。"
                },
                {
                    "name": "service-instance",
                    "type": "integer",
                    "explanation": "服务实例ID，例如1。"
                },
                {
                    "name": "interval",
                    "type": "string",
                    "explanation": "连续性检查间隔，例如1000ms。"
                },
                {
                    "name": "loss-threshold",
                    "type": "integer",
                    "explanation": "丢包阈值，例如20。"
                }
            ]
        },
        "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] delay-measurement two-way interval [parameter4] count [parameter5]": {
            "template": "set ethernet-cfm maintenance-domain [parameter1] maintenance-association [parameter2] service-instance [parameter3] delay-measurement two-way interval [parameter4] count [parameter5]",
            "command": "set ethernet-cfm maintenance-domain md1 maintenance-association ma1 service-instance 1 delay-measurement two-way interval 1000 count 20",
            "explanation": "配置以太网CFM的服务实例的双向延迟测量间隔及计数。",
            "parameters": [
                {
                    "name": "maintenance-domain",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联名称，例如ma1。"
                },
                {
                    "name": "service-instance",
                    "type": "integer",
                    "explanation": "服务实例ID，例如1。"
                },
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "延迟测量间隔，例如1000。"
                },
                {
                    "name": "count",
                    "type": "integer",
                    "explanation": "延迟测量计数，例如20。"
                }
            ]
        }
    }
}