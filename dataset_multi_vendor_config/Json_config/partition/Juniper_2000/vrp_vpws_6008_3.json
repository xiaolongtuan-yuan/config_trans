{
    "set system": {
        "template": "set system",
        "set system hostname [parameter1]": {
            "template": "set system hostname [parameter1]",
            "command": "set system hostname PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options ldp router-id [parameter1]": {
            "template": "set forwarding-options ldp router-id [parameter1]",
            "command": "set forwarding-options ldp router-id 3.3.3.9",
            "explanation": "配置LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议使用的路由器ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如mpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3] port-mode [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3] port-mode [parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching port-mode l2transport",
            "explanation": "配置接口的以太网交换协议族及端口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如ethernet-switching。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如l2transport。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols l2tpv3 interface [parameter1] control-connection [parameter2] peer [parameter3]": {
            "template": "set protocols l2tpv3 interface [parameter1] control-connection [parameter2] peer [parameter3]",
            "command": "set protocols l2tpv3 interface ge-1/0/0 control-connection 1.1.1.9-vc 200 peer 1.1.1.8",
            "explanation": "配置L2TPv3协议的接口控制连接及对端地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "control-connection",
                    "type": "string",
                    "explanation": "控制连接标识，例如1.1.1.9-vc 200。"
                },
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对端地址，例如1.1.1.8。"
                }
            ]
        },
        "set protocols ospf area [parameter1] range [parameter2]": {
            "template": "set protocols ospf area [parameter1] range [parameter2]",
            "command": "set protocols ospf area 0 range 10.2.2.0/24",
            "explanation": "配置OSPF协议的区域及地址范围。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号，例如0。"
                },
                {
                    "name": "range",
                    "type": "string",
                    "explanation": "地址范围，例如10.2.2.0/24。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 3.3.3.9",
            "explanation": "配置OSPF协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF协议使用的路由器ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options static route 3.3.3.9/32 next-hop self",
            "explanation": "配置静态路由的下一跳。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目的地址及掩码，例如3.3.3.9/32。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，例如self表示本设备。"
                }
            ]
        }
    }
}