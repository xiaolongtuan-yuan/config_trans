{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 1.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp peer-group [parameter1]": {
            "template": "set protocols bgp peer-group [parameter1]",
            "command": "set protocols bgp peer-group peering-BGP-Peer",
            "explanation": "配置BGP对等组。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp peer-group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp peer-group peering-BGP-Peer peer-as 200",
            "explanation": "配置BGP对等组的AS号。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等组的AS号。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] neighbor-address [parameter2]": {
            "template": "set protocols bgp peer-group [parameter1] neighbor-address [parameter2]",
            "command": "set protocols bgp peer-group peering-BGP-Peer neighbor-address 1.1.2.1",
            "explanation": "配置BGP对等组的邻居地址。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group peering-BGP-Peer type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options sync-all synchronize [parameter1]": {
            "template": "set routing-options sync-all synchronize [parameter1]",
            "command": "set routing-options sync-all synchronize false",
            "explanation": "配置路由选项，同步所有路由。",
            "parameters": [
                {
                    "name": "synchronize",
                    "type": "boolean",
                    "explanation": "是否同步所有路由，false表示不同步。"
                }
            ]
        }
    }
}