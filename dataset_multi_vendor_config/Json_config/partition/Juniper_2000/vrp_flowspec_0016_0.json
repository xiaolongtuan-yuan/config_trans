{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.3.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 1.1.1.1",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的唯一标识符。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group external local-address 1.1.1.1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组使用的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp group external neighbor 3.3.3.3 remote-as 100",
            "explanation": "配置BGP组的邻居及其远程AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "邻居的远程AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] update-source [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] update-source [parameter3]",
            "command": "set protocols bgp group external neighbor 3.3.3.3 update-source lo0",
            "explanation": "配置BGP组的更新源接口。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "用于BGP更新的源接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group external family inet unicast",
            "explanation": "配置BGP组的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet6 [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet6 [parameter2]",
            "command": "set protocols bgp group external family inet6 unicast",
            "explanation": "配置BGP组的IPv6单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet6。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] interface-type [parameter3]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] interface-type [parameter3]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0.0 interface-type p2p",
            "explanation": "配置OSPF区域的接口类型为点对点。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                },
                {
                    "name": "interface-type",
                    "type": "string",
                    "explanation": "接口类型，例如p2p。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] network [parameter3]/[parameter4]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] network [parameter3]/[parameter4]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0.0 network 10.3.1.0/24",
            "explanation": "配置OSPF区域的接口网络地址及子网掩码。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols ospf area [parameter1] router-id [parameter2]": {
            "template": "set protocols ospf area [parameter1] router-id [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 router-id 1.1.1.1",
            "explanation": "配置OSPF区域的路由器ID。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的ID。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的唯一标识符。"
                }
            ]
        }
    }
}