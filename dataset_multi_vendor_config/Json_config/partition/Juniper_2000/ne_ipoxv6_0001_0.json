{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 duid [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 duid [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 dhcpv6 duid 0001000125a7625df063f9761497",
            "explanation": "配置接口的DHCPv6 DUID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "duid",
                    "type": "string",
                    "explanation": "DHCPv6 DUID，用于标识DHCPv6客户端。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.10.10.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 address 2001:DB8:1::1/120",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address autoconfig link-local": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address autoconfig link-local",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 address autoconfig link-local",
            "explanation": "配置接口的IPv6链路本地地址自动配置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 relay destination [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 relay destination [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 dhcpv6 relay destination 2001:DB8:3::2",
            "explanation": "配置接口的DHCPv6中继目标地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "DHCPv6中继目标地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 client": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6 client",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 dhcpv6 client",
            "explanation": "配置接口为DHCPv6客户端。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation vlan-bridge": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation vlan-bridge",
            "command": "set interfaces ge-0/0/2 unit 1 encapsulation vlan-bridge",
            "explanation": "配置接口的封装类型为VLAN桥接。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 1 vlan-id 1",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 10.1.1.1/32 next-hop 10.0.0.2",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目标网络地址的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options dhcp-relay server-group [parameter1] [parameter2]": {
            "template": "set forwarding-options dhcp-relay server-group [parameter1] [parameter2]",
            "command": "set forwarding-options dhcp-relay server-group 1 192.168.1.2",
            "explanation": "配置DHCP中继服务器组。",
            "parameters": [
                {
                    "name": "group-id",
                    "type": "integer",
                    "explanation": "DHCP中继服务器组的ID。"
                },
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "DHCP服务器的地址。"
                }
            ]
        }
    }
}