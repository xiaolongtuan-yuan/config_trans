{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd traceoptions file [parameter1]": {
            "template": "set protocols bfd traceoptions file [parameter1]",
            "command": "set protocols bfd traceoptions file bfd.log",
            "explanation": "配置BFD协议的跟踪选项，指定日志文件。",
            "parameters": [
                {
                    "name": "filename",
                    "type": "string",
                    "explanation": "日志文件的名称。"
                }
            ]
        },
        "set protocols bfd interface [parameter1]": {
            "template": "set protocols bfd interface [parameter1]",
            "command": "set protocols bfd interface ge-1/0/0",
            "explanation": "在指定接口上启用BFD协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] multiplier [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 multiplier 3",
            "explanation": "配置BFD协议的乘数，用于计算会话超时时间。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数值，用于计算会话超时时间。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] minimum-interval [parameter2]": {
            "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 minimum-interval 500",
            "explanation": "配置BFD协议的最小间隔时间，单位为毫秒。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "最小间隔时间，单位为毫秒。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] neighbor [parameter2]": {
            "template": "set protocols bfd interface [parameter1] neighbor [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 neighbor 2001:db8::2",
            "explanation": "配置BFD协议的邻居地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IPv6地址。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] local-address [parameter2]": {
            "template": "set protocols bfd interface [parameter1] local-address [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 local-address 2001:db8::1",
            "explanation": "配置BFD协议的本地地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地的IPv6地址。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] detect-multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] detect-multiplier [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 detect-multiplier 3",
            "explanation": "配置BFD协议的检测乘数，用于检测会话失败。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "detect-multiplier",
                    "type": "integer",
                    "explanation": "检测乘数值，用于检测会话失败。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] local-discriminator [parameter2]": {
            "template": "set protocols bfd interface [parameter1] local-discriminator [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 local-discriminator 1",
            "explanation": "配置BFD协议的本地鉴别器。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "本地鉴别器的值。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] remote-discriminator [parameter2]": {
            "template": "set protocols bfd interface [parameter1] remote-discriminator [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 remote-discriminator 2",
            "explanation": "配置BFD协议的远程鉴别器。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "remote-discriminator",
                    "type": "integer",
                    "explanation": "远程鉴别器的值。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8::1/32",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    }
}