{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains bd-10 vlan-id 10",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd-10。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识特定的VLAN。"
                }
            ]
        },
        "set bridge-domains [parameter1] interface [parameter2]": {
            "template": "set bridge-domains [parameter1] interface [parameter2]",
            "command": "set bridge-domains bd-10 interface ge-1/0/1.1",
            "explanation": "将接口添加到桥接域中。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd-10。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式和接口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3] family ethernet-switching interface-mode [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3] family ethernet-switching interface-mode [parameter4]",
            "command": "set interfaces ge-1/0/1 unit 1 vlan-id 10 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的VLAN ID和以太网交换模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识特定的VLAN。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        }
    },
    "delete interfaces": {
        "template": "delete interfaces",
        "delete interfaces [parameter1] disable": {
            "template": "delete interfaces [parameter1] disable",
            "command": "delete interfaces ge-1/0/1 disable",
            "explanation": "删除接口的禁用状态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        }
    }
}