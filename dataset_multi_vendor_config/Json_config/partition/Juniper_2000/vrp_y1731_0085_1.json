{
    "set system": {
        "template": "set system",
        "set system services evpn-type [parameter1]": {
            "template": "set system services evpn-type [parameter1]",
            "command": "set system services evpn-type evpn",
            "explanation": "配置系统服务支持EVPN类型。",
            "parameters": [
                {
                    "name": "evpn-type",
                    "type": "string",
                    "explanation": "EVPN类型，例如evpn。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis card [parameter1] module [parameter2] host-name [parameter3]": {
            "template": "set chassis card [parameter1] module [parameter2] host-name [parameter3]",
            "command": "set chassis card 0 module 1 host-name PE1",
            "explanation": "配置指定卡和模块的主机名。",
            "parameters": [
                {
                    "name": "card",
                    "type": "integer",
                    "explanation": "卡号。"
                },
                {
                    "name": "module",
                    "type": "integer",
                    "explanation": "模块号。"
                },
                {
                    "name": "host-name",
                    "type": "string",
                    "explanation": "主机名。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] encapsulation vlan-encapsulation dot1q [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation vlan-encapsulation dot1q [parameter2]",
            "command": "set interfaces ge-0/0/1.0 encapsulation vlan-encapsulation dot1q 2",
            "explanation": "配置接口的VLAN封装类型为dot1q，并指定VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family l2vpn": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2vpn",
            "command": "set interfaces ge-0/0/1 unit 0 family l2vpn",
            "explanation": "配置接口支持L2VPN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] vrf forwarding [parameter2]": {
            "template": "set interfaces [parameter1] vrf forwarding [parameter2]",
            "command": "set interfaces ge-0/0/1.0 vrf forwarding evpn",
            "explanation": "配置接口的VRF转发实例为EVPN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                },
                {
                    "name": "vrf",
                    "type": "string",
                    "explanation": "VRF实例名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family evpn instance-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family evpn instance-id [parameter3]",
            "command": "set interfaces lo0 unit 0 family evpn instance-id 1",
            "explanation": "配置环回接口支持EVPN，并指定实例ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "EVPN实例ID。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group evpn type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer [parameter2] password [parameter3]": {
            "template": "set protocols bgp group [parameter1] peer [parameter2] password [parameter3]",
            "command": "set protocols bgp group evpn peer 2.2.2.2 password \"\"",
            "explanation": "配置BGP组的对等体密码。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体IP地址。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "对等体密码。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-0/0/1.0",
            "explanation": "配置OSPF区域接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                }
            ]
        },
        "set protocols l2tpv3 interface [parameter1] encapsulation vlan-encapsulation dot1q [parameter2]": {
            "template": "set protocols l2tpv3 interface [parameter1] encapsulation vlan-encapsulation dot1q [parameter2]",
            "command": "set protocols l2tpv3 interface ge-0/0/1.0 encapsulation vlan-encapsulation dot1q 2",
            "explanation": "配置L2TPv3接口的VLAN封装类型为dot1q，并指定VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set protocols l2tpv3 interface [parameter1] ccm-enable": {
            "template": "set protocols l2tpv3 interface [parameter1] ccm-enable",
            "command": "set protocols l2tpv3 interface ge-0/0/1.0 ccm-enable",
            "explanation": "启用L2TPv3接口的CCM功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                }
            ]
        },
        "set protocols l2tpv3 interface [parameter1] ccm-interval-send [parameter2]": {
            "template": "set protocols l2tpv3 interface [parameter1] ccm-interval-send [parameter2]",
            "command": "set protocols l2tpv3 interface ge-0/0/1.0 ccm-interval-send 1000",
            "explanation": "配置L2TPv3接口的CCM发送间隔。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                },
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "CCM发送间隔，单位毫秒。"
                }
            ]
        },
        "set protocols l2tpv3 interface [parameter1] ccm-interval-recv [parameter2]": {
            "template": "set protocols l2tpv3 interface [parameter1] ccm-interval-recv [parameter2]",
            "command": "set protocols l2tpv3 interface ge-0/0/1.0 ccm-interval-recv 1000",
            "explanation": "配置L2TPv3接口的CCM接收间隔。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1.0。"
                },
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "CCM接收间隔，单位毫秒。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] route-target import [parameter2]": {
            "template": "set routing-instances [parameter1] route-target import [parameter2]",
            "command": "set routing-instances evpn route-target import 1:1",
            "explanation": "配置路由实例的导入路由目标。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "route-target",
                    "type": "string",
                    "explanation": "导入的路由目标。"
                }
            ]
        },
        "set routing-instances [parameter1] route-target export [parameter2]": {
            "template": "set routing-instances [parameter1] route-target export [parameter2]",
            "command": "set routing-instances evpn route-target export 1:1",
            "explanation": "配置路由实例的导出路由目标。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "route-target",
                    "type": "string",
                    "explanation": "导出的路由目标。"
                }
            ]
        }
    }
}