{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Spoke2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.3.10/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel source ge-1/0/0",
            "explanation": "配置隧道接口的源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道源接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel destination 172.16.1.1",
            "explanation": "配置隧道接口的目的地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "隧道目的地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols nhrp interface [parameter1] server [parameter2] nbma-address [parameter3]": {
            "template": "set protocols nhrp interface [parameter1] server [parameter2] nbma-address [parameter3]",
            "command": "set protocols nhrp interface gr-0/0/0.0 server 172.16.1.1 nbma-address 10.1.1.10",
            "explanation": "配置NHRP协议的接口、服务器地址和NBMA地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "NHRP接口名称，例如gr-0/0/0.0。"
                },
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "NHRP服务器地址。"
                },
                {
                    "name": "nbma-address",
                    "type": "string",
                    "explanation": "NBMA地址。"
                }
            ]
        },
        "set protocols nhrp network-id [parameter1]": {
            "template": "set protocols nhrp network-id [parameter1]",
            "command": "set protocols nhrp network-id 1",
            "explanation": "配置NHRP协议的网络ID。",
            "parameters": [
                {
                    "name": "network-id",
                    "type": "integer",
                    "explanation": "NHRP网络ID。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.1 interface ge-1/0/0.0",
            "explanation": "配置OSPF协议的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "OSPF接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 10.1.3.10",
            "explanation": "配置OSPF协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 192.168.0.0/24 next-hop 172.16.1.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}