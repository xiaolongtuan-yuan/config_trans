{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols multicast-routing": {
            "template": "set protocols multicast-routing",
            "command": "set protocols multicast-routing",
            "explanation": "启用多播路由功能。",
            "parameters": []
        },
        "set protocols pim rp static address [parameter1]": {
            "template": "set protocols pim rp static address [parameter1]",
            "command": "set protocols pim rp static address 2.2.2.2",
            "explanation": "配置PIM（协议独立多播）的静态RP（汇聚点）地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "PIM的静态RP地址。"
                }
            ]
        },
        "set protocols pim rp-candidate [parameter1]": {
            "template": "set protocols pim rp-candidate [parameter1]",
            "command": "set protocols pim rp-candidate lo0.0",
            "explanation": "指定PIM RP候选接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "PIM RP候选接口名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "在OSPF区域0中启用接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols msdp peer [parameter1] local-address [parameter2]": {
            "template": "set protocols msdp peer [parameter1] local-address [parameter2]",
            "command": "set protocols msdp peer 192.168.1.1 local-address ge-1/0/0.0",
            "explanation": "配置MSDP对等体及其本地地址。",
            "parameters": [
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "MSDP对等体的IP地址。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地接口的IP地址。"
                }
            ]
        },
        "set protocols msdp originator-id [parameter1]": {
            "template": "set protocols msdp originator-id [parameter1]",
            "command": "set protocols msdp originator-id 192.168.1.1",
            "explanation": "配置MSDP源ID。",
            "parameters": [
                {
                    "name": "originator-id",
                    "type": "string",
                    "explanation": "MSDP源ID的IP地址。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options prefix-list [parameter1] term [parameter2] from prefix [parameter3]/[parameter4]": {
            "template": "set policy-options prefix-list [parameter1] term [parameter2] from prefix [parameter3]/[parameter4]",
            "command": "set policy-options prefix-list list-c term 10 from prefix 192.168.0.0/16",
            "explanation": "配置前缀列表的条目，指定匹配的前缀。",
            "parameters": [
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "前缀列表条目的编号。"
                },
                {
                    "name": "prefix",
                    "type": "string",
                    "explanation": "匹配的IP前缀。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IP前缀的长度。"
                }
            ]
        },
        "set policy-options prefix-list [parameter1] term [parameter2] from orlonger": {
            "template": "set policy-options prefix-list [parameter1] term [parameter2] from orlonger",
            "command": "set policy-options prefix-list list-c term 10 from orlonger",
            "explanation": "配置前缀列表的条目，匹配指定前缀或更长的前缀。",
            "parameters": [
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "前缀列表条目的编号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.3.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet pim-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet pim-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet pim-mode sparse",
            "explanation": "配置接口的PIM模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "pim-mode",
                    "type": "string",
                    "explanation": "PIM模式，例如稀疏模式（sparse）。"
                }
            ]
        }
    }
}