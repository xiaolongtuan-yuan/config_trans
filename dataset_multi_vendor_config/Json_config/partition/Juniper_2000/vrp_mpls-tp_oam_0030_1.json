{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-switched-path [parameter1] to [parameter2]": {
            "template": "set protocols mpls label-switched-path [parameter1] to [parameter2]",
            "command": "set protocols mpls label-switched-path lsp-to-1-1-1-1 to 1.1.1.1",
            "explanation": "配置MPLS标签交换路径到指定目的地址。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols ldp track-igp-metric": {
            "template": "set protocols ldp track-igp-metric",
            "command": "set protocols ldp track-igp-metric",
            "explanation": "配置LDP跟踪IGP度量。",
            "parameters": []
        },
        "set protocols mpls traffic-engineering bgp-igp area [parameter1] shield": {
            "template": "set protocols mpls traffic-engineering bgp-igp area [parameter1] shield",
            "command": "set protocols mpls traffic-engineering bgp-igp area 0 shield",
            "explanation": "配置MPLS流量工程BGP-IGP区域保护。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号。"
                }
            ]
        },
        "set protocols mpls static-label-switched-path [parameter1] to [parameter2]": {
            "template": "set protocols mpls static-label-switched-path [parameter1] to [parameter2]",
            "command": "set protocols mpls static-label-switched-path mpls-lsp-1 to 1.1.1.1",
            "explanation": "配置静态MPLS标签交换路径到指定目的地址。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 2.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-0/0/0 unit 0 disable",
            "explanation": "禁用指定接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 1.1.1.1/32 next-hop 2.1.1.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options mpls add-label [parameter1] next-hop [parameter2]": {
            "template": "set forwarding-options mpls add-label [parameter1] next-hop [parameter2]",
            "command": "set forwarding-options mpls add-label 40 next-hop 3.2.1.2",
            "explanation": "配置MPLS转发选项，添加标签并指定下一跳。",
            "parameters": [
                {
                    "name": "label",
                    "type": "integer",
                    "explanation": "MPLS标签。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}