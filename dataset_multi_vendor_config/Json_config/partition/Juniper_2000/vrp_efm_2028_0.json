{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] description [parameter2]": {
            "template": "set interfaces [parameter1] description [parameter2]",
            "command": "set interfaces ge-1/0/1 description \"GigabitEthernet1/0/1\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching",
            "explanation": "配置接口的以太网交换功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/1 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options loopback oam": {
            "template": "set interfaces [parameter1] ether-options loopback oam",
            "command": "set interfaces ge-1/0/1 ether-options loopback oam",
            "explanation": "配置接口的以太网选项，启用OAM环回。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options loopback mode [parameter2]": {
            "template": "set interfaces [parameter1] ether-options loopback mode [parameter2]",
            "command": "set interfaces ge-1/0/1 ether-options loopback mode passive",
            "explanation": "配置接口的以太网选项，设置环回模式为被动。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "环回模式，例如passive。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options loopback trigger [parameter2]": {
            "template": "set interfaces [parameter1] ether-options loopback trigger [parameter2]",
            "command": "set interfaces ge-1/0/1 ether-options loopback trigger link-status-down",
            "explanation": "配置接口的以太网选项，设置环回触发条件为链路状态下降。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "trigger",
                    "type": "string",
                    "explanation": "环回触发条件，例如link-status-down。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options loopback holdup-timer [parameter2]": {
            "template": "set interfaces [parameter1] ether-options loopback holdup-timer [parameter2]",
            "command": "set interfaces ge-1/0/1 ether-options loopback holdup-timer 20000",
            "explanation": "配置接口的以太网选项，设置环回保持定时器。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "holdup-timer",
                    "type": "integer",
                    "explanation": "环回保持定时器的时间，单位为毫秒。"
                }
            ]
        }
    }
}