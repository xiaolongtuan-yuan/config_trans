{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，'all'表示所有接口。"
                }
            ]
        },
        "set protocols ldp ldp-id [parameter1]": {
            "template": "set protocols ldp ldp-id [parameter1]",
            "command": "set protocols ldp ldp-id 1.1.1.1",
            "explanation": "配置LDP协议的ID。",
            "parameters": [
                {
                    "name": "ldp-id",
                    "type": "string",
                    "explanation": "LDP协议的ID，通常为设备的环回地址。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-0/0/0",
            "explanation": "在指定接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set protocols rsvp interface [parameter1]": {
            "template": "set protocols rsvp interface [parameter1]",
            "command": "set protocols rsvp interface lt-0/0/10.0",
            "explanation": "在指定接口上启用RSVP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lt-0/0/10.0。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1] to [parameter2]": {
            "template": "set protocols mpls label-switched-path [parameter1] to [parameter2]",
            "command": "set protocols mpls label-switched-path Tunnel10 to 3.3.3.3",
            "explanation": "配置MPLS标签交换路径的目的地址。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "to",
                    "type": "string",
                    "explanation": "标签交换路径的目的地址。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1] primary path-options explicit name [parameter2]": {
            "template": "set protocols mpls label-switched-path [parameter1] primary path-options explicit name [parameter2]",
            "command": "set protocols mpls label-switched-path Tunnel10 primary path-options explicit name Tunnel10",
            "explanation": "配置MPLS标签交换路径的主路径选项。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "path-options",
                    "type": "string",
                    "explanation": "路径选项，'explicit'表示显式路径。"
                },
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "显式路径的名称。"
                }
            ]
        },
        "set protocols mpls traffic-engineering [parameter1]": {
            "template": "set protocols mpls traffic-engineering [parameter1]",
            "command": "set protocols mpls traffic-engineering bgp-igp",
            "explanation": "启用MPLS流量工程的BGP-IGP同步功能。",
            "parameters": [
                {
                    "name": "traffic-engineering",
                    "type": "string",
                    "explanation": "流量工程功能，'bgp-igp'表示BGP-IGP同步。"
                }
            ]
        },
        "set protocols oam mpls [parameter1]": {
            "template": "set protocols oam mpls [parameter1]",
            "command": "set protocols oam mpls failure-alert",
            "explanation": "启用MPLS OAM的故障告警功能。",
            "parameters": [
                {
                    "name": "oam",
                    "type": "string",
                    "explanation": "OAM功能，'failure-alert'表示故障告警。"
                }
            ]
        },
        "set protocols oam mpls test meg [parameter1]": {
            "template": "set protocols oam mpls test meg [parameter1]",
            "command": "set protocols oam mpls test meg test",
            "explanation": "配置MPLS OAM的测试MEG。",
            "parameters": [
                {
                    "name": "meg",
                    "type": "string",
                    "explanation": "MEG名称，用于标识测试的维护实体组。"
                }
            ]
        },
        "set protocols oam mpls test meg [parameter1] mep-local [parameter2] interface [parameter3]": {
            "template": "set protocols oam mpls test meg [parameter1] mep-local [parameter2] interface [parameter3]",
            "command": "set protocols oam mpls test meg test mep-local 1 interface lt-0/0/10.0",
            "explanation": "配置MPLS OAM测试MEG的本地MEP。",
            "parameters": [
                {
                    "name": "meg",
                    "type": "string",
                    "explanation": "MEG名称，用于标识测试的维护实体组。"
                },
                {
                    "name": "mep-local",
                    "type": "integer",
                    "explanation": "本地MEP的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lt-0/0/10.0。"
                }
            ]
        },
        "set protocols oam mpls test meg [parameter1] remote-mep-id [parameter2]": {
            "template": "set protocols oam mpls test meg [parameter1] remote-mep-id [parameter2]",
            "command": "set protocols oam mpls test meg test remote-mep-id 2",
            "explanation": "配置MPLS OAM测试MEG的远程MEP ID。",
            "parameters": [
                {
                    "name": "meg",
                    "type": "string",
                    "explanation": "MEG名称，用于标识测试的维护实体组。"
                },
                {
                    "name": "remote-mep-id",
                    "type": "integer",
                    "explanation": "远程MEP的ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 2.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces lt-0/0/10 unit 0 encapsulation mpls",
            "explanation": "配置接口的封装类型为MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lt-0/0/10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，'mpls'表示MPLS封装。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 2.2.2.2/32 next-hop 2.1.1.2",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}