{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ipv4-tunneling [parameter1]": {
            "template": "set protocols mpls ipv4-tunneling [parameter1]",
            "command": "set protocols mpls ipv4-tunneling ldp",
            "explanation": "配置MPLS的IPv4隧道使用LDP协议。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "使用的协议，例如ldp。"
                }
            ]
        },
        "set protocols mpls traffic-engineering": {
            "template": "set protocols mpls traffic-engineering",
            "command": "set protocols mpls traffic-engineering",
            "explanation": "启用MPLS流量工程功能。",
            "parameters": []
        },
        "set protocols isis level [parameter1] traffic-engineering": {
            "template": "set protocols isis level [parameter1] traffic-engineering",
            "command": "set protocols isis level 2 traffic-engineering",
            "explanation": "在ISIS协议的level 2启用流量工程。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                }
            ]
        },
        "set protocols isis global-segment-routing [parameter1]": {
            "template": "set protocols isis global-segment-routing [parameter1]",
            "command": "set protocols isis global-segment-routing mpls",
            "explanation": "在ISIS协议中全局启用MPLS分段路由。",
            "parameters": [
                {
                    "name": "technology",
                    "type": "string",
                    "explanation": "使用的技术，例如mpls。"
                }
            ]
        },
        "set protocols mpls label-switched-path global-block [parameter1] [parameter2]": {
            "template": "set protocols mpls label-switched-path global-block [parameter1] [parameter2]",
            "command": "set protocols mpls label-switched-path global-block 16000 19000",
            "explanation": "配置MPLS标签交换路径的全局标签块范围。",
            "parameters": [
                {
                    "name": "start-label",
                    "type": "integer",
                    "explanation": "标签块的起始标签值。"
                },
                {
                    "name": "end-label",
                    "type": "integer",
                    "explanation": "标签块的结束标签值。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-1/0/0",
            "explanation": "在指定接口上启用ISIS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols link-protection [parameter1]": {
            "template": "set protocols link-protection [parameter1]",
            "command": "set protocols link-protection fast-reroute",
            "explanation": "启用链路保护快速重路由功能。",
            "parameters": [
                {
                    "name": "protection-type",
                    "type": "string",
                    "explanation": "保护类型，例如fast-reroute。"
                }
            ]
        },
        "set protocols mpls interface [parameter1] traffic-engineering bandwidth [parameter2]": {
            "template": "set protocols mpls interface [parameter1] traffic-engineering bandwidth [parameter2]",
            "command": "set protocols mpls interface ge-1/0/0 traffic-engineering bandwidth 20000",
            "explanation": "配置指定接口的MPLS流量工程带宽。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "带宽值，单位为kbps。"
                }
            ]
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 2-only",
            "explanation": "配置ISIS协议仅运行在level 2。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS协议的级别，例如2-only。"
                }
            ]
        },
        "set protocols isis level [parameter1] hello-authentication-type [parameter2]": {
            "template": "set protocols isis level [parameter1] hello-authentication-type [parameter2]",
            "command": "set protocols isis level 2 hello-authentication-type simple",
            "explanation": "配置ISIS协议level 2的hello认证类型为简单认证。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                },
                {
                    "name": "authentication-type",
                    "type": "string",
                    "explanation": "认证类型，例如simple。"
                }
            ]
        },
        "set protocols isis level [parameter1] hello-authentication-key [parameter2]": {
            "template": "set protocols isis level [parameter1] hello-authentication-key [parameter2]",
            "command": "set protocols isis level 2 hello-authentication-key <your-auth-key>",
            "explanation": "配置ISIS协议level 2的hello认证密钥。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                },
                {
                    "name": "authentication-key",
                    "type": "string",
                    "explanation": "认证密钥。"
                }
            ]
        },
        "set protocols isis network [parameter1]": {
            "template": "set protocols isis network [parameter1]",
            "command": "set protocols isis network point-to-point",
            "explanation": "配置ISIS网络类型为点对点。",
            "parameters": [
                {
                    "name": "network-type",
                    "type": "string",
                    "explanation": "网络类型，例如point-to-point。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0000.0000.0004.00",
            "explanation": "配置ISIS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题（NET），例如49.0000.0000.0004.00。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family iso": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso",
            "command": "set interfaces ge-1/0/0 unit 0 family iso",
            "explanation": "在接口上启用ISO协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] point-to-point": {
            "template": "set interfaces [parameter1] unit [parameter2] point-to-point",
            "command": "set interfaces ge-1/0/0 unit 0 point-to-point",
            "explanation": "配置接口为点对点类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}