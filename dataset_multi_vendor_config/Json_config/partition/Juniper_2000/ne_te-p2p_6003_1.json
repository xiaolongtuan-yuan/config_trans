{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/1 unit 0 family mpls",
            "explanation": "配置接口支持MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-mode [parameter1]": {
            "template": "set protocols mpls label-mode [parameter1]",
            "command": "set protocols mpls label-mode ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-mode",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "set protocols mpls traffic-eng router-id [parameter1]": {
            "template": "set protocols mpls traffic-eng router-id [parameter1]",
            "command": "set protocols mpls traffic-eng router-id lo0.0",
            "explanation": "配置MPLS流量工程的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "Router ID，例如lo0.0。"
                }
            ]
        },
        "set protocols mpls traffic-eng area [parameter1]": {
            "template": "set protocols mpls traffic-eng area [parameter1]",
            "command": "set protocols mpls traffic-eng area 0.0.0.0",
            "explanation": "配置MPLS流量工程的区域。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "区域ID，例如0.0.0.0。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] to [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] to [parameter2]",
            "command": "set protocols mpls traffic-eng tunnels Tunnel1 to 4.4.4.4",
            "explanation": "配置MPLS流量工程隧道的目标地址。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如Tunnel1。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "隧道目标地址，例如4.4.4.4。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] bandwidth [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] bandwidth [parameter2]",
            "command": "set protocols mpls traffic-eng tunnels Tunnel1 bandwidth 10000k",
            "explanation": "配置MPLS流量工程隧道的带宽。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如Tunnel1。"
                },
                {
                    "name": "bandwidth",
                    "type": "string",
                    "explanation": "隧道带宽，例如10000k。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] metric [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] metric [parameter2]",
            "command": "set protocols mpls traffic-eng tunnels Tunnel1 metric 1",
            "explanation": "配置MPLS流量工程隧道的度量值。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如Tunnel1。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "隧道度量值，例如1。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] source [parameter2]": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] source [parameter2]",
            "command": "set protocols mpls traffic-eng tunnels Tunnel1 source lo0.0",
            "explanation": "配置MPLS流量工程隧道的源地址。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如Tunnel1。"
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "隧道源地址，例如lo0.0。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels [parameter1] autoroute announce": {
            "template": "set protocols mpls traffic-eng tunnels [parameter1] autoroute announce",
            "command": "set protocols mpls traffic-eng tunnels Tunnel1 autoroute announce",
            "explanation": "配置MPLS流量工程隧道的自动路由通告。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如Tunnel1。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 2.2.2.2",
            "explanation": "配置OSPF协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "Router ID，例如2.2.2.2。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0",
            "explanation": "配置OSPF区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "区域ID，例如0.0.0.0。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        },
        "set protocols mpls traffic-eng interfaces [parameter1] bandwidth [parameter2]": {
            "template": "set protocols mpls traffic-eng interfaces [parameter1] bandwidth [parameter2]",
            "command": "set protocols mpls traffic-eng interfaces ge-0/0/2 bandwidth 20000k",
            "explanation": "配置MPLS流量工程接口的带宽。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "bandwidth",
                    "type": "string",
                    "explanation": "接口带宽，例如20000k。"
                }
            ]
        }
    }
}