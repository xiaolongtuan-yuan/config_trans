{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols rstp vlan [parameter1] root-priority [parameter2]": {
            "template": "set protocols rstp vlan [parameter1] root-priority [parameter2]",
            "command": "set protocols rstp vlan 10 root-priority 0",
            "explanation": "配置RSTP协议的VLAN根优先级。",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "root-priority",
                    "type": "integer",
                    "explanation": "根桥的优先级，数值越小优先级越高。"
                }
            ]
        },
        "set protocols erps instance [parameter1] control-vlan [parameter2]": {
            "template": "set protocols erps instance [parameter1] control-vlan [parameter2]",
            "command": "set protocols erps instance 1 control-vlan 10",
            "explanation": "配置ERPS实例的控制VLAN。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID号。"
                },
                {
                    "name": "control-vlan",
                    "type": "integer",
                    "explanation": "控制VLAN的ID号。"
                }
            ]
        },
        "set protocols erps instance [parameter1] protected-ring [parameter2] instance [parameter3]": {
            "template": "set protocols erps instance [parameter1] protected-ring [parameter2] instance [parameter3]",
            "command": "set protocols erps instance 1 protected-ring 1 instance 1",
            "explanation": "配置ERPS实例的保护环。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID号。"
                },
                {
                    "name": "protected-ring",
                    "type": "integer",
                    "explanation": "保护环的ID号。"
                },
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "实例的ID号。"
                }
            ]
        },
        "set protocols erps instance [parameter1] wtr-timer [parameter2]": {
            "template": "set protocols erps instance [parameter1] wtr-timer [parameter2]",
            "command": "set protocols erps instance 1 wtr-timer 6000",
            "explanation": "配置ERPS实例的等待恢复定时器。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID号。"
                },
                {
                    "name": "wtr-timer",
                    "type": "integer",
                    "explanation": "等待恢复定时器的值，单位为毫秒。"
                }
            ]
        },
        "set protocols erps instance [parameter1] guard-timer [parameter2]": {
            "template": "set protocols erps instance [parameter1] guard-timer [parameter2]",
            "command": "set protocols erps instance 1 guard-timer 10000",
            "explanation": "配置ERPS实例的保护定时器。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID号。"
                },
                {
                    "name": "guard-timer",
                    "type": "integer",
                    "explanation": "保护定时器的值，单位为毫秒。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members [10 100-200]",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "array",
                    "explanation": "VLAN成员列表，可以是单个VLAN ID或VLAN ID范围。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching erps ring [parameter3] role [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching erps ring [parameter3] role [parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching erps ring 1 role owner",
            "explanation": "配置接口的ERPS环角色为owner。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "erps-ring",
                    "type": "integer",
                    "explanation": "ERPS环的ID号。"
                },
                {
                    "name": "role",
                    "type": "string",
                    "explanation": "ERPS环的角色，例如owner。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching erps ring [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching erps ring [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 0 family ethernet-switching erps ring 1",
            "explanation": "配置接口的ERPS环。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "erps-ring",
                    "type": "integer",
                    "explanation": "ERPS环的ID号。"
                }
            ]
        }
    }
}