{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn1 route-distinguisher 100:3",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同VRF实例中的相同IP地址。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target export [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target export [parameter2]",
            "command": "set routing-instances vpn1 vrf-target export target:100:1",
            "explanation": "配置路由实例的VRF目标导出策略。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由信息的导出。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target import [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target import [parameter2]",
            "command": "set routing-instances vpn1 vrf-target import target:100:1",
            "explanation": "配置路由实例的VRF目标导入策略。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由信息的导入。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] type [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] type [parameter3]",
            "command": "set routing-instances vpn1 protocols bgp group external-peers type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] peer-as [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] peer-as [parameter3]",
            "command": "set routing-instances vpn1 protocols bgp group external-peers peer-as 200",
            "explanation": "配置BGP组的对等AS号。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] neighbor [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] neighbor [parameter3]",
            "command": "set routing-instances vpn1 protocols bgp group external-peers neighbor 10.1.2.2",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set routing-instances [parameter1] routing-options static route [parameter2]/[parameter3] [parameter4]": {
            "template": "set routing-instances [parameter1] routing-options static route [parameter2]/[parameter3] [parameter4]",
            "command": "set routing-instances vpn1 routing-options static route 192.168.3.3/32 discard",
            "explanation": "配置静态路由，并将匹配的路由丢弃。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目的地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对匹配路由的操作，例如discard。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.1.2.3/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrf-table-label": {
            "template": "set interfaces [parameter1] unit [parameter2] vrf-table-label",
            "command": "set interfaces ge-2/0/0 unit 0 vrf-table-label",
            "explanation": "为接口配置VRF表标签。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 100",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号。"
                }
            ]
        }
    }
}