{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2]": {
            "template": "set system login user [parameter1] class [parameter2]",
            "command": "set system login user rta class super-user",
            "explanation": "配置系统登录用户及其权限等级。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "登录用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户的权限等级，例如super-user。"
                }
            ]
        },
        "set system login user [parameter1] authentication encrypted-password [parameter2]": {
            "template": "set system login user [parameter1] authentication encrypted-password [parameter2]",
            "command": "set system login user rta authentication encrypted-password @%@%EDF~DAdfFD934J3<DAF#*<!@%@%",
            "explanation": "配置系统登录用户的加密密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "登录用户名。"
                },
                {
                    "name": "encrypted-password",
                    "type": "string",
                    "explanation": "用户的加密密码。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lmpif1/0/0 unit 0 family inet address 10.110.0.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lmpif1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces lmpif1/0/0 encapsulation ppp",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lmpif1/0/0。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "接口的封装类型，例如ppp。"
                }
            ]
        },
        "set interfaces [parameter1] ppp-options chap [parameter2]": {
            "template": "set interfaces [parameter1] ppp-options chap [parameter2]",
            "command": "set interfaces lmpif1/0/0 ppp-options chap default",
            "explanation": "配置接口的PPP CHAP认证为默认设置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lmpif1/0/0。"
                },
                {
                    "name": "chap-option",
                    "type": "string",
                    "explanation": "PPP CHAP认证选项，例如default。"
                }
            ]
        },
        "set interfaces [parameter1] ppp-options chap local-name [parameter2]": {
            "template": "set interfaces [parameter1] ppp-options chap local-name [parameter2]",
            "command": "set interfaces lmpif1/0/0 ppp-options chap local-name rtb",
            "explanation": "配置接口的PPP CHAP认证本地名称。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lmpif1/0/0。"
                },
                {
                    "name": "local-name",
                    "type": "string",
                    "explanation": "PPP CHAP认证的本地名称。"
                }
            ]
        },
        "set interfaces [parameter1] ppp-options chap secret [parameter2]": {
            "template": "set interfaces [parameter1] ppp-options chap secret [parameter2]",
            "command": "set interfaces lmpif1/0/0 ppp-options chap secret @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
            "explanation": "配置接口的PPP CHAP认证密码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lmpif1/0/0。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "PPP CHAP认证的密码。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access profile [parameter1] authentication-order [parameter2]": {
            "template": "set access profile [parameter1] authentication-order [parameter2]",
            "command": "set access profile default1 authentication-order password",
            "explanation": "配置访问配置文件的认证顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如password。"
                }
            ]
        },
        "set access profile [parameter1] client user [parameter2]": {
            "template": "set access profile [parameter1] client user [parameter2]",
            "command": "set access profile default1 client user rta",
            "explanation": "配置访问配置文件的客户端用户。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "客户端用户名。"
                }
            ]
        }
    }
}