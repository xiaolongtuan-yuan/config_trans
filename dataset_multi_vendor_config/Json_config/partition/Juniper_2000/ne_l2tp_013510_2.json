{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name NE40EC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        }
    },
    "set services": {
        "template": "set services",
        "set services l2tp [parameter1]": {
            "template": "set services l2tp [parameter1]",
            "command": "set services l2tp enable",
            "explanation": "启用L2TP服务。",
            "parameters": [
                {
                    "name": "enable",
                    "type": "boolean",
                    "explanation": "启用或禁用L2TP服务。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access radius-server [parameter1] port [parameter2]": {
            "template": "set access radius-server [parameter1] port [parameter2]",
            "command": "set access radius-server 10.0.0.249 port 1812",
            "explanation": "配置RADIUS服务器的IP地址和端口。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的端口号。"
                }
            ]
        },
        "set access radius-server [parameter1] secret [parameter2]": {
            "template": "set access radius-server [parameter1] secret [parameter2]",
            "command": "set access radius-server 10.0.0.249 secret \"$9$090C000D1E1F\"",
            "explanation": "配置RADIUS服务器的共享密钥。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                }
            ]
        },
        "set access l2tp client-dialout [parameter1]": {
            "template": "set access l2tp client-dialout [parameter1]",
            "command": "set access l2tp client-dialout lns1",
            "explanation": "配置L2TP客户端拨出。",
            "parameters": [
                {
                    "name": "client-dialout",
                    "type": "string",
                    "explanation": "L2TP客户端拨出名称。"
                }
            ]
        },
        "set access l2tp client-dialout [parameter1] virtual-template [parameter2]": {
            "template": "set access l2tp client-dialout [parameter1] virtual-template [parameter2]",
            "command": "set access l2tp client-dialout lns1 virtual-template vt-1",
            "explanation": "配置L2TP客户端拨出的虚拟模板。",
            "parameters": [
                {
                    "name": "client-dialout",
                    "type": "string",
                    "explanation": "L2TP客户端拨出名称。"
                },
                {
                    "name": "virtual-template",
                    "type": "string",
                    "explanation": "虚拟模板名称。"
                }
            ]
        },
        "set access l2tp server-dialin [parameter1]": {
            "template": "set access l2tp server-dialin [parameter1]",
            "command": "set access l2tp server-dialin group1",
            "explanation": "配置L2TP服务器拨入。",
            "parameters": [
                {
                    "name": "server-dialin",
                    "type": "string",
                    "explanation": "L2TP服务器拨入组名称。"
                }
            ]
        },
        "set access l2tp server-dialin [parameter1] virtual-template [parameter2]": {
            "template": "set access l2tp server-dialin [parameter1] virtual-template [parameter2]",
            "command": "set access l2tp server-dialin group1 virtual-template vt-1",
            "explanation": "配置L2TP服务器拨入的虚拟模板。",
            "parameters": [
                {
                    "name": "server-dialin",
                    "type": "string",
                    "explanation": "L2TP服务器拨入组名称。"
                },
                {
                    "name": "virtual-template",
                    "type": "string",
                    "explanation": "虚拟模板名称。"
                }
            ]
        },
        "set access l2tp server-dialin [parameter1] authentication [parameter2]": {
            "template": "set access l2tp server-dialin [parameter1] authentication [parameter2]",
            "command": "set access l2tp server-dialin group1 authentication no-authentication",
            "explanation": "配置L2TP服务器拨入的认证方式。",
            "parameters": [
                {
                    "name": "server-dialin",
                    "type": "string",
                    "explanation": "L2TP服务器拨入组名称。"
                },
                {
                    "name": "authentication",
                    "type": "string",
                    "explanation": "认证方式，例如no-authentication。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3] range low [parameter4] high [parameter5]": {
            "template": "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3] range low [parameter4] high [parameter5]",
            "command": "set access address-assignment pool pool1 family inet network 10.10.0.0/24 range low 10.10.0.2 high 10.10.0.100",
            "explanation": "配置地址分配池的网络地址范围和地址分配范围。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "地址分配池名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "low",
                    "type": "string",
                    "explanation": "地址分配范围的起始地址。"
                },
                {
                    "name": "high",
                    "type": "string",
                    "explanation": "地址分配范围的结束地址。"
                }
            ]
        },
        "set access profile [parameter1] authentication-order [parameter2]": {
            "template": "set access profile [parameter1] authentication-order [parameter2]",
            "command": "set access profile default1 authentication-order radius",
            "explanation": "配置访问配置文件的认证顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        },
        "set access profile [parameter1] authorization order [parameter2]": {
            "template": "set access profile [parameter1] authorization order [parameter2]",
            "command": "set access profile default1 authorization order radius",
            "explanation": "配置访问配置文件的授权顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authorization-order",
                    "type": "string",
                    "explanation": "授权顺序，例如radius。"
                }
            ]
        },
        "set access profile [parameter1] accounting start-stop order [parameter2]": {
            "template": "set access profile [parameter1] accounting start-stop order [parameter2]",
            "command": "set access profile default1 accounting start-stop order radius",
            "explanation": "配置访问配置文件的计费顺序。",
            "parameters": [
                {
                    "name": "profile",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "accounting-order",
                    "type": "string",
                    "explanation": "计费顺序，例如radius。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] ppp-options [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp-options [parameter3]",
            "command": "set interfaces vt-1 unit 0 ppp-options chap",
            "explanation": "配置接口的PPP选项。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如vt-1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ppp-options",
                    "type": "string",
                    "explanation": "PPP选项，例如chap。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.200.200.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 1.1.1.1/32 next-hop 10.200.200.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}