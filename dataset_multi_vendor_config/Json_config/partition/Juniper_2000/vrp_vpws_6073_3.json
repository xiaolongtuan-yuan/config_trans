{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls lsr-id [parameter1]": {
            "template": "set protocols mpls lsr-id [parameter1]",
            "command": "set protocols mpls lsr-id 1.1.1.1",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "MPLS的LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/0.0",
            "explanation": "在指定接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-1/0/0.0",
            "explanation": "在指定接口上启用LDP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols l2vpn": {
            "template": "set protocols l2vpn",
            "command": "set protocols l2vpn",
            "explanation": "启用L2VPN功能。",
            "parameters": []
        },
        "set protocols l2circuit neighbor [parameter1] interface [parameter2] pseudowire-id [parameter3]": {
            "template": "set protocols l2circuit neighbor [parameter1] interface [parameter2] pseudowire-id [parameter3]",
            "command": "set protocols l2circuit neighbor 2.2.2.2 interface ge-1/0/2.100 pseudowire-id 100",
            "explanation": "配置L2电路的邻居、接口和伪线ID。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.100。"
                },
                {
                    "name": "pseudowire-id",
                    "type": "integer",
                    "explanation": "伪线ID，用于标识L2电路。"
                }
            ]
        },
        "set protocols l2circuit neighbor [parameter1] interface [parameter2] redundancy [parameter3]": {
            "template": "set protocols l2circuit neighbor [parameter1] interface [parameter2] redundancy [parameter3]",
            "command": "set protocols l2circuit neighbor 2.2.2.2 interface ge-1/0/2.100 redundancy master",
            "explanation": "配置L2电路的冗余模式。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.100。"
                },
                {
                    "name": "redundancy",
                    "type": "string",
                    "explanation": "冗余模式，例如master。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.1",
            "explanation": "在指定OSPF区域中启用接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 100 encapsulation vlan-vpls",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-vpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 100 vlan-id 100",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] input-vlan-map [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] input-vlan-map [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 100 input-vlan-map push",
            "explanation": "配置接口的输入VLAN映射。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "input-vlan-map",
                    "type": "string",
                    "explanation": "输入VLAN映射操作，例如push。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-1/0/2 unit 100 family vpls",
            "explanation": "配置接口的协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如vpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}