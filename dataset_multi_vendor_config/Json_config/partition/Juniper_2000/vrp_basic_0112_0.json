{
    "set system": {
        "template": "set system",
        "set system login user [parameter1] class [parameter2]": {
            "template": "set system login user [parameter1] class [parameter2]",
            "command": "set system login user huawei class super-user",
            "explanation": "配置系统登录用户及其权限等级。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "登录用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户的权限等级，例如super-user。"
                }
            ]
        },
        "set system login user [parameter1] authentication plain-text-password [parameter2]": {
            "template": "set system login user [parameter1] authentication plain-text-password [parameter2]",
            "command": "set system login user huawei authentication plain-text-password \"@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%\"",
            "explanation": "配置系统登录用户的认证方式为明文密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "登录用户名。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "用户的明文密码。"
                }
            ]
        },
        "set system services ftp": {
            "template": "set system services ftp",
            "command": "set system services ftp",
            "explanation": "启用系统FTP服务。",
            "parameters": []
        },
        "set system services ftp source-interface [parameter1]": {
            "template": "set system services ftp source-interface [parameter1]",
            "command": "set system services ftp source-interface lo0",
            "explanation": "配置FTP服务的源接口。",
            "parameters": [
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "FTP服务的源接口名称，例如lo0。"
                }
            ]
        },
        "set system services ftp login [parameter1]": {
            "template": "set system services ftp login [parameter1]",
            "command": "set system services ftp login huawei",
            "explanation": "配置FTP服务的登录用户名。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "FTP服务的登录用户名。"
                }
            ]
        },
        "set system services ftp password [parameter1]": {
            "template": "set system services ftp password [parameter1]",
            "command": "set system services ftp password \"@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%\"",
            "explanation": "配置FTP服务的登录密码。",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "FTP服务的登录密码。"
                }
            ]
        },
        "set system processes ftp": {
            "template": "set system processes ftp",
            "command": "set system processes ftp",
            "explanation": "启用系统FTP进程。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 1.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}