{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name-up-e2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols [parameter1]": {
            "template": "set protocols [parameter1]",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议名称，例如ldp。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vbv1 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.4.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls label-switched-path [parameter3] to [parameter4] encap mpls pw-class [parameter5]": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls label-switched-path [parameter3] to [parameter4] encap mpls pw-class [parameter5]",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls label-switched-path up-lsp to 3.3.3.9 encap mpls pw-class pw-aucfg",
            "explanation": "配置MPLS标签交换路径。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址。"
                },
                {
                    "name": "pw-class",
                    "type": "string",
                    "explanation": "伪线类别名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls encapsulation mpls label switched-pw-class [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls encapsulation mpls label switched-pw-class [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls encapsulation mpls label switched-pw-class aas-name pw-a",
            "explanation": "配置MPLS封装和伪线类别。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "switched-pw-class",
                    "type": "string",
                    "explanation": "伪线类别名称。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set routing-options ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set routing-options ospf 1 area 0 interface ge-0/0/0.0",
            "explanation": "配置OSPF协议的接口。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set routing-options ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-options ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-options ospf 1 area 0 network 10.4.1.0/24",
            "explanation": "配置OSPF协议的网络。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    }
}