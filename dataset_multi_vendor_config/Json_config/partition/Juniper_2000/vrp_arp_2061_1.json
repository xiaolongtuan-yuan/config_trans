{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set arp": {
        "template": "set arp",
        "set arp static [parameter1] [parameter2]": {
            "template": "set arp static [parameter1] [parameter2]",
            "command": "set arp static 10.1.2.1 00:00:5e:41:03:00",
            "explanation": "配置静态ARP表项，将IP地址映射到MAC地址。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "静态ARP表项中的IP地址。"
                },
                {
                    "name": "mac-address",
                    "type": "string",
                    "explanation": "静态ARP表项中的MAC地址。"
                }
            ]
        }
    }
