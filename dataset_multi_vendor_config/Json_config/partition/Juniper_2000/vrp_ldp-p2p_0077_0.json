{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-switched-path protocol [parameter1]": {
            "template": "set protocols mpls label-switched-path protocol [parameter1]",
            "command": "set protocols mpls label-switched-path protocol ldp",
            "explanation": "配置MPLS标签交换路径的协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型，例如LDP。"
                }
            ]
        },
        "set protocols mpls bfd": {
            "template": "set protocols mpls bfd",
            "command": "set protocols mpls bfd",
            "explanation": "在MPLS协议中启用BFD（双向转发检测）。",
            "parameters": []
        },
        "set protocols mpls bfd-trigger-tunnel fec-list [parameter1]": {
            "template": "set protocols mpls bfd-trigger-tunnel fec-list [parameter1]",
            "command": "set protocols mpls bfd-trigger-tunnel fec-list list1",
            "explanation": "配置BFD触发隧道的FEC列表。",
            "parameters": [
                {
                    "name": "fec-list",
                    "type": "string",
                    "explanation": "FEC列表名称。"
                }
            ]
        },
        "set protocols mpls fec-list [parameter1] fec-node [parameter2]": {
            "template": "set protocols mpls fec-list [parameter1] fec-node [parameter2]",
            "command": "set protocols mpls fec-list list1 fec-node 4.4.4.9",
            "explanation": "配置FEC列表中的FEC节点。",
            "parameters": [
                {
                    "name": "fec-list",
                    "type": "string",
                    "explanation": "FEC列表名称。"
                },
                {
                    "name": "fec-node",
                    "type": "string",
                    "explanation": "FEC节点的IP地址。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols mpls ldp interface [parameter1]": {
            "template": "set protocols mpls ldp interface [parameter1]",
            "command": "set protocols mpls ldp interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-1/0/0",
            "explanation": "在指定接口上启用ISIS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 2 wide-metrics-only",
            "explanation": "配置ISIS协议的级别2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0001.00",
            "explanation": "配置ISIS协议的网络实体。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体的标识符。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}