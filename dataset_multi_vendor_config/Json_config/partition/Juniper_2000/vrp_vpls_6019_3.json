{
    "set system": {
        "template": "set system",
        "set system name [parameter1]": {
            "template": "set system name [parameter1]",
            "command": "set system name hostname",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 127.0.0.1/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options rib-group [parameter1]": {
            "template": "set routing-options rib-group [parameter1]",
            "command": "set routing-options rib-group default",
            "explanation": "配置RIB（路由信息库）组。",
            "parameters": [
                {
                    "name": "rib-group",
                    "type": "string",
                    "explanation": "RIB组的名称。"
                }
            ]
        },
        "set routing-options routing-instances [parameter1] routes options inherit-attributes from instance-type [parameter2]": {
            "template": "set routing-options routing-instances [parameter1] routes options inherit-attributes from instance-type [parameter2]",
            "command": "set routing-options routing-instances my-instance routes options inherit-attributes from instance-type vrf",
            "explanation": "配置路由实例的路由选项，使其继承特定实例类型的属性。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "实例类型，例如vrf。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set protocols static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set protocols static route 0.0.0.0/0 next-hop 192.168.1.1",
            "explanation": "配置静态路由，指定下一跳地址。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目的网络的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳的IP地址。"
                }
            ]
        }
    }
}