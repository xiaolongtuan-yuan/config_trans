{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast": {
            "template": "set routing-options multicast",
            "command": "set routing-options multicast",
            "explanation": "启用多播路由选项。",
            "parameters": []
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall family inet filter [parameter1] term [parameter2] from source-address [parameter3]/[parameter4]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] from source-address [parameter3]/[parameter4]",
            "command": "set firewall family inet filter multicast-filter term 1 from source-address 232.1.1.0/24",
            "explanation": "配置防火墙过滤器的源地址条件。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "防火墙过滤器的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "过滤条件的序号。"
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "源IP地址范围。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "源IP地址的子网掩码位数。"
                }
            ]
        },
        "set firewall family inet filter [parameter1] term [parameter2] then accept": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] then accept",
            "command": "set firewall family inet filter multicast-filter term 1 then accept",
            "explanation": "配置防火墙过滤器接受匹配的流量。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "防火墙过滤器的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "过滤条件的序号。"
                }
            ]
        },
        "set firewall family inet filter [parameter1] term [parameter2] then reject": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] then reject",
            "command": "set firewall family inet filter multicast-filter term 2 then reject",
            "explanation": "配置防火墙过滤器拒绝匹配的流量。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "防火墙过滤器的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "过滤条件的序号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] net [parameter2]": {
            "template": "set protocols isis level [parameter1] net [parameter2]",
            "command": "set protocols isis level 1 net 10.0000.0000.0001.00",
            "explanation": "配置IS-IS协议的级别和网络实体标题。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题，用于标识IS-IS网络。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-1/0/0",
            "explanation": "在指定接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] version [parameter2]": {
            "template": "set protocols igmp interface [parameter1] version [parameter2]",
            "command": "set protocols igmp interface ge-2/0/0 version 3",
            "explanation": "在指定接口上配置IGMP协议的版本。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "IGMP协议的版本号。"
                }
            ]
        },
        "set protocols pim ssm-policy [parameter1]": {
            "template": "set protocols pim ssm-policy [parameter1]",
            "command": "set protocols pim ssm-policy 2001",
            "explanation": "配置PIM协议的SSM策略。",
            "parameters": [
                {
                    "name": "policy-number",
                    "type": "integer",
                    "explanation": "SSM策略的编号。"
                }
            ]
        },
        "set protocols pim static-rp [parameter1]": {
            "template": "set protocols pim static-rp [parameter1]",
            "command": "set protocols pim static-rp 192.168.4.1",
            "explanation": "配置PIM协议的静态RP地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "静态RP的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.9.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pim-sm": {
            "template": "set interfaces [parameter1] unit [parameter2] pim-sm",
            "command": "set interfaces ge-1/0/0 unit 0 pim-sm",
            "explanation": "在指定接口上启用PIM-SM协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        }
    }
}