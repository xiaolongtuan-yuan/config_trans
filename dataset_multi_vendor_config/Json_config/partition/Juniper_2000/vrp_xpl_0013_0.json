{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gigabit-ether3/0/0 unit 0 family inet address 1.1.5.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ether3/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp [parameter1] peer-group [parameter2]": {
            "template": "set protocols bgp [parameter1] peer-group [parameter2]",
            "command": "set protocols bgp 100 peer-group PEER1",
            "explanation": "配置BGP协议的peer-group。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP的peer-group名称。"
                }
            ]
        },
        "set protocols bgp [parameter1] peer-group [parameter2] peer-address [parameter3] neighbor-settings remote-as [parameter4]": {
            "template": "set protocols bgp [parameter1] peer-group [parameter2] peer-address [parameter3] neighbor-settings remote-as [parameter4]",
            "command": "set protocols bgp 100 peer-group PEER1 peer-address 1.1.5.1 neighbor-settings remote-as 100",
            "explanation": "配置BGP peer-group的peer地址及远程AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP的peer-group名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP peer的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "远程BGP peer的AS号。"
                }
            ]
        },
        "set protocols bgp [parameter1] import [parameter2]": {
            "template": "set protocols bgp [parameter1] import [parameter2]",
            "command": "set protocols bgp 100 import static",
            "explanation": "配置BGP协议导入静态路由。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "import-policy",
                    "type": "string",
                    "explanation": "导入策略名称。"
                }
            ]
        },
        "set protocols bgp [parameter1] group [parameter2] type [parameter3]": {
            "template": "set protocols bgp [parameter1] group [parameter2] type [parameter3]",
            "command": "set protocols bgp 100 group PEER1 type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型。"
                }
            ]
        },
        "set protocols bgp [parameter1] group [parameter2] import [parameter3]": {
            "template": "set protocols bgp [parameter1] group [parameter2] import [parameter3]",
            "command": "set protocols bgp 100 group PEER1 import all",
            "explanation": "配置BGP组导入所有路由。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "import-policy",
                    "type": "string",
                    "explanation": "导入策略名称。"
                }
            ]
        },
        "set protocols bgp [parameter1] group [parameter2] routes distribute-list [parameter3] export": {
            "template": "set protocols bgp [parameter1] group [parameter2] routes distribute-list [parameter3] export",
            "command": "set protocols bgp 100 group PEER1 routes distribute-list ALLOW-PEER1 export",
            "explanation": "配置BGP组使用分发列表控制导出路由。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "distribute-list",
                    "type": "string",
                    "explanation": "分发列表名称。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] routes static route [parameter2]/[parameter3] next-hop [parameter4]": {
            "template": "set routing-instances [parameter1] routes static route [parameter2]/[parameter3] next-hop [parameter4]",
            "command": "set routing-instances default-instance routes static route 2.2.2.0/24 next-hop null0",
            "explanation": "配置默认路由实例的静态路由。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "静态路由的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall family [parameter1] filter [parameter2] term [parameter3] [parameter4] from prefix-list [parameter5]": {
            "template": "set firewall family [parameter1] filter [parameter2] term [parameter3] [parameter4] from prefix-list [parameter5]",
            "command": "set firewall family ipv4 filter ALLOW-PEER1 term t permit from prefix-list PREFIX1",
            "explanation": "配置IPv4防火墙过滤器的允许条件。",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如ipv4。"
                },
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "过滤条件的名称。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "匹配条件后的动作，例如permit。"
                },
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表名称。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 2.2.2.0/255.255.255.0 next-hop null0",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "静态路由的子网掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}