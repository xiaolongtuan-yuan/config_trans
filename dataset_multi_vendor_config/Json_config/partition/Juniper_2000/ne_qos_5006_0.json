{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis fpc [parameter1] pic [parameter2] t1-channel speed [parameter3]": {
            "template": "set chassis fpc [parameter1] pic [parameter2] t1-channel speed [parameter3]",
            "command": "set chassis fpc 2 pic 0 t1-channel speed 64k",
            "explanation": "配置控制器的T1通道速度。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "FPC（Flexible PIC Concentrator）编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC（Physical Interface Card）编号。"
                },
                {
                    "name": "speed",
                    "type": "string",
                    "explanation": "T1通道的速度，例如64k。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces t1-2/0/0 unit 0 encapsulation ppp",
            "explanation": "配置接口的封装类型为PPP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如t1-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "接口的封装类型，例如PPP。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] t1-options timeslots [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] t1-options timeslots [parameter3]",
            "command": "set interfaces t1-2/0/0 unit 0 t1-options timeslots 1-31",
            "explanation": "配置T1接口的时隙。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如t1-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "T1接口的时隙范围，例如1-31。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces t1-2/0/0 unit 0 family inet address 3.3.3.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如t1-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces t1-2/0/0 unit 0 disable",
            "explanation": "默认关闭接口，需要后续手动启用。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如t1-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set class-of-service": {
        "template": "set class-of-service",
        "set class-of-service schedulers [parameter1] transmit-rate percent [parameter2] buffer-size percent [parameter3]": {
            "template": "set class-of-service schedulers [parameter1] transmit-rate percent [parameter2] buffer-size percent [parameter3]",
            "command": "set class-of-service schedulers scheduler-1 transmit-rate percent 0 buffer-size percent 6",
            "explanation": "配置调度器的传输速率和缓冲区大小。",
            "parameters": [
                {
                    "name": "scheduler",
                    "type": "string",
                    "explanation": "调度器名称，例如scheduler-1。"
                },
                {
                    "name": "transmit-rate",
                    "type": "integer",
                    "explanation": "传输速率的百分比。"
                },
                {
                    "name": "buffer-size",
                    "type": "integer",
                    "explanation": "缓冲区大小的百分比。"
                }
            ]
        },
        "set class-of-service forwarding-classes [parameter1]": {
            "template": "set class-of-service forwarding-classes [parameter1]",
            "command": "set class-of-service forwarding-classes queue-1",
            "explanation": "配置转发类。",
            "parameters": [
                {
                    "name": "queue",
                    "type": "string",
                    "explanation": "队列名称，例如queue-1。"
                }
            ]
        },
        "set class-of-service interfaces [parameter1] unit [parameter2] output-scheduler-map forwarding-class [parameter3] scheduler [parameter4]": {
            "template": "set class-of-service interfaces [parameter1] unit [parameter2] output-scheduler-map forwarding-class [parameter3] scheduler [parameter4]",
            "command": "set class-of-service interfaces t1-2/0/0 unit 0 output-scheduler-map forwarding-class queue-1 scheduler scheduler-1",
            "explanation": "配置接口的输出调度器映射。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如t1-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "forwarding-class",
                    "type": "string",
                    "explanation": "转发类名称，例如queue-1。"
                },
                {
                    "name": "scheduler",
                    "type": "string",
                    "explanation": "调度器名称，例如scheduler-1。"
                }
            ]
        }
    }
}