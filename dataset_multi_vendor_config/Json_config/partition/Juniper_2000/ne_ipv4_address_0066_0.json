{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name HUAWEI",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2]": {
            "template": "set system login user [parameter1] class [parameter2]",
            "command": "set system login user noauth class super-user",
            "explanation": "配置系统登录用户的类别。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "user-class",
                    "type": "string",
                    "explanation": "用户类别，例如super-user。"
                }
            ]
        },
        "set system login user [parameter1] authentication plain-text-password [parameter2]": {
            "template": "set system login user [parameter1] authentication plain-text-password [parameter2]",
            "command": "set system login user noauth authentication plain-text-password \"\"",
            "explanation": "配置系统登录用户的认证方式为明文密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "明文密码。"
                }
            ]
        },
        "set system services dhcp-local-server group [parameter1] interface [parameter2]": {
            "template": "set system services dhcp-local-server group [parameter1] interface [parameter2]",
            "command": "set system services dhcp-local-server group DHCP-Pool1 interface irb.1",
            "explanation": "配置DHCP本地服务器组的接口。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "DHCP本地服务器组的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]": {
            "template": "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]",
            "command": "set access address-assignment pool pool1 family inet network 10.10.10.0/24",
            "explanation": "配置地址分配池的网络地址及子网掩码。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet range [parameter2] low [parameter3]": {
            "template": "set access address-assignment pool [parameter1] family inet range [parameter2] low [parameter3]",
            "command": "set access address-assignment pool pool1 family inet range pool1-range low 10.10.10.3",
            "explanation": "配置地址分配池的地址范围下限。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "range-name",
                    "type": "string",
                    "explanation": "地址范围的名称。"
                },
                {
                    "name": "low-address",
                    "type": "string",
                    "explanation": "地址范围的下限地址。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet range [parameter2] high [parameter3]": {
            "template": "set access address-assignment pool [parameter1] family inet range [parameter2] high [parameter3]",
            "command": "set access address-assignment pool pool1 family inet range pool1-range high 10.10.10.100",
            "explanation": "配置地址分配池的地址范围上限。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "range-name",
                    "type": "string",
                    "explanation": "地址范围的名称。"
                },
                {
                    "name": "high-address",
                    "type": "string",
                    "explanation": "地址范围的上限地址。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet dhcp-attributes router [parameter2]": {
            "template": "set access address-assignment pool [parameter1] family inet dhcp-attributes router [parameter2]",
            "command": "set access address-assignment pool pool1 family inet dhcp-attributes router 10.10.10.2",
            "explanation": "配置DHCP属性的路由器地址。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "router-address",
                    "type": "string",
                    "explanation": "路由器的IP地址。"
                }
            ]
        },
        "set access address-assignment pool [parameter1] family inet dhcp-attributes name-server [parameter2]": {
            "template": "set access address-assignment pool [parameter1] family inet dhcp-attributes name-server [parameter2]",
            "command": "set access address-assignment pool pool1 family inet dhcp-attributes name-server 10.20.20.1",
            "explanation": "配置DHCP属性的名称服务器地址。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                },
                {
                    "name": "name-server-address",
                    "type": "string",
                    "explanation": "名称服务器的IP地址。"
                }
            ]
        },
        "set access profile [parameter1] authentication-order [parameter2]": {
            "template": "set access profile [parameter1] authentication-order [parameter2]",
            "command": "set access profile isp1 authentication-order none",
            "explanation": "配置访问配置文件的认证顺序。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如none。"
                }
            ]
        },
        "set access profile [parameter1] client user [parameter2]": {
            "template": "set access profile [parameter1] client user [parameter2]",
            "command": "set access profile isp1 client user noauth",
            "explanation": "配置访问配置文件的客户端用户。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                }
            ]
        },
        "set access profile [parameter1] address-assignment pool [parameter2]": {
            "template": "set access profile [parameter1] address-assignment pool [parameter2]",
            "command": "set access profile isp1 address-assignment pool pool1",
            "explanation": "配置访问配置文件的地址分配池。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "地址分配池的名称。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan1 vlan-id 1",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID。"
                }
            ]
        },
        "set vlans [parameter1] l3-interface [parameter2]": {
            "template": "set vlans [parameter1] l3-interface [parameter2]",
            "command": "set vlans vlan1 l3-interface irb.1",
            "explanation": "配置VLAN的L3接口。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "l3-interface",
                    "type": "string",
                    "explanation": "L3接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching port-mode access",
            "explanation": "配置接口的以太网交换端口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching vlan members vlan1",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces irb unit 1 family inet address 10.10.10.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}