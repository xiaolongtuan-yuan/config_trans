{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname routerB",
        "explanation": "设置设备的主机名为 'routerB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "access-list [parameter1] permit ip host [parameter2] any": {
        "template": "access-list [parameter1] permit ip host [parameter2] any",
        "command": "access-list 2001 permit ip host 2.2.2.2 any",
        "explanation": "配置访问控制列表 2001，允许来自主机 2.2.2.2 的任何 IP 流量",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source host",
                "type": "IPv4",
                "explanation": "源主机 IP 地址"
            }
        ]
    },
    "class-map match-all [parameter1]": {
        "template": "class-map match-all [parameter1]",
        "command": "class-map match-all a",
        "explanation": "创建一个名为 'a' 的类映射，匹配所有条件",
        "parameters": [
            {
                "name": "class-map name",
                "type": "string",
                "explanation": "类映射名称"
            }
        ],
        "match access-group [parameter1]": {
            "template": "match access-group [parameter1]",
            "command": "match access-group 2001",
            "explanation": "匹配访问控制列表 2001",
            "parameters": [
                {
                    "name": "access-list number",
                    "type": "integer",
                    "explanation": "访问控制列表编号"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map e",
        "explanation": "创建一个名为 'e' 的策略映射",
        "parameters": [
            {
                "name": "policy-map name",
                "type": "string",
                "explanation": "策略映射名称"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class class-default",
            "explanation": "配置默认类",
            "parameters": [
                {
                    "name": "class name",
                    "type": "string",
                    "explanation": "类名称"
                }
            ],
            "port-mirror enable": {
                "template": "port-mirror enable",
                "command": "port-mirror enable",
                "explanation": "启用端口镜像",
                "parameters": []
            },
            "service-policy [parameter1]": {
                "template": "service-policy [parameter1]",
                "command": "service-policy e",
                "explanation": "应用策略映射 'e'",
                "parameters": [
                    {
                        "name": "policy-map name",
                        "type": "string",
                        "explanation": "策略映射名称"
                    }
                ]
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 7.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 7.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "service-policy input [parameter1]": {
            "template": "service-policy input [parameter1]",
            "command": "service-policy input 1",
            "explanation": "在输入方向上应用策略映射 '1'",
            "parameters": [
                {
                    "name": "policy-map name",
                    "type": "string",
                    "explanation": "策略映射名称"
                }
            ]
        },
        "port monitor index [parameter1]": {
            "template": "port monitor index [parameter1]",
            "command": "port monitor index 3",
            "explanation": "配置端口镜像索引为 3",
            "parameters": [
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "端口镜像索引"
                }
            ]
        }
    },
    "monitor capture mirror capture-point [parameter1]": {
        "template": "monitor capture mirror capture-point [parameter1]",
        "command": "monitor capture mirror capture-point 3",
        "explanation": "配置镜像捕获点 3",
        "parameters": [
            {
                "name": "capture-point",
                "type": "integer",
