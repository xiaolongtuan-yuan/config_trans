            "parameters": [
                {
                    "name": "dscp value",
                    "type": "string",
                    "explanation": "DSCP 值"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map MPLS-EXP-OUTBOUND",
        "explanation": "定义一个策略映射，名称为 MPLS-EXP-OUTBOUND",
        "parameters": [
            {
                "name": "policy-map name",
                "type": "string",
                "explanation": "策略映射的名称"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class AF4",
            "explanation": "指定类 AF4",
            "parameters": [
                {
                    "name": "class name",
                    "type": "string",
                    "explanation": "类的名称"
                }
            ],
            "set mpls experimental topmost [parameter1]": {
                "template": "set mpls experimental topmost [parameter1]",
                "command": "set mpls experimental topmost 5",
                "explanation": "设置 MPLS 实验性位的最高位为 5",
                "parameters": [
                    {
                        "name": "mpls experimental value",
                        "type": "integer",
                        "explanation": "MPLS 实验性位的值"
                    }
                ]
            },
            "set ip dscp [parameter1]": {
                "template": "set ip dscp [parameter1]",
                "command": "set ip dscp 18",
                "explanation": "设置 IP DSCP 值为 18",
                "parameters": [
                    {
                        "name": "dscp value",
                        "type": "integer",
                        "explanation": "DSCP 值"
                    }
                ]
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 2.2.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "service-policy input [parameter1]": {
            "template": "service-policy input [parameter1]",
            "command": "service-policy input DSCP-INBOUND",
            "explanation": "应用输入方向的服务策略 DSCP-INBOUND",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "服务策略的名称"
                }
