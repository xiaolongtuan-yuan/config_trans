{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname AP2",
        "explanation": "设置设备的主机名为 'AP2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用双向转发检测（BFD）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.0.4 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.4.0.4，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 65534",
            "explanation": "在接口上启用 IS-IS 进程 65534",
            "parameters": [
                {
                    "name": "IS-IS process ID",
                    "type": "integer",
                    "explanation": "IS-IS 进程 ID"
                }
            ]
        }
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 65534",
        "explanation": "配置 IS-IS 进程 65534",
        "parameters": [
            {
                "name": "IS-IS process ID",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0004.00",
            "explanation": "配置 IS-IS 网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "配置 IS-IS 类型为 Level-1",
            "parameters": [
                {
                    "name": "IS-IS type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "配置 IS-IS 使用宽度量风格",
            "parameters": [
                {
                    "name": "metric style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
            "explanation": "配置 IPv4 单播地址族",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "redistribute [parameter1]": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "重分发直连路由到 IS-IS",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "源协议"
                    }
                ]
            },
            "redistribute [parameter1] [parameter2]": {
                "template": "redistribute [parameter1] [parameter2]",
                "command": "redistribute ospf 1",
                "explanation": "重分发 OSPF 进程 1 的路由到 IS-IS",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "源协议"
                    },
                    {
                        "name": "process ID",
                        "type": "integer",
                        "explanation": "进程 ID"
                    }
                ]
            }
        }
    }
}