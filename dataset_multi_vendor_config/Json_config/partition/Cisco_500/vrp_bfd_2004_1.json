{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 1",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 1",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        }
    },
    "ip bfd pissub bind peer-ip [parameter1] interface [parameter2]": {
        "template": "ip bfd pissub bind peer-ip [parameter1] interface [parameter2]",
        "command": "ip bfd pissub bind peer-ip default-ip interface GigabitEthernet1/0/0",
        "explanation": "配置 BFD 会话，绑定到接口 'GigabitEthernet1/0/0'，使用默认 IP 作为对端 IP",
        "parameters": [
            {
                "name": "peer-ip",
                "type": "string",
                "explanation": "对端 IP 地址"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "bfd discriminator local [parameter1]": {
            "template": "bfd discriminator local [parameter1]",
            "command": "bfd discriminator local 2",
            "explanation": "配置 BFD 会话的本地标识符为 2",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地标识符"
                }
            ]
        },
        "bfd discriminator remote [parameter1]": {
            "template": "bfd discriminator remote [parameter1]",
            "command": "bfd discriminator remote 1",
            "explanation": "配置 BFD 会话的远端标识符为 1",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端标识符"
                }
            ]
        },
        "bfd process-interface-status [parameter1]": {
            "template": "bfd process-interface-status [parameter1]",
            "command": "bfd process-interface-status sub-if",
            "explanation": "配置 BFD 处理子接口状态",
            "parameters": [
                {
                    "name": "sub-interface status",
                    "type": "string",
                    "explanation": "子接口状态"
                }
            ]
        }
    }
}