        "parameters": [
            {
                "name": "key chain name",
                "type": "string",
                "explanation": "密钥链名称"
            }
        ],
        "key [parameter1]": {
            "template": "key [parameter1]",
            "command": "key 1",
            "explanation": "配置密钥链中的密钥 '1'",
            "parameters": [
                {
                    "name": "key identifier",
                    "type": "integer",
                    "explanation": "密钥标识符"
                }
            ],
            "key-string [parameter1] [parameter2]": {
                "template": "key-string [parameter1] [parameter2]",
                "command": "key-string 7 150D0F00001F480B5F5058171A1A1A",
                "explanation": "配置密钥字符串，使用加密类型 7",
                "parameters": [
                    {
                        "name": "encryption type",
                        "type": "integer",
                        "explanation": "加密类型"
                    },
                    {
                        "name": "key string",
                        "type": "string",
                        "explanation": "密钥字符串"
                    }
                ]
            },
            "key-string encryption-type [parameter1]": {
                "template": "key-string encryption-type [parameter1]",
                "command": "key-string encryption-type 7",
