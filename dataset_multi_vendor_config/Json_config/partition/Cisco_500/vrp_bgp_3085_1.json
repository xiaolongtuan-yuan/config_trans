            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.20.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.20.1.1，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "neighbor [parameter1] password [parameter2] [parameter3]": {
            "template": "neighbor [parameter1] password [parameter2] [parameter3]",
            "command": "neighbor 10.20.1.1 password 7 150D0F00001F480B5F5058171A1A1A",
            "explanation": "配置 BGP 邻居的密码，使用加密类型 7",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "encryption type",
                    "type": "integer",
                    "explanation": "加密类型"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "密码"
                }
            ]
        },
        "neighbor [parameter1] timers [parameter2] [parameter3]": {
            "template": "neighbor [parameter1] timers [parameter2] [parameter3]",
            "command": "neighbor 10.20.1.1 timers 11 12",
            "explanation": "配置 BGP 邻居的定时器，保持时间为 11 秒，保持间隔为 12 秒",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "keepalive interval",
                    "type": "integer",
                    "explanation": "保持间隔"
                },
                {
                    "name": "hold time",
                    "type": "integer",
                    "explanation": "保持时间"
                }
            ]
        },
        "no synchronization": {
            "template": "no synchronization",
            "command": "no synchronization",
            "explanation": "禁用 BGP 同步",
            "parameters": []
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.20.1.1 activate",
                "explanation": "激活 BGP 邻居 10.20.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor IP address",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        }
