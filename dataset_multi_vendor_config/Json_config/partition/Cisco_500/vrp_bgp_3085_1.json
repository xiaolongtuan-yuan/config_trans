                "parameters": [
                    {
                        "name": "encryption type",
                        "type": "integer",
                        "explanation": "加密类型"
                    }
                ]
            },
            "lifetime [parameter1] [parameter2]": {
                "template": "lifetime [parameter1] [parameter2]",
                "command": "lifetime 00:00:00 00:30:00",
                "explanation": "配置密钥的有效时间从 00:00:00 到 00:30:00",
                "parameters": [
                    {
                        "name": "start time",
                        "type": "time",
                        "explanation": "开始时间"
                    },
                    {
                        "name": "end time",
                        "type": "time",
                        "explanation": "结束时间"
                    }
                ]
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.20.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 2.2.2.2",
            "explanation": "配置 BGP 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
