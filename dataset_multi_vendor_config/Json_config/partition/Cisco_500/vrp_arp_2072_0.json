{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE",
        "explanation": "设置设备的主机名为 'PE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "配置桥接域10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域标识号"
            }
        ],
        "split-horizon": {
            "template": "split-horizon",
            "command": "split-horizon",
            "explanation": "启用分裂地平线以防止环路",
            "parameters": []
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif10",
        "explanation": "配置接口Vbdif10",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.10.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.110.10.3，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "arp proxy local": {
            "template": "arp proxy local",
            "command": "arp proxy local",
            "explanation": "启用本地ARP代理",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置封装类型为dot1q，VLAN ID为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识号"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将接口加入桥接域10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域标识号"
                }
            ]
        }
    }
