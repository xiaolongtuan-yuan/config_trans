{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip vpn-instance [parameter1]": {
        "template": "ip vpn-instance [parameter1]",
        "command": "ip vpn-instance vpn1",
        "explanation": "创建或进入名为 'vpn1' 的 VPN 实例配置模式",
        "parameters": [
            {
                "name": "vpn instance name",
                "type": "string",
                "explanation": "VPN 实例名"
            }
        ],
        "route-distinguisher [parameter1]": {
            "template": "route-distinguisher [parameter1]",
            "command": "route-distinguisher 100:3",
            "explanation": "设置 VPN 实例的路由区分符为 100:3",
            "parameters": [
                {
                    "name": "route distinguisher",
                    "type": "string",
                    "explanation": "路由区分符"
                }
            ]
        },
        "route-target export [parameter1]": {
            "template": "route-target export [parameter1]",
            "command": "route-target export 100:1",
            "explanation": "设置 VPN 实例的导出路由目标为 100:1",
            "parameters": [
                {
                    "name": "route target",
                    "type": "string",
                    "explanation": "路由目标"
                }
            ]
        },
        "route-target import [parameter1]": {
            "template": "route-target import [parameter1]",
            "command": "route-target import 100:1",
            "explanation": "设置 VPN 实例的导入路由目标为 100:1",
            "parameters": [
                {
                    "name": "route target",
                    "type": "string",
                    "explanation": "路由目标"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/1/0",
        "explanation": "配置接口 'GigabitEthernet0/1/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "进入 BGP 配置模式，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.1 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.1，远程 AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.1 activate",
                "explanation": "激活邻居 10.1.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            }
        },
        "address-family ipv4 vrf [parameter1]": {
            "template": "address-family ipv4 vrf [parameter1]",
            "command": "address-family ipv4 vrf vpn1",
            "explanation": "进入 VPN 实例 'vpn1' 的 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "vrf name",
                    "type": "string",
                    "explanation": "VPN 实例名"
                }
            ],
            "neighbor [parameter1] remote-as [parameter2]": {
                "template": "neighbor [parameter1] remote-as [parameter2]",
                "command": "neighbor 10.1.2.3 remote-as 100",
                "explanation": "配置 BGP 邻居，IP 地址为 10.1.2.3，远程 AS 号为 100",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    },
                    {
                        "name": "remote AS number",
                        "type": "integer",
                        "explanation": "远程自治系统号"
                    }
                ]
            }
        }
    }
}