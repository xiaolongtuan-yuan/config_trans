{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ASBR",
        "explanation": "设置设备的主机名为 'ASBR'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 router ospf [parameter1]": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "配置 IPv6 OSPF 进程 1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPF 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "redistribute [parameter1]": {
            "template": "redistribute [parameter1]",
            "command": "redistribute static",
            "explanation": "重分发静态路由到 OSPF",
            "parameters": [
                {
                    "name": "redistribute protocol",
                    "type": "string",
                    "explanation": "重分发的协议"
                }
            ]
        },
        "area [parameter1] range [parameter2]": {
            "template": "area [parameter1] range [parameter2]",
            "command": "area 0 range 2001::/16",
            "explanation": "在 OSPF 区域 0 中汇总 2001::/16 的路由",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                },
                {
                    "name": "ipv6 prefix",
                    "type": "IPv6",
                    "explanation": "IPv6 前缀"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0",
            "explanation": "将接口加入到 OSPF 进程 1 的区域 0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route 2001:DB8:2::1/128 Null0",
        "explanation": "配置静态路由，将 2001:DB8:2::1/128 指向 Null0 接口",
        "parameters": [
            {
                "name": "ipv6 prefix",
                "type": "IPv6",
                "explanation": "IPv6 前缀"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}