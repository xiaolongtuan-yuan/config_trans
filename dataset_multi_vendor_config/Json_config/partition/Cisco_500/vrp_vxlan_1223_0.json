{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spine1",
        "explanation": "设置设备的主机名为 'Spine1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.10.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPF 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域 ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 3.3.3.3 0.0.0.0",
                "explanation": "在 OSPF 区域 0.0.0.0 中宣告网络 3.3.3.3/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}