{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1.1",
        "explanation": "配置接口 'GigabitEthernet3/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 200",
            "explanation": "配置接口的封装类型为 dot1q，并指定 VLAN ID 为 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version 2",
        "explanation": "设置 CFM 版本为 2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "CFM 版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用 CFM 功能",
        "parameters": []
    },
    "cfm mep domain [parameter1]": {
        "template": "cfm mep domain [parameter1]",
        "command": "cfm mep domain md3",
        "explanation": "配置 CFM MEP 域为 'md3'",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "MEP 域名"
            }
        ],
        "cfm mep domain [parameter1] service [parameter2]": {
            "template": "cfm mep domain [parameter1] service [parameter2]",
            "command": "cfm mep domain md3 service ma3",
            "explanation": "在域 'md3' 下配置服务 'ma3'",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "MEP 域名"
                },
                {
                    "name": "service name",
                    "type": "string",
                    "explanation": "服务名"
                }
            ],
            "cfm mep domain [parameter1] service [parameter2] mep [parameter3]": {
                "template": "cfm mep domain [parameter1] service [parameter2] mep [parameter3]",
                "command": "cfm mep domain md3 service ma3 mep 4",
                "explanation": "在服务 'ma3' 下配置 MEP ID 为 4",
                "parameters": [
                    {
                        "name": "domain name",
                        "type": "string",
                        "explanation": "MEP 域名"
                    },
                    {
                        "name": "service name",
                        "type": "string",
                        "explanation": "服务名"
                    },
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ],
                "cfm mep domain [parameter1] service [parameter2] mep [parameter3] interface [parameter4] vlan [parameter5]": {
                    "template": "cfm mep domain [parameter1] service [parameter2] mep [parameter3] interface [parameter4] vlan [parameter5]",
                    "command": "cfm mep domain md3 service ma3 mep 4 interface GigabitEthernet3/0/1.1 vlan 200",
                    "explanation": "将 MEP 4 绑定到接口 'GigabitEthernet3/0/1.1' 和 VLAN 200",
                    "parameters": [
                        {
                            "name": "domain name",
                            "type": "string",
                            "explanation": "MEP 域名"
                        },
                        {
                            "name": "service name",
                            "type": "string",
                            "explanation": "服务名"
                        },
                        {
                            "name": "MEP ID",
                            "type": "integer",
                            "explanation": "MEP ID"
                        },
                        {
                            "name": "interface name",
                            "type": "string",
                            "explanation": "接口名"
                        },
                        {
                            "name": "VLAN ID",
                            "type": "integer",
                            "explanation": "VLAN ID"
                        }
                    ]
                },
                "cfm mep domain [parameter1] service [parameter2] mep [parameter3] ccm-send": {
                    "template": "cfm mep domain [parameter1] service [parameter2] mep [parameter3] ccm-send",
                    "command": "cfm mep domain md3 service ma3 mep 4 ccm-send",
                    "explanation": "配置 MEP 4 发送 CCM 消息",
                    "parameters": [
                        {
                            "name": "domain name",
                            "type": "string",
                            "explanation": "MEP 域名"
                        },
                        {
                            "name": "service name",
                            "type": "string",
                            "explanation": "服务名"
                        },
                        {
                            "name": "MEP ID",
                            "type": "integer",
                            "explanation": "MEP ID"
                        }
                    ]
                }
            },
            "cfm mep domain [parameter1] service [parameter2] remote-mep [parameter3]": {
                "template": "cfm mep domain [parameter1] service [parameter2] remote-mep [parameter3]",
                "command": "cfm mep domain md3 service ma3 remote-mep 3",
                "explanation": "在服务 'ma3' 下配置远程 MEP ID 为 3",
                "parameters": [
                    {
                        "name": "domain name",
                        "type": "string",
                        "explanation": "MEP 域名"
                    },
                    {
                        "name": "service name",
                        "type": "string",
                        "explanation": "服务名"
                    },
                    {
                        "name": "remote MEP ID",
                        "type": "integer",
                        "explanation": "远程 MEP ID"
                    }
                ],
                "cfm mep domain [parameter1] service [parameter2] remote-mep [parameter3] ccm-receive": {
                    "template": "cfm mep domain [parameter1] service [parameter2] remote-mep [parameter3] ccm-receive",
                    "command": "cfm mep domain md3 service ma3 remote-mep 3 ccm-receive",
                    "explanation": "配置接收来自远程 MEP 3 的 CCM 消息",
                    "parameters": [
                        {
                            "name": "domain name",
                            "type": "string",
                            "explanation": "MEP 域名"
                        },
                        {
                            "name": "service name",
                            "type": "string",
                            "explanation": "服务名"
                        },
                        {
                            "name": "remote MEP ID",
                            "type": "integer",
                            "explanation": "远程 MEP ID"
                        }
                    ]
                }
            },
            "cfm mep domain [parameter1] service [parameter2] test [parameter3] mep [parameter4]": {
                "template": "cfm mep domain [parameter1] service [parameter2] test [parameter3] mep [parameter4]",
                "command": "cfm mep domain md3 service ma3 test 1 mep 4",
                "explanation": "在服务 'ma3' 下配置测试 1 使用 MEP 4",
                "parameters": [
                    {
                        "name": "domain name",
                        "type": "string",
                        "explanation": "MEP 域名"
                    },
                    {
                        "name": "service name",
                        "type": "string",
                        "explanation": "服务名"
                    },
                    {
                        "name": "test ID",
                        "type": "integer",
                        "explanation": "测试 ID"
                    },
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ],
                "cfm mep domain [parameter1] service [parameter2] test [parameter3] loss-measure [parameter4] [parameter5]": {
                    "template": "cfm mep domain [parameter1] service [parameter2] test [parameter3] loss-measure [parameter4] [parameter5]",
                    "command": "cfm mep domain md3 service ma3 test 1 loss-measure dual-ended continual",
                    "explanation": "配置测试 1 进行双端持续丢包测量",
                    "parameters": [
                        {
                            "name": "domain name",
                            "type": "string",
                            "explanation": "MEP 域名"
                        },
                        {
                            "name": "service name",
                            "type": "string",
                            "explanation": "服务名"
                        },
                        {
                            "name": "test ID",
                            "type": "integer",
                            "explanation": "测试 ID"
                        },
                        {
                            "name": "measure type",
                            "type": "string",
                            "explanation": "测量类型"
                        },
                        {
                            "name": "measure mode",
                            "type": "string",
                            "explanation": "测量模式"
                        }
                    ]
                }
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到特权模式",
        "parameters": []
    }
}