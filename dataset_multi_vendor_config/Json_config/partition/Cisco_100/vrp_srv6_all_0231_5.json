{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel20",
        "explanation": "配置接口 'Port-channel20'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 20",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.2.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 20 mode on",
            "explanation": "将接口加入到通道组 20，模式为 on",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}