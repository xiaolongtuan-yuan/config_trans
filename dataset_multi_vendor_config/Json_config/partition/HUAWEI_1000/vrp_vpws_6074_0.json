{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk10",
        "explanation": "进入Eth-Trunk10接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "mode [parameter1]": {
            "template": "mode [parameter1]",
            "command": "mode lacp-static",
            "explanation": "设置Eth-Trunk10的工作模式为LACP静态模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "工作模式"
                }
            ]
        },
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 100",
            "explanation": "配置子接口的VLAN类型为dot1q，VLAN ID为100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 10",
            "explanation": "将接口加入Eth-Trunk10",
            "parameters": [
                {
                    "name": "eth-trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        }
    }
}