{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口配置为交换模式",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "允许VLAN 10通过 trunk 端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识号"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md2 level 6",
        "explanation": "配置CFM域md2，层次级别为6",
        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "CFM域名称"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "层次级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma2",
            "explanation": "配置MA（Maintenance Association）名为ma2",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "MA名称"
                }
            ],
            "map mpls vlan [parameter1]": {
                "template": "map mpls vlan [parameter1]",
                "command": "map mpls vlan 10",
                "explanation": "将VLAN 10映射到MPLS",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN标识号"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 62 interface gigabitEthernet1/0/1 outward",
                "explanation": "配置MEP ID为62，接口为GigabitEthernet1/0/1，方向为outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    },
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（inward或outward）"
                    }
                ]
            },
            "ccm-interval [parameter1]": {
                "template": "ccm-interval [parameter1]",
                "command": "ccm-interval 10000",
                "explanation": "设置CCM（Continuity Check Message）间隔为10000毫秒",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "CCM间隔时间（毫秒）"
                    }
                ]
            },
            "mep ccm-send enable": {
                "template": "mep ccm-send enable",
                "command": "mep ccm-send enable",
                "explanation": "启用MEP发送CCM",
                "parameters": []
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 61",
                "explanation": "配置远程MEP ID为61",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "remote-mep ccm-receive enable": {
                "template": "remote-mep ccm-receive enable",
                "command": "remote-mep ccm-receive enable",
                "explanation": "启用接收远程MEP的CCM",
                "parameters": []
            },
            "ais enable": {
                "template": "ais enable",
                "command": "ais enable",
                "explanation": "启用AIS（Alarm Indication Signal）",
                "parameters": []
            },
            "ais suppress-alarm": {
                "template": "ais suppress-alarm",
                "command": "ais suppress-alarm",
                "explanation": "抑制AIS报警",
                "parameters": []
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一级配置模式",
        "parameters": []
    }
}