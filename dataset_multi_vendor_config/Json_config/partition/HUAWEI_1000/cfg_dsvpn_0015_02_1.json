{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke1",
        "explanation": "设置设备的主机名为 'Spoke1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "启用NHRP（Next Hop Resolution Protocol）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.2.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到GRE隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "nhrp entry [parameter1] [parameter2] register": {
            "template": "nhrp entry [parameter1] [parameter2] register",
            "command": "nhrp entry 172.16.1.1 10.1.1.10 register",
            "explanation": "在NHRP中注册下一跳地址为172.16.1.1，NBMA地址为10.1.1.10",
            "parameters": [
                {
                    "name": "next hop address",
                    "type": "IPv4",
                    "explanation": "下一跳地址"
                },
                {
                    "name": "NBMA address",
                    "type": "IPv4",
                    "explanation": "NBMA地址"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol gre",
            "explanation": "设置隧道协议为GRE",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "设置隧道的源接口为GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 10.1.1.10",
            "explanation": "设置隧道的目的地址为10.1.1.10",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        },
        "ipsec policy [parameter1]": {
            "template": "ipsec policy [parameter1]",
            "command": "ipsec policy <IPSEC_PROFILE_NAME>",
            "explanation": "应用IPSec策略到隧道接口",
            "parameters": [
                {
                    "name": "IPSec policy name",
                    "type": "string",
                    "explanation": "IPSec策略名称"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.2",
        "explanation": "配置OSPF进程1，并设置路由器ID为172.16.1.2",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            },
            {
                "name": "router ID",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0配置模式",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络172.16.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            },
            "silent-interface [parameter1]": {
                "template": "silent-interface [parameter1]",
                "command": "silent-interface all",
                "explanation": "设置所有接口为静默接口，不发送OSPF Hello报文",
                "parameters": [
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口"
                    }
                ]
            },
            "undo silent-interface [parameter1]": {
                "template": "undo silent-interface [parameter1]",
                "command": "undo silent-interface GigabitEthernet1/0/0",
                "explanation": "取消GigabitEthernet1/0/0接口的静默状态，允许发送OSPF Hello报文",
                "parameters": [
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}