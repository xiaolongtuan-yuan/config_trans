            "template": "peer [parameter1] bfd min-tx-interval [parameter2] min-rx-interval [parameter3] detect-multiplier [parameter4]",
            "command": "peer 10.20.1.1 bfd min-tx-interval 100 min-rx-interval 100 detect-multiplier 4",
            "explanation": "配置BFD参数，最小发送间隔100ms，最小接收间隔100ms，检测倍数4",
            "parameters": [
                {
                    "name": "peer IP",
                    "type": "IPv4",
                    "explanation": "对等体的IP地址"
                },
                {
                    "name": "min tx interval",
                    "type": "integer",
                    "explanation": "最小发送间隔"
                },
                {
                    "name": "min rx interval",
                    "type": "integer",
                    "explanation": "最小接收间隔"
                },
                {
                    "name": "detect multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        },
