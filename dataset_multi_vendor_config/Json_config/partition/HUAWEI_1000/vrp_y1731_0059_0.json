{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1.1",
        "explanation": "进入接口 GigabitEthernet3/0/1.1 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 200",
            "explanation": "配置接口的VLAN类型为dot1q，并指定VLAN ID为200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "配置CFM（Connectivity Fault Management）版本为标准版本",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "cfm md [parameter1]": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
        "explanation": "配置CFM的维护域（Maintenance Domain）为md3",
        "parameters": [
            {
                "name": "Maintenance Domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "配置CFM的维护关联（Maintenance Association）为ma3",
            "parameters": [
                {
                    "name": "Maintenance Association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep mep-id [parameter1] interface [parameter2] vlan [parameter3] [parameter4]": {
                "template": "mep mep-id [parameter1] interface [parameter2] vlan [parameter3] [parameter4]",
                "command": "mep mep-id 3 interface GigabitEthernet3/0/1.1 vlan 200 outward",
                "explanation": "配置MEP（Maintenance End Point）ID为3，关联接口GigabitEthernet3/0/1.1，VLAN ID为200，方向为outward",
                "parameters": [
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "VLAN ID",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 3 enable",
                "explanation": "启用MEP ID为3的CCM（Continuity Check Message）发送功能",
                "parameters": [
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 4",
                "explanation": "配置远程MEP ID为4",
                "parameters": [
                    {
                        "name": "Remote MEP ID",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 4 enable",
                "explanation": "启用接收远程MEP ID为4的CCM消息功能",
                "parameters": [
                    {
                        "name": "Remote MEP ID",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "test-id [parameter1] mep [parameter2] remote-mep [parameter3]": {
                "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "test-id 1 mep 3 remote-mep 4",
                "explanation": "配置测试ID为1，关联MEP ID为3和远程MEP ID为4",
                "parameters": [
                    {
                        "name": "Test ID",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "Remote MEP ID",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "loss-measure [parameter1] [parameter2] test-id [parameter3]": {
                "template": "loss-measure [parameter1] [parameter2] test-id [parameter3]",
                "command": "loss-measure dual-ended continual test-id 1",
                "explanation": "配置测试ID为1的双端持续丢包测量",
                "parameters": [
                    {
                        "name": "measurement type",
                        "type": "string",
                        "explanation": "测量类型"
                    },
                    {
                        "name": "measurement mode",
                        "type": "string",
                        "explanation": "测量模式"
                    },
                    {
                        "name": "Test ID",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            }
        }
    }
}