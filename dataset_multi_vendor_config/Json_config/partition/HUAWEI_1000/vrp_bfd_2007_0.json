{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "进入OSPFv3进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 1.1.1.1",
            "explanation": "设置OSPFv3进程1的路由器ID为1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPFv3进程1的区域0.0.0.0配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址为2001:db8:1::1，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "bfd ipv6session bind peer-ipv6 [parameter1]": {
        "template": "bfd ipv6session bind peer-ipv6 [parameter1]",
        "command": "bfd ipv6session bind peer-ipv6 2001:db8:2::2",
        "explanation": "配置BFD IPv6会话，绑定对端IPv6地址为2001:db8:2::2",
        "parameters": [
            {
                "name": "peer ipv6 address",
                "type": "IPv6",
                "explanation": "对端IPv6地址"
            }
        ]
    },
    "discriminator local [parameter1]": {
        "template": "discriminator local [parameter1]",
        "command": "discriminator local 1",
        "explanation": "设置本地BFD会话的标识符为1",
        "parameters": [
            {
                "name": "local discriminator",
                "type": "integer",
                "explanation": "本地标识符"
            }
        ]
    },
    "discriminator remote [parameter1]": {
        "template": "discriminator remote [parameter1]",
        "command": "discriminator remote 2",
        "explanation": "设置远端BFD会话的标识符为2",
        "parameters": [
            {
                "name": "remote discriminator",
                "type": "integer",
                "explanation": "远端标识符"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}