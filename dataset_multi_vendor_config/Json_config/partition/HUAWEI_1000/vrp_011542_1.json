{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入VLAN 2的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置CFM（Connectivity Fault Management）版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口模式切换为二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2通过该trunk端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1]": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
        "explanation": "创建或进入名为md3的CFM维护域",
        "parameters": [
            {
                "name": "maintenance domain name",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "创建或进入名为ma3的维护关联",
            "parameters": [
                {
                    "name": "maintenance association name",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "map vlan [parameter1]": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 2",
                "explanation": "将维护关联映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 4 interface GigabitEthernet1/0/1 outward",
                "explanation": "在接口GigabitEthernet1/0/1上创建向外方向的MEP（维护端点），ID为4",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（outward/inward）"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 4 enable",
                "explanation": "启用MEP ID为4的CCM（连续性检查消息）发送功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 3",
                "explanation": "配置远程MEP ID为3",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 3 enable",
                "explanation": "启用接收远程MEP ID为3的CCM消息",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "test-id [parameter1] mep [parameter2]": {
                "template": "test-id [parameter1] mep [parameter2]",
                "command": "test-id 1 mep 4",
                "explanation": "为MEP ID为4配置测试ID为1",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "delay-measure one-way receive test-id [parameter1]": {
                "template": "delay-measure one-way receive test-id [parameter1]",
                "command": "delay-measure one-way receive test-id 1",
                "explanation": "配置单向延迟测量接收测试ID为1",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            },
            "test-id [parameter1] mep [parameter2] remote-mep [parameter3]": {
                "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "test-id 2 mep 4 remote-mep 3",
                "explanation": "为MEP ID为4和远程MEP ID为3配置测试ID为2",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "delay-measure one-way continual send test-id [parameter1] interval [parameter2]": {
                "template": "delay-measure one-way continual send test-id [parameter1] interval [parameter2]",
                "command": "delay-measure one-way continual send test-id 2 interval 1000",
                "explanation": "配置单向持续发送延迟测量测试ID为2，间隔为1000毫秒",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "间隔时间（毫秒）"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}