            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "node",
                "type": "integer",
                "explanation": "节点号"
            }
        ],
        "if-match ip-prefix [parameter1]": {
            "template": "if-match ip-prefix [parameter1]",
            "command": "if-match ip-prefix prefix1",
