    "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5]": {
        "template": "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5]",
        "command": "ip ip-prefix prefix1 index 10 permit 10.1.1.4 32",
        "explanation": "创建一个名为prefix1的IP前缀列表，索引为10，允许10.1.1.4/32的IP地址",
        "parameters": [
            {
                "name": "prefix name",
                "type": "string",
                "explanation": "前缀列表名称"
