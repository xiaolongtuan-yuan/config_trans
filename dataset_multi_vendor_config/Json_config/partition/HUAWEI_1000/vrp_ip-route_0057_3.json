            {
                "name": "index",
                "type": "integer",
                "explanation": "索引号"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IP地址"
            },
            {
                "name": "mask",
                "type": "integer",
                "explanation": "掩码长度"
            }
        ]
    },
    "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5] less-equal [parameter6]": {
        "template": "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5] less-equal [parameter6]",
        "command": "ip ip-prefix prefix2 index 20 permit 0.0.0.0 0 less-equal 32",
        "explanation": "在名为prefix2的IP前缀列表中，索引为20，允许0.0.0.0/0到32的IP地址",
        "parameters": [
            {
                "name": "prefix name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "index",
                "type": "integer",
                "explanation": "索引号"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IP地址"
            },
            {
                "name": "mask",
                "type": "integer",
                "explanation": "掩码长度"
            },
            {
                "name": "less-equal",
                "type": "integer",
                "explanation": "最大掩码长度"
            }
        ]
    },
    "route-policy [parameter1] [parameter2] node [parameter3]": {
        "template": "route-policy [parameter1] [parameter2] node [parameter3]",
        "command": "route-policy policy1 permit node 10",
