{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "启用扩展SSM控制",
        "parameters": [
            {
                "name": "control state",
                "type": "string",
                "explanation": "控制状态，on表示启用，off表示禁用"
            }
        ]
    },
    "clock bits-type [parameter1] [parameter2]": {
        "template": "clock bits-type [parameter1] [parameter2]",
        "command": "clock bits-type bits0 2mbps",
        "explanation": "设置BITS类型为bits0，速率2mbps",
        "parameters": [
            {
                "name": "bits type",
                "type": "string",
                "explanation": "BITS类型"
            },
            {
                "name": "rate",
                "type": "string",
                "explanation": "时钟速率"
            }
        ]
    },
    "clock source [parameter1] clock-id [parameter2]": {
        "template": "clock source [parameter1] clock-id [parameter2]",
        "command": "clock source bits0 clock-id 1",
        "explanation": "设置时钟源为bits0，时钟ID为1",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "时钟源"
            },
            {
                "name": "clock-id",
                "type": "integer",
                "explanation": "时钟ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步",
            "parameters": []
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 2",
            "explanation": "设置时钟ID为2",
            "parameters": [
                {
                    "name": "clock-id",
                    "type": "integer",
                    "explanation": "时钟ID"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 3",
            "explanation": "设置时钟优先级为3",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟优先级"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级",
        "parameters": []
    }
}