{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "设置设备的主机名为 'Spoke2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "启用 NHRP（Next Hop Resolution Protocol）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入 GigabitEthernet1/0/0 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.3.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel-protocol gre p2mp": {
            "template": "tunnel-protocol gre p2mp",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "设置隧道协议为 GRE 点对多点",
            "parameters": []
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet2/0/0",
            "explanation": "指定隧道的源接口为 GigabitEthernet2/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile IPSEC_PROFILE_NAME",
            "explanation": "为隧道启用 IPsec 保护，并指定配置文件名",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "IPsec 配置文件名"
                }
            ]
        },
        "tunnel-protocol gre": {
            "template": "tunnel-protocol gre",
            "command": "tunnel-protocol gre",
            "explanation": "设置隧道协议为 GRE",
            "parameters": []
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 172.16.1.1",
            "explanation": "设置隧道的目的地址为 172.16.1.1",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 300",
        "explanation": "进入 BGP 进程配置，AS 号为 300",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.3",
            "explanation": "设置 BGP 路由器 ID 为 172.16.1.3",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.1 as-number 100",
            "explanation": "配置 BGP 对等体 172.16.1.1，AS 号为 100",
            "parameters": [
                {
                    "name": "peer IP",
                    "type": "IPv4",
                    "explanation": "对等体 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的 AS 号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入 IPv4 单播地址族配置",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "禁用 BGP 与 IGP 的同步",
                "parameters": []
            },
            "import-route ospf [parameter1]": {
                "template": "import-route ospf [parameter1]",
                "command": "import-route ospf 1",
                "explanation": "将 OSPF 进程 1 的路由引入 BGP",
                "parameters": [
                    {
                        "name": "OSPF process ID",
                        "type": "integer",
                        "explanation": "OSPF 进程 ID"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.1.1 enable",
                "explanation": "启用与对等体 172.16.1.1 的 BGP 连接",
                "parameters": [
                    {
                        "name": "peer IP",
                        "type": "IPv4",
                        "explanation": "对等体 IP 地址"
                    }
                ]
            }
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.3",
        "explanation": "配置 OSPF 进程 1 的路由器 ID 为 172.16.1.3",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            },
            {
                "name": "router ID",
                "type": "IPv4",
                "explanation": "路由器 ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入 OSPF 区域 0.0.0.0 的配置",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "区域 ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.2.0 0.0.0.255",
                "explanation": "将网络 192.168.2.0/24 归属于该 OSPF 区域",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "反掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回上级模式",
        "parameters": []
    }
}