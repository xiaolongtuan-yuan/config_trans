{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置指定接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.0.0.0",
            "explanation": "配置接口的IPv4地址为 2.2.2.2，子网掩码为 255.0.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2002:202:202:1::1/64",
            "explanation": "配置接口的IPv6地址为 2002:202:202:1::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol ipv6-ipv4 6to4",
            "explanation": "设置隧道协议为 IPv6 over IPv4 with 6to4",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "隧道协议类型"
                },
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 2.2.2.2",
            "explanation": "设置隧道的源IPv4地址为 2.2.2.2",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源IPv4地址"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static 2002:: 16 Tunnel 10",
        "explanation": "配置静态IPv6路由，目标地址 2002::/16，出接口 Tunnel 10",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv6",
                "explanation": "目标IPv6地址前缀"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "output interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    }
}