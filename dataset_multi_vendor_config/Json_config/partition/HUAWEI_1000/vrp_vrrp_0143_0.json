{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口 GigabitEthernet1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp vrid [parameter1] peer-ip [parameter2] source-ip [parameter3]": {
            "template": "vrrp vrid [parameter1] peer-ip [parameter2] source-ip [parameter3]",
            "command": "vrrp vrid 1 peer-ip 192.168.2.1 source-ip 192.168.1.1",
            "explanation": "配置VRRP虚拟路由器的对端IP地址为192.168.2.1，源IP地址为192.168.1.1",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "peer-ip",
                    "type": "IPv4",
                    "explanation": "对端IP地址"
                },
                {
                    "name": "source-ip",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                }
            ]
        },
        "vrrp vrid [parameter1] priority [parameter2]": {
            "template": "vrrp vrid [parameter1] priority [parameter2]",
            "command": "vrrp vrid 1 priority 120",
            "explanation": "设置VRRP虚拟路由器的优先级为120",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "vrrp vrid [parameter1] preempt-mode timer delay [parameter2]": {
            "template": "vrrp vrid [parameter1] preempt-mode timer delay [parameter2]",
            "command": "vrrp vrid 1 preempt-mode timer delay 20",
            "explanation": "配置VRRP虚拟路由器的抢占模式，并设置抢占延迟时间为20秒",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "delay",
                    "type": "integer",
                    "explanation": "抢占延迟时间"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}