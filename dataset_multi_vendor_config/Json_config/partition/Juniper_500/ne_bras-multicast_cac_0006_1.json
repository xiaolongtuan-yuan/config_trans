{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name BRAS",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置认证顺序为RADIUS。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        },
        "set system radius-server [parameter1] secret [parameter2]": {
            "template": "set system radius-server [parameter1] secret [parameter2]",
            "command": "set system radius-server 10.0.0.1 secret \"radius-secret\"",
            "explanation": "配置RADIUS服务器地址及共享密钥。",
            "parameters": [
                {
                    "name": "radius-server",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                }
            ]
        },
        "set system authentication-methods login [parameter1]": {
            "template": "set system authentication-methods login [parameter1]",
            "command": "set system authentication-methods login none",
            "explanation": "配置登录认证方法为无。",
            "parameters": [
                {
                    "name": "authentication-methods",
                    "type": "string",
                    "explanation": "认证方法，例如none。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast": {
            "template": "set routing-options multicast",
            "command": "set routing-options multicast",
            "explanation": "启用多播路由。",
            "parameters": []
        },
        "set routing-options static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options static route 10.0.0.0/16 next-hop 10.0.0.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        },
        "set routing-options multicast mroute [parameter1] to [parameter2]": {
            "template": "set routing-options multicast mroute [parameter1] to [parameter2]",
            "command": "set routing-options multicast mroute 10.0.0.0/16 to 10.0.0.1",
            "explanation": "配置多播路由。",
            "parameters": [
                {
                    "name": "mroute",
                    "type": "string",
                    "explanation": "多播路由的目标网络地址及掩码。"
                },
                {
                    "name": "to",
                    "type": "string",
                    "explanation": "多播路由的下一跳地址。"
                }
            ]
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall family inet filter [parameter1] term [parameter2] from source-address [parameter3]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] from source-address [parameter3]",
            "command": "set firewall family inet filter list1 term permit1 from source-address 225.1.1.1/32",
            "explanation": "配置防火墙过滤器的源地址条件。",
            "parameters": [
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "过滤条件名称。"
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "源地址。"
                }
            ]
        },
        "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]",
            "command": "set firewall family inet filter list1 term permit1 then accept",
            "explanation": "配置防火墙过滤器的动作。",
            "parameters": [
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "过滤条件名称。"
                },
                {
                    "name": "then",
                    "type": "string",
                    "explanation": "动作，例如accept。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 address 2001:DB8::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet multicast pim [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet multicast pim [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet multicast pim sparse-mode",
            "explanation": "配置接口的PIM稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "pim-mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse-mode。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet igmp version [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet igmp version [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet igmp version 3",
            "explanation": "配置接口的IGMP版本。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "igmp-version",
                    "type": "integer",
                    "explanation": "IGMP版本，例如3。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] routing-interface [parameter2]": {
            "template": "set vlans [parameter1] routing-interface [parameter2]",
            "command": "set vlans bas routing-interface vlan-bas",
            "explanation": "配置VLAN的路由接口。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "routing-interface",
                    "type": "string",
                    "explanation": "路由接口名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces vlan-bas unit 0 family inet address 10.0.0.1/24",
            "explanation": "配置VLAN接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如vlan-bas。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set vlans [parameter1] multicast-routing": {
            "template": "set vlans [parameter1] multicast-routing",
            "command": "set vlans bas multicast-routing",
            "explanation": "启用VLAN的多播路由。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                }
            ]
        },
        "set vlans [parameter1] access-type [parameter2]": {
            "template": "set vlans [parameter1] access-type [parameter2]",
            "command": "set vlans bas access-type layer2",
            "explanation": "配置VLAN的访问类型为二层。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "access-type",
                    "type": "string",
                    "explanation": "访问类型，例如layer2。"
                }
            ]
        },
        "set vlans [parameter1] igmp version [parameter2]": {
            "template": "set vlans [parameter1] igmp version [parameter2]",
            "command": "set vlans bas igmp version 3",
            "explanation": "配置VLAN的IGMP版本。",
            "parameters": [
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "igmp-version",
                    "type": "integer",
                    "explanation": "IGMP版本，例如3。"
                }
            ]
        }
    }
}