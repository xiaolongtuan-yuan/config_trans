{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.3.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-1/0/0 unit 0 disable",
            "explanation": "禁用指定接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 800",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group BGP_GROUP type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group BGP_GROUP neighbor 10.3.1.2 peer-as 100",
            "explanation": "配置BGP邻居及其自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group BGP_GROUP family inet unicast",
            "explanation": "配置BGP组支持IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，例如inet。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "地址族类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family inet [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family inet [parameter3]",
            "command": "set protocols bgp group BGP_GROUP neighbor 10.3.1.2 family inet unicast",
            "explanation": "配置BGP邻居支持IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，例如inet。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "地址族类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group BGP_GROUP export ADVERTISE_NETWORK",
            "explanation": "配置BGP组导出指定的路由策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "导出的路由策略名称。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]",
            "command": "set policy-options policy-statement ADVERTISE_NETWORK term 1 from route-filter 10.3.1.0/24 exact",
            "explanation": "配置路由策略的匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "路由过滤器，指定匹配的路由。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "match-type",
                    "type": "string",
                    "explanation": "匹配类型，例如exact。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement ADVERTISE_NETWORK term 1 then accept",
            "explanation": "配置路由策略的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "动作，例如accept。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] then [parameter2]": {
            "template": "set policy-options policy-statement [parameter1] then [parameter2]",
            "command": "set policy-options policy-statement ADVERTISE_NETWORK then reject",
            "explanation": "配置路由策略的默认动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "默认动作，例如reject。"
                }
            ]
        }
    }
}