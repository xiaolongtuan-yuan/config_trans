{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode access",
            "explanation": "配置接口的以太网交换模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如access或trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan-members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan-members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan-members [ 2-500 ]",
            "explanation": "配置接口的VLAN成员范围。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "range",
                    "explanation": "VLAN成员的范围。"
                }
            ]
        },
        "set interfaces [parameter1] flexible-vlan-tagging": {
            "template": "set interfaces [parameter1] flexible-vlan-tagging",
            "command": "set interfaces ge-1/0/1 flexible-vlan-tagging",
            "explanation": "启用接口的灵活VLAN标记功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] stacked-vlan-translations vlan-id [parameter2] translate vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] stacked-vlan-translations vlan-id [parameter2] translate vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id 10 translate vlan-id 20",
            "explanation": "配置接口的堆叠VLAN翻译，将一个VLAN ID翻译为另一个VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "原始VLAN的ID号。"
                },
                {
                    "name": "translate-vlan-id",
                    "type": "integer",
                    "explanation": "翻译后的VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] stacked-vlan-translations vlan-id-range [parameter2] translate vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] stacked-vlan-translations vlan-id-range [parameter2] translate vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id-range 1000-2000 translate vlan-id 20",
            "explanation": "配置接口的堆叠VLAN翻译，将一个VLAN ID范围翻译为另一个VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "vlan-id-range",
                    "type": "range",
                    "explanation": "原始VLAN的ID范围。"
                },
                {
                    "name": "translate-vlan-id",
                    "type": "integer",
                    "explanation": "翻译后的VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] stacked-vlan-translations vlan-id [parameter2]": {
            "template": "set interfaces [parameter1] stacked-vlan-translations vlan-id [parameter2]",
            "command": "set interfaces ge-2/0/1 stacked-vlan-translations vlan-id 10",
            "explanation": "配置接口的堆叠VLAN翻译，指定一个VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    }
}