{
    "set system": {
        "template": "set system",
        "set system name [parameter1]": {
            "template": "set system name [parameter1]",
            "command": "set system name ASBR2",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-distribution [parameter1]": {
            "template": "set protocols mpls label-distribution [parameter1]",
            "command": "set protocols mpls label-distribution ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-distribution",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "set protocols bgp peer [parameter1] as [parameter2]": {
            "template": "set protocols bgp peer [parameter1] as [parameter2]",
            "command": "set protocols bgp peer 4.4.4.4 as 200",
            "explanation": "配置BGP对等体及其AS号。",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "as",
                    "type": "integer",
                    "explanation": "BGP对等体的AS号。"
                }
            ]
        },
        "set protocols bgp neighbor [parameter1] remote-as [parameter2]": {
            "template": "set protocols bgp neighbor [parameter1] remote-as [parameter2]",
            "command": "set protocols bgp neighbor 4.4.4.4 remote-as 200",
            "explanation": "配置BGP邻居及其远程AS号。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的远程AS号。"
                }
            ]
        },
        "set protocols bgp neighbor [parameter1] update-source [parameter2]": {
            "template": "set protocols bgp neighbor [parameter1] update-source [parameter2]",
            "command": "set protocols bgp neighbor 4.4.4.4 update-source Loopback0",
            "explanation": "配置BGP邻居的更新源接口。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口名称，例如Loopback0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如mpls。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 3.3.3.3",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        },
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 200",
            "explanation": "配置路由器的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "路由器的自治系统号。"
                }
            ]
        }
    },
    "set inet": {
        "template": "set inet",
        "set inet static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set inet static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set inet static route 4.4.4.4/32 next-hop 10.20.1.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目标网络的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        },
        "set inet label [parameter1] export policy [parameter2]": {
            "template": "set inet label [parameter1] export policy [parameter2]",
            "command": "set inet label 4.4.4.4:0 export policy policy1",
            "explanation": "配置标签的导出策略。",
            "parameters": [
                {
                    "name": "label",
                    "type": "string",
                    "explanation": "标签值。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] family [parameter2] [parameter3]": {
            "template": "set routing-instances [parameter1] family [parameter2] [parameter3]",
            "command": "set routing-instances instance1 family inet unicast",
            "explanation": "配置路由实例的协议族。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如inet。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "单播路由。"
                }
            ]
        },
        "set routing-instances [parameter1] routing-options static route [parameter2]/[parameter3] next-hop [parameter4]": {
            "template": "set routing-instances [parameter1] routing-options static route [parameter2]/[parameter3] next-hop [parameter4]",
            "command": "set routing-instances instance1 routing-options static route 10.30.1.0/24 next-hop 10.20.1.0",
            "explanation": "配置路由实例的静态路由。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目标网络的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols ospf area [parameter2] interface [parameter3]": {
            "template": "set routing-instances [parameter1] protocols ospf area [parameter2] interface [parameter3]",
            "command": "set routing-instances instance1 protocols ospf area 0.0.0.0 interface ge-1/0/0.0",
            "explanation": "配置路由实例的OSPF区域及接口。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement policy1 term 1 from protocol mpls-dpn",
            "explanation": "配置策略语句的匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议，例如mpls-dpn。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then set mpls label push [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then set mpls label push [parameter3]",
            "command": "set policy-options policy-statement policy1 term 1 then set mpls label push \"explicit-null\"",
            "explanation": "配置策略语句的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语号。"
                },
                {
                    "name": "label",
                    "type": "string",
                    "explanation": "MPLS标签动作，例如push \"explicit-null\"。"
                }
            ]
        }
    }
}