{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-protocol [parameter1]": {
            "template": "set protocols mpls label-protocol [parameter1]",
            "command": "set protocols mpls label-protocol ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1] force": {
            "template": "set protocols mpls ldp router-id [parameter1] force",
            "command": "set protocols mpls ldp router-id lo0 force",
            "explanation": "强制配置LDP的路由器ID为指定的环回接口。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP的路由器ID，通常为环回接口。"
                }
            ]
        },
        "set protocols mpls ldp advertise-labels for [parameter1]": {
            "template": "set protocols mpls ldp advertise-labels for [parameter1]",
            "command": "set protocols mpls ldp advertise-labels for 10.1.1.2/32",
            "explanation": "配置LDP为指定的IP地址前缀分发标签。",
            "parameters": [
                {
                    "name": "prefix",
                    "type": "string",
                    "explanation": "需要分发标签的IP地址前缀。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 network 2.2.2.9/32",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "需要加入OSPF区域的网络地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 10 encapsulation ethernet-bridge",
            "explanation": "配置接口单元的封装类型为以太网桥接。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如ethernet-bridge。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 10 vlan-id 10",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] xconnect [parameter3] [parameter4] encapsulation [parameter5]": {
            "template": "set interfaces [parameter1] unit [parameter2] xconnect [parameter3] [parameter4] encapsulation [parameter5]",
            "command": "set interfaces ge-1/0/0 unit 10 xconnect 1.1.1.9 100 encapsulation mpls",
            "explanation": "配置接口单元的交叉连接，使用MPLS封装。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "vc-id",
                    "type": "integer",
                    "explanation": "虚拟电路ID，用于标识不同的虚拟电路。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如mpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet mpls",
            "command": "set interfaces ge-2/0/0 unit 0 family inet mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet mpls ldp": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet mpls ldp",
            "command": "set interfaces ge-2/0/0 unit 0 family inet mpls ldp",
            "explanation": "在接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改，使配置生效。",
            "parameters": []
        }
    }
}