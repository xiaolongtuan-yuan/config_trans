{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE4",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp traffic-engineering": {
            "template": "set protocols ldp traffic-engineering",
            "command": "set protocols ldp traffic-engineering",
            "explanation": "启用LDP流量工程功能。",
            "parameters": []
        },
        "set protocols ldp discovery target-hello-accept interface [parameter1]": {
            "template": "set protocols ldp discovery target-hello-accept interface [parameter1]",
            "command": "set protocols ldp discovery target-hello-accept interface ge-1/0/1",
            "explanation": "配置LDP发现目标Hello接受接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group external peer-as 100",
            "explanation": "配置BGP外部组对等AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称，例如external。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group external local-address lo0.0",
            "explanation": "配置BGP外部组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称，例如external。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址，例如lo0.0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/2",
            "explanation": "配置OSPF区域接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.1.5.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ip": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ip",
            "command": "set interfaces ge-1/0/1 unit 0 family mpls ip",
            "explanation": "配置接口的MPLS IP功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation dot1q [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation dot1q [parameter3]",
            "command": "set interfaces ge-1/0/3 unit 1 encapsulation dot1q 10",
            "explanation": "配置接口的Dot1q封装。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/3 unit 1 family mpls",
            "explanation": "配置接口的MPLS功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ldp discovery target-hello-accept": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ldp discovery target-hello-accept",
            "command": "set interfaces ge-1/0/3 unit 1 family mpls ldp discovery target-hello-accept",
            "explanation": "配置接口的MPLS LDP发现目标Hello接受功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan1 vlan-id 2",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称，例如vlan1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set vlans [parameter1] bridge-domain [parameter2]": {
            "template": "set vlans [parameter1] bridge-domain [parameter2]",
            "command": "set vlans vlan1 bridge-domain 2",
            "explanation": "配置VLAN的桥接域。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称，例如vlan1。"
                },
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域ID。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options l2转发 vlan-ids [parameter1]": {
            "template": "set forwarding-options l2转发 vlan-ids [parameter1]",
            "command": "set forwarding-options l2转发 vlan-ids 1,2",
            "explanation": "配置L2转发的VLAN IDs。",
            "parameters": [
                {
                    "name": "vlan-ids",
                    "type": "string",
                    "explanation": "VLAN IDs，例如1,2。"
                }
            ]
        },
        "set forwarding-options l2转发 forwarding-table [parameter1] arp-options proxy-arp enable": {
            "template": "set forwarding-options l2转发 forwarding-table [parameter1] arp-options proxy-arp enable",
            "command": "set forwarding-options l2转发 forwarding-table vfi1 arp-options proxy-arp enable",
            "explanation": "配置L2转发的转发表代理ARP功能。",
            "parameters": [
                {
                    "name": "forwarding-table",
                    "type": "string",
                    "explanation": "转发表名称，例如vfi1。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vfi1 instance-type vpls",
            "explanation": "配置路由实例的类型。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例名称，例如vfi1。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例类型，例如vpls。"
                }
            ]
        },
        "set routing-instances [parameter1] vfi-id [parameter2]": {
            "template": "set routing-instances [parameter1] vfi-id [parameter2]",
            "command": "set routing-instances vfi1 vfi-id 2",
            "explanation": "配置路由实例的VFI ID。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例名称，例如vfi1。"
                },
                {
                    "name": "vfi-id",
                    "type": "integer",
                    "explanation": "VFI ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 4.4.4.1",
            "explanation": "配置静态路由的下一跳。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "路由地址及掩码，例如0.0.0.0/0。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，例如4.4.4.1。"
                }
            ]
        }
    }
}