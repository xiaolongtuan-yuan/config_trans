{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp enable": {
            "template": "set protocols ldp enable",
            "command": "set protocols ldp enable",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols mpls label-operation [parameter1]": {
            "template": "set protocols mpls label-operation [parameter1]",
            "command": "set protocols mpls label-operation ldp",
            "explanation": "配置MPLS标签操作使用LDP协议。",
            "parameters": [
                {
                    "name": "label-operation",
                    "type": "string",
                    "explanation": "指定MPLS标签操作使用的协议。"
                }
            ]
        },
        "set protocols static route [parameter1] next-hop [parameter2]": {
            "template": "set protocols static route [parameter1] next-hop [parameter2]",
            "command": "set protocols static route 0.0.0.0/0 next-hop 1.1.1.10",
            "explanation": "配置静态路由，指定默认路由的下一跳地址。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS IP功能。",
            "parameters": []
        },
        "set protocols ldp discover peer [parameter1]": {
            "template": "set protocols ldp discover peer [parameter1]",
            "command": "set protocols ldp discover peer 192.168.2.2",
            "explanation": "配置LDP发现对等体。",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols ldp discover peer [parameter1] interface [parameter2]": {
            "template": "set protocols ldp discover peer [parameter1] interface [parameter2]",
            "command": "set protocols ldp discover peer 192.168.1.2 interface ge-0/0/0",
            "explanation": "配置LDP发现对等体并指定接口。",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "指定用于发现对等体的接口。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口支持MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set forwarding": {
        "template": "set forwarding",
        "set forwarding firewall [parameter1]": {
            "template": "set forwarding firewall [parameter1]",
            "command": "set forwarding firewall家庭转发规则",
            "explanation": "配置防火墙转发规则。",
            "parameters": [
                {
                    "name": "firewall-rule",
                    "type": "string",
                    "explanation": "防火墙转发规则的名称或描述。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances rni0 interface ge-0/0/0.0",
            "explanation": "配置路由实例的接口。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，包括单元号。"
                }
            ]
        },
        "set routing-instances [parameter1] instance-type vfi [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type vfi [parameter2]",
            "command": "set routing-instances rni0 instance-type vfi mpls-l2vpn",
            "explanation": "配置路由实例的类型为VFI（虚拟转发实例）并指定MPLS L2VPN。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vfi-type",
                    "type": "string",
                    "explanation": "VFI类型，例如mpls-l2vpn。"
                }
            ]
        },
        "set routing-instances [parameter1] vfi-label allocate": {
            "template": "set routing-instances [parameter1] vfi-label allocate",
            "command": "set routing-instances rni0 vfi-label allocate",
            "explanation": "配置VFI标签为自动分配。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                }
            ]
        },
        "set routing-instances [parameter1] vfi-label [parameter2]": {
            "template": "set routing-instances [parameter1] vfi-label [parameter2]",
            "command": "set routing-instances rni1 vfi-label 202",
            "explanation": "配置VFI标签为指定值。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vfi-label",
                    "type": "integer",
                    "explanation": "VFI标签值。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}