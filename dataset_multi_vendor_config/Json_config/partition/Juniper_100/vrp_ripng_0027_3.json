{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-3/0/0 unit 0 family inet6 address 2001:db8:3::2/96",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ripng group [parameter1] interfaces [parameter2]": {
            "template": "set protocols ripng group [parameter1] interfaces [parameter2]",
            "command": "set protocols ripng group RIPNG-GROUP interfaces ge-3/0/0",
            "explanation": "配置RIPng协议组并指定参与RIPng的接口。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "RIPng协议组的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "参与RIPng协议的接口名称。"
                }
            ]
        }
    }
}