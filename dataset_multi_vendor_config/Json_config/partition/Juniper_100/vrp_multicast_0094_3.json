{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast": {
            "template": "set routing-options multicast",
            "command": "set routing-options multicast",
            "explanation": "启用多播路由选项。",
            "parameters": []
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1]-wide-metrics-only": {
            "template": "set protocols isis level [parameter1]-wide-metrics-only",
            "command": "set protocols isis level 2-wide-metrics-only",
            "explanation": "配置IS-IS协议的级别2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2] [parameter3]": {
            "template": "set protocols isis interface [parameter1] level [parameter2] [parameter3]",
            "command": "set protocols isis interface all level 1 disable",
            "explanation": "在所有接口上禁用IS-IS协议的级别1。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对指定级别的操作，disable表示禁用。"
                }
            ]
        },
        "set protocols isis level [parameter1] interface [parameter2] [parameter3]": {
            "template": "set protocols isis level [parameter1] interface [parameter2] [parameter3]",
            "command": "set protocols isis level 2 interface all passive",
            "explanation": "在IS-IS协议的级别2上将所有接口设置为被动模式。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对指定接口的操作，passive表示设置为被动模式。"
                }
            ]
        },
        "set protocols isis level [parameter1] router-id [parameter2]": {
            "template": "set protocols isis level [parameter1] router-id [parameter2]",
            "command": "set protocols isis level 2 router-id 4.0.0.0",
            "explanation": "配置IS-IS协议的级别2的路由器ID。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID。"
                }
            ]
        },
        "set protocols isis level [parameter1] system-id [parameter2]": {
            "template": "set protocols isis level [parameter1] system-id [parameter2]",
            "command": "set protocols isis level 2 system-id 0000.0000.0004",
            "explanation": "配置IS-IS协议的级别2的系统ID。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "system-id",
                    "type": "string",
                    "explanation": "系统的ID。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-2/0/0.0 mode sparse",
            "explanation": "配置PIM协议的接口模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM协议的模式，sparse表示稀疏模式。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] version [parameter2]": {
            "template": "set protocols igmp interface [parameter1] version [parameter2]",
            "command": "set protocols igmp interface ge-2/0/0.0 version 3",
            "explanation": "配置IGMP协议的接口版本为3。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "IGMP协议的版本。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] join-group [parameter2]": {
            "template": "set protocols igmp interface [parameter1] join-group [parameter2]",
            "command": "set protocols igmp interface ge-2/0/0.0 join-group 224.0.0.1",
            "explanation": "配置IGMP协议的接口加入指定的多播组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "多播组的地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.6.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}