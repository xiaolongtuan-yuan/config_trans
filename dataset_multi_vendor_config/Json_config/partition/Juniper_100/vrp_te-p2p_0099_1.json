{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp enable": {
            "template": "set protocols ldp enable",
            "command": "set protocols ldp enable",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols mpls label protocol [parameter1]": {
            "template": "set protocols mpls label protocol [parameter1]",
            "command": "set protocols mpls label protocol ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface lo0.0",
            "explanation": "配置OSPF区域0的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        },
        "set protocols mpls traffic-eng area [parameter1]": {
            "template": "set protocols mpls traffic-eng area [parameter1]",
            "command": "set protocols mpls traffic-eng area 0",
            "explanation": "配置MPLS流量工程区域。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "MPLS流量工程区域号。"
                }
            ]
        },
        "set protocols mpls traffic-eng router-id [parameter1] force": {
            "template": "set protocols mpls traffic-eng router-id [parameter1] force",
            "command": "set protocols mpls traffic-eng router-id Loopback1 force",
            "explanation": "强制配置MPLS流量工程的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器ID，例如Loopback1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ip address [parameter3] [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ip address [parameter3] [parameter4]",
            "command": "set interfaces eth-trunk1 unit 0 family ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如eth-trunk1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "IPv4子网掩码。"
                }
            ]
        },
        "set interfaces [parameter1] channel-group [parameter2] mode [parameter3]": {
            "template": "set interfaces [parameter1] channel-group [parameter2] mode [parameter3]",
            "command": "set interfaces gigabit-ethernet1/0/0 channel-group 1 mode active",
            "explanation": "配置接口加入通道组并设置模式为主动。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/0。"
                },
                {
                    "name": "channel-group",
                    "type": "integer",
                    "explanation": "通道组号。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "通道组模式，例如active。"
                }
            ]
        }
    }
}