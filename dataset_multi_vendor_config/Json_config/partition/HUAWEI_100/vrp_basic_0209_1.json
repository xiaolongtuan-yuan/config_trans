{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.0.0",
            "explanation": "配置接口的IPv4地址为10.1.2.2，子网掩码为255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "rsa local-key-pair create [parameter1]": {
        "template": "rsa local-key-pair create [parameter1]",
        "command": "rsa local-key-pair create 2048",
        "explanation": "创建一个2048位的RSA本地密钥对",
        "parameters": [
            {
                "name": "key size",
                "type": "integer",
                "explanation": "密钥大小（位数）"
            }
        ]
    },
    "stelnet server enable": {
        "template": "stelnet server enable",
        "command": "stelnet server enable",
        "explanation": "启用STELNET服务器",
        "parameters": []
    },
    "ssh server compatibility-ssh2 enable": {
        "template": "ssh server compatibility-ssh2 enable",
        "command": "ssh server compatibility-ssh2 enable",
        "explanation": "启用SSH服务器的SSH2兼容性",
        "parameters": []
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "配置VTY用户界面，端口范围从0到4",
        "parameters": [
            {
                "name": "start port",
                "type": "integer",
                "explanation": "起始端口"
            },
            {
                "name": "end port",
                "type": "integer",
                "explanation": "结束端口"
            }
        ],
        "authentication-mode password": {
            "template": "authentication-mode password",
            "command": "authentication-mode password",
            "explanation": "设置认证模式为密码认证",
            "parameters": []
        },
        "protocol inbound ssh": {
            "template": "protocol inbound ssh",
            "command": "protocol inbound ssh",
            "explanation": "允许SSH协议的入站连接",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一级配置模式或退出当前配置模式",
        "parameters": []
    }
}