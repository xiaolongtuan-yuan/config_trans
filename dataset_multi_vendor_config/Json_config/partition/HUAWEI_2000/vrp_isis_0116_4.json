{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceE",
        "explanation": "设置设备的主机名为 'DeviceE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router id [parameter1]": {
        "template": "router id [parameter1]",
        "command": "router id 5.5.5.5",
        "explanation": "设置路由器的ID为5.5.5.5",
        "parameters": [
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ]
    },
    "multicast routing-enable": {
        "template": "multicast routing-enable",
        "command": "multicast routing-enable",
        "explanation": "启用组播路由功能",
        "parameters": []
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入IS-IS进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-2",
            "explanation": "设置IS-IS的级别为level-2",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS级别"
                }
            ]
        },
        "cost-style [parameter1]": {
            "template": "cost-style [parameter1]",
            "command": "cost-style wide",
            "explanation": "设置IS-IS的成本计算方式为wide",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "成本计算方式"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0005.00",
            "explanation": "设置IS-IS的网络实体标题为10.0000.0000.0005.00",
            "parameters": [
                {
                    "name": "network entity title",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.3.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.0.3.3，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "pim [parameter1]": {
            "template": "pim [parameter1]",
            "command": "pim sm",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回到用户视图",
        "parameters": []
    }
