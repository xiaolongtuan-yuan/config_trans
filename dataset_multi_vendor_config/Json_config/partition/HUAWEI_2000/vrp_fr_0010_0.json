{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "进入接口配置模式，配置接口 'Pos1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol fr",
            "explanation": "配置接口的链路协议为帧中继 (Frame Relay)",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "链路协议类型"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "fr interface-type [parameter1]": {
            "template": "fr interface-type [parameter1]",
            "command": "fr interface-type dce",
            "explanation": "配置帧中继接口类型为 DCE (数据通信设备)",
            "parameters": [
                {
                    "name": "interface type",
                    "type": "string",
                    "explanation": "帧中继接口类型"
                }
            ]
        }
    },
    "interface [parameter1] [parameter2]": {
        "template": "interface [parameter1] [parameter2]",
        "command": "interface Pos1/0/0.1 p2p",
        "explanation": "进入子接口配置模式，配置点对点 (p2p) 子接口 'Pos1/0/0.1'",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "interface type",
                "type": "string",
                "explanation": "接口类型"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置子接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "fr dlci [parameter1]": {
            "template": "fr dlci [parameter1]",
            "command": "fr dlci 100",
            "explanation": "配置帧中继数据链路连接标识符 (DLCI) 为 100",
            "parameters": [
                {
                    "name": "dlci number",
                    "type": "integer",
                    "explanation": "数据链路连接标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}