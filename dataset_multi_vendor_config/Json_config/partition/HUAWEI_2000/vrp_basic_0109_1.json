{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 2000",
        "explanation": "创建或进入ACL编号2000的配置模式",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "访问控制列表的编号"
            }
        ],
        "rule [parameter1] permit source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit source [parameter2] [parameter3]",
            "command": "rule 5 permit source 1.1.1.1 0",
            "explanation": "在ACL中添加一条规则，允许源地址为1.1.1.1的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "规则编号"
                },
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/1",
        "explanation": "进入 GigabitEthernet1/0/1 接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为2.1.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "进入VTY用户界面配置模式，范围从0到4",
        "parameters": [
            {
                "name": "start vty line",
                "type": "integer",
                "explanation": "起始VTY线路编号"
            },
            {
                "name": "end vty line",
                "type": "integer",
                "explanation": "结束VTY线路编号"
            }
        ],
        "authentication-mode [parameter1]": {
            "template": "authentication-mode [parameter1]",
            "command": "authentication-mode password",
            "explanation": "设置认证模式为密码认证",
            "parameters": [
                {
                    "name": "authentication mode",
                    "type": "string",
                    "explanation": "认证模式类型"
                }
            ]
        },
        "set authentication password cipher [parameter1]": {
            "template": "set authentication password cipher [parameter1]",
            "command": "set authentication password cipher @%@%(t7h+Qu=a#pz`3Kylk1/,JXR%iy(DA!x8&+!|#b&.dEW65~.lEqGm~Np$O#2M]xJM@%@%",
            "explanation": "设置认证密码为加密形式",
            "parameters": [
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "加密的密码字符串"
                }
            ]
        },
        "acl [parameter1] inbound": {
            "template": "acl [parameter1] inbound",
            "command": "acl 2000 inbound",
            "explanation": "应用ACL 2000到VTY接口的入站方向",
            "parameters": [
                {
                    "name": "acl number",
                    "type": "integer",
                    "explanation": "访问控制列表的编号"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向，入站或出站"
                }
            ]
        }
    }
}