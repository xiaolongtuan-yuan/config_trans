    "nqa upload test-type [parameter1] ftp ipv4 [parameter2] file-name [parameter3] port [parameter4] username [parameter5] password [parameter6] interval [parameter7] retry [parameter8]": {
        "template": "nqa upload test-type [parameter1] ftp ipv4 [parameter2] file-name [parameter3] port [parameter4] username [parameter5] password [parameter6] interval [parameter7] retry [parameter8]",
        "command": "nqa upload test-type icmp ftp ipv4 10.1.2.8 file-name test1 port 21 username ftp password %^%#`P'|9L1x62lN*b+C~wMTT|$EA7+z0XOFC_,B$M+\"%^%# interval 600 retry 3",
        "explanation": "配置NQA测试结果上传，测试类型为ICMP，通过FTP协议上传到IPv4地址为10.1.2.8的服务器，文件名为test1，端口为21，用户名ftp，密码为加密字符串，上传间隔为600秒，重试次数为3次",
        "parameters": [
            {
                "name": "test-type",
                "type": "string",
                "explanation": "测试类型"
            },
            {
                "name": "ftp ipv4",
                "type": "IPv4",
                "explanation": "FTP服务器IPv4地址"
            },
            {
                "name": "file-name",
                "type": "string",
                "explanation": "文件名"
            },
            {
                "name": "port",
                "type": "integer",
                "explanation": "端口号"
            },
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            },
            {
                "name": "interval",
                "type": "integer",
                "explanation": "上传间隔时间"
            },
            {
                "name": "retry",
                "type": "integer",
                "explanation": "重试次数"
            }
        ],
        "nqa test-instance [parameter1] [parameter2]": {
            "template": "nqa test-instance [parameter1] [parameter2]",
            "command": "nqa test-instance admin icmp",
            "explanation": "创建NQA测试实例，实例名为admin，测试类型为ICMP",
            "parameters": [
                {
                    "name": "instance name",
                    "type": "string",
                    "explanation": "实例名"
                },
                {
                    "name": "test-type",
                    "type": "string",
