        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.3，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp vrid [parameter1] virtual-ip [parameter2]": {
            "template": "vrrp vrid [parameter1] virtual-ip [parameter2]",
            "command": "vrrp vrid 1 virtual-ip 10.1.1.1",
            "explanation": "配置VRRP虚拟路由器ID为1，虚拟IP地址为10.1.1.1",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv4",
                    "explanation": "虚拟IP地址"
                }
            ]
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口切换到二层模式",
            "parameters": []
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "设置接口的链路类型为trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "链路类型"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "允许VLAN 10通过trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "设置接口的默认VLAN为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 1",
            "explanation": "将接口加入到Eth-Trunk1",
            "parameters": [
                {
                    "name": "eth-trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        }
    },
    "stp enable": {
        "template": "stp enable",
        "command": "stp enable",
        "explanation": "启用STP（生成树协议）",
        "parameters": []
    },
    "stp region-configuration": {
        "template": "stp region-configuration",
        "command": "stp region-configuration",
        "explanation": "进入STP区域配置模式",
        "parameters": [],
