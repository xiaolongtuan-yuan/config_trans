                {
                    "name": "region name",
                    "type": "string",
                    "explanation": "区域名称"
                }
            ]
        },
        "instance [parameter1] vlan [parameter2]": {
            "template": "instance [parameter1] vlan [parameter2]",
            "command": "instance 1 vlan 10",
            "explanation": "将VLAN 10映射到STP实例1",
            "parameters": [
                {
                    "name": "instance id",
                    "type": "integer",
                    "explanation": "STP实例ID"
