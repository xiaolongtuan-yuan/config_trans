{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "启用IS-IS进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0003.00",
            "explanation": "配置IS-IS的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 172.17.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.11.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.11.0，通配符掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}