{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "进入接口 GigabitEthernet1/0/2 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::2/64",
            "explanation": "配置接口的IPv6地址为 2001:db8:1::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址及前缀长度"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ipv6 route-static 2001:db8:5:: 64 GigabitEthernet1/0/2 2001:db8:1::1",
        "explanation": "配置静态IPv6路由，目的网络为 2001:db8:5::/64，出接口为 GigabitEthernet1/0/2，下一跳地址为 2001:db8:1::1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv6",
                "explanation": "目的网络地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}