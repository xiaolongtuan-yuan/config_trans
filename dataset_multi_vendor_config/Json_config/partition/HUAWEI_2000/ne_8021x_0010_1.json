{
    "system-view": {
        "template": "system-view",
        "command": "system-view",
        "explanation": "Enter system view, where you can configure and manage the device.",
        "parameters": []
    },
    "dot1x-template [parameter1]": {
        "template": "dot1x-template [parameter1]",
        "command": "dot1x-template 10",
        "explanation": "Assign a dot1x template to the domain.",
        "parameters": [
            {
                "name": "template-id",
                "type": "integer",
                "explanation": "Identifier of the dot1x template"
            }
        ]
    },
    "radius-server group [parameter1]": {
        "template": "radius-server group [parameter1]",
        "command": "radius-server group shiva",
        "explanation": "Assign a RADIUS server group to the domain.",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "Name of the RADIUS server group"
            }
        ]
    },
    "radius-server authentication [parameter1] [parameter2]": {
        "template": "radius-server authentication [parameter1] [parameter2]",
        "command": "radius-server authentication 10.7.66.66 1812",
        "explanation": "Specify the RADIUS server's IP address and authentication port.",
        "parameters": [
            {
                "name": "server-ip",
                "type": "IPv4",
                "explanation": "IP address of the RADIUS server"
            },
            {
                "name": "auth-port",
                "type": "integer",
                "explanation": "Authentication port number"
            }
        ]
    },
    "aaa": {
        "template": "aaa",
        "command": "aaa",
        "explanation": "Enter AAA view to configure authentication, authorization, and accounting.",
        "parameters": []
    },
    "authentication-scheme [parameter1]": {
        "template": "authentication-scheme [parameter1]",
        "command": "authentication-scheme 1",
        "explanation": "Assign an authentication scheme to the domain.",
        "parameters": [
            {
                "name": "scheme-name",
                "type": "string",
                "explanation": "Name of the authentication scheme"
            }
        ]
    },
    "accounting-scheme [parameter1]": {
        "template": "accounting-scheme [parameter1]",
        "command": "accounting-scheme 1",
        "explanation": "Assign an accounting scheme to the domain.",
        "parameters": [
            {
                "name": "scheme-name",
                "type": "string",
                "explanation": "Name of the accounting scheme"
            }
        ]
    },
    "accounting-mode none": {
        "template": "accounting-mode none",
        "command": "accounting-mode none",
        "explanation": "Disable accounting.",
        "parameters": []
    },
    "domain [parameter1]": {
        "template": "domain [parameter1]",
        "command": "domain huawei",
        "explanation": "Enter or create a domain for user authentication.",
        "parameters": [
            {
                "name": "domain-name",
                "type": "string",
                "explanation": "Name of the domain"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Enter the configuration view of the specified interface.",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Name of the interface"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable the interface.",
            "parameters": []
        },
        "dot1x enable": {
            "template": "dot1x enable",
            "command": "dot1x enable",
            "explanation": "Enable dot1x on the interface.",
            "parameters": []
        },
        "dot1x force-domain [parameter1]": {
            "template": "dot1x force-domain [parameter1]",
            "command": "dot1x force-domain huawei",
            "explanation": "Force the interface to use a specific domain.",
            "parameters": [
                {
                    "name": "domain-name",
                    "type": "string",
                    "explanation": "Name of the domain"
                }
            ]
        },
        "dot1x max-user [parameter1]": {
            "template": "dot1x max-user [parameter1]",
            "command": "dot1x max-user 1",
            "explanation": "Set the maximum number of users allowed on the interface.",
            "parameters": [
                {
                    "name": "max-users",
                    "type": "integer",
                    "explanation": "Maximum number of users"
                }
            ]
        },
        "dot1x guest-vlan [parameter1]": {
            "template": "dot1x guest-vlan [parameter1]",
            "command": "dot1x guest-vlan 0",
            "explanation": "Configure the guest VLAN for the interface.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for guest users"
                }
            ]
        },
        "dot1x auth-fail vlan [parameter1]": {
            "template": "dot1x auth-fail vlan [parameter1]",
            "command": "dot1x auth-fail vlan 0",
            "explanation": "Configure the VLAN for authentication failure.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for authentication failure"
                }
            ]
        },
        "dot1x auth-fail max-attempts [parameter1]": {
            "template": "dot1x auth-fail max-attempts [parameter1]",
            "command": "dot1x auth-fail max-attempts 3",
            "explanation": "Set the maximum number of authentication attempts before locking.",
            "parameters": [
                {
                    "name": "max-attempts",
                    "type": "integer",
                    "explanation": "Maximum number of attempts"
                }
            ]
        },
        "dot1x auth-fail action [parameter1]": {
            "template": "dot1x auth-fail action [parameter1]",
            "command": "dot1x auth-fail action reauthenticate",
            "explanation": "Specify the action to take after authentication failure.",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "Action to take (e.g., reauthenticate)"
                }
            ]
        },
        "dot1x timeout reauth-period [parameter1]": {
            "template": "dot1x timeout reauth-period [parameter1]",
            "command": "dot1x timeout reauth-period 60",
            "explanation": "Set the reauthentication period.",
            "parameters": [
                {
                    "name": "period",
                    "type": "integer",
                    "explanation": "Reauthentication period in seconds"
                }
            ]
        },
        "dot1x critical eapol": {
            "template": "dot1x critical eapol",
            "command": "dot1x critical eapol",
            "explanation": "Set EAPOL as a critical protocol.",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Return to the previous view or quit the current mode.",
        "parameters": []
    }
}