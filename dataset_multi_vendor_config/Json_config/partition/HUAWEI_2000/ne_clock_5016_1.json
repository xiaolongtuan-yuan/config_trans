{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "启用扩展SSM控制",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "状态，可以是 'on' 或 'off'"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步",
            "parameters": []
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级",
            "parameters": [
                {
                    "name": "priority level",
                    "type": "integer",
                    "explanation": "优先级级别"
                }
            ]
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 4",
            "explanation": "设置时钟ID",
            "parameters": [
                {
                    "name": "clock ID",
                    "type": "integer",
                    "explanation": "时钟ID号"
                }
            ]
        }
    }
}