{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "设备的标识名称"
            }
        ]
    },
    "dhcpv6 duid [parameter1]": {
        "template": "dhcpv6 duid [parameter1]",
        "command": "dhcpv6 duid 0001000125a7625df063f9761497",
        "explanation": "配置 DHCPv6 的 DUID（唯一标识符）",
        "parameters": [
            {
                "name": "DUID",
                "type": "string",
                "explanation": "DHCPv6 的唯一标识符"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入 GigabitEthernet1/0/1 接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "指定接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.10.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "接口的 IPv4 地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::1/120",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::1/120",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "接口的 IPv6 地址及前缀长度"
                }
            ]
        },
        "ipv6 address auto link-local": {
            "template": "ipv6 address auto link-local",
            "command": "ipv6 address auto link-local",
            "explanation": "自动配置链路本地 IPv6 地址",
            "parameters": []
        },
        "dhcp select relay": {
            "template": "dhcp select relay",
            "command": "dhcp select relay",
            "explanation": "配置接口作为 DHCP 中继代理",
            "parameters": []
        },
        "ip relay address [parameter1]": {
            "template": "ip relay address [parameter1]",
            "command": "ip relay address 192.168.1.2",
            "explanation": "指定 DHCP 中继的下一跳地址为 192.168.1.2",
            "parameters": [
                {
                    "name": "next hop address",
                    "type": "IPv4",
                    "explanation": "DHCP 服务器的地址"
                }
            ]
        },
        "dhcpv6 relay destination [parameter1]": {
            "template": "dhcpv6 relay destination [parameter1]",
            "command": "dhcpv6 relay destination 2001:DB8:3::2",
            "explanation": "配置 DHCPv6 中继的下一跳地址为 2001:DB8:3::2",
            "parameters": [
                {
                    "name": "next hop address",
                    "type": "IPv6",
                    "explanation": "DHCPv6 服务器的地址"
                }
            ]
        },
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 1",
            "explanation": "配置子接口的 VLAN 类型为 802.1Q，VLAN ID 为 1",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 的标识号"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.1.1.1 255.255.255.255 10.0.0.2",
        "explanation": "配置一条静态路由，目标地址为 10.1.1.1，子网掩码为 255.255.255.255，下一跳地址为 10.0.0.2",
        "parameters": [
            {
                "name": "target address",
                "type": "IPv4",
                "explanation": "静态路由的目标地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "目标地址的子网掩码"
            },
            {
                "name": "next hop address",
                "type": "IPv4",
                "explanation": "数据包转发的下一跳地址"
            }
        ]
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static 2001:DB8:: 128 2001:DB8:2::2",
        "explanation": "配置一条 IPv6 静态路由，目标地址为 2001:DB8::，前缀长度为 128，下一跳地址为 2001:DB8:2::2",
        "parameters": [
            {
                "name": "target address",
                "type": "IPv6",
                "explanation": "静态路由的目标地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "目标地址的前缀长度"
            },
            {
                "name": "next hop address",
                "type": "IPv6",
                "explanation": "数据包转发的下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级配置模式",
        "parameters": []
    }
}