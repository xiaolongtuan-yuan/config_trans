{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "stp mode [parameter1]": {
        "template": "stp mode [parameter1]",
        "command": "stp mode rstp",
        "explanation": "设置生成树协议模式为 RSTP (Rapid Spanning Tree Protocol)",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "stp instance [parameter1] root [parameter2]": {
        "template": "stp instance [parameter1] root [parameter2]",
        "command": "stp instance 0 root secondary",
        "explanation": "配置生成树实例 0 为次根桥",
        "parameters": [
            {
                "name": "instance",
                "type": "integer",
                "explanation": "生成树实例编号"
            },
            {
                "name": "role",
                "type": "string",
                "explanation": "角色，此处为 'secondary' 表示次根桥"
            }
        ]
    },
    "stp pathcost-standard [parameter1]": {
        "template": "stp pathcost-standard [parameter1]",
        "command": "stp pathcost-standard legacy",
        "explanation": "设置生成树路径开销标准为 legacy",
        "parameters": [
            {
                "name": "standard",
                "type": "string",
                "explanation": "路径开销标准"
            }
        ]
    },
    "stp enable": {
        "template": "stp enable",
        "command": "stp enable",
        "explanation": "启用生成树协议",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口 GigabitEthernet1/0/1 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从路由模式切换到交换模式",
            "parameters": []
        },
        "stp enable": {
            "template": "stp enable",
            "command": "stp enable",
            "explanation": "在接口上启用生成树协议",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}