{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口，这里是 GigabitEthernet0/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.0.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.2.2，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ssh client first-time enable": {
        "template": "ssh client first-time enable",
        "command": "ssh client first-time enable",
        "explanation": "允许 SSH 客户端在首次连接时启用",
        "parameters": []
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一层配置模式或退出当前配置模式",
        "parameters": []
    }
}