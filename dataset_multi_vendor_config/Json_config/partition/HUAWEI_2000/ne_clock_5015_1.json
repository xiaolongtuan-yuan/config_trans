{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp-service clock-period [parameter1]": {
        "template": "ntp-service clock-period [parameter1]",
        "command": "ntp-service clock-period 3600",
        "explanation": "设置时钟周期为3600毫秒",
        "parameters": [
            {
                "name": "clock period",
                "type": "integer",
                "explanation": "时钟周期值，单位为毫秒"
            }
        ]
    },
    "ntp-service server [parameter1]": {
        "template": "ntp-service server [parameter1]",
        "command": "ntp-service server 10.0.0.1",
        "explanation": "配置NTP服务器地址为10.0.0.1",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP服务器的IP地址"
            }
        ]
    },
    "clock timezone [parameter1] offset [parameter2]": {
        "template": "clock timezone [parameter1] offset [parameter2]",
        "command": "clock timezone PST offset -8",
        "explanation": "设置时区为PST，偏移量为-8小时",
        "parameters": [
            {
                "name": "timezone name",
                "type": "string",
                "explanation": "时区名称"
            },
            {
                "name": "offset",
                "type": "integer",
                "explanation": "时区偏移量，单位为小时"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "ntp-service enable": {
            "template": "ntp-service enable",
            "command": "ntp-service enable",
            "explanation": "在接口上启用NTP服务",
            "parameters": []
        },
        "ntp-service clock-period [parameter1]": {
            "template": "ntp-service clock-period [parameter1]",
            "command": "ntp-service clock-period 3600",
            "explanation": "设置接口的时钟周期为3600毫秒",
            "parameters": [
                {
                    "name": "clock period",
                    "type": "integer",
                    "explanation": "时钟周期值，单位为毫秒"
                }
            ]
        },
        "ntp-service server [parameter1] prefer": {
            "template": "ntp-service server [parameter1] prefer",
            "command": "ntp-service server 10.0.0.1 prefer",
            "explanation": "配置优选的NTP服务器地址为10.0.0.1",
            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "优选的NTP服务器的IP地址"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级为1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟优先级值"
                }
            ]
        }
    }
}