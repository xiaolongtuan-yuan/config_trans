{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device3",
        "explanation": "设置设备的主机名为 'Device3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 20",
        "explanation": "创建或进入桥域20的配置模式",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ],
        "vxlan vni [parameter1]": {
            "template": "vxlan vni [parameter1]",
            "command": "vxlan vni 5020",
            "explanation": "在桥域20中配置VXLAN网络标识符为5020",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 4.4.4.4",
            "explanation": "配置NVE接口的源地址为4.4.4.4",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        },
        "vni [parameter1] head-end peer-list [parameter2]": {
            "template": "vni [parameter1] head-end peer-list [parameter2]",
            "command": "vni 5020 head-end peer-list 3.3.3.3",
            "explanation": "配置VNI 5020的头部复制，并指定对等体列表为3.3.3.3",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符"
                },
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "对等体地址"
                }
            ]
        }
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/2.1 mode l2",
        "explanation": "进入GigabitEthernet1/0/2.1接口的配置模式，并设置为二层模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 20",
            "explanation": "配置接口的封装类型为dot1q，并指定VLAN ID为20",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "rewrite pop [parameter1]": {
            "template": "rewrite pop [parameter1]",
            "command": "rewrite pop single",
            "explanation": "配置接口的标签操作为弹出单个标签",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "标签操作"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 20",
            "explanation": "将接口关联到桥域20",
            "parameters": [
                {
                    "name": "bridge-domain id",
                    "type": "integer",
                    "explanation": "桥域ID"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 4.4.4.4 0.0.0.0",
                "explanation": "在OSPF区域0.0.0.0中宣告网络4.4.4.4/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}