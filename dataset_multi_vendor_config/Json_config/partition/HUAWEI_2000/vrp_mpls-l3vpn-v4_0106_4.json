{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 6.6.6.6",
        "explanation": "设置MPLS的LSR ID为6.6.6.6",
        "parameters": [
            {
                "name": "lsr-id",
                "type": "IPv4",
                "explanation": "MPLS LSR ID"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "进入MPLS配置模式",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "进入MPLS LDP配置模式",
        "parameters": []
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入ISIS进程1的配置模式",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "ISIS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0006.00",
            "explanation": "设置ISIS的网络实体标题为10.0000.0000.0006.00",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.1.2 255.255.255.252",
            "explanation": "配置接口的IPv4地址为10.20.1.2，子网掩码为255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls": {
            "template": "mpls",
            "command": "mpls",
            "explanation": "在接口上启用MPLS",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用MPLS LDP",
            "parameters": []
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用ISIS进程1",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "ISIS进程ID"
                }
            ]
        }
    },
    "Return": {
        "template": "Return",
        "command": "Return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}