{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname P",
        "explanation": "设置设备的系统名称为 'P'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名"
            }
        ]
    },
    "mpls lsr-id [ip-address]": {
        "template": "mpls lsr-id [ip-address]",
        "command": "mpls lsr-id 192.168.1.4",
        "explanation": "设置MPLS的LSR ID为192.168.1.4",
        "parameters": [
            {
                "name": "ip-address",
                "type": "IPv4",
                "explanation": "LSR的IP地址"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "启用MPLS功能",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用MPLS LDP",
        "parameters": []
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [ip-address] [subnet-mask]": {
            "template": "ip address [ip-address] [subnet-mask]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "接口的IPv4地址"
                },
                {
                    "name": "subnet-mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls": {
            "template": "mpls",
            "command": "mpls",
            "explanation": "在接口上启用MPLS",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用MPLS LDP",
            "parameters": []
        }
    },
    "ospf [process-id]": {
        "template": "ospf [process-id]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程配置模式，进程ID为1",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSPF进程的ID"
            }
        ],
        "area [area-id]": {
            "template": "area [area-id]",
            "command": "area 0.0.0.0",
            "explanation": "定义OSPF区域0.0.0.0",
            "parameters": [
                {
                    "name": "area-id",
                    "type": "IPv4",
                    "explanation": "OSPF区域的ID"
                }
            ],
            "network [ip-address] [wildcard-mask]": {
                "template": "network [ip-address] [wildcard-mask]",
                "command": "network 192.168.1.4 0.0.0.0",
                "explanation": "将环回接口加入OSPF区域",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "IPv4",
                        "explanation": "网络的IP地址"
                    },
                    {
                        "name": "wildcard-mask",
                        "type": "IPv4",
                        "explanation": "反掩码"
                    }
                ]
            }
        }
    }
}