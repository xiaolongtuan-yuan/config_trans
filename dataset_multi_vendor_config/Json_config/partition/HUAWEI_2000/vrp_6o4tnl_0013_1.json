{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的名称为 'DeviceA'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [interface_name]": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [ip_address] [subnet_mask]": {
            "template": "ip address [ip_address] [subnet_mask]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip_address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet_mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [ipv6_address] [prefix_length]": {
            "template": "ipv6 address [ipv6_address] [prefix_length]",
            "command": "ipv6 address 2001:db8:101:101::1 64",
            "explanation": "配置接口的IPv6地址为 2001:db8:101:101::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6_address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "prefix_length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "tunnel-protocol [protocol]": {
            "template": "tunnel-protocol [protocol]",
            "command": "tunnel-protocol ipv6-ipv4 6rd",
            "explanation": "设置隧道协议为 ipv6-ipv4 6rd",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "隧道协议类型"
                }
            ]
        },
        "source [interface_name]": {
            "template": "source [interface_name]",
            "command": "source GigabitEthernet1/0/1",
            "explanation": "设置隧道的源接口为 GigabitEthernet1/0/1",
            "parameters": [
                {
                    "name": "interface_name",
                    "type": "string",
                    "explanation": "源接口名称"
                }
            ]
        },
        "ipv6-prefix [ipv6_prefix]": {
            "template": "ipv6-prefix [ipv6_prefix]",
            "command": "ipv6-prefix 2001:db8::/32",
            "explanation": "设置IPv6前缀为 2001:db8::/32",
            "parameters": [
                {
                    "name": "ipv6_prefix",
                    "type": "IPv6 prefix",
                    "explanation": "IPv6前缀"
                }
            ]
        },
        "ipv4-prefix length [length]": {
            "template": "ipv4-prefix length [length]",
            "command": "ipv4-prefix length 8",
            "explanation": "设置IPv4前缀长度为 8",
            "parameters": [
                {
                    "name": "length",
                    "type": "integer",
                    "explanation": "IPv4前缀长度"
                }
            ]
        }
    },
    "ipv6 route-static [destination] [prefix_length] [interface]": {
        "template": "ipv6 route-static [destination] [prefix_length] [interface]",
        "command": "ipv6 route-static 2001:db8:: 32 Tunnel1",
        "explanation": "配置静态IPv6路由，目的地为 2001:db8::/32，出接口为 Tunnel1",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的地IPv6地址"
            },
            {
                "name": "prefix_length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    }
}