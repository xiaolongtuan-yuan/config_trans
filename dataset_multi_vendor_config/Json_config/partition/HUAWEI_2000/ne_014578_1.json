{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname P",
        "explanation": "设置设备的系统名称为 \"P\"",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的系统名称"
            }
        ]
    },
    "mpls lsr-id [lsr-id]": {
        "template": "mpls lsr-id [lsr-id]",
        "command": "mpls lsr-id 2.2.2.9",
        "explanation": "设置 MPLS LSR 的标识符为 2.2.2.9",
        "parameters": [
            {
                "name": "lsr-id",
                "type": "IPv4",
                "explanation": "LSR 的标识符"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "启用 MPLS 功能",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用 MPLS LDP 协议",
        "parameters": []
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入 GigabitEthernet1/0/0 接口配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [ip-address] [mask]": {
            "template": "ip address [ip-address] [mask]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls": {
            "template": "mpls",
            "command": "mpls",
            "explanation": "在接口上启用 MPLS",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP",
            "parameters": []
        }
    },
    "ospf [process-id]": {
        "template": "ospf [process-id]",
        "command": "ospf 1",
        "explanation": "启用 OSPF 进程，进程ID为1",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSPF 进程ID"
            }
        ],
        "area [area-id]": {
            "template": "area [area-id]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPF 的区域，区域ID为0.0.0.0",
            "parameters": [
                {
                    "name": "area-id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域ID"
                }
            ],
            "network [ip-address] [wildcard-mask]": {
                "template": "network [ip-address] [wildcard-mask]",
                "command": "network 2.2.2.9 0.0.0.0",
                "explanation": "将网络 2.2.2.9/32 区域划分为 OSPF 区域0",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard-mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回上一级",
        "parameters": []
    }
}