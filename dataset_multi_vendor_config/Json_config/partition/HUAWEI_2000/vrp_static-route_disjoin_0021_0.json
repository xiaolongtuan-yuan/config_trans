{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceT",
        "explanation": "设置设备的主机名为 'DeviceT'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bfd [parameter1] bind peer-ip [parameter2] source-ip [parameter3]": {
        "template": "bfd [parameter1] bind peer-ip [parameter2] source-ip [parameter3]",
        "command": "bfd aa bind peer-ip 192.168.11.1 source-ip 192.168.10.1",
        "explanation": "配置BFD会话aa，绑定对端IP为192.168.11.1，源IP为192.168.10.1",
        "parameters": [
            {
                "name": "session name",
                "type": "string",
                "explanation": "BFD会话名称"
            },
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "source ip",
                "type": "IPv4",
                "explanation": "源IP地址"
            }
        ]
    },
    "discriminator local [parameter1]": {
        "template": "discriminator local [parameter1]",
        "command": "discriminator local 10",
        "explanation": "设置BFD会话的本地标识符为10",
        "parameters": [
            {
                "name": "local discriminator",
                "type": "integer",
                "explanation": "本地标识符"
            }
        ]
    },
    "discriminator remote [parameter1]": {
        "template": "discriminator remote [parameter1]",
        "command": "discriminator remote 20",
        "explanation": "设置BFD会话的远端标识符为20",
        "parameters": [
            {
                "name": "remote discriminator",
                "type": "integer",
                "explanation": "远端标识符"
            }
        ]
    },
    "ip route-static frr": {
        "template": "ip route-static frr",
        "command": "ip route-static frr",
        "explanation": "启用静态路由的快速重路由功能",
        "parameters": []
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4] preference [parameter5] track [parameter6]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4] preference [parameter5] track [parameter6]",
        "command": "ip route-static 172.17.1.0 24 GigabitEthernet2/0/0 192.168.10.2 preference 40 track bfd-session aa",
        "explanation": "配置静态路由，目的网络为172.17.1.0/24，出接口为GigabitEthernet2/0/0，下一跳为192.168.10.2，优先级为40，并跟踪BFD会话aa",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            },
            {
                "name": "preference",
                "type": "integer",
                "explanation": "优先级"
            },
            {
                "name": "track bfd-session",
                "type": "string",
                "explanation": "跟踪的BFD会话名称"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route-static 172.17.1.0 24 GigabitEthernet3/0/0 192.168.20.2",
        "explanation": "配置静态路由，目的网络为172.17.1.0/24，出接口为GigabitEthernet3/0/0，下一跳为192.168.20.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
