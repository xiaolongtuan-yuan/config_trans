{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 100 200",
        "explanation": "批量创建VLAN 100和200",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "bpdu-tunnel stp group-mac [parameter1]": {
        "template": "bpdu-tunnel stp group-mac [parameter1]",
        "command": "bpdu-tunnel stp group-mac 00e0-fc12-3456",
        "explanation": "配置BPDU隧道STP组MAC地址为00e0-fc12-3456",
        "parameters": [
            {
                "name": "group mac address",
                "type": "MAC",
                "explanation": "组MAC地址"
            }
        ]
    },
    "stp enable": {
        "template": "stp enable",
        "command": "stp enable",
        "explanation": "启用STP（生成树协议）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 200",
            "explanation": "设置接口的默认VLAN为200",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bpdu-tunnel enable": {
            "template": "bpdu-tunnel enable",
            "command": "bpdu-tunnel enable",
            "explanation": "启用BPDU隧道功能",
            "parameters": []
        },
        "stp disable": {
            "template": "stp disable",
            "command": "stp disable",
            "explanation": "禁用STP（生成树协议）",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1] [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] [parameter2]",
            "command": "port trunk allow-pass vlan 100 200",
            "explanation": "配置接口允许通过的VLAN为100和200",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}