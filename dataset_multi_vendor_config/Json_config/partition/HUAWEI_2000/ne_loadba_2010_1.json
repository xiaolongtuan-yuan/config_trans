{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerB",
        "explanation": "设置设备的主机名为 'routerB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1",
        "explanation": "进入 Eth-Trunk1 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.40.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 1",
            "explanation": "将接口加入 Eth-Trunk1",
            "parameters": [
                {
                    "name": "eth-trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route-static 10.1.1.0 255.255.255.0 GigabitEthernet2/0/0 10.30.1.1",
        "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳为 10.30.1.1，出接口为 GigabitEthernet2/0/0",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}