{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname PE1",
        "explanation": "设置设备的系统名称为 'PE1'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的系统名称"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "启用精确时间协议(PTP)",
        "parameters": []
    },
    "ptp profile [profile_name] enable": {
        "template": "ptp profile [profile_name] enable",
        "command": "ptp profile g-8275-1 enable",
        "explanation": "启用特定的PTP配置文件 'g-8275-1'",
        "parameters": [
            {
                "name": "profile_name",
                "type": "string",
                "explanation": "PTP配置文件名称"
            }
        ]
    },
    "ptp device-type [device_type]": {
        "template": "ptp device-type [device_type]",
        "command": "ptp device-type t-bc",
        "explanation": "设置设备的PTP类型为 't-bc'",
        "parameters": [
            {
                "name": "device_type",
                "type": "string",
                "explanation": "PTP设备类型"
            }
        ]
    },
    "interface [interface_name]": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入 GigabitEthernet1/0/0 接口的配置模式",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "启用接口的时钟同步",
            "parameters": []
        },
        "ptp enable": {
            "template": "ptp enable",
            "command": "ptp enable",
            "explanation": "在接口上启用PTP",
            "parameters": []
        }
    }
}