                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 4",
                "explanation": "配置远程MEP ID 4",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 4 enable",
                "explanation": "启用远程MEP ID 4的CCM接收",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "test-id [parameter1] mep [parameter2]": {
                "template": "test-id [parameter1] mep [parameter2]",
                "command": "test-id 2 mep 3",
                "explanation": "配置测试ID 2与MEP 3关联",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    }
                ]
            },
            "loss-measure single-ended receive test-id [parameter1]": {
                "template": "loss-measure single-ended receive test-id [parameter1]",
                "command": "loss-measure single-ended receive test-id 2",
                "explanation": "配置单端接收测试，测试ID为2",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            }
