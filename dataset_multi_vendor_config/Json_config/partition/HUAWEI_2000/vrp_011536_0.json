        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "CFM域名称"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma2",
            "explanation": "创建或进入MA ma2的配置模式",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "MA名称"
                }
            ],
