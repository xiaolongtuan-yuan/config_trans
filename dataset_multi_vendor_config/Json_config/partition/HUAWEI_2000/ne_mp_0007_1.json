{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "controller [parameter1]": {
        "template": "controller [parameter1]",
        "command": "controller E1 2/0/0",
        "explanation": "进入E1控制器2/0/0的配置模式",
        "parameters": [
            {
                "name": "controller name",
                "type": "string",
                "explanation": "控制器名称"
            }
        ],
        "channel-set [parameter1] timeslot-list [parameter2]": {
            "template": "channel-set [parameter1] timeslot-list [parameter2]",
            "command": "channel-set 1 timeslot-list 1-15",
            "explanation": "配置通道集1，使用时隙列表1-15",
            "parameters": [
                {
                    "name": "channel-set number",
                    "type": "integer",
                    "explanation": "通道集编号"
                },
                {
                    "name": "timeslot-list",
                    "type": "string",
                    "explanation": "时隙列表"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial2/0/0:1",
        "explanation": "进入串行接口2/0/0:1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "配置接口的链路协议为PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "链路协议"
                }
            ]
        },
        "ppp mp [parameter1]": {
            "template": "ppp mp [parameter1]",
            "command": "ppp mp Mp-group2/0/1",
            "explanation": "配置PPP多链路绑定到Mp-group2/0/1",
            "parameters": [
                {
                    "name": "Mp-group",
                    "type": "string",
                    "explanation": "多链路组名"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}