{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerD",
        "explanation": "设置设备的主机名为 'routerD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "启用 ISIS 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "ISIS 进程 ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-1",
            "explanation": "设置 ISIS 的等级为 level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS 的等级，level-1 或 level-2"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0004.00",
            "explanation": "设置 ISIS 的网络实体标题",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "ISIS 的网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入 GigabitEthernet1/0/0 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.50.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.50.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用 ISIS 进程 1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "ISIS 进程 ID"
                }
            ]
        }
    }
}