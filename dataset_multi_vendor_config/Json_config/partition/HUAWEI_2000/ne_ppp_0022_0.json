            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名"
                },
                {
                    "name": "service type",
                    "type": "string",
                    "explanation": "服务类型"
                }
            ]
        },
        "authentication-scheme [parameter1]": {
