{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式，配置GigabitEthernet1/0/0接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "filter-policy ip-prefix [parameter1] [parameter2]": {
            "template": "filter-policy ip-prefix [parameter1] [parameter2]",
            "command": "filter-policy ip-prefix in import",
            "explanation": "设置OSPF引入路由时的过滤策略，使用名为'in'的IP前缀列表",
            "parameters": [
                {
                    "name": "ip-prefix name",
                    "type": "string",
                    "explanation": "IP前缀列表名称"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "过滤方向，'import'表示引入路由时过滤"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.2.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.2.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5]": {
        "template": "ip ip-prefix [parameter1] index [parameter2] [parameter3] [parameter4] [parameter5]",
        "command": "ip ip-prefix in index 10 permit 172.16.18.0 24",
        "explanation": "配置IP前缀列表'in'的条目，索引为10，允许172.16.18.0/24网络",
        "parameters": [
            {
                "name": "ip-prefix name",
                "type": "string",
                "explanation": "IP前缀列表名称"
            },
            {
                "name": "index",
                "type": "integer",
                "explanation": "条目的索引号"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作，'permit'表示允许"
            },
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}