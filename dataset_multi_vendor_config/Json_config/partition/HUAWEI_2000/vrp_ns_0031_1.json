{
    "slot [parameter1]": {
        "template": "slot [parameter1]",
        "command": "slot 1",
        "explanation": "选择槽位1进行配置",
        "parameters": [
            {
                "name": "slot number",
                "type": "integer",
                "explanation": "槽位号"
            }
        ],
        "ip netstream sampler to slot [parameter1]": {
            "template": "ip netstream sampler to slot [parameter1]",
            "command": "ip netstream sampler to slot self",
            "explanation": "配置NetStream采样器将数据发送到本槽位",
            "parameters": [
                {
                    "name": "slot",
                    "type": "string",
                    "explanation": "槽位标识"
                }
            ]
        }
    },
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE",
        "explanation": "设置设备的主机名为 'PE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip netstream tcp-flag enable": {
        "template": "ip netstream tcp-flag enable",
        "command": "ip netstream tcp-flag enable",
        "explanation": "启用NetStream的TCP标志位采集功能",
        "parameters": []
    },
    "ip netstream sampler fix-packets [parameter1] [parameter2]": {
        "template": "ip netstream sampler fix-packets [parameter1] [parameter2]",
        "command": "ip netstream sampler fix-packets 10000 inbound",
        "explanation": "配置NetStream采样器以固定包数10000进行入方向采样",
        "parameters": [
            {
                "name": "packet count",
                "type": "integer",
                "explanation": "包数"
            },
            {
                "name": "direction",
                "type": "string",
                "explanation": "方向"
            }
        ]
    },
    "ip netstream export source [parameter1]": {
        "template": "ip netstream export source [parameter1]",
        "command": "ip netstream export source 192.168.2.1",
        "explanation": "配置NetStream导出数据源地址为192.168.2.1",
        "parameters": [
            {
                "name": "source ip address",
                "type": "IPv4",
                "explanation": "源IP地址"
            }
        ]
    },
    "ip netstream export host [parameter1] [parameter2]": {
        "template": "ip netstream export host [parameter1] [parameter2]",
        "command": "ip netstream export host 192.168.2.2 9001",
        "explanation": "配置NetStream导出数据目的地址为192.168.2.2，端口号为9001",
        "parameters": [
            {
                "name": "host ip address",
                "type": "IPv4",
                "explanation": "目的IP地址"
            },
            {
                "name": "port",
                "type": "integer",
                "explanation": "端口号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet 2/0/0",
        "explanation": "进入接口gigabitethernet 2/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为192.168.2.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip netstream inbound": {
            "template": "ip netstream inbound",
            "command": "ip netstream inbound",
            "explanation": "启用接口的入方向NetStream功能",
            "parameters": []
        },
        "ip netstream outbound": {
            "template": "ip netstream outbound",
            "command": "ip netstream outbound",
            "explanation": "启用接口的出方向NetStream功能",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}