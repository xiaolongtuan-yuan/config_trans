{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:3::2/64",
            "explanation": "配置接口的IPv6地址为 2001:db8:3::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.2",
            "explanation": "在接口上启用OSPFv3进程1，并将其分配到区域0.0.0.2",
            "parameters": [
                {
                    "name": "ospfv3 process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "进入OSPFv3进程1的配置模式",
        "parameters": [
            {
                "name": "ospfv3 process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置OSPFv3进程1的路由器ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.2",
            "explanation": "进入OSPFv3区域0.0.0.2的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}