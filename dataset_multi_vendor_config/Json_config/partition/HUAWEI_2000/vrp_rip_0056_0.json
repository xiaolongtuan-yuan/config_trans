{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "进入接口gigabitethernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 2.2.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "rip [parameter1]": {
        "template": "rip [parameter1]",
        "command": "rip 1",
        "explanation": "进入RIP进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "RIP进程ID"
            }
        ],
        "version [parameter1]": {
            "template": "version [parameter1]",
            "command": "version 2",
            "explanation": "配置RIP版本为2",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "RIP版本"
                }
            ]
        },
        "network [parameter1]": {
            "template": "network [parameter1]",
            "command": "network 2.0.0.0",
            "explanation": "在RIP进程中通告网络2.0.0.0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                }
            ]
        },
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用BFD",
            "parameters": []
        },
        "bfd all-interfaces min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]": {
            "template": "bfd all-interfaces min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]",
            "command": "bfd all-interfaces min-tx-interval 100 min-rx-interval 100 detect-multiplier 10",
            "explanation": "配置所有接口的BFD最小发送间隔为100ms，最小接收间隔为100ms，检测倍数为10",
            "parameters": [
                {
                    "name": "min-tx-interval",
                    "type": "integer",
                    "explanation": "最小发送间隔(ms)"
                },
                {
                    "name": "min-rx-interval",
                    "type": "integer",
                    "explanation": "最小接收间隔(ms)"
                },
                {
                    "name": "detect-multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
}