{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Hub",
        "explanation": "设置设备的主机名为 'Hub'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.10，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "设置隧道的协议为GRE，点对多点",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "隧道协议类型"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "指定隧道的源接口为GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 100",
        "explanation": "启用BGP进程，AS号为100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "设置BGP的router-id为172.16.1.1",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器标识"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.2 as-number 200",
            "explanation": "配置BGP对等体172.16.1.2，AS号为200",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "对等体地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族进行配置",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "取消BGP同步",
                "parameters": []
            },
            "aggregate [parameter1] [parameter2]": {
                "template": "aggregate [parameter1] [parameter2]",
                "command": "aggregate 192.168.0.0 255.255.0.0",
                "explanation": "配置聚合路由192.168.0.0/16",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "掩码"
                    }
                ]
            },
            "import-route ospf [parameter1]": {
                "template": "import-route ospf [parameter1]",
                "command": "import-route ospf 1",
                "explanation": "引入OSPF进程1的路由到BGP",
                "parameters": [
                    {
                        "name": "ospf process id",
                        "type": "integer",
                        "explanation": "OSPF进程ID"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.1.2 enable",
                "explanation": "启用与对等体172.16.1.2的连接",
                "parameters": [
                    {
                        "name": "peer address",
                        "type": "IPv4",
                        "explanation": "对等体地址"
                    }
                ]
            }
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.1",
        "explanation": "启用OSPF进程1，并设置router-id为172.16.1.1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            },
            {
                "name": "router-id",
                "type": "IPv4",
                "explanation": "路由器标识"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPF区域0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.0.0 0.0.0.255",
                "explanation": "将网络192.168.0.0/24加入OSPF区域",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "反掩码"
                    }
                ]
            }
        }
    }
}