{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Switch",
        "explanation": "设置设备的主机名为 'Switch'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 100",
        "explanation": "批量创建VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 100",
            "explanation": "配置接口允许VLAN 100的流量通过",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "port vlan-stacking vlan [parameter1] stack-vlan [parameter2]": {
            "template": "port vlan-stacking vlan [parameter1] stack-vlan [parameter2]",
            "command": "port vlan-stacking vlan 10 stack-vlan 100",
            "explanation": "配置接口的VLAN stacking功能，将VLAN 10的流量封装在VLAN 100中",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                },
                {
                    "name": "stack vlan id",
                    "type": "integer",
                    "explanation": "堆叠VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}