{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ops": {
        "template": "ops",
        "command": "ops",
        "explanation": "进入OPS配置模式",
        "parameters": [],
        "assistant [parameter1]": {
            "template": "assistant [parameter1]",
            "command": "assistant collect_health",
            "explanation": "创建一个名为 'collect_health' 的OPS助手",
            "parameters": [
                {
                    "name": "assistant name",
                    "type": "string",
                    "explanation": "助手名称"
                }
            ],
            "execute [parameter1] command [parameter2]": {
                "template": "execute [parameter1] command [parameter2]",
                "command": "execute 1 command display device > health.txt",
                "explanation": "执行命令 'display device' 并将输出重定向到文件 'health.txt'",
                "parameters": [
                    {
                        "name": "sequence number",
                        "type": "integer",
                        "explanation": "执行顺序编号"
                    },
                    {
                        "name": "command",
                        "type": "string",
                        "explanation": "要执行的命令"
                    }
                ]
            },
            "condition timer cron [parameter1] [parameter2] [parameter3] [parameter4] [parameter5] [parameter6]": {
                "template": "condition timer cron [parameter1] [parameter2] [parameter3] [parameter4] [parameter5] [parameter6]",
                "command": "condition timer cron 0 1 * * * *",
                "explanation": "设置定时任务，每天凌晨1点执行",
                "parameters": [
                    {
                        "name": "second",
                        "type": "integer",
                        "explanation": "秒"
                    },
                    {
                        "name": "minute",
                        "type": "integer",
                        "explanation": "分钟"
                    },
                    {
                        "name": "hour",
                        "type": "integer",
                        "explanation": "小时"
                    },
                    {
                        "name": "day of month",
                        "type": "integer",
                        "explanation": "日"
                    },
                    {
                        "name": "month",
                        "type": "integer",
                        "explanation": "月"
                    },
                    {
                        "name": "day of week",
                        "type": "integer",
                        "explanation": "星期"
                    }
                ]
            }
        }
    }
}