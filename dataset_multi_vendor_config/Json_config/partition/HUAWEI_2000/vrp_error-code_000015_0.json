{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD（双向转发检测）功能",
        "parameters": []
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "创建并进入IS-IS进程1的视图",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0001.00",
            "explanation": "配置IS-IS的网络实体名称（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体名称"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1",
        "explanation": "进入Eth-Trunk1接口视图",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bit-error-detection": {
            "template": "bit-error-detection",
            "command": "bit-error-detection",
            "explanation": "启用比特错误检测功能",
            "parameters": []
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "isis link-quality [parameter1] incr-cost [parameter2]": {
            "template": "isis link-quality [parameter1] incr-cost [parameter2]",
            "command": "isis link-quality low incr-cost max-reachable",
            "explanation": "配置IS-IS链路质量为低，增加成本，最大可达",
            "parameters": [
                {
                    "name": "link quality",
                    "type": "string",
                    "explanation": "链路质量"
                },
                {
                    "name": "cost type",
                    "type": "string",
                    "explanation": "成本类型"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 1",
            "explanation": "将接口加入到Eth-Trunk1",
            "parameters": [
                {
                    "name": "Eth-Trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        },
        "link-quality [parameter1] bit-error-threshold error-ratio [parameter2] [parameter3] resume-ratio [parameter4] [parameter5]": {
            "template": "link-quality [parameter1] bit-error-threshold error-ratio [parameter2] [parameter3] resume-ratio [parameter4] [parameter5]",
            "command": "link-quality low bit-error-threshold error-ratio 3 4 resume-ratio 2 5",
            "explanation": "配置链路质量为低，比特错误阈值，错误比率3/4，恢复比率2/5",
            "parameters": [
                {
                    "name": "link quality",
                    "type": "string",
                    "explanation": "链路质量"
                },
                {
                    "name": "bit-error-threshold",
                    "type": "string",
                    "explanation": "比特错误阈值"
                },
                {
                    "name": "error-ratio",
                    "type": "string",
                    "explanation": "错误比率"
                },
                {
                    "name": "resume-ratio",
                    "type": "string",
                    "explanation": "恢复比率"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图并返回到用户视图",
        "parameters": []
    }
}