            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65420",
        "explanation": "进入BGP配置模式，AS号为65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 20.20.20.20",
            "explanation": "设置BGP的Router ID为20.20.20.20",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:db8:2::2 as-number 100",
            "explanation": "配置BGP对等体2001:db8:2::2，AS号为100",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv6",
                    "explanation": "对等体地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "ipv6-family unicast": {
            "template": "ipv6-family unicast",
            "command": "ipv6-family unicast",
            "explanation": "进入IPv6单播地址族的配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "引入直连路由",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 2001:db8:2::2 enable",
                "explanation": "在IPv6单播地址族下启用对等体2001:db8:2::2",
                "parameters": [
                    {
                        "name": "peer address",
                        "type": "IPv6",
                        "explanation": "对等体地址"
                    }
                ]
            }
