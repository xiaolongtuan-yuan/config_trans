            "template": "rule [parameter1] permit source [parameter2] destination [parameter3]",
            "command": "rule 5 permit source 2001:DB8::/32 destination any",
            "explanation": "在ACL中添加一条规则，允许源地址为2001:DB8::/32到任何目的地的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "规则编号"
                },
                {
                    "name": "source address",
                    "type": "IPv6 prefix",
                    "explanation": "源地址前缀"
                },
                {
                    "name": "destination address",
                    "type": "string",
                    "explanation": "目的地地址，可以是'any'或特定地址"
                }
            ]
        }
    },
