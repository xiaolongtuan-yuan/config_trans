        "template": "ipv6 route-static frr",
        "command": "ipv6 route-static frr",
        "explanation": "启用IPv6静态路由的快速重路由功能",
        "parameters": []
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4] preference [parameter5] track bfd-session [parameter6]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4] preference [parameter5] track bfd-session [parameter6]",
        "command": "ipv6 route-static 2001:db8:6:: 64 GigabitEthernet1/0/2 2001:db8:1::2 preference 40 track bfd-session aa",
        "explanation": "配置IPv6静态路由，目的地址为2001:db8:6::，前缀长度为64，出接口为GigabitEthernet1/0/2，下一跳地址为2001:db8:1::2，优先级为40，并绑定BFD会话aa进行跟踪",
        "parameters": [
            {
                "name": "destination ipv6 address",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop ipv6 address",
                "type": "IPv6",
                "explanation": "下一跳IPv6地址"
            },
            {
                "name": "preference",
                "type": "integer",
                "explanation": "优先级"
            },
            {
                "name": "bfd session name",
                "type": "string",
                "explanation": "BFD会话名称"
            }
        ]
    },
