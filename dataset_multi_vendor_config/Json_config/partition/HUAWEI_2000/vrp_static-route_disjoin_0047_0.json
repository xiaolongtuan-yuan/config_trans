        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ipv6 route-static 2001:db8:6:: 64 GigabitEthernet1/0/1 2001:db8:2::2",
        "explanation": "配置IPv6静态路由，目的地址为2001:db8:6::，前缀长度为64，出接口为GigabitEthernet1/0/1，下一跳地址为2001:db8:2::2",
        "parameters": [
            {
                "name": "destination ipv6 address",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop ipv6 address",
                "type": "IPv6",
                "explanation": "下一跳IPv6地址"
