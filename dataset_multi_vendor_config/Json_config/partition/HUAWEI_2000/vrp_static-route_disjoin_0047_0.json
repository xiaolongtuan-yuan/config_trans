        "template": "bfd [parameter1] bind peer-ipv6 [parameter2] source-ipv6 [parameter3]",
        "command": "bfd aa bind peer-ipv6 2001:db8:3::2 source-ipv6 2001:db8:1::1",
        "explanation": "配置BFD会话，名称为aa，对端IPv6地址为2001:db8:3::2，源IPv6地址为2001:db8:1::1",
        "parameters": [
            {
                "name": "bfd session name",
