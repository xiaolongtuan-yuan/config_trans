{
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 2000",
        "explanation": "创建一个编号为2000的ACL（访问控制列表）",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "ACL编号"
            }
        ],
        "rule [parameter1] deny source [parameter2] [parameter3]": {
            "template": "rule [parameter1] deny source [parameter2] [parameter3]",
            "command": "rule 5 deny source 10.1.1.1 0",
            "explanation": "在ACL 2000中添加一条规则，规则ID为5，拒绝源IP地址为10.1.1.1的流量",
            "parameters": [
                {
                    "name": "rule id",
                    "type": "integer",
                    "explanation": "规则ID"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard bits",
                    "type": "integer",
                    "explanation": "通配符位"
                }
            ]
        }
    },
    "user-interface maximum-vty [parameter1]": {
        "template": "user-interface maximum-vty [parameter1]",
        "command": "user-interface maximum-vty 21",
        "explanation": "设置VTY（虚拟类型终端）用户界面的最大数量为21",
        "parameters": [
            {
                "name": "maximum vty number",
                "type": "integer",
                "explanation": "最大VTY数量"
            }
        ]
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 17",
        "explanation": "配置VTY用户界面，范围从0到17",
        "parameters": [
            {
                "name": "start vty number",
                "type": "integer",
                "explanation": "起始VTY编号"
            },
            {
                "name": "end vty number",
                "type": "integer",
                "explanation": "结束VTY编号"
            }
        ],
        "authentication-mode password": {
            "template": "authentication-mode password",
            "command": "authentication-mode password",
            "explanation": "设置VTY用户界面的认证模式为密码认证",
            "parameters": []
        },
        "user privilege level [parameter1]": {
            "template": "user privilege level [parameter1]",
            "command": "user privilege level 15",
            "explanation": "设置VTY用户界面的用户权限级别为15",
            "parameters": [
                {
                    "name": "privilege level",
                    "type": "integer",
                    "explanation": "用户权限级别"
                }
            ]
        },
        "set authentication password cipher [parameter1]": {
            "template": "set authentication password cipher [parameter1]",
            "command": "set authentication password cipher @%@%qQ5h+h1Ba#pJOx#+2[NX>3v'Ks6m@1Qg4%T>-q:D>7{](U0.BAb*OlJW&>We\\]@%@%",
            "explanation": "设置VTY用户界面的认证密码为加密格式",
            "parameters": [
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "加密的密码"
                }
            ]
        },
        "history-command max-size [parameter1]": {
            "template": "history-command max-size [parameter1]",
            "command": "history-command max-size 20",
            "explanation": "设置VTY用户界面的历史命令记录最大数量为20",
            "parameters": [
                {
                    "name": "max size",
                    "type": "integer",
                    "explanation": "历史命令记录最大数量"
                }
            ]
        },
        "idle-timeout [parameter1] [parameter2]": {
            "template": "idle-timeout [parameter1] [parameter2]",
            "command": "idle-timeout 30 0",
            "explanation": "设置VTY用户界面的空闲超时时间为30分钟0秒",
            "parameters": [
                {
                    "name": "minutes",
                    "type": "integer",
                    "explanation": "分钟"
                },
                {
                    "name": "seconds",
                    "type": "integer",
                    "explanation": "秒"
                }
            ]
        },
        "screen-length [parameter1]": {
            "template": "screen-length [parameter1]",
            "command": "screen-length 30",
            "explanation": "设置VTY用户界面的屏幕显示行数为30",
            "parameters": [
                {
                    "name": "screen length",
                    "type": "integer",
                    "explanation": "屏幕显示行数"
                }
            ]
        },
        "acl [parameter1] inbound": {
            "template": "acl [parameter1] inbound",
            "command": "acl 2000 inbound",
            "explanation": "应用ACL 2000到VTY用户界面的入方向",
            "parameters": [
                {
                    "name": "acl number",
                    "type": "integer",
                    "explanation": "ACL编号"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
