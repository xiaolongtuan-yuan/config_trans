{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device",
        "explanation": "设置设备的主机名为 'Device'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "arp speed-limit [parameter1] maximum [parameter2] slot [parameter3]": {
        "template": "arp speed-limit [parameter1] maximum [parameter2] slot [parameter3]",
        "command": "arp speed-limit destination-ip maximum 50 slot 1",
        "explanation": "设置ARP速度限制，目的地IP最大值为50，槽位1",
        "parameters": [
            {
                "name": "type",
                "type": "string",
                "explanation": "限制类型，这里是destination-ip"
            },
            {
                "name": "maximum value",
                "type": "integer",
                "explanation": "最大值"
            },
            {
                "name": "slot",
                "type": "integer",
                "explanation": "槽位号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置指定接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "arp learning [parameter1] [parameter2]": {
            "template": "arp learning [parameter1] [parameter2]",
            "command": "arp learning strict force-enable",
            "explanation": "设置ARP学习模式为严格，并强制启用",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "学习模式，这里是strict"
                },
                {
                    "name": "force-enable",
                    "type": "boolean",
                    "explanation": "是否强制启用"
                }
            ]
        },
        "arp-limit maximum [parameter1]": {
            "template": "arp-limit maximum [parameter1]",
            "command": "arp-limit maximum 20",
            "explanation": "设置ARP条目最大限制为20",
            "parameters": [
                {
                    "name": "maximum value",
                    "type": "integer",
                    "explanation": "最大ARP条目数"
                }
            ]
        }
    }
}