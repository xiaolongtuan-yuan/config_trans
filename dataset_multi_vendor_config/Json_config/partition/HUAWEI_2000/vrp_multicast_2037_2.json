                "explanation": "ACL编号"
            }
        ],
        "rule [parameter1] permit source [parameter2]": {
            "template": "rule [parameter1] permit source [parameter2]",
            "command": "rule 0 permit source FF3E::1/64",
            "explanation": "允许源地址为FF3E::1/64的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
