            "template": "pim ipv6 sm",
            "command": "pim ipv6 sm",
            "explanation": "在接口上启用IPv6 PIM稀疏模式",
            "parameters": []
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "OSPFv3 process ID",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        },
        "mld enable": {
            "template": "mld enable",
            "command": "mld enable",
            "explanation": "在接口上启用MLD",
            "parameters": []
        }
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "进入OSPFv3进程1的配置模式",
        "parameters": [
            {
                "name": "OSPFv3 process ID",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
