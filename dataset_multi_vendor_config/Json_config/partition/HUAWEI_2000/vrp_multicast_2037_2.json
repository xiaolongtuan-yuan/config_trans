    "pim-ipv6": {
        "template": "pim-ipv6",
        "command": "pim-ipv6",
        "explanation": "进入IPv6 PIM配置模式",
        "parameters": [],
        "ssm-policy [parameter1]": {
            "template": "ssm-policy [parameter1]",
            "command": "ssm-policy 2000",
            "explanation": "应用编号为2000的SSM策略",
            "parameters": [
                {
                    "name": "ACL number",
                    "type": "integer",
                    "explanation": "ACL编号"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
