{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Switch2",
        "explanation": "设置设备的主机名为 'Switch2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "批量创建VLAN，这里创建了VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "进入接口GigabitEthernet2/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "设置接口的默认VLAN为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "配置接口允许通过VLAN 10的流量",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}