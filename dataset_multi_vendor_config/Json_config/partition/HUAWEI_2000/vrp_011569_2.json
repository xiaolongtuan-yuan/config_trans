{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "批量创建VLAN，这里创建VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM（连通性故障管理）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口配置为交换模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "允许 trunk 端口传输指定的VLAN，这里是VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md1 level 6",
        "explanation": "配置CFM域，域名为md1，级别为6",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "CFM域名称"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "CFM级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "配置维护关联，名称为ma1",
            "parameters": [
                {
                    "name": "maintenance association name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "map vlan [parameter1]": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 10",
                "explanation": "将VLAN 10映射到维护关联",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 1 interface GigabitEthernet1/0/1 outward",
                "explanation": "配置MEP，MEP ID为1，接口为GigabitEthernet1/0/1，方向为outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识符"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向，如inward或outward"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 1 enable",
                "explanation": "启用MEP ID 1的CCM发送",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识符"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 2",
                "explanation": "配置远程MEP，MEP ID为2",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识符"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 2 enable",
                "explanation": "启用远程MEP ID 2的CCM接收",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识符"
                    }
                ]
            }
        }
    }
}