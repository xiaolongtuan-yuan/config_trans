{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 20",
        "explanation": "创建或进入桥域20的配置模式",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif20",
        "explanation": "进入Vbdif20接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.12 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.2.12，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        }
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/0.1 mode l2",
        "explanation": "进入GigabitEthernet1/0/0.1接口的配置模式，并设置为二层模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 20",
            "explanation": "配置接口的封装类型为dot1q，并指定VLAN ID为20",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "rewrite pop [parameter1]": {
            "template": "rewrite pop [parameter1]",
            "command": "rewrite pop single",
            "explanation": "配置接口的标签操作为弹出单个标签",
            "parameters": [
                {
                    "name": "operation",
                    "type": "string",
                    "explanation": "标签操作"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 20",
            "explanation": "将接口加入到桥域20",
            "parameters": [
                {
                    "name": "bridge-domain id",
                    "type": "integer",
                    "explanation": "桥域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}