{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname SSH_Server",
        "explanation": "设置设备的主机名为 'SSH_Server'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip domain-name [parameter1]": {
        "template": "ip domain-name [parameter1]",
        "command": "ip domain-name example.com",
        "explanation": "设置域名",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名"
            }
        ]
    },
    "rsa local-key-pair create": {
        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "创建本地RSA密钥对",
        "parameters": []
    },
    "[parameter1]": {
        "template": "[parameter1]",
        "command": "2048",
        "explanation": "指定密钥长度为2048位",
        "parameters": [
            {
                "name": "key length",
                "type": "integer",
                "explanation": "RSA密钥的长度"
            }
        ]
    },
    "ssh server enable": {
        "template": "ssh server enable",
        "command": "ssh server enable",
        "explanation": "启用SSH服务器",
        "parameters": []
    },
    "ssh server compatibility enable": {
        "template": "ssh server compatibility enable",
        "command": "ssh server compatibility enable",
        "explanation": "启用SSH服务器兼容性模式",
        "parameters": []
    },
    "ssh server version [parameter1]": {
        "template": "ssh server version [parameter1]",
        "command": "ssh server version 2",
        "explanation": "设置SSH服务器版本为2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "SSH协议版本"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface LoopBack0",
        "explanation": "进入LoopBack0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.255",
            "explanation": "配置接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "ssh server cipher [parameter1] [parameter2] [parameter3]": {
        "template": "ssh server cipher [parameter1] [parameter2] [parameter3]",
        "command": "ssh server cipher aes128-ctr aes192-ctr aes256-ctr",
        "explanation": "配置SSH服务器使用的加密算法",
        "parameters": [
            {
                "name": "cipher algorithms",
                "type": "list of strings",
                "explanation": "加密算法列表"
            }
        ]
    },
    "aaa": {
        "template": "aaa",
        "command": "aaa",
        "explanation": "进入AAA配置模式",
        "parameters": []
    },
    "local-user [parameter1] password irreversible-cipher [parameter2]": {
        "template": "local-user [parameter1] password irreversible-cipher [parameter2]",
        "command": "local-user client001 password irreversible-cipher @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "创建本地用户client001并设置不可逆密码",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "local-user [parameter1] privilege level [parameter2]": {
        "template": "local-user [parameter1] privilege level [parameter2]",
        "command": "local-user client001 privilege level 15",
        "explanation": "设置用户client001的权限级别为15",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "privilege level",
                "type": "integer",
                "explanation": "权限级别"
            }
        ]
    },
    "local-user [parameter1] service-type ssh": {
        "template": "local-user [parameter1] service-type ssh",
        "command": "local-user client001 service-type ssh",
        "explanation": "设置用户client001的服务类型为SSH",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            }
        ]
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "进入VTTY用户界面配置模式，范围从0到4",
        "parameters": [
            {
                "name": "start vty line",
                "type": "integer",
                "explanation": "起始VTTY线路"
            },
            {
                "name": "end vty line",
                "type": "integer",
                "explanation": "结束VTTY线路"
            }
        ],
        "authentication-mode aaa": {
            "template": "authentication-mode aaa",
            "command": "authentication-mode aaa",
            "explanation": "设置认证模式为AAA",
            "parameters": []
        },
        "protocol inbound ssh": {
            "template": "protocol inbound ssh",
            "command": "protocol inbound ssh",
            "explanation": "设置允许的传入协议为SSH",
            "parameters": []
        }
    }
}