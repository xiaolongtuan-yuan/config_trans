{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置特定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/1.1 mode l2",
        "explanation": "配置子接口并设置模式为L2",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "模式类型（L2）"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "设置封装类型为dot1q，并配置VLAN ID为10",
            "parameters": [
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将接口关联到桥接域10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域ID"
                }
            ]
        },
        "rewrite map [parameter1] vid [parameter2]": {
            "template": "rewrite map [parameter1] vid [parameter2]",
            "command": "rewrite map 1-to-1 vid 10",
            "explanation": "配置重写映射，将VLAN ID从1映射到10",
            "parameters": [
                {
                    "name": "map name",
                    "type": "string",
                    "explanation": "映射名称"
                },
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一层配置模式",
        "parameters": []
    }
}