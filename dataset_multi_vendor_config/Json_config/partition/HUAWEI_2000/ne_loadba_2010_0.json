{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerA",
        "explanation": "设置设备的主机名为 'routerA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "load-balance unequal-cost enable": {
        "template": "load-balance unequal-cost enable",
        "command": "load-balance unequal-cost enable",
        "explanation": "启用不等价负载均衡",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1",
        "explanation": "进入 Eth-Trunk1 接口视图",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.40.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 1",
            "explanation": "将接口加入 Eth-Trunk1",
            "parameters": [
                {
                    "name": "eth-trunk number",
                    "type": "integer",
                    "explanation": "Eth-Trunk组号"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route-static 10.20.1.0 255.255.255.0 GigabitEthernet2/0/0 10.30.1.2",
        "explanation": "配置静态路由，目标网络 10.20.1.0/24，出接口 GigabitEthernet2/0/0，下一跳地址 10.30.1.2",
        "parameters": [
            {
                "name": "destination ip",
                "type": "IPv4",
                "explanation": "目标网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop ip",
                "type": "IPv4",
                "explanation": "下一跳IP地址"
            }
        ]
    }
}