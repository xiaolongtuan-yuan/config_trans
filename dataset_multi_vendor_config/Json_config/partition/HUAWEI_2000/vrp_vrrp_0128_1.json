{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入IS-IS进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-1",
            "explanation": "配置IS-IS进程的级别为level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS级别，可以是level-1、level-2或level-1-2"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 20.0000.0000.0001.00",
            "explanation": "配置IS-IS的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题，用于唯一标识一个IS-IS进程"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp vrid [parameter1] virtual-ip [parameter2]": {
            "template": "vrrp vrid [parameter1] virtual-ip [parameter2]",
            "command": "vrrp vrid 1 virtual-ip 10.1.1.10",
            "explanation": "配置VRRP虚拟路由器ID为1，虚拟IP地址为10.1.1.10",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv4",
                    "explanation": "虚拟IP地址"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}