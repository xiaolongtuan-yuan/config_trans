{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "undo ntp-service server disable": {
        "template": "undo ntp-service server disable",
        "command": "undo ntp-service server disable",
        "explanation": "启用NTP服务器功能",
        "parameters": []
    },
    "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]": {
        "template": "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]",
        "command": "ntp-service authentication-keyid 42 authentication-mode hmac-sha256 cipher %#%#JA!v6M22=Gg\\{>U.lx%#)c%yY}0*\"/`5mi><QS)L%#%#",
        "explanation": "配置NTP认证密钥ID为42，认证模式为HMAC-SHA256，并设置加密密码",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "认证密钥ID"
            },
            {
                "name": "authentication mode",
                "type": "string",
                "explanation": "认证模式"
            },
            {
                "name": "cipher password",
                "type": "string",
                "explanation": "加密密码"
            }
        ]
    },
    "ntp-service refclock-master [parameter1]": {
        "template": "ntp-service refclock-master [parameter1]",
        "command": "ntp-service refclock-master 2",
        "explanation": "配置NTP参考时钟为主时钟，层级为2",
        "parameters": [
            {
                "name": "stratum",
                "type": "integer",
                "explanation": "时钟层级"
            }
        ]
    },
    "ntp-service authentication enable": {
        "template": "ntp-service authentication enable",
        "command": "ntp-service authentication enable",
        "explanation": "启用NTP认证功能",
        "parameters": []
    },
    "ntp-service server source-interface [parameter1]": {
        "template": "ntp-service server source-interface [parameter1]",
        "command": "ntp-service server source-interface gigabitethernet 1/0/0",
        "explanation": "配置NTP服务器的源接口为GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 2.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 2.2.2.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络2.2.2.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}