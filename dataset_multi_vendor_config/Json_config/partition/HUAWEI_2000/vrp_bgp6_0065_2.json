{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "进入接口 GigabitEthernet2/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:9:2::1/64",
            "explanation": "配置接口的IPv6地址为 2001:db8:9:2::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址及前缀长度"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65009",
        "explanation": "进入BGP配置模式，AS号为65009",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
            "explanation": "配置BGP的Router ID为3.3.3.3",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "BGP路由器的ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:db8:9:2::2 as-number 65009",
            "explanation": "配置BGP对等体，IPv6地址为2001:db8:9:2::2，AS号为65009",
            "parameters": [
                {
                    "name": "peer ipv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的自治系统号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            }
        },
        "ipv6-family unicast": {
            "template": "ipv6-family unicast",
            "command": "ipv6-family unicast",
            "explanation": "进入IPv6单播地址族配置模式",
            "parameters": [],
            "network [parameter1]": {
                "template": "network [parameter1]",
                "command": "network 2001:db8:9:2:: 64",
                "explanation": "在BGP中通告IPv6网络2001:db8:9:2::/64",
                "parameters": [
                    {
                        "name": "ipv6 network",
                        "type": "IPv6",
                        "explanation": "IPv6网络地址及前缀长度"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 2001:db8:9:2::2 enable",
                "explanation": "启用与对等体2001:db8:9:2::2的IPv6单播地址族通信",
                "parameters": [
                    {
                        "name": "peer ipv6 address",
                        "type": "IPv6",
                        "explanation": "对等体的IPv6地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图并返回到用户视图",
        "parameters": []
    }
}