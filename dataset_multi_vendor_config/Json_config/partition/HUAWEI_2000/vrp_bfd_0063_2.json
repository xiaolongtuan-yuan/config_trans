{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.2.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.1.1.0 255.255.255.0 10.2.1.1",
        "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳地址为 10.2.1.1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "bfd [parameter1] bind peer-ip [parameter2]": {
        "template": "bfd [parameter1] bind peer-ip [parameter2]",
        "command": "bfd ctoa bind peer-ip 10.1.1.1",
        "explanation": "配置BFD会话，绑定对端IP地址为 10.1.1.1",
        "parameters": [
            {
                "name": "session name",
                "type": "string",
                "explanation": "会话名称"
            },
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            }
        ],
        "discriminator local [parameter1]": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 20",
            "explanation": "配置本地BFD会话的标识符为20",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地标识符"
                }
            ]
        },
        "discriminator remote [parameter1]": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 10",
            "explanation": "配置远端BFD会话的标识符为10",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}