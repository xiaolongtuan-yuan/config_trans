{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname HUAWEI",
        "explanation": "设置设备的主机名为 'HUAWEI'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "multicast ipv6 routing-enable": {
        "template": "multicast ipv6 routing-enable",
        "command": "multicast ipv6 routing-enable",
        "explanation": "启用IPv6组播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1] [parameter2]": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8:7::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:7::2，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "encapsulation qinq-termination": {
            "template": "encapsulation qinq-termination",
            "command": "encapsulation qinq-termination",
            "explanation": "配置接口为QinQ终结模式",
            "parameters": []
        },
        "qinq termination pe-vid [parameter1] to [parameter2] ce-vid [parameter3] to [parameter4]": {
            "template": "qinq termination pe-vid [parameter1] to [parameter2] ce-vid [parameter3] to [parameter4]",
            "command": "qinq termination pe-vid 1 to 4 ce-vid 1 to 4",
            "explanation": "配置QinQ终结的PE VLAN ID范围为1到4，CE VLAN ID范围为1到4",
            "parameters": [
                {
                    "name": "pe-vid start",
                    "type": "integer",
                    "explanation": "PE VLAN ID起始值"
                },
                {
                    "name": "pe-vid end",
                    "type": "integer",
                    "explanation": "PE VLAN ID结束值"
                },
                {
                    "name": "ce-vid start",
                    "type": "integer",
                    "explanation": "CE VLAN ID起始值"
                },
                {
                    "name": "ce-vid end",
                    "type": "integer",
                    "explanation": "CE VLAN ID结束值"
                }
            ]
        },
        "pim ipv6 sm": {
            "template": "pim ipv6 sm",
            "command": "pim ipv6 sm",
            "explanation": "在接口上启用IPv6 PIM SM（稀疏模式）",
            "parameters": []
        },
        "mld enable": {
            "template": "mld enable",
            "command": "mld enable",
            "explanation": "在接口上启用MLD（组播侦听发现）",
            "parameters": []
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static 2001:db8:5:: 64 2001:db8:6::2",
        "explanation": "配置静态IPv6路由，目的地址为2001:db8:5::，前缀长度为64，下一跳地址为2001:db8:6::2",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳IPv6地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}