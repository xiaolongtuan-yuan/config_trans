{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "lldp enable": {
        "template": "lldp enable",
        "command": "lldp enable",
        "explanation": "启用LLDP（链路层发现协议）功能",
        "parameters": []
    },
    "lldp message-transmission interval [parameter1]": {
        "template": "lldp message-transmission interval [parameter1]",
        "command": "lldp message-transmission interval 60",
        "explanation": "设置LLDP消息的发送间隔为60秒",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "发送间隔时间，单位为秒"
            }
        ]
    },
    "lldp message-transmission delay [parameter1]": {
        "template": "lldp message-transmission delay [parameter1]",
        "command": "lldp message-transmission delay 9",
        "explanation": "设置LLDP消息的发送延迟为9秒",
        "parameters": [
            {
                "name": "delay",
                "type": "integer",
                "explanation": "发送延迟时间，单位为秒"
            }
        ]
    },
    "lldp restart-delay [parameter1]": {
        "template": "lldp restart-delay [parameter1]",
        "command": "lldp restart-delay 3",
        "explanation": "设置LLDP重启延迟为3秒",
        "parameters": [
            {
                "name": "restart-delay",
                "type": "integer",
                "explanation": "重启延迟时间，单位为秒"
            }
        ]
    },
    "lldp fast-count [parameter1]": {
        "template": "lldp fast-count [parameter1]",
        "command": "lldp fast-count 3",
        "explanation": "设置LLDP快速发送次数为3次",
        "parameters": [
            {
                "name": "fast-count",
                "type": "integer",
                "explanation": "快速发送次数"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.10.10.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "lldp management-address [parameter1]": {
            "template": "lldp management-address [parameter1]",
            "command": "lldp management-address 10.10.10.1",
            "explanation": "设置LLDP管理地址为10.10.10.1",
            "parameters": [
                {
                    "name": "management-address",
                    "type": "IPv4",
                    "explanation": "管理地址"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
