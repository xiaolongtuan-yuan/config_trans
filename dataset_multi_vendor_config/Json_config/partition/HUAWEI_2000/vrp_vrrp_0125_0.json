{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp vrid [parameter1] virtual-ip [parameter2]": {
            "template": "vrrp vrid [parameter1] virtual-ip [parameter2]",
            "command": "vrrp vrid 1 virtual-ip 10.1.1.111",
            "explanation": "配置VRRP虚拟路由器的虚拟IP地址为10.1.1.111",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "VRRP虚拟路由器ID"
                },
                {
                    "name": "virtual-ip",
                    "type": "IPv4",
                    "explanation": "虚拟IP地址"
                }
            ]
        },
        "vrrp vrid [parameter1] priority [parameter2]": {
            "template": "vrrp vrid [parameter1] priority [parameter2]",
            "command": "vrrp vrid 1 priority 120",
            "explanation": "配置VRRP虚拟路由器的优先级为120",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "VRRP虚拟路由器ID"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "vrrp vrid [parameter1] track interface [parameter2] reduced [parameter3]": {
            "template": "vrrp vrid [parameter1] track interface [parameter2] reduced [parameter3]",
            "command": "vrrp vrid 1 track interface gigabitethernet 2/0/0 reduced 30",
            "explanation": "配置VRRP虚拟路由器跟踪接口gigabitethernet 2/0/0的状态，如果接口状态变为down，优先级减少30",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "VRRP虚拟路由器ID"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                },
                {
                    "name": "reduced",
                    "type": "integer",
                    "explanation": "优先级减少的值"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.1.0/24",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}