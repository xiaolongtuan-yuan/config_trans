{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device2",
        "explanation": "设置设备的主机名为 'Device2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥域10的配置模式",
        "parameters": [
            {
                "name": "bridge-domain ID",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ],
        "vxlan vni [parameter1]": {
            "template": "vxlan vni [parameter1]",
            "command": "vxlan vni 5010",
            "explanation": "配置桥域10的VXLAN网络标识符为5010",
            "parameters": [
                {
                    "name": "VXLAN Network Identifier",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif10",
        "explanation": "进入Vbdif10接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.10 255.255.255.0",
            "explanation": "配置Vbdif10接口的IPv4地址为192.168.10.10，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 3.3.3.3",
            "explanation": "配置Nve1接口的源IP地址为3.3.3.3",
            "parameters": [
                {
                    "name": "source IP address",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                }
            ]
        },
        "vni [parameter1] head-end peer-list [parameter2]": {
            "template": "vni [parameter1] head-end peer-list [parameter2]",
            "command": "vni 5010 head-end peer-list 2.2.2.2",
            "explanation": "配置Nve1接口的VXLAN网络标识符5010的头部复制列表为2.2.2.2",
            "parameters": [
                {
                    "name": "VXLAN Network Identifier",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符"
                },
                {
                    "name": "peer IP address",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0的配置模式",
            "parameters": [
                {
                    "name": "OSPF area ID",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 3.3.3.3 0.0.0.0",
                "explanation": "在OSPF区域0中宣告网络3.3.3.3/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}