{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "批量创建VLAN，这里创建了VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "mac-address aging-time [parameter1]": {
        "template": "mac-address aging-time [parameter1]",
        "command": "mac-address aging-time 500",
        "explanation": "设置MAC地址老化时间为500秒",
        "parameters": [
            {
                "name": "aging time",
                "type": "integer",
                "explanation": "老化时间，单位为秒"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 2",
            "explanation": "设置接口的默认VLAN为2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "mac-address static [parameter1] [parameter2] [parameter3]": {
        "template": "mac-address static [parameter1] [parameter2] [parameter3]",
        "command": "mac-address static 00e0-fc12-3458 GigabitEthernet1/0/1 vlan 2",
        "explanation": "静态绑定MAC地址00e0-fc12-3458到接口GigabitEthernet1/0/1的VLAN 2",
        "parameters": [
            {
                "name": "mac address",
                "type": "MAC",
                "explanation": "MAC地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}