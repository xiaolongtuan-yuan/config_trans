                "explanation": "配置操作码::100为结束操作码",
                "parameters": [
                    {
                        "name": "opcode",
                        "type": "IPv6",
                        "explanation": "操作码"
                    }
                ]
            },
            "opcode [parameter1] end no-psp": {
                "template": "opcode [parameter1] end no-psp",
                "command": "opcode ::200 end no-psp",
                "explanation": "配置操作码::200为结束操作码，且不使用PSP（Penultimate Segment Pop）",
                "parameters": [
                    {
                        "name": "opcode",
                        "type": "IPv6",
                        "explanation": "操作码"
                    }
                ]
            }
        }
    },
