            "parameters": [
                {
                    "name": "locator name",
                    "type": "string",
                    "explanation": "定位器名称"
                },
                {
                    "name": "IPv6 prefix",
                    "type": "IPv6",
                    "explanation": "IPv6前缀"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                },
                {
                    "name": "static SID range",
                    "type": "integer",
                    "explanation": "静态SID范围"
                }
            ],
            "opcode [parameter1] end": {
                "template": "opcode [parameter1] end",
