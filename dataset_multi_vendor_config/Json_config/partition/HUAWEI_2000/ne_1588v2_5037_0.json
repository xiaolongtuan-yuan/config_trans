{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp-adaptive enable": {
        "template": "ptp-adaptive enable",
        "command": "ptp-adaptive enable",
        "explanation": "启用 PTP 自适应功能",
        "parameters": []
    },
    "ptp-adaptive device-type [parameter1]": {
        "template": "ptp-adaptive device-type [parameter1]",
        "command": "ptp-adaptive device-type server",
        "explanation": "设置设备类型为服务器",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "设备类型，如 'server' 或 'client'"
            }
        ]
    },
    "ptp-adaptive local-ip [parameter1]": {
        "template": "ptp-adaptive local-ip [parameter1]",
        "command": "ptp-adaptive local-ip 1.1.1.1",
        "explanation": "设置本地 IP 地址为 1.1.1.1",
        "parameters": [
            {
                "name": "local IP",
                "type": "IPv4",
                "explanation": "本地 IP 地址"
            }
        ]
    },
    "ptp-adaptive acr unicast-negotiate enable": {
        "template": "ptp-adaptive acr unicast-negotiate enable",
        "command": "ptp-adaptive acr unicast-negotiate enable",
        "explanation": "启用 PTP ACR 单播协商功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "进入 Loopback0 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称，如 'Loopback0'"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}