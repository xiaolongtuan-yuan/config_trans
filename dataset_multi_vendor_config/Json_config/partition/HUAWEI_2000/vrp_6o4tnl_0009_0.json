{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置指定的接口，这里是 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.50.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.50.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8::1/64",
            "explanation": "配置接口的IPv6地址为 2001:db8::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol ipv6-ipv4",
            "explanation": "设置隧道的协议为 IPv6 over IPv4",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "隧道协议类型"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 192.168.50.2",
            "explanation": "设置隧道的源IP地址为 192.168.50.2",
            "parameters": [
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 192.168.51.2",
            "explanation": "设置隧道的目的IP地址为 192.168.51.2",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目的IP地址"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 192.168.51.0 255.255.255.0 192.168.50.1",
        "explanation": "配置静态路由，目标网络 192.168.51.0/24，下一跳地址 192.168.50.1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目标网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳IP地址"
            }
        ]
    }
}