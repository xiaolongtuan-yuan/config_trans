{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD（双向转发检测）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.10.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route-static bfd [parameter1] local-address [parameter2]": {
        "template": "ip route-static bfd [parameter1] local-address [parameter2]",
        "command": "ip route-static bfd 10.10.1.2 local-address 10.10.1.1",
        "explanation": "配置静态路由BFD会话，对端地址为10.10.1.2，本地地址为10.10.1.1",
        "parameters": [
            {
                "name": "peer address",
                "type": "IPv4",
                "explanation": "对端地址"
            },
            {
                "name": "local address",
                "type": "IPv4",
                "explanation": "本地地址"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3] bfd enable": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] bfd enable",
        "command": "ip route-static 2.2.2.2 32 10.10.1.2 bfd enable",
        "explanation": "配置静态路由，目的地址为2.2.2.2/32，下一跳为10.10.1.2，并启用BFD检测",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
}