{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "启用OSPFv3进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
            "explanation": "设置OSPFv3进程1的路由器ID为3.3.3.3",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "import-route static cost [parameter1]": {
            "template": "import-route static cost [parameter1]",
            "command": "import-route static cost 20",
            "explanation": "导入静态路由到OSPFv3进程1，并设置开销为20",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "路由开销"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPFv3进程1的区域为0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:6::1/64",
            "explanation": "配置接口的IPv6地址为2001:db8:6::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ipv6 route-static 2001:db8:7:: 64 GigabitEthernet1/0/0 2001:db8:6::2",
        "explanation": "配置静态IPv6路由，目的地址为2001:db8:7::/64，出接口为GigabitEthernet1/0/0，下一跳地址为2001:db8:6::2",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}