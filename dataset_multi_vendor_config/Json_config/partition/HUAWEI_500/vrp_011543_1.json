{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [vlan-id]": {
        "template": "vlan [vlan-id]",
        "command": "vlan 2",
        "explanation": "创建或配置VLAN 2",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm version [version]": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准版",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "版本名称"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置GigabitEthernet1/0/1接口",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "允许接口进行二层交换",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port trunk allow-pass vlan [vlan-id]": {
            "template": "port trunk allow-pass vlan [vlan-id]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2通过该trunk接口",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [md-name]": {
        "template": "cfm md [md-name]",
        "command": "cfm md md3",
        "explanation": "配置MD md3",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "维护域名称"
            }
        ],
        "ma [ma-name]": {
            "template": "ma [ma-name]",
            "command": "ma ma3",
            "explanation": "配置MA ma3",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "map vlan [vlan-id]": {
                "template": "map vlan [vlan-id]",
                "command": "map vlan 2",
                "explanation": "将MA映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [mep-id] interface [interface-name] [direction]": {
                "template": "mep mep-id [mep-id] interface [interface-name] [direction]",
                "command": "mep mep-id 4 interface GigabitEthernet1/0/1 outward",
                "explanation": "配置MEP ID 4在接口GigabitEthernet1/0/1上，方向为outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向，如inward或outward"
                    }
                ]
            },
            "mep ccm-send mep-id [mep-id] enable": {
                "template": "mep ccm-send mep-id [mep-id] enable",
                "command": "mep ccm-send mep-id 4 enable",
                "explanation": "启用MEP ID 4发送CCM",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id [mep-id]": {
                "template": "remote-mep mep-id [mep-id]",
                "command": "remote-mep mep-id 3",
                "explanation": "配置远程MEP ID 3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [mep-id] enable": {
                "template": "remote-mep ccm-receive mep-id [mep-id] enable",
                "command": "remote-mep ccm-receive mep-id 3 enable",
                "explanation": "启用接收远程MEP ID 3的CCM",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "test-id [test-id] mep [mep-id]": {
                "template": "test-id [test-id] mep [mep-id]",
                "command": "test-id 1 mep 4",
                "explanation": "配置测试ID 1，MEP ID 4",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "delay-measure two-way receive test-id [test-id]": {
                "template": "delay-measure two-way receive test-id [test-id]",
                "command": "delay-measure two-way receive test-id 1",
                "explanation": "配置延迟测量，双向接收，测试ID 1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            },
            "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]": {
                "template": "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]",
                "command": "test-id 2 mep 4 remote-mep 3",
                "explanation": "配置测试ID 2，MEP ID 4，远程MEP ID 3",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "remote-mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "delay-measure two-way continual send test-id [test-id] interval [interval]": {
                "template": "delay-measure two-way continual send test-id [test-id] interval [interval]",
                "command": "delay-measure two-way continual send test-id 2 interval 1000",
                "explanation": "配置延迟测量，双向连续发送，测试ID 2，间隔1000毫秒",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "间隔时间，单位毫秒"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一级配置模式",
        "parameters": []
    }
}