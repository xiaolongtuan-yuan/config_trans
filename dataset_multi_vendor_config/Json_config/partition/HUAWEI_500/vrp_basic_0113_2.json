{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname client002",
        "explanation": "设置设备的主机名为 'client002'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [interface_name]": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "进入 GigabitEthernet0/0/0 接口配置模式",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [ip_address] [subnet_mask]": {
            "template": "ip address [ip_address] [subnet_mask]",
            "command": "ip address 10.1.3.3 255.255.0.0",
            "explanation": "配置接口的IPv4地址为10.1.3.3，子网掩码为255.255.0.0",
            "parameters": [
                {
                    "name": "ip_address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet_mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "rsa local-key-pair create": {
        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "创建本地RSA密钥对",
        "parameters": []
    },
    "ssh version [version]": {
        "template": "ssh version [version]",
        "command": "ssh version 2",
        "explanation": "设置SSH协议版本为2",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "SSH版本"
            }
        ]
    },
    "ssh client enable": {
        "template": "ssh client enable",
        "command": "ssh client enable",
        "explanation": "启用SSH客户端功能",
        "parameters": []
    },
    "ssh client first-time enable": {
        "template": "ssh client first-time enable",
        "command": "ssh client first-time enable",
        "explanation": "允许SSH客户端在第一次连接时启用",
        "parameters": []
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一层配置模式",
        "parameters": []
    }
}