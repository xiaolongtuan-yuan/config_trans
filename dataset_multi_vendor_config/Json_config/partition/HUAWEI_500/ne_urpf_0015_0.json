{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerA",
        "explanation": "设置设备的主机名为 'routerA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.19.139.1 255.255.255.252",
            "explanation": "配置接口的IPv4地址为172.19.139.1，子网掩码为255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip urpf [parameter1] [parameter2]": {
            "template": "ip urpf [parameter1] [parameter2]",
            "command": "ip urpf strict allow-default",
            "explanation": "配置URPF（Unicast Reverse Path Forwarding）严格模式，并允许默认路由",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "URPF模式（strict）"
                },
                {
                    "name": "option",
                    "type": "string",
                    "explanation": "额外选项（allow-default）"
                }
            ]
        }
    }
}