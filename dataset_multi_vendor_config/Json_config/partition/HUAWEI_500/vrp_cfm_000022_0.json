{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] to [parameter2]": {
        "template": "vlan batch [parameter1] to [parameter2]",
        "command": "vlan batch 2 to 4",
        "explanation": "批量创建VLAN 2到VLAN 4",
        "parameters": [
            {
                "name": "start vlan id",
                "type": "integer",
                "explanation": "起始VLAN ID"
            },
            {
                "name": "end vlan id",
                "type": "integer",
                "explanation": "结束VLAN ID"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM（Connectivity Fault Management）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1] to [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] to [parameter2]",
            "command": "port trunk allow-pass vlan 2 to 4",
            "explanation": "允许VLAN 2到VLAN 4的流量通过该接口",
            "parameters": [
                {
                    "name": "start vlan id",
                    "type": "integer",
                    "explanation": "起始VLAN ID"
                },
                {
                    "name": "end vlan id",
                    "type": "integer",
                    "explanation": "结束VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md1 level 6",
        "explanation": "配置CFM维护域md1，级别为6",
        "parameters": [
            {
                "name": "maintenance domain name",
                "type": "string",
                "explanation": "维护域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "维护域级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "配置维护关联ma1",
            "parameters": [
                {
                    "name": "maintenance association name",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "map vlan [parameter1]": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 2",
                "explanation": "将维护关联ma1映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 1 interface gigabitethernet 1/0/1 inward",
                "explanation": "配置维护端点mep-id 1，接口为gigabitethernet 1/0/1，方向为inward",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 1 enable",
                "explanation": "启用维护端点mep-id 1的CCM发送功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点ID"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 2",
                "explanation": "配置远程维护端点mep-id 2",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 2 enable",
                "explanation": "启用远程维护端点mep-id 2的CCM接收功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
}