{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASG2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp enable": {
            "template": "set protocols ptp enable",
            "command": "set protocols ptp enable",
            "explanation": "启用PTP协议。",
            "parameters": []
        },
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 255",
            "explanation": "配置PTP协议的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP协议的域编号。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] clock-source [parameter2]": {
            "template": "set protocols ptp interface [parameter1] clock-source [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 clock-source internal",
            "explanation": "配置PTP接口的时钟源为内部。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "clock-source",
                    "type": "string",
                    "explanation": "时钟源类型，例如internal。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] clock-priority [parameter2]": {
            "template": "set protocols ptp interface [parameter1] clock-priority [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 clock-priority 1",
            "explanation": "配置PTP接口的时钟优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "clock-priority",
                    "type": "integer",
                    "explanation": "时钟优先级，数值越小优先级越高。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] domain [parameter2]": {
            "template": "set protocols ptp interface [parameter1] domain [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 domain 255",
            "explanation": "配置PTP接口的域。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP协议的域编号。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] enable": {
            "template": "set protocols ptp interface [parameter1] enable",
            "command": "set protocols ptp interface ge-0/0/0 enable",
            "explanation": "启用PTP接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] delay-mechanism [parameter2]": {
            "template": "set protocols ptp interface [parameter1] delay-mechanism [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 delay-mechanism delay",
            "explanation": "配置PTP接口的延迟机制。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "delay-mechanism",
                    "type": "string",
                    "explanation": "延迟机制类型，例如delay。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-0/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching port-mode access",
            "explanation": "配置接口的以太网交换模式和端口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如access。"
                }
            ]
        }
    }
}