{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan-2 vlan-id 2",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols cfm version [parameter1]": {
            "template": "set protocols cfm version [parameter1]",
            "command": "set protocols cfm version standard",
            "explanation": "配置CFM协议的版本为标准版本。",
            "parameters": [
                {
                    "name": "version",
                    "type": "string",
                    "explanation": "CFM协议的版本。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] direction [parameter6]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] direction [parameter6]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 direction outward",
            "explanation": "配置CFM域中关联的MEP方向为向外。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "MEP的方向，outward表示向外。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] ccm send [parameter6]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] ccm send [parameter6]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 ccm send enable",
            "explanation": "启用CFM域中关联的MEP的CCM发送功能。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "ccm-send",
                    "type": "string",
                    "explanation": "CCM发送功能的状态，enable表示启用。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] ccm receive [parameter6]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] ccm receive [parameter6]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 ccm receive enable",
            "explanation": "启用CFM域中关联的MEP的CCM接收功能。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "ccm-receive",
                    "type": "string",
                    "explanation": "CCM接收功能的状态，enable表示启用。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] remote-mep [parameter6]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] remote-mep [parameter6]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 remote-mep 4",
            "explanation": "配置CFM域中关联的MEP的远程MEP。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP的ID号。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] test-id [parameter6] local-mep [parameter7] remote-mep [parameter8]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] test-id [parameter6] local-mep [parameter7] remote-mep [parameter8]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 test-id 1 local-mep 3 remote-mep 4",
            "explanation": "配置CFM域中关联的MEP的测试ID，包括本地MEP和远程MEP。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID号。"
                },
                {
                    "name": "local-mep",
                    "type": "integer",
                    "explanation": "本地MEP的ID号。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP的ID号。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] test-id [parameter6] local-mep [parameter7]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] test-id [parameter6] local-mep [parameter7]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 test-id 2 local-mep 3",
            "explanation": "配置CFM域中关联的MEP的测试ID，包括本地MEP。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID号。"
                },
                {
                    "name": "local-mep",
                    "type": "integer",
                    "explanation": "本地MEP的ID号。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] delay-measurement test-id [parameter6] type [parameter7]": {
            "template": "set protocols cfm domain [parameter1] association [parameter2] vlan [parameter3] mep [parameter4] interface [parameter5] delay-measurement test-id [parameter6] type [parameter7]",
            "command": "set protocols cfm domain md3 association ma3 vlan 2 mep 3 interface ge-1/0/1 delay-measurement test-id 2 type two-way",
            "explanation": "配置CFM域中关联的MEP的延迟测量类型为双向。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "association",
                    "type": "string",
                    "explanation": "CFM关联的名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID号。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "延迟测量的类型，two-way表示双向。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口的以太网交换端口模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，trunk表示中继模式。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan-2",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员名称。"
                }
            ]
        }
    }
