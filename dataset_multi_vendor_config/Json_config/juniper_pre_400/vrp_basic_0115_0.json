{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system domain-name [parameter1]": {
            "template": "set system domain-name [parameter1]",
            "command": "set system domain-name example.com",
            "explanation": "配置设备的域名。",
            "parameters": [
                {
                    "name": "domain-name",
                    "type": "string",
                    "explanation": "设备的域名。"
                }
            ]
        },
        "set system services ssh": {
            "template": "set system services ssh",
            "command": "set system services ssh",
            "explanation": "启用SSH服务。",
            "parameters": []
        },
        "set system services ssh protocol-version [parameter1]": {
            "template": "set system services ssh protocol-version [parameter1]",
            "command": "set system services ssh protocol-version v2",
            "explanation": "配置SSH服务的协议版本。",
            "parameters": [
                {
                    "name": "protocol-version",
                    "type": "string",
                    "explanation": "SSH协议版本，例如v2。"
                }
            ]
        },
        "set system services ssh client-algorithms encryption [parameter1] [parameter2] [parameter3]": {
            "template": "set system services ssh client-algorithms encryption [parameter1] [parameter2] [parameter3]",
            "command": "set system services ssh client-algorithms encryption aes128-ctr aes192-ctr aes256-ctr",
            "explanation": "配置SSH客户端加密算法。",
            "parameters": [
                {
                    "name": "encryption-algorithms",
                    "type": "list",
                    "explanation": "SSH客户端支持的加密算法列表。"
                }
            ]
        },
        "set system services ssh client-algorithms mac [parameter1] [parameter2]": {
            "template": "set system services ssh client-algorithms mac [parameter1] [parameter2]",
            "command": "set system services ssh client-algorithms mac hmac-sha1 hmac-sha1-96",
            "explanation": "配置SSH客户端MAC算法。",
            "parameters": [
                {
                    "name": "mac-algorithms",
                    "type": "list",
                    "explanation": "SSH客户端支持的MAC算法列表。"
                }
            ]
        },
        "set system services ssh client-algorithms kex [parameter1]": {
            "template": "set system services ssh client-algorithms kex [parameter1]",
            "command": "set system services ssh client-algorithms kex dh-group14-sha1",
            "explanation": "配置SSH客户端密钥交换算法。",
            "parameters": [
                {
                    "name": "kex-algorithm",
                    "type": "string",
                    "explanation": "SSH客户端支持的密钥交换算法。"
                }
            ]
        },
        "set system services ssh client-algorithms host-key [parameter1]": {
            "template": "set system services ssh client-algorithms host-key [parameter1]",
            "command": "set system services ssh client-algorithms host-key ssh-rsa",
            "explanation": "配置SSH客户端主机密钥算法。",
            "parameters": [
                {
                    "name": "host-key-algorithm",
                    "type": "string",
                    "explanation": "SSH客户端支持的主机密钥算法。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2]": {
            "template": "set system login user [parameter1] class [parameter2]",
            "command": "set system login user client001 class super-user",
            "explanation": "配置用户登录类别。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户类别，例如super-user。"
                }
            ]
        },
        "set system login user [parameter1] authentication plain-text-password [parameter2]": {
            "template": "set system login user [parameter1] authentication plain-text-password [parameter2]",
            "command": "set system login user client001 authentication plain-text-password \"@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%\"",
            "explanation": "配置用户认证密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "用户的认证密码。"
                }
            ]
        },
        "set system services ftp": {
            "template": "set system services ftp",
            "command": "set system services ftp",
            "explanation": "启用FTP服务。",
            "parameters": []
        },
        "set system services ssh root-login [parameter1]": {
            "template": "set system services ssh root-login [parameter1]",
            "command": "set system services ssh root-login deny",
            "explanation": "禁止root用户通过SSH登录。",
            "parameters": [
                {
                    "name": "root-login",
                    "type": "string",
                    "explanation": "root用户登录权限，例如deny。"
                }
            ]
        },
        "set system services telnet [parameter1]": {
            "template": "set system services telnet [parameter1]",
            "command": "set system services telnet disable",
            "explanation": "禁用Telnet服务。",
            "parameters": [
                {
                    "name": "telnet-service",
                    "type": "string",
                    "explanation": "Telnet服务状态，例如disable。"
                }
            ]
        },
        "set system services ssh max-sessions-per-connection [parameter1]": {
            "template": "set system services ssh max-sessions-per-connection [parameter1]",
            "command": "set system services ssh max-sessions-per-connection 4",
            "explanation": "配置每个SSH连接的最大会话数。",
            "parameters": [
                {
                    "name": "max-sessions",
                    "type": "integer",
                    "explanation": "每个SSH连接允许的最大会话数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 10.1.1.1/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group BGP-GROUP type external",
            "explanation": "配置BGP组的类型。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-as [parameter2]",
            "command": "set protocols bgp group BGP-GROUP local-as 65410",
            "explanation": "配置BGP组的本地AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group BGP-GROUP neighbor 10.1.1.2 peer-as 100",
            "explanation": "配置BGP邻居的AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family inet [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family inet [parameter3]",
            "command": "set protocols bgp group BGP-GROUP neighbor 10.1.1.2 family inet unicast",
            "explanation": "配置BGP邻居的地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族，例如inet unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] local-address [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] local-address [parameter3]",
            "command": "set protocols bgp group BGP-GROUP neighbor 10.1.1.2 local-address 10.1.1.1",
            "explanation": "配置BGP邻居的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] export [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] export [parameter3]",
            "command": "set protocols bgp group BGP-GROUP neighbor 10.1.1.2 export NEXT-HOP-SELF",
            "explanation": "配置BGP邻居的导出策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        }
    }
}