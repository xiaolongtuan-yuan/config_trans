{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name NPE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-protocol [parameter1]": {
            "template": "set protocols mpls label-protocol [parameter1]",
            "command": "set protocols mpls label-protocol ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 3.3.3.3",
            "explanation": "配置LDP的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP的Router ID，用于标识LDP实例。"
                }
            ]
        },
        "set protocols isis area-address [parameter1]": {
            "template": "set protocols isis area-address [parameter1]",
            "command": "set protocols isis area-address 10.0000.0000.0003.00",
            "explanation": "配置IS-IS的区域地址。",
            "parameters": [
                {
                    "name": "area-address",
                    "type": "string",
                    "explanation": "IS-IS的区域地址，用于标识IS-IS区域。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp group 100 neighbor 2.2.2.2 remote-as 100",
            "explanation": "配置BGP邻居的远程AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的远程AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] update-source [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] update-source [parameter3]",
            "command": "set protocols bgp group 100 neighbor 2.2.2.2 update-source lo0",
            "explanation": "配置BGP邻居的更新源接口。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "用于BGP更新的源接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] address-family [parameter2]": {
            "template": "set protocols bgp group [parameter1] address-family [parameter2]",
            "command": "set protocols bgp group 100 address-family ipv4-unicast",
            "explanation": "配置BGP组的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "BGP地址族，例如ipv4-unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] activate": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] activate",
            "command": "set protocols bgp group 100 neighbor 2.2.2.2 activate",
            "explanation": "激活BGP邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family inet mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet mpls ldp sync": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet mpls ldp sync",
            "command": "set interfaces ge-1/0/0 unit 0 family inet mpls ldp sync",
            "explanation": "配置接口上的MPLS LDP同步。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet vrf forwarding [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet vrf forwarding [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet vrf forwarding vpn1",
            "explanation": "配置接口的VRF转发。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vrf",
                    "type": "string",
                    "explanation": "VRF名称，用于指定转发实例。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]",
            "command": "set policy-options policy-statement SPE term 1 from route-filter 0.0.0.0/0",
            "explanation": "配置策略语句的匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "路由过滤器，用于匹配特定的路由。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement SPE term 1 then accept",
            "explanation": "配置策略项的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "策略项的动作，例如accept。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}