{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name client001",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services ssh": {
            "template": "set system services ssh",
            "command": "set system services ssh",
            "explanation": "启用SSH服务。",
            "parameters": []
        },
        "set system login user [parameter1] class [parameter2] authentication [parameter3]": {
            "template": "set system login user [parameter1] class [parameter2] authentication [parameter3]",
            "command": "set system login user <username> class super-user authentication plain-text-password",
            "explanation": "配置系统登录用户，指定用户类别为超级用户，并使用明文密码进行认证。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "登录用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户类别，例如super-user。"
                },
                {
                    "name": "authentication",
                    "type": "string",
                    "explanation": "认证方式，例如plain-text-password。"
                }
            ]
        },
        "set system ports auxiliary [parameter1]": {
            "template": "set system ports auxiliary [parameter1]",
            "command": "set system ports auxiliary disable",
            "explanation": "禁用辅助端口。",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "端口状态，例如disable。"
                }
            ]
        },
        "set system ports console [parameter1]": {
            "template": "set system ports console [parameter1]",
            "command": "set system ports console disable",
            "explanation": "禁用控制台端口。",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "端口状态，例如disable。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.2.2/16",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-0/0/0 enable",
            "explanation": "启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security ssh root-login [parameter1]": {
            "template": "set security ssh root-login [parameter1]",
            "command": "set security ssh root-login allow",
            "explanation": "允许SSH的root登录。",
            "parameters": [
                {
                    "name": "permission",
                    "type": "string",
                    "explanation": "权限设置，例如allow。"
                }
            ]
        }
    }
}