{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-switched-path [parameter1]": {
            "template": "set protocols mpls label-switched-path [parameter1]",
            "command": "set protocols mpls label-switched-path ldp",
            "explanation": "配置MPLS的标签交换路径为LDP。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的类型，例如ldp。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，例如all表示所有接口。"
                }
            ]
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 1 wide-metrics-only",
            "explanation": "配置IS-IS Level 1仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，例如1表示Level 1。"
                }
            ]
        },
        "set protocols isis level [parameter1] disable": {
            "template": "set protocols isis level [parameter1] disable",
            "command": "set protocols isis level 1 disable",
            "explanation": "禁用IS-IS Level 1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，例如1表示Level 1。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2]": {
            "template": "set protocols isis interface [parameter1] level [parameter2]",
            "command": "set protocols isis interface ge-1/0/0 level 1",
            "explanation": "在指定接口上配置IS-IS Level 1。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，例如1表示Level 1。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-1/0/0 point-to-point",
            "explanation": "配置指定接口为点对点类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols isis interface [parameter1] passive": {
            "template": "set protocols isis interface [parameter1] passive",
            "command": "set protocols isis interface lo0.1 passive",
            "explanation": "配置指定接口为被动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols isis [parameter1] address-family inet unicast": {
            "template": "set protocols isis [parameter1] address-family inet unicast",
            "command": "set protocols isis lo0.1 address-family inet unicast",
            "explanation": "在指定接口上配置IS-IS的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols isis [parameter1] address-family inet unicast prefix-sid index [parameter2]": {
            "template": "set protocols isis [parameter1] address-family inet unicast prefix-sid index [parameter2]",
            "command": "set protocols isis lo0.1 address-family inet unicast prefix-sid index 10",
            "explanation": "为指定接口的IPv4单播地址族配置前缀SID索引。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                },
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "前缀SID的索引值。"
                }
            ]
        },
        "set protocols isis no-advertise-mac": {
            "template": "set protocols isis no-advertise-mac",
            "command": "set protocols isis no-advertise-mac",
            "explanation": "禁止IS-IS通告MAC地址。",
            "parameters": []
        },
        "set protocols isis no-advertise-protocol": {
            "template": "set protocols isis no-advertise-protocol",
            "command": "set protocols isis no-advertise-protocol",
            "explanation": "禁止IS-IS通告协议。",
            "parameters": []
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0001.0000.0000.0000.00",
            "explanation": "配置IS-IS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识IS-IS区域和系统。"
                }
            ]
        },
        "set protocols isis sr-mpls": {
            "template": "set protocols isis sr-mpls",
            "command": "set protocols isis sr-mpls",
            "explanation": "启用IS-IS的Segment Routing MPLS功能。",
            "parameters": []
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options dynamic-tunnels segment-routing mpls": {
            "template": "set routing-options dynamic-tunnels segment-routing mpls",
            "command": "set routing-options dynamic-tunnels segment-routing mpls",
            "explanation": "启用动态隧道的Segment Routing MPLS功能。",
            "parameters": []
        },
        "set routing-options dynamic-tunnels segment-routing mpls label-range-page [parameter1] [parameter2]": {
            "template": "set routing-options dynamic-tunnels segment-routing mpls label-range-page [parameter1] [parameter2]",
            "command": "set routing-options dynamic-tunnels segment-routing mpls label-range-page 16000 23999",
            "explanation": "配置Segment Routing MPLS的标签范围。",
            "parameters": [
                {
                    "name": "start-label",
                    "type": "integer",
                    "explanation": "标签范围的起始值。"
                },
                {
                    "name": "end-label",
                    "type": "integer",
                    "explanation": "标签范围的结束值。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}