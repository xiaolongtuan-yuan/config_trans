{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name BRAS",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services dhcp pool [parameter1] network [parameter2]/[parameter3]": {
            "template": "set system services dhcp pool [parameter1] network [parameter2]/[parameter3]",
            "command": "set system services dhcp pool bas_local network 10.0.0.0/16",
            "explanation": "配置DHCP服务的地址池及其网络地址和子网掩码。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCP地址池的名称。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "DHCP地址池的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "DHCP地址池的子网掩码位数。"
                }
            ]
        },
        "set system services dhcp pool [parameter1] default-router [parameter2]": {
            "template": "set system services dhcp pool [parameter1] default-router [parameter2]",
            "command": "set system services dhcp pool bas_local default-router 10.0.0.1",
            "explanation": "配置DHCP地址池的默认网关。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCP地址池的名称。"
                },
                {
                    "name": "default-router",
                    "type": "string",
                    "explanation": "DHCP地址池的默认网关地址。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order none",
            "explanation": "配置系统认证顺序为无。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "系统认证顺序，'none'表示无认证。"
                }
            ]
        },
        "set system accounting-order [parameter1]": {
            "template": "set system accounting-order [parameter1]",
            "command": "set system accounting-order none",
            "explanation": "配置系统计费顺序为无。",
            "parameters": [
                {
                    "name": "accounting-order",
                    "type": "string",
                    "explanation": "系统计费顺序，'none'表示不计费。"
                }
            ]
        },
        "set system domain-name [parameter1]": {
            "template": "set system domain-name [parameter1]",
            "command": "set system domain-name ipv4",
            "explanation": "配置系统的域名。",
            "parameters": [
                {
                    "name": "domain-name",
                    "type": "string",
                    "explanation": "系统的域名。"
                }
            ]
        },
        "set system services dhcp pool [parameter1] domain-name [parameter2]": {
            "template": "set system services dhcp pool [parameter1] domain-name [parameter2]",
            "command": "set system services dhcp pool ipv4 domain-name ipv4",
            "explanation": "配置DHCP地址池的域名。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCP地址池的名称。"
                },
                {
                    "name": "domain-name",
                    "type": "string",
                    "explanation": "DHCP地址池的域名。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols multicast-routing": {
            "template": "set protocols multicast-routing",
            "command": "set protocols multicast-routing",
            "explanation": "启用多播路由。",
            "parameters": []
        },
        "set protocols pim interface [parameter1]": {
            "template": "set protocols pim interface [parameter1]",
            "command": "set protocols pim interface ge-0/0/1",
            "explanation": "在指定接口上启用PIM协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                }
            ]
        },
        "set protocols igmp-snooping interface [parameter1] group [parameter2]": {
            "template": "set protocols igmp-snooping interface [parameter1] group [parameter2]",
            "command": "set protocols igmp-snooping interface ge-0/0/0 group 224.0.0.0",
            "explanation": "在指定接口上配置IGMP Snooping组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "IGMP Snooping组的地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options multicast no-tunnel": {
            "template": "set forwarding-options multicast no-tunnel",
            "command": "set forwarding-options multicast no-tunnel",
            "explanation": "配置多播转发不使用隧道。",
            "parameters": []
        },
        "set forwarding-options multicast rp [parameter1]": {
            "template": "set forwarding-options multicast rp [parameter1]",
            "command": "set forwarding-options multicast rp 10.0.0.1",
            "explanation": "配置多播转发的RP（Rendezvous Point）地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "多播转发的RP地址。"
                }
            ]
        },
        "set forwarding-options multicast policy [parameter1] output bandwidth [parameter2] level-1 [parameter3]": {
            "template": "set forwarding-options multicast policy [parameter1] output bandwidth [parameter2] level-1 [parameter3]",
            "command": "set forwarding-options multicast policy bas-policy output bandwidth 30000 level-1 20000",
            "explanation": "配置多播转发的策略输出带宽和级别。",
            "parameters": [
                {
                    "name": "policy-name",
                    "type": "string",
                    "explanation": "多播转发的策略名称。"
                },
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "策略的输出带宽。"
                },
                {
                    "name": "level-1",
                    "type": "integer",
                    "explanation": "策略的级别1带宽。"
                }
            ]
        }
    }
}