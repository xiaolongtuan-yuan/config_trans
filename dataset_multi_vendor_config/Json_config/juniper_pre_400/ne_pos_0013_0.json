{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/30",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces ge-1/0/0 encapsulation ppp",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如ppp。"
                }
            ]
        },
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-1/0/0 enable",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    }
}