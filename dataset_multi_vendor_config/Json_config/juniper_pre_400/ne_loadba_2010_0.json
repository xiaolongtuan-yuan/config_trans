{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name routerA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options hash-key family [parameter1] [parameter2]": {
            "template": "set forwarding-options hash-key family [parameter1] [parameter2]",
            "command": "set forwarding-options hash-key family inet per-packet-balancing",
            "explanation": "配置转发选项的哈希键，用于指定IPv4家族的数据包平衡方式。",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "指定协议家族，例如inet表示IPv4。"
                },
                {
                    "name": "balancing-method",
                    "type": "string",
                    "explanation": "指定数据包平衡的方法，例如per-packet-balancing表示每个数据包都进行平衡。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]",
            "command": "set interfaces ae0 aggregated-ether-options link-speed gigabit-ethernet",
            "explanation": "配置聚合以太网接口的链路速度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae0。"
                },
                {
                    "name": "link-speed",
                    "type": "string",
                    "explanation": "指定链路速度，例如gigabit-ethernet表示千兆以太网。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ae0 unit 0 family inet address 10.40.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/2 ether-options 802.3ad ae0",
            "explanation": "配置接口的以太网选项，将其加入到指定的聚合接口中。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae0。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 10.20.1.0/24 next-hop 10.30.1.2",
            "explanation": "配置静态路由，指定目的网络和下一跳地址。",
            "parameters": [
                {
                    "name": "destination-network",
                    "type": "string",
                    "explanation": "目的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "目的网络的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，数据包将被转发到该地址。"
                }
            ]
        }
    }
}