{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name client001",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services ssh root-login [parameter1]": {
            "template": "set system services ssh root-login [parameter1]",
            "command": "set system services ssh root-login allow",
            "explanation": "允许root用户通过SSH登录。",
            "parameters": [
                {
                    "name": "root-login",
                    "type": "string",
                    "explanation": "控制root用户是否可以通过SSH登录。"
                }
            ]
        },
        "set system services ssh protocol-version [parameter1]": {
            "template": "set system services ssh protocol-version [parameter1]",
            "command": "set system services ssh protocol-version v2",
            "explanation": "设置SSH服务使用的协议版本。",
            "parameters": [
                {
                    "name": "protocol-version",
                    "type": "string",
                    "explanation": "SSH协议版本，例如v2。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2] authentication [parameter3]": {
            "template": "set system login user [parameter1] class [parameter2] authentication [parameter3]",
            "command": "set system login user <username> class super-user authentication plain-text-password",
            "explanation": "配置系统登录用户，设置用户类别和认证方式。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户的登录名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户的类别，例如super-user。"
                },
                {
                    "name": "authentication",
                    "type": "string",
                    "explanation": "用户的认证方式，例如plain-text-password。"
                }
            ]
        },
        "set system login user [parameter1] full-name \"[parameter2]\"": {
            "template": "set system login user [parameter1] full-name \"[parameter2]\"",
            "command": "set system login user <username> full-name \"<full name>\"",
            "explanation": "配置系统登录用户的全名。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户的登录名。"
                },
                {
                    "name": "full-name",
                    "type": "string",
                    "explanation": "用户的全名。"
                }
            ]
        },
        "set system services ssh connection-limit [parameter1]": {
            "template": "set system services ssh connection-limit [parameter1]",
            "command": "set system services ssh connection-limit 5",
            "explanation": "设置SSH服务的连接限制。",
            "parameters": [
                {
                    "name": "connection-limit",
                    "type": "integer",
                    "explanation": "SSH服务的最大连接数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}