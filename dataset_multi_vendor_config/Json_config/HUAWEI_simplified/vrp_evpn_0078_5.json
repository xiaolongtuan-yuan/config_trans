{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥域10的配置模式",
        "parameters": [
            {
                "name": "bridge-domain ID",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk10",
        "explanation": "进入Eth-Trunk10接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 10",
            "explanation": "将接口加入到Eth-Trunk10",
            "parameters": [
                {
                    "name": "Eth-Trunk ID",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        }
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface Eth-Trunk10.1 mode l2",
        "explanation": "进入Eth-Trunk10.1子接口的配置模式，并设置为二层模式",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 100",
            "explanation": "配置子接口的封装类型为dot1q，并指定VLAN ID为100",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口加入到桥域10",
            "parameters": [
                {
                    "name": "bridge-domain ID",
                    "type": "integer",
                    "explanation": "桥域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}