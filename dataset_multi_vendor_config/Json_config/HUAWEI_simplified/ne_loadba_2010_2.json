{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerC",
        "explanation": "设置设备的主机名为 'routerC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route-static 10.1.1.0 255.255.255.0 GigabitEthernet2/0/2 10.50.1.1",
        "explanation": "配置静态路由，目标网络10.1.1.0/24，出接口GigabitEthernet2/0/2，下一跳10.50.1.1",
        "parameters": [
            {
                "name": "target network",
                "type": "IPv4",
                "explanation": "目标网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳IP地址"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.20.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}