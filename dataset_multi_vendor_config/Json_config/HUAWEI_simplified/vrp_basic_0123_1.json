{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口，这里是GigabitEthernet0/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.2.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ssh client first-time enable": {
        "template": "ssh client first-time enable",
        "command": "ssh client first-time enable",
        "explanation": "启用SSH客户端首次连接功能",
        "parameters": []
    }
}