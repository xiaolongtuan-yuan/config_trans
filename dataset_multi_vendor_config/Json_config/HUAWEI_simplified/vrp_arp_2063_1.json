{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入VLAN 10的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ],
        "port isolate [parameter1] [parameter2]": {
            "template": "port isolate [parameter1] [parameter2]",
            "command": "port isolate GigabitEthernet1/0/1 GigabitEthernet1/0/2",
            "explanation": "在指定接口之间启用端口隔离",
            "parameters": [
                {
                    "name": "interface1",
                    "type": "string",
                    "explanation": "第一个接口名"
                },
                {
                    "name": "interface2",
                    "type": "string",
                    "explanation": "第二个接口名"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "启用接口的二层交换功能",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "设置接口的默认VLAN为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识号"
                }
            ]
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "设置接口的链路类型为trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "链路类型，如trunk"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "允许VLAN 10通过trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识号"
                }
            ]
        }
    }
}