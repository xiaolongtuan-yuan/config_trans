{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "arp expire-time [parameter1]": {
            "template": "arp expire-time [parameter1]",
            "command": "arp expire-time 5",
            "explanation": "设置ARP表项的过期时间为5分钟",
            "parameters": [
                {
                    "name": "expire time",
                    "type": "integer",
                    "explanation": "过期时间（分钟）"
                }
            ]
        },
        "arp static [parameter1] [parameter2] [parameter3]": {
            "template": "arp static [parameter1] [parameter2] [parameter3]",
            "command": "arp static 10.1.1.2 interface-name mac-address",
            "explanation": "配置静态ARP条目，将IP地址10.1.1.2映射到指定接口的MAC地址",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "interface-name",
                    "type": "string",
                    "explanation": "接口名称"
                },
                {
                    "name": "mac-address",
                    "type": "string",
                    "explanation": "MAC地址"
                }
            ]
        }
    }
}