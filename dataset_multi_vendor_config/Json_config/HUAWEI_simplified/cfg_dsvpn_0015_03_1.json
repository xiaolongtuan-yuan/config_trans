{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke1",
        "explanation": "设置设备的主机名为 'Spoke1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.2.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到GRE隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "配置隧道协议为GRE点对多点",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                },
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "设置隧道的源接口为GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 200",
        "explanation": "进入BGP配置模式，AS号为200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.2",
            "explanation": "设置BGP的Router ID为172.16.1.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.1 as-number 100",
            "explanation": "配置BGP对等体172.16.1.1，AS号为100",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体AS号"
                }
            ]
        },
        "ipv4-family [parameter1]": {
            "template": "ipv4-family [parameter1]",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route [parameter1] [parameter2]": {
                "template": "import-route [parameter1] [parameter2]",
                "command": "import-route ospf 1",
                "explanation": "引入OSPF进程1的路由到BGP",
                "parameters": [
                    {
                        "name": "protocol",
                        "type": "string",
                        "explanation": "路由协议"
                    },
                    {
                        "name": "process id",
                        "type": "integer",
                        "explanation": "进程ID"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.1.1 enable",
                "explanation": "使能对等体172.16.1.1的IPv4单播地址族",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            }
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.2",
        "explanation": "进入OSPF进程1的配置模式，设置Router ID为172.16.1.2",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.1.0，反掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "反掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}