{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 11 13",
        "explanation": "批量创建VLAN 11和VLAN 13",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "启用OSPFv3进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置OSPFv3进程1的路由器ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "import-route [parameter1]": {
            "template": "import-route [parameter1]",
            "command": "import-route static",
            "explanation": "将静态路由导入OSPFv3进程1",
            "parameters": [
                {
                    "name": "route type",
                    "type": "string",
                    "explanation": "路由类型"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.1",
            "explanation": "配置OSPFv3区域0.0.0.1",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "nssa": {
                "template": "nssa",
                "command": "nssa",
                "explanation": "将区域0.0.0.1配置为NSSA（Not-So-Stubby Area）",
                "parameters": []
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif11",
        "explanation": "进入VLAN接口11的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:5::1/64",
            "explanation": "配置接口的IPv6地址为2001:DB8:5::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.1",
            "explanation": "将接口加入OSPFv3进程1的区域0.0.0.1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 13",
            "explanation": "设置接口的默认VLAN为13",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static 2001:DB8:6::1 128 NULL0",
        "explanation": "配置IPv6静态路由，目的地址为2001:DB8:6::1/128，下一跳为NULL0",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv6",
                "explanation": "目的地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图并返回到用户视图",
        "parameters": []
    }
}