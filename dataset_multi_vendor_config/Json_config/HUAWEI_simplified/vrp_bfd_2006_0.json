{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8::1/32",
            "explanation": "配置接口的IPv6地址为2001:db8::1，前缀长度为32",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        }
    },
    "bfd ipv6session bind peer-ipv6 [parameter1] interface [parameter2]": {
        "template": "bfd ipv6session bind peer-ipv6 [parameter1] interface [parameter2]",
        "command": "bfd ipv6session bind peer-ipv6 2001:db8::2 interface GigabitEthernet1/0/0",
        "explanation": "绑定BFD IPv6会话到对端IPv6地址2001:db8::2和接口GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "peer-ipv6",
                "type": "IPv6",
                "explanation": "对端IPv6地址"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "discriminator local [parameter1]": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 1",
            "explanation": "设置本地BFD会话的标识符为1",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地BFD会话的标识符"
                }
            ]
        },
        "discriminator remote [parameter1]": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 2",
            "explanation": "设置远端BFD会话的标识符为2",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端BFD会话的标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}