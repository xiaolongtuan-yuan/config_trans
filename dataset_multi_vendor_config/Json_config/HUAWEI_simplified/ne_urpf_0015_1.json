{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerB",
        "explanation": "设置设备的主机名为 'routerB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 2010",
        "explanation": "创建或进入ACL编号为2010的配置模式",
        "parameters": [
            {
                "name": "ACL number",
                "type": "integer",
                "explanation": "访问控制列表的编号"
            }
        ],
        "rule [parameter1] permit source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit source [parameter2] [parameter3]",
            "command": "rule 5 permit source 10.1.1.0 0.0.0.255",
            "explanation": "在ACL中添加一条规则，允许源地址为10.1.1.0/24的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "规则编号"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "许可动作（permit/deny）"
                },
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                }
            ]
        }
    },
    "traffic classifier [parameter1] operator [parameter2]": {
        "template": "traffic classifier [parameter1] operator [parameter2]",
        "command": "traffic classifier classifier1 operator or",
        "explanation": "创建一个名为classifier1的流量分类器，使用“或”操作符",
        "parameters": [
            {
                "name": "classifier name",
                "type": "string",
                "explanation": "分类器名称"
            },
            {
                "name": "operator",
                "type": "string",
                "explanation": "操作符（or/and）"
            }
        ],
        "if-match acl [parameter1]": {
            "template": "if-match acl [parameter1]",
            "command": "if-match acl 2010",
            "explanation": "匹配ACL 2010定义的流量",
            "parameters": [
                {
                    "name": "ACL number",
                    "type": "integer",
                    "explanation": "访问控制列表的编号"
                }
            ]
        }
    },
    "traffic behavior [parameter1]": {
        "template": "traffic behavior [parameter1]",
        "command": "traffic behavior behavior1",
        "explanation": "创建一个名为behavior1的流量行为",
        "parameters": [
            {
                "name": "behavior name",
                "type": "string",
                "explanation": "行为名称"
            }
        ],
        "ip urpf [parameter1]": {
            "template": "ip urpf [parameter1]",
            "command": "ip urpf strict",
            "explanation": "启用严格的URPF检查",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "URPF模式（strict/loose）"
                }
            ]
        }
    },
    "traffic policy [parameter1]": {
        "template": "traffic policy [parameter1]",
        "command": "traffic policy policy1",
        "explanation": "创建一个名为policy1的流量策略",
        "parameters": [
            {
                "name": "policy name",
                "type": "string",
                "explanation": "策略名称"
            }
        ],
        "classifier [parameter1] behavior [parameter2]": {
            "template": "classifier [parameter1] behavior [parameter2]",
            "command": "classifier classifier1 behavior behavior1",
            "explanation": "将分类器classifier1与行为behavior1关联",
            "parameters": [
                {
                    "name": "classifier name",
                    "type": "string",
                    "explanation": "分类器名称"
                },
                {
                    "name": "behavior name",
                    "type": "string",
                    "explanation": "行为名称"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.19.139.2 255.255.255.252",
            "explanation": "配置接口的IPv4地址为172.19.139.2，子网掩码为255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "traffic-policy [parameter1] inbound": {
            "template": "traffic-policy [parameter1] inbound",
            "command": "traffic-policy policy1 inbound",
            "explanation": "在接口的入方向应用流量策略policy1",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "策略名称"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向（inbound/outbound）"
                }
            ]
        }
    }
}