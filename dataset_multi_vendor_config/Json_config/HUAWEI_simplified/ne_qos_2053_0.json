{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "traffic classifier [parameter1] operator [parameter2]": {
        "template": "traffic classifier [parameter1] operator [parameter2]",
        "command": "traffic classifier c1 operator or",
        "explanation": "创建名为 'c1' 的流量分类器，并设置其操作为 'or'",
        "parameters": [
            {
                "name": "classifier name",
                "type": "string",
                "explanation": "流量分类器名称"
            },
            {
                "name": "operator",
                "type": "string",
                "explanation": "操作符，'or' 表示逻辑或"
            }
        ],
        "if-match [parameter1]": {
            "template": "if-match [parameter1]",
            "command": "if-match any",
            "explanation": "匹配所有流量",
            "parameters": [
                {
                    "name": "condition",
                    "type": "string",
                    "explanation": "匹配条件，'any' 表示所有流量"
                }
            ]
        }
    },
    "traffic behavior [parameter1]": {
        "template": "traffic behavior [parameter1]",
        "command": "traffic behavior b1",
        "explanation": "创建名为 'b1' 的流量行为",
        "parameters": [
            {
                "name": "behavior name",
                "type": "string",
                "explanation": "流量行为名称"
            }
        ],
        "car cir [parameter1] cbs [parameter2] green [parameter3] red [parameter4]": {
            "template": "car cir [parameter1] cbs [parameter2] green [parameter3] red [parameter4]",
            "command": "car cir 10000 cbs 150000 green pass red discard",
            "explanation": "配置承诺信息速率 (CIR) 为 10000 kbps，承诺突发大小 (CBS) 为 150000 bytes，绿色流量通过，红色流量丢弃",
            "parameters": [
                {
                    "name": "cir",
                    "type": "integer",
                    "explanation": "承诺信息速率，单位 kbps"
                },
                {
                    "name": "cbs",
                    "type": "integer",
                    "explanation": "承诺突发大小，单位 bytes"
                },
                {
                    "name": "green action",
                    "type": "string",
                    "explanation": "绿色流量的动作，'pass' 表示通过"
                },
                {
                    "name": "red action",
                    "type": "string",
                    "explanation": "红色流量的动作，'discard' 表示丢弃"
                }
            ]
        }
    },
    "traffic policy [parameter1]": {
        "template": "traffic policy [parameter1]",
        "command": "traffic policy p1",
        "explanation": "创建名为 'p1' 的流量策略",
        "parameters": [
            {
                "name": "policy name",
                "type": "string",
                "explanation": "流量策略名称"
            }
        ],
        "classifier [parameter1] behavior [parameter2] precedence [parameter3]": {
            "template": "classifier [parameter1] behavior [parameter2] precedence [parameter3]",
            "command": "classifier c1 behavior b1 precedence 1",
            "explanation": "将流量分类器 'c1' 和流量行为 'b1' 关联到流量策略 'p1'，并设置优先级为 1",
            "parameters": [
                {
                    "name": "classifier name",
                    "type": "string",
                    "explanation": "流量分类器名称"
                },
                {
                    "name": "behavior name",
                    "type": "string",
                    "explanation": "流量行为名称"
                },
                {
                    "name": "precedence",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/1/0",
        "explanation": "进入接口 GigabitEthernet0/1/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.10.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "control-vid [parameter1] qinq-termination": {
            "template": "control-vid [parameter1] qinq-termination",
            "command": "control-vid 1 qinq-termination",
            "explanation": "配置子接口的QinQ终结功能，控制VLAN ID为1",
            "parameters": [
                {
                    "name": "control-vid",
                    "type": "integer",
                    "explanation": "控制VLAN ID"
                }
            ]
        },
        "qinq termination pe-vid [parameter1] ce-vid [parameter2] to [parameter3]": {
            "template": "qinq termination pe-vid [parameter1] ce-vid [parameter2] to [parameter3]",
            "command": "qinq termination pe-vid 100 ce-vid 10 to 20",
            "explanation": "配置QinQ终结的PE VLAN ID为100，CE VLAN ID范围为10到20",
            "parameters": [
                {
                    "name": "pe-vid",
                    "type": "integer",
                    "explanation": "PE VLAN ID"
                },
                {
                    "name": "ce-vid start",
                    "type": "integer",
                    "explanation": "CE VLAN ID 起始值"
                },
                {
                    "name": "ce-vid end",
                    "type": "integer",
                    "explanation": "CE VLAN ID 结束值"
                }
            ]
        },
        "traffic-policy [parameter1] [parameter2]": {
            "template": "traffic-policy [parameter1] [parameter2]",
            "command": "traffic-policy p1 inbound",
            "explanation": "在子接口的入方向应用流量策略 'p1'",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "流量策略名称"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "应用方向，'inbound' 表示入方向"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}