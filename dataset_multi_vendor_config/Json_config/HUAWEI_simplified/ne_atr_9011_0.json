{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Server1",
        "explanation": "设置设备的主机名为 'Server1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp-adaptive enable": {
        "template": "ptp-adaptive enable",
        "command": "ptp-adaptive enable",
        "explanation": "启用PTP自适应功能",
        "parameters": []
    },
    "ptp-adaptive device-type [parameter1]": {
        "template": "ptp-adaptive device-type [parameter1]",
        "command": "ptp-adaptive device-type server",
        "explanation": "设置设备类型为服务器",
        "parameters": [
            {
                "name": "device-type",
                "type": "string",
                "explanation": "设备类型，如服务器或客户端"
            }
        ]
    },
    "ptp-adaptive time profile": {
        "template": "ptp-adaptive time profile",
        "command": "ptp-adaptive time profile",
        "explanation": "设置时间配置文件",
        "parameters": []
    },
    "ptp-adaptive domain [parameter1]": {
        "template": "ptp-adaptive domain [parameter1]",
        "command": "ptp-adaptive domain 45",
        "explanation": "设置PTP域号为45",
        "parameters": [
            {
                "name": "domain",
                "type": "integer",
                "explanation": "PTP域号"
            }
        ]
    },
    "ptp-adaptive local-ip [parameter1]": {
        "template": "ptp-adaptive local-ip [parameter1]",
        "command": "ptp-adaptive local-ip 1.1.1.1",
        "explanation": "设置本地IP地址为1.1.1.1",
        "parameters": [
            {
                "name": "local-ip",
                "type": "IPv4",
                "explanation": "本地IP地址"
            }
        ]
    },
    "ptp-adaptive atr unicast-negotiate enable": {
        "template": "ptp-adaptive atr unicast-negotiate enable",
        "command": "ptp-adaptive atr unicast-negotiate enable",
        "explanation": "启用ATR单播协商",
        "parameters": []
    },
    "ptp-adaptive dscp [parameter1]": {
        "template": "ptp-adaptive dscp [parameter1]",
        "command": "ptp-adaptive dscp 60",
        "explanation": "设置DSCP值为60",
        "parameters": [
            {
                "name": "dscp",
                "type": "integer",
                "explanation": "DSCP值"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "进入接口配置模式，配置回环接口Loopback0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置接口的IPv4地址为1.1.1.1，子网掩码为255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ptp-adaptive atr enable": {
            "template": "ptp-adaptive atr enable",
            "command": "ptp-adaptive atr enable",
            "explanation": "在该接口上启用PTP自适应的ATR功能",
            "parameters": []
        }
    }
}