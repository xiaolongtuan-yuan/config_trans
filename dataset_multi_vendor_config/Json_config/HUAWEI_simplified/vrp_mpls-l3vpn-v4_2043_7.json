{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.2.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 172.16.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65420",
        "explanation": "进入BGP配置模式，AS号为65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.2.2 as-number 300",
            "explanation": "配置BGP对等体172.16.2.2，其AS号为300",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "对等体的IPv4地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的自治系统号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "引入直连路由到BGP",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.2.2 enable",
                "explanation": "使能与对等体172.16.2.2的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "对等体的IPv4地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出到用户视图",
        "parameters": []
    }
}