{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 10 20",
        "explanation": "批量创建VLAN 10和VLAN 20",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif10",
        "explanation": "进入VLAN接口10的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "配置VLAN接口10的IPv4地址为 10.2.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 20",
            "explanation": "设置接口的默认VLAN为20",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到GRE隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol gre",
            "explanation": "设置隧道协议为GRE",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 2.2.2.2",
            "explanation": "设置隧道的源地址为2.2.2.2",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 1.1.1.1",
            "explanation": "设置隧道的目的地址为1.1.1.1",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 2.2.2.2 0.0.0.0",
                "explanation": "在OSPF区域0.0.0.0中宣告网络2.2.2.2/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}