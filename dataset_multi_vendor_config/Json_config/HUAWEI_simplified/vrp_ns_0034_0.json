{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 1.1.1.9",
        "explanation": "配置MPLS的LSR ID为1.1.1.9",
        "parameters": [
            {
                "name": "LSR ID",
                "type": "IPv4",
                "explanation": "MPLS的LSR ID"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "进入MPLS配置模式",
        "parameters": [],
        "lsp-trigger [parameter1]": {
            "template": "lsp-trigger [parameter1]",
            "command": "lsp-trigger all",
            "explanation": "配置LSP触发条件为所有路由",
            "parameters": [
                {
                    "name": "trigger condition",
                    "type": "string",
                    "explanation": "LSP触发条件"
                }
            ]
        }
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "进入MPLS LDP配置模式",
        "parameters": [],
        "mpls ldp remote-peer [parameter1]": {
            "template": "mpls ldp remote-peer [parameter1]",
            "command": "mpls ldp remote-peer Devicec",
            "explanation": "配置MPLS LDP的远程对等体为Devicec",
            "parameters": [
                {
                    "name": "remote peer",
                    "type": "string",
                    "explanation": "远程对等体名称"
                }
            ],
            "remote-ip [parameter1]": {
                "template": "remote-ip [parameter1]",
                "command": "remote-ip 3.3.3.9",
                "explanation": "配置远程对等体的IP地址为3.3.3.9",
                "parameters": [
                    {
                        "name": "remote IP",
                        "type": "IPv4",
                        "explanation": "远程对等体的IP地址"
                    }
                ]
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls": {
            "template": "mpls",
            "command": "mpls",
            "explanation": "在接口上启用MPLS",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用MPLS LDP",
            "parameters": []
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1配置模式",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0配置模式",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.1.0，通配符掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}