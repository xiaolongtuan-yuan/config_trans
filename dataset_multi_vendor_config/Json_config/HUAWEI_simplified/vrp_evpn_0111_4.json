{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 20",
        "explanation": "批量创建VLAN 20",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 20",
        "explanation": "进入VLAN 20的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif20",
        "explanation": "进入VLAN接口20的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.11 255.255.255.0",
            "explanation": "配置VLAN接口20的IPv4地址为 192.168.2.11，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口模式切换为二层模式",
            "parameters": []
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "设置接口链路类型为Trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "链路类型"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 20",
            "explanation": "允许VLAN 20通过Trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "mode [parameter1]": {
            "template": "mode [parameter1]",
            "command": "mode lacp-static",
            "explanation": "设置Eth-Trunk的工作模式为静态LACP模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "工作模式"
                }
            ]
        },
        "lacp preempt [parameter1]": {
            "template": "lacp preempt [parameter1]",
            "command": "lacp preempt enable",
            "explanation": "启用LACP抢占功能",
            "parameters": [
                {
                    "name": "preempt",
                    "type": "string",
                    "explanation": "抢占功能"
                }
            ]
        },
        "max active-linknumber [parameter1]": {
            "template": "max active-linknumber [parameter1]",
            "command": "max active-linknumber 1",
            "explanation": "设置Eth-Trunk的最大活动链路数为1",
            "parameters": [
                {
                    "name": "number",
                    "type": "integer",
                    "explanation": "最大活动链路数"
                }
            ]
        },
        "lacp preempt delay [parameter1]": {
            "template": "lacp preempt delay [parameter1]",
            "command": "lacp preempt delay 180",
            "explanation": "设置LACP抢占延迟时间为180秒",
            "parameters": [
                {
                    "name": "delay time",
                    "type": "integer",
                    "explanation": "抢占延迟时间"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 20",
            "explanation": "将接口加入到Eth-Trunk20",
            "parameters": [
                {
                    "name": "eth-trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}