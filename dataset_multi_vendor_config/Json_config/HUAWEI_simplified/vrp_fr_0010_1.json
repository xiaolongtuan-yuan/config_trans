{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "进入接口 Pos1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol fr",
            "explanation": "配置接口的链路层协议为帧中继 (FR)",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "链路层协议"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        }
    },
    "interface [parameter1] [parameter2]": {
        "template": "interface [parameter1] [parameter2]",
        "command": "interface Pos1/0/0.1 p2p",
        "explanation": "进入子接口 Pos1/0/0.1 的配置模式，并指定其类型为点对点 (p2p)",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "interface type",
                "type": "string",
                "explanation": "接口类型"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置子接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "fr dlci [parameter1]": {
            "template": "fr dlci [parameter1]",
            "command": "fr dlci 100",
            "explanation": "配置帧中继数据链路连接标识符 (DLCI) 为 100",
            "parameters": [
                {
                    "name": "dlci",
                    "type": "integer",
                    "explanation": "数据链路连接标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}