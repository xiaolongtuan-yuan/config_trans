        "command": "interface GigabitEthernet0/0/0",
        "explanation": "进入 GigabitEthernet0/0/0 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.0.0",
            "explanation": "配置接口的IPv4地址为 10.1.2.2，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "rsa local-key-pair create": {
        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "生成本地RSA密钥对",
        "parameters": []
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "进入VTY用户接口配置模式，范围从0到4",
        "parameters": [
            {
                "name": "start vty number",
                "type": "integer",
                "explanation": "起始VTY接口编号"
            },
            {
                "name": "end vty number",
                "type": "integer",
                "explanation": "结束VTY接口编号"
            }
        ],
        "authentication-mode local": {
            "template": "authentication-mode local",
            "command": "authentication-mode local",
            "explanation": "设置认证模式为本地",
            "parameters": []
        },
        "protocol inbound ssh": {
            "template": "protocol inbound ssh",
            "command": "protocol inbound ssh",
            "explanation": "允许SSH协议 inbound",
            "parameters": []
        }
