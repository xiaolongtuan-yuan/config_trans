{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
