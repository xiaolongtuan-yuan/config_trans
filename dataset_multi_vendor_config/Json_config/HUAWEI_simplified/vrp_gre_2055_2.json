{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.21.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.21.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到GRE隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:5::1/64",
            "explanation": "配置接口的IPv6地址为 2001:DB8:5::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol gre",
            "explanation": "配置隧道协议为GRE",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 10.21.1.2",
            "explanation": "配置隧道的源地址为 10.21.1.2",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 10.20.1.1",
            "explanation": "配置隧道的目的地址为 10.20.1.1",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.21.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.21.1.0，子网掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static 2001:DB8:1:: 64 Tunnel1",
        "explanation": "配置静态IPv6路由，目的网络为2001:DB8:1::/64，下一跳为Tunnel1接口",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv6",
                "explanation": "目的网络"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}