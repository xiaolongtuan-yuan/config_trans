{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mirror instance [parameter1] location": {
        "template": "mirror instance [parameter1] location",
        "command": "mirror instance evcto201 location",
        "explanation": "创建一个镜像实例并指定位置",
        "parameters": [
            {
                "name": "instance name",
                "type": "string",
                "explanation": "镜像实例的名称"
            }
        ]
    },
    "slot [parameter1]": {
        "template": "slot [parameter1]",
        "command": "slot 1",
        "explanation": "指定槽位号",
        "parameters": [
            {
                "name": "slot number",
                "type": "integer",
                "explanation": "槽位编号"
            }
        ]
    },
    "mirror to observe-index [parameter1]": {
        "template": "mirror to observe-index [parameter1]",
        "command": "mirror to observe-index 1",
        "explanation": "将镜像数据发送到指定的观察索引",
        "parameters": [
            {
                "name": "observe index",
                "type": "integer",
                "explanation": "观察索引号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "port-observing observe-index [parameter1]": {
            "template": "port-observing observe-index [parameter1]",
            "command": "port-observing observe-index 1",
            "explanation": "配置端口观察，指定观察索引",
            "parameters": [
                {
                    "name": "observe index",
                    "type": "integer",
                    "explanation": "观察索引号"
                }
            ]
        }
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/1.1 mode l2",
        "explanation": "进入指定子接口的配置模式，并设置模式为L2",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "子接口名称"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "模式类型（L2）"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "设置封装类型为dot1q，并指定VLAN ID",
            "parameters": [
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将接口分配到指定的桥域",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥域ID"
                }
            ]
        },
        "port-mirroring instance [parameter1] inbound vid [parameter2] identifier [parameter3]": {
            "template": "port-mirroring instance [parameter1] inbound vid [parameter2] identifier [parameter3]",
            "command": "port-mirroring instance evcto201 inbound vid 10 identifier none",
            "explanation": "配置端口镜像实例，指定入站VLAN和标识符",
            "parameters": [
                {
                    "name": "instance name",
                    "type": "string",
                    "explanation": "镜像实例名称"
                },
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                },
                {
                    "name": "identifier",
                    "type": "string",
                    "explanation": "标识符（none表示无标识）"
                }
            ]
        }
    }
}