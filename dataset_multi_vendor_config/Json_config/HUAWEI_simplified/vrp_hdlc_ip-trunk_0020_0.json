{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.1.1.0 255.255.255.0 Pos1/0/0",
        "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳接口为 Pos1/0/0",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop interface",
                "type": "string",
                "explanation": "下一跳接口"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "进入接口 Pos1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol hdlc",
            "explanation": "配置接口的链路协议为 HDLC",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "链路协议"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address unnumbered interface [parameter1]": {
            "template": "ip address unnumbered interface [parameter1]",
            "command": "ip address unnumbered interface LoopBack1",
            "explanation": "配置接口使用 LoopBack1 接口的 IP 地址",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.255",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
}