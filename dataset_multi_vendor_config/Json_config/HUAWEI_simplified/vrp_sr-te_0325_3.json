{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Controller",
        "explanation": "设置设备的主机名为 'Controller'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "pce-server": {
        "template": "pce-server",
        "command": "pce-server",
        "explanation": "进入PCE服务器配置模式",
        "parameters": [],
        "source-address [parameter1]": {
            "template": "source-address [parameter1]",
            "command": "source-address 10.2.1.2",
            "explanation": "设置PCE服务器的源地址为10.2.1.2",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "进入接口GigabitEthernet3/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.2.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 100",
        "explanation": "进入BGP配置模式，AS号为100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.2.1.1 as-number 100",
            "explanation": "配置BGP对等体10.2.1.1，AS号为100",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "对等体地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP同步功能",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.2.1.1 enable",
                "explanation": "启用对等体10.2.1.1的IPv4单播地址族",
                "parameters": [
                    {
                        "name": "peer address",
                        "type": "IPv4",
                        "explanation": "对等体地址"
                    }
                ]
            }
        },
        "link-state-family unicast": {
            "template": "link-state-family unicast",
            "command": "link-state-family unicast",
            "explanation": "进入链路状态单播地址族配置模式",
            "parameters": [],
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.2.1.1 enable",
                "explanation": "启用对等体10.2.1.1的链路状态单播地址族",
                "parameters": [
                    {
                        "name": "peer address",
                        "type": "IPv4",
                        "explanation": "对等体地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}