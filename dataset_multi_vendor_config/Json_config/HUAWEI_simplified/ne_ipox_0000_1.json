        "parameters": [],
        "user [parameter1] password cipher [parameter2] authentication-type [parameter3] block fail-times [parameter4] interval [parameter5]": {
            "template": "user [parameter1] password cipher [parameter2] authentication-type [parameter3] block fail-times [parameter4] interval [parameter5]",
            "command": "user 00e0-fc12-3456@isp1 password cipher %^%#-;Y`5xisf(pJ|7O@]x=({F5*>\\If$&5m]dS^\\UgF%^%# authentication-type B block fail-times 3 interval 5",
