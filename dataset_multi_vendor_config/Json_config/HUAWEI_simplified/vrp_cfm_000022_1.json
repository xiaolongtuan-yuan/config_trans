{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] to [parameter2]": {
        "template": "vlan batch [parameter1] to [parameter2]",
        "command": "vlan batch 2 to 4",
        "explanation": "批量创建VLAN 2到4",
        "parameters": [
            {
                "name": "start vlan id",
                "type": "integer",
                "explanation": "起始VLAN ID"
            },
            {
                "name": "end vlan id",
                "type": "integer",
                "explanation": "结束VLAN ID"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1] to [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] to [parameter2]",
            "command": "port trunk allow-pass vlan 2 to 4",
            "explanation": "配置接口允许VLAN 2到4的流量通过",
            "parameters": [
                {
                    "name": "start vlan id",
                    "type": "integer",
                    "explanation": "起始VLAN ID"
                },
                {
                    "name": "end vlan id",
                    "type": "integer",
                    "explanation": "结束VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md1 level 6",
        "explanation": "配置CFM维护域md1的级别为6",
        "parameters": [
            {
                "name": "maintenance domain name",
                "type": "string",
                "explanation": "维护域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "维护域级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "配置CFM维护关联ma1",
            "parameters": [
                {
                    "name": "maintenance association name",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "map vlan [parameter1]": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 2",
                "explanation": "将维护关联ma1映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图并返回到用户视图",
        "parameters": []
    }
