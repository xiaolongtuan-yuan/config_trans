{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]": {
        "template": "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]",
        "command": "ntp-service authentication-keyid 16 authentication-mode hmac-sha256 cipher %#%#m:fVJfk*r&3x\"1J`21^K`Y;LH;B+g(t2<ZX^}Q_~%#%#",
        "explanation": "配置NTP认证密钥ID为16，认证模式为HMAC-SHA256，并设置加密密码",
        "parameters": [
            {
                "name": "keyid",
                "type": "integer",
                "explanation": "认证密钥ID"
            },
            {
                "name": "authentication mode",
                "type": "string",
                "explanation": "认证模式"
            },
            {
                "name": "cipher",
                "type": "string",
                "explanation": "加密密码"
            }
        ]
    },
    "ntp-service reliable authentication-keyid [parameter1]": {
        "template": "ntp-service reliable authentication-keyid [parameter1]",
        "command": "ntp-service reliable authentication-keyid 16",
        "explanation": "设置NTP可靠认证密钥ID为16",
        "parameters": [
            {
                "name": "keyid",
                "type": "integer",
                "explanation": "认证密钥ID"
            }
        ]
    },
    "ntp-service authentication enable": {
        "template": "ntp-service authentication enable",
        "command": "ntp-service authentication enable",
        "explanation": "启用NTP认证",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.1.32 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.0.1.32，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ntp-service broadcast-client": {
            "template": "ntp-service broadcast-client",
            "command": "ntp-service broadcast-client",
            "explanation": "配置接口为NTP广播客户端",
            "parameters": []
        }
    },
    "Return": {
        "template": "Return",
        "command": "Return",
        "explanation": "返回到用户视图",
        "parameters": []
    }
