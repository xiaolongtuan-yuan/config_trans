{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口 GigabitEthernet1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65010",
        "explanation": "进入BGP配置模式，AS号为65010",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置BGP的Router ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.1.1.2 as-number 65010",
            "explanation": "配置BGP对等体10.1.1.2，AS号为65010",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "group [parameter1] internal": {
            "template": "group [parameter1] internal",
            "command": "group in_rr internal",
            "explanation": "创建一个名为in_rr的内部BGP组",
            "parameters": [
                {
                    "name": "group name",
                    "type": "string",
                    "explanation": "组名"
                }
            ]
        },
        "peer [parameter1] group [parameter2]": {
            "template": "peer [parameter1] group [parameter2]",
            "command": "peer 10.1.4.2 group in_rr",
            "explanation": "将对等体10.1.4.2加入到in_rr组中",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "group name",
                    "type": "string",
                    "explanation": "组名"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族的配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP同步功能",
                "parameters": []
            },
            "undo reflect between-clients": {
                "template": "undo reflect between-clients",
                "command": "undo reflect between-clients",
                "explanation": "关闭BGP客户端之间的反射功能",
                "parameters": []
            },
            "reflector cluster-id [parameter1]": {
                "template": "reflector cluster-id [parameter1]",
                "command": "reflector cluster-id 1",
                "explanation": "设置BGP反射器的集群ID为1",
                "parameters": [
                    {
                        "name": "cluster id",
                        "type": "integer",
                        "explanation": "集群ID"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.1.1.2 enable",
                "explanation": "启用与对等体10.1.1.2的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            },
            "peer [parameter1] reflect-client": {
                "template": "peer [parameter1] reflect-client",
                "command": "peer in_rr reflect-client",
                "explanation": "配置in_rr组内的对等体为反射客户端",
                "parameters": [
                    {
                        "name": "group name",
                        "type": "string",
                        "explanation": "组名"
                    }
                ]
            },
            "peer [parameter1] group [parameter2]": {
                "template": "peer [parameter1] group [parameter2]",
                "command": "peer 10.1.4.2 group in_rr",
                "explanation": "将对等体10.1.4.2加入到in_rr组中",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    },
                    {
                        "name": "group name",
                        "type": "string",
                        "explanation": "组名"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
