                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:db8:8::2 as-number 200",
            "explanation": "配置BGP对等体2001:db8:8::2，AS号为200",
            "parameters": [
                {
                    "name": "peer ipv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "peer [parameter1] bfd min-tx-interval [parameter2] min-rx-interval [parameter3] detect-multiplier [parameter4]": {
            "template": "peer [parameter1] bfd min-tx-interval [parameter2] min-rx-interval [parameter3] detect-multiplier [parameter4]",
            "command": "peer 2001:db8:8::2 bfd min-tx-interval 100 min-rx-interval 100 detect-multiplier 4",
            "explanation": "配置与对等体2001:db8:8::2的BFD会话参数，最小发送间隔100ms，最小接收间隔100ms，检测倍数4",
            "parameters": [
                {
                    "name": "peer ipv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                },
                {
                    "name": "min-tx-interval",
                    "type": "integer",
                    "explanation": "最小发送间隔，单位ms"
                },
                {
                    "name": "min-rx-interval",
                    "type": "integer",
                    "explanation": "最小接收间隔，单位ms"
                },
                {
                    "name": "detect-multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        },
        "peer [parameter1] bfd enable": {
            "template": "peer [parameter1] bfd enable",
            "command": "peer 2001:db8:8::2 bfd enable",
            "explanation": "启用与对等体2001:db8:8::2的BFD会话",
            "parameters": [
                {
                    "name": "peer ipv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                }
            ]
        },
