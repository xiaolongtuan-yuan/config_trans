{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock ssm-control [parameter1]": {
        "template": "clock ssm-control [parameter1]",
        "command": "clock ssm-control on",
        "explanation": "启用SSM控制",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "控制状态，on或off"
            }
        ]
    },
    "clock bits-type [parameter1] [parameter2]": {
        "template": "clock bits-type [parameter1] [parameter2]",
        "command": "clock bits-type bits0 2mbps",
        "explanation": "设置BITS类型",
        "parameters": [
            {
                "name": "bits-id",
                "type": "string",
                "explanation": "BITS标识"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "类型，如2mbps"
            }
        ]
    },
    "clock source [parameter1] synchronization [parameter2]": {
        "template": "clock source [parameter1] synchronization [parameter2]",
        "command": "clock source bits0 synchronization enable",
        "explanation": "启用指定时钟源的同步",
        "parameters": [
            {
                "name": "source-id",
                "type": "string",
                "explanation": "时钟源标识"
            },
            {
                "name": "synchronization-state",
                "type": "string",
                "explanation": "同步状态，enable或disable"
            }
        ]
    },
    "clock source [parameter1] priority [parameter2]": {
        "template": "clock source [parameter1] priority [parameter2]",
        "command": "clock source bits0 priority 1",
        "explanation": "设置时钟源的优先级",
        "parameters": [
            {
                "name": "source-id",
                "type": "string",
                "explanation": "时钟源标识"
            },
            {
                "name": "priority-level",
                "type": "integer",
                "explanation": "优先级级别"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "clock synchronization [parameter1]": {
            "template": "clock synchronization [parameter1]",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步",
            "parameters": [
                {
                    "name": "synchronization-state",
                    "type": "string",
                    "explanation": "同步状态，enable或disable"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 2",
            "explanation": "设置时钟优先级",
            "parameters": [
                {
                    "name": "priority-level",
                    "type": "integer",
                    "explanation": "优先级级别"
                }
            ]
        }
    }
}