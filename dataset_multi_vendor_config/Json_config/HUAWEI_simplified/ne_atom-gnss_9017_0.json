{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname ASG1",
        "explanation": "设置设备的主机名为 'ASG1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock ssm-control [parameter1]": {
        "template": "clock ssm-control [parameter1]",
        "command": "clock ssm-control on",
        "explanation": "启用SSM控制功能",
        "parameters": [
            {
                "name": "ssm-control status",
                "type": "string",
                "explanation": "控制状态，on或off"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "启用PTP协议",
        "parameters": []
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type bc",
        "explanation": "设置PTP设备类型为BC（Boundary Clock）",
        "parameters": [
            {
                "name": "device-type",
                "type": "string",
                "explanation": "设备类型，如bc、oc等"
            }
        ]
    },
    "ptp domain [parameter1]": {
        "template": "ptp domain [parameter1]",
        "command": "ptp domain 255",
        "explanation": "设置PTP域号为255",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "域号，范围0-255"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitEthernet 1/0/0",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步功能",
            "parameters": []
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级为1",
            "parameters": [
                {
                    "name": "priority level",
                    "type": "integer",
                    "explanation": "优先级等级"
                }
            ]
        },
        "smart-clock ptp domain [parameter1]": {
            "template": "smart-clock ptp domain [parameter1]",
            "command": "smart-clock ptp domain 255",
            "explanation": "设置智能时钟的PTP域号为255",
            "parameters": [
                {
                    "name": "domain number",
                    "type": "integer",
                    "explanation": "域号，范围0-255"
                }
            ]
        },
        "smart clock gnss-model [parameter1] [parameter2]": {
            "template": "smart clock gnss-model [parameter1] [parameter2]",
            "command": "smart clock gnss-model gps glonass",
            "explanation": "设置智能时钟的GNSS模型为GPS和GLONASS",
            "parameters": [
                {
                    "name": "gnss models",
                    "type": "list of strings",
                    "explanation": "GNSS模型列表，如gps、glonass等"
                }
            ]
        },
        "smart-clock cable-delay [parameter1]": {
            "template": "smart-clock cable-delay [parameter1]",
            "command": "smart-clock cable-delay 60",
            "explanation": "设置智能时钟的电缆延迟为60",
            "parameters": [
                {
                    "name": "cable delay",
                    "type": "integer",
                    "explanation": "电缆延迟值"
                }
            ]
        },
        "ptp enable": {
            "template": "ptp enable",
            "command": "ptp enable",
            "explanation": "启用接口的PTP功能",
            "parameters": []
        },
        "ptp delay-mechanism [parameter1]": {
            "template": "ptp delay-mechanism [parameter1]",
            "command": "ptp delay-mechanism delay",
            "explanation": "设置PTP延迟机制为delay",
            "parameters": [
                {
                    "name": "delay mechanism",
                    "type": "string",
                    "explanation": "延迟机制类型，如delay等"
                }
            ]
        }
