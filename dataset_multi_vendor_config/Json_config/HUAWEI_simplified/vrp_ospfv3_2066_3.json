{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceE",
        "explanation": "设置设备的主机名为 'DeviceE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD（双向转发检测）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1] [parameter2]": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8:2000::1 255.255.255.0",
            "explanation": "配置接口的IPv6地址为 2001:db8:2000::1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ospfv3 cost [parameter1]": {
            "template": "ospfv3 cost [parameter1]",
            "command": "ospfv3 cost 5",
            "explanation": "设置OSPFv3接口的cost值为5",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "OSPFv3接口的cost值"
                }
            ]
        }
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "进入OSPFv3进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置OSPFv3的Router ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPFv3的Router ID"
                }
            ]
        },
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用BFD功能",
            "parameters": []
        },
        "bfd all-interfaces frr-binding": {
            "template": "bfd all-interfaces frr-binding",
            "command": "bfd all-interfaces frr-binding",
            "explanation": "在所有接口上绑定BFD与FRR（快速重路由）功能",
            "parameters": []
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.1",
            "explanation": "进入OSPFv3区域0.0.0.1的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3区域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}