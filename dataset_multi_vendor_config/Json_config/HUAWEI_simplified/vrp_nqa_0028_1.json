        "explanation": "设置NQA抖动测试的标签版本为2",
        "parameters": [
            {
                "name": "tag version",
                "type": "integer",
                "explanation": "标签版本"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入IS-IS进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 00.0000.0000.0002.00",
            "explanation": "设置IS-IS的网络实体标题为00.0000.0000.0002.00",
            "parameters": [
                {
                    "name": "network entity title",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.2.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.2.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        }
    },
    "nqa test-instance [parameter1] [parameter2]": {
        "template": "nqa test-instance [parameter1] [parameter2]",
        "command": "nqa test-instance admin udpjitter",
        "explanation": "创建一个NQA测试实例，管理员为admin，测试类型为udpjitter",
        "parameters": [
            {
                "name": "administrator",
                "type": "string",
                "explanation": "管理员"
            },
            {
                "name": "test type",
                "type": "string",
                "explanation": "测试类型"
            }
        ],
        "test-type [parameter1]": {
            "template": "test-type [parameter1]",
            "command": "test-type jitter",
            "explanation": "设置测试类型为抖动测试",
            "parameters": [
                {
                    "name": "test type",
                    "type": "string",
                    "explanation": "测试类型"
                }
            ]
        },
        "destination-address ipv4 [parameter1]": {
            "template": "destination-address ipv4 [parameter1]",
            "command": "destination-address ipv4 10.1.1.1",
