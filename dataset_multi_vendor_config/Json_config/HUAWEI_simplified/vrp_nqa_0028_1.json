            "parameters": [
                {
                    "name": "codec",
                    "type": "string",
                    "explanation": "编解码器"
                }
            ]
        },
        "start [parameter1]": {
            "template": "start [parameter1]",
            "command": "start now",
            "explanation": "立即开始测试",
            "parameters": [
                {
                    "name": "start time",
                    "type": "string",
                    "explanation": "开始时间"
                }
            ]
