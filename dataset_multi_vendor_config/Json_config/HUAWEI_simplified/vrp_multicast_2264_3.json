{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "multicast routing-enable": {
        "template": "multicast routing-enable",
        "command": "multicast routing-enable",
        "explanation": "启用组播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo portswitch": {
            "template": "undo portswitch",
            "command": "undo portswitch",
            "explanation": "将接口从二层模式切换到三层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "pim sm": {
            "template": "pim sm",
            "command": "pim sm",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "igmp enable": {
            "template": "igmp enable",
            "command": "igmp enable",
            "explanation": "在接口上启用IGMP",
            "parameters": []
        },
        "igmp static-group [parameter1]": {
            "template": "igmp static-group [parameter1]",
            "command": "igmp static-group 228.0.0.1",
            "explanation": "配置静态组播组地址为 228.0.0.1",
            "parameters": [
                {
                    "name": "group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 2",
        "explanation": "启用OSPF进程2",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.3.0 0.0.0.255",
                "explanation": "将网络10.1.3.0/24加入到OSPF区域0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "pim": {
        "template": "pim",
        "command": "pim",
        "explanation": "进入PIM配置模式",
        "parameters": [],
        "static-rp [parameter1]": {
            "template": "static-rp [parameter1]",
            "command": "static-rp 1.1.1.1",
            "explanation": "配置静态RP地址为1.1.1.1",
            "parameters": [
                {
                    "name": "rp address",
                    "type": "IPv4",
                    "explanation": "RP地址"
                }
            ]
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route-static 1.1.1.1 255.255.255.255 Gigabitethernet1/0/0 10.1.3.1",
        "explanation": "配置静态路由，目的地址为1.1.1.1/32，出接口为Gigabitethernet1/0/0，下一跳地址为10.1.3.1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "destination mask",
                "type": "IPv4",
                "explanation": "目的地址掩码"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop address",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
}