{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname SPE",
        "explanation": "设置设备的主机名为'SPE'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD功能",
        "parameters": []
    },
    "mpls lsr-id [ip-address]": {
        "template": "mpls lsr-id [ip-address]",
        "command": "mpls lsr-id 4.4.4.4",
        "explanation": "设置MPLS的LSR-ID为4.4.4.4",
        "parameters": [
            {
                "name": "ip-address",
                "type": "IPv4",
                "explanation": "LSR的IP地址"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "启用MPLS功能",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用MPLS的LDP",
        "parameters": []
    },
    "ipv4-family": {
        "template": "ipv4-family",
        "command": "ipv4-family",
        "explanation": "进入IPv4地址族的配置模式",
        "parameters": []
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [ip-address] [subnet-mask]": {
            "template": "ip address [ip-address] [subnet-mask]",
            "command": "ip address 10.1.3.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.3.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "接口的IPv4地址"
                },
                {
                    "name": "subnet-mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls": {
            "template": "mpls",
            "command": "mpls",
            "explanation": "在接口上启用MPLS",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用MPLS LDP",
            "parameters": []
        },
        "trap-threshold [error-type] [ratio-type] alarm-threshold [value1] [value2] resume-threshold [value3] [value4] trigger-section": {
            "template": "trap-threshold [error-type] [ratio-type] alarm-threshold [value1] [value2] resume-threshold [value3] [value4] trigger-section",
            "command": "trap-threshold crc-error packet-error-ratio alarm-threshold 3 4 resume-threshold 2 5 trigger-section",
            "explanation": "设置陷阱阈值参数",
            "parameters": [
                {
                    "name": "error-type",
                    "type": "string",
                    "explanation": "错误类型，如crc-error"
                },
                {
                    "name": "ratio-type",
                    "type": "string",
                    "explanation": "比率类型，如packet-error-ratio"
                },
                {
                    "name": "alarm-threshold",
                    "type": "integer",
                    "explanation": "告警阈值"
                },
                {
                    "name": "resume-threshold",
                    "type": "integer",
                    "explanation": "恢复阈值"
                },
                {
                    "name": "trigger-section",
                    "type": "string",
                    "explanation": "触发部分"
                }
            ]
        }
    },
    "ospf [process-id]": {
        "template": "ospf [process-id]",
        "command": "ospf 100",
        "explanation": "启动OSPF进程，进程号为100",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [area-id]": {
            "template": "area [area-id]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPF的区域，区域ID为0.0.0.0",
            "parameters": [
                {
                    "name": "area-id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [ip-address] [wildcard-mask]": {
                "template": "network [ip-address] [wildcard-mask]",
                "command": "network 4.4.4.4 0.0.0.0",
                "explanation": "将IP地址4.4.4.4及其子网划入OSPF区域",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "IPv4",
                        "explanation": "网络的IP地址"
                    },
                    {
                        "name": "wildcard-mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "返回上一级配置模式或退出当前模式",
        "parameters": []
    }
}