{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router id [parameter1]": {
        "template": "router id [parameter1]",
        "command": "router id 2.2.2.2",
        "explanation": "设置路由器的ID为 2.2.2.2",
        "parameters": [
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD（双向转发检测）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 2.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ospf bfd enable": {
            "template": "ospf bfd enable",
            "command": "ospf bfd enable",
            "explanation": "在接口上启用OSPF BFD功能",
            "parameters": []
        },
        "ospf bfd min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]": {
            "template": "ospf bfd min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]",
            "command": "ospf bfd min-tx-interval 500 min-rx-interval 500 detect-multiplier 4",
            "explanation": "配置OSPF BFD的最小发送间隔为500ms，最小接收间隔为500ms，检测倍数为4",
            "parameters": [
                {
                    "name": "min-tx-interval",
                    "type": "integer",
                    "explanation": "最小发送间隔(ms)"
                },
                {
                    "name": "min-rx-interval",
                    "type": "integer",
                    "explanation": "最小接收间隔(ms)"
                },
                {
                    "name": "detect-multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用BFD功能",
            "parameters": []
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 3.3.3.0 0.0.0.255",
                "explanation": "将网络3.3.3.0/24加入到OSPF区域0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}