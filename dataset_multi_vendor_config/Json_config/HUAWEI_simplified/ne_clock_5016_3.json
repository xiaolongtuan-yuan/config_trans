{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "启用扩展SSM控制",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "状态，on或off"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "选择接口GigabitEthernet1/0/0进行配置",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "启用接口的时钟同步",
            "parameters": []
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级为1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级数值"
                }
            ]
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 9",
            "explanation": "设置时钟ID为9",
            "parameters": [
                {
                    "name": "clock id",
                    "type": "integer",
                    "explanation": "时钟ID数值"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式或返回上一级",
        "parameters": []
    }
}