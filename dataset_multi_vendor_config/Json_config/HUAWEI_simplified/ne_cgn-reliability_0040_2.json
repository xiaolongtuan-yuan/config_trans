{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/1",
        "explanation": "进入 GigabitEthernet2/0/1 接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.11.11.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.11.11.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 200",
        "explanation": "进入 BGP 进程配置，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.3.3.3 as-number 200",
            "explanation": "配置 BGP 对等体 10.3.3.3，AS 号为 200",
            "parameters": [
                {
                    "name": "peer IP address",
                    "type": "IPv4",
                    "explanation": "对等体的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的自治系统编号"
                }
            ]
        },
        "peer [parameter1] connect-interface [parameter2]": {
            "template": "peer [parameter1] connect-interface [parameter2]",
            "command": "peer 10.3.3.3 connect-interface Loopback0",
            "explanation": "指定与对等体 10.3.3.3 建立连接的接口为 Loopback0",
            "parameters": [
                {
                    "name": "peer IP address",
                    "type": "IPv4",
                    "explanation": "对等体的 IP 地址"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "连接接口名"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "取消 BGP 同步",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.3.3.3 enable",
                "explanation": "启用与对等体 10.3.3.3 的 BGP 会话",
                "parameters": [
                    {
                        "name": "peer IP address",
                        "type": "IPv4",
                        "explanation": "对等体的 IP 地址"
                    }
                ]
            },
            "peer [parameter1] route-policy [parameter2] import": {
                "template": "peer [parameter1] route-policy [parameter2] import",
                "command": "peer 10.3.3.3 route-policy local_pre import",
                "explanation": "为对等体 10.3.3.3 配置导入路由策略 'local_pre'",
                "parameters": [
                    {
                        "name": "peer IP address",
                        "type": "IPv4",
                        "explanation": "对等体的 IP 地址"
                    },
                    {
                        "name": "route policy name",
                        "type": "string",
                        "explanation": "路由策略名称"
                    }
                ]
            }
        }
    }
}