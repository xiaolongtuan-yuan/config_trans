{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 10 20",
        "explanation": "批量创建VLAN 10和VLAN 20",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "将接口的默认VLAN设置为VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}