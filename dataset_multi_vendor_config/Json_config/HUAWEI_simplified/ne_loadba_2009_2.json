{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerC",
        "explanation": "设置设备的主机名为 'routerC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "启用IS-IS进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ]
    },
    "is-level [parameter1]": {
        "template": "is-level [parameter1]",
        "command": "is-level level-1",
        "explanation": "设置IS-IS的等级为level-1",
        "parameters": [
            {
                "name": "level",
                "type": "string",
                "explanation": "IS-IS等级 (level-1 or level-2)"
            }
        ]
    },
    "network-entity [parameter1]": {
        "template": "network-entity [parameter1]",
        "command": "network-entity 10.0000.0000.0003.00",
        "explanation": "设置IS-IS的网络实体标题",
        "parameters": [
            {
                "name": "net",
                "type": "string",
                "explanation": "IS-IS网络实体标题"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.40.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级",
        "parameters": []
    }
}