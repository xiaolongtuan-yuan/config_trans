            ]
        },
        "vrrp vrid [parameter1] track bfd-session [parameter2] increased [parameter3]": {
            "template": "vrrp vrid [parameter1] track bfd-session [parameter2] increased [parameter3]",
            "command": "vrrp vrid 1 track bfd-session 2 increased 40",
            "explanation": "配置VRRP虚拟路由器ID为1，跟踪BFD会话2，优先级增加40",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "bfd-session",
                    "type": "integer",
                    "explanation": "BFD会话ID"
                },
                {
                    "name": "increased",
                    "type": "integer",
                    "explanation": "优先级增加量"
                }
            ]
        }
    },
    "bfd trackbfd bind peer-ip [parameter1] interface [parameter2]": {
        "template": "bfd trackbfd bind peer-ip [parameter1] interface [parameter2]",
        "command": "bfd trackbfd bind peer-ip 10.1.1.1 interface gigabitethernet1/0/0",
        "explanation": "配置BFD跟踪，绑定对端IP为10.1.1.1，接口为gigabitethernet1/0/0",
