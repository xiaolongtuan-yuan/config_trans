        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "创建本地RSA密钥对",
        "parameters": [],
        "modulus [parameter1]": {
            "template": "modulus [parameter1]",
            "command": "modulus 2048",
            "explanation": "设置密钥的模长为2048位",
            "parameters": [
                {
                    "name": "modulus length",
                    "type": "integer",
                    "explanation": "密钥的模长"
                }
            ]
        }
    },
    "stelnet server enable": {
        "template": "stelnet server enable",
        "command": "stelnet server enable",
