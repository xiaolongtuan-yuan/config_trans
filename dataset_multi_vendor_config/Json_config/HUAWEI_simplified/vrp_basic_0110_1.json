        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.2.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
