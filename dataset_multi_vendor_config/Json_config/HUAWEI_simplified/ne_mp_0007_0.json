{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "设备的标识名称"
            }
        ]
    },
    "controller E1 [parameter1]": {
        "template": "controller E1 [parameter1]",
        "command": "controller E1 1/0/0",
        "explanation": "配置E1控制器，槽位1，端口0，控制器0",
        "parameters": [
            {
                "name": "slot/port/controller",
                "type": "string",
                "explanation": "指定控制器的位置"
            }
        ],
        "channel-set [parameter1] timeslot-list [parameter2]": {
            "template": "channel-set [parameter1] timeslot-list [parameter2]",
            "command": "channel-set 1 timeslot-list 1-15",
            "explanation": "设置通道组1使用时隙1到15",
            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "通道组的标识号"
                },
                {
                    "name": "timeslot list",
                    "type": "string",
                    "explanation": "使用的时隙范围"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial1/0/0:1",
        "explanation": "进入Serial1/0/0:1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "指定接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "设置链            协议为PPP",
            "parameters": [
                {
                    "name": "protocol name",
                    "type": "string",
                    "explanation": "指定链路协议"
                }
            ]
        },
        "ppp mp [parameter1]": {
            "template": "ppp mp [parameter1]",
            "command": "ppp mp Mp-group1/0/1",
            "explanation": "配置PPP多链路，组名为Mp-group1/0/1",
            "parameters": [
                {
                    "name": "group name",
                    "type": "string",
                    "explanation": "多链路组的名称"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "接口的IP地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "接口的子网掩码"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级",
        "parameters": []
    }
}