        "parameters": []
    },
    "multicast ipv6 routing-enable": {
        "template": "multicast ipv6 routing-enable",
        "command": "multicast ipv6 routing-enable",
        "explanation": "启用IPv6组播路由功能",
        "parameters": []
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用BFD功能",
        "parameters": []
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "启用OSPFv3进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 10.4.4.4",
            "explanation": "设置OSPFv3进程1的路由器ID为10.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:3::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:3::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 address [parameter1] link-local": {
            "template": "ipv6 address [parameter1] link-local",
            "command": "ipv6 address FE80::8 link-local",
            "explanation": "配置接口的IPv6链路本地地址为FE80::8",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6链路本地地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        },
        "pim ipv6 sm": {
            "template": "pim ipv6 sm",
            "command": "pim ipv6 sm",
            "explanation": "在接口上启用IPv6 PIM稀疏模式",
            "parameters": []
        },
        "pim ipv6 timer dr-switch-delay [parameter1]": {
            "template": "pim ipv6 timer dr-switch-delay [parameter1]",
            "command": "pim ipv6 timer dr-switch-delay 20",
            "explanation": "设置PIM IPv6 DR切换延迟时间为20秒",
            "parameters": [
                {
                    "name": "delay time",
                    "type": "integer",
                    "explanation": "延迟时间（秒）"
                }
            ]
        },
        "pim ipv6 bfd enable": {
            "template": "pim ipv6 bfd enable",
            "command": "pim ipv6 bfd enable",
            "explanation": "在接口上启用PIM IPv6 BFD功能",
            "parameters": []
        },
        "pim ipv6 bfd min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]": {
            "template": "pim ipv6 bfd min-tx-interval [parameter1] min-rx-interval [parameter2] detect-multiplier [parameter3]",
            "command": "pim ipv6 bfd min-tx-interval 200 min-rx-interval 200 detect-multiplier 4",
            "explanation": "配置PIM IPv6 BFD的最小发送间隔为200ms，最小接收间隔为200ms，检测倍数为4",
            "parameters": [
                {
                    "name": "min tx interval",
                    "type": "integer",
                    "explanation": "最小发送间隔（毫秒）"
                },
                {
                    "name": "min rx interval",
                    "type": "integer",
                    "explanation": "最小接收间隔（毫秒）"
                },
                {
                    "name": "detect multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        },
        "mld enable": {
            "template": "mld enable",
            "command": "mld enable",
            "explanation": "在接口上启用MLD功能",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
