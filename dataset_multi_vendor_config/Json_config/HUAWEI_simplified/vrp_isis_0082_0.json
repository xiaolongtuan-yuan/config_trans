{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入IS-IS进程1的配置模式",
        "parameters": [
            {
                "name": "IS-IS process number",
                "type": "integer",
                "explanation": "IS-IS进程号"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0001.00",
            "explanation": "配置IS-IS的网络实体标题（NET）为10.0000.0000.0001.00",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "IS-IS process number",
                    "type": "integer",
                    "explanation": "IS-IS进程号"
                }
            ]
        },
        "isis dis-priority [parameter1] level-1": {
            "template": "isis dis-priority [parameter1] level-1",
            "command": "isis dis-priority 100 level-1",
            "explanation": "设置接口在IS-IS level-1中的DIS优先级为100",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "DIS优先级"
                }
            ]
        },
        "isis dis-priority [parameter1] level-2": {
            "template": "isis dis-priority [parameter1] level-2",
            "command": "isis dis-priority 100 level-2",
            "explanation": "设置接口在IS-IS level-2中的DIS优先级为100",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "DIS优先级"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}