{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1",
        "explanation": "进入Eth-Trunk1接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "eth-trunk [parameter1]": {
            "template": "eth-trunk [parameter1]",
            "command": "eth-trunk 1",
            "explanation": "将接口加入Eth-Trunk1",
            "parameters": [
                {
                    "name": "eth-trunk id",
                    "type": "integer",
                    "explanation": "Eth-Trunk编号"
                }
            ]
        }
    },
    "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3]": {
        "template": "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3]",
        "command": "bfd atob bind peer-ip 10.1.1.2 interface Eth-Trunk 1",
        "explanation": "配置BFD会话，名称为atob，绑定对端IP地址为10.1.1.2，接口为Eth-Trunk1",
        "parameters": [
            {
                "name": "bfd session name",
                "type": "string",
                "explanation": "BFD会话名称"
            },
            {
                "name": "peer ip address",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "discriminator local [parameter1]": {
        "template": "discriminator local [parameter1]",
        "command": "discriminator local 10",
        "explanation": "设置本地BFD会话的标识符为10",
        "parameters": [
            {
                "name": "local discriminator",
                "type": "integer",
                "explanation": "本地BFD会话标识符"
            }
        ]
    },
    "discriminator remote [parameter1]": {
        "template": "discriminator remote [parameter1]",
        "command": "discriminator remote 20",
        "explanation": "设置远端BFD会话的标识符为20",
        "parameters": [
            {
                "name": "remote discriminator",
                "type": "integer",
                "explanation": "远端BFD会话标识符"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}