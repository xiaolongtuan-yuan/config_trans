{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 2.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 2.2.2.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络2.2.2.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "ntp-service authentication enable": {
        "template": "ntp-service authentication enable",
        "command": "ntp-service authentication enable",
        "explanation": "启用NTP认证",
        "parameters": []
    },
    "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]": {
        "template": "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]",
        "command": "ntp-service authentication-keyid 42 authentication-mode hmac-sha256 cipher %#%#JA!v6M22=Gg\\{>U.lx%#)c%yY}0*\"/`5mi><QS)L%#%#",
        "explanation": "配置NTP认证密钥ID为42，认证模式为HMAC-SHA256，密钥为加密格式",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "NTP认证密钥ID"
            },
            {
                "name": "authentication mode",
                "type": "string",
                "explanation": "认证模式"
            },
            {
                "name": "cipher key",
                "type": "string",
                "explanation": "加密密钥"
            }
        ]
    },
    "ntp-service reliable authentication-keyid [parameter1]": {
        "template": "ntp-service reliable authentication-keyid [parameter1]",
        "command": "ntp-service reliable authentication-keyid 42",
        "explanation": "设置NTP认证密钥ID42为可靠",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "NTP认证密钥ID"
            }
        ]
    },
    "ntp-service refclock-master [parameter1]": {
        "template": "ntp-service refclock-master [parameter1]",
        "command": "ntp-service refclock-master 2",
        "explanation": "配置NTP参考时钟为主时钟，层级为2",
        "parameters": [
            {
                "name": "stratum",
                "type": "integer",
                "explanation": "时钟层级"
            }
        ]
    },
    "acl [parameter1]": {
        "template": "acl [parameter1]",
        "command": "acl 2000",
        "explanation": "进入ACL 2000的配置模式",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "ACL编号"
            }
        ],
        "rule [parameter1] permit source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit source [parameter2] [parameter3]",
            "command": "rule 2000 permit source 10.0.0.1 0",
            "explanation": "配置ACL 2000的规则2000，允许源地址为10.0.0.1/32的流量",
            "parameters": [
                {
                    "name": "rule id",
                    "type": "integer",
                    "explanation": "规则ID"
                },
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                }
            ]
        }
    },
    "ntp-service access limited [parameter1]": {
        "template": "ntp-service access limited [parameter1]",
        "command": "ntp-service access limited 2000",
        "explanation": "限制NTP访问，仅允许ACL 2000定义的流量",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "ACL编号"
            }
        ]
    },
    "ntp-service discard min-interval [parameter1] avg-interval [parameter2]": {
        "template": "ntp-service discard min-interval [parameter1] avg-interval [parameter2]",
        "command": "ntp-service discard min-interval 4 avg-interval 4",
        "explanation": "配置NTP丢弃包的最小间隔和平均间隔为4秒",
        "parameters": [
            {
                "name": "min interval",
                "type": "integer",
                "explanation": "最小间隔"
            },
            {
                "name": "avg interval",
                "type": "integer",
                "explanation": "平均间隔"
            }
        ]
    },
    "ntp-service server source-interface [parameter1]": {
        "template": "ntp-service server source-interface [parameter1]",
        "command": "ntp-service server source-interface gigabitethernet 1/0/0",
        "explanation": "配置NTP服务器的源接口为GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ntp-service kod-enable": {
        "template": "ntp-service kod-enable",
        "command": "ntp-service kod-enable",
        "explanation": "启用NTP的Kiss-o'-Death (KoD)功能",
        "parameters": []
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}