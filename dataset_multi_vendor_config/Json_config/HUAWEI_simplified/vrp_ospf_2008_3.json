{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceE",
        "explanation": "设置设备的主机名为 'DeviceE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.2.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ospf cost [parameter1]": {
            "template": "ospf cost [parameter1]",
            "command": "ospf cost 5",
            "explanation": "设置接口的OSPF成本为5",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "OSPF成本"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 4.4.4.4",
        "explanation": "进入OSPF进程1的配置模式，并设置路由器ID为4.4.4.4",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ],
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用BFD",
            "parameters": []
        },
        "bfd all-interfaces frr-binding": {
            "template": "bfd all-interfaces frr-binding",
            "command": "bfd all-interfaces frr-binding",
            "explanation": "在所有接口上启用BFD与FRR的绑定",
            "parameters": []
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}