{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "multicast routing-enable": {
        "template": "multicast routing-enable",
        "command": "multicast routing-enable",
        "explanation": "启用组播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口 GigabitEthernet1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "pim sm": {
            "template": "pim sm",
            "command": "pim sm",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "igmp enable": {
            "template": "igmp enable",
            "command": "igmp enable",
            "explanation": "在接口上启用IGMP",
            "parameters": []
        },
        "igmp version [parameter1]": {
            "template": "igmp version [parameter1]",
            "command": "igmp version 3",
            "explanation": "设置IGMP版本为3",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "IGMP版本"
                }
            ]
        },
        "igmp static-group [parameter1] source [parameter2]": {
            "template": "igmp static-group [parameter1] source [parameter2]",
            "command": "igmp static-group 225.1.1.1 source 10.1.3.2",
            "explanation": "配置静态组播组225.1.1.1，源地址为10.1.3.2",
            "parameters": [
                {
                    "name": "group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                },
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "源地址"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 2",
        "explanation": "进入OSPF进程2的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 7.7.7.7 0.0.0.0",
                "explanation": "将7.7.7.7/32网络加入到OSPF区域0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}