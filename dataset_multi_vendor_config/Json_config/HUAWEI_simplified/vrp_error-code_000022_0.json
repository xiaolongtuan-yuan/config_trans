            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bit-error-mode [parameter1]": {
            "template": "bit-error-mode [parameter1]",
            "command": "bit-error-mode prefec",
            "explanation": "配置接口的误码模式为pre-FEC",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "误码模式"
                }
            ]
        },
        "link-quality [parameter1] bit-error-threshold error-ratio [parameter2] [parameter3] resume-ratio [parameter4] [parameter5]": {
            "template": "link-quality [parameter1] bit-error-threshold error-ratio [parameter2] [parameter3] resume-ratio [parameter4] [parameter5]",
            "command": "link-quality low bit-error-threshold error-ratio 1 3 resume-ratio 1 6",
