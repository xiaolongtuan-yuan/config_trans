            "parameters": [
                {
                    "name": "quality level",
                    "type": "string",
                    "explanation": "链路质量等级"
                },
                {
                    "name": "error ratio numerator",
                    "type": "integer",
                    "explanation": "错误率分子"
                },
                {
                    "name": "error ratio denominator",
                    "type": "integer",
                    "explanation": "错误率分母"
                },
                {
                    "name": "resume ratio numerator",
                    "type": "integer",
                    "explanation": "恢复率分子"
                },
                {
                    "name": "resume ratio denominator",
                    "type": "integer",
                    "explanation": "恢复率分母"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process ID",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "isis link-quality [parameter1] incr-cost [parameter2]": {
            "template": "isis link-quality [parameter1] incr-cost [parameter2]",
            "command": "isis link-quality low incr-cost max-reachable",
            "explanation": "配置IS-IS链路质量低时增加成本，最大可达",
            "parameters": [
                {
                    "name": "quality level",
                    "type": "string",
                    "explanation": "链路质量等级"
                },
                {
                    "name": "cost type",
                    "type": "string",
                    "explanation": "成本类型"
                }
            ]
        },
        "isis cost [parameter1]": {
            "template": "isis cost [parameter1]",
            "command": "isis cost 30",
            "explanation": "配置IS-IS接口成本为30",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "接口成本"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
