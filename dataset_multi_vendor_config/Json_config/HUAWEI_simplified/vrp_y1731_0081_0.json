{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM（Connectivity Fault Management）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitEthernet1/0/0.1",
        "explanation": "进入接口gigabitEthernet1/0/0.1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 1",
            "explanation": "配置接口的VLAN类型为dot1q，并指定VLAN ID为1",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "qos profile [parameter1] outbound": {
            "template": "qos profile [parameter1] outbound",
            "command": "qos profile 1 outbound",
            "explanation": "配置接口的出方向QoS策略为profile 1",
            "parameters": [
                {
                    "name": "profile ID",
                    "type": "integer",
                    "explanation": "QoS策略ID"
                }
            ]
        }
    },
    "cfm md [parameter1]": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md1",
        "explanation": "配置CFM的维护域为md1",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "配置CFM的维护关联为ma1",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep mep-id [parameter1] interface [parameter2] outward": {
                "template": "mep mep-id [parameter1] interface [parameter2] outward",
                "command": "mep mep-id 1 interface GigabitEthernet1/0/0.1 outward",
                "explanation": "配置MEP（Maintenance End Point）ID为1，关联接口为GigabitEthernet1/0/0.1，方向为outward",
                "parameters": [
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    }
                ]
            },
            "mep mep-id [parameter1] eth-bn receive enable mode [parameter2]": {
                "template": "mep mep-id [parameter1] eth-bn receive enable mode [parameter2]",
                "command": "mep mep-id 1 eth-bn receive enable mode port-vlan",
                "explanation": "配置MEP ID为1的以太网广播/多播帧接收功能，模式为port-vlan",
                "parameters": [
                    {
                        "name": "MEP ID",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "mode",
                        "type": "string",
                        "explanation": "模式"
                    }
                ]
            }
        }
    },
    "qos-profile [parameter1]": {
        "template": "qos-profile [parameter1]",
        "command": "qos-profile 1",
        "explanation": "进入QoS策略1的配置模式",
        "parameters": [
            {
                "name": "profile ID",
                "type": "integer",
                "explanation": "QoS策略ID"
            }
        ],
        "car cir [parameter1] pir [parameter2] cbs [parameter3] pbs [parameter4] green [parameter5] yellow [parameter6] red [parameter7]": {
            "template": "car cir [parameter1] pir [parameter2] cbs [parameter3] pbs [parameter4] green [parameter5] yellow [parameter6] red [parameter7]",
            "command": "car cir 10000 pir 12000 cbs 1870000 pbs 2244000 green pass yellow pass red discard",
            "explanation": "配置承诺访问速率（CAR），包括承诺信息速率（CIR）、峰值信息速率（PIR）、承诺突发大小（CBS）、峰值突发大小（PBS），以及绿色、黄色、红色流量的处理方式",
            "parameters": [
                {
                    "name": "CIR",
                    "type": "integer",
                    "explanation": "承诺信息速率"
                },
                {
                    "name": "PIR",
                    "type": "integer",
                    "explanation": "峰值信息速率"
                },
                {
                    "name": "CBS",
                    "type": "integer",
                    "explanation": "承诺突发大小"
                },
                {
                    "name": "PBS",
                    "type": "integer",
                    "explanation": "峰值突发大小"
                },
                {
                    "name": "green action",
                    "type": "string",
                    "explanation": "绿色流量的处理方式"
                },
                {
                    "name": "yellow action",
                    "type": "string",
                    "explanation": "黄色流量的处理方式"
                },
                {
                    "name": "red action",
                    "type": "string",
                    "explanation": "红色流量的处理方式"
                }
            ]
        }
    }
}