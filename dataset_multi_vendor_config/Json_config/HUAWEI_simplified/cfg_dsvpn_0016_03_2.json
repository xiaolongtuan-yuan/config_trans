{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "设置设备的主机名为 'Spoke2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.3.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "将接口绑定到GRE隧道",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "配置隧道协议为GRE点对多点",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "隧道协议"
                },
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "设置隧道的源接口为 GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "gre key [parameter1]": {
            "template": "gre key [parameter1]",
            "command": "gre key 0",
            "explanation": "设置GRE隧道的密钥为0",
            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "密钥"
                }
            ]
        },
        "ipsec profile [parameter1]": {
            "template": "ipsec profile [parameter1]",
            "command": "ipsec profile IPSEC_PROFILE_NAME",
            "explanation": "应用IPSec配置文件",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "配置文件名称"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 300",
        "explanation": "进入BGP配置模式，AS号为300",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.3",
            "explanation": "设置BGP的Router ID为172.16.1.3",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.1 as-number 100",
            "explanation": "配置BGP对等体172.16.1.1，AS号为100",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP同步",
                "parameters": []
            },
            "import-route [parameter1] [parameter2]": {
                "template": "import-route [parameter1] [parameter2]",
                "command": "import-route ospf 1",
                "explanation": "引入OSPF进程1的路由到BGP",
                "parameters": [
                    {
                        "name": "protocol",
                        "type": "string",
                        "explanation": "协议"
                    },
                    {
                        "name": "process id",
                        "type": "integer",
                        "explanation": "进程ID"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.1.1 enable",
                "explanation": "启用对等体172.16.1.1的BGP功能",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            }
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.3",
        "explanation": "进入OSPF进程1配置模式，设置Router ID为172.16.1.3",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.2.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.2.0，通配符掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}