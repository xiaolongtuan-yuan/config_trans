{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口 GigabitEthernet1/0/0 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1] [parameter2]": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8:102::1/96",
            "explanation": "配置接口的IPv6地址为 2001:db8:102::1，前缀长度为 96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 200",
        "explanation": "进入BGP配置模式，AS号为200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
            "explanation": "设置BGP路由器的ID为3.3.3.3",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:db8:101::2 as-number 200",
            "explanation": "配置BGP对等体，IPv6地址为2001:db8:101::2，AS号为200",
            "parameters": [
                {
                    "name": "peer IPv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "ipv6-family unicast": {
            "template": "ipv6-family unicast",
            "command": "ipv6-family unicast",
            "explanation": "进入IPv6单播地址族的配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 2001:db8:101:: 96",
                "explanation": "在BGP中宣告网络2001:db8:101::，前缀长度为96",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv6",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "prefix length",
                        "type": "integer",
                        "explanation": "前缀长度"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 2001:db8:101::2 enable",
                "explanation": "启用与对等体2001:db8:101::2的BGP会话",
                "parameters": [
                    {
                        "name": "peer IPv6 address",
                        "type": "IPv6",
                        "explanation": "对等体的IPv6地址"
                    }
                ]
            },
            "peer [parameter1] reflect-client": {
                "template": "peer [parameter1] reflect-client",
                "command": "peer 2001:db8:101::2 reflect-client",
                "explanation": "配置对等体2001:db8:101::2为路由反射器客户端",
                "parameters": [
                    {
                        "name": "peer IPv6 address",
                        "type": "IPv6",
                        "explanation": "对等体的IPv6地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}