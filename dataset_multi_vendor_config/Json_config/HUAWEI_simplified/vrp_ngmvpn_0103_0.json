{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "multicast routing-enable": {
        "template": "multicast routing-enable",
        "command": "multicast routing-enable",
        "explanation": "启用组播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.6.6 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.0.6.6，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "pim sm": {
            "template": "pim sm",
            "command": "pim sm",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 2",
        "explanation": "进入OSPF进程2的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.1",
            "explanation": "进入OSPF区域0.0.0.1的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.0.5.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.1中宣告网络10.0.5.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "pim": {
        "template": "pim",
        "command": "pim",
        "explanation": "进入PIM配置模式",
        "parameters": [],
        "static-rp [parameter1]": {
            "template": "static-rp [parameter1]",
            "command": "static-rp 10.0.6.6",
            "explanation": "配置静态RP地址为10.0.6.6",
            "parameters": [
                {
                    "name": "rp address",
                    "type": "IPv4",
                    "explanation": "RP地址"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图并返回到用户视图",
        "parameters": []
    }
