{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client002",
        "explanation": "设置设备的主机名为 'client002'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.3 255.255.0.0",
            "explanation": "配置接口的IPv4地址为10.1.3.3，子网掩码为255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "rsa local-key-pair create [parameter1]": {
        "template": "rsa local-key-pair create [parameter1]",
        "command": "rsa local-key-pair create 2048",
        "explanation": "创建本地RSA密钥对，指定密钥长度为2048位",
        "parameters": [
            {
                "name": "key length",
                "type": "integer",
                "explanation": "密钥长度（位数）"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式或返回上一级",
        "parameters": []
    }
}