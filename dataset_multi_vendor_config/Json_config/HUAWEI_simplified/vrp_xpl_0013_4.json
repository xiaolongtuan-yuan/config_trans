{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceE",
        "explanation": "设置设备的主机名为 'DeviceE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1",
        "explanation": "进入接口GigabitEthernet3/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.2.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 1.1.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 200",
        "explanation": "进入BGP配置模式，AS号为200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 1.1.1.2 as-number 200",
            "explanation": "配置BGP对等体1.1.1.2，AS号为200",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 1.1.1.2 enable",
                "explanation": "启用与对等体1.1.1.2的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            },
            "peer [parameter1] route-filter [parameter2] import": {
                "template": "peer [parameter1] route-filter [parameter2] import",
                "command": "peer 1.1.1.2 route-filter r3 import",
                "explanation": "对从对等体1.1.1.2接收的路由应用路由过滤器r3",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    },
                    {
                        "name": "route-filter name",
                        "type": "string",
                        "explanation": "路由过滤器名称"
                    }
                ]
            }
        }
    },
    "xpl route-filter [parameter1]": {
        "template": "xpl route-filter [parameter1]",
        "command": "xpl route-filter appmed($med)",
        "explanation": "定义一个名为appmed的路由过滤器，接受一个参数$med",
        "parameters": [
            {
                "name": "route-filter name",
                "type": "string",
                "explanation": "路由过滤器名称"
            },
            {
                "name": "parameter",
                "type": "variable",
                "explanation": "参数"
            }
        ],
        "apply med [parameter1]": {
            "template": "apply med [parameter1]",
            "command": "apply med $med",
            "explanation": "应用MED值为$med",
            "parameters": [
                {
                    "name": "MED value",
                    "type": "variable",
                    "explanation": "MED值"
                }
            ]
        },
        "end-filter": {
            "template": "end-filter",
            "command": "end-filter",
            "explanation": "结束路由过滤器的定义",
            "parameters": []
        },
        "if ip route-destination in {[parameter1]} then": {
            "template": "if ip route-destination in {[parameter1]} then",
            "command": "if ip route-destination in {2.2.2.0 24} then",
            "explanation": "如果路由目的地在2.2.2.0/24范围内",
            "parameters": [
                {
                    "name": "destination network",
                    "type": "IPv4 CIDR",
                    "explanation": "目的网络"
                }
            ]
        },
        "call route-filter [parameter1]": {
            "template": "call route-filter [parameter1]",
            "command": "call route-filter appmed(200)",
            "explanation": "调用appmed路由过滤器，传入MED值为200",
            "parameters": [
                {
                    "name": "route-filter name",
                    "type": "string",
                    "explanation": "路由过滤器名称"
                },
                {
                    "name": "MED value",
                    "type": "integer",
                    "explanation": "MED值"
                }
            ]
        },
        "elseif ip route-destination in {[parameter1]} then": {
            "template": "elseif ip route-destination in {[parameter1]} then",
            "command": "elseif ip route-destination in {2.2.2.0 24, 3.3.3.0 24} then",
            "explanation": "否则如果路由目的地在2.2.2.0/24或3.3.3.0/24范围内",
            "parameters": [
                {
                    "name": "destination networks",
                    "type": "IPv4 CIDR list",
                    "explanation": "目的网络列表"
                }
            ]
        },
        "approve": {
            "template": "approve",
            "command": "approve",
            "explanation": "允许路由通过",
            "parameters": []
        },
        "else": {
            "template": "else",
            "command": "else",
            "explanation": "否则",
            "parameters": []
        },
        "refuse": {
            "template": "refuse",
            "command": "refuse",
            "explanation": "拒绝路由通过",
            "parameters": []
        },
        "endif": {
            "template": "endif",
            "command": "endif",
            "explanation": "结束if条件语句",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}