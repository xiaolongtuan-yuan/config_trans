{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DHCP-Relay",
        "explanation": "设置设备的主机名为 'DHCP-Relay'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "dhcp enable": {
        "template": "dhcp enable",
        "command": "dhcp enable",
        "explanation": "启用DHCP功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "encapsulation qinq-termination": {
            "template": "encapsulation qinq-termination",
            "command": "encapsulation qinq-termination",
            "explanation": "配置子接口为QinQ终结模式",
            "parameters": []
        },
        "qinq termination pe-vid [parameter1] ce-vid [parameter2]": {
            "template": "qinq termination pe-vid [parameter1] ce-vid [parameter2]",
            "command": "qinq termination pe-vid 100 ce-vid 10",
            "explanation": "配置QinQ终结的PE VLAN ID为100，CE VLAN ID为10",
            "parameters": [
                {
                    "name": "pe-vid",
                    "type": "integer",
                    "explanation": "PE VLAN ID"
                },
                {
                    "name": "ce-vid",
                    "type": "integer",
                    "explanation": "CE VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置子接口的IPv4地址为192.168.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip relay address [parameter1]": {
            "template": "ip relay address [parameter1]",
            "command": "ip relay address 192.168.3.1",
            "explanation": "配置DHCP中继的服务器地址为192.168.3.1",
            "parameters": [
                {
                    "name": "relay address",
                    "type": "IPv4",
                    "explanation": "DHCP中继服务器地址"
                }
            ]
        },
        "dhcp select relay": {
            "template": "dhcp select relay",
            "command": "dhcp select relay",
            "explanation": "配置接口使用DHCP中继模式",
            "parameters": []
        },
        "dhcp option82 rebuild enable": {
            "template": "dhcp option82 rebuild enable",
            "command": "dhcp option82 rebuild enable",
            "explanation": "启用DHCP Option82重建功能",
            "parameters": []
        },
        "arp broadcast enable": {
            "template": "arp broadcast enable",
            "command": "arp broadcast enable",
            "explanation": "启用ARP广播功能",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
