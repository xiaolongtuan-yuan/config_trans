{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.40.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65430",
        "explanation": "进入BGP配置模式，指定本地AS号为65430",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "本地AS号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.40.1.1 as-number 100",
            "explanation": "配置BGP对等体，对等体IP地址为10.40.1.1，对等体AS号为100",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP同步",
                "parameters": []
            },
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 33.33.33.33 255.255.255.255",
                "explanation": "在BGP中通告网络33.33.33.33/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "sub musk",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.40.1.1 enable",
                "explanation": "启用与对等体10.40.1.1的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}