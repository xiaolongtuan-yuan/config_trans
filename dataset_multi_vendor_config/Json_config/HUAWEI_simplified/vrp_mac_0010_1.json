{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "批量创建VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "进入VLAN 2的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "mac-limit maximum [parameter1] rate [parameter2] action [parameter3]": {
            "template": "mac-limit maximum [parameter1] rate [parameter2] action [parameter3]",
            "command": "mac-limit maximum 100 rate 50 action forward",
            "explanation": "设置VLAN 2的MAC地址学习限制，最大学习100个MAC地址，学习速率为50，超过限制后的动作为转发",
            "parameters": [
                {
                    "name": "maximum",
                    "type": "integer",
                    "explanation": "最大MAC地址学习数量"
                },
                {
                    "name": "rate",
                    "type": "integer",
                    "explanation": "MAC地址学习速率"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "超过限制后的动作"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "设置接口的链路类型为trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "链路类型"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2通过该trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}