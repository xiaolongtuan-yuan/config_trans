{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CPE",
        "explanation": "设置设备的主机名为 'CPE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥域10的配置模式",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ],
        "vxlan vni [parameter1] split-horizon-mode": {
            "template": "vxlan vni [parameter1] split-horizon-mode",
            "command": "vxlan vni 10 split-horizon-mode",
            "explanation": "在桥域10中配置VXLAN VNI 10并启用水平分割模式",
            "parameters": [
                {
                    "name": "VXLAN VNI",
                    "type": "integer",
                    "explanation": "VXLAN虚拟网络标识符"
                }
            ]
        }
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "创建或进入ISIS进程1的配置模式",
        "parameters": [
            {
                "name": "ISIS process id",
                "type": "integer",
                "explanation": "ISIS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 20.0000.0000.0001.00",
            "explanation": "配置ISIS进程1的网络实体标题",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用ISIS进程1",
            "parameters": [
                {
                    "name": "ISIS process id",
                    "type": "integer",
                    "explanation": "ISIS进程ID"
                }
            ]
        },
        "esi [parameter1]": {
            "template": "esi [parameter1]",
            "command": "esi 0000.0000.0000.0000.0017",
            "explanation": "配置以太网段标识符",
            "parameters": [
                {
                    "name": "ESI",
                    "type": "string",
                    "explanation": "以太网段标识符"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 4.4.4.4",
            "explanation": "配置NVE接口的源IP地址",
            "parameters": [
                {
                    "name": "source IP",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                }
            ]
        },
        "vni [parameter1] head-end peer-list [parameter2]": {
            "template": "vni [parameter1] head-end peer-list [parameter2]",
            "command": "vni 10 head-end peer-list 3.3.3.3",
            "explanation": "配置VNI 10的头端复制列表，添加对等体3.3.3.3",
            "parameters": [
                {
                    "name": "VXLAN VNI",
                    "type": "integer",
                    "explanation": "VXLAN虚拟网络标识符"
                },
                {
                    "name": "peer IP",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                }
            ]
        }
    },
    "interface [parameter1] mode l2": {
        "template": "interface [parameter1] mode l2",
        "command": "interface GigabitEthernet1/0/3.1 mode l2",
        "explanation": "进入GigabitEthernet1/0/3.1接口的L2配置模式",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 100",
            "explanation": "配置子接口的封装类型为dot1q，并指定VLAN ID为100",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN标识符"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥域10",
            "parameters": [
                {
                    "name": "bridge-domain id",
                    "type": "integer",
                    "explanation": "桥域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回到用户视图",
        "parameters": []
    }
}