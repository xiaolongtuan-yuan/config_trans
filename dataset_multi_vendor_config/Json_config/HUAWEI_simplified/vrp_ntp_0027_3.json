{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "undo ntp-service server disable": {
        "template": "undo ntp-service server disable",
        "command": "undo ntp-service server disable",
        "explanation": "启用NTP服务器功能",
        "parameters": []
    },
    "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]": {
        "template": "ntp-service authentication-keyid [parameter1] authentication-mode [parameter2] cipher [parameter3]",
        "command": "ntp-service authentication-keyid 42 authentication-mode hmac-sha256 cipher %#%#$_6BKWy1]kdR@=c;O@UX!)Vor5iYi|zIYEG_v5%#%#",
        "explanation": "配置NTP认证密钥ID为42，认证模式为HMAC-SHA256，并设置加密密码",
        "parameters": [
            {
                "name": "authentication-keyid",
                "type": "integer",
                "explanation": "认证密钥ID"
            },
            {
                "name": "authentication-mode",
                "type": "string",
                "explanation": "认证模式"
            },
            {
                "name": "cipher",
                "type": "string",
                "explanation": "加密密码"
            }
        ]
    },
    "ntp-service reliable authentication-keyid [parameter1]": {
        "template": "ntp-service reliable authentication-keyid [parameter1]",
        "command": "ntp-service reliable authentication-keyid 42",
        "explanation": "设置NTP认证密钥ID42为可靠",
        "parameters": [
            {
                "name": "authentication-keyid",
                "type": "integer",
                "explanation": "认证密钥ID"
            }
        ]
    },
    "ntp-service unicast-server [parameter1] authentication-keyid [parameter2]": {
        "template": "ntp-service unicast-server [parameter1] authentication-keyid [parameter2]",
        "command": "ntp-service unicast-server 10.0.0.1 authentication-keyid 42",
        "explanation": "配置NTP单播服务器地址为10.0.0.1，并使用认证密钥ID42",
        "parameters": [
            {
                "name": "unicast-server",
                "type": "IPv4",
                "explanation": "单播服务器地址"
            },
            {
                "name": "authentication-keyid",
                "type": "integer",
                "explanation": "认证密钥ID"
            }
        ]
    },
    "ntp-service authentication enable": {
        "template": "ntp-service authentication enable",
        "command": "ntp-service authentication enable",
        "explanation": "启用NTP认证功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.0.0.3，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
