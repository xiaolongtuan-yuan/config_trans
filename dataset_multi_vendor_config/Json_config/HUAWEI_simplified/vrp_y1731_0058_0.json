{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1.1",
        "explanation": "进入接口 GigabitEthernet3/0/1.1 的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 200",
            "explanation": "配置接口的 VLAN 类型为 dot1q，并指定 VLAN ID 为 200",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置 CFM 版本为标准版本",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM 版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用 CFM 功能",
        "parameters": []
    },
    "cfm md [parameter1]": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
        "explanation": "进入 CFM 维护域 md3 的配置模式",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "进入 CFM 维护关联 ma3 的配置模式",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep mep-id [parameter1] interface [parameter2] vlan [parameter3] [parameter4]": {
                "template": "mep mep-id [parameter1] interface [parameter2] vlan [parameter3] [parameter4]",
                "command": "mep mep-id 3 interface GigabitEthernet3/0/1.1 vlan 200 outward",
                "explanation": "配置 MEP ID 为 3，关联接口 GigabitEthernet3/0/1.1 和 VLAN 200，方向为 outward",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 3 enable",
                "explanation": "启用 MEP ID 为 3 的 CCM 发送功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 4",
                "explanation": "配置远程 MEP ID 为 4",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 4 enable",
                "explanation": "启用远程 MEP ID 为 4 的 CCM 接收功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "test-id [parameter1] mep [parameter2] remote-mep [parameter3]": {
                "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "test-id 1 mep 3 remote-mep 4",
                "explanation": "配置测试 ID 为 1，关联 MEP ID 为 3 和远程 MEP ID 为 4",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试 ID"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程 MEP ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}