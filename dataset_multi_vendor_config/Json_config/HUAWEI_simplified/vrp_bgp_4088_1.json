{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.3.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 20",
        "explanation": "进入BGP配置模式，AS号为20",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置BGP的Router ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.1.2.1 as-number 10",
            "explanation": "配置BGP对等体10.1.2.1，AS号为10",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route [parameter1]": {
                "template": "import-route [parameter1]",
                "command": "import-route direct",
                "explanation": "引入直连路由到BGP",
                "parameters": [
                    {
                        "name": "route type",
                        "type": "string",
                        "explanation": "路由类型"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.1.2.1 enable",
                "explanation": "使能对等体10.1.2.1的IPv4单播地址族",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            },
            "peer [parameter1] as-path-filter [parameter2] export": {
                "template": "peer [parameter1] as-path-filter [parameter2] export",
                "command": "peer 10.1.2.1 as-path-filter 1 export",
                "explanation": "配置对等体10.1.2.1的出口AS路径过滤器为1",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    },
                    {
                        "name": "as-path-filter",
                        "type": "integer",
                        "explanation": "AS路径过滤器编号"
                    }
                ]
            }
        }
    },
    "ip as-path-filter [parameter1] deny [parameter2]": {
        "template": "ip as-path-filter [parameter1] deny [parameter2]",
        "command": "ip as-path-filter 1 deny _30_",
        "explanation": "配置AS路径过滤器1，拒绝包含AS30的路径",
        "parameters": [
            {
                "name": "as-path-filter",
                "type": "integer",
                "explanation": "AS路径过滤器编号"
            },
            {
                "name": "AS number",
                "type": "string",
                "explanation": "AS号"
            }
        ]
    },
    "ip as-path-filter [parameter1] permit [parameter2]": {
        "template": "ip as-path-filter [parameter1] permit [parameter2]",
        "command": "ip as-path-filter 1 permit .*",
        "explanation": "配置AS路径过滤器1，允许所有路径",
        "parameters": [
            {
                "name": "as-path-filter",
                "type": "integer",
                "explanation": "AS路径过滤器编号"
            },
            {
                "name": "regex",
                "type": "string",
                "explanation": "正则表达式"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}