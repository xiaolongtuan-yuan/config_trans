{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device1",
        "explanation": "设置设备的主机名为 'Device1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp vrid [parameter1] virtual-ip [parameter2]": {
            "template": "vrrp vrid [parameter1] virtual-ip [parameter2]",
            "command": "vrrp vrid 1 virtual-ip 10.1.1.111",
            "explanation": "配置VRRP虚拟路由器的虚拟IP地址为 10.1.1.111",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "virtual-ip",
                    "type": "IPv4",
                    "explanation": "虚拟IP地址"
                }
            ]
        },
        "vrrp vrid [parameter1] priority [parameter2]": {
            "template": "vrrp vrid [parameter1] priority [parameter2]",
            "command": "vrrp vrid 1 priority 120",
            "explanation": "设置VRRP虚拟路由器的优先级为120",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "direct-route track vrrp vrid [parameter1] degrade-cost [parameter2]": {
            "template": "direct-route track vrrp vrid [parameter1] degrade-cost [parameter2]",
            "command": "direct-route track vrrp vrid 1 degrade-cost 300",
            "explanation": "配置直接路由跟踪VRRP虚拟路由器，当VRRP状态变化时，路由成本增加300",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "degrade-cost",
                    "type": "integer",
                    "explanation": "路由成本增加值"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "default cost inherit-metric": {
            "template": "default cost inherit-metric",
            "command": "default cost inherit-metric",
            "explanation": "设置OSPF默认路由的成本继承自引入路由的度量值",
            "parameters": []
        },
        "import-route direct": {
            "template": "import-route direct",
            "command": "import-route direct",
            "explanation": "引入直连路由到OSPF",
            "parameters": []
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.3.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.3.0，子网掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    }
}