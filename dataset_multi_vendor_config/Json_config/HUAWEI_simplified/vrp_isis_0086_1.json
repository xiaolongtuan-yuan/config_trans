            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地标识符"
                }
            ]
        },
        "discriminator remote [parameter1]": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 1",
            "explanation": "设置远端BFD会话的标识符为1",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
