        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "isis bfd static": {
            "template": "isis bfd static",
            "command": "isis bfd static",
            "explanation": "在接口上启用静态BFD",
            "parameters": []
        }
    },
    "bfd btoa bind peer-ip [parameter1] interface [parameter2]": {
        "template": "bfd btoa bind peer-ip [parameter1] interface [parameter2]",
        "command": "bfd btoa bind peer-ip 10.1.1.1 interface GigabitEthernet1/0/0",
        "explanation": "配置BFD会话，绑定对端IP地址为10.1.1.1，接口为GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "discriminator local [parameter1]": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 2",
