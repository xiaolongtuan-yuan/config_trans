        "command": "ipv6",
        "explanation": "启用IPv6功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:5::1/64",
            "explanation": "配置接口的IPv6地址为2001:db8:5::1，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ipv6 route-static :: 0 GigabitEthernet1/0/0 2001:db8:5::2",
        "explanation": "配置IPv6静态路由，目的地址为::/0，下一跳为GigabitEthernet1/0/0接口，下一跳地址为2001:db8:5::2",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
