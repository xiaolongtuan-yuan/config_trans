{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ospfv3 [parameter1]": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "启用OSPFv3进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置OSPFv3进程1的Router ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8::2/64",
            "explanation": "配置接口的IPv6地址为2001:DB8::2，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "vrrp6 vrid [parameter1] virtual-ip [parameter2] link-local": {
            "template": "vrrp6 vrid [parameter1] virtual-ip [parameter2] link-local",
            "command": "vrrp6 vrid 1 virtual-ip fe80::1 link-local",
            "explanation": "配置VRRP6虚拟路由器ID为1，虚拟IPv6地址为fe80::1，类型为链路本地",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv6",
                    "explanation": "虚拟IPv6地址"
                }
            ]
        },
        "vrrp6 vrid [parameter1] virtual-ip [parameter2]": {
            "template": "vrrp6 vrid [parameter1] virtual-ip [parameter2]",
            "command": "vrrp6 vrid 1 virtual-ip 2001:DB8::100",
            "explanation": "配置VRRP6虚拟路由器ID为1，虚拟IPv6地址为2001:DB8::100",
            "parameters": [
                {
                    "name": "vrid",
                    "type": "integer",
                    "explanation": "虚拟路由器ID"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv6",
                    "explanation": "虚拟IPv6地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}