{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "选择接口GigabitEthernet1/0/1进行配置",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "启用接口的交换功能",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "配置接口为Trunk模式并允许VLAN 10通过",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md2 level 6",
        "explanation": "配置CFM域名为md2，级别为6",
        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "CFM域名称"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "CFM级别"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma2",
            "explanation": "配置维护关联名称为ma2",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "map mpls vlan [parameter1]": {
                "template": "map mpls vlan [parameter1]",
                "command": "map mpls vlan 10",
                "explanation": "映射MPLS与VLAN 10",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 61 interface gigabitEthernet1/0/1 outward",
                "explanation": "配置MEP ID为61，接口是GigabitEthernet1/0/1，方向是outward",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "ccm-interval [parameter1]": {
                "template": "ccm-interval [parameter1]",
                "command": "ccm-interval 10000",
                "explanation": "设置CCM间隔时间为10000毫秒",
                "parameters": [
                    {
                        "name": "interval time",
                        "type": "integer",
                        "explanation": "间隔时间（毫秒）"
                    }
                ]
            },
            "mep ccm-send enable": {
                "template": "mep ccm-send enable",
                "command": "mep ccm-send enable",
                "explanation": "启用MEP发送CCM",
                "parameters": []
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 62",
                "explanation": "配置远程MEP ID为62",
                "parameters": [
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive enable": {
                "template": "remote-mep ccm-receive enable",
                "command": "remote-mep ccm-receive enable",
                "explanation": "启用接收远程MEP的CCM",
                "parameters": []
            },
            "ais enable": {
                "template": "ais enable",
                "command": "ais enable",
                "explanation": "启用AIS",
                "parameters": []
            },
            "ais suppress-alarm": {
                "template": "ais suppress-alarm",
                "command": "ais suppress-alarm",
                "explanation": "抑制AIS报警",
                "parameters": []
            }
        }
    }
}