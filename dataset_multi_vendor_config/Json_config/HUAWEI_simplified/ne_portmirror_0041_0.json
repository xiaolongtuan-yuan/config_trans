{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device",
        "explanation": "设置设备的主机名为 'Device'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "设备的主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入VLAN 10的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN的标识号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口的名称"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "启用接口的二层交换功能",
            "parameters": []
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "设置接口的默认VLAN为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "默认VLAN的标识号"
                }
            ]
        },
        "port-mirroring inbound vlan [parameter1]": {
            "template": "port-mirroring inbound vlan [parameter1]",
            "command": "port-mirroring inbound vlan 10",
            "explanation": "配置端口镜像，捕获入站VLAN 10的流量",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "要镜像的VLAN的标识号"
                }
            ]
        },
        "port-mirroring to observe-index [parameter1] [parameter2]": {
            "template": "port-mirroring to observe-index [parameter1] [parameter2]",
            "command": "port-mirroring to observe-index 1 2",
            "explanation": "将镜像的流量发送到观察索引1和2",
            "parameters": [
                {
                    "name": "observe index 1",
                    "type": "integer",
                    "explanation": "第一个观察索引"
                },
                {
                    "name": "observe index 2",
                    "type": "integer",
                    "explanation": "第二个观察索引"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.10.1.1，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "接口的IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "接口的子网掩码"
                }
            ]
        },
        "port-observing observe-index [parameter1]": {
            "template": "port-observing observe-index [parameter1]",
            "command": "port-observing observe-index 1",
            "explanation": "配置接口观察指定的观察索引1",
            "parameters": [
                {
                    "name": "observe index",
                    "type": "integer",
                    "explanation": "观察索引的标识号"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级模式",
        "parameters": []
    }
}