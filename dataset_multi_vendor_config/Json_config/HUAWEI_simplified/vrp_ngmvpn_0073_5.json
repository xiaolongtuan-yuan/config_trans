{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "multicast routing-enable": {
        "template": "multicast routing-enable",
        "command": "multicast routing-enable",
        "explanation": "启用组播路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.6.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.6.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "pim sm": {
            "template": "pim sm",
            "command": "pim sm",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "igmp enable": {
            "template": "igmp enable",
            "command": "igmp enable",
            "explanation": "在接口上启用IGMP",
            "parameters": []
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65004",
        "explanation": "进入BGP配置模式，AS号为65004",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 192.168.2.2 as-number 200",
            "explanation": "配置BGP对等体，IP地址为192.168.2.2，AS号为200",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体的IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的自治系统号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "将直连路由引入到BGP中",
                "parameters": []
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 192.168.2.2 enable",
                "explanation": "启用与对等体192.168.2.2的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip",
                        "type": "IPv4",
                        "explanation": "对等体的IP地址"
                    }
                ]
            }
        }
    },
    "pim": {
        "template": "pim",
        "command": "pim",
        "explanation": "进入PIM配置模式",
        "parameters": [],
        "static-rp [parameter1]": {
            "template": "static-rp [parameter1]",
            "command": "static-rp 192.168.2.1",
            "explanation": "配置静态RP（Rendezvous Point），IP地址为192.168.2.1",
            "parameters": [
                {
                    "name": "RP ip",
                    "type": "IPv4",
                    "explanation": "RP的IP地址"
                }
            ]
        }
    },
    "msdp": {
        "template": "msdp",
        "command": "msdp",
        "explanation": "进入MSDP配置模式",
        "parameters": [],
        "peer [parameter1] connect-interface [parameter2]": {
            "template": "peer [parameter1] connect-interface [parameter2]",
            "command": "peer 192.168.2.2 connect-interface GigabitEthernet1/0/4",
            "explanation": "配置MSDP对等体，IP地址为192.168.2.2，连接接口为GigabitEthernet1/0/4",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体的IP地址"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "连接接口名"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}