{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "配置接口 GigabitEthernet1/0/1.1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 1",
            "explanation": "设置接口的VLAN类型为dot1q，VLAN ID为1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为192.168.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "dhcp select relay": {
            "template": "dhcp select relay",
            "command": "dhcp select relay",
            "explanation": "配置接口使用DHCP中继",
            "parameters": []
        },
        "ip relay address [parameter1]": {
            "template": "ip relay address [parameter1]",
            "command": "ip relay address 192.168.1.1",
            "explanation": "配置DHCP中继的上游服务器地址为192.168.1.1",
            "parameters": [
                {
                    "name": "relay address",
                    "type": "IPv4",
                    "explanation": "DHCP中继服务器地址"
                }
            ]
        }
    }
}