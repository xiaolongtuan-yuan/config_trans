{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif2",
        "explanation": "进入VLAN接口2的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.3，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2通过该Trunk端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3]": {
        "template": "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3]",
        "command": "bfd link1 bind peer-ip 10.1.1.1 interface Vlanif2",
        "explanation": "配置BFD会话link1，绑定对端IP地址10.1.1.1和接口Vlanif2",
        "parameters": [
            {
                "name": "session name",
                "type": "string",
                "explanation": "BFD会话名称"
            },
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "discriminator local [parameter1]": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 51",
            "explanation": "设置本地BFD会话的标识符为51",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地标识符"
                }
            ]
        },
        "discriminator remote [parameter1]": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 15",
            "explanation": "设置远端BFD会话的标识符为15",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}