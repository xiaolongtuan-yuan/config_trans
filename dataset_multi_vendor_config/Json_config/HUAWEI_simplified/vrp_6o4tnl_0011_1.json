{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的系统名称为“DeviceB”。",
        "parameters": [
            {
                "name": "hostname",
                "type": "字符串",
                "explanation": "设备的系统名称"
            }
        ]
    },
    "admin": {
        "template": "admin",
        "command": "admin",
        "explanation": "进入管理员视图。（注：这个命令在华为设备中可能不是标准命令，可能需要根据具体设备文档来确定其功能。）",
        "parameters": []
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入指定接口的配置模式。",
        "parameters": [
            {
                "name": "interface-name",
                "type": "字符串",
                "explanation": "接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口可能是关闭的）。",
            "parameters": []
        },
        "ip address [ip-address] [mask]": {
            "template": "ip address [ip-address] [mask]",
            "command": "ip address 2.2.2.2 255.0.0.0",
            "explanation": "配置接口的IPv4地址和子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "接口的IPv4地址"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能。",
            "parameters": []
        },
        "ipv6 address [ipv6-address]/[prefix-length]": {
            "template": "ipv6 address [ipv6-address]/[prefix-length]",
            "command": "ipv6 address 2001:db8::1/64",
            "explanation": "配置接口的IPv6地址和前缀长度。",
            "parameters": [
                {
                    "name": "ipv6-address",
                    "type": "IPv6",
                    "explanation": "接口的IPv6地址"
                },
                {
                    "name": "prefix-length",
                    "type": "整数",
                    "explanation": "前缀长度"
                }
            ]
        },
        "tunnel-protocol [protocol]": {
            "template": "tunnel-protocol [protocol]",
            "command": "tunnel-protocol ipv6-ipv4 6to4",
            "explanation": "设置隧道的协议类型为IPv6 over IPv4的6to4。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "字符串",
                    "explanation": "隧道协议类型"
                }
            ]
        },
        "source [ip-address]": {
            "template": "source [ip-address]",
            "command": "source 2.2.2.2",
            "explanation": "指定隧道的源IPv4地址。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "源IPv4地址"
                }
            ]
        }
    },
    "ipv6 route-static [destination] [prefix-length] [interface]": {
        "template": "ipv6 route-static [destination] [prefix-length] [interface]",
        "command": "ipv6 route-static 2002:: 16 Tunnel 10",
        "explanation": "配置静态IPv6路由，指向隧道接口Tunnel 10。",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的地址"
            },
            {
                "name": "prefix-length",
                "type": "整数",
                "explanation": "前缀长度"
            },
            {
                "name": "interface",
                "type": "字符串",
                "explanation": "出接口"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级视图。",
        "parameters": []
    }
}