{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip topology [parameter1]": {
        "template": "ip topology [parameter1]",
        "command": "ip topology red",
        "explanation": "配置IP拓扑为 'red'",
        "parameters": [
            {
                "name": "topology name",
                "type": "string",
                "explanation": "拓扑名称"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "进入IS-IS进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 86.0000.0000.0002.00",
            "explanation": "配置IS-IS的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "topology [parameter1] topology-id [parameter2]": {
            "template": "topology [parameter1] topology-id [parameter2]",
            "command": "topology red topology-id 10",
            "explanation": "在IS-IS中配置拓扑 'red' 的拓扑ID为10",
            "parameters": [
                {
                    "name": "topology name",
                    "type": "string",
                    "explanation": "拓扑名称"
                },
                {
                    "name": "topology id",
                    "type": "integer",
                    "explanation": "拓扑ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "ip topology [parameter1] enable": {
            "template": "ip topology [parameter1] enable",
            "command": "ip topology red enable",
            "explanation": "在接口上启用IP拓扑 'red'",
            "parameters": [
                {
                    "name": "topology name",
                    "type": "string",
                    "explanation": "拓扑名称"
                }
            ]
        },
        "isis topology [parameter1]": {
            "template": "isis topology [parameter1]",
            "command": "isis topology red",
            "explanation": "在IS-IS中配置拓扑 'red'",
            "parameters": [
                {
                    "name": "topology name",
                    "type": "string",
                    "explanation": "拓扑名称"
                }
            ]
        },
        "isis cost [parameter1]": {
            "template": "isis cost [parameter1]",
            "command": "isis cost 3",
            "explanation": "配置IS-IS接口的cost值为3",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "cost值"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回到用户视图",
        "parameters": []
    }
}