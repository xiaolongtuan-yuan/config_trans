{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::3/64",
            "explanation": "配置接口的IPv6地址为2001:db8:2::3，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ripng [parameter1] enable": {
            "template": "ripng [parameter1] enable",
            "command": "ripng 1 enable",
            "explanation": "在接口上启用RIPng进程1",
            "parameters": [
                {
                    "name": "ripng process",
                    "type": "integer",
                    "explanation": "RIPng进程号"
                }
            ]
        }
    },
    "ripng [parameter1]": {
        "template": "ripng [parameter1]",
        "command": "ripng 1",
        "explanation": "进入RIPng进程1的配置模式",
        "parameters": [
            {
                "name": "ripng process",
                "type": "integer",
                "explanation": "RIPng进程号"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}