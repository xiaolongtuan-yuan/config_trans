{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface all mode sparse",
            "explanation": "配置PIM协议在所有接口上使用稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，sparse表示稀疏模式。"
                }
            ]
        },
        "set protocols mpls label-switched-path protocol [parameter1]": {
            "template": "set protocols mpls label-switched-path protocol [parameter1]",
            "command": "set protocols mpls label-switched-path protocol ldp",
            "explanation": "配置MPLS标签交换路径使用LDP协议。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "使用的协议，ldp表示标签分发协议。"
                }
            ]
        },
        "set protocols pim interface [parameter1]": {
            "template": "set protocols pim interface [parameter1]",
            "command": "set protocols pim interface ge-1/0/0",
            "explanation": "在指定接口上启用PIM协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mpls ldp interface [parameter1]": {
            "template": "set protocols mpls ldp interface [parameter1]",
            "command": "set protocols mpls ldp interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS LDP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0",
            "explanation": "在指定区域和接口上启用OSPF协议。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 1.1.1.1",
            "explanation": "配置OSPF路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器的ID，通常为一个IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，internal表示内部。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group internal neighbor 3.3.3.3 peer-as 100",
            "explanation": "配置BGP组的邻居及其AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 1.1.1.1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址，通常为一个IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family [parameter2] [parameter3]": {
            "template": "set protocols bgp group [parameter1] family [parameter2] [parameter3]",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，inet表示IPv4。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "地址族类型，unicast表示单播。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family [parameter2]": {
            "template": "set protocols bgp group [parameter1] family [parameter2]",
            "command": "set protocols bgp group internal family inet-vpn",
            "explanation": "配置BGP组的地址族为IPv4 VPN。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族，inet-vpn表示IPv4 VPN。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}