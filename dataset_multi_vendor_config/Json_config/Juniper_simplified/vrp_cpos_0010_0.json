{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis fpc [parameter1] pic [parameter2] channelized-t1 controller [parameter3] timeslots [parameter4] channel-group [parameter5]": {
            "template": "set chassis fpc [parameter1] pic [parameter2] channelized-t1 controller [parameter3] timeslots [parameter4] channel-group [parameter5]",
            "command": "set chassis fpc 3 pic 0 channelized-t1 controller 0 timeslots 1-10 channel-group 1",
            "explanation": "配置FPC上的PIC的T1控制器的时间槽到指定的通道组。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "FPC（Flexible PIC Concentrator）的编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC（Physical Interface Card）的编号。"
                },
                {
                    "name": "controller",
                    "type": "integer",
                    "explanation": "控制器的编号。"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "时间槽的范围，例如1-10。"
                },
                {
                    "name": "channel-group",
                    "type": "integer",
                    "explanation": "通道组的编号。"
                }
            ]
        },
        "set chassis fpc [parameter1] pic [parameter2] channelized-t1 controller [parameter3] no shutdown": {
            "template": "set chassis fpc [parameter1] pic [parameter2] channelized-t1 controller [parameter3] no shutdown",
            "command": "set chassis fpc 3 pic 0 channelized-t1 controller 0 no shutdown",
            "explanation": "启用FPC上的PIC的T1控制器。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "FPC（Flexible PIC Concentrator）的编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC（Physical Interface Card）的编号。"
                },
                {
                    "name": "controller",
                    "type": "integer",
                    "explanation": "控制器的编号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces se-3/0/0/1:1 encapsulation ppp",
            "explanation": "配置接口的封装类型为PPP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如se-3/0/0/1:1。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如PPP。"
                }
            ]
        },
        "set interfaces [parameter1] ppp multilink group [parameter2]": {
            "template": "set interfaces [parameter1] ppp multilink group [parameter2]",
            "command": "set interfaces se-3/0/0/1:1 ppp multilink group 1",
            "explanation": "配置接口的PPP多链路组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如se-3/0/0/1:1。"
                },
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "多链路组的编号。"
                }
            ]
        },
        "set interfaces [parameter1]": {
            "template": "set interfaces [parameter1]",
            "command": "set interfaces multilink1",
            "explanation": "创建或选择多链路接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "多链路接口名称，例如multilink1。"
                }
            ]
        }
    }
}