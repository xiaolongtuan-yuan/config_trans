{
    "host-name": {
        "template": "host-name",
        "host-name [parameter1]": {
            "template": "host-name [parameter1]",
            "command": "host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface": {
        "template": "interface",
        "interface [parameter1]": {
            "template": "interface [parameter1]",
            "command": "interface ge-0/0/0.1",
            "explanation": "进入指定接口的配置模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.1。"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口。",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置接口的封装类型为802.1Q，并指定VLAN ID。",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的虚拟局域网。"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IP地址及子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IP地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "子网掩码，用于定义IP地址的网络部分和主机部分。"
                }
            ]
        }
    }
}