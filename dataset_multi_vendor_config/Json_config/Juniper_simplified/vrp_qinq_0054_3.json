{
    "hostname": {
        "template": "hostname",
        "hostname [parameter1]": {
            "template": "hostname [parameter1]",
            "command": "hostname CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface": {
        "template": "interface",
        "interface [parameter1]": {
            "template": "interface [parameter1]",
            "command": "interface GigabitEthernet1/0/1.1",
            "explanation": "进入接口配置模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如GigabitEthernet1/0/1.1。"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口。",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "IPv4子网掩码。"
                }
            ]
        }
    },
    "router bgp": {
        "template": "router bgp",
        "router bgp [parameter1]": {
            "template": "router bgp [parameter1]",
            "command": "router bgp 65410",
            "explanation": "进入BGP配置模式，并指定本地自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "本地自治系统号。"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 192.168.1.1 remote-as 100",
            "explanation": "配置BGP邻居及其远程自治系统号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的远程自治系统号。"
                }
            ]
        }
    },
    "address-family ipv4 unicast": {
        "template": "address-family ipv4 unicast",
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入IPv4单播地址族配置模式。",
            "parameters": []
        },
        "no synchronization": {
            "template": "no synchronization",
            "command": "no synchronization",
            "explanation": "禁用BGP同步。",
            "parameters": []
        },
        "redistribute connected": {
            "template": "redistribute connected",
            "command": "redistribute connected",
            "explanation": "将直连路由重分发到BGP中。",
            "parameters": []
        },
        "neighbor [parameter1] activate": {
            "template": "neighbor [parameter1] activate",
            "command": "neighbor 192.168.1.1 activate",
            "explanation": "激活BGP邻居的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "end": {
            "template": "end",
            "command": "end",
            "explanation": "退出配置模式。",
            "parameters": []
        }
    }
}