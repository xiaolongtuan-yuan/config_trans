{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-switched-path protocol [parameter1]": {
            "template": "set protocols mpls label-switched-path protocol [parameter1]",
            "command": "set protocols mpls label-switched-path protocol ldp",
            "explanation": "配置MPLS标签交换路径的协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型，例如LDP。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1] force": {
            "template": "set protocols mpls ldp router-id [parameter1] force",
            "command": "set protocols mpls ldp router-id lo0.1 force",
            "explanation": "强制配置LDP的路由器ID为指定的环回接口。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器ID，通常为环回接口地址。"
                }
            ]
        },
        "set protocols mpls traffic-engineering tunnels": {
            "template": "set protocols mpls traffic-engineering tunnels",
            "command": "set protocols mpls traffic-engineering tunnels",
            "explanation": "启用MPLS流量工程的隧道功能。",
            "parameters": []
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 2 wide-metrics-only",
            "explanation": "配置IS-IS协议的级别2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，例如1或2。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 49.0005.0000.0000.0003.00",
            "explanation": "配置IS-IS协议的网络实体标题。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体标题，用于标识IS-IS域。"
                }
            ]
        },
        "set protocols isis traffic-engineering level-[parameter1]": {
            "template": "set protocols isis traffic-engineering level-[parameter1]",
            "command": "set protocols isis traffic-engineering level-2",
            "explanation": "在IS-IS协议的级别2启用流量工程。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，例如1或2。"
                }
            ]
        },
        "set protocols isis segment-routing mpls": {
            "template": "set protocols isis segment-routing mpls",
            "command": "set protocols isis segment-routing mpls",
            "explanation": "启用IS-IS协议的段路由MPLS功能。",
            "parameters": []
        },
        "set protocols isis segment-routing prefix-sid index [parameter1]": {
            "template": "set protocols isis segment-routing prefix-sid index [parameter1]",
            "command": "set protocols isis segment-routing prefix-sid index 30",
            "explanation": "配置IS-IS协议的段路由前缀SID索引。",
            "parameters": [
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "前缀SID的索引值。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-1/0/0 point-to-point",
            "explanation": "配置IS-IS接口为点对点类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/0",
            "explanation": "在指定接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mpls traffic-engineering bandwidth [parameter1]": {
            "template": "set protocols mpls traffic-engineering bandwidth [parameter1]",
            "command": "set protocols mpls traffic-engineering bandwidth 100000",
            "explanation": "配置MPLS流量工程的带宽。",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "带宽值，单位为kbps。"
                }
            ]
        },
        "set protocols mpls traffic-engineering bc0 [parameter1]": {
            "template": "set protocols mpls traffic-engineering bc0 [parameter1]",
            "command": "set protocols mpls traffic-engineering bc0 100000",
            "explanation": "配置MPLS流量工程的BC0带宽。",
            "parameters": [
                {
                    "name": "bc0",
                    "type": "integer",
                    "explanation": "BC0带宽值，单位为kbps。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface lo0.1",
            "explanation": "在指定环回接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "环回接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols isis prefix-sid index [parameter1]": {
            "template": "set protocols isis prefix-sid index [parameter1]",
            "command": "set protocols isis prefix-sid index 30",
            "explanation": "配置IS-IS协议的前缀SID索引。",
            "parameters": [
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "前缀SID的索引值。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}