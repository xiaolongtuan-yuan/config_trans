{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE4",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols ldp router-id [parameter1] force": {
            "template": "set protocols ldp router-id [parameter1] force",
            "command": "set protocols ldp router-id loopback0 force",
            "explanation": "强制使用指定的接口作为LDP的router-id。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "指定作为LDP router-id的接口名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2] local-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] type [parameter2] local-as [parameter3]",
            "command": "set protocols bgp group internal type internal local-as 100",
            "explanation": "配置BGP内部组，指定本地AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，internal表示内部组。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-address [parameter2] as [parameter3] update-source [parameter4]": {
            "template": "set protocols bgp group [parameter1] peer-address [parameter2] as [parameter3] update-source [parameter4]",
            "command": "set protocols bgp group internal peer-address 3.3.3.3 as 100 update-source loopback0",
            "explanation": "配置BGP内部组的对等体地址，AS号及更新源。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "as",
                    "type": "integer",
                    "explanation": "对等体的AS号。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "指定更新源接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] activate": {
            "template": "set protocols bgp group [parameter1] activate",
            "command": "set protocols bgp group internal activate",
            "explanation": "激活BGP内部组。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] send-community": {
            "template": "set protocols bgp group [parameter1] send-community",
            "command": "set protocols bgp group internal send-community",
            "explanation": "配置BGP内部组发送community属性。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/1",
            "explanation": "配置OSPF区域0下的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 192.168.6.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ip": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ip",
            "command": "set interfaces ge-1/0/1 unit 0 family mpls ip",
            "explanation": "配置接口的MPLS IP家族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans v1 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set vlans [parameter1] l2-vpn instance [parameter2]": {
            "template": "set vlans [parameter1] l2-vpn instance [parameter2]",
            "command": "set vlans v1 l2-vpn instance v1",
            "explanation": "配置VLAN的L2VPN实例。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "l2-vpn-instance",
                    "type": "string",
                    "explanation": "L2VPN实例的名称。"
                }
            ]
        }
    },
    "set routing-instance": {
        "template": "set routing-instance",
        "set routing-instance [parameter1] l2-vpn addressing-mode [parameter2]": {
            "template": "set routing-instance [parameter1] l2-vpn addressing-mode [parameter2]",
            "command": "set routing-instance v1 l2-vpn addressing-mode unicast",
            "explanation": "配置路由实例的L2VPN地址模式为单播。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "addressing-mode",
                    "type": "string",
                    "explanation": "地址模式，unicast表示单播。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] interfaces [parameter2] unit [parameter3] family mpls ip": {
            "template": "set routing-instances [parameter1] interfaces [parameter2] unit [parameter3] family mpls ip",
            "command": "set routing-instances v1 interfaces ge-1/0/1 unit 0 family mpls ip",
            "explanation": "配置路由实例下的接口MPLS IP家族。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options direct-forwarding routing-instances [parameter1] enable": {
            "template": "set forwarding-options direct-forwarding routing-instances [parameter1] enable",
            "command": "set forwarding-options direct-forwarding routing-instances v1 enable",
            "explanation": "启用路由实例的直接转发功能。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                }
            ]
        }
    }
}