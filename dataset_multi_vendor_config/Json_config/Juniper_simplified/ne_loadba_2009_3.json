{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name routerD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 1",
            "explanation": "配置IS-IS协议的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0004.00",
            "explanation": "配置IS-IS协议的网络实体标题。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "IS-IS协议的网络实体标题，用于标识网络中的设备。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-1/0/0.0",
            "explanation": "在指定接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.50.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family iso": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso",
            "command": "set interfaces ge-1/0/0 unit 0 family iso",
            "explanation": "配置接口支持ISO协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}