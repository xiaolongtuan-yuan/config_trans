{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，'all'表示所有接口。"
                }
            ]
        },
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols isis level [parameter1] enable": {
            "template": "set protocols isis level [parameter1] enable",
            "command": "set protocols isis level 1 enable",
            "explanation": "在ISIS协议的level 1上启用。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，1表示level 1。"
                }
            ]
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 1 wide-metrics-only",
            "explanation": "在ISIS协议的level 1上仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，1表示level 1。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用ISIS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，'all'表示所有接口。"
                }
            ]
        },
        "set protocols isis interface [parameter1] passive": {
            "template": "set protocols isis interface [parameter1] passive",
            "command": "set protocols isis interface lo0.1 passive",
            "explanation": "将指定接口设置为ISIS协议的被动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols isis level [parameter1] router-id [parameter2]": {
            "template": "set protocols isis level [parameter1] router-id [parameter2]",
            "command": "set protocols isis level 1 router-id 4.4.4.9",
            "explanation": "为ISIS协议的level 1设置路由器ID。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，1表示level 1。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        },
        "set protocols isis level [parameter1] network [parameter2]": {
            "template": "set protocols isis level [parameter1] network [parameter2]",
            "command": "set protocols isis level 1 network 49.0000.0000.0000.0004.00",
            "explanation": "为ISIS协议的level 1设置网络地址。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，1表示level 1。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址，用于标识网络。"
                }
            ]
        },
        "set protocols traffic-engineering mpls router-id [parameter1]": {
            "template": "set protocols traffic-engineering mpls router-id [parameter1]",
            "command": "set protocols traffic-engineering mpls router-id lo0.1",
            "explanation": "为MPLS流量工程设置路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        },
        "set protocols segment-routing mpls": {
            "template": "set protocols segment-routing mpls",
            "command": "set protocols segment-routing mpls",
            "explanation": "启用MPLS段路由。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.13.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}