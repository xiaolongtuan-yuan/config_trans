{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd interface [parameter1] minimum-interval [parameter2]": {
            "template": "set protocols bfd interface [parameter1] minimum-interval [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 minimum-interval 200",
            "explanation": "配置BFD协议在指定接口上的最小间隔时间。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "BFD协议的最小间隔时间，单位为毫秒。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] multiplier [parameter2]": {
            "template": "set protocols bfd interface [parameter1] multiplier [parameter2]",
            "command": "set protocols bfd interface ge-1/0/0 multiplier 3",
            "explanation": "配置BFD协议在指定接口上的乘数。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD协议的乘数，用于计算检测时间。"
                }
            ]
        },
        "set protocols bfd interface [parameter1] no-echo": {
            "template": "set protocols bfd interface [parameter1] no-echo",
            "command": "set protocols bfd interface ge-1/0/0 no-echo",
            "explanation": "配置BFD协议在指定接口上不使用echo功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    }
}