{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1]": {
            "template": "set bridge-domains [parameter1]",
            "command": "set bridge-domains 10",
            "explanation": "配置桥接域。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域的编号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-1/0/1 enable",
            "explanation": "启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 family ethernet-switching vlan members 10",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，标识VLAN成员。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching bridge-domain [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching bridge-domain [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 family ethernet-switching bridge-domain 10",
            "explanation": "配置接口的以太网交换桥接域。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域的编号。"
                }
            ]
        }
    }
}