{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE4",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.4.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "delete interfaces": {
        "template": "delete interfaces",
        "delete interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "delete interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "delete interfaces ge-0/0/0 unit 0 family ethernet-switching",
            "explanation": "删除接口的以太网交换配置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 10.4.1.1",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        },
        "set routing-options bgp自主路由管理进程": {
            "template": "set routing-options bgp自主路由管理进程",
            "command": "set routing-options bgp自主路由管理进程",
            "explanation": "配置BGP自主路由管理进程。",
            "parameters": []
        },
        "set routing-options bgp autonomous-system [parameter1]": {
            "template": "set routing-options bgp autonomous-system [parameter1]",
            "command": "set routing-options bgp autonomous-system 65440",
            "explanation": "配置BGP的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "BGP的自治系统号，用于标识自治系统。"
                }
            ]
        },
        "set routing-options neighbors [parameter1] peer-as [parameter2]": {
            "template": "set routing-options neighbors [parameter1] peer-as [parameter2]",
            "command": "set routing-options neighbors 10.4.1.2 peer-as 100",
            "explanation": "配置BGP邻居的自治系统号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的自治系统号。"
                }
            ]
        },
        "delete routing-options protocols bgp": {
            "template": "delete routing-options protocols bgp",
            "command": "delete routing-options protocols bgp",
            "explanation": "删除BGP协议配置。",
            "parameters": []
        },
        "set routing-options protocols bgp dampening": {
            "template": "set routing-options protocols bgp dampening",
            "command": "set routing-options protocols bgp dampening",
            "explanation": "配置BGP协议的阻尼功能。",
            "parameters": []
        },
        "set routing-options protocols bgp group [parameter1] type [parameter2]": {
            "template": "set routing-options protocols bgp group [parameter1] type [parameter2]",
            "command": "set routing-options protocols bgp group external type internal",
            "explanation": "配置BGP协议组的类型。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP协议组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP协议组的类型，例如internal。"
                }
            ]
        },
        "set routing-options protocols static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options protocols static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options protocols static route 0.0.0.0/0 next-hop 10.4.1.2",
            "explanation": "配置静态路由的下一跳地址。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目的地址。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "静态路由的下一跳地址。"
                }
            ]
        }
    }
}