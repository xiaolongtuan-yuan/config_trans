{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name client002",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services [parameter1]": {
            "template": "set system services [parameter1]",
            "command": "set system services ssh",
            "explanation": "启用SSH服务。",
            "parameters": [
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "启用的服务名称，例如ssh。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.3.3/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set security zones": {
        "template": "set security zones",
        "set security zones security-zone [parameter1] interfaces [parameter2] host-inbound-traffic system-services [parameter3]": {
            "template": "set security zones security-zone [parameter1] interfaces [parameter2] host-inbound-traffic system-services [parameter3]",
            "command": "set security zones security-zone trust interfaces ge-0/0/0.0 host-inbound-traffic system-services ssh",
            "explanation": "配置安全区域允许的入站流量服务。",
            "parameters": [
                {
                    "name": "security-zone",
                    "type": "string",
                    "explanation": "安全区域名称，例如trust。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "允许的入站流量服务名称，例如ssh。"
                }
            ]
        },
        "set security zones security-zone [parameter1] interfaces [parameter2]": {
            "template": "set security zones security-zone [parameter1] interfaces [parameter2]",
            "command": "set security zones security-zone trust interfaces ge-0/0/0.0",
            "explanation": "将接口分配到指定的安全区域。",
            "parameters": [
                {
                    "name": "security-zone",
                    "type": "string",
                    "explanation": "安全区域名称，例如trust。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        }
    }
}