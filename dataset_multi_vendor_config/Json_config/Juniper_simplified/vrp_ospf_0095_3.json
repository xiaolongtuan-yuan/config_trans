{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 4.4.4.4",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        },
        "set routing-options static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options static route 10.0.0.0/8 next-hop null0",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，null0表示丢弃数据包。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet ospf area [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet ospf area [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet ospf area 0.0.0.2",
            "explanation": "配置接口的OSPF区域。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                }
            ]
        }
    },
    "set routing protocols": {
        "template": "set routing protocols",
        "set routing protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set routing protocols ospf area [parameter1] interface [parameter2]",
            "command": "set routing protocols ospf area 0.0.0.2 interface ge-0/0/0.0",
            "explanation": "配置OSPF区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set routing protocols ospf area [parameter1] network [parameter2]": {
            "template": "set routing protocols ospf area [parameter1] network [parameter2]",
            "command": "set routing protocols ospf area 0.0.0.2 network 192.168.2.0/24",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    }
}