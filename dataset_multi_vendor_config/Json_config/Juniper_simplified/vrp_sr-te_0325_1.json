{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp label-protocol": {
            "template": "set protocols mpls ldp label-protocol",
            "command": "set protocols mpls ldp label-protocol",
            "explanation": "启用MPLS LDP标签协议。",
            "parameters": []
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 2.2.2.2",
            "explanation": "配置MPLS LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP的路由器ID。"
                }
            ]
        },
        "set protocols isis level [parameter1] metric-style [parameter2]": {
            "template": "set protocols isis level [parameter1] metric-style [parameter2]",
            "command": "set protocols isis level 2-only metric-style wide",
            "explanation": "配置IS-IS协议的级别和度量风格。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "metric-style",
                    "type": "string",
                    "explanation": "IS-IS协议的度量风格。"
                }
            ]
        },
        "set protocols isis traffic-engineering router-id [parameter1]": {
            "template": "set protocols isis traffic-engineering router-id [parameter1]",
            "command": "set protocols isis traffic-engineering router-id lo0",
            "explanation": "配置IS-IS流量工程的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "IS-IS流量工程的路由器ID。"
                }
            ]
        },
        "set protocols isis traffic-engineering level [parameter1]": {
            "template": "set protocols isis traffic-engineering level [parameter1]",
            "command": "set protocols isis traffic-engineering level 2",
            "explanation": "配置IS-IS流量工程的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS流量工程的级别。"
                }
            ]
        },
        "set protocols isis traffic-engineering area [parameter1]": {
            "template": "set protocols isis traffic-engineering area [parameter1]",
            "command": "set protocols isis traffic-engineering area 0",
            "explanation": "配置IS-IS流量工程的区域。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "IS-IS流量工程的区域。"
                }
            ]
        },
        "set protocols isis traffic-engineering segment-routing": {
            "template": "set protocols isis traffic-engineering segment-routing",
            "command": "set protocols isis traffic-engineering segment-routing",
            "explanation": "启用IS-IS流量工程的段路由功能。",
            "parameters": []
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp group 100 neighbor 10.2.1.2 remote-as 100",
            "explanation": "配置BGP协议的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast": {
            "template": "set protocols bgp group [parameter1] family inet unicast",
            "command": "set protocols bgp group 100 family inet unicast",
            "explanation": "配置BGP协议的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast neighbor [parameter2] activate": {
            "template": "set protocols bgp group [parameter1] family inet unicast neighbor [parameter2] activate",
            "command": "set protocols bgp group 100 family inet unicast neighbor 10.2.1.2 activate",
            "explanation": "激活BGP协议的IPv4单播地址族的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "BGP组的编号。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 2",
            "explanation": "配置IS-IS协议的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                }
            ]
        },
        "set protocols isis segment-routing mpls": {
            "template": "set protocols isis segment-routing mpls",
            "command": "set protocols isis segment-routing mpls",
            "explanation": "启用IS-IS协议的段路由MPLS功能。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 mpls",
            "explanation": "配置接口的IPv6 MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options mpls label-range [parameter1] [parameter2]": {
            "template": "set routing-options mpls label-range [parameter1] [parameter2]",
            "command": "set routing-options mpls label-range 100000 199999",
            "explanation": "配置MPLS标签范围。",
            "parameters": [
                {
                    "name": "start-label",
                    "type": "integer",
                    "explanation": "MPLS标签范围的起始标签。"
                },
                {
                    "name": "end-label",
                    "type": "integer",
                    "explanation": "MPLS标签范围的结束标签。"
                }
            ]
        }
    }
}