{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name UPE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 1 family inet address 1.1.1.9/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] deactivate": {
            "template": "set interfaces [parameter1] deactivate",
            "command": "set interfaces ge-0/0/0 deactivate",
            "explanation": "停用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching vlan members 10",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "integer",
                    "explanation": "VLAN成员ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 10 vlan-id 10",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 10 encapsulation vlan-ccc",
            "explanation": "配置接口单元的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-ccc。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 10 family mpls",
            "explanation": "配置接口单元的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如mpls。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，例如all表示所有接口。"
                }
            ]
        },
        "set protocols ldp": {
            "template": "set protocols ldp",
            "set protocols ldp": {
                "template": "set protocols ldp",
                "command": "set protocols ldp",
                "explanation": "启用LDP协议。",
                "parameters": []
            },
            "set protocols ldp interface [parameter1]": {
                "template": "set protocols ldp interface [parameter1]",
                "command": "set protocols ldp interface ge-0/0/1.0",
                "explanation": "在指定接口上启用LDP协议。",
                "parameters": [
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口名称，例如ge-0/0/1.0。"
                    }
                ]
            },
            "set protocols ldp neighbor [parameter1]": {
                "template": "set protocols ldp neighbor [parameter1]",
                "command": "set protocols ldp neighbor 3.3.3.9",
                "explanation": "配置LDP邻居。",
                "parameters": [
                    {
                        "name": "neighbor-ip",
                        "type": "string",
                        "explanation": "LDP邻居的IP地址。"
                    }
                ]
            }
        },
        "set protocols ospf": {
            "template": "set protocols ospf",
            "set protocols ospf area [parameter1] interface [parameter2]": {
                "template": "set protocols ospf area [parameter1] interface [parameter2]",
                "command": "set protocols ospf area 0.0.0.0 interface lo0.1",
                "explanation": "在指定接口上启用OSPF协议，并指定区域。",
                "parameters": [
                    {
                        "name": "area",
                        "type": "string",
                        "explanation": "OSPF区域ID。"
                    },
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口名称，例如lo0.1。"
                    }
                ]
            }
        }
    }
}