{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Spine2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] address-family inet address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] address-family inet address [parameter2]/[parameter3]",
            "command": "set interfaces gigebit-ethernet1/0/0 address-family inet address 192.168.30.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigebit-ethernet1/0/0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] address [parameter2]/[parameter3]",
            "command": "set interfaces lo0 address 4.4.4.4/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] routing-options static route [parameter2] next-hop [parameter3]": {
            "template": "set routing-instances [parameter1] routing-options static route [parameter2] next-hop [parameter3]",
            "command": "set routing-instances default-instance routing-options static route 0.0.0.0/0 next-hop 192.168.30.2",
            "explanation": "配置静态路由，指定下一跳地址。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称，例如default-instance。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 192.168.30.0/24",
            "explanation": "配置OSPF协议，指定区域和网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    }
}