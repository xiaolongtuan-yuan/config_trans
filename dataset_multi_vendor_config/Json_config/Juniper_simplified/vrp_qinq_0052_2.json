{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id-list [parameter2]": {
            "template": "set vlans [parameter1] vlan-id-list [parameter2]",
            "command": "set vlans vlan1-1000 vlan-id-list [ 1-1000 ]",
            "explanation": "配置VLAN的ID范围。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id-list",
                    "type": "range",
                    "explanation": "VLAN ID的范围。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode access",
            "explanation": "配置接口的以太网交换模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如access或trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan7",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员，例如vlan7。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id-stack [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id-stack [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 vlan-id-stack 1",
            "explanation": "配置接口的VLAN ID堆栈。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id-stack",
                    "type": "integer",
                    "explanation": "VLAN ID堆栈。"
                }
            ]
        }
    }
}