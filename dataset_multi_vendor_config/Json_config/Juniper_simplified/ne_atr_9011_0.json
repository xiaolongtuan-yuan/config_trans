{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Server1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system ptp mode [parameter1]": {
            "template": "set system ptp mode [parameter1]",
            "command": "set system ptp mode boundary",
            "explanation": "配置PTP（精确时间协议）模式为边界时钟模式。",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PTP模式，例如boundary表示边界时钟模式。"
                }
            ]
        },
        "set system ptp domain [parameter1]": {
            "template": "set system ptp domain [parameter1]",
            "command": "set system ptp domain 45",
            "explanation": "配置PTP域编号。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域编号，用于区分不同的PTP域。"
                }
            ]
        },
        "set system ptp clock-class [parameter1]": {
            "template": "set system ptp clock-class [parameter1]",
            "command": "set system ptp clock-class 248",
            "explanation": "配置PTP时钟的类别。",
            "parameters": [
                {
                    "name": "clock-class",
                    "type": "integer",
                    "explanation": "PTP时钟的类别，影响时钟的优先级。"
                }
            ]
        },
        "set system ptp priority1 [parameter1]": {
            "template": "set system ptp priority1 [parameter1]",
            "command": "set system ptp priority1 128",
            "explanation": "配置PTP优先级1。",
            "parameters": [
                {
                    "name": "priority1",
                    "type": "integer",
                    "explanation": "PTP优先级1，用于时钟选举。"
                }
            ]
        },
        "set system ptp priority2 [parameter1]": {
            "template": "set system ptp priority2 [parameter1]",
            "command": "set system ptp priority2 128",
            "explanation": "配置PTP优先级2。",
            "parameters": [
                {
                    "name": "priority2",
                    "type": "integer",
                    "explanation": "PTP优先级2，用于时钟选举。"
                }
            ]
        },
        "set system ptp unicast-negotiation": {
            "template": "set system ptp unicast-negotiation",
            "command": "set system ptp unicast-negotiation",
            "explanation": "启用PTP单播协商。",
            "parameters": []
        },
        "set system ptp dscp [parameter1]": {
            "template": "set system ptp dscp [parameter1]",
            "command": "set system ptp dscp 60",
            "explanation": "配置PTP消息的DSCP值。",
            "parameters": [
                {
                    "name": "dscp",
                    "type": "integer",
                    "explanation": "DSCP值，用于QoS标记PTP消息。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 1.1.1.1/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching",
            "explanation": "配置接口为以太网交换模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] ptp": {
            "template": "set interfaces [parameter1] ptp",
            "command": "set interfaces ge-1/0/0 ptp",
            "explanation": "在接口上启用PTP功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    }
}