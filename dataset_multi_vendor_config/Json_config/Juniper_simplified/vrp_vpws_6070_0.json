{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces vlan-10 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如vlan-10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] switchport mode [parameter2]": {
            "template": "set interfaces [parameter1] switchport mode [parameter2]",
            "command": "set interfaces gigabitethernet0/0/0 switchport mode trunk",
            "explanation": "配置接口为trunk模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet0/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] switchport trunk allowed-vlans add [parameter2]": {
            "template": "set interfaces [parameter1] switchport trunk allowed-vlans add [parameter2]",
            "command": "set interfaces gigabitethernet0/0/0 switchport trunk allowed-vlans add 10",
            "explanation": "配置trunk接口允许的VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet0/0/0。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "允许通过的VLAN ID。"
                }
            ]
        },
        "disable interfaces [parameter1]": {
            "template": "disable interfaces [parameter1]",
            "command": "disable interfaces gigabitethernet0/0/0",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet0/0/0。"
                }
            ]
        }
    },
    "set ethernetcfm": {
        "template": "set ethernetcfm",
        "set ethernetcfm mdt [parameter1]": {
            "template": "set ethernetcfm mdt [parameter1]",
            "command": "set ethernetcfm mdt md-md-1",
            "explanation": "配置以太网CFM的MDT（Maintenance Domain Test）。",
            "parameters": [
                {
                    "name": "mdt-name",
                    "type": "string",
                    "explanation": "MDT名称，例如md-md-1。"
                }
            ]
        },
        "set ethernetcfm management-agent [parameter1]": {
            "template": "set ethernetcfm management-agent [parameter1]",
            "command": "set ethernetcfm management-agent ma-ma-1",
            "explanation": "配置以太网CFM的管理代理。",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "管理代理名称，例如ma-ma-1。"
                }
            ]
        },
        "set ethernetcfm mep-domain [parameter1] mep-id [parameter2]": {
            "template": "set ethernetcfm mep-domain [parameter1] mep-id [parameter2]",
            "command": "set ethernetcfm mep-domain vlan-10 mep-id 2",
            "explanation": "配置以太网CFM的MEP（Maintenance End Point）域和ID。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "MEP域，例如vlan-10。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP ID，用于标识MEP。"
                }
            ]
        },
        "set ethernetcfm mep-control-plane [parameter1]": {
            "template": "set ethernetcfm mep-control-plane [parameter1]",
            "command": "set ethernetcfm mep-control-plane ccm-send",
            "explanation": "配置以太网CFM的MEP控制平面为CCM发送模式。",
            "parameters": [
                {
                    "name": "control-plane",
                    "type": "string",
                    "explanation": "控制平面模式，例如ccm-send。"
                }
            ]
        },
        "set ethernetcfm remote-mep-id [parameter1]": {
            "template": "set ethernetcfm remote-mep-id [parameter1]",
            "command": "set ethernetcfm remote-mep-id 1",
            "explanation": "配置以太网CFM的远程MEP ID。",
            "parameters": [
                {
                    "name": "remote-mep-id",
                    "type": "integer",
                    "explanation": "远程MEP ID，用于标识远程MEP。"
                }
            ]
        },
        "set ethernetcfm ethernetcfm mep-control-plane [parameter1]": {
            "template": "set ethernetcfm ethernetcfm mep-control-plane [parameter1]",
            "command": "set ethernetcfm ethernetcfm mep-control-plane ccm-receive",
            "explanation": "配置以太网CFM的MEP控制平面为CCM接收模式。",
            "parameters": [
                {
                    "name": "control-plane",
                    "type": "string",
                    "explanation": "控制平面模式，例如ccm-receive。"
                }
            ]
        }
    }
}