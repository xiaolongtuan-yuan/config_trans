{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.10.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls te": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls te",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls te",
            "explanation": "在接口上启用MPLS流量工程。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls rsvp-te": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls rsvp-te",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls rsvp-te",
            "explanation": "在接口上启用MPLS RSVP-TE。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set ospf": {
        "template": "set ospf",
        "set ospf [parameter1] area [parameter2] network [parameter3]/[parameter4] opaque-capability enable": {
            "template": "set ospf [parameter1] area [parameter2] network [parameter3]/[parameter4] opaque-capability enable",
            "command": "set ospf 1 area 0.0.0.0 network 2.2.2.9/32 opaque-capability enable",
            "explanation": "在OSPF区域中启用不透明LSA能力。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例编号。"
                },
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及子网掩码。"
                }
            ]
        },
        "set ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set ospf 1 area 0.0.0.0 network 10.10.1.0/24",
            "explanation": "在OSPF区域中宣告网络。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例编号。"
                },
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及子网掩码。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label protocol [parameter1]": {
            "template": "set protocols mpls label protocol [parameter1]",
            "command": "set protocols mpls label protocol ldp",
            "explanation": "配置MPLS标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS IP功能。",
            "parameters": []
        },
        "set protocols mpls traffic-eng tunnels": {
            "template": "set protocols mpls traffic-eng tunnels",
            "command": "set protocols mpls traffic-eng tunnels",
            "explanation": "启用MPLS流量工程隧道功能。",
            "parameters": []
        }
    },
    "set routes": {
        "template": "set routes",
        "set routes static route [parameter1]/[parameter2] next-hop [parameter3] distance [parameter4]": {
            "template": "set routes static route [parameter1]/[parameter2] next-hop [parameter3] distance [parameter4]",
            "command": "set routes static route 0.0.0.0/0 next-hop 10.10.1.2 distance 1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的网络地址及子网掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                },
                {
                    "name": "distance",
                    "type": "integer",
                    "explanation": "路由的管理距离。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options ospf area [parameter1] opaque-capability enable": {
            "template": "set routing-options ospf area [parameter1] opaque-capability enable",
            "command": "set routing-options ospf area 0 opaque-capability enable",
            "explanation": "在OSPF区域中启用不透明LSA能力。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域ID。"
                }
            ]
        },
        "set routing-options area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set routing-options area [parameter1] network [parameter2]/[parameter3]",
            "command": "set routing-options area 0 network 2.2.2.9/32",
            "explanation": "在OSPF区域中宣告网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及子网掩码。"
                }
            ]
        },
        "set routing-options mpls traffic-eng area [parameter1]": {
            "template": "set routing-options mpls traffic-eng area [parameter1]",
            "command": "set routing-options mpls traffic-eng area 0",
            "explanation": "在OSPF区域中启用MPLS流量工程。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域ID。"
                }
            ]
        }
    }
}