{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis fpc [parameter1] pic [parameter2] port [parameter3] no-disable": {
            "template": "set chassis fpc [parameter1] pic [parameter2] port [parameter3] no-disable",
            "command": "set chassis fpc 0 pic 0 port 2 no-disable",
            "explanation": "配置指定FPC、PIC和端口不禁用。",
            "parameters": [
                {
                    "name": "fpc",
                    "type": "integer",
                    "explanation": "FPC（Flexible PIC Concentrator）编号。"
                },
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC（Physical Interface Card）编号。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "端口编号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols lldp interface [parameter1]": {
            "template": "set protocols lldp interface [parameter1]",
            "command": "set protocols lldp interface all",
            "explanation": "在所有接口上启用LLDP（Link Layer Discovery Protocol）。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口范围，'all'表示所有接口。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改，使其生效。",
            "parameters": []
        }
    }
}