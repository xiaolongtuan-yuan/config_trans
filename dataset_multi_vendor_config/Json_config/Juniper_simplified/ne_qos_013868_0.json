{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-1/0/0 mode sparse",
            "explanation": "配置PIM协议在指定接口上的模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM协议的模式，例如sparse。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] join-group [parameter2]": {
            "template": "set protocols igmp interface [parameter1] join-group [parameter2]",
            "command": "set protocols igmp interface ge-1/0/0 join-group 239.0.0.1",
            "explanation": "配置IGMP协议在指定接口上加入指定的组播组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "group-address",
                    "type": "string",
                    "explanation": "组播组地址，例如239.0.0.1。"
                }
            ]
        },
        "set protocols pim join-filter [parameter1] prefix-list [parameter2]": {
            "template": "set protocols pim join-filter [parameter1] prefix-list [parameter2]",
            "command": "set protocols pim join-filter cctv prefix-list cctv",
            "explanation": "配置PIM协议的加入过滤器，使用指定的前缀列表。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器的名称，例如cctv。"
                },
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表的名称，例如cctv。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 100 vlan-id 100",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.0.0.3/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet filter input [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet filter input [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet filter input huawei-filter",
            "explanation": "配置接口的输入过滤器。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器的名称，例如huawei-filter。"
                }
            ]
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall policer [parameter1] if-exceeding bandwidth-limit [parameter2]": {
            "template": "set firewall policer [parameter1] if-exceeding bandwidth-limit [parameter2]",
            "command": "set firewall policer huawei-policer if-exceeding bandwidth-limit 2m",
            "explanation": "配置防火墙策略器的带宽限制。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "策略器的名称，例如huawei-policer。"
                },
                {
                    "name": "bandwidth-limit",
                    "type": "string",
                    "explanation": "带宽限制值，例如2m。"
                }
            ]
        },
        "set firewall policer [parameter1] if-exceeding burst-size-limit [parameter2]": {
            "template": "set firewall policer [parameter1] if-exceeding burst-size-limit [parameter2]",
            "command": "set firewall policer huawei-policer if-exceeding burst-size-limit 250k",
            "explanation": "配置防火墙策略器的突发大小限制。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "策略器的名称，例如huawei-policer。"
                },
                {
                    "name": "burst-size-limit",
                    "type": "string",
                    "explanation": "突发大小限制值，例如250k。"
                }
            ]
        },
        "set firewall policer [parameter1] then [parameter2]": {
            "template": "set firewall policer [parameter1] then [parameter2]",
            "command": "set firewall policer huawei-policer then discard",
            "explanation": "配置防火墙策略器的动作。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "策略器的名称，例如huawei-policer。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "动作，例如discard。"
                }
            ]
        },
        "set firewall filter [parameter1] term [parameter2] from family [parameter3]": {
            "template": "set firewall filter [parameter1] term [parameter2] from family [parameter3]",
            "command": "set firewall filter huawei-filter term huawei from family inet",
            "explanation": "配置防火墙过滤器的匹配条件。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器的名称，例如huawei-filter。"
                },
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "条件的名称，例如huawei。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如inet。"
                }
            ]
        },
        "set firewall filter [parameter1] term [parameter2] then policer [parameter3]": {
            "template": "set firewall filter [parameter1] term [parameter2] then policer [parameter3]",
            "command": "set firewall filter huawei-filter term huawei then policer huawei-policer",
            "explanation": "配置防火墙过滤器的动作。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器的名称，例如huawei-filter。"
                },
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "条件的名称，例如huawei。"
                },
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "策略器的名称，例如huawei-policer。"
                }
            ]
        },
        "set firewall filter [parameter1] term [parameter2] then [parameter3]": {
            "template": "set firewall filter [parameter1] term [parameter2] then [parameter3]",
            "command": "set firewall filter huawei-filter term huawei then accept",
            "explanation": "配置防火墙过滤器的动作。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器的名称，例如huawei-filter。"
                },
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "条件的名称，例如huawei。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "动作，例如accept。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options prefix-list [parameter1] [parameter2]/[parameter3]": {
            "template": "set policy-options prefix-list [parameter1] [parameter2]/[parameter3]",
            "command": "set policy-options prefix-list cctv 239.0.0.0/24",
            "explanation": "配置策略选项的前缀列表。",
            "parameters": [
                {
                    "name": "prefix-list-name",
                    "type": "string",
                    "explanation": "前缀列表的名称，例如cctv。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "IP地址，例如239.0.0.0。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数，例如24。"
                }
            ]
        }
    }
}