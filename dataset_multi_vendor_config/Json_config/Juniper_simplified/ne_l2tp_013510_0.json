{
    "set protocols": {
        "template": "set protocols",
        "set protocols l2tp": {
            "template": "set protocols l2tp",
            "command": "set protocols l2tp",
            "explanation": "启用L2TP协议。",
            "parameters": []
        },
        "set protocols l2tp lns [parameter1] authentication [parameter2]": {
            "template": "set protocols l2tp lns [parameter1] authentication [parameter2]",
            "command": "set protocols l2tp lns lac1 authentication chap",
            "explanation": "配置L2TP LNS使用CHAP认证。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如chap。"
                }
            ]
        },
        "set protocols l2tp lns [parameter1] tunnel-password [parameter2]": {
            "template": "set protocols l2tp lns [parameter1] tunnel-password [parameter2]",
            "command": "set protocols l2tp lns lac1 tunnel-password \"<password>\"",
            "explanation": "配置L2TP隧道的密码。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "隧道的密码。"
                }
            ]
        },
        "set protocols l2tp lns [parameter1] tunnel-name [parameter2]": {
            "template": "set protocols l2tp lns [parameter1] tunnel-name [parameter2]",
            "command": "set protocols l2tp lns lac1 tunnel-name LAC1",
            "explanation": "配置L2TP隧道的名称。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                },
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道的名称。"
                }
            ]
        },
        "set protocols l2tp lns [parameter1] local-ip [parameter2]": {
            "template": "set protocols l2tp lns [parameter1] local-ip [parameter2]",
            "command": "set protocols l2tp lns lac1 local-ip 10.100.100.1",
            "explanation": "配置L2TP隧道的本地IP地址。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                },
                {
                    "name": "local-ip",
                    "type": "string",
                    "explanation": "隧道的本地IP地址。"
                }
            ]
        },
        "set protocols l2tp lns [parameter1] remote-ip [parameter2]": {
            "template": "set protocols l2tp lns [parameter1] remote-ip [parameter2]",
            "command": "set protocols l2tp lns lac1 remote-ip 1.1.1.1",
            "explanation": "配置L2TP隧道的远程IP地址。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                },
                {
                    "name": "remote-ip",
                    "type": "string",
                    "explanation": "隧道的远程IP地址。"
                }
            ]
        },
        "set protocols l2tp lns [parameter1] tunnel-path-mtu-discovery": {
            "template": "set protocols l2tp lns [parameter1] tunnel-path-mtu-discovery",
            "command": "set protocols l2tp lns lac1 tunnel-path-mtu-discovery",
            "explanation": "启用L2TP隧道的路径MTU发现。",
            "parameters": [
                {
                    "name": "lns-name",
                    "type": "string",
                    "explanation": "LNS的名称。"
                }
            ]
        }
    },
    "set system": {
        "template": "set system",
        "set system radius-server [parameter1] port [parameter2] secret [parameter3]": {
            "template": "set system radius-server [parameter1] port [parameter2] secret [parameter3]",
            "command": "set system radius-server 10.0.0.249 port 1812 secret \"%^%#vS%796FO7%C~pB%CR=q;j}gSCqR-X6+P!.DYI@)%^%\"",
            "explanation": "配置RADIUS服务器的IP地址、端口和共享密钥。",
            "parameters": [
                {
                    "name": "radius-server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的端口号。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                }
            ]
        },
        "set system radius-server [parameter1] accounting-port [parameter2] secret [parameter3]": {
            "template": "set system radius-server [parameter1] accounting-port [parameter2] secret [parameter3]",
            "command": "set system radius-server 10.0.0.249 accounting-port 1813 secret \"%^%#vS%796FO7%C~pB%CR=q;j}gSCqR-X6+P!.DYI@)%^%\"",
            "explanation": "配置RADIUS服务器的IP地址、计费端口和共享密钥。",
            "parameters": [
                {
                    "name": "radius-server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "accounting-port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序为RADIUS。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.100.100.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 100 vlan-id 100",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-options client": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-options client",
            "command": "set interfaces ge-1/0/0 unit 100 pppoe-options client",
            "explanation": "配置接口单元为PPPoE客户端。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-options underlying-interface [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-options underlying-interface [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 100 pppoe-options underlying-interface ge-1/0/0",
            "explanation": "配置PPPoE客户端的底层接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "underlying-interface",
                    "type": "string",
                    "explanation": "底层接口名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-options service-policy control [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-options service-policy control [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 100 pppoe-options service-policy control default-in-policy",
            "explanation": "配置PPPoE客户端的服务策略。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "service-policy",
                    "type": "string",
                    "explanation": "服务策略名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] enable": {
            "template": "set interfaces [parameter1] unit [parameter2] enable",
            "command": "set interfaces ge-1/0/0 unit 0 enable",
            "explanation": "启用接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ppp authentication [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp authentication [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 100 ppp authentication chap",
            "explanation": "配置接口单元的PPP认证方法为CHAP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如chap。"
                }
            ]
        }
    },
