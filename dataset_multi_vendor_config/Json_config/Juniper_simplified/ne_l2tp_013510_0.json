                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set access profile [parameter1] accounting-order [parameter2]": {
            "template": "set access profile [parameter1] accounting-order [parameter2]",
            "command": "set access profile default1 accounting-order radius",
            "explanation": "配置访问配置文件的计费顺序为RADIUS。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "accounting-method",
                    "type": "string",
                    "explanation": "计费方法，例如radius。"
                }
            ]
        },
        "set access profile [parameter1] authorization-order [parameter2]": {
            "template": "set access profile [parameter1] authorization-order [parameter2]",
            "command": "set access profile default1 authorization-order radius",
            "explanation": "配置访问配置文件的授权顺序为RADIUS。",
            "parameters": [
                {
                    "name": "profile-name",
                    "type": "string",
                    "explanation": "访问配置文件的名称。"
                },
                {
                    "name": "authorization-method",
                    "type": "string",
