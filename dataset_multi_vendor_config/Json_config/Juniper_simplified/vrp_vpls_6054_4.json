{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols mpls label distribute [parameter1]": {
            "template": "set protocols mpls label distribute [parameter1]",
            "command": "set protocols mpls label distribute all",
            "explanation": "配置MPLS标签分发策略为所有。",
            "parameters": [
                {
                    "name": "distribute",
                    "type": "string",
                    "explanation": "标签分发策略，'all'表示分发所有标签。"
                }
            ]
        },
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "在MPLS协议下启用LDP。",
            "parameters": []
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0.0",
            "explanation": "在OSPF协议中配置区域0的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gigabit-ethernet3/0/0 unit 0 family inet address 192.168.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet3/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation dot1q [parameter2] connect vfi [parameter3]": {
            "template": "set interfaces [parameter1] encapsulation dot1q [parameter2] connect vfi [parameter3]",
            "command": "set interfaces gigabit-ethernet3/0/0.1 encapsulation dot1q 10 connect vfi vis1",
            "explanation": "配置接口的VLAN封装并连接到VFI。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet3/0/0.1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                },
                {
                    "name": "vfi",
                    "type": "string",
                    "explanation": "虚拟转发实例名称，用于连接VFI。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vis1 instance-type vfi",
            "explanation": "配置路由实例的类型为VFI。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "路由实例类型，例如vfi。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-table-target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-table-target [parameter2]",
            "command": "set routing-instances vis1 vrf-table-target both",
            "explanation": "配置路由实例的VRF表目标为both。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "VRF表目标，'both'表示同时应用于导入和导出。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1] next-hop [parameter2]": {
            "template": "set routing-options static route [parameter1] next-hop [parameter2]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 192.168.20.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}