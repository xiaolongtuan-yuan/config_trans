{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 172.16.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 description \"GigabitEthernet1/0/0\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65009",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP等协议。"
                }
            ]
        },
        "set routing-options static route [parameter1]/[parameter2] [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
            "command": "set routing-options static route 172.16.1.0/24 discard",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "网络前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址或动作，例如discard表示丢弃。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，internal表示内部。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 3.3.3.3",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 172.16.1.1",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP组的邻居地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group external peer-as 65008",
            "explanation": "配置BGP组的外部对等体自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "外部对等体的自治系统号。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement export-bgp term 1 from protocol direct",
            "explanation": "配置策略语句的匹配条件，匹配直接路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的路由协议，direct表示直接路由。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement export-bgp term 1 then accept",
            "explanation": "配置策略语句的动作，接受匹配的路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "策略语句的动作，accept表示接受。"
                }
            ]
        }
    }
}