{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-protocol [parameter1]": {
            "template": "set protocols mpls label-protocol [parameter1]",
            "command": "set protocols mpls label-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols mpls l2vpn": {
            "template": "set protocols mpls l2vpn",
            "command": "set protocols mpls l2vpn",
            "explanation": "启用MPLS的L2VPN功能。",
            "parameters": []
        },
        "set protocols mpls l2vpn pseudowire-class [parameter1] encapsulation [parameter2]": {
            "template": "set protocols mpls l2vpn pseudowire-class [parameter1] encapsulation [parameter2]",
            "command": "set protocols mpls l2vpn pseudowire-class 3to1 encapsulation mpls",
            "explanation": "配置L2VPN的伪线类及其封装类型。",
            "parameters": [
                {
                    "name": "pseudowire-class",
                    "type": "string",
                    "explanation": "伪线类名称。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如MPLS。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 192.168.1.3/32",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols mpls ldp remote-peer [parameter1]": {
            "template": "set protocols mpls ldp remote-peer [parameter1]",
            "command": "set protocols mpls ldp remote-peer 192.168.1.2",
            "explanation": "配置LDP的远程对等体。",
            "parameters": [
                {
                    "name": "remote-peer",
                    "type": "string",
                    "explanation": "远程对等体的IP地址。"
                }
            ]
        },
        "set protocols mpls ldp remote-ip [parameter1]": {
            "template": "set protocols mpls ldp remote-ip [parameter1]",
            "command": "set protocols mpls ldp remote-ip 192.168.1.2",
            "explanation": "配置LDP的远程IP地址。",
            "parameters": [
                {
                    "name": "remote-ip",
                    "type": "string",
                    "explanation": "远程IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.2.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet mpls",
            "command": "set interfaces ge-0/0/1 unit 0 family inet mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] aps group [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] aps group [parameter3]",
            "command": "set interfaces cpos-3/0/1 unit 0 aps group 1",
            "explanation": "配置接口的APS组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如cpos-3/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "aps-group",
                    "type": "integer",
                    "explanation": "APS组号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] aps group [parameter3] aps protect aps mode [parameter4] [parameter5]": {
            "template": "set interfaces [parameter1] unit [parameter2] aps group [parameter3] aps protect aps mode [parameter4] [parameter5]",
            "command": "set interfaces cpos-3/0/2 unit 0 aps group 1 aps protect aps mode one-plus-one unidirectional",
            "explanation": "配置接口的APS保护模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如cpos-3/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "aps-group",
                    "type": "integer",
                    "explanation": "APS组号。"
                },
                {
                    "name": "aps-mode",
                    "type": "string",
                    "explanation": "APS模式，例如one-plus-one。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向，例如unidirectional。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces trunk-serial1/1:0 encapsulation mpls",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如trunk-serial1/1:0。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如MPLS。"
                }
            ]
        },
        "set interfaces [parameter1] mpls l2vc pw-template [parameter2] [parameter3]": {
            "template": "set interfaces [parameter1] mpls l2vc pw-template [parameter2] [parameter3]",
            "command": "set interfaces trunk-serial1/1:0 mpls l2vc pw-template 3to1 100",
            "explanation": "配置接口的MPLS L2VC伪线模板。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如trunk-serial1/1:0。"
                },
                {
                    "name": "pw-template",
                    "type": "string",
                    "explanation": "伪线模板名称。"
                },
                {
                    "name": "vc-id",
                    "type": "integer",
                    "explanation": "虚拟电路ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 192.168.1.3",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，通常为一个IP地址。"
                }
            ]
        }
    }
}