            "template": "set protocols mpls l2vpn pw-template [parameter1] to [parameter2]",
            "command": "set protocols mpls l2vpn pw-template 3 to 1",
            "explanation": "配置MPLS L2VPN的伪线模板。",
            "parameters": [
                {
                    "name": "template-id",
                    "type": "integer",
                    "explanation": "伪线模板ID。"
                },
                {
                    "name": "peer-id",
                    "type": "integer",
                    "explanation": "对端ID。"
                }
            ]
        },
