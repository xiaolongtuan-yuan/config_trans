            "template": "set protocols mpls l2vpn neighbor [parameter1] pw-id [parameter2]",
            "command": "set protocols mpls l2vpn neighbor 192.168.2.2 pw-id 100",
            "explanation": "配置MPLS L2VPN邻居的伪线ID。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "pw-id",
                    "type": "integer",
                    "explanation": "伪线ID。"
                }
            ]
        },
        "set protocols mpls l2vc [parameter1] pw-class [parameter2] to [parameter3]": {
            "template": "set protocols mpls l2vc [parameter1] pw-class [parameter2] to [parameter3]",
            "command": "set protocols mpls l2vc 100 pw-class 3 to 1",
            "explanation": "配置MPLS L2VC的伪线类别。",
            "parameters": [
                {
                    "name": "vc-id",
