{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 172.16.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 1 wide-metrics-only",
            "explanation": "配置IS-IS协议的级别1仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 10.0000.0000.0001.00",
            "explanation": "配置IS-IS网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题，用于标识IS-IS网络中的设备。"
                }
            ]
        },
        "set protocols isis segment-routing mpls": {
            "template": "set protocols isis segment-routing mpls",
            "command": "set protocols isis segment-routing mpls",
            "explanation": "启用IS-IS协议的段路由MPLS功能。",
            "parameters": []
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，internal表示内部。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 1.1.1.9",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group internal neighbor 3.3.3.9 peer-as 100",
            "explanation": "配置BGP组的邻居及其对等AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast": {
            "template": "set protocols bgp group [parameter1] family inet unicast",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组支持IPv4单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] next-hop-self": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] next-hop-self",
            "command": "set protocols bgp group internal neighbor 3.3.3.9 next-hop-self",
            "explanation": "配置BGP组邻居的下一跳为自己。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast redistribute connected": {
            "template": "set protocols bgp group [parameter1] family inet unicast redistribute connected",
            "command": "set protocols bgp group internal family inet unicast redistribute connected",
            "explanation": "配置BGP组在IPv4单播地址族下重分发直连路由。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id lo0.1",
            "explanation": "配置MPLS LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP的路由器ID。"
                }
            ]
        },
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols mpls segment-routing": {
            "template": "set protocols mpls segment-routing",
            "command": "set protocols mpls segment-routing",
            "explanation": "启用MPLS段路由功能。",
            "parameters": []
        },
        "set protocols mpls segment-routing tunnel-preference [parameter1]": {
            "template": "set protocols mpls segment-routing tunnel-preference [parameter1]",
            "command": "set protocols mpls segment-routing tunnel-preference segment-routing",
            "explanation": "配置MPLS段路由的隧道偏好。",
            "parameters": [
                {
                    "name": "tunnel-preference",
                    "type": "string",
                    "explanation": "MPLS段路由的隧道偏好。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options tunnel [parameter1] destination [parameter2]": {
            "template": "set routing-options tunnel [parameter1] destination [parameter2]",
            "command": "set routing-options tunnel sr-lsp1 destination 10.0.0.0",
            "explanation": "配置隧道的目标地址。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道的名称。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "隧道的目标地址。"
                }
            ]
        },
        "set routing-options tunnel [parameter1] policy [parameter2]": {
            "template": "set routing-options tunnel [parameter1] policy [parameter2]",
            "command": "set routing-options tunnel sr-lsp1 policy p1",
            "explanation": "配置隧道的策略。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道的名称。"
                },
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "隧道的策略名称。"
                }
            ]
        },
        "set routing-options tunnel-policy [parameter1] tunnel-selector [parameter2] load-balance-number [parameter3]": {
            "template": "set routing-options tunnel-policy [parameter1] tunnel-selector [parameter2] load-balance-number [parameter3]",
            "command": "set routing-options tunnel-policy p1 tunnel-selector sr-lsp load-balance-number 1",
            "explanation": "配置隧道策略的隧道选择器和负载均衡数。",
            "parameters": [
                {
                    "name": "tunnel-policy",
                    "type": "string",
                    "explanation": "隧道策略的名称。"
                },
                {
                    "name": "tunnel-selector",
                    "type": "string",
                    "explanation": "隧道选择器的名称。"
                },
                {
                    "name": "load-balance-number",
                    "type": "integer",
                    "explanation": "负载均衡数。"
                }
            ]
        }
    }
}