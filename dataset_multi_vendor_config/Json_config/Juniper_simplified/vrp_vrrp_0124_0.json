{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] standby [parameter5] address [parameter6] standby track [parameter7] [parameter8] unflapped": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] standby [parameter5] address [parameter6] standby track [parameter7] [parameter8] unflapped",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.10.1.1/24 standby 10 address 10.10.1.111 standby track ge-0/0/4 1 unflapped",
            "explanation": "配置接口的IPv4地址及子网掩码，并设置备用地址和跟踪接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                },
                {
                    "name": "standby-group",
                    "type": "integer",
                    "explanation": "备用地址组号。"
                },
                {
                    "name": "standby-address",
                    "type": "string",
                    "explanation": "备用地址。"
                },
                {
                    "name": "track-interface",
                    "type": "string",
                    "explanation": "跟踪的接口名称。"
                },
                {
                    "name": "track-priority",
                    "type": "integer",
                    "explanation": "跟踪接口的优先级。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/3 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] standby [parameter5] address [parameter6] standby priority [parameter7]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] standby [parameter5] address [parameter6] standby priority [parameter7]",
            "command": "set interfaces ge-0/0/4 unit 0 family inet address 10.10.3.1/24 standby 1 address 10.10.3.111 standby priority 120",
            "explanation": "配置接口的IPv4地址及子网掩码，并设置备用地址和优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/4。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                },
                {
                    "name": "standby-group",
                    "type": "integer",
                    "explanation": "备用地址组号。"
                },
                {
                    "name": "standby-address",
                    "type": "string",
                    "explanation": "备用地址。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "备用地址的优先级。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 10.10.1.0/255.255.255.0",
            "explanation": "配置OSPF协议的区域和网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "子网掩码。"
                }
            ]
        }
    }
}