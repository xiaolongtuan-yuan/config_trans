{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim rp static address [parameter1]": {
            "template": "set protocols pim rp static address [parameter1]",
            "command": "set protocols pim rp static address 192.168.3.1",
            "explanation": "配置PIM（Protocol Independent Multicast）的静态RP（Rendezvous Point）地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "静态RP的IPv4地址。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-1/0/2.0 mode sparse",
            "explanation": "配置接口的PIM模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse。"
                }
            ]
        },
        "set protocols igmp interface [parameter1] join [parameter2]": {
            "template": "set protocols igmp interface [parameter1] join [parameter2]",
            "command": "set protocols igmp interface ge-1/0/2.0 join 239.0.0.1",
            "explanation": "配置接口加入指定的IGMP组播组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2.0。"
                },
                {
                    "name": "multicast-group",
                    "type": "string",
                    "explanation": "要加入的组播组地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external-peers type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group external-peers peer-as 200",
            "explanation": "配置BGP组的对等体AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group external-peers neighbor 192.168.2.1",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IPv4地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] import [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] import [parameter3]",
            "command": "set protocols bgp group external-peers neighbor 192.168.2.1 import DIRECT",
            "explanation": "配置BGP组邻居的导入策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IPv4地址。"
                },
                {
                    "name": "import-policy",
                    "type": "string",
                    "explanation": "导入策略名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export": {
            "template": "set protocols bgp group [parameter1] export",
            "command": "set protocols bgp group external-peers export",
            "explanation": "配置BGP组的导出策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp network [parameter1]/[parameter2]": {
            "template": "set protocols bgp network [parameter1]/[parameter2]",
            "command": "set protocols bgp network 192.168.2.0/24",
            "explanation": "配置BGP通告的网络。",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "要通告的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/2 unit 0 family inet address 192.168.4.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}