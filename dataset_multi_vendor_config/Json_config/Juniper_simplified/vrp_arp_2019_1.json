{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching",
            "explanation": "配置接口为以太网交换模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-0/0/0 unit 0 disable",
            "explanation": "禁用指定接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set arp": {
        "template": "set arp",
        "set arp aging-time [parameter1]": {
            "template": "set arp aging-time [parameter1]",
            "command": "set arp aging-time 20",
            "explanation": "配置ARP表项的老化时间。",
            "parameters": [
                {
                    "name": "aging-time",
                    "type": "integer",
                    "explanation": "ARP表项的老化时间，单位为分钟。"
                }
            ]
        },
        "set arp rate-limit [parameter1]": {
            "template": "set arp rate-limit [parameter1]",
            "command": "set arp rate-limit 50",
            "explanation": "配置ARP请求的速率限制。",
            "parameters": [
                {
                    "name": "rate-limit",
                    "type": "integer",
                    "explanation": "ARP请求的速率限制，单位为每秒请求数。"
                }
            ]
        },
        "set arp learning-mode [parameter1]": {
            "template": "set arp learning-mode [parameter1]",
            "command": "set arp learning-mode strict",
            "explanation": "配置ARP学习模式为严格模式。",
            "parameters": [
                {
                    "name": "learning-mode",
                    "type": "string",
                    "explanation": "ARP学习模式，例如strict。"
                }
            ]
        },
        "set arp force-enable": {
            "template": "set arp force-enable",
            "command": "set arp force-enable",
            "explanation": "强制启用ARP功能。",
            "parameters": []
        }
    }
}