{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASBR1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp [parameter1]": {
            "template": "set protocols ldp [parameter1]",
            "command": "set protocols ldp disabled",
            "explanation": "禁用LDP协议。",
            "parameters": [
                {
                    "name": "ldp-status",
                    "type": "string",
                    "explanation": "LDP协议的状态，disabled表示禁用。"
                }
            ]
        },
        "set protocols l2vpn pw label-mode [parameter1]": {
            "template": "set protocols l2vpn pw label-mode [parameter1]",
            "command": "set protocols l2vpn pw label-mode per-egress-ingress",
            "explanation": "配置L2VPN PW的标签模式为每个出口入口。",
            "parameters": [
                {
                    "name": "label-mode",
                    "type": "string",
                    "explanation": "L2VPN PW的标签模式，per-egress-ingress表示每个出口入口。"
                }
            ]
        },
        "set protocols l2vpn pw neighbor [parameter1] pw-id [parameter2]": {
            "template": "set protocols l2vpn pw neighbor [parameter1] pw-id [parameter2]",
            "command": "set protocols l2vpn pw neighbor 1.1.1.1 pw-id 2",
            "explanation": "配置L2VPN PW的邻居和PW ID。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "pw-id",
                    "type": "integer",
                    "explanation": "PW的ID。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vid [parameter2]": {
            "template": "set vlans [parameter1] vid [parameter2]",
            "command": "set vlans vlan1 vid 10",
            "explanation": "配置VLAN的VID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN的ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching virtual-switch-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching virtual-switch-id [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching virtual-switch-id 10",
            "explanation": "配置接口的以太网交换虚拟交换机ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "virtual-switch-id",
                    "type": "integer",
                    "explanation": "虚拟交换机的ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching cport-connected-vlan [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching cport-connected-vlan [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching cport-connected-vlan vlan1",
            "explanation": "配置接口的以太网交换连接VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "连接的VLAN名称。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation dot1q [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation dot1q [parameter2]",
            "command": "set interfaces ge-0/0/0.1 encapsulation dot1q 10",
            "explanation": "配置接口的dot1q封装。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "dot1q封装的VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family l2vpn vfi [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2vpn vfi [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family l2vpn vfi v1",
            "explanation": "配置接口的L2VPN VFI。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "VFI的名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3] [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3] [parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.10.1.2 255.255.255.252",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "IPv4子网掩码。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options mpls label-mode [parameter1]": {
            "template": "set forwarding-options mpls label-mode [parameter1]",
            "command": "set forwarding-options mpls label-mode per-egress-ingress",
            "explanation": "配置MPLS的标签模式为每个出口入口。",
            "parameters": [
                {
                    "name": "label-mode",
                    "type": "string",
                    "explanation": "MPLS的标签模式，per-egress-ingress表示每个出口入口。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router ospf [parameter1] area [parameter2] network [parameter3]": {
            "template": "set routing-options router ospf [parameter1] area [parameter2] network [parameter3]",
            "command": "set routing-options router ospf 1 area 0 network 2.2.2.2.0.0.0.0",
            "explanation": "配置OSPF路由器的区域网络。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    },
    "tag config-lock": {
        "template": "tag config-lock",
        "tag config-lock": {
            "template": "tag config-lock",
            "command": "tag config-lock",
            "explanation": "锁定配置，防止未经授权的更改。",
            "parameters": []
        }
    }
}