{
    "set system": {
        "template": "set system",
        "set system name [parameter1]": {
            "template": "set system name [parameter1]",
            "command": "set system name NPE1",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd all-interfaces": {
            "template": "set protocols bfd all-interfaces",
            "command": "set protocols bfd all-interfaces",
            "explanation": "在所有接口上启用BFD协议。",
            "parameters": []
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS协议并配置IP。",
            "parameters": []
        },
        "set protocols mpls l2vpn": {
            "template": "set protocols mpls l2vpn",
            "command": "set protocols mpls l2vpn",
            "explanation": "启用MPLS L2VPN功能。",
            "parameters": []
        },
        "set protocols ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set protocols ospf 1 area 0 interface ge-1/0/3",
            "explanation": "在OSPF进程1的区域0中启用接口ge-1/0/3。",
            "parameters": [
                {
                    "name": "ospf-process",
                    "type": "integer",
                    "explanation": "OSPF进程号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set protocols ospf 1 area 0 network 192.168.30.0/24",
            "explanation": "在OSPF进程1的区域0中宣告网络192.168.30.0/24。",
            "parameters": [
                {
                    "name": "ospf-process",
                    "type": "integer",
                    "explanation": "OSPF进程号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols mpls ldp interface [parameter1]": {
            "template": "set protocols mpls ldp interface [parameter1]",
            "command": "set protocols mpls ldp interface ge-1/0/3",
            "explanation": "在接口ge-1/0/3上启用MPLS LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family iso channel-group [parameter3] mode [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso channel-group [parameter3] mode [parameter4]",
            "command": "set interfaces po1 unit 0 family iso channel-group 1 mode passive",
            "explanation": "配置接口po1的ISO通道组为被动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "channel-group",
                    "type": "integer",
                    "explanation": "通道组号。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式，例如passive。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces po1 unit 0 family inet address 5.5.5.5/24",
            "explanation": "配置接口po1的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family dot1q encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family dot1q encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family dot1q encapsulation 10",
            "explanation": "配置接口ge-1/0/1的dot1q封装。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ip": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ip",
            "command": "set interfaces ge-1/0/3 unit 0 family mpls ip",
            "explanation": "在接口ge-1/0/3上启用MPLS IP功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vsi1 vlan-id 10",
            "explanation": "配置VLAN vsi1的VLAN ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set vlans [parameter1] interface [parameter2]": {
            "template": "set vlans [parameter1] interface [parameter2]",
            "command": "set vlans vsi1 interface ge-1/0/1.10",
            "explanation": "将接口ge-1/0/1.10加入到VLAN vsi1。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options l2转发 vsi [parameter1] vfi-id [parameter2] remote-peer [parameter3] vpls-id [parameter4]": {
            "template": "set forwarding-options l2转发 vsi [parameter1] vfi-id [parameter2] remote-peer [parameter3] vpls-id [parameter4]",
            "command": "set forwarding-options l2转发 vsi vsi1 vfi-id 1 remote-peer 2.2.2.2 vpls-id 1",
            "explanation": "配置L2转发选项，包括VSI、VFI ID、远程对等体和VPLS ID。",
            "parameters": [
                {
                    "name": "vsi",
                    "type": "string",
                    "explanation": "VSI名称。"
                },
                {
                    "name": "vfi-id",
                    "type": "integer",
                    "explanation": "VFI ID。"
                },
                {
                    "name": "remote-peer",
                    "type": "string",
                    "explanation": "远程对等体的IP地址。"
                },
                {
                    "name": "vpls-id",
                    "type": "integer",
                    "explanation": "VPLS ID。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 5.5.5.6",
            "explanation": "配置静态路由，指定默认路由的下一跳地址。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
