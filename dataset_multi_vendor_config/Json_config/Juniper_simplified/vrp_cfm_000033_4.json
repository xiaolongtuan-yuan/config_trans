{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls lsr-id [parameter1]": {
            "template": "set protocols mpls lsr-id [parameter1]",
            "command": "set protocols mpls lsr-id 3.3.3.9",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "MPLS的LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        },
        "set protocols mpls": {
            "template": "set protocols mpls",
            "command": "set protocols mpls",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols l2vpn": {
            "template": "set protocols l2vpn",
            "command": "set protocols l2vpn",
            "explanation": "启用L2VPN协议。",
            "parameters": []
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id lo0.0",
            "explanation": "配置LDP的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP的Router ID，通常指向一个环回接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group vpnv4 type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group vpnv4 local-address lo0.0",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址，通常指向一个环回接口。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group vpnv4 peer-as 100",
            "explanation": "配置BGP组的对等AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] signaling": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] signaling",
            "command": "set protocols bgp group vpnv4 neighbor 1.1.1.9 family inet-vpn signaling",
            "explanation": "配置BGP组的邻居及其支持的地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "支持的地址族，例如inet-vpn。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0.0",
            "explanation": "配置OSPF区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet",
            "command": "set interfaces ge-1/0/0 unit 0 family inet",
            "explanation": "配置接口的IPv4协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 encapsulation ethernet-vpls",
            "explanation": "配置接口的封装类型为Ethernet-VPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "接口的封装类型，例如ethernet-vpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] l2vpn vpls-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] l2vpn vpls-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 l2vpn vpls-id 100",
            "explanation": "配置接口的L2VPN VPLS ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vpls-id",
                    "type": "integer",
                    "explanation": "L2VPN VPLS的ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 192.168.10.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-2/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vpls",
            "explanation": "配置路由实例的类型为VPLS。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vpls。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn1 route-distinguisher 100:1",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于在MPLS VPN中唯一标识路由。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target [parameter2] export": {
            "template": "set routing-instances [parameter1] vrf-target [parameter2] export",
            "command": "set routing-instances vpn1 vrf-target target:200:1 export",
            "explanation": "配置路由实例的VRF目标为导出。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由的导入和导出。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target [parameter2] import": {
            "template": "set routing-instances [parameter1] vrf-target [parameter2] import",
            "command": "set routing-instances vpn1 vrf-target target:200:1 import",
            "explanation": "配置路由实例的VRF目标为导入。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由的导入和导出。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances vpn1 interface ge-1/0/0.0",
            "explanation": "配置路由实例的接口。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    }
}