{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-1/0/0 point-to-point",
            "explanation": "配置ISIS协议的接口类型为点对点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 1 wide-metrics-only",
            "explanation": "配置ISIS协议的级别1仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如1。"
                }
            ]
        },
        "set protocols isis level [parameter1] interface [parameter2]": {
            "template": "set protocols isis level [parameter1] interface [parameter2]",
            "command": "set protocols isis level 1 interface ge-1/0/0",
            "explanation": "配置ISIS协议的级别1接口。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如1。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols isis no-ipv6-routing": {
            "template": "set protocols isis no-ipv6-routing",
            "command": "set protocols isis no-ipv6-routing",
            "explanation": "禁用ISIS协议的IPv6路由功能。",
            "parameters": []
        },
        "set protocols isis level [parameter1] circuit-type [parameter2]": {
            "template": "set protocols isis level [parameter1] circuit-type [parameter2]",
            "command": "set protocols isis level 1 circuit-type level-1",
            "explanation": "配置ISIS协议的级别1电路类型为级别1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如1。"
                },
                {
                    "name": "circuit-type",
                    "type": "string",
                    "explanation": "电路类型，例如level-1。"
                }
            ]
        },
        "set protocols isis iso-address [parameter1]": {
            "template": "set protocols isis iso-address [parameter1]",
            "command": "set protocols isis iso-address 49.0001.0000.0000.0002.00",
            "explanation": "配置ISIS协议的ISO地址。",
            "parameters": [
                {
                    "name": "iso-address",
                    "type": "string",
                    "explanation": "ISO地址，用于ISIS协议。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP协议的内部组类型。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称，例如internal。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "组类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group external neighbor 10.2.1.2 peer-as 65009",
            "explanation": "配置BGP协议的外部组邻居及其对等AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称，例如external。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group external export RTC",
            "explanation": "配置BGP协议的外部组导出策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称，例如external。"
                },
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "导出策略名称，例如RTC。"
                }
            ]
        },
        "set protocols bgp local-as [parameter1]": {
            "template": "set protocols bgp local-as [parameter1]",
            "command": "set protocols bgp local-as 65008",
            "explanation": "配置BGP协议的本地AS号。",
            "parameters": [
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set protocols bgp route-distinguisher-id [parameter1]": {
            "template": "set protocols bgp route-distinguisher-id [parameter1]",
            "command": "set protocols bgp route-distinguisher-id 1.1.1.1",
            "explanation": "配置BGP协议的路由区分器ID。",
            "parameters": [
                {
                    "name": "route-distinguisher-id",
                    "type": "string",
                    "explanation": "路由区分器ID，例如1.1.1.1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "delete interfaces [parameter1] disable": {
            "template": "delete interfaces [parameter1] disable",
            "command": "delete interfaces ge-1/0/0 disable",
            "explanation": "删除接口的禁用状态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from as-path [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from as-path [parameter3]",
            "command": "set policy-options policy-statement RTC term 1 from as-path 1",
            "explanation": "配置策略语句的匹配条件为特定的AS路径。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称，例如RTC。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号，例如1。"
                },
                {
                    "name": "as-path",
                    "type": "integer",
                    "explanation": "AS路径编号，用于匹配策略。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then metric [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then metric [parameter3]",
            "command": "set policy-options policy-statement RTC term 1 then metric 20",
            "explanation": "配置策略语句的动作，设置度量值为20。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称，例如RTC。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号，例如1。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值，用于策略动作。"
                }
            ]
        },
        "set policy-options as-path [parameter1] \"[parameter2]\"": {
            "template": "set policy-options as-path [parameter1] \"[parameter2]\"",
            "command": "set policy-options as-path 1 \"^65009$\"",
            "explanation": "配置AS路径的正则表达式。",
            "parameters": [
                {
                    "name": "as-path",
                    "type": "integer",
                    "explanation": "AS路径编号。"
                },
                {
                    "name": "regex",
                    "type": "string",
                    "explanation": "AS路径的正则表达式，例如\"^65009$\"。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]": {
            "template": "set routing-options static route [parameter1]",
            "command": "set routing-options static route 10.2.1.0/24",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目标网络地址及子网掩码。"
                }
            ]
        }
    }
}