{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] net [parameter2]": {
            "template": "set protocols isis level [parameter1] net [parameter2]",
            "command": "set protocols isis level 2 net 10.0000.0000.0001.00",
            "explanation": "配置IS-IS协议的NET地址。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别。"
                },
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "NET地址，用于IS-IS协议的唯一标识。"
                }
            ]
        },
        "set protocols isis interface [parameter1] unit [parameter2] network-type [parameter3]": {
            "template": "set protocols isis interface [parameter1] unit [parameter2] network-type [parameter3]",
            "command": "set protocols isis interface ge-0/0/0 unit 0 network-type point-to-point",
            "explanation": "配置IS-IS接口的网络类型为点对点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "network-type",
                    "type": "string",
                    "explanation": "网络类型，例如点对点。"
                }
            ]
        },
        "set protocols bgp [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp 100 neighbor 2.2.2.2 remote-as 100",
            "explanation": "配置BGP邻居的AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "邻居的AS号。"
                }
            ]
        },
        "set protocols bgp [parameter1] neighbor [parameter2] update-source [parameter3]": {
            "template": "set protocols bgp [parameter1] neighbor [parameter2] update-source [parameter3]",
            "command": "set protocols bgp 100 neighbor 2.2.2.2 update-source lo0",
            "explanation": "配置BGP邻居的更新源。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口名称。"
                }
            ]
        },
        "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] activate": {
            "template": "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] activate",
            "command": "set protocols bgp 100 l2vpn evpn neighbor 2.2.2.2 activate",
            "explanation": "激活BGP L2VPN EVPN邻居。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] advertisement-encapsulation [parameter3]": {
            "template": "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] advertisement-encapsulation [parameter3]",
            "command": "set protocols bgp 100 l2vpn evpn neighbor 2.2.2.2 advertisement-encapsulation vxlan",
            "explanation": "配置BGP L2VPN EVPN邻居的广告封装类型。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "encapsulation-type",
                    "type": "string",
                    "explanation": "封装类型，例如VXLAN。"
                }
            ]
        },
        "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] advertisement-irb": {
            "template": "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] advertisement-irb",
            "command": "set protocols bgp 100 l2vpn evpn neighbor 2.2.2.2 advertisement-irb",
            "explanation": "配置BGP L2VPN EVPN邻居的IRB广告。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] route-reflector-client": {
            "template": "set protocols bgp [parameter1] l2vpn evpn neighbor [parameter2] route-reflector-client",
            "command": "set protocols bgp 100 l2vpn evpn neighbor 2.2.2.2 route-reflector-client",
            "explanation": "配置BGP L2VPN EVPN邻居为路由反射器客户端。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP的AS号。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.3.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}