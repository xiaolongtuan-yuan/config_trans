{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan2 vlan-id 2",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set ethernet-oam": {
        "template": "set ethernet-oam",
        "set ethernet-oam version [parameter1]": {
            "template": "set ethernet-oam version [parameter1]",
            "command": "set ethernet-oam version 0",
            "explanation": "配置以太网OAM的版本。",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "以太网OAM的版本号。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] level [parameter2]": {
            "template": "set ethernet-oam domain [parameter1] level [parameter2]",
            "command": "set ethernet-oam domain default level 0",
            "explanation": "配置以太网OAM域的级别。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "以太网OAM域的级别。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] service [parameter2]": {
            "template": "set ethernet-oam domain [parameter1] service [parameter2]",
            "command": "set ethernet-oam domain default service cfm",
            "explanation": "配置以太网OAM域的服务类型。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "以太网OAM域的服务类型。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3",
            "explanation": "配置以太网OAM域的维护关联。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] interface [parameter4] direction [parameter5]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] interface [parameter4] direction [parameter5]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 interface ge-1/0/1 direction down",
            "explanation": "配置维护端点(MEP)的接口和方向。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "维护端点的方向。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 continuity-check enabled",
            "explanation": "启用维护端点的连续性检查。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "continuity-check",
                    "type": "string",
                    "explanation": "连续性检查的状态。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check interval [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check interval [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 continuity-check interval 1s",
            "explanation": "配置维护端点的连续性检查间隔。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "interval",
                    "type": "string",
                    "explanation": "连续性检查的时间间隔。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] direction [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] direction [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 3 direction up",
            "explanation": "配置维护端点的方向。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "维护端点的方向。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check receive [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] continuity-check receive [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 3 continuity-check receive enabled",
            "explanation": "启用维护端点的连续性检查接收功能。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "receive",
                    "type": "string",
                    "explanation": "连续性检查接收功能的状态。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement test-id [parameter4] [parameter5]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement test-id [parameter4] [parameter5]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 loss-measurement test-id 1 dual-ended",
            "explanation": "配置维护端点的双端丢失测量测试。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID。"
                },
                {
                    "name": "test-type",
                    "type": "string",
                    "explanation": "测试类型。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement destination-mep-id [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement destination-mep-id [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 loss-measurement destination-mep-id 3",
            "explanation": "配置丢失测量的目标维护端点ID。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "destination-mep-id",
                    "type": "integer",
                    "explanation": "目标维护端点的ID。"
                }
            ]
        },
        "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement source-mep-id [parameter4]": {
            "template": "set ethernet-oam domain [parameter1] maintenance-association [parameter2] mep [parameter3] loss-measurement source-mep-id [parameter4]",
            "command": "set ethernet-oam domain md3 maintenance-association ma3 mep 4 loss-measurement source-mep-id 4",
            "explanation": "配置丢失测量的源维护端点ID。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "以太网OAM域的名称。"
                },
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "维护关联的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的ID。"
                },
                {
                    "name": "source-mep-id",
                    "type": "integer",
                    "explanation": "源维护端点的ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式和接口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan2",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员名称。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/1 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    }
}