{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system mpls lsr-id [parameter1]": {
            "template": "set system mpls lsr-id [parameter1]",
            "command": "set system mpls lsr-id 11.11.11.11",
            "explanation": "配置MPLS的LSR ID。",
            "parameters": [
                {
                    "name": "lsr-id",
                    "type": "string",
                    "explanation": "MPLS的LSR ID，用于标识MPLS网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-protocol [parameter1]": {
            "template": "set protocols mpls label-protocol [parameter1]",
            "command": "set protocols mpls label-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-protocol",
                    "type": "string",
                    "explanation": "MPLS的标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 10.1.1.0/24",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mpls traffic-eng tunnels": {
            "template": "set interfaces [parameter1] unit [parameter2] mpls traffic-eng tunnels",
            "command": "set interfaces ge-0/0/0 unit 0 mpls traffic-eng tunnels",
            "explanation": "配置接口支持MPLS流量工程隧道。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] mpls",
            "command": "set interfaces ge-0/0/1 unit 0 mpls",
            "explanation": "配置接口支持MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet policy input [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet policy input [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet policy input pe",
            "explanation": "配置接口的输入策略。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "输入策略名称。"
                }
            ]
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall family inet filter [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set firewall family inet filter pe term match-any from protocol all",
            "explanation": "配置防火墙过滤器的匹配条件。",
            "parameters": [
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "条件项名称。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议类型。"
                }
            ]
        },
        "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]",
            "command": "set firewall family inet filter pe term match-any then accept",
            "explanation": "配置防火墙过滤器的动作。",
            "parameters": [
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "条件项名称。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "执行的动作，例如accept。"
                }
            ]
        }
    },
    "set class-of-service": {
        "template": "set class-of-service",
        "set class-of-service classifiers traffic [parameter1] [parameter2]": {
            "template": "set class-of-service classifiers traffic [parameter1] [parameter2]",
            "command": "set class-of-service classifiers traffic match-all pe",
            "explanation": "配置流量分类器。",
            "parameters": [
                {
                    "name": "classifier-type",
                    "type": "string",
                    "explanation": "分类器类型，例如traffic。"
                },
                {
                    "name": "classifier-name",
                    "type": "string",
                    "explanation": "分类器名称。"
                }
            ]
        },
        "set class-of-service schedulers [parameter1] scheduler-weight [parameter2] weight [parameter3]": {
            "template": "set class-of-service schedulers [parameter1] scheduler-weight [parameter2] weight [parameter3]",
            "command": "set class-of-service schedulers pe scheduler-weight 8 weight 50",
            "explanation": "配置调度器的权重。",
            "parameters": [
                {
                    "name": "scheduler-name",
                    "type": "string",
                    "explanation": "调度器名称。"
                },
                {
                    "name": "scheduler-weight",
                    "type": "integer",
                    "explanation": "调度器的权重值。"
                },
                {
                    "name": "weight",
                    "type": "integer",
                    "explanation": "权重值。"
                }
            ]
        },
        "set class-of-service policer [parameter1] cir [parameter2] pps": {
            "template": "set class-of-service policer [parameter1] cir [parameter2] pps",
            "command": "set class-of-service policer pe cir 15000 pps",
            "explanation": "配置流量监管器的承诺信息速率。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "流量监管器名称。"
                },
                {
                    "name": "cir",
                    "type": "integer",
                    "explanation": "承诺信息速率，单位是pps。"
                }
            ]
        },
        "set class-of-service policer [parameter1] pir [parameter2] pps": {
            "template": "set class-of-service policer [parameter1] pir [parameter2] pps",
            "command": "set class-of-service policer pe pir 20000 pps",
            "explanation": "配置流量监管器的峰值信息速率。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "流量监管器名称。"
                },
                {
                    "name": "pir",
                    "type": "integer",
                    "explanation": "峰值信息速率，单位是pps。"
                }
            ]
        },
        "set class-of-service policer [parameter1] conform-action [parameter2] exceed-action [parameter3] violate-action [parameter4]": {
            "template": "set class-of-service policer [parameter1] conform-action [parameter2] exceed-action [parameter3] violate-action [parameter4]",
            "command": "set class-of-service policer pe conform-action pass exceed-action drop violate-action drop",
            "explanation": "配置流量监管器的动作。",
            "parameters": [
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "流量监管器名称。"
                },
                {
                    "name": "conform-action",
                    "type": "string",
                    "explanation": "符合速率时的动作。"
                },
                {
                    "name": "exceed-action",
                    "type": "string",
                    "explanation": "超过速率时的动作。"
                },
                {
                    "name": "violate-action",
                    "type": "string",
                    "explanation": "违反速率时的动作。"
                }
            ]
        }
    }
}