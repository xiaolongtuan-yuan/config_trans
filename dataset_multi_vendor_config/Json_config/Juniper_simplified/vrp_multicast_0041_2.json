{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim ssm-groups [parameter1]": {
            "template": "set protocols pim ssm-groups [parameter1]",
            "command": "set protocols pim ssm-groups 232.1.1.0/24",
            "explanation": "配置PIM SSM（Source-Specific Multicast）组地址。",
            "parameters": [
                {
                    "name": "ssm-group",
                    "type": "string",
                    "explanation": "SSM组地址范围。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface all mode sparse",
            "explanation": "配置所有接口的PIM模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，sparse表示稀疏模式。"
                }
            ]
        },
        "set protocols pim ssm-translate [parameter1] from [parameter2]": {
            "template": "set protocols pim ssm-translate [parameter1] from [parameter2]",
            "command": "set protocols pim ssm-translate rule-1 from 232.1.1.0/24",
            "explanation": "配置SSM转换规则，将指定组地址转换为SSM。",
            "parameters": [
                {
                    "name": "rule-name",
                    "type": "string",
                    "explanation": "规则名称。"
                },
                {
                    "name": "from-group",
                    "type": "string",
                    "explanation": "转换前的组地址范围。"
                }
            ]
        },
        "set protocols isis source-address [parameter1]": {
            "template": "set protocols isis source-address [parameter1]",
            "command": "set protocols isis source-address 10.0000.0000.0003.00",
            "explanation": "配置IS-IS协议的源地址。",
            "parameters": [
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "IS-IS协议的源地址。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-1/0/0 point-to-point",
            "explanation": "配置指定接口的IS-IS网络类型为点对点。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols pim interface [parameter1] version [parameter2]": {
            "template": "set protocols pim interface [parameter1] version [parameter2]",
            "command": "set protocols pim interface ge-2/0/0 version 3",
            "explanation": "配置指定接口的PIM版本。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "PIM版本号。"
                }
            ]
        },
        "set protocols pim interface [parameter1] join-[parameter2]": {
            "template": "set protocols pim interface [parameter1] join-[parameter2]",
            "command": "set protocols pim interface ge-2/0/0 join-232.1.1.0",
            "explanation": "配置指定接口加入指定的PIM组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "要加入的PIM组地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.4.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}