{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] description [parameter2]": {
            "template": "set interfaces [parameter1] description [parameter2]",
            "command": "set interfaces ae10 description \"Eth-Trunk10\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options lacp [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options lacp active",
            "explanation": "配置接口的LACP协议为主动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP协议模式，例如active。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ae10 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口的以太网交换端口模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "以太网交换端口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ae10 unit 0 family ethernet-switching vlan members 10",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，例如10。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ae10 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/0 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项为802.3ad，并指定聚合组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        },
        "set interfaces [parameter1] gigether-options no-auto-negotiation": {
            "template": "set interfaces [parameter1] gigether-options no-auto-negotiation",
            "command": "set interfaces ge-0/0/0 gigether-options no-auto-negotiation",
            "explanation": "配置接口的千兆以太网选项为不自动协商。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] gigether-options speed [parameter2]": {
            "template": "set interfaces [parameter1] gigether-options speed [parameter2]",
            "command": "set interfaces ge-0/0/0 gigether-options speed 1g",
            "explanation": "配置接口的千兆以太网速度为1G。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "speed",
                    "type": "string",
                    "explanation": "接口速度，例如1g。"
                }
            ]
        },
        "set interfaces [parameter1] gigether-options link-mode [parameter2]": {
            "template": "set interfaces [parameter1] gigether-options link-mode [parameter2]",
            "command": "set interfaces ge-0/0/0 gigether-options link-mode full-duplex",
            "explanation": "配置接口的千兆以太网链路模式为全双工。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "link-mode",
                    "type": "string",
                    "explanation": "链路模式，例如full-duplex。"
                }
            ]
        }
    }
}