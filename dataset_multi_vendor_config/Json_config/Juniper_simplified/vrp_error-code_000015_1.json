{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 1-wide-metrics-only",
            "explanation": "配置ISIS协议的级别1仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS协议的级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用ISIS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2]": {
            "template": "set protocols isis interface [parameter1] level [parameter2]",
            "command": "set protocols isis interface ae1.0 level 1",
            "explanation": "在指定接口上启用ISIS协议的级别1。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae1.0。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，1表示级别1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ae1 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] gigether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] gigether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/0 gigether-options 802.3ad ae1",
            "explanation": "配置接口的链路聚合选项。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae1。"
                }
            ]
        }
    }
}