{
    "set system": {
        "template": "set system",
        "set system name host [parameter1]": {
            "template": "set system name host [parameter1]",
            "command": "set system name host PE1",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-distribution-protocol [parameter1]": {
            "template": "set protocols mpls label-distribution-protocol [parameter1]",
            "command": "set protocols mpls label-distribution-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如LDP。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1]": {
            "template": "set protocols mpls label-switched-path [parameter1]",
            "command": "set protocols mpls label-switched-path trust-upstream",
            "explanation": "配置MPLS的标签交换路径信任上游。",
            "parameters": [
                {
                    "name": "path",
                    "type": "string",
                    "explanation": "标签交换路径的信任设置，例如trust-upstream。"
                }
            ]
        },
        "set protocols mpls traffic-eng general router-id interface [parameter1]": {
            "template": "set protocols mpls traffic-eng general router-id interface [parameter1]",
            "command": "set protocols mpls traffic-eng general router-id interface \"gi1/0/0\"",
            "explanation": "配置MPLS流量工程的通用路由器ID接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "路由器ID接口名称，例如gi1/0/0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gi1/0/0 unit 0 family inet address 10.10.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gi1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces gi1/0/0 encapsulation gre",
            "explanation": "配置接口的封装类型为GRE。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gi1/0/0。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如GRE。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 1.1.1.9",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        },
        "set routing-options protocols ospf instances [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-options protocols ospf instances [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-options protocols ospf instances \"instance\" area 0 network 1.1.1.9/32",
            "explanation": "配置OSPF实例的区域网络。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "OSPF实例名称。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    }
}