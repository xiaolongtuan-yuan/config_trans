{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 discard",
            "explanation": "配置静态路由，将0.0.0.0/0路由丢弃。",
            "parameters": [
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "网络前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址或操作，如discard表示丢弃。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan-10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set vlans [parameter1] l3-interface [parameter2]": {
            "template": "set vlans [parameter1] l3-interface [parameter2]",
            "command": "set vlans vlan-10 l3-interface irb.10",
            "explanation": "将VLAN与三层接口关联。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "三层接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces irb unit 10 family inet address 10.1.3.2/24",
            "explanation": "配置三层接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如irb。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口为trunk模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching vlan members vlan-10",
            "explanation": "配置接口允许的VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "允许的VLAN名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-0/0/0 unit 0 disable",
            "explanation": "禁用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface irb.10",
            "explanation": "配置OSPF区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如irb.10。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] passive": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] passive",
            "command": "set protocols ospf area 0.0.0.0 interface irb.10 passive",
            "explanation": "配置OSPF接口为被动模式。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如irb.10。"
                }
            ]
        }
    }
}