{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 2.2.2.2",
            "explanation": "配置LDP协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的Router ID，用于标识LDP实例。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols mpls traffic-engineering": {
            "template": "set protocols mpls traffic-engineering",
            "command": "set protocols mpls traffic-engineering",
            "explanation": "启用MPLS流量工程。",
            "parameters": []
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 2 wide-metrics-only",
            "explanation": "配置IS-IS协议的Level 2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，2表示Level 2。"
                }
            ]
        },
        "set protocols isis level [parameter1] traffic-engineering": {
            "template": "set protocols isis level [parameter1] traffic-engineering",
            "command": "set protocols isis level 2 traffic-engineering",
            "explanation": "在IS-IS协议的Level 2启用流量工程。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，2表示Level 2。"
                }
            ]
        },
        "set protocols isis level [parameter1] segment-routing mpls": {
            "template": "set protocols isis level [parameter1] segment-routing mpls",
            "command": "set protocols isis level 2 segment-routing mpls",
            "explanation": "在IS-IS协议的Level 2启用MPLS分段路由。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，2表示Level 2。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0003.00",
            "explanation": "配置IS-IS协议的网络实体标题。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "IS-IS协议的网络实体标题，用于标识IS-IS实例。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-2/0/0 point-to-point",
            "explanation": "在指定接口上配置IS-IS协议为点对点模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                }
            ]
        },
        "set protocols mpls traffic-engineering interface [parameter1]": {
            "template": "set protocols mpls traffic-engineering interface [parameter1]",
            "command": "set protocols mpls traffic-engineering interface ge-2/0/0",
            "explanation": "在指定接口上启用MPLS流量工程。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                }
            ]
        },
        "set protocols isis interface [parameter1] passive": {
            "template": "set protocols isis interface [parameter1] passive",
            "command": "set protocols isis interface lo0 passive",
            "explanation": "在指定接口上配置IS-IS协议为被动模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family iso": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso",
            "command": "set interfaces ge-2/0/0 unit 0 family iso",
            "explanation": "在接口上启用ISO协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}