{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains bd10 vlan-id 10",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd10。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "set bridge-domains [parameter1] routing-interface [parameter2]": {
            "template": "set bridge-domains [parameter1] routing-interface [parameter2]",
            "command": "set bridge-domains bd10 routing-interface irb.10",
            "explanation": "配置桥接域的路由接口。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd10。"
                },
                {
                    "name": "routing-interface",
                    "type": "string",
                    "explanation": "路由接口名称，例如irb.10。"
                }
            ]
        },
        "set bridge-domains [parameter1] interface [parameter2]": {
            "template": "set bridge-domains [parameter1] interface [parameter2]",
            "command": "set bridge-domains bd10 interface ae10.100",
            "explanation": "配置桥接域的接口。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd10。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.100。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces irb unit 10 family inet address 192.168.1.12/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如irb。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]": {
            "template": "set interfaces [parameter1] aggregated-ether-options link-speed [parameter2]",
            "command": "set interfaces ae10 aggregated-ether-options link-speed 1g",
            "explanation": "配置聚合以太网接口的链路速度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "link-speed",
                    "type": "string",
                    "explanation": "链路速度，例如1g。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ae10 unit 100 vlan-id 100",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-1/0/0 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项，将其加入指定的聚合组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    }
}