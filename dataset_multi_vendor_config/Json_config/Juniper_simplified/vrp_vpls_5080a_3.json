{
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] family inet unicast": {
            "template": "set routing-instances [parameter1] family inet unicast",
            "command": "set routing-instances r0 family inet unicast",
            "explanation": "配置路由实例的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances r0 interface ge-0/0/0.0",
            "explanation": "将接口分配给特定的路由实例。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，包括单元号。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options forwarder": {
            "template": "set forwarding-options forwarder",
            "command": "set forwarding-options forwarder",
            "explanation": "启用转发器功能。",
            "parameters": []
        },
        "set forwarding-options mpls traffic-eng tunnels [parameter1] path-option [parameter2] host-name [parameter3]": {
            "template": "set forwarding-options mpls traffic-eng tunnels [parameter1] path-option [parameter2] host-name [parameter3]",
            "command": "set forwarding-options mpls traffic-eng tunnels tunnel1 path-option 2pe1 host-name path2pe1",
            "explanation": "配置MPLS流量工程隧道的路径选项和主机名。",
            "parameters": [
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道的名称。"
                },
                {
                    "name": "path-option",
                    "type": "string",
                    "explanation": "路径选项的名称。"
                },
                {
                    "name": "host-name",
                    "type": "string",
                    "explanation": "主机名，用于标识路径。"
                }
            ]
        },
        "set forwarding-options mpls traffic-eng tunnel-ttl-security [parameter1]": {
            "template": "set forwarding-options mpls traffic-eng tunnel-ttl-security [parameter1]",
            "command": "set forwarding-options mpls traffic-eng tunnel-ttl-security disable",
            "explanation": "禁用MPLS流量工程隧道的TTL安全功能。",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "启用或禁用TTL安全功能。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 10.20.1.0/24",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域的编号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols ospf opaque-lsas capability [parameter1]": {
            "template": "set protocols ospf opaque-lsas capability [parameter1]",
            "command": "set protocols ospf opaque-lsas capability enable",
            "explanation": "启用OSPF的不透明LSA能力。",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "启用或禁用不透明LSA能力。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 3.3.3.9/30",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/2 unit 0 family mpls",
            "explanation": "配置接口的MPLS地址族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set family": {
        "template": "set family",
        "set family inet unicast route-target import [parameter1]:[parameter2]": {
            "template": "set family inet unicast route-target import [parameter1]:[parameter2]",
            "command": "set family inet unicast route-target import 10:1",
            "explanation": "配置IPv4单播地址族的导入路由目标。",
            "parameters": [
                {
                    "name": "route-target",
                    "type": "string",
                    "explanation": "路由目标的格式，例如10:1。"
                }
            ]
        }
    }
}