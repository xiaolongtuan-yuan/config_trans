{
    "host-name": {
        "template": "host-name",
        "host-name [parameter1]": {
            "template": "host-name [parameter1]",
            "command": "host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface": {
        "template": "interface",
        "interface [parameter1]": {
            "template": "interface [parameter1]",
            "command": "interface ge-0/0/0",
            "explanation": "进入指定接口的配置模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ],
            "sub-commands": {
                "template": "sub-commands",
                "no shutdown": {
                    "template": "no shutdown",
                    "command": "no shutdown",
                    "explanation": "启用接口。",
                    "parameters": []
                },
                "ipv6 enable": {
                    "template": "ipv6 enable",
                    "command": "ipv6 enable",
                    "explanation": "启用接口的IPv6功能。",
                    "parameters": []
                },
                "ipv6 address [parameter1]/[parameter2]": {
                    "template": "ipv6 address [parameter1]/[parameter2]",
                    "command": "ipv6 address 2001:DB8::3/64",
                    "explanation": "配置接口的IPv6地址及前缀长度。",
                    "parameters": [
                        {
                            "name": "ipv6-address",
                            "type": "string",
                            "explanation": "分配给接口的IPv6地址。"
                        },
                        {
                            "name": "prefix-length",
                            "type": "integer",
                            "explanation": "IPv6地址的前缀长度。"
                        }
                    ]
                },
                "ipv6 ospf [parameter1] area [parameter2]": {
                    "template": "ipv6 ospf [parameter1] area [parameter2]",
                    "command": "ipv6 ospf 1 area 0.0.0.0",
                    "explanation": "配置接口参与OSPFv3进程，并指定区域。",
                    "parameters": [
                        {
                            "name": "ospf-process-id",
                            "type": "integer",
                            "explanation": "OSPF进程ID。"
                        },
                        {
                            "name": "area-id",
                            "type": "string",
                            "explanation": "OSPF区域ID。"
                        }
                    ]
                }
            }
        }
    }
}