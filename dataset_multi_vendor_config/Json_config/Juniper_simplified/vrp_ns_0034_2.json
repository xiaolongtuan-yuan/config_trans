{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-1/0/0",
            "explanation": "在指定接口上启用OSPF协议，并指定区域。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] passive": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] passive",
            "command": "set protocols ospf area 0 interface lo0.1 passive",
            "explanation": "在指定接口上启用OSPF协议，指定区域，并设置为被动接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-1/0/0",
            "explanation": "在指定接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 3.3.3.9",
            "explanation": "配置LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的路由器ID。"
                }
            ]
        },
        "set protocols ldp targetted-hello [parameter1]": {
            "template": "set protocols ldp targetted-hello [parameter1]",
            "command": "set protocols ldp targetted-hello 1.1.1.9",
            "explanation": "配置LDP协议的目标Hello地址。",
            "parameters": [
                {
                    "name": "targetted-hello",
                    "type": "string",
                    "explanation": "LDP协议的目标Hello地址。"
                }
            ]
        },
        "set protocols rsvp interface [parameter1]": {
            "template": "set protocols rsvp interface [parameter1]",
            "command": "set protocols rsvp interface ge-1/0/0",
            "explanation": "在指定接口上启用RSVP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1]": {
            "template": "set protocols mpls label-switched-path [parameter1]",
            "command": "set protocols mpls label-switched-path auto-bandwidth",
            "explanation": "配置MPLS标签交换路径的自动带宽调整。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "MPLS标签交换路径的配置项。"
                }
            ]
        },
        "set protocols mpls traffic-engineering [parameter1]": {
            "template": "set protocols mpls traffic-engineering [parameter1]",
            "command": "set protocols mpls traffic-engineering bgp-igp",
            "explanation": "配置MPLS流量工程的BGP-IGP同步。",
            "parameters": [
                {
                    "name": "traffic-engineering",
                    "type": "string",
                    "explanation": "MPLS流量工程的配置项。"
                }
            ]
        },
        "set protocols mpls traffic-engineering family [parameter1]": {
            "template": "set protocols mpls traffic-engineering family [parameter1]",
            "command": "set protocols mpls traffic-engineering family inet",
            "explanation": "配置MPLS流量工程支持IPv4协议族。",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族类型，inet表示IPv4。"
                }
            ]
        },
        "set protocols mpls traffic-engineering logging [parameter1]": {
            "template": "set protocols mpls traffic-engineering logging [parameter1]",
            "command": "set protocols mpls traffic-engineering logging bandwidth-changes",
            "explanation": "配置MPLS流量工程的带宽变化日志记录。",
            "parameters": [
                {
                    "name": "logging",
                    "type": "string",
                    "explanation": "日志记录配置项。"
                }
            ]
        },
        "set protocols mpls traffic-engineering bfd-liveness-detection minimum-interval [parameter1]": {
            "template": "set protocols mpls traffic-engineering bfd-liveness-detection minimum-interval [parameter1]",
            "command": "set protocols mpls traffic-engineering bfd-liveness-detection minimum-interval 1000",
            "explanation": "配置MPLS流量工程的BFD存活检测最小间隔时间。",
            "parameters": [
                {
                    "name": "minimum-interval",
                    "type": "integer",
                    "explanation": "BFD存活检测的最小间隔时间，单位为毫秒。"
                }
            ]
        },
        "set protocols mpls traffic-engineering bfd-liveness-detection multiplier [parameter1]": {
            "template": "set protocols mpls traffic-engineering bfd-liveness-detection multiplier [parameter1]",
            "command": "set protocols mpls traffic-engineering bfd-liveness-detection multiplier 3",
            "explanation": "配置MPLS流量工程的BFD存活检测乘数。",
            "parameters": [
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD存活检测的乘数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "在指定接口单元上启用MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}