{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] gigether-options no-auto-negotiation": {
            "template": "set interfaces [parameter1] gigether-options no-auto-negotiation",
            "command": "set interfaces ge-1/0/1 gigether-options no-auto-negotiation",
            "explanation": "配置接口的千兆以太网选项，禁用自动协商。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 vlan-id 10",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 family bridge interface-mode access",
            "explanation": "配置接口单元的桥接模式为access。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，例如access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation extended-vlan-tagging": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation extended-vlan-tagging",
            "command": "set interfaces ge-1/0/1 unit 2 encapsulation extended-vlan-tagging",
            "explanation": "配置接口单元的封装类型为扩展VLAN标记。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-tags outer [parameter3] inner [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-tags outer [parameter3] inner [parameter4]",
            "command": "set interfaces ge-1/0/1 unit 2 vlan-tags outer 30 inner 10",
            "explanation": "配置接口单元的VLAN标签，包括外层和内层VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "outer-vlan-id",
                    "type": "integer",
                    "explanation": "外层VLAN ID。"
                },
                {
                    "name": "inner-vlan-id",
                    "type": "integer",
                    "explanation": "内层VLAN ID。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains vlan10 vlan-id 10",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如vlan10。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set bridge-domains [parameter1] vlan-id-list [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id-list [parameter2]",
            "command": "set bridge-domains vlan30_10 vlan-id-list [30 10]",
            "explanation": "配置桥接域的VLAN ID列表。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如vlan30_10。"
                },
                {
                    "name": "vlan-id-list",
                    "type": "list",
                    "explanation": "VLAN ID列表，用于标识多个VLAN。"
                }
            ]
        }
    }
}