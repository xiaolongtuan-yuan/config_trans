{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name RR1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-3/0/1 unit 0 family inet address 172.16.4.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] description [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] description [parameter3]",
            "command": "set interfaces ge-3/0/1 unit 0 description \"Active Interface\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65009",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "自治系统号，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 4.4.4.4",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 172.16.2.1",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP组的邻居地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group internal export policy1",
            "explanation": "配置BGP组的路由导出策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "BGP组的路由导出策略名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组的地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "BGP组的地址族类型，例如inet。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] send-community": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] send-community",
            "command": "set protocols bgp group internal neighbor 172.16.2.1 send-community",
            "explanation": "配置BGP组的邻居发送社区属性。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP组的邻居地址。"
                },
                {
                    "name": "send-community",
                    "type": "string",
                    "explanation": "配置邻居发送社区属性。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] then local-preference [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then local-preference [parameter3]",
            "command": "set policy-options policy-statement policy1 term 1 then local-preference 130",
            "explanation": "配置路由策略的本地优先级。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "路由策略的术语编号。"
                },
                {
                    "name": "local-preference",
                    "type": "integer",
                    "explanation": "路由的本地优先级值。"
                }
            ]
        }
    }
}