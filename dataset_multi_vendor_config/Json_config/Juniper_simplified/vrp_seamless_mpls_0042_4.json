{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name MASG",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bfd [parameter1]": {
            "template": "set protocols bfd [parameter1]",
            "command": "set protocols bfd all-interfaces",
            "explanation": "在所有接口上启用BFD协议。",
            "parameters": [
                {
                    "name": "all-interfaces",
                    "type": "string",
                    "explanation": "指定在所有接口上启用BFD。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "指定在所有接口上启用LDP。"
                }
            ]
        },
        "set protocols ldp transport-address-interface [parameter1]": {
            "template": "set protocols ldp transport-address-interface [parameter1]",
            "command": "set protocols ldp transport-address-interface lo0.0",
            "explanation": "指定LDP协议的传输地址接口。",
            "parameters": [
                {
                    "name": "transport-address-interface",
                    "type": "string",
                    "explanation": "指定LDP协议的传输地址接口。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "指定在所有接口上启用MPLS。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external-peers type external",
            "explanation": "配置BGP对等组类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP对等组类型，此处为外部。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group external-peers neighbor 4.4.4.4 peer-as 200",
            "explanation": "配置BGP邻居的AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] local-address [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] local-address [parameter3]",
            "command": "set protocols bgp group external-peers neighbor 4.4.4.4 local-address 5.5.5.5",
            "explanation": "配置BGP邻居的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP邻居的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]",
            "command": "set protocols bgp group external-peers neighbor 4.4.4.4 family inet unicast",
            "explanation": "配置BGP邻居的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，此处为inet。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "指定为单播地址族。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] export [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] export [parameter3]",
            "command": "set protocols bgp group external-peers neighbor 4.4.4.4 export EXPORT-POLICY",
            "explanation": "配置BGP邻居的导出策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] [parameter3]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] [parameter3]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0 passive",
            "explanation": "配置OSPF区域接口为被动模式。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "passive",
                    "type": "string",
                    "explanation": "指定接口为被动模式。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-2/0/0.0",
            "explanation": "配置OSPF区域接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet address 10.4.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-2/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族类型，此处为mpls。"
                }
            ]
        },
        "set interfaces [parameter1] gigether-options [parameter2]": {
            "template": "set interfaces [parameter1] gigether-options [parameter2]",
            "command": "set interfaces ge-2/0/0 gigether-options no-auto-negotiation",
            "explanation": "配置接口的千兆以太网选项为不自动协商。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "gigether-options",
                    "type": "string",
                    "explanation": "千兆以太网选项。"
                },
                {
                    "name": "no-auto-negotiation",
                    "type": "string",
                    "explanation": "指定不自动协商。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement EXPORT-POLICY term 10 from protocol direct",
            "explanation": "配置策略语句的匹配条件为直接路由协议。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "from",
                    "type": "string",
                    "explanation": "匹配条件来源。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议类型，此处为direct。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]",
            "command": "set policy-options policy-statement EXPORT-POLICY term 10 from route-filter 5.5.5.5/32 exact",
            "explanation": "配置策略语句的匹配条件为精确匹配特定路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "from",
                    "type": "string",
                    "explanation": "匹配条件来源。"
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "路由过滤器，指定匹配的路由。"
                },
                {
                    "name": "exact",
                    "type": "string",
                    "explanation": "指定为精确匹配。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement EXPORT-POLICY term 10 then accept",
            "explanation": "配置策略语句的动作条件为接受。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "then",
                    "type": "string",
                    "explanation": "动作条件，此处为接受。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then set [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then set [parameter3]",
            "command": "set policy-options policy-statement EXPORT-POLICY term 10 then set mpls-label",
            "explanation": "配置策略语句的动作条件为设置MPLS标签。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "then",
                    "type": "string",
                    "explanation": "动作条件，此处为设置。"
                },
                {
                    "name": "mpls-label",
                    "type": "string",
                    "explanation": "指定设置的MPLS标签。"
                }
            ]
        }
    }
}