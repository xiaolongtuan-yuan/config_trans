{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 0",
            "explanation": "配置PTP（精确时间协议）的域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域的编号。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0",
            "explanation": "配置OSPF（开放最短路径优先）协议的区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的标识符。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "参与OSPF协议的接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.0.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] disable [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 disable false",
            "explanation": "启用或禁用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "是否禁用接口，false表示启用。"
                }
            ]
        }
    }
}