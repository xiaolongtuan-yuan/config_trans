{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast": {
            "template": "set routing-options multicast",
            "command": "set routing-options multicast",
            "explanation": "启用多播路由。",
            "parameters": []
        }
    },
    "set firewall": {
        "template": "set firewall",
        "set firewall family inet filter [parameter1] term [parameter2] from destination-address [parameter3]/[parameter4]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] from destination-address [parameter3]/[parameter4]",
            "command": "set firewall family inet filter acl-2000 term 1 from destination-address 232.1.1.0/24",
            "explanation": "配置防火墙过滤器的条件，指定目的地址。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "防火墙过滤器的名称。"
                },
                {
                    "name": "term-number",
                    "type": "integer",
                    "explanation": "过滤条件的序号。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]": {
            "template": "set firewall family inet filter [parameter1] term [parameter2] then [parameter3]",
            "command": "set firewall family inet filter acl-2000 term 1 then accept",
            "explanation": "配置防火墙过滤器的动作，接受匹配的流量。",
            "parameters": [
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "防火墙过滤器的名称。"
                },
                {
                    "name": "term-number",
                    "type": "integer",
                    "explanation": "过滤条件的序号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对匹配流量的处理动作，如accept。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 1-2 wide-metrics-only",
            "explanation": "配置IS-IS协议的级别1和2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS协议的级别，如1-2。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，如all表示所有接口。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-0/0/0 point-to-point",
            "explanation": "配置指定接口为点对点模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，如ge-0/0/0。"
                }
            ]
        },
        "set protocols isis level [parameter1] network-entity [parameter2]": {
            "template": "set protocols isis level [parameter1] network-entity [parameter2]",
            "command": "set protocols isis level 1-2 network-entity 10.0000.0000.0001.00",
            "explanation": "配置IS-IS协议的网络实体标题。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS协议的级别，如1-2。"
                },
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体标题。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-0/0/0 mode sparse",
            "explanation": "配置PIM协议的接口模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，如ge-0/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，如sparse。"
                }
            ]
        },
        "set protocols pim ssm": {
            "template": "set protocols pim ssm",
            "command": "set protocols pim ssm",
            "explanation": "启用PIM SSM（源特定多播）。",
            "parameters": []
        },
        "set protocols pim ssm range [parameter1]/[parameter2]": {
            "template": "set protocols pim ssm range [parameter1]/[parameter2]",
            "command": "set protocols pim ssm range 232.1.1.0/24",
            "explanation": "配置PIM SSM的范围。",
            "parameters": [
                {
                    "name": "ssm-range",
                    "type": "string",
                    "explanation": "SSM范围，如232.1.1.0/24。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.2.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet filter input [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet filter input [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet filter input acl-2000",
            "explanation": "配置接口的输入过滤器。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "过滤器名称，如acl-2000。"
                }
            ]
        }
    }
}