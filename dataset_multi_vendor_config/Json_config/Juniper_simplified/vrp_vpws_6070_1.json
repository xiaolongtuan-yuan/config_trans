{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces vlan10 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如vlan10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] link-mode [parameter2]": {
            "template": "set interfaces [parameter1] link-mode [parameter2]",
            "command": "set interfaces gigabitethernet1_0_0 link-mode trunk",
            "explanation": "配置接口的链路模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet1_0_0。"
                },
                {
                    "name": "link-mode",
                    "type": "string",
                    "explanation": "接口的链路模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces gigabitethernet1_0_0 unit 0 family ethernet-switching vlan members vlan-10",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet1_0_0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员，例如vlan-10。"
                }
            ]
        },
        "set interfaces [parameter1] shutdown [parameter2]": {
            "template": "set interfaces [parameter1] shutdown [parameter2]",
            "command": "set interfaces gigabitethernet1_0_0 shutdown disable",
            "explanation": "禁用接口的关闭状态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet1_0_0。"
                },
                {
                    "name": "shutdown",
                    "type": "string",
                    "explanation": "关闭状态，例如disable。"
                }
            ]
        }
    },
    "set security monitor cfm": {
        "template": "set security monitor cfm",
        "set security monitor cfm md [parameter1]": {
            "template": "set security monitor cfm md [parameter1]",
            "command": "set security monitor cfm md md1",
            "explanation": "配置CFM的维护域。",
            "parameters": [
                {
                    "name": "md",
                    "type": "string",
                    "explanation": "维护域名称，例如md1。"
                }
            ]
        },
        "set security monitor cfm domain [parameter1] id [parameter2] interface-[parameter3] direction [parameter4]": {
            "template": "set security monitor cfm domain [parameter1] id [parameter2] interface-[parameter3] direction [parameter4]",
            "command": "set security monitor cfm domain ma1 id 2 interface-gigabitethernet1_0_0 direction outward",
            "explanation": "配置CFM域的接口方向。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "域名称，例如ma1。"
                },
                {
                    "name": "id",
                    "type": "integer",
                    "explanation": "域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet1_0_0。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向，例如outward。"
                }
            ]
        },
        "set security monitor cfm domain [parameter1] id [parameter2] ccm-send": {
            "template": "set security monitor cfm domain [parameter1] id [parameter2] ccm-send",
            "command": "set security monitor cfm domain ma1 id 2 ccm-send",
            "explanation": "配置CFM域的CCM发送。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "域名称，例如ma1。"
                },
                {
                    "name": "id",
                    "type": "integer",
                    "explanation": "域ID。"
                }
            ]
        },
        "set security monitor cfm domain [parameter1] id [parameter2] remote-mep": {
            "template": "set security monitor cfm domain [parameter1] id [parameter2] remote-mep",
            "command": "set security monitor cfm domain ma1 id 1 remote-mep",
            "explanation": "配置CFM域的远程MEP。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "域名称，例如ma1。"
                },
                {
                    "name": "id",
                    "type": "integer",
                    "explanation": "域ID。"
                }
            ]
        },
        "set security monitor cfm domain [parameter1] id [parameter2] ccm-receive": {
            "template": "set security monitor cfm domain [parameter1] id [parameter2] ccm-receive",
            "command": "set security monitor cfm domain ma1 id 1 ccm-receive",
            "explanation": "配置CFM域的CCM接收。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "域名称，例如ma1。"
                },
                {
                    "name": "id",
                    "type": "integer",
                    "explanation": "域ID。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}