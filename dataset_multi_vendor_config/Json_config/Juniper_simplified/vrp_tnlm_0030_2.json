{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interface": {
        "template": "set interface",
        "set interface [parameter1] unit [parameter2] [parameter3]/[parameter4]": {
            "template": "set interface [parameter1] unit [parameter2] [parameter3]/[parameter4]",
            "command": "set interface ge-0/0/0 unit 0 10.1.1.1/29",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interface [parameter1] family inet address [parameter2]/[parameter3]": {
            "template": "set interface [parameter1] family inet address [parameter2]/[parameter3]",
            "command": "set interface lo0 family inet address 3.3.3.3/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65410",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP协议。"
                }
            ]
        },
        "set routing-options rib all neighbors [parameter1] source-ip [parameter2]": {
            "template": "set routing-options rib all neighbors [parameter1] source-ip [parameter2]",
            "command": "set routing-options rib all neighbors 10.1.1.2 source-ip 10.1.1.1",
            "explanation": "配置RIB中邻居的源IP地址。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "source-ip",
                    "type": "string",
                    "explanation": "用于与邻居通信的源IP地址。"
                }
            ]
        },
        "set routing-options rib all neighbors [parameter1] peer-as [parameter2]": {
            "template": "set routing-options rib all neighbors [parameter1] peer-as [parameter2]",
            "command": "set routing-options rib all neighbors 10.1.1.2 peer-as 100",
            "explanation": "配置RIB中邻居的自治系统号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的自治系统号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp neighbor [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp neighbor [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp neighbor 10.1.1.2 peer-as 100",
            "explanation": "配置BGP邻居及其自治系统号。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的自治系统号。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] export route-map [parameter2]": {
            "template": "set protocols bgp peer-group [parameter1] export route-map [parameter2]",
            "command": "set protocols bgp peer-group default export route-map import-route",
            "explanation": "配置BGP对等组的出口路由映射。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "route-map",
                    "type": "string",
                    "explanation": "出口路由映射名称。"
                }
            ]
        },
        "set protocols bgp peer-group [parameter1] export route-map [parameter2] import route-map [parameter3]": {
            "template": "set protocols bgp peer-group [parameter1] export route-map [parameter2] import route-map [parameter3]",
            "command": "set protocols bgp peer-group default export route-map import-route import route-map export-route",
            "explanation": "配置BGP对等组的出口和入口路由映射。",
            "parameters": [
                {
                    "name": "peer-group",
                    "type": "string",
                    "explanation": "BGP对等组名称。"
                },
                {
                    "name": "export-route-map",
                    "type": "string",
                    "explanation": "出口路由映射名称。"
                },
                {
                    "name": "import-route-map",
                    "type": "string",
                    "explanation": "入口路由映射名称。"
                }
            ]
        }
    },
    "set route-object": {
        "template": "set route-object",
        "set route-object create [parameter1] route [parameter2]": {
            "template": "set route-object create [parameter1] route [parameter2]",
            "command": "set route-object create ro_3_3_3_0/32 route 3.3.3.3/32",
            "explanation": "创建路由对象并指定路由。",
            "parameters": [
                {
                    "name": "route-object",
                    "type": "string",
                    "explanation": "路由对象名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "路由的IP地址及子网掩码。"
                }
            ]
        }
    }
}