{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim rp static address [parameter1]": {
            "template": "set protocols pim rp static address [parameter1]",
            "command": "set protocols pim rp static address 2.2.2.2",
            "explanation": "配置PIM（Protocol Independent Multicast）的静态RP（Rendezvous Point）地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "RP的IPv4地址。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ae1.0 mode sparse",
            "explanation": "配置PIM接口的模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae1.0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0",
            "explanation": "配置OSPF（Open Shortest Path First）区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] description [parameter2]": {
            "template": "set interfaces [parameter1] description [parameter2]",
            "command": "set interfaces ae1 description \"e-trunk 1\"",
            "explanation": "配置接口的描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae1。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ae1 unit 0 family inet address 10.0.15.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-0/0/1 enable",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/2 ether-options 802.3ad ae1",
            "explanation": "配置接口的以太网选项，将其加入到链路聚合组中。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "链路聚合组的接口名称，例如ae1。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options multicast": {
            "template": "set routing-options multicast",
            "command": "set routing-options multicast",
            "explanation": "启用多播路由。",
            "parameters": []
        }
    }
}