{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis router-id [parameter1]": {
            "template": "set protocols isis router-id [parameter1]",
            "command": "set protocols isis router-id 10.0.0.3",
            "explanation": "配置ISIS协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "ISIS协议的Router ID，用于标识路由器。"
                }
            ]
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 1-2",
            "explanation": "配置ISIS协议的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS协议的级别，可以是1、2或1-2。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0003.00",
            "explanation": "配置ISIS协议的网络实体。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "ISIS协议的网络实体标识符。"
                }
            ]
        },
        "set protocols isis ipv6-topology": {
            "template": "set protocols isis ipv6-topology",
            "command": "set protocols isis ipv6-topology",
            "explanation": "启用ISIS协议的IPv6拓扑。",
            "parameters": []
        },
        "set protocols isis interface [parameter1] family inet6": {
            "template": "set protocols isis interface [parameter1] family inet6",
            "command": "set protocols isis interface ge-1/0/0.0 family inet6",
            "explanation": "在指定接口上启用ISIS协议的IPv6支持。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        },
        "set protocols isis interface [parameter1] level [parameter2]": {
            "template": "set protocols isis interface [parameter1] level [parameter2]",
            "command": "set protocols isis interface ge-3/0/0.0 level 1-2",
            "explanation": "配置指定接口的ISIS协议级别。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/0.0。"
                },
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS协议的级别，可以是1、2或1-2。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family iso": {
            "template": "set interfaces [parameter1] unit [parameter2] family iso",
            "command": "set interfaces ge-1/0/0 unit 0 family iso",
            "explanation": "在指定接口上启用ISO协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}