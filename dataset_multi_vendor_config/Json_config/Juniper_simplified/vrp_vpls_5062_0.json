{
    "host-name": {
        "template": "host-name",
        "host-name [parameter1]": {
            "template": "host-name [parameter1]",
            "command": "host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface gigabitethernet 0/0/0": {
        "template": "interface gigabitethernet 0/0/0",
        "interface gigabitethernet [parameter1] no shutdown": {
            "template": "interface gigabitethernet [parameter1] no shutdown",
            "command": "interface gigabitethernet 0/0/0 no shutdown",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet 0/0/0。"
                }
            ]
        }
    },
    "interface gigabitethernet 0/0/0.1": {
        "template": "interface gigabitethernet 0/0/0.1",
        "interface gigabitethernet [parameter1] unit [parameter2] family inet ip address [parameter3]/[parameter4]": {
            "template": "interface gigabitethernet [parameter1] unit [parameter2] family inet ip address [parameter3]/[parameter4]",
            "command": "interface gigabitethernet 0/0/0.1 unit 10 family inet ip address 10.1.1.1/24",
            "explanation": "配置子接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "子接口名称，例如gigabitethernet 0/0/0.1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给子接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}