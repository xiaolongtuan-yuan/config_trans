{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASG1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp enable": {
            "template": "set protocols ptp enable",
            "command": "set protocols ptp enable",
            "explanation": "启用PTP（精确时间协议）。",
            "parameters": []
        },
        "set protocols ptp device-type [parameter1]": {
            "template": "set protocols ptp device-type [parameter1]",
            "command": "set protocols ptp device-type boundary-clock",
            "explanation": "配置PTP设备类型为边界时钟。",
            "parameters": [
                {
                    "name": "device-type",
                    "type": "string",
                    "explanation": "PTP设备类型，例如boundary-clock。"
                }
            ]
        },
        "set protocols ptp domain [parameter1]": {
            "template": "set protocols ptp domain [parameter1]",
            "command": "set protocols ptp domain 255",
            "explanation": "配置PTP域。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域的编号。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] clock-synchronization enable": {
            "template": "set protocols ptp interface [parameter1] clock-synchronization enable",
            "command": "set protocols ptp interface ge-0/0/0 clock-synchronization enable",
            "explanation": "在指定接口上启用时钟同步。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] clock-priority [parameter2]": {
            "template": "set protocols ptp interface [parameter1] clock-priority [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 clock-priority 1",
            "explanation": "配置指定接口的时钟优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟优先级，数值越小优先级越高。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] master-grandmaster": {
            "template": "set protocols ptp interface [parameter1] master-grandmaster",
            "command": "set protocols ptp interface ge-0/0/0 master-grandmaster",
            "explanation": "配置指定接口为主时钟。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] delay-mechanism [parameter2]": {
            "template": "set protocols ptp interface [parameter1] delay-mechanism [parameter2]",
            "command": "set protocols ptp interface ge-0/0/0 delay-mechanism peer-to-peer-delay",
            "explanation": "配置指定接口的延迟机制为对等延迟。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "delay-mechanism",
                    "type": "string",
                    "explanation": "延迟机制类型，例如peer-to-peer-delay。"
                }
            ]
        },
        "set protocols ptp interface [parameter1] enable": {
            "template": "set protocols ptp interface [parameter1] enable",
            "command": "set protocols ptp interface ge-0/0/0 enable",
            "explanation": "在指定接口上启用PTP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-0/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching port-mode access",
            "explanation": "配置接口的以太网交换端口模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如access。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改。",
            "parameters": []
        }
    }
}