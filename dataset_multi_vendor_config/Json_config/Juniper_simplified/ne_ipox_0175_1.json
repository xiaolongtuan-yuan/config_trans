{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name HUAWEI",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services dhcp pool [parameter1] network [parameter2]/[parameter3]": {
            "template": "set system services dhcp pool [parameter1] network [parameter2]/[parameter3]",
            "command": "set system services dhcp pool pool1 network 172.30.0.0/24",
            "explanation": "配置DHCP服务的地址池及其网络地址和子网掩码。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCP地址池的名称。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "DHCP地址池的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "网络地址的子网掩码位数。"
                }
            ]
        },
        "set system services dhcp pool [parameter1] default-router [parameter2]": {
            "template": "set system services dhcp pool [parameter1] default-router [parameter2]",
            "command": "set system services dhcp pool pool1 default-router 172.30.0.1",
            "explanation": "配置DHCP地址池的默认网关。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCP地址池的名称。"
                },
                {
                    "name": "default-router",
                    "type": "string",
                    "explanation": "DHCP地址池的默认网关地址。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set system login user [parameter1] authentication-method [parameter2]": {
            "template": "set system login user [parameter1] authentication-method [parameter2]",
            "command": "set system login user rdp authentication-method radius",
            "explanation": "配置用户登录的认证方法。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access radius-server [parameter1] primary secret [parameter2]": {
            "template": "set access radius-server [parameter1] primary secret [parameter2]",
            "command": "set access radius-server 10.1.123.151 primary secret \"%^%#}v{/ZA}>yTiC'[0bvy'X\"N[+,uj*U)L0^5;4Jtf6%^%#\"",
            "explanation": "配置RADIUS服务器的主服务器地址及其共享密钥。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与RADIUS服务器通信的共享密钥。"
                }
            ]
        },
        "set access radius-server dynamic-author [parameter1] secret [parameter2]": {
            "template": "set access radius-server dynamic-author [parameter1] secret [parameter2]",
            "command": "set access radius-server dynamic-author 10.1.0.201 secret \"%^%#}v{/ZA}>yTiC'[0bvy'X\"N[+,uj*U)L0^5;4Jtf6%^%#\"",
            "explanation": "配置RADIUS动态授权服务器的地址及其共享密钥。",
            "parameters": [
                {
                    "name": "server-address",
                    "type": "string",
                    "explanation": "RADIUS动态授权服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与RADIUS动态授权服务器通信的共享密钥。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.1.0.197/8",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set subscriber-template": {
        "template": "set subscriber-template",
        "set subscriber-template bas domain authentication [parameter1]": {
            "template": "set subscriber-template bas domain authentication [parameter1]",
            "command": "set subscriber-template bas domain authentication radiusproxy",
            "explanation": "配置BAS模板的域认证方法。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radiusproxy。"
                }
            ]
        },
        "set subscriber-template bas authentication bind": {
            "template": "set subscriber-template bas authentication bind",
            "command": "set subscriber-template bas authentication bind",
            "explanation": "配置BAS模板的认证绑定。",
            "parameters": []
        }
    }
}