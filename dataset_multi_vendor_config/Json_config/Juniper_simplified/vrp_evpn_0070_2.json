{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name NPE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn1 route-distinguisher 10:2",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同的路由实例。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target [parameter2]",
            "command": "set routing-instances vpn1 vrf-target target:2:2",
            "explanation": "配置路由实例的VRF目标。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由的导入和导出。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 3.3.3.3",
            "explanation": "配置LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的路由器ID。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用ISIS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols isis level [parameter1] disable": {
            "template": "set protocols isis level [parameter1] disable",
            "command": "set protocols isis level 2 disable",
            "explanation": "禁用ISIS协议的Level 2。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0000.0000.0000.0003.00",
            "explanation": "配置ISIS协议的NET地址。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "ISIS协议的NET地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 3.3.3.3",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 2.2.2.2",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP组的邻居地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group internal family inet unicast",
            "explanation": "配置BGP组的IPv4单播地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet-vpn [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet-vpn [parameter2]",
            "command": "set protocols bgp group internal family inet-vpn unicast",
            "explanation": "配置BGP组的IPv4 VPN单播地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet-vpn unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family evpn [parameter2]": {
            "template": "set protocols bgp group [parameter1] family evpn [parameter2]",
            "command": "set protocols bgp group internal family evpn signaling",
            "explanation": "配置BGP组的EVPN信令地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如evpn signaling。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrf-table-label": {
            "template": "set interfaces [parameter1] unit [parameter2] vrf-table-label",
            "command": "set interfaces ge-2/0/0 unit 0 vrf-table-label",
            "explanation": "在接口上启用VRF表标签。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 100",
            "explanation": "配置路由选项的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "自治系统号，用于标识网络中的设备。"
                }
            ]
        }
    }
}