{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order [ local ]",
            "explanation": "配置系统的认证顺序。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "array",
                    "explanation": "认证顺序列表，例如[ local ]。"
                }
            ]
        },
        "set system login user [parameter1] authentication plaintext-password [parameter2]": {
            "template": "set system login user [parameter1] authentication plaintext-password [parameter2]",
            "command": "set system login user default authentication plaintext-password \"default-password\"",
            "explanation": "配置默认用户的认证密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名，例如default。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "用户的明文密码。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols l2tp enable": {
            "template": "set protocols l2tp enable",
            "command": "set protocols l2tp enable",
            "explanation": "启用L2TP协议。",
            "parameters": []
        },
        "set protocols l2tp class [parameter1] authentication [parameter2]": {
            "template": "set protocols l2tp class [parameter1] authentication [parameter2]",
            "command": "set protocols l2tp class lns1 authentication chap",
            "explanation": "配置L2TP类的认证方式为CHAP。",
            "parameters": [
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "L2TP类名，例如lns1。"
                },
                {
                    "name": "authentication",
                    "type": "string",
                    "explanation": "认证方式，例如chap。"
                }
            ]
        },
        "set protocols l2tp class [parameter1] tunnel password cipher [parameter2]": {
            "template": "set protocols l2tp class [parameter1] tunnel password cipher [parameter2]",
            "command": "set protocols l2tp class lns1 tunnel password cipher \"@%##!!!!!!!!!\"!!!!\"!!!!(!!!!1];16qfZ81fv\"uMoKKZ.1k`AO!X2K2N.b~'NB^V!!!!!!!!!!1!!!!o/4J(q\"J1F.!K9%M!6x8%@%\"",
            "explanation": "配置L2TP类的隧道密码。",
            "parameters": [
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "L2TP类名，例如lns1。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "隧道的加密密码。"
                }
            ]
        },
        "set protocols l2tp class [parameter1] tunnel name [parameter2]": {
            "template": "set protocols l2tp class [parameter1] tunnel name [parameter2]",
            "command": "set protocols l2tp class lns1 tunnel name lns1",
            "explanation": "配置L2TP类的隧道名称。",
            "parameters": [
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "L2TP类名，例如lns1。"
                },
                {
                    "name": "tunnel-name",
                    "type": "string",
                    "explanation": "隧道名称，例如lns1。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces virtual-template1 unit 0 family inet address 0.0.0.0/32",
            "explanation": "配置虚拟模板接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如virtual-template1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ppp-options [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp-options [parameter3]",
            "command": "set interfaces virtual-template1 unit 0 ppp-options chap",
            "explanation": "配置虚拟模板接口的PPP选项为CHAP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如virtual-template1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ppp-options",
                    "type": "string",
                    "explanation": "PPP选项，例如chap。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 1.1.1.1/32 next-hop 12.12.12.1",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "目标网络的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set access": {
        "template": "set access",
        "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]": {
            "template": "set access address-assignment pool [parameter1] family inet network [parameter2]/[parameter3]",
            "command": "set access address-assignment pool pool1 family inet network 10.10.0.102/30",
            "explanation": "配置地址分配池的网络地址及子网掩码。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "地址分配池名称，例如pool1。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set aaa": {
        "template": "set aaa",
        "set aaa accounting session [parameter1]": {
            "template": "set aaa accounting session [parameter1]",
            "command": "set aaa accounting session start-stop",
            "explanation": "配置AAA会话计费。",
            "parameters": [
                {
                    "name": "session",
                    "type": "string",
                    "explanation": "会话计费类型，例如start-stop。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security vpn vpdn-group [parameter1] accept-dial-in protocol [parameter2] virtual-template [parameter3]": {
            "template": "set security vpn vpdn-group [parameter1] accept-dial-in protocol [parameter2] virtual-template [parameter3]",
            "command": "set security vpn vpdn-group lns1 accept-dial-in protocol l2tp virtual-template 1",
            "explanation": "配置VPN VPDN组接受拨入的协议及虚拟模板。",
            "parameters": [
                {
                    "name": "vpdn-group",
                    "type": "string",
                    "explanation": "VPDN组名称，例如lns1。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "拨入协议，例如l2tp。"
                },
                {
                    "name": "virtual-template",
                    "type": "integer",
                    "explanation": "虚拟模板编号。"
                }
            ]
        },
        "set security vpn vpdn-group [parameter1] bind-interface [parameter2]": {
            "template": "set security vpn vpdn-group [parameter1] bind-interface [parameter2]",
            "command": "set security vpn vpdn-group group1 bind-interface lo0.0",
            "explanation": "配置VPN VPDN组绑定接口。",
            "parameters": [
                {
                    "name": "vpdn-group",
                    "type": "string",
                    "explanation": "VPDN组名称，例如group1。"
                },
                {
                    "name": "bind-interface",
                    "type": "string",
                    "explanation": "绑定接口名称，例如lo0.0。"
                }
            ]
        }
    }
}