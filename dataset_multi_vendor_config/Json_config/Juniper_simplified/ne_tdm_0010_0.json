{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 192.168.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-2/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] framing [parameter2]": {
            "template": "set interfaces [parameter1] framing [parameter2]",
            "command": "set interfaces e1-1/0/1 framing crc4",
            "explanation": "配置E1接口的成帧类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/1。"
                },
                {
                    "name": "framing",
                    "type": "string",
                    "explanation": "成帧类型，例如crc4。"
                }
            ]
        },
        "set interfaces [parameter1] timeslots [parameter2]": {
            "template": "set interfaces [parameter1] timeslots [parameter2]",
            "command": "set interfaces e1-1/0/1 timeslots 1-31",
            "explanation": "配置E1接口的时隙。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/1。"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "时隙范围，例如1-31。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces e1-1/0/1 unit 0 encapsulation ppp",
            "explanation": "配置接口单元的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如ppp。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-2/0/0.0",
            "explanation": "配置MPLS协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0.0。"
                }
            ]
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 192.168.2.2",
            "explanation": "配置LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器ID，例如192.168.2.2。"
                }
            ]
        },
        "set protocols ldp targeted-hello [parameter1] [parameter2]": {
            "template": "set protocols ldp targeted-hello [parameter1] [parameter2]",
            "command": "set protocols ldp targeted-hello 192.168.2.2 192.168.3.3",
            "explanation": "配置LDP协议的定向Hello消息。",
            "parameters": [
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "源地址，例如192.168.2.2。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "目的地址，例如192.168.3.3。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0",
            "explanation": "配置OSPF协议的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域，例如0.0.0.0。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        }
    }
}