{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name SPE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.1",
            "explanation": "配置OSPF协议，指定区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.1。"
                }
            ]
        },
        "set protocols ldp router-id [parameter1]": {
            "template": "set protocols ldp router-id [parameter1]",
            "command": "set protocols ldp router-id 3.3.3.3",
            "explanation": "配置LDP协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP协议的Router ID。"
                }
            ]
        },
        "set protocols l2circuit pw-class [parameter1] signaling [parameter2]": {
            "template": "set protocols l2circuit pw-class [parameter1] signaling [parameter2]",
            "command": "set protocols l2circuit pw-class vsi1 signaling ldp",
            "explanation": "配置L2Circuit的PW-Class和信令协议。",
            "parameters": [
                {
                    "name": "pw-class",
                    "type": "string",
                    "explanation": "PW-Class名称。"
                },
                {
                    "name": "signaling",
                    "type": "string",
                    "explanation": "信令协议，例如LDP。"
                }
            ]
        },
        "set protocols l2circuit connection [parameter1] neighbor [parameter2] virtual-circuit-id [parameter3]": {
            "template": "set protocols l2circuit connection [parameter1] neighbor [parameter2] virtual-circuit-id [parameter3]",
            "command": "set protocols l2circuit connection vsi1-vc1 neighbor 1.1.1.1 virtual-circuit-id 1",
            "explanation": "配置L2Circuit连接，指定邻居和虚拟电路ID。",
            "parameters": [
                {
                    "name": "connection",
                    "type": "string",
                    "explanation": "连接名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "virtual-circuit-id",
                    "type": "integer",
                    "explanation": "虚拟电路ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.20.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}