{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system time-zone [parameter1]": {
            "template": "set system time-zone [parameter1]",
            "command": "set system time-zone UTC",
            "explanation": "配置设备的时区。",
            "parameters": [
                {
                    "name": "time-zone",
                    "type": "string",
                    "explanation": "设备的时区设置。"
                }
            ]
        },
        "set system clock priority [parameter1]": {
            "template": "set system clock priority [parameter1]",
            "command": "set system clock priority 1",
            "explanation": "配置系统时钟的优先级。",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "系统时钟的优先级，数值越小优先级越高。"
                }
            ]
        },
        "set system clock source [parameter1]": {
            "template": "set system clock source [parameter1]",
            "command": "set system clock source ptp",
            "explanation": "配置系统时钟的源。",
            "parameters": [
                {
                    "name": "source",
                    "type": "string",
                    "explanation": "系统时钟的源，例如ptp。"
                }
            ]
        },
        "set system clock ssm-prc": {
            "template": "set system clock ssm-prc",
            "command": "set system clock ssm-prc",
            "explanation": "配置系统时钟的SSM PRC（Primary Reference Clock）模式。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 3.3.3.3/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ptp interface [parameter1]": {
            "template": "set protocols ptp interface [parameter1]",
            "command": "set protocols ptp interface lo0",
            "explanation": "配置PTP协议使用的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "PTP协议使用的接口名称。"
                }
            ]
        },
        "set protocols ptp client": {
            "template": "set protocols ptp client",
            "command": "set protocols ptp client",
            "explanation": "配置设备作为PTP客户端。",
            "parameters": []
        },
        "set protocols ptp local-address [parameter1]": {
            "template": "set protocols ptp local-address [parameter1]",
            "command": "set protocols ptp local-address 3.3.3.3",
            "explanation": "配置PTP协议的本地地址。",
            "parameters": [
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "PTP协议的本地IPv4地址。"
                }
            ]
        },
        "set protocols ptp peer [parameter1]": {
            "template": "set protocols ptp peer [parameter1]",
            "command": "set protocols ptp peer 1.1.1.1",
            "explanation": "配置PTP协议的对等体地址。",
            "parameters": [
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "PTP协议的对等体IPv4地址。"
                }
            ]
        },
        "set protocols ptp sync-interval [parameter1]": {
            "template": "set protocols ptp sync-interval [parameter1]",
            "command": "set protocols ptp sync-interval 4",
            "explanation": "配置PTP协议的同步消息发送间隔。",
            "parameters": [
                {
                    "name": "sync-interval",
                    "type": "integer",
                    "explanation": "PTP协议同步消息的发送间隔，单位为秒。"
                }
            ]
        },
        "set protocols ptp announce-interval [parameter1]": {
            "template": "set protocols ptp announce-interval [parameter1]",
            "command": "set protocols ptp announce-interval 12",
            "explanation": "配置PTP协议的公告消息发送间隔。",
            "parameters": [
                {
                    "name": "announce-interval",
                    "type": "integer",
                    "explanation": "PTP协议公告消息的发送间隔，单位为秒。"
                }
            ]
        },
        "set protocols ptp delay-response-interval [parameter1]": {
            "template": "set protocols ptp delay-response-interval [parameter1]",
            "command": "set protocols ptp delay-response-interval 6",
            "explanation": "配置PTP协议的延迟响应消息发送间隔。",
            "parameters": [
                {
                    "name": "delay-response-interval",
                    "type": "integer",
                    "explanation": "PTP协议延迟响应消息的发送间隔，单位为秒。"
                }
            ]
        },
        "set protocols ptp unicast-negotiate": {
            "template": "set protocols ptp unicast-negotiate",
            "command": "set protocols ptp unicast-negotiate",
            "explanation": "启用PTP协议的单播协商功能。",
            "parameters": []
        }
    }
}