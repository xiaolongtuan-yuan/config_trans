{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6",
            "explanation": "配置接口支持IPv6协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf3 area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
            "command": "set protocols ospf3 area 0.0.0.0 interface ge-0/0/0.0",
            "explanation": "配置OSPFv3区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPFv3区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "参与OSPFv3的接口名称。"
                }
            ]
        },
        "set protocols ospf3 router-id [parameter1]": {
            "template": "set protocols ospf3 router-id [parameter1]",
            "command": "set protocols ospf3 router-id 1.1.1.1",
            "explanation": "配置OSPFv3的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPFv3路由器的唯一标识。"
                }
            ]
        },
        "set protocols bfd ipv6 session [parameter1] local-address [parameter2] discriminator local [parameter3]": {
            "template": "set protocols bfd ipv6 session [parameter1] local-address [parameter2] discriminator local [parameter3]",
            "command": "set protocols bfd ipv6 session 2001:db8:2::2 local-address 2001:db8:1::1 discriminator local 1",
            "explanation": "配置BFD IPv6会话的本地标识符。",
            "parameters": [
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BFD会话的对端IPv6地址。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BFD会话的本地IPv6地址。"
                },
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "BFD会话的本地标识符。"
                }
            ]
        },
        "set protocols bfd ipv6 session [parameter1] local-address [parameter2] discriminator remote [parameter3]": {
            "template": "set protocols bfd ipv6 session [parameter1] local-address [parameter2] discriminator remote [parameter3]",
            "command": "set protocols bfd ipv6 session 2001:db8:2::2 local-address 2001:db8:1::1 discriminator remote 2",
            "explanation": "配置BFD IPv6会话的远端标识符。",
            "parameters": [
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BFD会话的对端IPv6地址。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BFD会话的本地IPv6地址。"
                },
                {
                    "name": "remote-discriminator",
                    "type": "integer",
                    "explanation": "BFD会话的远端标识符。"
                }
            ]
        }
    }
}