{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls traffic-eng tunnels": {
            "template": "set protocols mpls traffic-eng tunnels",
            "command": "set protocols mpls traffic-eng tunnels",
            "explanation": "启用MPLS流量工程隧道功能。",
            "parameters": []
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options isis network [parameter1]": {
            "template": "set routing-options isis network [parameter1]",
            "command": "set routing-options isis network point-to-point",
            "explanation": "配置IS-IS网络类型为点对点。",
            "parameters": [
                {
                    "name": "network-type",
                    "type": "string",
                    "explanation": "IS-IS网络类型，point-to-point表示点对点网络。"
                }
            ]
        },
        "set routing-options isis metric-style [parameter1]": {
            "template": "set routing-options isis metric-style [parameter1]",
            "command": "set routing-options isis metric-style wide",
            "explanation": "配置IS-IS使用宽度量风格。",
            "parameters": [
                {
                    "name": "metric-style",
                    "type": "string",
                    "explanation": "IS-IS度量风格，wide表示宽度量风格。"
                }
            ]
        },
        "set routing-options isis mpls traffic-eng [parameter1]": {
            "template": "set routing-options isis mpls traffic-eng [parameter1]",
            "command": "set routing-options isis mpls traffic-eng level-2-only",
            "explanation": "配置IS-IS MPLS流量工程仅在Level-2级别启用。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS级别，level-2-only表示仅在Level-2级别启用。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 4.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}