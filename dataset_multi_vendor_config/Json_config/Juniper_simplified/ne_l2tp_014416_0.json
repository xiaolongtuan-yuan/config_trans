{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system radius-server [parameter1] secret [parameter2]": {
            "template": "set system radius-server [parameter1] secret [parameter2]",
            "command": "set system radius-server 10.20.20.1 secret \"073C2D2A0D5E1C0D0B\"",
            "explanation": "配置RADIUS服务器的共享密钥。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与RADIUS服务器通信的共享密钥。"
                }
            ]
        },
        "set system radius-server [parameter1] authentication-port [parameter2]": {
            "template": "set system radius-server [parameter1] authentication-port [parameter2]",
            "command": "set system radius-server 10.20.20.1 authentication-port 1812",
            "explanation": "配置RADIUS服务器的认证端口。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的认证端口号。"
                }
            ]
        },
        "set system radius-server [parameter1] accounting-port [parameter2]": {
            "template": "set system radius-server [parameter1] accounting-port [parameter2]",
            "command": "set system radius-server 10.20.20.1 accounting-port 1813",
            "explanation": "配置RADIUS服务器的计费端口。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
            "explanation": "配置系统的认证顺序为RADIUS。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如radius。"
                }
            ]
        },
        "set system login user [parameter1] authentication plain-text-password [parameter2]": {
            "template": "set system login user [parameter1] authentication plain-text-password [parameter2]",
            "command": "set system login user vpdnuser authentication plain-text-password \"072A5C090A504B5D5F131D0F0C\"",
            "explanation": "配置用户的认证密码。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "用户的认证密码。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet",
            "command": "set interfaces st0 unit 1 family inet",
            "explanation": "配置接口的IPv4协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如st0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ppp chap": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp chap",
            "command": "set interfaces st0 unit 1 ppp chap",
            "explanation": "配置接口的PPP CHAP认证。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如st0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.38.160.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-options pppoe-server": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-options pppoe-server",
            "command": "set interfaces ge-0/0/0 unit 0 pppoe-options pppoe-server",
            "explanation": "配置接口的PPPoE服务器选项。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 encapsulation ethernet-bridged",
            "explanation": "配置接口的封装类型为以太网桥接。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如ethernet-bridged。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 vlan-id 100",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-options service-name [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-options service-name [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 pppoe-options service-name Virtual-Template1",
            "explanation": "配置PPPoE服务名称。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "service-name",
                    "type": "string",
                    "explanation": "PPPoE服务名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] pppoe-server authentication [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] pppoe-server authentication [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 pppoe-server authentication chap",
            "explanation": "配置PPPoE服务器的认证方式为CHAP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如chap。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] bridge-group [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] bridge-group [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 bridge-group 1",
            "explanation": "配置接口的桥接组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "bridge-group",
                    "type": "integer",
                    "explanation": "桥接组编号。"
                }
            ]
        }
    },
    "set services": {
        "template": "set services",
        "set services l2tp remote-access tunnel password [parameter1]": {
            "template": "set services l2tp remote-access tunnel password [parameter1]",
            "command": "set services l2tp remote-access tunnel password \"072A5C090A504B5D5F131D0F0C\"",
            "explanation": "配置L2TP远程访问隧道的密码。",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "L2TP隧道的密码。"
                }
            ]
        },
        "set services l2tp remote-access authentication [parameter1]": {
            "template": "set services l2tp remote-access authentication [parameter1]",
            "command": "set services l2tp remote-access authentication chap",
            "explanation": "配置L2TP远程访问的认证方式为CHAP。",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "认证方法，例如chap。"
                }
            ]
        },
        "set services l2tp remote-access client pool low [parameter1] high [parameter2]": {
            "template": "set services l2tp remote-access client pool low [parameter1] high [parameter2]",
            "command": "set services l2tp remote-access client pool low 10.38.160.1 high 10.38.160.10",
            "explanation": "配置L2TP远程访问客户端的IP地址池范围。",
            "parameters": [
                {
                    "name": "low-ip",
                    "type": "string",
