                },
                {
                    "name": "high-ip",
                    "type": "string",
                    "explanation": "IP地址池的结束地址。"
                }
            ]
        },
        "set services l2tp remote-access client bind-address [parameter1]": {
            "template": "set services l2tp remote-access client bind-address [parameter1]",
            "command": "set services l2tp remote-access client bind-address 10.38.160.1",
            "explanation": "配置L2TP远程访问客户端的绑定地址。",
            "parameters": [
                {
                    "name": "bind-address",
                    "type": "string",
                    "explanation": "客户端的绑定IP地址。"
                }
            ]
