{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 2 wide-metrics-only",
            "explanation": "配置ISIS协议的级别2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                }
            ]
        },
        "set protocols isis level [parameter1]-only": {
            "template": "set protocols isis level [parameter1]-only",
            "command": "set protocols isis level 2-only",
            "explanation": "配置ISIS协议仅使用级别2。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                }
            ]
        },
        "set protocols isis interface [parameter1] point-to-point": {
            "template": "set protocols isis interface [parameter1] point-to-point",
            "command": "set protocols isis interface ge-1/0/0 point-to-point",
            "explanation": "配置ISIS协议在指定接口上使用点对点模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols isis address-family [parameter1] unicast enable": {
            "template": "set protocols isis address-family [parameter1] unicast enable",
            "command": "set protocols isis address-family ipv6 unicast enable",
            "explanation": "启用ISIS协议的IPv6单播地址族。",
            "parameters": [
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如ipv6。"
                }
            ]
        },
        "set protocols isis address-family [parameter1] unicast set interface [parameter2]": {
            "template": "set protocols isis address-family [parameter1] unicast set interface [parameter2]",
            "command": "set protocols isis address-family ipv6 unicast set interface ge-1/0/0",
            "explanation": "配置ISIS协议的IPv6单播地址族在指定接口上。",
            "parameters": [
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如ipv6。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols isis level [parameter1] address [parameter2]": {
            "template": "set protocols isis level [parameter1] address [parameter2]",
            "command": "set protocols isis level 2 address 49.0000.0000.0003.00",
            "explanation": "配置ISIS协议的级别2地址。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS协议的级别，例如2。"
                },
                {
                    "name": "address",
                    "type": "string",
                    "explanation": "ISIS协议的地址。"
                }
            ]
        },
        "set protocols ospf3 area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
            "command": "set protocols ospf3 area 0.0.0.2 interface ge-2/0/0",
            "explanation": "配置OSPFv3协议的区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPFv3协议的区域，例如0.0.0.2。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                }
            ]
        },
        "set protocols ospf3 router-id [parameter1]": {
            "template": "set protocols ospf3 router-id [parameter1]",
            "command": "set protocols ospf3 router-id 1.1.1.1",
            "explanation": "配置OSPFv3协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPFv3协议的路由器ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:20::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4] preferred": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4] preferred",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:20::1/64 preferred",
            "explanation": "配置接口的IPv6地址及前缀长度，并标记为优先。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    }
}