{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] wide-metrics-only": {
            "template": "set protocols isis level [parameter1] wide-metrics-only",
            "command": "set protocols isis level 2 wide-metrics-only",
            "explanation": "配置IS-IS协议的级别2仅使用宽度量。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1，2表示级别2。"
                }
            ]
        },
        "set protocols isis network-entity [parameter1]": {
            "template": "set protocols isis network-entity [parameter1]",
            "command": "set protocols isis network-entity 10.0000.0000.0004.00",
            "explanation": "配置IS-IS协议的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "network-entity",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识IS-IS网络中的设备。"
                }
            ]
        },
        "set protocols isis ipv6-unicast": {
            "template": "set protocols isis ipv6-unicast",
            "command": "set protocols isis ipv6-unicast",
            "explanation": "启用IS-IS协议的IPv6单播功能。",
            "parameters": []
        },
        "set protocols pim6 rp static address [parameter1]": {
            "template": "set protocols pim6 rp static address [parameter1]",
            "command": "set protocols pim6 rp static address 2001:db8:6::3",
            "explanation": "配置PIM6协议的静态RP地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "静态RP的IPv6地址。"
                }
            ]
        },
        "set protocols pim6 interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim6 interface [parameter1] mode [parameter2]",
            "command": "set protocols pim6 interface ge-1/0/0 mode sparse",
            "explanation": "配置PIM6协议的接口模式为稀疏模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM6协议的接口模式，例如稀疏模式（sparse）。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface ge-1/0/0",
            "explanation": "在指定接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:5::6/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    }
}