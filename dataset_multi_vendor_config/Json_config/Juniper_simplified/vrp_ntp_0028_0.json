{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system ntp source-address [parameter1]": {
            "template": "set system ntp source-address [parameter1]",
            "command": "set system ntp source-address 10.0.1.31",
            "explanation": "配置NTP源地址。",
            "parameters": [
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "NTP报文的源IP地址。"
                }
            ]
        },
        "set system ntp server [parameter1]": {
            "template": "set system ntp server [parameter1]",
            "command": "set system ntp server 10.0.1.31",
            "explanation": "配置NTP服务器地址。",
            "parameters": [
                {
                    "name": "server",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                }
            ]
        },
        "set system ntp server [parameter1] preferred": {
            "template": "set system ntp server [parameter1] preferred",
            "command": "set system ntp server 10.0.1.31 preferred",
            "explanation": "配置首选NTP服务器地址。",
            "parameters": [
                {
                    "name": "server",
                    "type": "string",
                    "explanation": "NTP服务器的IP地址。"
                },
                {
                    "name": "preferred",
                    "type": "keyword",
                    "explanation": "标记此服务器为首选。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.0.1.31/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] enable": {
            "template": "set interfaces [parameter1] enable",
            "command": "set interfaces ge-0/0/0 enable",
            "explanation": "启用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    }
}