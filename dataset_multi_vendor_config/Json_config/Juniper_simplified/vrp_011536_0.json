{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan-2 vlan-id 2",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set ethernet-switching-options": {
        "template": "set ethernet-switching-options",
        "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] interface [parameter5] direction [parameter6]": {
            "template": "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] interface [parameter5] direction [parameter6]",
            "command": "set ethernet-switching-options cfm mep-database md md1 ma ma2 vlan-id 2 mep-id 3 interface ge-1/0/1 direction outward",
            "explanation": "配置CFM MEP数据库，指定MD、MA、VLAN ID、MEP ID、接口和方向。",
            "parameters": [
                {
                    "name": "md",
                    "type": "string",
                    "explanation": "维护域名称。"
                },
                {
                    "name": "ma",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "MEP的方向，outward或inward。"
                }
            ]
        },
        "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] ccm-enable": {
            "template": "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] ccm-enable",
            "command": "set ethernet-switching-options cfm mep-database md md1 ma ma2 vlan-id 2 mep-id 3 ccm-enable",
            "explanation": "启用CFM MEP的CCM功能。",
            "parameters": [
                {
                    "name": "md",
                    "type": "string",
                    "explanation": "维护域名称。"
                },
                {
                    "name": "ma",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                }
            ]
        },
        "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] remote-mep [parameter5]": {
            "template": "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] remote-mep [parameter5]",
            "command": "set ethernet-switching-options cfm mep-database md md1 ma ma2 vlan-id 2 mep-id 3 remote-mep 4",
            "explanation": "配置CFM MEP的远程MEP。",
            "parameters": [
                {
                    "name": "md",
                    "type": "string",
                    "explanation": "维护域名称。"
                },
                {
                    "name": "ma",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程MEP的ID号。"
                }
            ]
        },
        "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] loss-measurement single-ended receive test-id [parameter5]": {
            "template": "set ethernet-switching-options cfm mep-database md [parameter1] ma [parameter2] vlan-id [parameter3] mep-id [parameter4] loss-measurement single-ended receive test-id [parameter5]",
            "command": "set ethernet-switching-options cfm mep-database md md1 ma ma2 vlan-id 2 mep-id 3 loss-measurement single-ended receive test-id 2",
            "explanation": "配置CFM MEP的单端接收丢失测量。",
            "parameters": [
                {
                    "name": "md",
                    "type": "string",
                    "explanation": "维护域名称。"
                },
                {
                    "name": "ma",
                    "type": "string",
                    "explanation": "维护关联名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP的ID号。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan-2",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN成员名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-1/0/1 unit 0 disable",
            "explanation": "禁用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        }
    }
}