{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-mode [parameter1]": {
            "template": "set protocols mpls label-mode [parameter1]",
            "command": "set protocols mpls label-mode ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-mode",
                    "type": "string",
                    "explanation": "MPLS标签分发模式，例如ldp。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching",
            "explanation": "配置接口的以太网交换功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] family inet enable-mpls": {
            "template": "set interfaces [parameter1] family inet enable-mpls",
            "command": "set interfaces ge-0/0/0 family inet enable-mpls",
            "explanation": "在接口上启用MPLS功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router ospf [parameter1]": {
            "template": "set routing-options router ospf [parameter1]",
            "command": "set routing-options router ospf 1",
            "explanation": "配置OSPF路由协议实例。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例编号。"
                }
            ]
        },
        "set routing-options router ospf [parameter1] network [parameter2] area [parameter3]": {
            "template": "set routing-options router ospf [parameter1] network [parameter2] area [parameter3]",
            "command": "set routing-options router ospf 1 network 2.2.2.9.0.0.0.0 area 0",
            "explanation": "配置OSPF网络及所属区域。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例编号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "OSPF网络地址及掩码。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域编号。"
                }
            ]
        }
    }
}