{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols l2vpn [parameter1] routing-distinguisher auto": {
            "template": "set protocols l2vpn [parameter1] routing-distinguisher auto",
            "command": "set protocols l2vpn vnp1 routing-distinguisher auto",
            "explanation": "为L2VPN实例配置自动生成的路由区分符。",
            "parameters": [
                {
                    "name": "vpn-instance",
                    "type": "string",
                    "explanation": "L2VPN实例名称。"
                }
            ]
        },
        "set protocols l2vpn [parameter1] target [parameter2]": {
            "template": "set protocols l2vpn [parameter1] target [parameter2]",
            "command": "set protocols l2vpn vnp1 target 100:1",
            "explanation": "为L2VPN实例配置目标社区。",
            "parameters": [
                {
                    "name": "vpn-instance",
                    "type": "string",
                    "explanation": "L2VPN实例名称。"
                },
                {
                    "name": "target-community",
                    "type": "string",
                    "explanation": "目标社区值。"
                }
            ]
        },
        "set protocols bgp [parameter1]": {
            "template": "set protocols bgp [parameter1]",
            "command": "set protocols bgp 100",
            "explanation": "配置BGP实例。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] peer [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp [parameter1] peer [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp 100 peer 3.3.3.9 remote-as 100",
            "explanation": "配置BGP对等体及其远程自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "对等体的远程自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] peer [parameter2] update-source [parameter3]": {
            "template": "set protocols bgp [parameter1] peer [parameter2] update-source [parameter3]",
            "command": "set protocols bgp 100 peer 3.3.3.9 update-source lo0",
            "explanation": "配置BGP对等体的更新源接口。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口名称。"
                }
            ]
        },
        "set protocols bgp [parameter1] family inet": {
            "template": "set protocols bgp [parameter1] family inet",
            "command": "set protocols bgp 100 family inet",
            "explanation": "在BGP实例中启用IPv4地址族。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] family inet peer [parameter2] activate": {
            "template": "set protocols bgp [parameter1] family inet peer [parameter2] activate",
            "command": "set protocols bgp 100 family inet peer 3.3.3.9 activate",
            "explanation": "激活BGP对等体的IPv4地址族。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] family l2vpn-vpls": {
            "template": "set protocols bgp [parameter1] family l2vpn-vpls",
            "command": "set protocols bgp 100 family l2vpn-vpls",
            "explanation": "在BGP实例中启用L2VPN VPLS地址族。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                }
            ]
        },
        "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] activate": {
            "template": "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] activate",
            "command": "set protocols bgp 100 family l2vpn-vpls peer 3.3.3.9 activate",
            "explanation": "激活BGP对等体的L2VPN VPLS地址族。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] send-community": {
            "template": "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] send-community",
            "command": "set protocols bgp 100 family l2vpn-vpls peer 3.3.3.9 send-community",
            "explanation": "配置BGP对等体发送社区属性。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                }
            ]
        },
        "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] transport": {
            "template": "set protocols bgp [parameter1] family l2vpn-vpls peer [parameter2] transport",
            "command": "set protocols bgp 100 family l2vpn-vpls peer 3.3.3.9 transport",
            "explanation": "配置BGP对等体的传输设置。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "BGP对等体的IP地址。"
                }
            ]
        },
        "set protocols ospf [parameter1] area [parameter2] network [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] network [parameter3]",
            "command": "set protocols ospf 1 area 0 network 1.1.1.9/32",
            "explanation": "在OSPF区域中配置网络。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls ldp enable": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls ldp enable",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls ldp enable",
            "explanation": "在接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vcn1 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set vlans [parameter1] l2-vpn encapsulation mpls": {
            "template": "set vlans [parameter1] l2-vpn encapsulation mpls",
            "command": "set vlans vcn1 l2-vpn encapsulation mpls",
            "explanation": "配置VLAN的L2VPN封装类型为MPLS。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称。"
                }
            ]
        }
    }
}