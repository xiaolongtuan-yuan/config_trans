{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols rstp vlan-group [parameter1] vlan [parameter2]": {
            "template": "set protocols rstp vlan-group [parameter1] vlan [parameter2]",
            "command": "set protocols rstp vlan-group vlan10-100 vlan [10 100]",
            "explanation": "配置RSTP协议的VLAN组。",
            "parameters": [
                {
                    "name": "vlan-group-name",
                    "type": "string",
                    "explanation": "VLAN组的名称。"
                },
                {
                    "name": "vlan-ids",
                    "type": "list",
                    "explanation": "VLAN ID列表。"
                }
            ]
        },
        "set protocols erps ring [parameter1] control-vlan [parameter2]": {
            "template": "set protocols erps ring [parameter1] control-vlan [parameter2]",
            "command": "set protocols erps ring 1 control-vlan 100",
            "explanation": "配置ERPS环的控制VLAN。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                },
                {
                    "name": "control-vlan",
                    "type": "integer",
                    "explanation": "控制VLAN的ID。"
                }
            ]
        },
        "set protocols erps ring [parameter1] protected-instance [parameter2]": {
            "template": "set protocols erps ring [parameter1] protected-instance [parameter2]",
            "command": "set protocols erps ring 1 protected-instance 0",
            "explanation": "配置ERPS环的保护实例。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                },
                {
                    "name": "protected-instance",
                    "type": "integer",
                    "explanation": "保护实例的ID。"
                }
            ]
        },
        "set protocols erps ring [parameter1] version [parameter2]": {
            "template": "set protocols erps ring [parameter1] version [parameter2]",
            "command": "set protocols erps ring 1 version 2",
            "explanation": "配置ERPS环的版本。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "ERPS协议的版本。"
                }
            ]
        },
        "set protocols erps ring [parameter1] sub-ring": {
            "template": "set protocols erps ring [parameter1] sub-ring",
            "command": "set protocols erps ring 1 sub-ring",
            "explanation": "配置ERPS环为子环。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                }
            ]
        },
        "set protocols rstp interface [parameter1] bpdu-filter": {
            "template": "set protocols rstp interface [parameter1] bpdu-filter",
            "command": "set protocols rstp interface ge-1/0/0 bpdu-filter",
            "explanation": "在接口上启用RSTP BPDU过滤。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols erps ring [parameter1] interface [parameter2]": {
            "template": "set protocols erps ring [parameter1] interface [parameter2]",
            "command": "set protocols erps ring 1 interface ge-1/0/0",
            "explanation": "将接口加入到ERPS环中。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols erps ring [parameter1] interface [parameter2] rpl-owner": {
            "template": "set protocols erps ring [parameter1] interface [parameter2] rpl-owner",
            "command": "set protocols erps ring 1 interface ge-2/0/0 rpl-owner",
            "explanation": "配置接口为ERPS环的RPL所有者。",
            "parameters": [
                {
                    "name": "ring-id",
                    "type": "integer",
                    "explanation": "ERPS环的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching vlan members [10 100]",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "list",
                    "explanation": "VLAN成员列表。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口的端口模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如trunk或access。"
                }
            ]
        },
        "set interfaces [parameter1] disable [parameter2]": {
            "template": "set interfaces [parameter1] disable [parameter2]",
            "command": "set interfaces ge-1/0/0 disable false",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "是否禁用接口。"
                }
            ]
        }
    }
}