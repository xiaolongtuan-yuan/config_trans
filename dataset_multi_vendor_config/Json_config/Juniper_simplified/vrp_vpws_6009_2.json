{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name mpls-lab-proto-ldp-mpls-ip",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/1/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/1/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances ospf-1 instance-type ospf",
            "explanation": "配置路由实例的类型为OSPF。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如OSPF。"
                }
            ]
        },
        "set routing-instances [parameter1] routing-options router-id [parameter2]": {
            "template": "set routing-instances [parameter1] routing-options router-id [parameter2]",
            "command": "set routing-instances ospf-1 routing-options router-id 192.168.4.4",
            "explanation": "配置OSPF路由实例的Router ID。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由实例的Router ID。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-table-target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-table-target [parameter2]",
            "command": "set routing-instances ospf-1 vrf-table-target target:0.0.0.0:0",
            "explanation": "配置路由实例的VRF表目标。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-table-target",
                    "type": "string",
                    "explanation": "VRF表目标，用于指定路由实例的VRF表。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols ospf area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-instances [parameter1] protocols ospf area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-instances ospf-1 protocols ospf area 0 network 192.168.4.4/32",
            "explanation": "配置OSPF区域内的网络。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域的编号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "OSPF区域内的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "网络地址的子网掩码位数。"
                }
            ]
        }
    }
}