{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set interfaces [parameter1] family inet6 address [parameter2]/[parameter3]": {
            "template": "set interfaces [parameter1] family inet6 address [parameter2]/[parameter3]",
            "command": "set interfaces ge-1/0/0 family inet6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]": {
            "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
            "command": "set routing-options rib inet6.0 static route ::/0 next-hop <next-hop-address>",
            "explanation": "配置IPv6静态路由，指定下一跳地址。",
            "parameters": [
                {
                    "name": "rib",
                    "type": "string",
                    "explanation": "路由信息库名称，例如inet6.0。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址，例如::/0表示默认路由。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group external local-address 2001:db8:1::1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family [parameter2] [parameter3]": {
            "template": "set protocols bgp group [parameter1] family [parameter2] [parameter3]",
            "command": "set protocols bgp group external family inet6 unicast",
            "explanation": "配置BGP组支持IPv6单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet6。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "指定为单播地址族。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group external neighbor 2001:db8:1::2 peer-as 200",
            "explanation": "配置BGP邻居及其对等AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]",
            "command": "set protocols bgp group external neighbor 2001:db8:1::2 family inet6 unicast",
            "explanation": "配置BGP邻居支持IPv6单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的地址。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet6。"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "指定为单播地址族。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group external export redistribute-connected",
            "explanation": "配置BGP组导出重分发直连路由的策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        },
        "set protocols bgp local-as [parameter1]": {
            "template": "set protocols bgp local-as [parameter1]",
            "command": "set protocols bgp local-as 65410",
            "explanation": "配置BGP本地AS号。",
            "parameters": [
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "BGP本地AS号。"
                }
            ]
        },
        "set protocols bgp router-id [parameter1]": {
            "template": "set protocols bgp router-id [parameter1]",
            "command": "set protocols bgp router-id 10.10.10.10",
            "explanation": "配置BGP路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "BGP路由器的ID。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] from protocol [parameter2]": {
            "template": "set policy-options policy-statement [parameter1] from protocol [parameter2]",
            "command": "set policy-options policy-statement redistribute-connected from protocol direct",
            "explanation": "配置策略语句，指定从直连协议导入路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型，例如direct。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] then [parameter2]": {
            "template": "set policy-options policy-statement [parameter1] then [parameter2]",
            "command": "set policy-options policy-statement redistribute-connected then accept",
            "explanation": "配置策略语句，指定接受匹配的路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "执行的动作，例如accept。"
                }
            ]
        }
    }
}