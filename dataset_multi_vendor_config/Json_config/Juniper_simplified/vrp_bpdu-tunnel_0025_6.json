{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan100 vlan-id 100",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols layer2-control bpdu-block": {
            "template": "set protocols layer2-control bpdu-block",
            "command": "set protocols layer2-control bpdu-block",
            "explanation": "启用BPDU阻塞功能，防止BPDU帧通过。",
            "parameters": []
        },
        "set protocols rstp interface [parameter1] vlan [parameter2] root-priority [parameter3]": {
            "template": "set protocols rstp interface [parameter1] vlan [parameter2] root-priority [parameter3]",
            "command": "set protocols rstp interface ge-1/0/1 vlan 100 root-priority 0",
            "explanation": "配置RSTP协议的接口VLAN根优先级。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                },
                {
                    "name": "root-priority",
                    "type": "integer",
                    "explanation": "根桥优先级，值越小优先级越高。"
                }
            ]
        },
        "set protocols rstp interface [parameter1] disable": {
            "template": "set protocols rstp interface [parameter1] disable",
            "command": "set protocols rstp interface ge-1/0/1 disable",
            "explanation": "在指定接口上禁用RSTP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 100",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "integer",
                    "explanation": "VLAN成员ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如access或trunk。"
                }
            ]
        }
    }
}