{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security radius-server [parameter1] address [parameter2]": {
            "template": "set security radius-server [parameter1] address [parameter2]",
            "command": "set security radius-server 10.6.55.55 address 10.6.55.55",
            "explanation": "配置RADIUS服务器的IP地址。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                }
            ]
        },
        "set security radius-server [parameter1] secret [parameter2]": {
            "template": "set security radius-server [parameter1] secret [parameter2]",
            "command": "set security radius-server 10.6.55.55 secret vS796FO7CpBCRqjgSCqRX6P-DYI",
            "explanation": "配置RADIUS服务器的共享密钥。",
            "parameters": [
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥，用于加密通信。"
                }
            ]
        },
        "set security radius-server [parameter1] authentication-port [parameter2]": {
            "template": "set security radius-server [parameter1] authentication-port [parameter2]",
            "command": "set security radius-server 10.6.55.55 authentication-port 1812",
            "explanation": "配置RADIUS服务器的认证端口。",
            "parameters": [
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的认证端口号。"
                }
            ]
        },
        "set security radius-server [parameter1] accounting-port [parameter2]": {
            "template": "set security radius-server [parameter1] accounting-port [parameter2]",
            "command": "set security radius-server 10.6.55.55 accounting-port 1813",
            "explanation": "配置RADIUS服务器的计费端口。",
            "parameters": [
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                }
            ]
        },
        "set security radius-server [parameter1] attributes attribute-32 include-in-access-request format [parameter2]": {
            "template": "set security radius-server [parameter1] attributes attribute-32 include-in-access-request format [parameter2]",
            "command": "set security radius-server 10.6.55.55 attributes attribute-32 include-in-access-request format \"%h\"",
            "explanation": "配置RADIUS服务器属性32的格式。",
            "parameters": [
                {
                    "name": "format",
                    "type": "string",
                    "explanation": "属性32的格式，用于在访问请求中包含特定信息。"
                }
            ]
        },
        "set security radius-server [parameter1] vsa accounting": {
            "template": "set security radius-server [parameter1] vsa accounting",
            "command": "set security radius-server 10.6.55.55 vsa accounting",
            "explanation": "启用RADIUS服务器的VSA计费功能。",
            "parameters": []
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ipv6 unicast-routing": {
            "template": "set protocols ipv6 unicast-routing",
            "command": "set protocols ipv6 unicast-routing",
            "explanation": "启用IPv6单播路由。",
            "parameters": []
        }
    },
    "set dhcp": {
        "template": "set dhcp",
        "set dhcp ipv6-pools [parameter1] dns-server [parameter2]": {
            "template": "set dhcp ipv6-pools [parameter1] dns-server [parameter2]",
            "command": "set dhcp ipv6-pools pool1 dns-server 2001:DB82::2:2",
            "explanation": "配置DHCPv6池的DNS服务器地址。",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "DHCPv6池的名称。"
                },
                {
                    "name": "dns-server",
                    "type": "string",
                    "explanation": "DNS服务器的IPv6地址。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]": {
            "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
            "command": "set routing-options rib inet6.0 static route ::/0 next-hop 2001:DB82::2:2",
            "explanation": "配置IPv6静态路由的下一跳地址。",
            "parameters": [
                {
                    "name": "rib",
                    "type": "string",
                    "explanation": "路由信息库的名称。"
                },
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "静态路由的目标地址。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "静态路由的下一跳地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 1 encapsulation vlan-bridge",
            "explanation": "配置接口的封装类型为VLAN桥接。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "接口的封装类型。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-0/0/1 unit 1 vlan-id 1",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 autoconf": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 autoconf",
            "command": "set interfaces ge-0/0/1 unit 1 family inet6 autoconf",
            "explanation": "启用接口的IPv6自动配置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/3 unit 0 family inet6 address 2001:DB82::2:1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    }
}