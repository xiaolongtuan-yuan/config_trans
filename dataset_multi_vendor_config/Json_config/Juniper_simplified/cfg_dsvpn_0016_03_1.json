{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Spoke1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.2.10/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] tunnel source [parameter2]": {
            "template": "set interfaces [parameter1] tunnel source [parameter2]",
            "command": "set interfaces ge-1/0/0 tunnel source ge-1/0/0",
            "explanation": "配置隧道源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道源接口名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel source [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel source ge-1/0/0",
            "explanation": "配置隧道源接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "隧道源接口名称。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] tunnel destination [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 tunnel destination 172.16.1.1",
            "explanation": "配置隧道目的地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "隧道接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination-address",
                    "type": "string",
                    "explanation": "隧道目的地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces gr-0/0/0 unit 0 encapsulation gre",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gr-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如gre。"
                }
            ]
        }
    },
    "set security": {
        "template": "set security",
        "set security ipsec vpn [parameter1] bind-interface [parameter2]": {
            "template": "set security ipsec vpn [parameter1] bind-interface [parameter2]",
            "command": "set security ipsec vpn IPSEC-VPN bind-interface gr-0/0/0",
            "explanation": "将IPSec VPN绑定到指定接口。",
            "parameters": [
                {
                    "name": "vpn-name",
                    "type": "string",
                    "explanation": "IPSec VPN名称。"
                },
                {
                    "name": "bind-interface",
                    "type": "string",
                    "explanation": "绑定接口名称。"
                }
            ]
        },
        "set security ipsec vpn [parameter1] ike ipsec-policy [parameter2]": {
            "template": "set security ipsec vpn [parameter1] ike ipsec-policy [parameter2]",
            "command": "set security ipsec vpn IPSEC-VPN ike ipsec-policy IPSEC-PROFILE",
            "explanation": "配置IPSec VPN的IKE策略。",
            "parameters": [
                {
                    "name": "vpn-name",
                    "type": "string",
                    "explanation": "IPSec VPN名称。"
                },
                {
                    "name": "ipsec-policy",
                    "type": "string",
                    "explanation": "IKE策略名称。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group BGP-TO-PEER type external",
            "explanation": "配置BGP组的类型。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group BGP-TO-PEER local-address 172.16.1.2",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group BGP-TO-PEER neighbor 172.16.1.1 peer-as 100",
            "explanation": "配置BGP邻居及其AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group BGP-TO-PEER family inet unicast",
            "explanation": "配置BGP组的地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group BGP-TO-PEER export [ EXPORT-OSPF-ROUTES ]",
            "explanation": "配置BGP组的导出策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/1",
            "explanation": "配置OSPF区域接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 192.168.1.0/24",
            "explanation": "配置OSPF区域网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement EXPORT-OSPF-ROUTES term 1 from protocol ospf",
            "explanation": "配置策略语句的匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的协议类型，例如ospf。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement EXPORT-OSPF-ROUTES term 1 then accept",
            "explanation": "配置策略语句的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "执行的动作，例如accept。"
                }
            ]
        }
    }
}