{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name client002",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services ssh protocol-version [parameter1]": {
            "template": "set system services ssh protocol-version [parameter1]",
            "command": "set system services ssh protocol-version v2",
            "explanation": "配置SSH服务使用的协议版本。",
            "parameters": [
                {
                    "name": "protocol-version",
                    "type": "string",
                    "explanation": "SSH协议版本，例如v2。"
                }
            ]
        },
        "set system login user [parameter1] authentication-tries [parameter2]": {
            "template": "set system login user [parameter1] authentication-tries [parameter2]",
            "command": "set system login user root authentication-tries 4",
            "explanation": "配置用户登录时的认证尝试次数。",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "用户名，例如root。"
                },
                {
                    "name": "authentication-tries",
                    "type": "integer",
                    "explanation": "允许的认证尝试次数。"
                }
            ]
        },
        "set system services ssh root-login [parameter1]": {
            "template": "set system services ssh root-login [parameter1]",
            "command": "set system services ssh root-login deny",
            "explanation": "配置是否允许root用户通过SSH登录。",
            "parameters": [
                {
                    "name": "root-login",
                    "type": "string",
                    "explanation": "是否允许root登录，例如deny。"
                }
            ]
        },
        "set system services ssh connection-limit [parameter1]": {
            "template": "set system services ssh connection-limit [parameter1]",
            "command": "set system services ssh connection-limit 4",
            "explanation": "配置SSH服务的最大连接数。",
            "parameters": [
                {
                    "name": "connection-limit",
                    "type": "integer",
                    "explanation": "SSH服务的最大连接数。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.3.3/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}