{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name NATA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 1.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 vlan-id 1",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] vlan-id [parameter2]": {
            "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
            "command": "set bridge-domains bd1 vlan-id 1",
            "explanation": "配置桥接域的VLAN ID。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域名称，例如bd1。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        }
    },
    "set security nat source": {
        "template": "set security nat source",
        "set security nat source rule-set [parameter1] from zone [parameter2]": {
            "template": "set security nat source rule-set [parameter1] from zone [parameter2]",
            "command": "set security nat source rule-set rs1 from zone trust",
            "explanation": "配置源NAT规则集的源区域。",
            "parameters": [
                {
                    "name": "rule-set",
                    "type": "string",
                    "explanation": "源NAT规则集名称，例如rs1。"
                },
                {
                    "name": "zone",
                    "type": "string",
                    "explanation": "源区域名称，例如trust。"
                }
            ]
        },
        "set security nat source rule-set [parameter1] to zone [parameter2]": {
            "template": "set security nat source rule-set [parameter1] to zone [parameter2]",
            "command": "set security nat source rule-set rs1 to zone untrust",
            "explanation": "配置源NAT规则集的目标区域。",
            "parameters": [
                {
                    "name": "rule-set",
                    "type": "string",
                    "explanation": "源NAT规则集名称，例如rs1。"
                },
                {
                    "name": "zone",
                    "type": "string",
                    "explanation": "目标区域名称，例如untrust。"
                }
            ]
        },
        "set security nat source rule-set [parameter1] rule [parameter2] match source-address [parameter3]/[parameter4]": {
            "template": "set security nat source rule-set [parameter1] rule [parameter2] match source-address [parameter3]/[parameter4]",
            "command": "set security nat source rule-set rs1 rule r1 match source-address 192.168.10.0/24",
            "explanation": "配置源NAT规则的源地址匹配条件。",
            "parameters": [
                {
                    "name": "rule-set",
                    "type": "string",
                    "explanation": "源NAT规则集名称，例如rs1。"
                },
                {
                    "name": "rule",
                    "type": "string",
                    "explanation": "源NAT规则名称，例如r1。"
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "源地址，例如192.168.10.0/24。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "源地址的子网掩码位数。"
                }
            ]
        },
        "set security nat source rule-set [parameter1] rule [parameter2] then source-nat [parameter3]": {
            "template": "set security nat source rule-set [parameter1] rule [parameter2] then source-nat [parameter3]",
            "command": "set security nat source rule-set rs1 rule r1 then source-nat interface",
            "explanation": "配置源NAT规则的源NAT动作。",
            "parameters": [
                {
                    "name": "rule-set",
                    "type": "string",
                    "explanation": "源NAT规则集名称，例如rs1。"
                },
                {
                    "name": "rule",
                    "type": "string",
                    "explanation": "源NAT规则名称，例如r1。"
                },
                {
                    "name": "source-nat",
                    "type": "string",
                    "explanation": "源NAT动作，例如interface。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1]": {
            "template": "set policy-options policy-statement [parameter1]",
            "command": "set policy-options policy-statement ps1",
            "explanation": "创建策略声明。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略声明名称，例如ps1。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] from source-address [parameter3]/[parameter4]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from source-address [parameter3]/[parameter4]",
            "command": "set policy-options policy-statement ps1 term 1 from source-address 192.168.10.0/24",
            "explanation": "配置策略声明的源地址匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略声明名称，例如ps1。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略声明的术语编号，例如1。"
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "源地址，例如192.168.10.0/24。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "源地址的子网掩码位数。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement ps1 term 1 then accept",
            "explanation": "配置策略声明的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略声明名称，例如ps1。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略声明的术语编号，例如1。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "动作，例如accept。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-3/0/0.0",
            "explanation": "配置OSPF区域的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域，例如0.0.0.0。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/0.0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 2.2.2.0/24",
            "explanation": "配置OSPF区域的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域，例如0.0.0.0。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址，例如2.2.2.0/24。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "网络地址的子网掩码位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 2.2.2.2",
            "explanation": "配置静态路由。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "目标网络地址，例如0.0.0.0/0。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "目标网络地址的子网掩码位数。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址，例如2.2.2.2。"
                }
            ]
        }
    }
}