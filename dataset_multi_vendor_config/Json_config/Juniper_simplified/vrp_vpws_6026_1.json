{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp": {
            "template": "set protocols ldp",
            "command": "set protocols ldp",
            "explanation": "启用LDP协议。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gigabit-ethernet0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation mpls connect-ce [parameter3] [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation mpls connect-ce [parameter3] [parameter4]",
            "command": "set interfaces gigabit-ethernet1/0/0 unit 0 encapsulation mpls connect-ce CE1-CE2 100",
            "explanation": "配置接口的MPLS封装，并连接到指定的CE设备。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ce-name",
                    "type": "string",
                    "explanation": "连接的CE设备名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        }
    }
}