{
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65000",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP等协议。"
                }
            ]
        },
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 10.0.0.1",
            "explanation": "配置设备的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "设备的Router ID，用于OSPF、BGP等协议。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis netpoint-point-to-point [parameter1]": {
            "template": "set protocols isis netpoint-point-to-point [parameter1]",
            "command": "set protocols isis netpoint-point-to-point default",
            "explanation": "配置IS-IS协议的点对点网络类型。",
            "parameters": [
                {
                    "name": "netpoint-point-to-point",
                    "type": "string",
                    "explanation": "IS-IS协议的点对点网络类型配置。"
                }
            ]
        },
        "set protocols isis cost-style [parameter1]": {
            "template": "set protocols isis cost-style [parameter1]",
            "command": "set protocols isis cost-style metric",
            "explanation": "配置IS-IS协议的成本风格。",
            "parameters": [
                {
                    "name": "cost-style",
                    "type": "string",
                    "explanation": "IS-IS协议的成本风格配置。"
                }
            ]
        },
        "set protocols isis metric [parameter1]": {
            "template": "set protocols isis metric [parameter1]",
            "command": "set protocols isis metric wide-metric",
            "explanation": "配置IS-IS协议的度量类型。",
            "parameters": [
                {
                    "name": "metric",
                    "type": "string",
                    "explanation": "IS-IS协议的度量类型配置。"
                }
            ]
        },
        "set protocols isis metric wide-metric-adjustment [parameter1]": {
            "template": "set protocols isis metric wide-metric-adjustment [parameter1]",
            "command": "set protocols isis metric wide-metric-adjustment none",
            "explanation": "配置IS-IS协议的宽度量调整。",
            "parameters": [
                {
                    "name": "wide-metric-adjustment",
                    "type": "string",
                    "explanation": "IS-IS协议的宽度量调整配置。"
                }
            ]
        },
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 192.168.1.1/32",
            "explanation": "配置OSPF协议的区域及网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF协议的区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "OSPF协议的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "OSPF协议的网络子网掩码位数。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-as [parameter2]",
            "command": "set protocols bgp group bgp-group local-as 65000",
            "explanation": "配置BGP协议的本地自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP协议的组名。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "BGP协议的本地自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer [parameter2] as [parameter3]": {
            "template": "set protocols bgp group [parameter1] peer [parameter2] as [parameter3]",
            "command": "set protocols bgp group bgp-group peer 192.168.2.2 as 65001",
            "explanation": "配置BGP协议的邻居及远程自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP协议的组名。"
                },
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "BGP协议的邻居地址。"
                },
                {
                    "name": "as",
                    "type": "integer",
                    "explanation": "BGP协议的远程自治系统号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] advertise-deployed-rt-only [parameter2]": {
            "template": "set protocols bgp group [parameter1] advertise-deployed-rt-only [parameter2]",
            "command": "set protocols bgp group bgp-group advertise-deployed-rt-only true",
            "explanation": "配置BGP协议仅广告已部署的路由。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP协议的组名。"
                },
                {
                    "name": "advertise-deployed-rt-only",
                    "type": "boolean",
                    "explanation": "是否仅广告已部署的路由。"
                }
            ]
        }
    },
    "set policies": {
        "template": "set policies",
        "set policies from [parameter1] to [parameter2] policy [parameter3] term [parameter4] then route-table [parameter5]": {
            "template": "set policies from [parameter1] to [parameter2] policy [parameter3] term [parameter4] then route-table [parameter5]",
            "command": "set policies from test to test policy test term term1 then route-table table1",
            "explanation": "配置策略的路由表。",
            "parameters": [
                {
                    "name": "from",
                    "type": "string",
                    "explanation": "策略的源区域。"
                },
                {
                    "name": "to",
                    "type": "string",
                    "explanation": "策略的目标区域。"
                },
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "策略名称。"
                },
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "策略的术语名称。"
                },
                {
                    "name": "route-table",
                    "type": "string",
                    "explanation": "路由表名称。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances test-vrf instance-type vrf",
            "explanation": "配置路由实例的类型。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型。"
                }
            ]
        },
        "set routing-instances [parameter1] vrrp-vrf": {
            "template": "set routing-instances [parameter1] vrrp-vrf",
            "command": "set routing-instances test-vrf vrrp-vrf",
            "explanation": "配置路由实例的VRRP VRF。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vrrp-vrf",
                    "type": "string",
                    "explanation": "VRRP VRF配置。"
                }
            ]
        }
    },
    "set chassis": {
        "template": "set chassis",
        "set chassis hardware-id [parameter1]": {
            "template": "set chassis hardware-id [parameter1]",
            "command": "set chassis hardware-id FDOE123456789",
            "explanation": "配置设备的硬件ID。",
            "parameters": [
                {
                    "name": "hardware-id",
                    "type": "string",
                    "explanation": "设备的硬件ID。"
                }
            ]
        }
    }
}