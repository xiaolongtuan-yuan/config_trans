{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:DB8::1:1/96",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 10.10.10.10",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        }
    },
    "set protocols bgp group EXTERNAL": {
        "template": "set protocols bgp group EXTERNAL",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group EXTERNAL type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group EXTERNAL peer-as 100",
            "explanation": "配置BGP组的对等AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group EXTERNAL local-address 2001:DB8::1:1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "本地地址，用于BGP会话。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group EXTERNAL neighbor 2001:DB8::1:2",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet6 unicast": {
            "template": "set protocols bgp group [parameter1] family inet6 unicast",
            "command": "set protocols bgp group EXTERNAL family inet6 unicast",
            "explanation": "配置BGP组支持IPv6单播地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] export [parameter2]": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group EXTERNAL export route-to-advertise",
            "explanation": "配置BGP组导出指定的路由策略。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出的路由策略名称。"
                }
            ]
        }
    },
    "set policy-options policy-statement route-to-advertise": {
        "template": "set policy-options policy-statement route-to-advertise",
        "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] exact": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] exact",
            "command": "set policy-options policy-statement route-to-advertise term 1 from route-filter 2001:DB8::11:1/128 exact",
            "explanation": "配置路由策略的匹配条件，精确匹配指定的IPv6地址。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "路由过滤器，用于匹配特定的路由。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "路由前缀的长度。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then accept": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then accept",
            "command": "set policy-options policy-statement route-to-advertise term 1 then accept",
            "explanation": "配置路由策略的动作，接受匹配的路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "路由策略的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略项的编号。"
                }
            ]
        }
    }
}