{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASBR2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] encapsulation dot1q [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation dot1q [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 1 encapsulation dot1q 10",
            "explanation": "配置接口的VLAN封装类型及VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] interface [parameter2]": {
            "template": "set vlans [parameter1] interface [parameter2]",
            "command": "set vlans v1 interface ge-0/0/0.1",
            "explanation": "将接口分配给指定的VLAN。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN名称，用于标识不同的VLAN。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.1。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface ge-0/0/0",
            "explanation": "配置LDP协议在指定接口上运行。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-address [parameter2] passive remote-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] peer-address [parameter2] passive remote-as [parameter3]",
            "command": "set protocols bgp group internal peer-address 4.4.4.4 passive remote-as 200",
            "explanation": "配置BGP对等体组，指定对等体地址、被动模式及远程AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP对等体组名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "对等体的远程AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-address [parameter2] advertisement-options route-flap-damping": {
            "template": "set protocols bgp group [parameter1] peer-address [parameter2] advertisement-options route-flap-damping",
            "command": "set protocols bgp group internal peer-address 4.4.4.4 advertisement-options route-flap-damping",
            "explanation": "配置BGP对等体组的广告选项，启用路由抖动抑制。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP对等体组名称。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set protocols ospf 1 area 0 interface ge-0/0/0.1",
            "explanation": "配置OSPF协议在指定区域和接口上运行。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.1。"
                }
            ]
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS协议并配置IP转发。",
            "parameters": []
        },
        "set protocols l2vpn vfi [parameter1]": {
            "template": "set protocols l2vpn vfi [parameter1]",
            "command": "set protocols l2vpn vfi v1",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                }
            ]
        },
        "set protocols l2vpn vfi [parameter1] forward-routes": {
            "template": "set protocols l2vpn vfi [parameter1] forward-routes",
            "command": "set protocols l2vpn vfi v1 forward-routes",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）转发路由。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                }
            ]
        },
        "set protocols l2vpn vfi [parameter1] vfi-name [parameter2]": {
            "template": "set protocols l2vpn vfi [parameter1] vfi-name [parameter2]",
            "command": "set protocols l2vpn vfi v1 vfi-name v1",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）的名称。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                }
            ]
        },
        "set protocols l2vpn vfi [parameter1] rd [parameter2]": {
            "template": "set protocols l2vpn vfi [parameter1] rd [parameter2]",
            "command": "set protocols l2vpn vfi v1 rd 200:1",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）的路由区分符（RD）。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                },
                {
                    "name": "rd",
                    "type": "string",
                    "explanation": "路由区分符，格式为ASN:NN。"
                }
            ]
        },
        "set protocols l2vpn vfi [parameter1] import-target [parameter2]": {
            "template": "set protocols l2vpn vfi [parameter1] import-target [parameter2]",
            "command": "set protocols l2vpn vfi v1 import-target 1:1",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）的导入目标。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                },
                {
                    "name": "import-target",
                    "type": "string",
                    "explanation": "导入目标，格式为ASN:NN。"
                }
            ]
        },
        "set protocols l2vpn vfi [parameter1] export-target [parameter2]": {
            "template": "set protocols l2vpn vfi [parameter1] export-target [parameter2]",
            "command": "set protocols l2vpn vfi v1 export-target 1:1",
            "explanation": "配置L2VPN的虚拟转发实例（VFI）的导出目标。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发实例的名称。"
                },
                {
                    "name": "export-target",
                    "type": "string",
                    "explanation": "导出目标，格式为ASN:NN。"
                }
            ]
        },
        "set protocols ldp discovery targeted-hello": {
            "template": "set protocols ldp discovery targeted-hello",
            "command": "set protocols ldp discovery targeted-hello",
            "explanation": "配置LDP协议的定向Hello发现机制。",
            "parameters": []
        },
        "set protocols mpls ldp auto-config": {
            "template": "set protocols mpls ldp auto-config",
            "command": "set protocols mpls ldp auto-config",
            "explanation": "启用MPLS LDP协议的自动配置。",
            "parameters": []
        }
    }
}