{
    "interface ge-0/0/0.1": {
        "template": "interface ge-0/0/0.1",
        "encapsulation vlan-_tagged [parameter1]": {
            "template": "encapsulation vlan-_tagged [parameter1]",
            "command": "encapsulation vlan-_tagged 10",
            "explanation": "配置接口的VLAN封装类型及VLAN ID。",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "ipv4 address [parameter1]/[parameter2]": {
            "template": "ipv4 address [parameter1]/[parameter2]",
            "command": "ipv4 address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}