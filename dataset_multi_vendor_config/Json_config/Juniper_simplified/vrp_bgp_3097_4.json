{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name RR",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/3 unit 0 family inet address 172.16.4.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols bgp group RR": {
        "template": "set protocols bgp group RR",
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group RR local-address 5.5.5.5",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group RR type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group RR neighbor 172.16.2.1 peer-as 65008",
            "explanation": "配置BGP邻居的AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group RR family inet unicast",
            "explanation": "配置BGP组的地址族为IPv4单播。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] disable synchronized": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] disable synchronized",
            "command": "set protocols bgp group RR neighbor 172.16.2.1 disable synchronized",
            "explanation": "禁用BGP邻居的同步。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] activate": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] activate",
            "command": "set protocols bgp group RR neighbor 172.16.2.1 activate",
            "explanation": "激活BGP邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols bgp group [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols bgp group RR network 172.16.2.0/24",
            "explanation": "配置BGP组宣告的网络。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "宣告的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "网络地址的子网掩码位数。"
                }
            ]
        },
        "set protocols bgp group [parameter1] maximum-paths [parameter2]": {
            "template": "set protocols bgp group [parameter1] maximum-paths [parameter2]",
            "command": "set protocols bgp group RR maximum-paths 2",
            "explanation": "配置BGP组的最大路径数。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "maximum-paths",
                    "type": "integer",
                    "explanation": "BGP组允许的最大路径数。"
                }
            ]
        }
    }
}