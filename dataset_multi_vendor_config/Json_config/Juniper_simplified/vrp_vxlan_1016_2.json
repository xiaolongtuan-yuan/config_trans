{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Device3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domain": {
        "template": "set bridge-domain",
        "set bridge-domain [parameter1] vxlan vni [parameter2]": {
            "template": "set bridge-domain [parameter1] vxlan vni [parameter2]",
            "command": "set bridge-domain 10 vxlan vni 5010",
            "explanation": "配置桥接域的VXLAN VNI。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域的编号。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符。"
                }
            ]
        },
        "set bridge-domain [parameter1] interface [parameter2]": {
            "template": "set bridge-domain [parameter1] interface [parameter2]",
            "command": "set bridge-domain 10 interface ge-1/0/2.1",
            "explanation": "将接口添加到桥接域。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gigabit-ethernet1/0/1 unit 0 family inet address 192.168.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet disable": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet disable",
            "command": "set interfaces gigabit-ethernet1/0/2 unit 0 family inet disable",
            "explanation": "禁用接口的IPv4协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching_vlan [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching_vlan [parameter3]",
            "command": "set interfaces gigabit-ethernet1/0/2.1 unit 0 family ethernet-switching_vlan 20",
            "explanation": "配置接口的以太网交换VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/2.1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN编号。"
                }
            ]
        },
        "set interfaces [parameter1] vlan- memberships [parameter2] [parameter3]": {
            "template": "set interfaces [parameter1] vlan- memberships [parameter2] [parameter3]",
            "command": "set interfaces gigabit-ethernet1/0/2.1 vlan- memberships 20 dynamic",
            "explanation": "配置接口的VLAN成员资格为动态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/2.1。"
                },
                {
                    "name": "vlan",
                    "type": "integer",
                    "explanation": "VLAN编号。"
                },
                {
                    "name": "membership-type",
                    "type": "string",
                    "explanation": "成员资格类型，例如dynamic。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options.source-route-forwarding source-interface [parameter1]": {
            "template": "set forwarding-options.source-route-forwarding source-interface [parameter1]",
            "command": "set forwarding-options.source-route-forwarding source-interface lo0",
            "explanation": "配置源路由转发的源接口。",
            "parameters": [
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "源接口名称，例如lo0。"
                }
            ]
        }
    },
    "set virtual-switch": {
        "template": "set virtual-switch",
        "set virtual-switch [parameter1] headend-peer-list [parameter2] vni [parameter3]": {
            "template": "set virtual-switch [parameter1] headend-peer-list [parameter2] vni [parameter3]",
            "command": "set virtual-switch vxlan1 headend-peer-list 2.2.2.2 vni 5010",
            "explanation": "配置虚拟交换机的VXLAN头端对等列表。",
            "parameters": [
                {
                    "name": "virtual-switch",
                    "type": "string",
                    "explanation": "虚拟交换机名称，例如vxlan1。"
                },
                {
                    "name": "headend-peer",
                    "type": "string",
                    "explanation": "头端对等的IP地址。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN网络标识符。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0.0.0.0 network 4.4.4.4/32",
            "explanation": "配置OSPF区域的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    }
}