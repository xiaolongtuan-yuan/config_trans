{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2] network [parameter3]/[parameter4]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] network [parameter3]/[parameter4]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-0/0/0.0 network 192.168.0.0/24",
            "explanation": "配置OSPF区域及接口的网络地址。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称及单元号，例如ge-0/0/0.0。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        },
        "set protocols ospf router-id [parameter1]": {
            "template": "set protocols ospf router-id [parameter1]",
            "command": "set protocols ospf router-id 1.1.1.1",
            "explanation": "配置OSPF路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "OSPF路由器的ID。"
                }
            ]
        },
        "set protocols ospf reference-bandwidth [parameter1]": {
            "template": "set protocols ospf reference-bandwidth [parameter1]",
            "command": "set protocols ospf reference-bandwidth 10000",
            "explanation": "配置OSPF的参考带宽。",
            "parameters": [
                {
                    "name": "reference-bandwidth",
                    "type": "integer",
                    "explanation": "OSPF的参考带宽，单位是Mbps。"
                }
            ]
        },
        "set protocols ospf ttl-security hops [parameter1]": {
            "template": "set protocols ospf ttl-security hops [parameter1]",
            "command": "set protocols ospf ttl-security hops 1",
            "explanation": "配置OSPF的TTL安全跳数。",
            "parameters": [
                {
                    "name": "hops",
                    "type": "integer",
                    "explanation": "TTL安全跳数，用于防止OSPF路由欺骗。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.0.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}