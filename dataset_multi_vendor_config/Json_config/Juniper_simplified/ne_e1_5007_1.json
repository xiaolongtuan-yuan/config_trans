            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation-type",
                    "type": "string",
                    "explanation": "封装类型，例如PPP。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mtu [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] mtu [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 0 mtu 1500",
            "explanation": "配置接口的MTU大小。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "mtu-size",
                    "type": "integer",
                    "explanation": "MTU大小，单位为字节。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ppp multilink": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp multilink",
            "command": "set interfaces ge-0/0/2 unit 0 ppp multilink",
            "explanation": "启用接口的PPP多链路功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] ppp multilink group [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp multilink group [parameter3]",
            "command": "set interfaces ge-0/0/2 unit 0 ppp multilink group 1",
            "explanation": "配置接口的PPP多链路组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "group-id",
                    "type": "integer",
                    "explanation": "PPP多链路组ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/2 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-0/0/2 disable",
