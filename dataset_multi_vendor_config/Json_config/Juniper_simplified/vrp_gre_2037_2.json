{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceC",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans vlan10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces vlan unit 10 family inet address 172.16.1.2/24",
            "explanation": "配置VLAN接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如vlan。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching vlan members vlan10",
            "explanation": "配置接口的以太网交换模式，并将其加入指定VLAN。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称，接口将加入此VLAN。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] network [parameter2]/[parameter3]": {
            "template": "set protocols ospf area [parameter1] network [parameter2]/[parameter3]",
            "command": "set protocols ospf area 0 network 172.16.1.0/24",
            "explanation": "配置OSPF协议，指定区域和网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    }
}