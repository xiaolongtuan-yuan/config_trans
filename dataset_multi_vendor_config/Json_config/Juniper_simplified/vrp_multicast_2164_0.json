{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ipv6": {
            "template": "set protocols ipv6",
            "command": "set protocols ipv6",
            "explanation": "启用IPv6协议。",
            "parameters": []
        },
        "set protocols ospf3 area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
            "command": "set protocols ospf3 area 0.0.0.0 interface ge-1/0/0",
            "explanation": "配置OSPFv3区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPFv3区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols pim interface [parameter1] mode [parameter2]": {
            "template": "set protocols pim interface [parameter1] mode [parameter2]",
            "command": "set protocols pim interface ge-1/0/0 mode sparse",
            "explanation": "配置PIM协议接口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM模式，例如sparse。"
                }
            ]
        },
        "set protocols pim rp local address [parameter1]": {
            "template": "set protocols pim rp local address [parameter1]",
            "command": "set protocols pim rp local address 2001:db8:7::7",
            "explanation": "配置PIM RP本地地址。",
            "parameters": [
                {
                    "name": "address",
                    "type": "string",
                    "explanation": "RP本地地址。"
                }
            ]
        },
        "set protocols pim rp-candidate [parameter1]": {
            "template": "set protocols pim rp-candidate [parameter1]",
            "command": "set protocols pim rp-candidate lo0",
            "explanation": "配置PIM RP候选接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "RP候选接口名称，例如lo0。"
                }
            ]
        },
        "set protocols pim bsr-candidate [parameter1]": {
            "template": "set protocols pim bsr-candidate [parameter1]",
            "command": "set protocols pim bsr-candidate lo0",
            "explanation": "配置PIM BSR候选接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "BSR候选接口名称，例如lo0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::2/64",
            "explanation": "配置接口的IPv6地址及子网前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6子网前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3] [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3] [parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet6 address FE80::2 preferred",
            "explanation": "配置接口的IPv6地址并标记为优先。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "preferred",
                    "type": "string",
                    "explanation": "标记该地址为优先。"
                }
            ]
        }
    }
}