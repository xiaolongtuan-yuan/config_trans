{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSR-E",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp enable": {
            "template": "set protocols ldp enable",
            "command": "set protocols ldp enable",
            "explanation": "启用LDP协议。",
            "parameters": []
        },
        "set protocols ldp route-id [parameter1]": {
            "template": "set protocols ldp route-id [parameter1]",
            "command": "set protocols ldp route-id 5.5.5.5",
            "explanation": "配置LDP的路由ID。",
            "parameters": [
                {
                    "name": "route-id",
                    "type": "string",
                    "explanation": "LDP协议使用的路由ID。"
                }
            ]
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level level-2-only",
            "explanation": "配置ISIS协议的级别为仅Level-2。",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS协议的级别，level-2-only表示仅Level-2。"
                }
            ]
        },
        "set protocols mpls traffic-eng bandwidth [parameter1] [parameter2]": {
            "template": "set protocols mpls traffic-eng bandwidth [parameter1] [parameter2]",
            "command": "set protocols mpls traffic-eng bandwidth 5000 5000",
            "explanation": "配置MPLS流量工程的带宽。",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "MPLS流量工程的带宽值，单位为kbps。"
                },
                {
                    "name": "reserved-bandwidth",
                    "type": "integer",
                    "explanation": "MPLS流量工程的预留带宽值，单位为kbps。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls traffic-eng tunnels": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls traffic-eng tunnels",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls traffic-eng tunnels",
            "explanation": "配置接口的MPLS流量工程隧道。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 10.4.1.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces lo0 unit 0 family mpls",
            "explanation": "配置环回接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    }
}