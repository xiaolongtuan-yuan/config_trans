{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name HUAWEI",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system services dhcpv6-pd client interface [parameter1] pool [parameter2]": {
            "template": "set system services dhcpv6-pd client interface [parameter1] pool [parameter2]",
            "command": "set system services dhcpv6-pd client interface ge-0/0/2 pool pre1",
            "explanation": "配置DHCPv6前缀委派客户端接口和池。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2。"
                },
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "DHCPv6池名称。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order [ radius local ]",
            "explanation": "配置系统认证顺序。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "list",
                    "explanation": "认证顺序列表，例如radius和local。"
                }
            ]
        },
        "set system login class [parameter1] authentication-order [parameter2]": {
            "template": "set system login class [parameter1] authentication-order [parameter2]",
            "command": "set system login class default authentication-order radius",
            "explanation": "配置默认登录类的认证顺序。",
            "parameters": [
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "登录类名称，例如default。"
                },
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        },
        "set system services radius-server [parameter1] port [parameter2] secret [parameter3] accounting-port [parameter4]": {
            "template": "set system services radius-server [parameter1] port [parameter2] secret [parameter3] accounting-port [parameter4]",
            "command": "set system services radius-server 10.6.55.55 port 1645 secret \"050A051F010F\" accounting-port 1646",
            "explanation": "配置RADIUS服务器。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的端口号。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                },
                {
                    "name": "accounting-port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                }
            ]
        },
        "set system local-dhcpv6-pool [parameter1] address-range low [parameter2] low [parameter3] prefix-length [parameter4]": {
            "template": "set system local-dhcpv6-pool [parameter1] address-range low [parameter2] low [parameter3] prefix-length [parameter4]",
            "command": "set system local-dhcpv6-pool pool1 address-range low 2001:DB8:2::/64 low 2001:DB8:2::/64 prefix-length 64",
            "explanation": "配置本地DHCPv6池的地址范围和前缀长度。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "DHCPv6池名称。"
                },
                {
                    "name": "address-range-low",
                    "type": "string",
                    "explanation": "地址范围的低端地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "前缀长度。"
                }
            ]
        }
    },
    "set access-radius-server": {
        "template": "set access-radius-server",
        "set access-radius-server [parameter1] secret [parameter2] port [parameter3] authentication-port [parameter4] accounting-port [parameter5]": {
            "template": "set access-radius-server [parameter1] secret [parameter2] port [parameter3] authentication-port [parameter4] accounting-port [parameter5]",
            "command": "set access-radius-server 10.6.55.55 secret \"050A051F010F\" port 1645 authentication-port 1645 accounting-port 1646",
            "explanation": "配置访问RADIUS服务器的参数。",
            "parameters": [
                {
                    "name": "server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "RADIUS服务器的共享密钥。"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的端口号。"
                },
                {
                    "name": "authentication-port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的认证端口号。"
                },
                {
                    "name": "accounting-port",
                    "type": "integer",
                    "explanation": "RADIUS服务器的计费端口号。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options ipv6-router-advertisements interface [parameter1]": {
            "template": "set routing-options ipv6-router-advertisements interface [parameter1]",
            "command": "set routing-options ipv6-router-advertisements interface all",
            "explanation": "在所有接口上启用IPv6路由器广告。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如all表示所有接口。"
                }
            ]
        },
        "set routing-options static route6 [parameter1] next-hop [parameter2] link-local": {
            "template": "set routing-options static route6 [parameter1] next-hop [parameter2] link-local",
            "command": "set routing-options static route6 ::/0 next-hop fe80:: link-local",
            "explanation": "配置静态IPv6路由，指定下一跳为链路本地地址。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "IPv6路由地址。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4] eui-64": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4] eui-64",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 address 2001:DB8:3::/64 eui-64",
            "explanation": "配置接口的IPv6地址及使用EUI-64格式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3] link-local": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3] link-local",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 address fe80:: link-local",
            "explanation": "配置接口的IPv6链路本地地址。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6链路本地地址。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6-client": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 dhcpv6-client",
            "command": "set interfaces ge-0/0/1 unit 0 family inet6 dhcpv6-client",
            "explanation": "在接口上启用DHCPv6客户端。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set access-group": {
        "template": "set access-group",
        "set access-group [parameter1] authentication-order [parameter2]": {
            "template": "set access-group [parameter1] authentication-order [parameter2]",
            "command": "set access-group default authentication-order radius",
            "explanation": "配置默认访问组的认证顺序。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "访问组名称，例如default。"
                },
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        },
        "set access-group [parameter1] accounting-order [parameter2]": {
            "template": "set access-group [parameter1] accounting-order [parameter2]",
            "command": "set access-group default accounting-order radius",
            "explanation": "配置默认访问组的计费顺序。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "访问组名称，例如default。"
                },
                {
                    "name": "accounting-order",
                    "type": "string",
                    "explanation": "计费顺序，例如radius。"
                }
            ]
        },
        "set access-group [parameter1] authorization-order [parameter2]": {
            "template": "set access-group [parameter1] authorization-order [parameter2]",
            "command": "set access-group default authorization-order radius",
            "explanation": "配置默认访问组的授权顺序。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "访问组名称，例如default。"
                },
                {
                    "name": "authorization-order",
                    "type": "string",
                    "explanation": "授权顺序，例如radius。"
                }
            ]
        }
    }
}