{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSR-E",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp peer-traffic": {
            "template": "set protocols ldp peer-traffic",
            "command": "set protocols ldp peer-traffic",
            "explanation": "启用LDP对等体流量。",
            "parameters": []
        },
        "set protocols mpls enable": {
            "template": "set protocols mpls enable",
            "command": "set protocols mpls enable",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "set protocols isis topology [parameter1] level-[parameter2]": {
            "template": "set protocols isis topology [parameter1] level-[parameter2]",
            "command": "set protocols isis topology opf level-1",
            "explanation": "配置ISIS拓扑为OPF，并设置级别为1。",
            "parameters": [
                {
                    "name": "topology",
                    "type": "string",
                    "explanation": "ISIS拓扑名称。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS级别，1表示级别1。"
                }
            ]
        },
        "set protocols isis topology [parameter1] metric-type [parameter2]": {
            "template": "set protocols isis topology [parameter1] metric-type [parameter2]",
            "command": "set protocols isis topology opf metric-type wide",
            "explanation": "配置ISIS拓扑为OPF，并设置度量类型为wide。",
            "parameters": [
                {
                    "name": "topology",
                    "type": "string",
                    "explanation": "ISIS拓扑名称。"
                },
                {
                    "name": "metric-type",
                    "type": "string",
                    "explanation": "度量类型，wide表示宽度量。"
                }
            ]
        },
        "set protocols mpls ldp target-address [parameter1] [parameter2]": {
            "template": "set protocols mpls ldp target-address [parameter1] [parameter2]",
            "command": "set protocols mpls ldp target-address 7.7.7.7 rsvp-te",
            "explanation": "配置MPLS LDP目标地址，并指定RSVP-TE。",
            "parameters": [
                {
                    "name": "target-address",
                    "type": "string",
                    "explanation": "LDP目标地址。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "使用的协议，例如RSVP-TE。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS家族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.4.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65000",
            "explanation": "配置路由选项中的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "commit": {
        "template": "commit",
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交配置更改，使其生效。",
            "parameters": []
        }
    }
}