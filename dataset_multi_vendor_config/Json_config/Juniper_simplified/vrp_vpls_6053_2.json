{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name ASBR1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp": {
            "template": "set protocols mpls ldp",
            "command": "set protocols mpls ldp",
            "explanation": "启用MPLS LDP协议。",
            "parameters": []
        },
        "set protocols mpls ip": {
            "template": "set protocols mpls ip",
            "command": "set protocols mpls ip",
            "explanation": "启用MPLS IP转发。",
            "parameters": []
        },
        "set protocols bgp group [parameter1] peer [parameter2] active": {
            "template": "set protocols bgp group [parameter1] peer [parameter2] active",
            "command": "set protocols bgp group internal peer 1.1.1.1 active",
            "explanation": "配置BGP内部组，指定对等体并激活。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                }
            ]
        },
        "set protocols bgp group-policy [parameter1] policy [parameter2] export": {
            "template": "set protocols bgp group-policy [parameter1] policy [parameter2] export",
            "command": "set protocols bgp group-policy internal policy policy1 export",
            "explanation": "为BGP内部组配置导出策略。",
            "parameters": [
                {
                    "name": "group-policy",
                    "type": "string",
                    "explanation": "BGP组策略名称。"
                },
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "策略名称。"
                }
            ]
        },
        "set protocols bgp group-policy [parameter1] send-label": {
            "template": "set protocols bgp group-policy [parameter1] send-label",
            "command": "set protocols bgp group-policy internal send-label",
            "explanation": "为BGP内部组配置发送标签。",
            "parameters": [
                {
                    "name": "group-policy",
                    "type": "string",
                    "explanation": "BGP组策略名称。"
                }
            ]
        },
        "set protocol ospf area [parameter1] interface [parameter2]": {
            "template": "set protocol ospf area [parameter1] interface [parameter2]",
            "command": "set protocol ospf area 0 interface ge-0/0/0.0",
            "explanation": "配置OSPF区域0的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS家族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 2.2.2.2/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options routers bgp [parameter1]": {
            "template": "set routing-options routers bgp [parameter1]",
            "command": "set routing-options routers bgp 100",
            "explanation": "配置BGP路由器的AS号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "BGP自治系统号。"
                }
            ]
        },
        "set routing-options routers bgp peer [parameter1] as [parameter2] update-source [parameter3]": {
            "template": "set routing-options routers bgp peer [parameter1] as [parameter2] update-source [parameter3]",
            "command": "set routing-options routers bgp peer 1.1.1.1 as 100 update-source lo0",
            "explanation": "配置BGP对等体，指定AS号和更新源。",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "对等体的AS号。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口。"
                }
            ]
        },
        "set routing-options routers bgp peer [parameter1] as [parameter2] update-source [parameter3] unit [parameter4]": {
            "template": "set routing-options routers bgp peer [parameter1] as [parameter2] update-source [parameter3] unit [parameter4]",
            "command": "set routing-options routers bgp peer 10.20.1.2 as 200 update-source ge-0/0/0 unit 0",
            "explanation": "配置BGP对等体，指定AS号和更新源。",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体的IP地址。"
                },
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "对等体的AS号。"
                },
                {
                    "name": "update-source",
                    "type": "string",
                    "explanation": "更新源接口。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id lo0.0",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，通常为环回接口的IP地址。"
                }
            ]
        }
    },
    "set forwardingNewLabel": {
        "template": "set forwardingNewLabel",
        "set forwardingNewLabel pmap policy [parameter1] permit [parameter2] match mpls experimental [parameter3]": {
            "template": "set forwardingNewLabel pmap policy [parameter1] permit [parameter2] match mpls experimental [parameter3]",
            "command": "set forwardingNewLabel pmap policy pmap1 permit 10 match mpls experimental topmos",
            "explanation": "配置转发新标签的PMAP策略，允许匹配MPLS实验位。",
            "parameters": [
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "策略名称。"
                },
                {
                    "name": "sequence-number",
                    "type": "integer",
                    "explanation": "序列号。"
                },
                {
                    "name": "mpls-experimental",
                    "type": "string",
                    "explanation": "MPLS实验位。"
                }
            ]
        },
        "set forwardingNewLabel pmap policy [parameter1] permit [parameter2] set mpls label imposition": {
            "template": "set forwardingNewLabel pmap policy [parameter1] permit [parameter2] set mpls label imposition",
            "command": "set forwardingNewLabel pmap policy pmap2 permit 10 set mpls label imposition",
            "explanation": "配置转发新标签的PMAP策略，设置MPLS标签。",
            "parameters": [
                {
                    "name": "policy",
                    "type": "string",
                    "explanation": "策略名称。"
                },
                {
                    "name": "sequence-number",
                    "type": "integer",
                    "explanation": "序列号。"
                }
            ]
        }
    }
}