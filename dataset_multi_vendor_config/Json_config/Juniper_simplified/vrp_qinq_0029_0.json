{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，trunk表示允许多个VLAN通过。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 vlan-id 10",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 1 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 192.168.2.1",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/1.1",
            "explanation": "配置OSPF区域及接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] interface [parameter2] virtual-address [parameter3]": {
            "template": "set protocols vrrp group [parameter1] interface [parameter2] virtual-address [parameter3]",
            "command": "set protocols vrrp group 1 interface ge-1/0/1.1 virtual-address 10.1.1.111",
            "explanation": "配置VRRP组的虚拟地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1.1。"
                },
                {
                    "name": "virtual-address",
                    "type": "string",
                    "explanation": "VRRP组的虚拟地址。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] priority [parameter2]": {
            "template": "set protocols vrrp group [parameter1] priority [parameter2]",
            "command": "set protocols vrrp group 1 priority 120",
            "explanation": "配置VRRP组的优先级。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "VRRP组的优先级，数值越大优先级越高。"
                }
            ]
        },
        "set protocols vrrp group [parameter1] preempt hold-time [parameter2]": {
            "template": "set protocols vrrp group [parameter1] preempt hold-time [parameter2]",
            "command": "set protocols vrrp group 1 preempt hold-time 20",
            "explanation": "配置VRRP组的抢占保持时间。",
            "parameters": [
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "VRRP组号。"
                },
                {
                    "name": "hold-time",
                    "type": "integer",
                    "explanation": "抢占保持时间，单位为秒。"
                }
            ]
        }
    }
}