{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口为以太网交换模式，并设置为trunk模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 10 vlan-id 10",
            "explanation": "配置接口单元的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的虚拟局域网。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 10 family inet address 10.10.1.1/24",
            "explanation": "配置接口单元的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-1/0/0.10",
            "explanation": "配置OSPF协议，指定区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID，例如0.0.0.0。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.10。"
                }
            ]
        }
    }
}