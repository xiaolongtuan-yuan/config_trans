{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis level [parameter1] [parameter2]": {
            "template": "set protocols isis level [parameter1] [parameter2]",
            "command": "set protocols isis level 1 ipv6",
            "explanation": "配置IS-IS协议的级别和IPv6支持。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，1表示级别1。"
                },
                {
                    "name": "ipv6",
                    "type": "string",
                    "explanation": "启用IPv6支持。"
                }
            ]
        },
        "set protocols isis net-entity [parameter1]": {
            "template": "set protocols isis net-entity [parameter1]",
            "command": "set protocols isis net-entity 10.0000.0000.0002.00",
            "explanation": "配置IS-IS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net-entity",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识IS-IS网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8:100::2/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 isis enable": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 isis enable",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 isis enable",
            "explanation": "在接口上启用IS-IS协议支持IPv6。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "isis",
                    "type": "string",
                    "explanation": "启用IS-IS协议支持。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 2001:db8:100::/64 next-hop 2001:db8:100::1",
            "explanation": "配置静态路由，指定目的网络和下一跳地址。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的网络的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目的网络的前缀长度。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳的IPv6地址。"
                }
            ]
        }
    }
}