{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CPE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances BD10 instance-type virtual-switch",
            "explanation": "配置路由实例的类型为虚拟交换机。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，此处为虚拟交换机。"
                }
            ]
        },
        "set routing-instances [parameter1] vxlan vni [parameter2]": {
            "template": "set routing-instances [parameter1] vxlan vni [parameter2]",
            "command": "set routing-instances BD10 vxlan vni 10",
            "explanation": "配置VXLAN的VNI（虚拟网络标识符）。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN的虚拟网络标识符。"
                }
            ]
        },
        "set routing-instances [parameter1] vxlan vni [parameter2] vtep-source-interface [parameter3]": {
            "template": "set routing-instances [parameter1] vxlan vni [parameter2] vtep-source-interface [parameter3]",
            "command": "set routing-instances BD10 vxlan vni 10 vtep-source-interface lo0.0",
            "explanation": "配置VXLAN的VTEP源接口。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN的虚拟网络标识符。"
                },
                {
                    "name": "vtep-source-interface",
                    "type": "string",
                    "explanation": "VTEP源接口的名称。"
                }
            ]
        },
        "set routing-instances [parameter1] vxlan vni [parameter2] multicast-group [parameter3]": {
            "template": "set routing-instances [parameter1] vxlan vni [parameter2] multicast-group [parameter3]",
            "command": "set routing-instances BD10 vxlan vni 10 multicast-group 239.1.1.1",
            "explanation": "配置VXLAN的组播组地址。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN的虚拟网络标识符。"
                },
                {
                    "name": "multicast-group",
                    "type": "string",
                    "explanation": "组播组地址。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 20.0000.0000.0001.00",
            "explanation": "配置IS-IS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "IS-IS的网络实体标题，用于标识IS-IS实例。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface all",
            "explanation": "在所有接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，此处为all表示所有接口。"
                }
            ]
        },
        "set protocols isis interface [parameter1] frr": {
            "template": "set protocols isis interface [parameter1] frr",
            "command": "set protocols isis interface all frr",
            "explanation": "在所有接口上配置IS-IS的快速重路由（FRR）。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，此处为all表示所有接口。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/1 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/3 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls static-l2vpn destination [parameter3] vc-id [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls static-l2vpn destination [parameter3] vc-id [parameter4]",
            "command": "set interfaces ge-1/0/3 unit 0 family mpls static-l2vpn destination 3.3.3.3 vc-id 10",
            "explanation": "配置MPLS静态L2VPN的目的地址和VC ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "L2VPN的目的地址。"
                },
                {
                    "name": "vc-id",
                    "type": "integer",
                    "explanation": "虚拟电路ID，用于标识L2VPN连接。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/3 unit 1 vlan-id 10",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family bridge interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/3 unit 1 family bridge interface-mode trunk",
            "explanation": "配置桥接接口的模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，此处为trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family bridge vlan-id-list [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family bridge vlan-id-list [parameter3]",
            "command": "set interfaces ge-1/0/3 unit 1 family bridge vlan-id-list 10",
            "explanation": "配置桥接接口的VLAN ID列表。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/3。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id-list",
                    "type": "integer",
                    "explanation": "VLAN ID列表，此处为单个VLAN ID。"
                }
            ]
        }
    }
}