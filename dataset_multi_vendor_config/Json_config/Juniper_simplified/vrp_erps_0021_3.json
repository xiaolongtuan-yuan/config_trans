{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] vlan-id [parameter2]": {
            "template": "set vlans [parameter1] vlan-id [parameter2]",
            "command": "set vlans VLAN10 vlan-id 10",
            "explanation": "配置VLAN的ID。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN的ID号。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols rstp vlan [parameter1]": {
            "template": "set protocols rstp vlan [parameter1]",
            "command": "set protocols rstp vlan [10 100]",
            "explanation": "配置RSTP协议的VLAN。",
            "parameters": [
                {
                    "name": "vlan-ids",
                    "type": "list",
                    "explanation": "RSTP协议应用的VLAN ID列表。"
                }
            ]
        },
        "set protocols erps instance [parameter1] control-vlan [parameter2]": {
            "template": "set protocols erps instance [parameter1] control-vlan [parameter2]",
            "command": "set protocols erps instance 1 control-vlan 100",
            "explanation": "配置ERPS实例的控制VLAN。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                },
                {
                    "name": "control-vlan",
                    "type": "integer",
                    "explanation": "控制VLAN的ID。"
                }
            ]
        },
        "set protocols erps instance [parameter1] protected-instance [parameter2]": {
            "template": "set protocols erps instance [parameter1] protected-instance [parameter2]",
            "command": "set protocols erps instance 1 protected-instance 0",
            "explanation": "配置ERPS实例的保护实例。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                },
                {
                    "name": "protected-instance",
                    "type": "integer",
                    "explanation": "保护实例的ID。"
                }
            ]
        },
        "set protocols erps instance [parameter1] version [parameter2]": {
            "template": "set protocols erps instance [parameter1] version [parameter2]",
            "command": "set protocols erps instance 1 version 2",
            "explanation": "配置ERPS实例的版本。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                },
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "ERPS协议的版本号。"
                }
            ]
        },
        "set protocols erps instance [parameter1] sub-ring": {
            "template": "set protocols erps instance [parameter1] sub-ring",
            "command": "set protocols erps instance 1 sub-ring",
            "explanation": "配置ERPS实例为子环。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                }
            ]
        },
        "set protocols rstp interface [parameter1] disable": {
            "template": "set protocols rstp interface [parameter1] disable",
            "command": "set protocols rstp interface ge-1/0/0 disable",
            "explanation": "在指定接口上禁用RSTP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols erps instance [parameter1] interface [parameter2]": {
            "template": "set protocols erps instance [parameter1] interface [parameter2]",
            "command": "set protocols erps instance 1 interface ge-1/0/0",
            "explanation": "配置ERPS实例的接口。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols erps instance [parameter1] interface [parameter2] rpl-owner": {
            "template": "set protocols erps instance [parameter1] interface [parameter2] rpl-owner",
            "command": "set protocols erps instance 1 interface ge-2/0/0 rpl-owner",
            "explanation": "配置ERPS实例的接口为RPL所有者。",
            "parameters": [
                {
                    "name": "instance-id",
                    "type": "integer",
                    "explanation": "ERPS实例的ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "配置接口的以太网交换模式为trunk。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching vlan members [10 100]",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-members",
                    "type": "list",
                    "explanation": "VLAN成员列表。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-1/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    }
}