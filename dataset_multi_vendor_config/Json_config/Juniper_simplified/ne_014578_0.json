{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 1.1.1.9",
            "explanation": "配置MPLS LDP协议的Router ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP协议的Router ID，用于标识LDP路由器。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] [parameter3]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] [parameter3]",
            "command": "set protocols ospf area 0.0.0.0 interface lo0.0 passive",
            "explanation": "配置OSPF协议的区域和接口，并设置接口为被动模式。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "passive",
                    "type": "string",
                    "explanation": "设置接口为被动模式，不发送OSPF Hello包。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0.0.0.0 interface ge-0/0/0.0",
            "explanation": "配置OSPF协议的区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域ID。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] mpls",
            "command": "set interfaces ge-0/0/0 unit 0 mpls",
            "explanation": "在接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] encapsulation [parameter2]": {
            "template": "set interfaces [parameter1] encapsulation [parameter2]",
            "command": "set interfaces ge-0/0/4.0 encapsulation vlan-ccc",
            "explanation": "配置接口的封装类型为VLAN-CCC。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/4.0。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-ccc。"
                }
            ]
        },
        "set interfaces [parameter1] vlan-id [parameter2]": {
            "template": "set interfaces [parameter1] vlan-id [parameter2]",
            "command": "set interfaces ge-0/0/4.0 vlan-id 1",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/4.0。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-0/0/4.0 unit 0 encapsulation mpls",
            "explanation": "在接口单元上启用MPLS封装。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/4.0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如mpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] xconnect peer-address [parameter3] vpn-id [parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] xconnect peer-address [parameter3] vpn-id [parameter4]",
            "command": "set interfaces ge-0/0/4.0 unit 0 xconnect peer-address 3.3.3.9 vpn-id 101",
            "explanation": "配置接口单元的交叉连接，指定对等地址和VPN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/4.0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "peer-address",
                    "type": "string",
                    "explanation": "对等地址，用于指定交叉连接的对端地址。"
                },
                {
                    "name": "vpn-id",
                    "type": "integer",
                    "explanation": "VPN ID，用于标识VPN。"
                }
            ]
        }
    }
}