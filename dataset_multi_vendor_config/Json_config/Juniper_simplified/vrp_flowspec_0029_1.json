{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpna instance-type virtual-router",
            "explanation": "配置路由实例的类型为虚拟路由器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如virtual-router。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpna route-distinguisher 100:1",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于在MPLS VPN中唯一标识路由。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-import target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-import target [parameter2]",
            "command": "set routing-instances vpna vrf-import target 111:1",
            "explanation": "配置路由实例的VRF导入目标。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "VRF导入目标，用于控制路由的导入。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-export target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-export target [parameter2]",
            "command": "set routing-instances vpna vrf-export target 111:1",
            "explanation": "配置路由实例的VRF导出目标。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "target",
                    "type": "string",
                    "explanation": "VRF导出目标，用于控制路由的导出。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2]",
            "command": "set routing-instances vpna protocols bgp group bgp-group",
            "explanation": "在路由实例中配置BGP组。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols bgp group [parameter2] family [parameter3]": {
            "template": "set routing-instances [parameter1] protocols bgp group [parameter2] family [parameter3]",
            "command": "set routing-instances vpna protocols bgp group bgp-group family vpnv4",
            "explanation": "在路由实例的BGP组中配置VPNv4地址族。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如vpnv4。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8:1::2/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 vrf [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 vrf [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 vrf vpna",
            "explanation": "配置接口的IPv6地址族关联到指定的VRF。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vrf-name",
                    "type": "string",
                    "explanation": "VRF名称，用于指定地址族关联的VRF。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 0 family inet address 10.2.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group bgp-group type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group bgp-group local-address 10.2.1.1",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group bgp-group neighbor 10.2.1.2 peer-as 200",
            "explanation": "配置BGP组的邻居及其对等AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BGP邻居的地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP邻居的对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3] [parameter4]",
            "command": "set protocols bgp group bgp-group neighbor 10.2.1.2 family inet6 unicast",
            "explanation": "配置BGP组的邻居的地址族为IPv6单播。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BGP邻居的地址。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet6。"
                },
                {
                    "name": "sub-address-family",
                    "type": "string",
                    "explanation": "子地址族类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family [parameter3]",
            "command": "set protocols bgp group bgp-group neighbor 10.2.1.2 family vpnv4",
            "explanation": "配置BGP组的邻居的地址族为VPNv4。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BGP邻居的地址。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如vpnv4。"
                }
            ]
        }
    }
}