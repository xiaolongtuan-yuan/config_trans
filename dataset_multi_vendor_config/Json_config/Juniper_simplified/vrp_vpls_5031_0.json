{
    "host-name": {
        "template": "host-name",
        "host-name [parameter1]": {
            "template": "host-name [parameter1]",
            "command": "host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface": {
        "template": "interface",
        "interface [parameter1]": {
            "template": "interface [parameter1]",
            "command": "interface ge-0/0/0.1",
            "explanation": "进入指定接口的配置模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.1。"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口。",
            "parameters": []
        },
        "unit [parameter1]": {
            "template": "unit [parameter1]",
            "command": "unit 10",
            "explanation": "配置接口单元。",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "family inet": {
            "template": "family inet",
            "command": "family inet",
            "explanation": "配置接口的IPv4协议族。",
            "parameters": []
        },
        "address [parameter1]/[parameter2]": {
            "template": "address [parameter1]/[parameter2]",
            "command": "address 10.1.1.1/32",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式。",
            "parameters": []
        }
    }
}