{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] description [parameter2]": {
            "template": "set vlans [parameter1] description [parameter2]",
            "command": "set vlans vlan1 description \"Default VLAN\"",
            "explanation": "配置VLAN的描述信息。",
            "parameters": [
                {
                    "name": "vlan-name",
                    "type": "string",
                    "explanation": "VLAN的名称。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "VLAN的描述信息。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching port-mode access",
            "explanation": "配置接口的以太网交换模式为接入模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "接口的以太网交换模式，例如access。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family ethernet-switching vlan members vlan1",
            "explanation": "配置接口的VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "接口所属的VLAN名称。"
                }
            ]
        }
    }
}