{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp neighbor [parameter1]": {
            "template": "set protocols ldp neighbor [parameter1]",
            "command": "set protocols ldp neighbor 1.1.1.9",
            "explanation": "配置LDP协议的邻居。",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "LDP邻居的IP地址。"
                }
            ]
        }
    },
    "set forwarding-plane": {
        "template": "set forwarding-plane",
        "set forwarding-plane virtual-functions vfi [parameter1] encapsulation-dot1q [parameter2]": {
            "template": "set forwarding-plane virtual-functions vfi [parameter1] encapsulation-dot1q [parameter2]",
            "command": "set forwarding-plane virtual-functions vfi a2 encapsulation-dot1q 10",
            "explanation": "配置虚拟转发功能的VFI和封装类型。",
            "parameters": [
                {
                    "name": "vfi-name",
                    "type": "string",
                    "explanation": "虚拟转发功能的名称。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于802.1Q封装。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family l2vpn pw-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2vpn pw-id [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family l2vpn pw-id 100",
            "explanation": "配置接口的L2VPN协议族和伪线ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "pw-id",
                    "type": "integer",
                    "explanation": "伪线ID，用于标识L2VPN连接。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 192.168.20.2/32",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family l2vpn": {
            "template": "set interfaces [parameter1] unit [parameter2] family l2vpn",
            "command": "set interfaces ge-1/0/0 unit 1 family l2vpn",
            "explanation": "配置接口的L2VPN协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options routers ospf [parameter1] area [parameter2] network [parameter3].[parameter4].[parameter5].[parameter6]": {
            "template": "set routing-options routers ospf [parameter1] area [parameter2] network [parameter3].[parameter4].[parameter5].[parameter6]",
            "command": "set routing-options routers ospf 1 area 0 network 3.3.3.9.0.0.0.0",
            "explanation": "配置OSPF路由协议的区域和网络。",
            "parameters": [
                {
                    "name": "ospf-process-id",
                    "type": "integer",
                    "explanation": "OSPF进程ID。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "wildcard-mask",
                    "type": "string",
                    "explanation": "通配符掩码，用于匹配网络地址。"
                }
            ]
        }
    }
}