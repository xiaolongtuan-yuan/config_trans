{
    "host-name": {
        "template": "host-name",
        "host-name [parameter1]": {
            "template": "host-name [parameter1]",
            "command": "host-name CE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "interface": {
        "template": "interface",
        "interface [parameter1]": {
            "template": "interface [parameter1]",
            "command": "interface ge-0/0/0",
            "explanation": "进入指定接口的配置模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "interface [parameter1] description [parameter2]": {
            "template": "interface [parameter1] description [parameter2]",
            "command": "interface ge-0/0/0 description To_Core_Layer3",
            "explanation": "为接口添加描述信息。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口的描述信息。"
                }
            ]
        },
        "interface [parameter1] no shutdown": {
            "template": "interface [parameter1] no shutdown",
            "command": "interface ge-0/0/0 no shutdown",
            "explanation": "启用接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        },
        "interface [parameter1] encapsulation dot1q [parameter2]": {
            "template": "interface [parameter1] encapsulation dot1q [parameter2]",
            "command": "interface ge-0/0/0.10 encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为802.1Q，并指定VLAN ID。",
            "parameters": [
                {
                    "name": "subinterface",
                    "type": "string",
                    "explanation": "子接口名称，例如ge-0/0/0.10。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识不同的VLAN。"
                }
            ]
        },
        "interface [parameter1] ip address [parameter2] [parameter3]": {
            "template": "interface [parameter1] ip address [parameter2] [parameter3]",
            "command": "interface ge-0/0/0.10 ip address 10.1.1.2 255.255.255.0",
            "explanation": "为子接口配置IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "subinterface",
                    "type": "string",
                    "explanation": "子接口名称，例如ge-0/0/0.10。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给子接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "string",
                    "explanation": "IPv4子网掩码。"
                }
            ]
        }
    }
}