{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-3/0/1 unit 0 family inet address 1.1.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] enable": {
            "template": "set interfaces [parameter1] unit [parameter2] enable",
            "command": "set interfaces ge-3/0/1 unit 0 enable",
            "explanation": "启用指定接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-3/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group external-peers type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-as [parameter2]",
            "command": "set protocols bgp group external-peers local-as 200",
            "explanation": "配置BGP组的本地AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "本地AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] peer-as [parameter3]",
            "command": "set protocols bgp group external-peers neighbor 1.1.2.1 peer-as 200",
            "explanation": "配置BGP邻居的AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "邻居的AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2] family inet unicast": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2] family inet unicast",
            "command": "set protocols bgp group external-peers neighbor 1.1.2.1 family inet unicast",
            "explanation": "配置BGP邻居支持IPv4单播。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        }
    }
}