{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols pim": {
            "template": "set protocols pim",
            "command": "set protocols pim",
            "explanation": "启用PIM协议。",
            "parameters": []
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1] to [parameter2]": {
            "template": "set protocols mpls label-switched-path [parameter1] to [parameter2]",
            "command": "set protocols mpls label-switched-path lsp-to-2.2.2.2 to 2.2.2.2",
            "explanation": "配置MPLS标签交换路径到指定目的地。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的地的IP地址。"
                }
            ]
        },
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface all",
            "explanation": "在所有接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，'all'表示所有接口。"
                }
            ]
        },
        "set protocols pim interface [parameter1]": {
            "template": "set protocols pim interface [parameter1]",
            "command": "set protocols pim interface ge-1/0/0",
            "explanation": "在指定接口上启用PIM协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface lo0.1",
            "explanation": "在指定OSPF区域中启用指定接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols pim rp static address [parameter1]": {
            "template": "set protocols pim rp static address [parameter1]",
            "command": "set protocols pim rp static address 2.2.2.2",
            "explanation": "配置PIM静态RP地址。",
            "parameters": [
                {
                    "name": "rp-address",
                    "type": "string",
                    "explanation": "RP的IP地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}