{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set bridge-domains": {
        "template": "set bridge-domains",
        "set bridge-domains [parameter1] domain-type [parameter2]": {
            "template": "set bridge-domains [parameter1] domain-type [parameter2]",
            "command": "set bridge-domains vlan-10 domain-type bridge",
            "explanation": "配置桥接域的类型。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域的名称。"
                },
                {
                    "name": "domain-type",
                    "type": "string",
                    "explanation": "桥接域的类型，例如bridge。"
                }
            ]
        },
        "set bridge-domains [parameter1] interface [parameter2]": {
            "template": "set bridge-domains [parameter1] interface [parameter2]",
            "command": "set bridge-domains vlan-10 interface ae10.100",
            "explanation": "将接口添加到桥接域中。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "string",
                    "explanation": "桥接域的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10.100。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "set interfaces ae10 unit 0 family ethernet-switching port-mode trunk",
            "explanation": "配置接口的以太网交换模式和端口模式。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "端口模式，例如trunk。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ae10 unit 100 encapsulation vlan-bridge",
            "explanation": "配置接口的封装类型。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如vlan-bridge。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ae10 unit 100 vlan-id 100",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ae10。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID，用于标识VLAN。"
                }
            ]
        },
        "set interfaces [parameter1] ether-options 802.3ad [parameter2]": {
            "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
            "command": "set interfaces ge-0/0/0 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项，例如加入链路聚合组。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        }
    },
    "delete interfaces": {
        "template": "delete interfaces",
        "delete interfaces [parameter1] disable": {
            "template": "delete interfaces [parameter1] disable",
            "command": "delete interfaces ge-0/0/0 disable",
            "explanation": "删除接口的禁用状态。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    }
}