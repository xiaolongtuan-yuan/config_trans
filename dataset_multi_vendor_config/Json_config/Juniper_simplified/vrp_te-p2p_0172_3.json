{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSRD",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1]": {
            "template": "set protocols ldp interface [parameter1]",
            "command": "set protocols ldp interface gig-e1/0/0",
            "explanation": "在指定接口上启用LDP协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gig-e1/0/0。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels": {
            "template": "set protocols mpls traffic-eng tunnels",
            "command": "set protocols mpls traffic-eng tunnels",
            "explanation": "启用MPLS流量工程隧道。",
            "parameters": []
        },
        "set protocols mpls traffic-eng metric [parameter1] interface [parameter2]": {
            "template": "set protocols mpls traffic-eng metric [parameter1] interface [parameter2]",
            "command": "set protocols mpls traffic-eng metric 1 interface lo1",
            "explanation": "为指定接口配置MPLS流量工程的度量值。",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值，用于影响路径选择。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo1。"
                }
            ]
        },
        "set protocols ldp autoconfig interface [parameter1]": {
            "template": "set protocols ldp autoconfig interface [parameter1]",
            "command": "set protocols ldp autoconfig interface gig-e1/0/0",
            "explanation": "在指定接口上启用LDP自动配置。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gig-e1/0/0。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces gig-E1/0/0 unit 0 family inet address 10.1.6.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gig-E1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances ospf-1 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称，例如ospf-1。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols ospf area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set routing-instances [parameter1] protocols ospf area [parameter2] network [parameter3]/[parameter4]",
            "command": "set routing-instances ospf-1 protocols ospf area 0 network 10.1.3.0/24",
            "explanation": "在指定的OSPF区域中配置网络。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称，例如ospf-1。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options traffic-engineering area [parameter1]": {
            "template": "set routing-options traffic-engineering area [parameter1]",
            "command": "set routing-options traffic-engineering area 0",
            "explanation": "配置流量工程区域。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "流量工程区域号。"
                }
            ]
        }
    }
}