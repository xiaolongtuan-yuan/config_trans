{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn2 instance-type virtual-router",
            "explanation": "配置路由实例的类型为虚拟路由器。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如virtual-router。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn2 route-distinguisher 100:2",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同的VPN路由。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-import [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-import [parameter2]",
            "command": "set routing-instances vpn2 vrf-import 100:2",
            "explanation": "配置路由实例的VRF导入策略。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vrf-import",
                    "type": "string",
                    "explanation": "VRF导入策略标识。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-export [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-export [parameter2]",
            "command": "set routing-instances vpn2 vrf-export 100:2",
            "explanation": "配置路由实例的VRF导出策略。",
            "parameters": [
                {
                    "name": "routing-instance",
                    "type": "string",
                    "explanation": "路由实例名称。"
                },
                {
                    "name": "vrf-export",
                    "type": "string",
                    "explanation": "VRF导出策略标识。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 3.3.3.9",
            "explanation": "配置MPLS LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "MPLS LDP的路由器ID。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-0/0/2.0",
            "explanation": "在指定接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2.0。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group vpn-peer type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group vpn-peer peer-as 100",
            "explanation": "配置BGP组的对等AS号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group vpn-peer neighbor 3.3.3.9",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet unicast network [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet unicast network [parameter2]",
            "command": "set protocols bgp group vpn-peer family inet unicast network 1.1.1.9/32",
            "explanation": "配置BGP组在inet地址族下的单播网络。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family vpnv4 network [parameter2]": {
            "template": "set protocols bgp group [parameter1] family vpnv4 network [parameter2]",
            "command": "set protocols bgp group vpn-peer family vpnv4 network 1.1.1.9/32",
            "explanation": "配置BGP组在vpnv4地址族下的网络。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及掩码。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-0/0/2.0",
            "explanation": "在指定区域和接口上启用OSPF。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/2.0。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2] unit [parameter3]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2] unit [parameter3]",
            "command": "set protocols ospf area 0 interface lo0 unit 0",
            "explanation": "在指定区域和环回接口单元上启用OSPF。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        },
        "set protocols bgp family [parameter1]": {
            "template": "set protocols bgp family [parameter1]",
            "command": "set protocols bgp family vpnv4",
            "explanation": "启用BGP的vpnv4地址族。",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "BGP地址族，例如vpnv4。"
                }
            ]
        },
        "set protocols bgp family [parameter1] neighbor [parameter2] remote-as [parameter3]": {
            "template": "set protocols bgp family [parameter1] neighbor [parameter2] remote-as [parameter3]",
            "command": "set protocols bgp family vpnv4 neighbor 172.17.1.2 remote-as 65421",
            "explanation": "配置BGP vpnv4地址族下的邻居及其远程AS号。",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "BGP地址族，例如vpnv4。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "邻居的远程AS号。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/1 unit 1 family inet address 172.17.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
            "command": "set policy-options policy-statement vpn1-import term 1 from protocol direct",
            "explanation": "配置策略语句的匹配条件为直接路由。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "匹配的路由协议，例如direct。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement vpn1-import term 1 then accept",
            "explanation": "配置策略语句的操作为接受。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "执行的操作，例如accept。"
                }
            ]
        }
    }
}