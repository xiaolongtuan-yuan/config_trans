{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name P",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-protocol [parameter1]": {
            "template": "set protocols mpls label-protocol [parameter1]",
            "command": "set protocols mpls label-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label-protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "set protocols mpls mpls-ip": {
            "template": "set protocols mpls mpls-ip",
            "command": "set protocols mpls mpls-ip",
            "explanation": "启用MPLS IP功能。",
            "parameters": []
        },
        "set protocols mpls ldp router-id [parameter1]": {
            "template": "set protocols mpls ldp router-id [parameter1]",
            "command": "set protocols mpls ldp router-id 2.2.2.2",
            "explanation": "配置LDP的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "LDP路由器的ID地址。"
                }
            ]
        },
        "set protocols mpls ldp advertise-labels": {
            "template": "set protocols mpls ldp advertise-labels",
            "command": "set protocols mpls ldp advertise-labels",
            "explanation": "启用LDP标签广告功能。",
            "parameters": []
        },
        "set protocols mpls ldp discovery transport-address [parameter1]": {
            "template": "set protocols mpls ldp discovery transport-address [parameter1]",
            "command": "set protocols mpls ldp discovery transport-address 2.2.2.2",
            "explanation": "配置LDP发现传输地址。",
            "parameters": [
                {
                    "name": "transport-address",
                    "type": "string",
                    "explanation": "LDP发现传输地址。"
                }
            ]
        },
        "set protocols mpls ldp neighbor [parameter1]": {
            "template": "set protocols mpls ldp neighbor [parameter1]",
            "command": "set protocols mpls ldp neighbor 10.1.1.1",
            "explanation": "配置LDP邻居。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "LDP邻居的IP地址。"
                }
            ]
        },
        "set protocols mpls ldp igp-sync": {
            "template": "set protocols mpls ldp igp-sync",
            "command": "set protocols mpls ldp igp-sync",
            "explanation": "启用LDP IGP同步功能。",
            "parameters": []
        },
        "set protocols isis level [parameter1]": {
            "template": "set protocols isis level [parameter1]",
            "command": "set protocols isis level 2",
            "explanation": "配置IS-IS的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，例如2。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0001.0000.0000.0000.00",
            "explanation": "配置IS-IS的网络实体标题。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "IS-IS的网络实体标题。"
                }
            ]
        },
        "set protocols isis metric-style [parameter1]": {
            "template": "set protocols isis metric-style [parameter1]",
            "command": "set protocols isis metric-style wide",
            "explanation": "配置IS-IS的度量风格为宽。",
            "parameters": [
                {
                    "name": "metric-style",
                    "type": "string",
                    "explanation": "IS-IS的度量风格，例如wide。"
                }
            ]
        },
        "set protocols isis segment-routing [parameter1]": {
            "template": "set protocols isis segment-routing [parameter1]",
            "command": "set protocols isis segment-routing mpls",
            "explanation": "启用IS-IS的段路由MPLS功能。",
            "parameters": [
                {
                    "name": "segment-routing",
                    "type": "string",
                    "explanation": "段路由类型，例如mpls。"
                }
            ]
        },
        "set protocols isis segment-routing global-block [parameter1] [parameter2]": {
            "template": "set protocols isis segment-routing global-block [parameter1] [parameter2]",
            "command": "set protocols isis segment-routing global-block 153616 153800",
            "explanation": "配置IS-IS段路由的全局块范围。",
            "parameters": [
                {
                    "name": "start-label",
                    "type": "integer",
                    "explanation": "全局块的起始标签。"
                },
                {
                    "name": "end-label",
                    "type": "integer",
                    "explanation": "全局块的结束标签。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet isis level [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet isis level [parameter3]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet isis level 2",
            "explanation": "配置接口的IS-IS级别。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS的级别，例如2。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet isis prefix-sid absolute [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet isis prefix-sid absolute [parameter3]",
            "command": "set interfaces lo0 unit 0 family inet isis prefix-sid absolute 153710",
            "explanation": "配置环回接口的IS-IS前缀SID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "prefix-sid",
                    "type": "integer",
                    "explanation": "IS-IS前缀SID的绝对数值。"
                }
            ]
        }
    }
}