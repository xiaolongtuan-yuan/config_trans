{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name LSR-A",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols ldp interface [parameter1] force-label allocation": {
            "template": "set protocols ldp interface [parameter1] force-label allocation",
            "command": "set protocols ldp interface gigabit-ethernet1/0/0 force-label allocation",
            "explanation": "在指定接口上强制分配LDP标签。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabit-ethernet1/0/0。"
                }
            ]
        },
        "set protocols ldp interface [parameter1] local-label allocation-force": {
            "template": "set protocols ldp interface [parameter1] local-label allocation-force",
            "command": "set protocols ldp interface ge-1/0/0 local-label allocation-force",
            "explanation": "在指定接口上强制分配本地LDP标签。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                }
            ]
        },
        "set protocols mep domain [parameter1] id [parameter2] remotes peer-remote-id [parameter3]": {
            "template": "set protocols mep domain [parameter1] id [parameter2] remotes peer-remote-id [parameter3]",
            "command": "set protocols mep domain abcd id 1 remotes peer-remote-id 2",
            "explanation": "配置MEP域的参数，包括域名称、ID和远程对等ID。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "MEP域的名称。"
                },
                {
                    "name": "id",
                    "type": "integer",
                    "explanation": "MEP域的ID。"
                },
                {
                    "name": "peer-remote-id",
                    "type": "integer",
                    "explanation": "远程对等ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces lo0 unit 0 family inet address 1.1.1.1/32",
            "explanation": "配置环回接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances test-rip instance-type vrf",
            "explanation": "配置路由实例的类型。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] interface [parameter2]": {
            "template": "set routing-instances [parameter1] interface [parameter2]",
            "command": "set routing-instances test-rip interface ge-1/0/0.0",
            "explanation": "将接口添加到路由实例中。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0.0。"
                }
            ]
        }
    },
    "set forwarding-options": {
        "template": "set forwarding-options",
        "set forwarding-options label-switched-path [parameter1] nexthop [parameter2]": {
            "template": "set forwarding-options label-switched-path [parameter1] nexthop [parameter2]",
            "command": "set forwarding-options label-switched-path abcd nexthop 2.1.1.2",
            "explanation": "配置标签交换路径的下一跳地址。",
            "parameters": [
                {
                    "name": "lsp-name",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "nexthop",
                    "type": "string",
                    "explanation": "下一跳的IP地址。"
                }
            ]
        },
        "set forwarding-options label-switched-path [parameter1] out-label [parameter2]": {
            "template": "set forwarding-options label-switched-path [parameter1] out-label [parameter2]",
            "command": "set forwarding-options label-switched-path abcd out-label 20",
            "explanation": "配置标签交换路径的出标签。",
            "parameters": [
                {
                    "name": "lsp-name",
                    "type": "string",
                    "explanation": "标签交换路径的名称。"
                },
                {
                    "name": "out-label",
                    "type": "integer",
                    "explanation": "出标签的值。"
                }
            ]
        }
    },
    "set vlans": {
        "template": "set vlans",
        "set vlans [parameter1] rules any permit": {
            "template": "set vlans [parameter1] rules any permit",
            "command": "set vlans vlan0,vlan1,vlan3,arp-vlan-access rules any permit",
            "explanation": "配置VLAN的访问规则，允许所有流量。",
            "parameters": [
                {
                    "name": "vlan-list",
                    "type": "string",
                    "explanation": "VLAN列表，例如vlan0,vlan1,vlan3,arp-vlan-access。"
                }
            ]
        }
    }
}