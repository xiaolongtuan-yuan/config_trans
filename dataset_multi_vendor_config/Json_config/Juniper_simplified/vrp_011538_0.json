{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols cfm version [parameter1]": {
            "template": "set protocols cfm version [parameter1]",
            "command": "set protocols cfm version standard",
            "explanation": "配置CFM协议的版本为标准版本。",
            "parameters": [
                {
                    "name": "version",
                    "type": "string",
                    "explanation": "CFM协议的版本，此处为标准版本。"
                }
            ]
        },
        "set protocols cfm cfm-enable": {
            "template": "set protocols cfm cfm-enable",
            "command": "set protocols cfm cfm-enable",
            "explanation": "启用CFM协议。",
            "parameters": []
        },
        "set protocols cfm domain [parameter1] service [parameter2] continuity-check interval [parameter3]": {
            "template": "set protocols cfm domain [parameter1] service [parameter2] continuity-check interval [parameter3]",
            "command": "set protocols cfm domain md1 service ma1 continuity-check interval 3",
            "explanation": "配置CFM域中服务的连续性检查间隔时间。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "服务的名称。"
                },
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "连续性检查的间隔时间，单位为秒。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] interface [parameter4] [parameter5]": {
            "template": "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] interface [parameter4] [parameter5]",
            "command": "set protocols cfm domain md1 service ma1 continuity-check mep 1 interface ge-1/0/1.1 inward",
            "explanation": "配置CFM域中服务的MEP（维护端点）的接口和方向。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "服务的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向，此处为向内。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] remote-mep [parameter4] peer-ip [parameter5]": {
            "template": "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] remote-mep [parameter4] peer-ip [parameter5]",
            "command": "set protocols cfm domain md1 service ma1 continuity-check mep 1 remote-mep 2 peer-ip 1.1.1.1",
            "explanation": "配置CFM域中服务的MEP的远程MEP和对端IP地址。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "服务的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的编号。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程维护端点的编号。"
                },
                {
                    "name": "peer-ip",
                    "type": "string",
                    "explanation": "对端IP地址。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] remote-mep [parameter4] continuity-check-receive": {
            "template": "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] remote-mep [parameter4] continuity-check-receive",
            "command": "set protocols cfm domain md1 service ma1 continuity-check mep 1 remote-mep 2 continuity-check-receive",
            "explanation": "配置CFM域中服务的MEP接收远程MEP的连续性检查。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "服务的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的编号。"
                },
                {
                    "name": "remote-mep",
                    "type": "integer",
                    "explanation": "远程维护端点的编号。"
                }
            ]
        },
        "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] loss-measurement dual-ended test-id [parameter4]": {
            "template": "set protocols cfm domain [parameter1] service [parameter2] continuity-check mep [parameter3] loss-measurement dual-ended test-id [parameter4]",
            "command": "set protocols cfm domain md1 service ma1 continuity-check mep 1 loss-measurement dual-ended test-id 1",
            "explanation": "配置CFM域中服务的MEP的双端丢失测量测试ID。",
            "parameters": [
                {
                    "name": "domain",
                    "type": "string",
                    "explanation": "CFM域的名称。"
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "服务的名称。"
                },
                {
                    "name": "mep",
                    "type": "integer",
                    "explanation": "维护端点的编号。"
                },
                {
                    "name": "test-id",
                    "type": "integer",
                    "explanation": "测试ID。"
                }
            ]
        },
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface ge-1/0/2",
            "explanation": "配置MPLS协议的接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols mpls ldp router-id [parameter1] force": {
            "template": "set protocols mpls ldp router-id [parameter1] force",
            "command": "set protocols mpls ldp router-id 2.2.2.2 force",
            "explanation": "强制配置MPLS LDP协议的路由器ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器ID。"
                }
            ]
        },
        "set protocols ospf area [parameter1] interface [parameter2]": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface lo0.0",
            "explanation": "配置OSPF协议的区域和接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                }
            ]
        },
        "set protocols l2circuit neighbor [parameter1] interface [parameter2] virtual-circuit-id [parameter3]": {
            "template": "set protocols l2circuit neighbor [parameter1] interface [parameter2] virtual-circuit-id [parameter3]",
            "command": "set protocols l2circuit neighbor 1.1.1.1 interface ge-1/0/1.1 virtual-circuit-id ldp1",
            "explanation": "配置L2电路的邻居、接口和虚拟电路ID。",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居IP地址。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "virtual-circuit-id",
                    "type": "string",
                    "explanation": "虚拟电路ID。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 encapsulation vlan-ccc",
            "explanation": "配置接口的封装类型为VLAN-CCC。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
            "command": "set interfaces ge-1/0/1 unit 1 vlan-id 2",
            "explanation": "配置接口的VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/2 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-1/0/2 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号。"
                }
            ]
        }
    }
}