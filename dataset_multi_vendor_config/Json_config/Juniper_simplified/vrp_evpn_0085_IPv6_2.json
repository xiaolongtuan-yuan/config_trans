{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name NPE",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances vpn1 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] route-distinguisher [parameter2]": {
            "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
            "command": "set routing-instances vpn1 route-distinguisher 100:1",
            "explanation": "配置路由实例的路由区分器。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "路由区分器，用于区分不同VPN的路由。"
                }
            ]
        },
        "set routing-instances [parameter1] vrf-target [parameter2]": {
            "template": "set routing-instances [parameter1] vrf-target [parameter2]",
            "command": "set routing-instances vpn1 vrf-target target:2:2",
            "explanation": "配置路由实例的VRF目标。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "vrf-target",
                    "type": "string",
                    "explanation": "VRF目标，用于控制路由的导入和导出。"
                }
            ]
        },
        "set routing-instances [parameter1] protocols [parameter2]": {
            "template": "set routing-instances [parameter1] protocols [parameter2]",
            "command": "set routing-instances vpn1 protocols mpls",
            "explanation": "在路由实例中启用MPLS协议。",
            "parameters": [
                {
                    "name": "instance-name",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "启用的协议，例如mpls。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 3.3.3.3",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        },
        "set routing-options autonomous-system [parameter1]": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 100",
            "explanation": "配置路由器的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "路由器的自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls interface [parameter1]": {
            "template": "set protocols mpls interface [parameter1]",
            "command": "set protocols mpls interface all",
            "explanation": "在所有接口上启用MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，all表示所有接口。"
                }
            ]
        },
        "set protocols mpls label-switched-path [parameter1]": {
            "template": "set protocols mpls label-switched-path [parameter1]",
            "command": "set protocols mpls label-switched-path ldp",
            "explanation": "配置MPLS的标签交换路径为LDP。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "string",
                    "explanation": "标签交换路径的类型，例如ldp。"
                }
            ]
        },
        "set protocols isis interface [parameter1]": {
            "template": "set protocols isis interface [parameter1]",
            "command": "set protocols isis interface lo0.0",
            "explanation": "在指定接口上启用IS-IS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0.0。"
                }
            ]
        },
        "set protocols isis level [parameter1] [parameter2]": {
            "template": "set protocols isis level [parameter1] [parameter2]",
            "command": "set protocols isis level 1 disable",
            "explanation": "禁用IS-IS协议的Level 1。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS协议的级别，例如1。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对指定级别的操作，例如disable。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 10.0000.0000.0003.00",
            "explanation": "配置IS-IS协议的NET地址。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "IS-IS协议的NET地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group internal type internal",
            "explanation": "配置BGP组的类型为内部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如internal。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group internal local-address 3.3.3.3",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] neighbor [parameter2]": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group internal neighbor 2.2.2.2",
            "explanation": "配置BGP组的邻居。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "BGP组的邻居地址。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family [parameter3]": {
            "template": "set interfaces [parameter1] unit [parameter2] family [parameter3]",
            "command": "set interfaces ge-1/0/0 unit 0 family mpls",
            "explanation": "在接口上启用MPLS协议族。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "协议族，例如mpls。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-2/0/0 unit 0 family inet6 address 2001:DB8:30::1/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] vrf-table-label": {
            "template": "set interfaces [parameter1] unit [parameter2] vrf-table-label",
            "command": "set interfaces ge-2/0/0 unit 0 vrf-table-label",
            "explanation": "在接口上启用VRF表标签。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set policy-options": {
        "template": "set policy-options",
        "set policy-options policy-statement [parameter1] term [parameter2] from prefix-list [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from prefix-list [parameter3]",
            "command": "set policy-options policy-statement SPE term 10 from prefix-list default",
            "explanation": "配置策略语句的匹配条件为来自指定的前缀列表。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表的名称。"
                }
            ]
        },
        "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement SPE term 10 then accept",
            "explanation": "配置策略语句的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "策略语句的动作，例如accept。"
                }
            ]
        },
        "set policy-options prefix-list [parameter1] [parameter2]": {
            "template": "set policy-options prefix-list [parameter1] [parameter2]",
            "command": "set policy-options prefix-list default ::/0",
            "explanation": "配置前缀列表。",
            "parameters": [
                {
                    "name": "prefix-list",
                    "type": "string",
                    "explanation": "前缀列表的名称。"
                },
                {
                    "name": "prefix",
                    "type": "string",
                    "explanation": "前缀列表的地址和前缀长度。"
                }
            ]
        }
    }
}