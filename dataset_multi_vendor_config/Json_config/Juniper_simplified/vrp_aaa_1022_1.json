{
    "set system": {
        "template": "set system",
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order tacplus",
            "explanation": "配置系统认证顺序为TACACS+。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，指定为TACACS+。"
                }
            ]
        },
        "set system tacplus-server [parameter1] secret [parameter2]": {
            "template": "set system tacplus-server [parameter1] secret [parameter2]",
            "command": "set system tacplus-server 10.137.217.251 secret cisco",
            "explanation": "配置TACACS+服务器地址及共享密钥。",
            "parameters": [
                {
                    "name": "tacplus-server",
                    "type": "string",
                    "explanation": "TACACS+服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与TACACS+服务器通信的共享密钥。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2] authentication plaintext-password [parameter3]": {
            "template": "set system login user [parameter1] class [parameter2] authentication plaintext-password [parameter3]",
            "command": "set system login user admin@aaa class super-user authentication plaintext-password \"pPgn;|W90$J72.Ak$Y,IQ:gqIfPBTLjqW%,N`M_~\"",
            "explanation": "配置用户登录信息，包括用户名、用户类别及明文密码。",
            "parameters": [
                {
                    "name": "user",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户类别，例如super-user。"
                },
                {
                    "name": "plaintext-password",
                    "type": "string",
                    "explanation": "用户的明文密码。"
                }
            ]
        },
        "set system login user [parameter1] class [parameter2]": {
            "template": "set system login user [parameter1] class [parameter2]",
            "command": "set system login user admin@aaa class super-user",
            "explanation": "配置用户登录信息，包括用户名及用户类别。",
            "parameters": [
                {
                    "name": "user",
                    "type": "string",
                    "explanation": "用户名。"
                },
                {
                    "name": "class",
                    "type": "string",
                    "explanation": "用户类别，例如super-user。"
                }
            ]
        },
        "set system services ssh": {
            "template": "set system services ssh",
            "command": "set system services ssh",
            "explanation": "启用SSH服务。",
            "parameters": []
        },
        "set system services telnet": {
            "template": "set system services telnet",
            "command": "set system services telnet",
            "explanation": "启用Telnet服务。",
            "parameters": []
        },
        "set system session-id common": {
            "template": "set system session-id common",
            "command": "set system session-id common",
            "explanation": "配置系统会话ID为通用模式。",
            "parameters": []
        },
        "set system services ssh root-login allow": {
            "template": "set system services ssh root-login allow",
            "command": "set system services ssh root-login allow",
            "explanation": "允许SSH服务的root用户登录。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.137.217.251/23",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces ge-0/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 10.137.216.1",
            "explanation": "配置静态路由，指定默认路由的下一跳地址。",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "路由目的地址及掩码。"
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "下一跳地址。"
                }
            ]
        }
    }
}