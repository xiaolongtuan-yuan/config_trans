{
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 4.4.4.4",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-switched-path [parameter1]": {
            "template": "set protocols mpls label-switched-path [parameter1]",
            "command": "set protocols mpls label-switched-path 330403",
            "explanation": "配置MPLS的标签交换路径。",
            "parameters": [
                {
                    "name": "label-switched-path",
                    "type": "integer",
                    "explanation": "标签交换路径的ID。"
                }
            ]
        },
        "set protocols mpls traffic-eng tunnels": {
            "template": "set protocols mpls traffic-eng tunnels",
            "command": "set protocols mpls traffic-eng tunnels",
            "explanation": "启用MPLS流量工程的隧道功能。",
            "parameters": []
        },
        "set protocols mpls traffic-eng explicit-path [parameter1] next-address [parameter2]": {
            "template": "set protocols mpls traffic-eng explicit-path [parameter1] next-address [parameter2]",
            "command": "set protocols mpls traffic-eng explicit-path path2asbr2 next-address 3.3.3.3",
            "explanation": "配置MPLS流量工程的显式路径的下一个地址。",
            "parameters": [
                {
                    "name": "explicit-path",
                    "type": "string",
                    "explanation": "显式路径的名称。"
                },
                {
                    "name": "next-address",
                    "type": "string",
                    "explanation": "显式路径的下一个地址。"
                }
            ]
        },
        "set protocols isis interface [parameter1] address [parameter2]/[parameter3]": {
            "template": "set protocols isis interface [parameter1] address [parameter2]/[parameter3]",
            "command": "set protocols isis interface ge-0/0/0.0 address 10.9.1.2/24",
            "explanation": "配置ISIS接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set protocols isis interface [parameter1] metric [parameter2]": {
            "template": "set protocols isis interface [parameter1] metric [parameter2]",
            "command": "set protocols isis interface ge-0/0/0.0 metric 10",
            "explanation": "配置ISIS接口的度量值。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                },
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "接口的度量值。"
                }
            ]
        },
        "set protocols isis net [parameter1]": {
            "template": "set protocols isis net [parameter1]",
            "command": "set protocols isis net 49.0001.0000.0000.0004.00",
            "explanation": "配置ISIS的网络实体标题（NET）。",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题（NET），用于标识ISIS网络。"
                }
            ]
        },
        "set protocols isis traffic-eng level [parameter1]": {
            "template": "set protocols isis traffic-eng level [parameter1]",
            "command": "set protocols isis traffic-eng level 2",
            "explanation": "配置ISIS流量工程的级别。",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "ISIS流量工程的级别。"
                }
            ]
        },
        "set protocols isis segment-routing mpls": {
            "template": "set protocols isis segment-routing mpls",
            "command": "set protocols isis segment-routing mpls",
            "explanation": "启用ISIS的段路由MPLS功能。",
            "parameters": []
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] mpls": {
            "template": "set interfaces [parameter1] mpls",
            "command": "set interfaces ge-0/0/0.0 mpls",
            "explanation": "在接口上启用MPLS。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set interfaces [parameter1] mpls traffic-eng tunnels": {
            "template": "set interfaces [parameter1] mpls traffic-eng tunnels",
            "command": "set interfaces ge-0/0/0.0 mpls traffic-eng tunnels",
            "explanation": "在接口上启用MPLS流量工程的隧道功能。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set interfaces [parameter1] mpls segment-routing sid [parameter2]": {
            "template": "set interfaces [parameter1] mpls segment-routing sid [parameter2]",
            "command": "set interfaces lo0 mpls segment-routing sid 16400",
            "explanation": "配置环回接口的段路由SID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如lo0。"
                },
                {
                    "name": "sid",
                    "type": "integer",
                    "explanation": "段路由的SID值。"
                }
            ]
        },
        "set interfaces [parameter1] tunnel-protocol mpls traffic-eng": {
            "template": "set interfaces [parameter1] tunnel-protocol mpls traffic-eng",
            "command": "set interfaces tunnel.2 tunnel-protocol mpls traffic-eng",
            "explanation": "配置隧道的协议为MPLS流量工程。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道接口名称，例如tunnel.2。"
                }
            ]
        },
        "set interfaces [parameter1] destination [parameter2]": {
            "template": "set interfaces [parameter1] destination [parameter2]",
            "command": "set interfaces tunnel.2 destination 3.3.3.3",
            "explanation": "配置隧道的目的地址。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道接口名称，例如tunnel.2。"
                },
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "隧道的目的地址。"
                }
            ]
        },
        "set interfaces [parameter1] mpls traffic-eng path-option [parameter2] explicit-path [parameter3]": {
            "template": "set interfaces [parameter1] mpls traffic-eng path-option [parameter2] explicit-path [parameter3]",
            "command": "set interfaces tunnel.2 mpls traffic-eng path-option 1 explicit-path path2asbr2",
            "explanation": "配置MPLS流量工程隧道的路径选项。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道接口名称，例如tunnel.2。"
                },
                {
                    "name": "path-option",
                    "type": "integer",
                    "explanation": "路径选项的编号。"
                },
                {
                    "name": "explicit-path",
                    "type": "string",
                    "explanation": "显式路径的名称。"
                }
            ]
        },
        "set interfaces [parameter1] mpls traffic-eng binding-sid [parameter2]": {
            "template": "set interfaces [parameter1] mpls traffic-eng binding-sid [parameter2]",
            "command": "set interfaces tunnel.2 mpls traffic-eng binding-sid 3000",
            "explanation": "配置MPLS流量工程隧道的绑定SID。",
            "parameters": [
                {
                    "name": "tunnel",
                    "type": "string",
                    "explanation": "隧道接口名称，例如tunnel.2。"
                },
                {
                    "name": "binding-sid",
                    "type": "integer",
                    "explanation": "绑定SID的值。"
                }
            ]
        }
    }
}