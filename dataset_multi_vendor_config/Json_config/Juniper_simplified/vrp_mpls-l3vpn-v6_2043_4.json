{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8:2::2/64",
            "explanation": "配置接口的IPv6地址及前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ipv6-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 10.10.10.10",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于BGP等协议中标识路由器。"
                }
            ]
        }
    },
    "set protocols bgp": {
        "template": "set protocols bgp",
        "set protocols bgp group [parameter1] type [parameter2]": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group [parameter1] local-address [parameter2]": {
            "template": "set protocols bgp group [parameter1] local-address [parameter2]",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 local-address 2001:db8:2::2",
            "explanation": "配置BGP组的本地地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "BGP组的本地地址。"
                }
            ]
        },
        "set protocols bgp group [parameter1] remote-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] remote-as [parameter2]",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 remote-as 100",
            "explanation": "配置BGP组的远程AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "remote-as",
                    "type": "integer",
                    "explanation": "BGP组的远程AS号。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet6 unicast": {
            "template": "set protocols bgp group [parameter1] family inet6 unicast",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 family inet6 unicast",
            "explanation": "为BGP组启用IPv6单播地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet6 unicast network [parameter2]/[parameter3]": {
            "template": "set protocols bgp group [parameter1] family inet6 unicast network [parameter2]/[parameter3]",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 family inet6 unicast network 2001:db8:0:1:2::1/128",
            "explanation": "配置BGP组宣告的IPv6网络。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "宣告的IPv6网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6网络地址的前缀长度。"
                }
            ]
        },
        "set protocols bgp group [parameter1] family inet6 unicast peer-as [parameter2]": {
            "template": "set protocols bgp group [parameter1] family inet6 unicast peer-as [parameter2]",
            "command": "set protocols bgp group neighbor-2001:db8:2::1 family inet6 unicast peer-as 100",
            "explanation": "配置BGP组IPv6单播地址族的对等AS号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等AS号。"
                }
            ]
        }
    }
}