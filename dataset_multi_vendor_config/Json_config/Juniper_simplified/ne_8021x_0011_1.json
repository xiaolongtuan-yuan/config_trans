{
    "set system": {
        "template": "set system",
        "set system host-name [parameter1]": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name Router",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        },
        "set system aaa radius-server [parameter1] secret [parameter2]": {
            "template": "set system aaa radius-server [parameter1] secret [parameter2]",
            "command": "set system aaa radius-server 192.168.7.249 secret \"%^%#`E)v.Q@BHVzxxZ;ij{>&_M0!TGP7YRA@8a7mq<\\/%^%#\"",
            "explanation": "配置RADIUS服务器的IP地址和共享密钥。",
            "parameters": [
                {
                    "name": "radius-server-ip",
                    "type": "string",
                    "explanation": "RADIUS服务器的IP地址。"
                },
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "与RADIUS服务器通信的共享密钥。"
                }
            ]
        },
        "set system login authentication-order [parameter1]": {
            "template": "set system login authentication-order [parameter1]",
            "command": "set system login authentication-order radius",
            "explanation": "配置登录认证顺序为RADIUS。",
            "parameters": [
                {
                    "name": "authentication-order",
                    "type": "string",
                    "explanation": "认证顺序，例如radius。"
                }
            ]
        },
        "set system authentication-order [parameter1]": {
            "template": "set system authentication-order [parameter1]",
            "command": "set system authentication-order radius",
