{
    "set system": {
        "template": "set system",
        "set system name [parameter1]": {
            "template": "set system name [parameter1]",
            "command": "set system name SPE2",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "template": "set protocols",
        "set protocols mpls label-distribution-protocol [parameter1]": {
            "template": "set protocols mpls label-distribution-protocol [parameter1]",
            "command": "set protocols mpls label-distribution-protocol ldp",
            "explanation": "配置MPLS的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "标签分发协议，例如ldp。"
                }
            ]
        },
        "setprotocols mpls enable": {
            "template": "setprotocols mpls enable",
            "command": "setprotocols mpls enable",
            "explanation": "启用MPLS协议。",
            "parameters": []
        },
        "setprotocols l2vpn": {
            "template": "setprotocols l2vpn",
            "command": "setprotocols l2vpn",
            "explanation": "启用L2VPN协议。",
            "parameters": []
        }
    },
    "set routing-instances": {
        "template": "set routing-instances",
        "set routing-instances [parameter1] instance-type [parameter2]": {
            "template": "set routing-instances [parameter1] instance-type [parameter2]",
            "command": "set routing-instances v100 instance-type vrf",
            "explanation": "配置路由实例的类型为VRF。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "路由实例的类型，例如vrf。"
                }
            ]
        },
        "set routing-instances [parameter1] routing-options route-target-import target [parameter2]:[parameter3] [parameter4]": {
            "template": "set routing-instances [parameter1] routing-options route-target-import target [parameter2]:[parameter3] [parameter4]",
            "command": "set routing-instances v100 routing-options route-target-import target 100:100 both",
            "explanation": "配置路由实例的导入路由目标。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "target-number",
                    "type": "integer",
                    "explanation": "路由目标的编号。"
                },
                {
                    "name": "target-number2",
                    "type": "integer",
                    "explanation": "路由目标的编号。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "路由目标的方向，例如both。"
                }
            ]
        },
        "set routing-instances [parameter1] routing-options route-target-export target [parameter2]:[parameter3] [parameter4]": {
            "template": "set routing-instances [parameter1] routing-options route-target-export target [parameter2]:[parameter3] [parameter4]",
            "command": "set routing-instances v100 routing-options route-target-export target 100:100 both",
            "explanation": "配置路由实例的导出路由目标。",
            "parameters": [
                {
                    "name": "instance",
                    "type": "string",
                    "explanation": "路由实例的名称。"
                },
                {
                    "name": "target-number",
                    "type": "integer",
                    "explanation": "路由目标的编号。"
                },
                {
                    "name": "target-number2",
                    "type": "integer",
                    "explanation": "路由目标的编号。"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "路由目标的方向，例如both。"
                }
            ]
        }
    },
    "set interfaces": {
        "template": "set interfaces",
        "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.10.2.2/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces [parameter1] unit [parameter2] family mpls": {
            "template": "set interfaces [parameter1] unit [parameter2] family mpls",
            "command": "set interfaces ge-0/0/0 unit 0 family mpls",
            "explanation": "配置接口的MPLS协议。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "template": "set routing-options",
        "set routing-options router-id [parameter1]": {
            "template": "set routing-options router-id [parameter1]",
            "command": "set routing-options router-id 3.3.3.9",
            "explanation": "配置路由器的ID。",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "string",
                    "explanation": "路由器的ID，用于标识路由器。"
                }
            ]
        }
    },
    "set protocols ospf": {
        "template": "set protocols ospf",
        "set protocols ospf [parameter1] area [parameter2] interface [parameter3]": {
            "template": "set protocols ospf [parameter1] area [parameter2] interface [parameter3]",
            "command": "set protocols ospf 1 area 0 interface ge-0/0/0.0",
            "explanation": "配置OSPF协议的接口。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例的编号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域编号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/0.0。"
                }
            ]
        },
        "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]": {
            "template": "set protocols ospf [parameter1] area [parameter2] network [parameter3]/[parameter4]",
            "command": "set protocols ospf 1 area 0 network 10.10.2.0/24",
            "explanation": "配置OSPF协议的网络。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例的编号。"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域编号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "子网掩码的位数。"
                }
            ]
        }
    }
}