{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "在设备上启用 MPLS IP 转发",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "配置接口 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.34.4 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.34.4，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        },
        "mpls ldp autoconfig": {
            "template": "mpls ldp autoconfig",
            "command": "mpls ldp autoconfig",
            "explanation": "在接口上自动配置 LDP",
            "parameters": []
        },
        "mpls ldp discovery transport-address [parameter1]": {
            "template": "mpls ldp discovery transport-address [parameter1]",
            "command": "mpls ldp discovery transport-address 4.4.4.4",
            "explanation": "设置 LDP 发现传输地址为 4.4.4.4",
            "parameters": [
                {
                    "name": "transport address",
                    "type": "IPv4",
                    "explanation": "传输地址"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect vfi [parameter1]": {
            "template": "xconnect vfi [parameter1]",
            "command": "xconnect vfi ldp1",
            "explanation": "配置子接口连接到 VFI 'ldp1'",
            "parameters": [
                {
                    "name": "VFI name",
                    "type": "string",
                    "explanation": "VFI 名称"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 4.4.4.4 0.0.0.0 area 0",
            "explanation": "将 IP 地址 4.4.4.4 加入 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
