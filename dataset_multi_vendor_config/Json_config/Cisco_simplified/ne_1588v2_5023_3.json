{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp domain [parameter1]": {
        "template": "ptp domain [parameter1]",
        "command": "ptp domain 1",
        "explanation": "配置PTP域为1",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "PTP域编号"
            }
        ]
    },
    "ptp clock-source [parameter1] priority1 [parameter2]": {
        "template": "ptp clock-source [parameter1] priority1 [parameter2]",
        "command": "ptp clock-source bits1 priority1 1",
        "explanation": "配置PTP时钟源为bits1，优先级1为1",
        "parameters": [
            {
                "name": "clock source",
                "type": "string",
                "explanation": "时钟源名称"
            },
            {
                "name": "priority1",
                "type": "integer",
                "explanation": "优先级1的值"
            }
        ]
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type bc",
        "explanation": "配置PTP设备类型为边界时钟",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "设备类型"
            }
        ]
    },
    "ptp clock source [parameter1] type [parameter2] input": {
        "template": "ptp clock source [parameter1] type [parameter2] input",
        "command": "ptp clock source bits1 type 1pps input",
        "explanation": "配置PTP时钟源bits1的类型为1pps输入",
        "parameters": [
            {
                "name": "clock source",
                "type": "string",
                "explanation": "时钟源名称"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "时钟源类型"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ptp enable": {
            "template": "ptp enable",
            "command": "ptp enable",
            "explanation": "启用PTP功能",
            "parameters": []
        },
        "ptp delay-mechanism [parameter1]": {
            "template": "ptp delay-mechanism [parameter1]",
            "command": "ptp delay-mechanism pdelay",
            "explanation": "配置PTP延迟机制为pdelay",
            "parameters": [
                {
                    "name": "delay mechanism",
                    "type": "string",
                    "explanation": "延迟机制类型"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.0.0.0 0.0.0.255 area 0",
            "explanation": "将网络10.0.0.0/24加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    }
}