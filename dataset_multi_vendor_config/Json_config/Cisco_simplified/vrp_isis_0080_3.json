{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 2",
        "explanation": "配置 IS-IS 路由进程，进程号为 2",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "IS-IS 进程号"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 00.4444.4444.4444.00",
            "explanation": "配置 IS-IS 网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-2-only",
            "explanation": "配置 IS-IS 类型为仅 Level-2",
            "parameters": [
                {
                    "name": "IS-IS type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip router isis [parameter1]": {
            "template": "ip router isis [parameter1]",
            "command": "ip router isis 2",
            "explanation": "在接口上启用 IS-IS 路由，进程号为 2",
            "parameters": [
                {
                    "name": "process ID",
                    "type": "integer",
                    "explanation": "IS-IS 进程号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}