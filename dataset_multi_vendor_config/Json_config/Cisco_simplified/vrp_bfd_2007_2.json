{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用IPv6单播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:2::2，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 ospfv3 [parameter1] area [parameter2]": {
            "template": "ipv6 ospfv3 [parameter1] area [parameter2]",
            "command": "ipv6 ospfv3 1 area 0.0.0.0",
            "explanation": "在接口上启用OSPFv3进程1，并将其分配到区域0.0.0.0",
            "parameters": [
                {
                    "name": "ospfv3 process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3区域ID"
                }
            ]
        }
    },
    "ipv6 bfd ipv6session bind peer-ipv6 [parameter1]": {
        "template": "ipv6 bfd ipv6session bind peer-ipv6 [parameter1]",
        "command": "ipv6 bfd ipv6session bind peer-ipv6 2001:db8:1::1",
        "explanation": "配置BFD会话，绑定到对端IPv6地址2001:db8:1::1",
        "parameters": [
            {
                "name": "peer ipv6 address",
                "type": "IPv6",
                "explanation": "对端IPv6地址"
            }
        ],
        "bfd discriminator local [parameter1]": {
            "template": "bfd discriminator local [parameter1]",
            "command": "bfd discriminator local 2",
            "explanation": "设置本地BFD会话的标识符为2",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地BFD会话标识符"
                }
            ]
        },
        "bfd discriminator remote [parameter1]": {
            "template": "bfd discriminator remote [parameter1]",
            "command": "bfd discriminator remote 1",
            "explanation": "设置远端BFD会话的标识符为1",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端BFD会话标识符"
                }
            ]
        }
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "进入OSPFv3进程1的配置模式",
        "parameters": [
            {
                "name": "ospfv3 process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
            "explanation": "设置OSPFv3进程1的路由器ID为3.3.3.3",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPFv3区域0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3区域ID"
                }
            ]
        }
    }
}