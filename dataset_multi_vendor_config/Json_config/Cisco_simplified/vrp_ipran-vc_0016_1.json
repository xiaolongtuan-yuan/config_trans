            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        },
        "ip router isis [parameter1]": {
            "template": "ip router isis [parameter1]",
            "command": "ip router isis 65534",
            "explanation": "在接口上启用 IS-IS 路由协议，并指定 IS-IS 进程 ID 为 65534",
            "parameters": [
                {
                    "name": "IS-IS process ID",
                    "type": "integer",
                    "explanation": "IS-IS 进程 ID"
                }
            ]
        }
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 65534",
        "explanation": "配置 IS-IS 路由进程，进程 ID 为 65534",
        "parameters": [
            {
                "name": "IS-IS process ID",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0000.0004.00",
            "explanation": "配置 IS-IS 网络实体标题（NET），用于标识 IS-IS 区域和系统",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
