            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.0.4 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.4.0.4，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
