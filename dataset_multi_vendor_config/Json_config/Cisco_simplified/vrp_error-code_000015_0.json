{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用双向转发检测（BFD）功能",
        "parameters": []
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置IS-IS路由进程1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "IS-IS进程ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0001.00",
            "explanation": "配置IS-IS网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel1",
        "explanation": "配置接口 'Port-channel1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "description [parameter1]": {
            "template": "description [parameter1]",
            "command": "description Eth-Trunk1",
            "explanation": "设置接口描述为 'Eth-Trunk1'",
            "parameters": [
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口描述"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process ID",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        },
        "isis cost [parameter1]": {
            "template": "isis cost [parameter1]",
            "command": "isis cost max-reachable",
            "explanation": "设置IS-IS接口成本为最大可达值",
            "parameters": [
                {
                    "name": "cost",
                    "type": "string",
                    "explanation": "IS-IS接口成本"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 1 mode on",
            "explanation": "将接口加入到通道组1，并设置为on模式",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "通道组模式"
                }
            ]
        },
        "no cdp enable": {
            "template": "no cdp enable",
            "command": "no cdp enable",
            "explanation": "禁用CDP（Cisco Discovery Protocol）功能",
            "parameters": []
        },
        "link-quality [parameter1] error-ratio [parameter2] resume-ratio [parameter3]": {
            "template": "link-quality [parameter1] error-ratio [parameter2] resume-ratio [parameter3]",
            "command": "link-quality low error-ratio 3/4 resume-ratio 2/5",
            "explanation": "配置链路质量监测，设置错误比率为3/4，恢复比率为2/5",
            "parameters": [
                {
                    "name": "link-quality",
                    "type": "string",
                    "explanation": "链路质量"
                },
                {
                    "name": "error-ratio",
                    "type": "string",
                    "explanation": "错误比率"
                },
                {
                    "name": "resume-ratio",
                    "type": "string",
                    "explanation": "恢复比率"
                }
            ]
        }
    }
}