{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router id [parameter1]": {
        "template": "router id [parameter1]",
        "command": "router id 4.4.4.4",
        "explanation": "设置路由器的ID为 '4.4.4.4'",
        "parameters": [
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "import-route static type [parameter1]": {
            "template": "import-route static type [parameter1]",
            "command": "import-route static type 1",
            "explanation": "将静态路由导入OSPF，类型为1",
            "parameters": [
                {
                    "name": "type",
                    "type": "integer",
                    "explanation": "路由类型"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.2",
            "explanation": "配置OSPF区域0.0.0.2",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.2.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.2中宣告网络192.168.2.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.0.0.0 255.0.0.0 NULL0",
        "explanation": "配置静态路由，目的网络为10.0.0.0/8，下一跳为NULL0接口",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳地址或接口"
            }
        ]
    },
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.2.0 0.0.0.255 area 0.0.0.2",
            "explanation": "在OSPF区域0.0.0.2中宣告网络192.168.2.0/24",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 10.0.0.0 255.0.0.0 Null0",
        "explanation": "配置静态路由，目的网络为10.0.0.0/8，下一跳为Null0接口",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳地址或接口"
            }
        ]
    }
}