{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname RR",
        "explanation": "设置设备的主机名为 'RR'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/3",
        "explanation": "配置接口 'GigabitEthernet3/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.4.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.4.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65008",
        "explanation": "配置 BGP 路由进程，AS 号为 65008",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 5.5.5.5",
            "explanation": "设置 BGP 路由器的 ID 为 5.5.5.5",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.2.1 remote-as 65008",
            "explanation": "配置 BGP 邻居，IP 地址为 172.16.2.1，AS 号为 65008",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family ipv4",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 172.16.2.1 activate",
                "explanation": "激活与邻居 172.16.2.1 的 IPv4 BGP 会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 和 IGP 同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 172.16.2.0 mask 255.255.255.0",
                "explanation": "在 BGP 中宣告网络 172.16.2.0/24",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "maximum-paths [parameter1]": {
                "template": "maximum-paths [parameter1]",
                "command": "maximum-paths 2",
                "explanation": "设置 BGP 最大路径数为 2",
                "parameters": [
                    {
                        "name": "maximum paths",
                        "type": "integer",
                        "explanation": "最大路径数"
                    }
                ]
            }
        }
    }
}