{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRC",
        "explanation": "设置设备的主机名为 'LSRC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "配置 MPLS LDP 的路由器 ID 为 Loopback1 接口的 IP 地址，并强制使用",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "force",
                "type": "keyword",
                "explanation": "强制使用指定接口作为路由器 ID"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "在设备上启用 MPLS IP 功能",
        "parameters": []
    },
    "mpls traffic-eng": {
        "template": "mpls traffic-eng",
        "command": "mpls traffic-eng",
        "explanation": "在设备上启用 MPLS 流量工程功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "remote-mep-id [parameter1]": {
            "template": "remote-mep-id [parameter1]",
            "command": "remote-mep-id 4",
            "explanation": "配置远程 MEP ID 为 4",
            "parameters": [
                {
                    "name": "mep id",
                    "type": "integer",
                    "explanation": "MEP ID"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 1.1.1.1 255.255.255.255 3.2.1.1",
        "explanation": "配置静态路由，目的地址为 1.1.1.1/32，下一跳为 3.2.1.1",
        "parameters": [
            {
                "name": "destination ip",
                "type": "IPv4",
                "explanation": "目的 IP 地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    }
}