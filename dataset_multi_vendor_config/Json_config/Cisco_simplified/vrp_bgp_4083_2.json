{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用 BFD（双向转发检测）功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.20.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 路由进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 3.3.3.3",
            "explanation": "设置 BGP 路由器的 ID 为 3.3.3.3",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.1 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.1，AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "neighbor [parameter1] maximum-routes [parameter2]": {
            "template": "neighbor [parameter1] maximum-routes [parameter2]",
            "command": "neighbor 10.20.2.1 maximum-routes 12000",
            "explanation": "配置 BGP 邻居 10.20.2.1 的最大路由数为 12000",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "maximum routes",
                    "type": "integer",
                    "explanation": "最大路由数"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family ipv4",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.1 activate",
                "explanation": "激活 BGP 邻居 10.1.1.1 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-map [parameter2] out": {
                "template": "neighbor [parameter1] route-map [parameter2] out",
                "command": "neighbor 10.20.2.1 route-map 10 out",
                "explanation": "对 BGP 邻居 10.20.2.1 的出站路由应用路由映射 10",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    }
                ]
            }
        }
    },
    "route-map [parameter1] permit [parameter2]": {
        "template": "route-map [parameter1] permit [parameter2]",
        "command": "route-map 10 permit 10",
        "explanation": "配置路由映射 10，允许序列号为 10 的路由",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set metric [parameter1]": {
            "template": "set metric [parameter1]",
            "command": "set metric 150",
            "explanation": "设置路由的度量值为 150",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}