            "template": "bfd all-interfaces",
            "command": "bfd all-interfaces",
            "explanation": "在所有接口上启用 BFD",
            "parameters": []
        },
        "bfd address-family ipv4 fast-detect": {
            "template": "bfd address-family ipv4 fast-detect",
            "command": "bfd address-family ipv4 fast-detect",
            "explanation": "在 IPv4 地址族上启用 BFD 快速检测",
            "parameters": []
        },
        "bfd fast-detect": {
            "template": "bfd fast-detect",
            "command": "bfd fast-detect",
            "explanation": "启用 BFD 快速检测",
            "parameters": []
        }
    },
    "bfd all-interfaces": {
        "template": "bfd all-interfaces",
        "command": "bfd all-interfaces",
        "explanation": "在所有接口上启用 BFD",
        "parameters": []
    },
    "interval [parameter1] min_rx [parameter2] min_tx [parameter3] multiplier [parameter4]": {
        "template": "interval [parameter1] min_rx [parameter2] min_tx [parameter3] multiplier [parameter4]",
        "command": "interval 100 min_rx 100 min_tx 100 multiplier 3",
        "explanation": "配置 BFD 的间隔时间为 100 毫秒，最小接收间隔为 100 毫秒，最小发送间隔为 100 毫秒，乘数为 3",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "间隔时间（毫秒）"
            },
            {
                "name": "min_rx",
                "type": "integer",
                "explanation": "最小接收间隔（毫秒）"
            },
            {
                "name": "min_tx",
                "type": "integer",
                "explanation": "最小发送间隔（毫秒）"
            },
            {
                "name": "multiplier",
                "type": "integer",
                "explanation": "乘数"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.2.0 0.0.0.255 area 0",
            "explanation": "将网络 192.168.2.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
