{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ABR",
        "explanation": "设置设备的主机名为 'ABR'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "配置 OSPFv3 进程 ID 为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPFv3 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器的 ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPFv3 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        },
        "area [parameter1] range [parameter2]": {
            "template": "area [parameter1] range [parameter2]",
            "command": "area 0.0.0.1 range 2001:DB8::/32",
            "explanation": "在 OSPFv3 区域 0.0.0.1 中汇总地址 2001:DB8::/32",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                },
                {
                    "name": "IPv6 prefix",
                    "type": "IPv6",
                    "explanation": "IPv6 前缀"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ospfv3 [parameter1] area [parameter2]": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到 OSPFv3 进程 1 的区域 0.0.0.0",
            "parameters": [
                {
                    "name": "process ID",
                    "type": "integer",
                    "explanation": "OSPFv3 进程 ID"
                },
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}