{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.4.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65440",
        "explanation": "进入 BGP 路由器配置模式，AS 号为 65440",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.4.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居 10.4.1.2，其 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统编号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 与 IGP 的同步",
                "parameters": []
            },
            "redistribute connected": {
                "template": "redistribute connected",
                "command": "redistribute connected",
                "explanation": "重分布直连路由到 BGP",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.4.1.2 activate",
                "explanation": "激活与邻居 10.4.1.2 的会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        },
        "exit-address-family": {
            "template": "exit-address-family",
            "command": "exit-address-family",
            "explanation": "退出地址族配置模式",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式并返回到特权执行模式",
        "parameters": []
    }
}