{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "配置 BGP 路由进程，AS 号为 65410",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 10.10.10.10",
            "explanation": "配置 BGP 路由器的 ID 为 10.10.10.10",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.2，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 1.1.1.1 mask 255.255.255.255",
                "explanation": "在 BGP 中宣告网络 1.1.1.1/32",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.2 activate",
                "explanation": "激活与邻居 10.1.1.2 的 BGP 会话",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 与 IGP 的同步",
                "parameters": []
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            },
            "network [parameter1]": {
                "template": "network [parameter1]",
                "command": "network 2001:DB8:8::/64",
                "explanation": "在 BGP 中宣告网络 2001:DB8:8::/64",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv6",
                        "explanation": "网络地址"
                    }
                ]
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}