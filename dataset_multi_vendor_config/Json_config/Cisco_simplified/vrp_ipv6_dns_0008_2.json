{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::3/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:2::3/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 rip [parameter1] enable": {
            "template": "ipv6 rip [parameter1] enable",
            "command": "ipv6 rip RIPNG enable",
            "explanation": "在接口上启用 RIPNG 路由协议",
            "parameters": [
                {
                    "name": "rip process name",
                    "type": "string",
                    "explanation": "RIP 进程名称"
                }
            ]
        }
    },
    "ipv6 router rip [parameter1]": {
        "template": "ipv6 router rip [parameter1]",
        "command": "ipv6 router rip RIPNG",
        "explanation": "配置 IPv6 RIP 路由进程 'RIPNG'",
        "parameters": [
            {
                "name": "rip process name",
                "type": "string",
                "explanation": "RIP 进程名称"
            }
        ],
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式并返回到特权执行模式",
        "parameters": []
    }
}