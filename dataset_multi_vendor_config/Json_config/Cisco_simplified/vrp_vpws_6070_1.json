{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建 VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ethernet cfm": {
        "template": "ethernet cfm",
        "command": "ethernet cfm",
        "explanation": "启用以太网连接故障管理（CFM）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan10",
        "explanation": "配置接口 'Vlan10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许 VLAN 10 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "ethernet cfm md [parameter1]": {
        "template": "ethernet cfm md [parameter1]",
        "command": "ethernet cfm md md1",
        "explanation": "配置以太网 CFM 维护域 'md1'",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "mep domain [parameter1]": {
            "template": "mep domain [parameter1]",
            "command": "mep domain ma1",
            "explanation": "配置维护端点域 'ma1'",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4]": {
                "template": "mep domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4]",
                "command": "mep domain ma1 mep-id 2 interface GigabitEthernet1/0/0 direction outward",
                "explanation": "配置维护端点 ID 2，接口为 GigabitEthernet1/0/0，方向为向外",
                "parameters": [
                    {
                        "name": "maintenance association",
                        "type": "string",
                        "explanation": "维护关联名"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点 ID"
                    },
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep domain [parameter1] mep-id [parameter2] ccm-send": {
                "template": "mep domain [parameter1] mep-id [parameter2] ccm-send",
                "command": "mep domain ma1 mep-id 2 ccm-send",
                "explanation": "配置维护端点 ID 2 发送连续性检查消息（CCM）",
                "parameters": [
                    {
                        "name": "maintenance association",
                        "type": "string",
                        "explanation": "维护关联名"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点 ID"
                    }
                ]
            },
            "mep domain [parameter1] mep-id [parameter2] remote-mep": {
                "template": "mep domain [parameter1] mep-id [parameter2] remote-mep",
                "command": "mep domain ma1 mep-id 1 remote-mep",
                "explanation": "配置维护端点 ID 1 为远程维护端点",
                "parameters": [
                    {
                        "name": "maintenance association",
                        "type": "string",
                        "explanation": "维护关联名"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点 ID"
                    }
                ]
            },
            "mep domain [parameter1] mep-id [parameter2] ccm-receive": {
                "template": "mep domain [parameter1] mep-id [parameter2] ccm-receive",
                "command": "mep domain ma1 mep-id 1 ccm-receive",
                "explanation": "配置维护端点 ID 1 接收连续性检查消息（CCM）",
                "parameters": [
                    {
                        "name": "maintenance association",
                        "type": "string",
                        "explanation": "维护关联名"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "维护端点 ID"
                    }
                ]
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}