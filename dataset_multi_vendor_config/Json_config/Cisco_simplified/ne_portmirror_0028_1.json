{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "设置封装类型为 dot1q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识号"
                }
            ]
        },
        "bridge-group [parameter1]": {
            "template": "bridge-group [parameter1]",
            "command": "bridge-group 10",
            "explanation": "设置桥接组为 10",
            "parameters": [
                {
                    "name": "bridge group number",
                    "type": "integer",
                    "explanation": "桥接组编号"
                }
            ]
        },
        "encapsulation dot1q [parameter1] second-dot1q [parameter2]": {
            "template": "encapsulation dot1q [parameter1] second-dot1q [parameter2]",
            "command": "encapsulation dot1q 30 second-dot1q 10",
            "explanation": "设置双层 VLAN 封装，外层 VLAN ID 为 30，内层 VLAN ID 为 10",
            "parameters": [
                {
                    "name": "outer VLAN ID",
                    "type": "integer",
                    "explanation": "外层 VLAN 标识号"
                },
                {
                    "name": "inner VLAN ID",
                    "type": "integer",
                    "explanation": "内层 VLAN 标识号"
                }
            ]
        }
    }
}