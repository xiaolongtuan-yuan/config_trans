{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device",
        "explanation": "设置设备的主机名为 'Device'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口为trunk模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100,200",
            "explanation": "允许VLAN 100和200通过trunk",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "list of integers",
                    "explanation": "允许通过的VLAN列表"
                }
            ]
        },
        "arp inspection trust": {
            "template": "arp inspection trust",
            "command": "arp inspection trust",
            "explanation": "信任接口的ARP流量",
            "parameters": []
        },
        "arp rate-limit [parameter1]": {
            "template": "arp rate-limit [parameter1]",
            "command": "arp rate-limit 50",
            "explanation": "设置ARP速率限制为50次/秒",
            "parameters": [
                {
                    "name": "rate limit",
                    "type": "integer",
                    "explanation": "每秒允许的ARP请求数"
                }
            ]
        }
    }
}