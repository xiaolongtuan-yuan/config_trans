{
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface Loopback0",
        "explanation": "配置接口 Loopback0",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "ip address [ip-address] [subnet-mask]": {
            "template": "ip address [ip-address] [subnet-mask]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 2.2.2.2，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet-mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ptp enable": {
            "template": "ptp enable",
            "command": "ptp enable",
            "explanation": "启用 PTP（精密时间协议)",
            "parameters": []
        },
        "ptp device-type [type]": {
            "template": "ptp device-type [type]",
            "command": "ptp device-type boundary",
            "explanation": "设置 PTP 设备类型为边界时钟",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "设备类型，这里是 'boundary'"
                }
            ]
        },
        "ptp clock-source atr enable": {
            "template": "ptp clock-source atr enable",
            "command": "ptp clock-source atr enable",
            "explanation": "启用 ATR（Automatic Time Recovery）时钟源",
            "parameters": []
        },
        "ptp priority [priority-value]": {
            "template": "ptp priority [priority-value]",
            "command": "ptp priority 5",
            "explanation": "设置 PTP 优先级为 5",
            "parameters": [
                {
                    "name": "priority-value",
                    "type": "integer",
                    "explanation": "优先级值"
                }
            ]
        },
        "ptp adaptive enable": {
            "template": "ptp adaptive enable",
            "command": "ptp adaptive enable",
            "explanation": "启用自适应 PTP",
            "parameters": []
        },
        "ptp adaptive time-profile": {
            "template": "ptp adaptive time-profile",
            "command": "ptp adaptive time-profile",
            "explanation": "设置自适应时间配置文件",
            "parameters": []
        },
        "ptp adaptive device-type [type]": {
            "template": "ptp adaptive device-type [type]",
            "command": "ptp adaptive device-type client",
            "explanation": "设置自适应设备类型为客户端",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "设备类型，这里是 'client'"
                }
            ]
        },
        "ptp adaptive atr hop-by-hop": {
            "template": "ptp adaptive atr hop-by-hop",
            "command": "ptp adaptive atr hop-by-hop",
            "explanation": "启用 ATR 每跳协商",
            "parameters": []
        },
        "ptp adaptive local-ip [ip-address]": {
            "template": "ptp adaptive local-ip [ip-address]",
            "command": "ptp adaptive local-ip 2.2.2.2",
            "explanation": "设置本地 IP 地址为 2.2.2.2",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "本地 IP 地址"
                }
            ]
        },
        "ptp adaptive atr unicast-negotiation enable": {
            "template": "ptp adaptive atr unicast-negotiation enable",
            "command": "ptp adaptive atr unicast-negotiation enable",
            "explanation": "启用 ATR 单播协商",
            "parameters": []
        },
        "ptp adaptive remote-server1-ip [ip-address]": {
            "template": "ptp adaptive remote-server1-ip [ip-address]",
            "command": "ptp adaptive remote-server1-ip 1.1.1.1",
            "explanation": "设置远程服务器 IP 地址为 1.1.1.1",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "远程服务器 IP 地址"
                }
            ]
        },
        "ptp adaptive dscp [dscp-value]": {
            "template": "ptp adaptive dscp [dscp-value]",
            "command": "ptp adaptive dscp 60",
            "explanation": "设置 DSCP 值为 60",
            "parameters": [
                {
                    "name": "dscp-value",
                    "type": "integer",
                    "explanation": "DSCP 值"
                }
            ]
        },
        "clock source ptp synchronization enable": {
            "template": "clock source ptp synchronization enable",
            "command": "clock source ptp synchronization enable",
            "explanation": "启用 PTP 同步时钟源",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口",
            "parameters": []
        },
        "ptp adaptive atr enable": {
            "template": "ptp adaptive atr enable",
            "command": "ptp adaptive atr enable",
            "explanation": "启用自适应 ATR",
            "parameters": []
        }
    }
}