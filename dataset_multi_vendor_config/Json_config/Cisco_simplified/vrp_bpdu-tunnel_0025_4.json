                "explanation": "VLAN ID"
            }
        ]
    },
    "spanning-tree extend system-id": {
        "template": "spanning-tree extend system-id",
        "command": "spanning-tree extend system-id",
        "explanation": "扩展系统ID用于生成唯一的桥ID",
        "parameters": []
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "设置生成树模式为快速PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树模式"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口设置为二层模式",
            "parameters": []
        },
        "switchport trunk encapsulation [parameter1]": {
            "template": "switchport trunk encapsulation [parameter1]",
            "command": "switchport trunk encapsulation dot1q",
            "explanation": "设置接口的封装类型为dot1q",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许VLAN 100通过该trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "启用PortFast特性，使接口立即进入转发状态",
            "parameters": []
        },
        "spanning-tree bpdufilter enable": {
            "template": "spanning-tree bpdufilter enable",
            "command": "spanning-tree bpdufilter enable",
            "explanation": "启用BPDU过滤，阻止接口发送或接收BPDU",
            "parameters": []
        }
    }
