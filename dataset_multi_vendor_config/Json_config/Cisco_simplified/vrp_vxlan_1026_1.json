{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device2",
        "explanation": "设置设备的主机名为 'Device2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建桥接域 10",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ],
        "vxlan vni [parameter1]": {
            "template": "vxlan vni [parameter1]",
            "command": "vxlan vni 5010",
            "explanation": "配置 VXLAN 网络标识符为 5010",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN 网络标识符"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif10",
        "explanation": "配置虚拟桥接接口 Vbdif10",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.10 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.10.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "source-interface [parameter1]": {
            "template": "source-interface [parameter1]",
            "command": "source-interface Loopback1",
            "explanation": "设置 NVE 接口的源接口为 Loopback1",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "member vni [parameter1] mcast-group [parameter2]": {
            "template": "member vni [parameter1] mcast-group [parameter2]",
            "command": "member vni 5010 mcast-group 225.0.0.1",
            "explanation": "配置 VNI 5010 的组播组为 225.0.0.1",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN 网络标识符"
                },
                {
                    "name": "mcast-group",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 3.3.3.3 0.0.0.0 area 0",
            "explanation": "将 3.3.3.3/32 网络加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF 区域"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}