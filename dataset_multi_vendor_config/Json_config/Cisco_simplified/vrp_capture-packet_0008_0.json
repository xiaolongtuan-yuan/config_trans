{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 2001",
        "explanation": "创建一个编号为2001的访问控制列表",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            }
        ],
        "rule [parameter1] permit source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit source [parameter2] [parameter3]",
            "command": "rule 5 permit source 10.1.1.1 0",
            "explanation": "在ACL 2001中添加一条规则，允许源IP为10.1.1.1的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "规则编号"
                },
                {
                    "name": "source IP",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPF区域0.0.0.0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络10.1.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式",
        "parameters": []
    },
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "access-list [parameter1] permit ip host [parameter2] any": {
        "template": "access-list [parameter1] permit ip host [parameter2] any",
        "command": "access-list 2001 permit ip host 10.1.1.1 any",
        "explanation": "在访问控制列表2001中添加一条规则，允许源IP为10.1.1.1的IP流量到任何目的地",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source IP",
                "type": "IPv4",
                "explanation": "源IP地址"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.1.0 0.0.0.255 area 0",
            "explanation": "在OSPF进程1中宣告网络10.1.1.0/24到区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF区域ID"
                }
            ]
        }
    }
}