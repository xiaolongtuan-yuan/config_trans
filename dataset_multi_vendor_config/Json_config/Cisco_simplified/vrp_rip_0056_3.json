{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "配置接口 'gigabitethernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router [parameter1]": {
        "template": "router [parameter1]",
        "command": "router rip",
        "explanation": "启用 RIP 路由协议",
        "parameters": [
            {
                "name": "routing protocol",
                "type": "string",
                "explanation": "路由协议"
            }
        ],
        "version [parameter1]": {
            "template": "version [parameter1]",
            "command": "version 2",
            "explanation": "设置 RIP 版本为 2",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "RIP 版本"
                }
            ]
        },
        "network [parameter1]": {
            "template": "network [parameter1]",
            "command": "network 172.16.0.0",
            "explanation": "在 RIP 中通告网络 172.16.0.0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                }
            ]
        }
    }
}