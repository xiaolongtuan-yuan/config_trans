        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8::1/32",
