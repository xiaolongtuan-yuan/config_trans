    "radius-server host [parameter1] auth-port [parameter2] acct-port [parameter3] key [parameter4]": {
        "template": "radius-server host [parameter1] auth-port [parameter2] acct-port [parameter3] key [parameter4]",
        "command": "radius-server host 192.168.7.249 auth-port 1645 acct-port 1646 key 7 %^%#vS%796FO7%C~pB%CR=q;j}gSCqR-X6+P!.DYI@)%^%",
        "explanation": "配置 RADIUS 服务器，指定服务器地址为 192.168.7.249，认证端口为 1645，计费端口为 1646，密钥为加密字符串",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "RADIUS 服务器地址"
            },
            {
                "name": "authentication port",
                "type": "integer",
                "explanation": "认证端口"
            },
            {
                "name": "accounting port",
                "type": "integer",
                "explanation": "计费端口"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "密钥"
            }
        ]
    },
