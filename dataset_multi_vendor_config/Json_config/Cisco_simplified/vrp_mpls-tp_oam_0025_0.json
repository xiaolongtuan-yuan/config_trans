{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRA",
        "explanation": "设置设备的主机名为 'LSRA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制使用 Loopback1 接口的 IP 地址作为 LDP 的 Router ID",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 2.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        },
        "mpls traffic-eng tunnels": {
            "template": "mpls traffic-eng tunnels",
            "command": "mpls traffic-eng tunnels",
            "explanation": "在接口上启用 MPLS 流量工程隧道",
            "parameters": []
        },
        "ip unnumbered [parameter1]": {
            "template": "ip unnumbered [parameter1]",
            "command": "ip unnumbered Loopback1",
            "explanation": "配置隧道接口使用 Loopback1 接口的 IP 地址",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "tunnel mode [parameter1]": {
            "template": "tunnel mode [parameter1]",
            "command": "tunnel mode mpls traffic-eng",
            "explanation": "配置隧道模式为 MPLS 流量工程",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 3.3.3.3",
            "explanation": "配置隧道的目的地址为 3.3.3.3",
            "parameters": [
                {
                    "name": "destination",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        },
        "tunnel mpls traffic-eng autoroute announce": {
            "template": "tunnel mpls traffic-eng autoroute announce",
            "command": "tunnel mpls traffic-eng autoroute announce",
            "explanation": "启用隧道的自动路由通告",
            "parameters": []
        },
        "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]": {
            "template": "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]",
            "command": "tunnel mpls traffic-eng path-option 10 explicit name Tunnel10",
            "explanation": "配置隧道的路径选项为显式路径，名称为 Tunnel10",
            "parameters": [
                {
                    "name": "path-option",
                    "type": "integer",
                    "explanation": "路径选项编号"
                },
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "路径名称"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 2.2.2.2 255.255.255.255 2.1.1.2",
        "explanation": "配置静态路由，目的地址为 2.2.2.2/32，下一跳为 2.1.1.2",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "mpls traffic-eng mpls-tp meg [parameter1]": {
        "template": "mpls traffic-eng mpls-tp meg [parameter1]",
        "command": "mpls traffic-eng mpls-tp meg test",
        "explanation": "配置 MPLS-TP 维护实体组（MEG）名称为 test",
        "parameters": [
            {
                "name": "meg name",
                "type": "string",
                "explanation": "维护实体组名称"
            }
        ],
        "mep interface [parameter1] mep-id [parameter2] remote-mep-id [parameter3]": {
            "template": "mep interface [parameter1] mep-id [parameter2] remote-mep-id [parameter3]",
            "command": "mep interface Tunnel10 mep-id 1 remote-mep-id 2",
            "explanation": "配置维护端点（MEP）在 Tunnel10 接口上，MEP ID 为 1，远端 MEP ID 为 2",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                },
                {
                    "name": "mep-id",
                    "type": "integer",
                    "explanation": "MEP ID"
                },
                {
                    "name": "remote-mep-id",
                    "type": "integer",
                    "explanation": "远端 MEP ID"
                }
            ]
        }
    }
}