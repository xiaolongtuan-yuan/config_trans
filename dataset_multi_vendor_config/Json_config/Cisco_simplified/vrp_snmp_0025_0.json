                "explanation": "主机IP地址"
            },
            {
                "name": "SNMP version",
                "type": "integer",
                "explanation": "SNMP版本"
            },
            {
                "name": "community string",
                "type": "string",
                "explanation": "社区字符串"
            }
        ]
    },
    "snmp-server user [parameter1] [parameter2] v3 auth [parameter3] [parameter4] priv [parameter5] [parameter6]": {
        "template": "snmp-server user [parameter1] [parameter2] v3 auth [parameter3] [parameter4] priv [parameter5] [parameter6]",
        "command": "snmp-server user nms2-admin admin v3 auth sha %#%##/L&Fd]S.!i*S7<\\jCh2DkfkE4+:<%Wap|8zZWwPL+[a>h$wy>VJsp9(L{%B%#%# priv aes 128 %#%#CM-]HDuhH6VX)**J<186nf({M823f(0Z73++7(A#%,1jODj}D>_HS>W,'Ss=%#%#",
