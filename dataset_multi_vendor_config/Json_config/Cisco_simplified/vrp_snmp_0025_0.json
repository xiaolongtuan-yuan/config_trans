{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "snmp-server enable traps": {
        "template": "snmp-server enable traps",
        "command": "snmp-server enable traps",
        "explanation": "启用SNMP陷阱",
        "parameters": []
    },
    "access-list [parameter1] permit ip host [parameter2] any": {
        "template": "access-list [parameter1] permit ip host [parameter2] any",
        "command": "access-list 2001 permit ip host 1.1.1.2 any",
        "explanation": "允许来自主机1.1.1.2的IP流量访问任何目的地",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source host",
                "type": "IPv4",
                "explanation": "源主机IP地址"
            }
        ]
    },
    "access-list [parameter1] deny ip host [parameter2] any": {
        "template": "access-list [parameter1] deny ip host [parameter2] any",
        "command": "access-list 2001 deny ip host 1.1.1.1 any",
        "explanation": "拒绝来自主机1.1.1.1的IP流量访问任何目的地",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source host",
                "type": "IPv4",
                "explanation": "源主机IP地址"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.2.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 1.1.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.2.0 0.0.0.255 area 0",
            "explanation": "将网络1.1.2.0/24加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "snmp-server community [parameter1] [parameter2]": {
        "template": "snmp-server community [parameter1] [parameter2]",
        "command": "snmp-server community nms2-admin RO",
        "explanation": "配置SNMP社区字符串为nms2-admin，权限为只读",
        "parameters": [
            {
                "name": "community string",
                "type": "string",
                "explanation": "社区字符串"
            },
            {
                "name": "permission",
                "type": "string",
                "explanation": "权限（RO表示只读）"
            }
        ]
    },
    "snmp-server location [parameter1]": {
        "template": "snmp-server location [parameter1]",
        "command": "snmp-server location Operator at 010-12345678",
