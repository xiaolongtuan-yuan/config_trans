{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Hub",
        "explanation": "设置设备的主机名为 'Hub'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source GigabitEthernet1/0/0",
            "explanation": "指定隧道的源接口为 'GigabitEthernet1/0/0'",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode gre multipoint",
            "explanation": "设置隧道模式为 GRE 多点",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "隧道类型"
                }
            ]
        },
        "tunnel key [parameter1]": {
            "template": "tunnel key [parameter1]",
            "command": "tunnel key 0",
            "explanation": "设置隧道密钥为 0",
            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "隧道密钥值"
                }
            ]
        },
        "ip nhrp network-id [parameter1]": {
            "template": "ip nhrp network-id [parameter1]",
            "command": "ip nhrp network-id 1",
            "explanation": "配置 NHRP 网络 ID 为 1",
            "parameters": [
                {
                    "name": "network-id",
                    "type": "integer",
                    "explanation": "NHRP 网络 ID"
                }
            ]
        },
        "ip nhrp nhs [parameter1] [parameter2]": {
            "template": "ip nhrp nhs [parameter1] [parameter2]",
            "command": "ip nhrp nhs 172.16.1.1 multicast",
            "explanation": "配置 NHRP 指定 NHS 为 172.16.1.1，多播",
            "parameters": [
                {
                    "name": "nhs address",
                    "type": "IPv4",
                    "explanation": "NHS 地址"
                },
                {
                    "name": "multicast",
                    "type": "string",
                    "explanation": "多播选项"
                }
            ]
        },
        "ip nhrp map multicast [parameter1]": {
            "template": "ip nhrp map multicast [parameter1]",
            "command": "ip nhrp map multicast dynamic",
            "explanation": "配置 NHRP 多播映射为动态",
            "parameters": [
                {
                    "name": "mapping type",
                    "type": "string",
                    "explanation": "映射类型"
                }
            ]
        },
        "ip nhrp redirect": {
            "template": "ip nhrp redirect",
            "command": "ip nhrp redirect",
            "explanation": "启用 NHRP 重定向",
            "parameters": []
        },
        "ip nhrp shortcut": {
            "template": "ip nhrp shortcut",
            "command": "ip nhrp shortcut",
            "explanation": "启用 NHRP 快捷方式",
            "parameters": []
        },
        "ip ospf network [parameter1]": {
            "template": "ip ospf network [parameter1]",
            "command": "ip ospf network point-to-multipoint",
            "explanation": "配置 OSPF 网络类型为点到多点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "OSPF 网络类型"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入 OSPF 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "设置 OSPF 路由器 ID 为 172.16.1.1",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0.0.0.0",
            "explanation": "将网络 172.16.1.0/24 归属于区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "IPv4",
                    "explanation": "OSPF 区域"
                }
            ]
        }
    }
}