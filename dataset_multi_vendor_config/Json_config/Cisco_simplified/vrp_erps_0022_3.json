{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10,100",
        "explanation": "创建 VLAN 10 和 VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "list",
                "explanation": "VLAN ID 列表"
            }
        ]
    },
    "spanning-tree vlan [parameter1] root primary": {
        "template": "spanning-tree vlan [parameter1] root primary",
        "command": "spanning-tree vlan 10,100 root primary",
        "explanation": "配置 VLAN 10 和 VLAN 100 的生成树根桥为主根",
        "parameters": [
            {
                "name": "vlan id",
                "type": "list",
                "explanation": "VLAN ID 列表"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10,100",
            "explanation": "配置 trunk 接口允许通过的 VLAN 为 10 和 100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "list",
                    "explanation": "VLAN ID 列表"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "spanning-tree portfast [parameter1]": {
            "template": "spanning-tree portfast [parameter1]",
            "command": "spanning-tree portfast trunk",
            "explanation": "在 trunk 接口上启用 PortFast 特性",
            "parameters": [
                {
                    "name": "port type",
                    "type": "string",
                    "explanation": "端口类型"
                }
            ]
        },
        "shutdown": {
            "template": "shutdown",
            "command": "shutdown",
            "explanation": "关闭接口",
            "parameters": []
        }
    }
}