{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "distribute-list prefix [parameter1] out [parameter2]": {
            "template": "distribute-list prefix [parameter1] out [parameter2]",
            "command": "distribute-list prefix a2b out gigabitethernet1/0/0",
            "explanation": "在接口 'GigabitEthernet1/0/0' 上应用前缀列表 'a2b' 来控制 OSPF 路由的分发",
            "parameters": [
                {
                    "name": "prefix list name",
                    "type": "string",
                    "explanation": "前缀列表名称"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "redistribute static subnets": {
            "template": "redistribute static subnets",
            "command": "redistribute static subnets",
            "explanation": "重分发静态路由到 OSPF 中，包括子网",
            "parameters": []
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.1.0 0.0.0.255 area 0",
            "explanation": "将网络 192.168.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "ip prefix-list [parameter1] seq [parameter2] permit [parameter3]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] permit [parameter3]",
        "command": "ip prefix-list a2b seq 10 permit 172.16.17.0/24",
        "explanation": "定义前缀列表 'a2b' 的序列号 10，允许 172.16.17.0/24 网络",
        "parameters": [
            {
                "name": "prefix list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            },
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            }
        ]
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 172.16.16.0 255.255.255.0 Null0",
        "explanation": "配置静态路由，将 172.16.16.0/24 网络指向 Null0 接口",
        "parameters": [
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳地址或接口"
            }
        ]
    }
}