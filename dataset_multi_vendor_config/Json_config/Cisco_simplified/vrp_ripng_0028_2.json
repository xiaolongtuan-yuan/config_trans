{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:2::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 rip [parameter1] enable": {
            "template": "ipv6 rip [parameter1] enable",
            "command": "ipv6 rip NAME enable",
            "explanation": "在接口上启用 IPv6 RIP 路由协议，实例名为 NAME",
            "parameters": [
                {
                    "name": "rip instance name",
                    "type": "string",
                    "explanation": "RIP 实例名"
                }
            ]
        }
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "ipv6 router rip [parameter1]": {
        "template": "ipv6 router rip [parameter1]",
        "command": "ipv6 router rip NAME",
        "explanation": "配置 IPv6 RIP 路由协议，实例名为 NAME",
        "parameters": [
            {
                "name": "rip instance name",
                "type": "string",
                "explanation": "RIP 实例名"
            }
        ],
        "network [parameter1]": {
            "template": "network [parameter1]",
            "command": "network 2001:db8:2::/64",
            "explanation": "将网络 2001:db8:2::/64 加入到 RIP 实例 NAME 中",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv6",
                    "explanation": "IPv6 网络地址"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}