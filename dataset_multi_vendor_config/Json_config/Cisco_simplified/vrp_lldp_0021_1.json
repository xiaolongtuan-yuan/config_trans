{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "lldp run": {
        "template": "lldp run",
        "command": "lldp run",
        "explanation": "启用 LLDP（链路层发现协议）",
        "parameters": []
    },
    "lldp timer [parameter1]": {
        "template": "lldp timer [parameter1]",
        "command": "lldp timer 60",
        "explanation": "设置 LLDP 的定时器为 60 秒",
        "parameters": [
            {
                "name": "timer value",
                "type": "integer",
                "explanation": "定时器值（秒）"
            }
        ]
    },
    "lldp holdtime [parameter1]": {
        "template": "lldp holdtime [parameter1]",
        "command": "lldp holdtime 9",
        "explanation": "设置 LLDP 的保持时间为 9 秒",
        "parameters": [
            {
                "name": "holdtime value",
                "type": "integer",
                "explanation": "保持时间值（秒）"
            }
        ]
    },
    "lldp tlv-select management restart [parameter1]": {
        "template": "lldp tlv-select management restart [parameter1]",
        "command": "lldp tlv-select management restart 3",
        "explanation": "设置 LLDP 管理地址 TLV 的重启时间为 3 秒",
        "parameters": [
            {
                "name": "restart time",
                "type": "integer",
                "explanation": "重启时间值（秒）"
            }
        ]
    },
    "lldp holdtime multiplier [parameter1]": {
        "template": "lldp holdtime multiplier [parameter1]",
        "command": "lldp holdtime multiplier 3",
        "explanation": "设置 LLDP 保持时间倍数为 3",
        "parameters": [
            {
                "name": "multiplier value",
                "type": "integer",
                "explanation": "保持时间倍数"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.10.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "lldp management-address [parameter1]": {
        "template": "lldp management-address [parameter1]",
        "command": "lldp management-address 10.10.10.2",
        "explanation": "设置 LLDP 管理地址为 10.10.10.2",
        "parameters": [
            {
                "name": "management address",
                "type": "IPv4",
                "explanation": "管理地址"
            }
        ]
    },
    "exit": {
        "template": "exit",
        "command": "exit",
        "explanation": "退出当前配置模式",
        "parameters": []
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置并返回到特权模式",
        "parameters": []
    }
}