{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname UPE",
        "explanation": "设置设备的主机名为 'UPE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置MPLS标签分发协议为LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls l2vpn": {
        "template": "mpls l2vpn",
        "command": "mpls l2vpn",
        "explanation": "启用MPLS L2VPN功能",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用MPLS LDP功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "xconnect [parameter1] [parameter2] encapsulation [parameter3]": {
            "template": "xconnect [parameter1] [parameter2] encapsulation [parameter3]",
            "command": "xconnect 10.10.10.1 1 encapsulation mpls",
            "explanation": "配置MPLS封装的点到点连接，目标地址为10.10.10.1，VC ID为1",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "对等体地址"
                },
                {
                    "name": "vc id",
                    "type": "integer",
                    "explanation": "虚拟电路ID"
                },
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.3，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP功能",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用MPLS LDP功能",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.10.10.2 0.0.0.0 area 0",
            "explanation": "将IP地址10.10.10.2/32加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    }
}