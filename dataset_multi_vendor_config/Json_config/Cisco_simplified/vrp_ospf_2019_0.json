{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 1.1.1.1",
            "explanation": "设置OSPF路由器的ID为1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.0.0 0.0.0.255 area 0",
            "explanation": "将192.168.0.0/24网络加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3] nssa no-summary": {
            "template": "network [parameter1] [parameter2] area [parameter3] nssa no-summary",
            "command": "network 192.168.3.0 0.0.0.255 area 1 nssa no-summary",
            "explanation": "将192.168.3.0/24网络加入到OSPF区域1，并配置为NSSA区域，不汇总",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                },
                {
                    "name": "nssa",
                    "type": "keyword",
                    "explanation": "配置为NSSA区域"
                },
                {
                    "name": "no-summary",
                    "type": "keyword",
                    "explanation": "不汇总"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}