{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 '10'",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域 '10'",
            "parameters": [
                {
                    "name": "bridge-domain id",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        },
        "source-interface [parameter1]": {
            "template": "source-interface [parameter1]",
            "command": "source-interface Loopback1",
            "explanation": "配置 NVE 接口的源接口为 'Loopback1'",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "member vni [parameter1]": {
            "template": "member vni [parameter1]",
            "command": "member vni 10",
            "explanation": "将 VNI '10' 关联到 NVE 接口",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN 网络标识符"
                }
            ]
        },
        "head-end [parameter1]": {
            "template": "head-end [parameter1]",
            "command": "head-end 1.1.1.2",
            "explanation": "配置 NVE 接口的头端地址为 1.1.1.2",
            "parameters": [
                {
                    "name": "head-end ip",
                    "type": "IPv4",
                    "explanation": "头端 IPv4 地址"
                }
            ]
        }
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "配置桥接域 '10'",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ],
        "vxlan vni [parameter1]": {
            "template": "vxlan vni [parameter1]",
            "command": "vxlan vni 10",
            "explanation": "配置 VXLAN 网络标识符为 '10'",
            "parameters": [
                {
                    "name": "vni",
                    "type": "integer",
                    "explanation": "VXLAN 网络标识符"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 1.1.1.2 255.255.255.255 192.168.1.2",
        "explanation": "配置静态路由，目的地址为 1.1.1.2/32，下一跳地址为 192.168.1.2",
        "parameters": [
            {
                "name": "destination ip",
                "type": "IPv4",
                "explanation": "目的 IPv4 地址"
            },
            {
                "name": "destination mask",
                "type": "IPv4",
                "explanation": "目的地址的子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    }
}