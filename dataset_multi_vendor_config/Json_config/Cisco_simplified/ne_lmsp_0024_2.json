{
    "router isis [process-id]": {
        "template": "router isis [process-id]",
        "command": "router isis 1",
        "explanation": "启动ISIS路由协议，并指定进程ID为1。",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "ISIS进程的唯一标识符。"
            }
        ]
    },
    "is-type [level]": {
        "template": "is-type [level]",
        "command": "is-type level-1",
        "explanation": "设置ISIS路由器的类型为Level-1，即仅参与区域内路由。",
        "parameters": [
            {
                "name": "level",
                "type": "string",
                "explanation": "ISIS的层次级别，可以是level-1或level-2。"
            }
        ]
    },
    "net [net-address]": {
        "template": "net [net-address]",
        "command": "net 49.0003.0033.0033.0033.00",
        "explanation": "配置ISIS的NET地址，用于标识路由器。",
        "parameters": [
            {
                "name": "net-address",
                "type": "string",
                "explanation": "ISIS的网络实体标题，用于唯一标识路由器。"
            }
        ]
    },
    "lsp-gen-interval [initial] [max] [steady-state]": {
        "template": "lsp-gen-interval [initial] [max] [steady-state]",
        "command": "lsp-gen-interval 1 1 50",
        "explanation": "设置链路状态PDU的生成间隔时间。",
        "parameters": [
            {
                "name": "initial",
                "type": "integer",
                "explanation": "初始LSP生成间隔时间（秒）。"
            },
            {
                "name": "max",
                "type": "integer",
                "explanation": "最大LSP生成间隔时间（秒）。"
            },
            {
                "name": "steady-state",
                "type": "integer",
                "explanation": "稳定状态下的LSP生成间隔时间（秒）。"
            }
        ]
    },
    "metric-style [style]": {
        "template": "metric-style [style]",
        "command": "metric-style wide-compatible",
        "explanation": "设置度量风格为宽兼容模式，支持TE流量工程。",
        "parameters": [
            {
                "name": "style",
                "type": "string",
                "explanation": "度量风格，可以是narrow、wide或wide-compatible。"
            }
        ]
    },
    "graceful-restart-timer": {
        "template": "graceful-restart-timer",
        "command": "graceful-restart-timer",
        "explanation": "启用ISIS的优雅重启功能，以减少路由中断。",
        "parameters": []
    },
    "traffic-eng [level]": {
        "template": "traffic-eng [level]",
        "command": "traffic-eng level-1-2",
        "explanation": "启用流量工程功能，并指定在Level-1和Level-2中使用。",
        "parameters": [
            {
                "name": "level",
                "type": "string",
                "explanation": "指定流量工程的层次级别，可以是level-1、level-2或level-1-2。"
            }
        ]
    },
    "interface [interface-id]": {
        "template": "interface [interface-id]",
        "command": "interface GigabitEthernet 2/0/2",
        "explanation": "进入GigabitEthernet 2/0/2接口的配置模式。",
        "parameters": [
            {
                "name": "interface-id",
                "type": "string",
                "explanation": "接口的标识符。"
            }
        ],
        "ip router isis [process-id]": {
            "template": "ip router isis [process-id]",
            "command": "ip router isis 1",
            "explanation": "将此接口加入到ISIS进程1中。",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "ISIS进程的标识符。"
                }
            ]
        },
        "ip address [address] [mask]": {
            "template": "ip address [address] [mask]",
            "command": "ip address 3.3.3.3 255.255.255.255",
            "explanation": "配置Loopback 0接口的IP地址为3.3.3.3，子网掩码为255.255.255.255。",
            "parameters": [
                {
                    "name": "address",
                    "type": "IPv4",
                    "explanation": "IP地址。"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "子网掩码。"
                }
            ]
        }
    }
}