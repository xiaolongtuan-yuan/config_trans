{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "强制设置 MPLS LDP 的路由器 ID 为 Loopback0 接口的 IP 地址",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls l2vpn": {
        "template": "mpls l2vpn",
        "command": "mpls l2vpn",
        "explanation": "启用 MPLS L2VPN 功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 功能",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP 功能",
            "parameters": []
        },
        "mpls ldp neighbor [parameter1] targeted": {
            "template": "mpls ldp neighbor [parameter1] targeted",
            "command": "mpls ldp neighbor 3.3.3.9 targeted",
            "explanation": "配置 MPLS LDP 目标邻居为 3.3.3.9",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect [parameter1] [parameter2] encapsulation mpls": {
            "template": "xconnect [parameter1] [parameter2] encapsulation mpls",
            "command": "xconnect 3.3.3.9 101 encapsulation mpls",
            "explanation": "配置 MPLS 封装类型的点到点连接，目标地址为 3.3.3.9，VC ID 为 101",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对等体的 IP 地址"
                },
                {
                    "name": "vc id",
                    "type": "integer",
                    "explanation": "虚拟电路 ID"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.1.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}