{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DHCP Server",
        "explanation": "设置设备的主机名为 'DHCP Server'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip dhcp pool [parameter1]": {
        "template": "ip dhcp pool [parameter1]",
        "command": "ip dhcp pool pool1",
        "explanation": "配置名为 'pool1' 的 DHCP 池",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "DHCP 池名称"
            }
        ],
        "network [parameter1] [parameter2]": {
            "template": "network [parameter1] [parameter2]",
            "command": "network 10.10.10.0 255.255.255.0",
            "explanation": "配置 DHCP 池的网络地址为 10.10.10.0，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "default-router [parameter1]": {
            "template": "default-router [parameter1]",
            "command": "default-router 10.10.10.1",
            "explanation": "配置 DHCP 池的默认网关为 10.10.10.1",
            "parameters": [
                {
                    "name": "default gateway",
                    "type": "IPv4",
                    "explanation": "默认网关"
                }
            ]
        },
        "dns-server [parameter1]": {
            "template": "dns-server [parameter1]",
            "command": "dns-server <DNS_SERVER_IP>",
            "explanation": "配置 DHCP 池的 DNS 服务器地址",
            "parameters": [
                {
                    "name": "DNS server IP",
                    "type": "IPv4",
                    "explanation": "DNS 服务器地址"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 100",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 100",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    }
}