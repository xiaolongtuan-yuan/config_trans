                {
                    "name": "maintenance domain",
                    "type": "string",
                    "explanation": "维护域名"
                }
            ]
        },
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "配置 CFM 的维护关联为 'ma3'",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ]
        },
        "mep [parameter1]": {
            "template": "mep [parameter1]",
            "command": "mep 3",
            "explanation": "配置 CFM 的维护端点（MEP）为 3",
            "parameters": [
                {
                    "name": "MEP ID",
                    "type": "integer",
                    "explanation": "维护端点标识符"
                }
            ]
        },
        "vlan [parameter1]": {
            "template": "vlan [parameter1]",
            "command": "vlan 200",
            "explanation": "配置 VLAN 为 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "mep [parameter1] ccm-send enable": {
            "template": "mep [parameter1] ccm-send enable",
            "command": "mep 3 ccm-send enable",
            "explanation": "启用 MEP 3 的连续性检查消息（CCM）发送功能",
            "parameters": [
                {
                    "name": "MEP ID",
                    "type": "integer",
                    "explanation": "维护端点标识符"
                }
            ]
        },
        "remote-mep [parameter1]": {
            "template": "remote-mep [parameter1]",
            "command": "remote-mep 4",
            "explanation": "配置远程维护端点（RMEP）为 4",
            "parameters": [
                {
                    "name": "RMEP ID",
                    "type": "integer",
                    "explanation": "远程维护端点标识符"
                }
            ]
        },
        "remote-mep [parameter1] ccm-receive enable": {
            "template": "remote-mep [parameter1] ccm-receive enable",
            "command": "remote-mep 4 ccm-receive enable",
            "explanation": "启用 RMEP 4 的连续性检查消息（CCM）接收功能",
            "parameters": [
                {
                    "name": "RMEP ID",
                    "type": "integer",
                    "explanation": "远程维护端点标识符"
                }
            ]
        },
        "test-id [parameter1] mep [parameter2] remote-mep [parameter3]": {
            "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
            "command": "test-id 1 mep 3 remote-mep 4",
            "explanation": "配置测试 ID 为 1，关联 MEP 3 和 RMEP 4",
