            "explanation": "配置接口的封装类型为 dot1Q，VLAN ID 为 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "cfm": {
            "template": "cfm",
            "command": "cfm",
