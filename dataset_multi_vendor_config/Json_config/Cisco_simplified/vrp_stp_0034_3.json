{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "设置生成树协议模式为快速PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "spanning-tree vlan [parameter1] priority [parameter2]": {
        "template": "spanning-tree vlan [parameter1] priority [parameter2]",
        "command": "spanning-tree vlan 1 priority 24576",
        "explanation": "设置VLAN 1的生成树优先级为24576",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "生成树优先级"
            }
        ]
    },
    "spanning-tree pathcost method [parameter1]": {
        "template": "spanning-tree pathcost method [parameter1]",
        "command": "spanning-tree pathcost method long",
        "explanation": "设置生成树路径成本计算方法为长",
        "parameters": [
            {
                "name": "method",
                "type": "string",
                "explanation": "路径成本计算方法"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "启用PortFast特性，使接口立即进入转发状态",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}