{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname C",
        "explanation": "设置设备的主机名为 'C'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.9",
            "explanation": "设置 OSPF 路由器的 ID 为 2.2.2.9",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        }
    },
    "mpls traffic-eng tunnels": {
        "template": "mpls traffic-eng tunnels",
        "command": "mpls traffic-eng tunnels",
        "explanation": "启用 MPLS 流量工程隧道功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 功能",
            "parameters": []
        },
        "mpls traffic-eng tunnels": {
            "template": "mpls traffic-eng tunnels",
            "command": "mpls traffic-eng tunnels",
            "explanation": "在接口上启用 MPLS 流量工程隧道功能",
            "parameters": []
        },
        "mpls traffic-eng bandwidth max-reservable-bandwidth [parameter1]": {
            "template": "mpls traffic-eng bandwidth max-reservable-bandwidth [parameter1]",
            "command": "mpls traffic-eng bandwidth max-reservable-bandwidth 5000",
            "explanation": "设置接口的最大可预留带宽为 5000 kbps",
            "parameters": [
                {
                    "name": "max reservable bandwidth",
                    "type": "integer",
                    "explanation": "最大可预留带宽"
                }
            ]
        },
        "mpls traffic-eng bandwidth bc0 [parameter1]": {
            "template": "mpls traffic-eng bandwidth bc0 [parameter1]",
            "command": "mpls traffic-eng bandwidth bc0 4000",
            "explanation": "设置接口的 BC0 带宽为 4000 kbps",
            "parameters": [
                {
                    "name": "bc0 bandwidth",
                    "type": "integer",
                    "explanation": "BC0 带宽"
                }
            ]
        }
