{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 multicast-routing": {
        "template": "ipv6 multicast-routing",
        "command": "ipv6 multicast-routing",
        "explanation": "启用IPv6组播路由功能",
        "parameters": []
    },
    "ipv6 access-list [parameter1]": {
        "template": "ipv6 access-list [parameter1]",
        "command": "ipv6 access-list 2000",
        "explanation": "创建或进入IPv6访问控制列表2000",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            }
        ],
        "permit ipv6 [parameter1] [parameter2]": {
            "template": "permit ipv6 [parameter1] [parameter2]",
            "command": "permit ipv6 any FF3E::1/64",
            "explanation": "允许所有IPv6流量到FF3E::1/64",
            "parameters": [
                {
                    "name": "source",
                    "type": "IPv6 address",
                    "explanation": "源地址"
                },
                {
                    "name": "destination",
                    "type": "IPv6 address",
                    "explanation": "目的地址"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:2::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:2::2/64",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6 address",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 pim sparse-mode": {
            "template": "ipv6 pim sparse-mode",
            "command": "ipv6 pim sparse-mode",
            "explanation": "在接口上启用IPv6 PIM稀疏模式",
            "parameters": []
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0.0.0.0",
            "explanation": "将接口加入到OSPF进程1的区域0.0.0.0",
            "parameters": [
                {
                    "name": "OSPF process ID",
                    "type": "integer",
                    "explanation": "OSPF进程ID"
                },
                {
                    "name": "OSPF area",
                    "type": "IPv4 address",
                    "explanation": "OSPF区域"
                }
            ]
        }
    },
    "ipv6 router ospf [parameter1]": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置OSPF进程1的路由器ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4 address",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置OSPF区域0.0.0.0",
            "parameters": [
                {
                    "name": "OSPF area",
                    "type": "IPv4 address",
                    "explanation": "OSPF区域"
                }
            ]
        }
    },
    "ipv6 pim rp-address [parameter1] group-list [parameter2]": {
        "template": "ipv6 pim rp-address [parameter1] group-list [parameter2]",
        "command": "ipv6 pim rp-address 2001:db8:3::2 group-list 2001",
        "explanation": "配置IPv6 PIM的RP地址为2001:db8:3::2，并指定组列表为2001",
        "parameters": [
            {
                "name": "RP address",
                "type": "IPv6 address",
                "explanation": "RP地址"
            },
            {
                "name": "group-list",
                "type": "integer",
                "explanation": "组列表编号"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}