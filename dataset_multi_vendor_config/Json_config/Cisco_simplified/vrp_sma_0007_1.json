{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname AER_B",
        "explanation": "设置设备的主机名为 'AER_B'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "ipv6 cef": {
        "template": "ipv6 cef",
        "command": "ipv6 cef",
        "explanation": "启用 IPv6 Cisco Express Forwarding",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]/[parameter2]": {
            "template": "ipv6 address [parameter1]/[parameter2]",
            "command": "ipv6 address 2001:db8:1::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1::2，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "ipv6 traffic-filter [parameter1] [parameter2]": {
            "template": "ipv6 traffic-filter [parameter1] [parameter2]",
            "command": "ipv6 traffic-filter egress in",
            "explanation": "在接口的出口方向应用 IPv6 流量过滤器",
            "parameters": [
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "流量方向"
                },
                {
                    "name": "filter name",
                    "type": "string",
                    "explanation": "过滤器名称"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "ipv6 route [parameter1]/[parameter2] [parameter3]": {
        "template": "ipv6 route [parameter1]/[parameter2] [parameter3]",
        "command": "ipv6 route 2001:db8:4::/64 2001:db8:1::1",
        "explanation": "配置 IPv6 静态路由，目标网络为 2001:db8:4::/64，下一跳地址为 2001:db8:1::1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv6",
                "explanation": "目标网络"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    }
}