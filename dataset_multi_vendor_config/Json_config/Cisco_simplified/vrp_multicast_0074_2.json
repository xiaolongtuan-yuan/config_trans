{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceF",
        "explanation": "设置设备的主机名为 'DeviceF'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "ip prefix-list [parameter1] seq [parameter2] permit [parameter3] ge [parameter4] le [parameter5]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] permit [parameter3] ge [parameter4] le [parameter5]",
        "command": "ip prefix-list list-c seq 10 permit 192.168.0.0/16 ge 16 le 32",
        "explanation": "创建一个名为 'list-c' 的前缀列表，序列号为 10，允许 192.168.0.0/16 网段，前缀长度大于等于 16，小于等于 32",
        "parameters": [
            {
                "name": "prefix-list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            },
            {
                "name": "network",
                "type": "IPv4 with mask",
                "explanation": "网络地址和掩码"
            },
            {
                "name": "greater than or equal to",
                "type": "integer",
                "explanation": "前缀长度大于等于"
            },
            {
                "name": "less than or equal to",
                "type": "integer",
                "explanation": "前缀长度小于等于"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.5.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.5.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用 PIM 稀疏模式",
            "parameters": []
        }
    },
    "ip pim rp-candidate [parameter1]": {
        "template": "ip pim rp-candidate [parameter1]",
        "command": "ip pim rp-candidate Loopback0",
        "explanation": "配置 Loopback0 接口作为 PIM 的 RP 候选",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ip pim bsr-candidate [parameter1]": {
        "template": "ip pim bsr-candidate [parameter1]",
        "command": "ip pim bsr-candidate Loopback0",
        "explanation": "配置 Loopback0 接口作为 PIM 的 BSR 候选",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入 OSPF 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0",
            "explanation": "配置 OSPF 区域 0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ],
            "network [parameter1] [parameter2] area [parameter3]": {
                "template": "network [parameter1] [parameter2] area [parameter3]",
                "command": "network 192.168.5.0 0.0.0.255 area 0",
                "explanation": "将 192.168.5.0/24 网段加入到 OSPF 区域 0",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4 with wildcard mask",
                        "explanation": "网络地址和通配符掩码"
                    },
                    {
                        "name": "area ID",
                        "type": "integer",
                        "explanation": "OSPF 区域 ID"
                    }
                ]
            }
        }
    },
    "ip msdp peer [parameter1] connect-interface [parameter2]": {
        "template": "ip msdp peer [parameter1] connect-interface [parameter2]",
        "command": "ip msdp peer 192.168.4.1 connect-interface GigabitEthernet1/0/0",
        "explanation": "配置 MSDP 对等体 192.168.4.1，连接接口为 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "peer IP address",
                "type": "IPv4",
                "explanation": "MSDP 对等体的 IP 地址"
            },
            {
                "name": "connect interface",
                "type": "string",
                "explanation": "连接接口名"
            }
        ]
    },
    "ip msdp static-rp-peer [parameter1] rp-policy [parameter2]": {
        "template": "ip msdp static-rp-peer [parameter1] rp-policy [parameter2]",
        "command": "ip msdp static-rp-peer 192.168.4.1 rp-policy list-c",
        "explanation": "配置静态 RP 对等体 192.168.4.1，使用 RP 策略 'list-c'",
        "parameters": [
            {
                "name": "peer IP address",
                "type": "IPv4",
                "explanation": "静态 RP 对等体的 IP 地址"
            },
            {
                "name": "rp-policy",
                "type": "string",
                "explanation": "RP 策略名称"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}