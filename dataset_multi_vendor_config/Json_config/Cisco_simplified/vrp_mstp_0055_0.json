{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "配置生成树协议模式为快速PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "spanning-tree instance [parameter1] vlan [parameter2]": {
        "template": "spanning-tree instance [parameter1] vlan [parameter2]",
        "command": "spanning-tree instance 1 vlan 1,10",
        "explanation": "配置生成树实例1，包含VLAN 1和10",
        "parameters": [
            {
                "name": "instance id",
                "type": "integer",
                "explanation": "生成树实例ID"
            },
            {
                "name": "vlan list",
                "type": "string",
                "explanation": "VLAN列表"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "配置桥接域10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口配置为二层交换端口",
            "parameters": []
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "启用PortFast特性，使接口立即进入转发状态",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1-20",
            "explanation": "配置子接口的802.1Q封装，VLAN ID范围1-20",
            "parameters": [
                {
                    "name": "vlan id range",
                    "type": "string",
                    "explanation": "VLAN ID范围"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}