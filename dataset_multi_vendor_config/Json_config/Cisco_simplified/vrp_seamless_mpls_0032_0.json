    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2.2.2.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 2.2.2.2，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 2.2.2.2 update-source Loopback1",
            "explanation": "配置 BGP 邻居 2.2.2.2 使用 Loopback1 接口作为更新源",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "更新源接口"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 1.1.1.1 mask 255.255.255.255",
                "explanation": "在 BGP 中宣告网络 1.1.1.1/32",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "网络掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2.2.2.2 activate",
                "explanation": "激活 BGP 邻居 2.2.2.2 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-policy [parameter2] export": {
                "template": "neighbor [parameter1] route-policy [parameter2] export",
                "command": "neighbor 2.2.2.2 route-policy policy1 export",
                "explanation": "为 BGP 邻居 2.2.2.2 配置出口路由策略 'policy1'",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    },
                    {
                        "name": "route policy",
                        "type": "string",
                        "explanation": "路由策略名称"
                    }
                ]
            },
            "neighbor [parameter1] send-label": {
                "template": "neighbor [parameter1] send-label",
                "command": "neighbor 2.2.2.2 send-label",
                "explanation": "为 BGP 邻居 2.2.2.2 启用标签发送功能",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程号为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.1.1 0.0.0.0 area 0",
            "explanation": "在 OSPF 中宣告网络 1.1.1.1/32，区域为 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map policy1 permit 10",
        "explanation": "配置路由策略 'policy1'，序列号为 10，动作为允许",
        "parameters": [
            {
                "name": "route map name",
                "type": "string",
                "explanation": "路由策略名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit/deny）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set mpls label": {
            "template": "set mpls label",
            "command": "set mpls label",
            "explanation": "设置 MPLS 标签",
            "parameters": []
        }
    }
