{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.3.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用稀疏模式的PIM",
            "parameters": []
        }
    },
    "ip pim rp-candidate [parameter1]": {
        "template": "ip pim rp-candidate [parameter1]",
        "command": "ip pim rp-candidate Loopback1",
        "explanation": "指定Loopback1接口作为PIM RP候选",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ip pim rp-address [parameter1]": {
        "template": "ip pim rp-address [parameter1]",
        "command": "ip pim rp-address Loopback10",
        "explanation": "指定Loopback10接口的IP地址作为PIM RP地址",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.110.2.0 0.0.0.255 area 0",
            "explanation": "将网络10.110.2.0/24加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ip msdp originator-id [parameter1]": {
        "template": "ip msdp originator-id [parameter1]",
        "command": "ip msdp originator-id Loopback0",
        "explanation": "指定Loopback0接口的IP地址作为MSDP源ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ip msdp peer [parameter1] connect-interface [parameter2]": {
        "template": "ip msdp peer [parameter1] connect-interface [parameter2]",
        "command": "ip msdp peer 1.1.1.1 connect-interface Loopback0",
        "explanation": "配置MSDP对等体1.1.1.1，并使用Loopback0接口进行连接",
        "parameters": [
            {
                "name": "peer address",
                "type": "IPv4",
                "explanation": "对等体IP地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "连接接口名"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}