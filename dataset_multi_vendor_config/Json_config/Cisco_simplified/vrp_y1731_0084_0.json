{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入 VLAN 2 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "mac bridge-domain [parameter1]": {
        "template": "mac bridge-domain [parameter1]",
        "command": "mac bridge-domain 2",
        "explanation": "创建或进入 MAC 桥接域 2 的配置模式",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ],
        "member [parameter1]": {
            "template": "member [parameter1]",
            "command": "member GigabitEthernet1/0/1",
            "explanation": "将接口 'GigabitEthernet1/0/1' 加入到桥接域",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        }
    },
    "cfm domain [parameter1] level [parameter2]": {
        "template": "cfm domain [parameter1] level [parameter2]",
        "command": "cfm domain default level 2",
        "explanation": "配置 CFM 域 'default' 的级别为 2",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "CFM 域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "CFM 级别"
            }
        ],
        "md [parameter1]": {
            "template": "md [parameter1]",
            "command": "md md1",
            "explanation": "配置维护域 'md1'",
            "parameters": [
                {
                    "name": "maintenance domain name",
                    "type": "string",
                    "explanation": "维护域名"
                }
            ],
            "ma [parameter1]": {
                "template": "ma [parameter1]",
                "command": "ma ma1",
                "explanation": "配置维护关联 'ma1'",
                "parameters": [
                    {
                        "name": "maintenance association name",
                        "type": "string",
                        "explanation": "维护关联名"
                    }
                ],
                "mep domain [parameter1]": {
                    "template": "mep domain [parameter1]",
                    "command": "mep domain 2",
                    "explanation": "配置维护端点域 2",
                    "parameters": [
                        {
                            "name": "domain id",
                            "type": "integer",
                            "explanation": "域 ID"
                        }
                    ],
                    "interface [parameter1]": {
                        "template": "interface [parameter1]",
                        "command": "interface GigabitEthernet1/0/1",
                        "explanation": "配置接口 'GigabitEthernet1/0/1' 的维护端点",
                        "parameters": [
                            {
                                "name": "interface name",
                                "type": "string",
                                "explanation": "接口名"
                            }
                        ],
                        "mep id [parameter1] mep-direction [parameter2]": {
                            "template": "mep id [parameter1] mep-direction [parameter2]",
                            "command": "mep id 2 mep-direction down",
                            "explanation": "配置维护端点 ID 为 2，方向为 down",
                            "parameters": [
                                {
                                    "name": "mep id",
                                    "type": "integer",
                                    "explanation": "维护端点 ID"
                                },
                                {
                                    "name": "direction",
                                    "type": "string",
                                    "explanation": "维护端点方向"
                                }
                            ]
                        },
                        "mep ccm-send mep-id [parameter1] interval [parameter2]": {
                            "template": "mep ccm-send mep-id [parameter1] interval [parameter2]",
                            "command": "mep ccm-send mep-id 2 interval 1",
                            "explanation": "配置维护端点 ID 为 2 的 CCM 发送间隔为 1",
                            "parameters": [
                                {
                                    "name": "mep id",
                                    "type": "integer",
                                    "explanation": "维护端点 ID"
                                },
                                {
                                    "name": "interval",
                                    "type": "integer",
                                    "explanation": "CCM 发送间隔"
                                }
                            ]
                        },
                        "mep ccm-receive mep-id [parameter1] enable": {
                            "template": "mep ccm-receive mep-id [parameter1] enable",
                            "command": "mep ccm-receive mep-id 1 enable",
                            "explanation": "启用维护端点 ID 为 1 的 CCM 接收",
                            "parameters": [
                                {
                                    "name": "mep id",
                                    "type": "integer",
                                    "explanation": "维护端点 ID"
                                }
                            ]
                        },
                        "remote-mep mep-id [parameter1]": {
                            "template": "remote-mep mep-id [parameter1]",
                            "command": "remote-mep mep-id 1",
                            "explanation": "配置远程维护端点 ID 为 1",
                            "parameters": [
                                {
                                    "name": "mep id",
                                    "type": "integer",
                                    "explanation": "远程维护端点 ID"
                                }
                            ],
                            "remote-mep ccm-receive mep-id [parameter1] enable": {
                                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                                "command": "remote-mep ccm-receive mep-id 1 enable",
                                "explanation": "启用远程维护端点 ID 为 1 的 CCM 接收",
                                "parameters": [
                                    {
                                        "name": "mep id",
                                        "type": "integer",
                                        "explanation": "远程维护端点 ID"
                                    }
                                ]
                            }
                        },
                        "loss-measurement single-ended receive test-id [parameter1]": {
                            "template": "loss-measurement single-ended receive test-id [parameter1]",
                            "command": "loss-measurement single-ended receive test-id 1",
                            "explanation": "配置单端接收丢失测量测试 ID 为 1",
                            "parameters": [
                                {
                                    "name": "test id",
                                    "type": "integer",
                                    "explanation": "测试 ID"
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
}