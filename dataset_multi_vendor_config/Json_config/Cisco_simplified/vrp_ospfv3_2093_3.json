{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 11",
        "explanation": "创建或进入 VLAN 11 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "name [parameter1]": {
            "template": "name [parameter1]",
            "command": "name VLAN11",
            "explanation": "为 VLAN 11 设置名称为 'VLAN11'",
            "parameters": [
                {
                    "name": "vlan name",
                    "type": "string",
                    "explanation": "VLAN 名称"
                }
            ]
        }
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "进入 OSPFv3 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置 OSPFv3 进程 1 的 Router ID 为 4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "default-information originate always": {
            "template": "default-information originate always",
            "command": "default-information originate always",
            "explanation": "总是向 OSPFv3 域内通告默认路由",
            "parameters": []
        },
        "area [parameter1] nssa": {
            "template": "area [parameter1] nssa",
            "command": "area 0.0.0.1 nssa",
            "explanation": "配置 OSPFv3 区域 0.0.0.1 为 NSSA（Not-So-Stubby Area）",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan11",
        "explanation": "进入 VLAN 11 的接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:5::1/64",
            "explanation": "为 VLAN 11 接口配置 IPv6 地址 2001:DB8:5::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospfv3 [parameter1] area [parameter2]": {
            "template": "ipv6 ospfv3 [parameter1] area [parameter2]",
            "command": "ipv6 ospfv3 1 area 0.0.0.1",
            "explanation": "在 VLAN 11 接口上启用 OSPFv3 进程 1，并将其分配到区域 0.0.0.1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode access": {
            "template": "switchport mode access",
            "command": "switchport mode access",
            "explanation": "将接口模式设置为访问模式",
            "parameters": []
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 13",
            "explanation": "将接口分配到 VLAN 13",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route 2001:DB8:6::1/128 Null0",
        "explanation": "配置一条静态 IPv6 路由，目的地址为 2001:DB8:6::1/128，下一跳为 Null0（黑洞路由）",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的 IPv6 地址"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳地址或接口"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}