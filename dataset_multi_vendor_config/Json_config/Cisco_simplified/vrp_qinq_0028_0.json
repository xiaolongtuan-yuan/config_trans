{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 10",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "arp broadcast enable": {
            "template": "arp broadcast enable",
            "command": "arp broadcast enable",
            "explanation": "启用 ARP 广播功能",
            "parameters": []
        },
        "standby [parameter1] ip [parameter2]": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 1 ip 10.1.1.111",
            "explanation": "配置 HSRP 组 1 的虚拟 IP 地址为 10.1.1.111",
            "parameters": [
                {
                    "name": "HSRP group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "virtual IP address",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "standby [parameter1] priority [parameter2]": {
            "template": "standby [parameter1] priority [parameter2]",
            "command": "standby 1 priority 120",
            "explanation": "配置 HSRP 组 1 的优先级为 120",
            "parameters": [
                {
                    "name": "HSRP group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "standby [parameter1] preempt delay minimum [parameter2]": {
            "template": "standby [parameter1] preempt delay minimum [parameter2]",
            "command": "standby 1 preempt delay minimum 20",
            "explanation": "配置 HSRP 组 1 的抢占延迟最小为 20 秒",
            "parameters": [
                {
                    "name": "HSRP group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "minimum delay",
                    "type": "integer",
                    "explanation": "最小延迟时间"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.1.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    }
}