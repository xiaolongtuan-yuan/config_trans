            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IP 地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
