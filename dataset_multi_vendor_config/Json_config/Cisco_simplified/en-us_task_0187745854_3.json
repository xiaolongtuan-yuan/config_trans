            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "BGP 邻居 IP 地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "更新源接口"
                }
