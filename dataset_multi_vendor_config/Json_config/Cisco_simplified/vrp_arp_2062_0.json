{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device A",
        "explanation": "设置设备的主机名为 'Device A'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route 0.0.0.0 0.0.0.0 GigabitEthernet2/0/0 172.17.3.2",
        "explanation": "配置静态路由，将所有流量（0.0.0.0/0）通过接口 GigabitEthernet2/0/0 发送到下一跳地址 172.17.3.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目标网络地址"
            },
            {
                "name": "destination subnet mask",
                "type": "IPv4",
                "explanation": "目标网络子网掩码"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip proxy-arp": {
            "template": "ip proxy-arp",
            "command": "ip proxy-arp",
            "explanation": "启用接口的代理ARP功能",
            "parameters": []
        }
    }
}