{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 2.2.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.0 0.0.0.255 area 0",
            "explanation": "将网络 2.2.2.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]",
        "command": "ntp authentication-key 42 md5 7 1234567890ABCDEF",
        "explanation": "配置 NTP 认证密钥，ID 为 42，使用 MD5 加密，密钥为 1234567890ABCDEF",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            },
            {
                "name": "encryption type",
                "type": "string",
                "explanation": "加密类型"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "密钥"
            }
        ]
    },
    "ntp authenticate": {
        "template": "ntp authenticate",
        "command": "ntp authenticate",
        "explanation": "启用 NTP 认证",
        "parameters": []
    },
    "ntp trusted-key [parameter1]": {
        "template": "ntp trusted-key [parameter1]",
        "command": "ntp trusted-key 42",
        "explanation": "信任 NTP 认证密钥 ID 42",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            }
        ]
    },
    "ntp master [parameter1]": {
        "template": "ntp master [parameter1]",
        "command": "ntp master 2",
        "explanation": "配置设备为 NTP 主时钟，层级为 2",
        "parameters": [
            {
                "name": "stratum",
                "type": "integer",
                "explanation": "层级"
            }
        ]
    },
    "access-list [parameter1] permit ip host [parameter2] any": {
        "template": "access-list [parameter1] permit ip host [parameter2] any",
        "command": "access-list 2000 permit ip host 10.0.0.1 any",
        "explanation": "配置访问控制列表 2000，允许来自主机 10.0.0.1 的任何 IP 流量",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source host",
                "type": "IPv4",
                "explanation": "源主机地址"
            }
        ]
    },
    "ntp access-group [parameter1] [parameter2]": {
        "template": "ntp access-group [parameter1] [parameter2]",
        "command": "ntp access-group 2000 limited",
        "explanation": "应用访问控制列表 2000 到 NTP，限制访问",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "access type",
                "type": "string",
                "explanation": "访问类型"
            }
        ]
    },
    "ntp minpoll [parameter1] maxpoll [parameter2]": {
        "template": "ntp minpoll [parameter1] maxpoll [parameter2]",
        "command": "ntp minpoll 4 maxpoll 4",
        "explanation": "配置 NTP 最小和最大轮询间隔为 4",
        "parameters": [
            {
                "name": "minpoll",
                "type": "integer",
                "explanation": "最小轮询间隔"
            },
            {
                "name": "maxpoll",
                "type": "integer",
                "explanation": "最大轮询间隔"
            }
        ]
    },
    "ntp server [parameter1] source": {
        "template": "ntp server [parameter1] source",
        "command": "ntp server gigabitethernet 1/0/0 source",
        "explanation": "配置 NTP 服务器，使用接口 GigabitEthernet1/0/0 作为源",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ntp authenticate-ntp-kod": {
        "template": "ntp authenticate-ntp-kod",
        "command": "ntp authenticate-ntp-kod",
        "explanation": "启用 NTP 认证和 KoD（Kiss-o'-Death）功能",
        "parameters": []
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}