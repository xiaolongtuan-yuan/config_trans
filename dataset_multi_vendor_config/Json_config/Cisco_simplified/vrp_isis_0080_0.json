{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入IS-IS路由配置模式",
        "parameters": [],
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-2-only",
            "explanation": "设置IS-IS路由类型为仅Level-2",
            "parameters": [
                {
                    "name": "IS-IS type",
                    "type": "string",
                    "explanation": "IS-IS路由类型"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.1111.1111.1111.00",
            "explanation": "设置IS-IS的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "isis circuit-type [parameter1]": {
            "template": "isis circuit-type [parameter1]",
            "command": "isis circuit-type level-2-only",
            "explanation": "设置IS-IS电路类型为仅Level-2",
            "parameters": [
                {
                    "name": "circuit type",
                    "type": "string",
                    "explanation": "电路类型"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "设置IS-IS网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        },
        "isis cost [parameter1]": {
            "template": "isis cost [parameter1]",
            "command": "isis cost 5",
            "explanation": "设置IS-IS接口的cost值为5",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "接口的cost值"
                }
            ]
        },
        "isis process-id [parameter1]": {
            "template": "isis process-id [parameter1]",
            "command": "isis process-id 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS进程ID"
                }
            ]
        }
    }
