{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode pvst",
        "explanation": "设置生成树模式为 PVST（Per-VLAN Spanning Tree）",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树模式"
            }
        ]
    },
    "spanning-tree vlan [parameter1] pathcost method [parameter2]": {
        "template": "spanning-tree vlan [parameter1] pathcost method [parameter2]",
        "command": "spanning-tree vlan 1-20 pathcost method long",
        "explanation": "为 VLAN 1-20 设置生成树路径成本计算方法为 'long'",
        "parameters": [
            {
                "name": "vlan range",
                "type": "string",
                "explanation": "VLAN 范围"
            },
            {
                "name": "pathcost method",
                "type": "string",
                "explanation": "路径成本计算方法"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥接域 10 的配置模式",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口配置为二层交换端口",
            "parameters": []
        },
        "spanning-tree disable": {
            "template": "spanning-tree disable",
            "command": "spanning-tree disable",
            "explanation": "在接口上禁用生成树协议",
            "parameters": []
        },
        "spanning-tree portfast": {
            "template": "spanning-tree portfast",
            "command": "spanning-tree portfast",
            "explanation": "在接口上启用 PortFast 特性，使接口立即进入转发状态",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1-20",
            "explanation": "为子接口配置 802.1Q 封装，并指定 VLAN 范围为 1-20",
            "parameters": [
                {
                    "name": "vlan range",
                    "type": "string",
                    "explanation": "VLAN 范围"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域 10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}