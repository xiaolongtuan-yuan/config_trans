{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 multicast-routing": {
        "template": "ipv6 multicast-routing",
        "command": "ipv6 multicast-routing",
        "explanation": "启用IPv6组播路由",
        "parameters": []
    },
    "ipv6 access-list [parameter1]": {
        "template": "ipv6 access-list [parameter1]",
        "command": "ipv6 access-list 2000",
        "explanation": "创建或进入IPv6访问控制列表2000",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            }
        ],
        "permit ipv6 [parameter1] [parameter2]": {
            "template": "permit ipv6 [parameter1] [parameter2]",
            "command": "permit ipv6 2001:db8:5::5/64 any",
            "explanation": "允许来自2001:db8:5::5/64网络的IPv6流量到任何目的地",
            "parameters": [
                {
                    "name": "source network",
                    "type": "IPv6",
                    "explanation": "源网络地址"
                },
                {
                    "name": "destination",
                    "type": "keyword",
                    "explanation": "目的地，'any'表示任何地址"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:1::2/64",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 pim sparse-mode": {
            "template": "ipv6 pim sparse-mode",
            "command": "ipv6 pim sparse-mode",
            "explanation": "在接口上启用IPv6 PIM稀疏模式",
            "parameters": []
        },
        "ipv6 ospfv3 [parameter1] area [parameter2]": {
            "template": "ipv6 ospfv3 [parameter1] area [parameter2]",
            "command": "ipv6 ospfv3 1 area 0.0.0.0",
            "explanation": "在接口上启用IPv6 OSPFv3进程1，并指定区域0.0.0.0",
            "parameters": [
                {
                    "name": "OSPF process ID",
                    "type": "integer",
                    "explanation": "OSPF进程ID"
                },
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        },
        "ipv6 mld join-group [parameter1]": {
            "template": "ipv6 mld join-group [parameter1]",
            "command": "ipv6 mld join-group FF02::1",
            "explanation": "在接口上加入IPv6 MLD组FF02::1",
            "parameters": [
                {
                    "name": "MLD group address",
                    "type": "IPv6",
                    "explanation": "MLD组地址"
                }
            ]
        }
    },
    "ipv6 router ospf [parameter1]": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "配置IPv6 OSPF进程1",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置OSPF路由器的ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "指定区域0.0.0.0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ipv6 pim bsr candidate-policy [parameter1]": {
        "template": "ipv6 pim bsr candidate-policy [parameter1]",
        "command": "ipv6 pim bsr candidate-policy 2001",
        "explanation": "配置IPv6 PIM BSR候选策略为2001",
        "parameters": [
            {
                "name": "policy number",
                "type": "integer",
                "explanation": "策略编号"
            }
        ]
    },
    "ipv6 pim rp-address [parameter1]": {
        "template": "ipv6 pim rp-address [parameter1]",
        "command": "ipv6 pim rp-address 2001:db8:3::2",
        "explanation": "配置IPv6 PIM RP地址为2001:db8:3::2",
        "parameters": [
            {
                "name": "RP address",
                "type": "IPv6",
                "explanation": "RP地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}