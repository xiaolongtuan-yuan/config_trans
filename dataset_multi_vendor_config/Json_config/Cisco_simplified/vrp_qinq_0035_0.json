{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DHCP-Relay",
        "explanation": "设置设备的主机名为 'DHCP-Relay'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip dhcp relay information option": {
        "template": "ip dhcp relay information option",
        "command": "ip dhcp relay information option",
        "explanation": "启用 DHCP 中继信息选项",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 100",
            "explanation": "配置子接口的 802.1Q 封装，VLAN ID 为 100",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip helper-address [parameter1]": {
            "template": "ip helper-address [parameter1]",
            "command": "ip helper-address 192.168.3.1",
            "explanation": "配置 DHCP 中继代理，将 DHCP 请求转发到 192.168.3.1",
            "parameters": [
                {
                    "name": "DHCP server address",
                    "type": "IPv4",
                    "explanation": "DHCP 服务器地址"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}