{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 100",
        "explanation": "批量创建 VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ip dhcp pool [parameter1]": {
        "template": "ip dhcp pool [parameter1]",
        "command": "ip dhcp pool pool1",
        "explanation": "创建名为 'pool1' 的 DHCP 地址池",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "DHCP 地址池名称"
            }
        ],
        "network [parameter1] [parameter2]": {
            "template": "network [parameter1] [parameter2]",
            "command": "network 10.10.10.0 255.255.255.0",
            "explanation": "配置 DHCP 地址池的网络地址为 10.10.10.0，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "default-router [parameter1]": {
            "template": "default-router [parameter1]",
            "command": "default-router 10.10.10.1",
            "explanation": "配置 DHCP 地址池的默认网关为 10.10.10.1",
            "parameters": [
                {
                    "name": "default gateway",
                    "type": "IPv4",
                    "explanation": "默认网关"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan100",
        "explanation": "配置 VLAN 100 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.2 255.255.255.0",
            "explanation": "配置 VLAN 100 接口的 IPv4 地址为 10.10.10.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "standby [parameter1] ip [parameter2]": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 1 ip 10.10.10.100",
            "explanation": "配置 HSRP 组 1 的虚拟 IP 地址为 10.10.10.100",
            "parameters": [
                {
                    "name": "hsrp group",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "standby [parameter1] preempt": {
            "template": "standby [parameter1] preempt",
            "command": "standby 1 preempt",
            "explanation": "启用 HSRP 组 1 的抢占模式",
            "parameters": [
                {
                    "name": "hsrp group",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口为 trunk 模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "配置 trunk 接口允许通过的 VLAN 为 100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}