{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:9:2::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:9:2::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址及前缀长度"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65009",
        "explanation": "配置 BGP 路由进程，AS 号为 65009",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 3.3.3.3",
            "explanation": "配置 BGP 路由器的 ID 为 3.3.3.3",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "BGP 路由器的 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:db8:9:2::2 remote-as 65009",
            "explanation": "配置 BGP 邻居，邻居的 IPv6 地址为 2001:db8:9:2::2，AS 号为 65009",
            "parameters": [
                {
                    "name": "neighbor address",
                    "type": "IPv6",
                    "explanation": "邻居的 IPv6 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        },
        "address-family ipv6 unicast": {
            "template": "address-family ipv6 unicast",
            "command": "address-family ipv6 unicast",
            "explanation": "进入 IPv6 单播地址族配置模式",
            "parameters": [],
            "network [parameter1]": {
                "template": "network [parameter1]",
                "command": "network 2001:db8:9:2::/64",
                "explanation": "在 BGP 中宣告网络 2001:db8:9:2::/64",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv6",
                        "explanation": "要宣告的网络地址及前缀长度"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:db8:9:2::2 activate",
                "explanation": "激活邻居 2001:db8:9:2::2 的 IPv6 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor address",
                        "type": "IPv6",
                        "explanation": "邻居的 IPv6 地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        }
    }
}