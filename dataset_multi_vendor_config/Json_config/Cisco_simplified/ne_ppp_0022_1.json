{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "配置接口 'Lmpif1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation [parameter1]": {
            "template": "encapsulation [parameter1]",
            "command": "encapsulation ppp",
            "explanation": "设置接口的封装类型为 PPP",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型，这里是 PPP"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.110.0.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ppp authentication [parameter1]": {
            "template": "ppp authentication [parameter1]",
            "command": "ppp authentication pap",
            "explanation": "配置 PPP 认证方式为 PAP",
            "parameters": [
                {
                    "name": "authentication type",
                    "type": "string",
                    "explanation": "认证类型，这里是 PAP"
                }
            ]
        },
        "ppp pap sent-username [parameter1] password [parameter2] [parameter3]": {
            "template": "ppp pap sent-username [parameter1] password [parameter2] [parameter3]",
            "command": "ppp pap sent-username rtb password 0 <password>",
            "explanation": "配置 PPP PAP 的发送用户名和密码",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "发送的用户名"
                },
                {
                    "name": "password type",
                    "type": "integer",
                    "explanation": "密码类型，0 表示明文"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "密码"
                }
            ]
        }
    }
}