{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用 BFD（双向转发检测）功能",
        "parameters": []
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 4.4.4.4",
        "explanation": "配置 MPLS 的 LSR ID 为 4.4.4.4",
        "parameters": [
            {
                "name": "LSR ID",
                "type": "IPv4",
                "explanation": "MPLS 的 LSR ID"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.5.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.5.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0",
            "explanation": "配置 OSPF 区域 0",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ],
            "network [parameter1] [parameter2] area [parameter3]": {
                "template": "network [parameter1] [parameter2] area [parameter3]",
                "command": "network 10.1.5.0 0.0.0.255 area 0",
                "explanation": "将网络 10.1.5.0/24 加入到 OSPF 区域 0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "通配符掩码"
                    },
                    {
                        "name": "area ID",
                        "type": "integer",
                        "explanation": "OSPF 区域 ID"
                    }
                ]
            }
        }
    },
    "bfd all-interfaces bind peer-ip [parameter1]": {
        "template": "bfd all-interfaces bind peer-ip [parameter1]",
        "command": "bfd all-interfaces bind peer-ip 1.1.1.1",
        "explanation": "在所有接口上绑定 BFD 会话，对端 IP 地址为 1.1.1.1",
        "parameters": [
            {
                "name": "peer IP",
                "type": "IPv4",
                "explanation": "对端 IP 地址"
            }
        ],
        "bfd discriminator local [parameter1]": {
            "template": "bfd discriminator local [parameter1]",
            "command": "bfd discriminator local 2",
            "explanation": "配置本地 BFD 会话的标识符为 2",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地 BFD 会话标识符"
                }
            ]
        },
        "bfd discriminator remote [parameter1]": {
            "template": "bfd discriminator remote [parameter1]",
            "command": "bfd discriminator remote 1",
            "explanation": "配置远端 BFD 会话的标识符为 1",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端 BFD 会话标识符"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}