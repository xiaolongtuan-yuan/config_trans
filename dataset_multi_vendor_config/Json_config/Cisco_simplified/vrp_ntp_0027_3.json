{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "no ntp server disable": {
        "template": "no ntp server disable",
        "command": "no ntp server disable",
        "explanation": "启用 NTP 服务器功能",
        "parameters": []
    },
    "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2] [parameter3]",
        "command": "ntp authentication-key 42 md5 7 132143243B2E3F4E3C463A2D3E4F5G6",
        "explanation": "配置 NTP 认证密钥，密钥 ID 为 42，使用 MD5 加密，加密类型为 7，密钥为 132143243B2E3F4E3C463A2D3E4F5G6",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            },
            {
                "name": "encryption type",
                "type": "integer",
                "explanation": "加密类型"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "密钥"
            }
        ]
    },
    "ntp trusted-key [parameter1]": {
        "template": "ntp trusted-key [parameter1]",
        "command": "ntp trusted-key 42",
        "explanation": "配置信任的 NTP 密钥 ID 为 42",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            }
        ]
    },
    "ntp server [parameter1] key [parameter2]": {
        "template": "ntp server [parameter1] key [parameter2]",
        "command": "ntp server 10.0.0.1 key 42",
        "explanation": "配置 NTP 服务器地址为 10.0.0.1，使用密钥 ID 42 进行认证",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP 服务器地址"
            },
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            }
        ]
    },
    "ntp authenticate": {
        "template": "ntp authenticate",
        "command": "ntp authenticate",
        "explanation": "启用 NTP 认证",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.3 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.0.3，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "end": {
