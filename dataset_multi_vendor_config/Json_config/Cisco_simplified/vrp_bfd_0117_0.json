{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel1",
        "explanation": "配置接口 'Port-channel1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 1 mode on",
            "explanation": "将接口加入到通道组1，并设置为on模式",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式"
                }
            ]
        }
    },
    "bfd all-interfaces": {
        "template": "bfd all-interfaces",
        "command": "bfd all-interfaces",
        "explanation": "在所有接口上启用BFD（双向转发检测）",
        "parameters": [],
        "min-tx-interval [parameter1]": {
            "template": "min-tx-interval [parameter1]",
            "command": "min-tx-interval 10",
            "explanation": "设置BFD的最小传输间隔为10毫秒",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "间隔时间，单位毫秒"
                }
            ]
        },
        "min-rx-interval [parameter1]": {
            "template": "min-rx-interval [parameter1]",
            "command": "min-rx-interval 10",
            "explanation": "设置BFD的最小接收间隔为10毫秒",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "间隔时间，单位毫秒"
                }
            ]
        }
    },
    "bfd all-interfaces destination [parameter1] source [parameter2]": {
        "template": "bfd all-interfaces destination [parameter1] source [parameter2]",
        "command": "bfd all-interfaces destination 10.1.1.2 source 10.1.1.1",
        "explanation": "在所有接口上配置BFD的目的地址为10.1.1.2，源地址为10.1.1.1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的IPv4地址"
            },
            {
                "name": "source address",
                "type": "IPv4",
                "explanation": "源IPv4地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}