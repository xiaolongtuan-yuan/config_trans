{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "username [parameter1] password [parameter2]": {
        "template": "username [parameter1] password [parameter2]",
        "command": "username huawei123 password $1c$%L%X:Jn3hY$5^%T5I\\4HG>j|i~s,{.@FpH*2XGM\\R;7#$\\\"i!L0$",
        "explanation": "创建用户名为 'huawei123' 的用户，并设置密码",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "启用 AAA 新模型",
        "parameters": []
    },
    "aaa authorization exec [parameter1] [parameter2]": {
        "template": "aaa authorization exec [parameter1] [parameter2]",
        "command": "aaa authorization exec default local",
        "explanation": "配置 AAA 授权，使用本地数据库进行 exec 授权",
        "parameters": [
            {
                "name": "exec",
                "type": "string",
                "explanation": "exec 授权"
            },
            {
                "name": "default",
                "type": "string",
                "explanation": "默认授权方法"
            },
            {
                "name": "local",
                "type": "string",
                "explanation": "使用本地数据库"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:4::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:4::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route 2001:db8:3::/64 GigabitEthernet1/0/1 2001:db8:4::2",
        "explanation": "配置 IPv6 静态路由，目的网络为 2001:db8:3::/64，出接口为 GigabitEthernet1/0/1，下一跳地址为 2001:db8:4::2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv6",
                "explanation": "目的网络"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "出接口"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ]
    },
    "grpc": {
        "template": "grpc",
        "command": "grpc",
        "explanation": "启用 gRPC 服务",
        "parameters": []
    },
    "grpc server ipv6": {
        "template": "grpc server ipv6",
        "command": "grpc server ipv6",
        "explanation": "配置 gRPC 服务使用 IPv6",
        "parameters": [],
        "source-ip [parameter1]": {
            "template": "source-ip [parameter1]",
            "command": "source-ip 2001:db8:4::1",
            "explanation": "配置 gRPC 服务的源 IPv6 地址为 2001:db8:4::1",
            "parameters": [
                {
                    "name": "source ip",
                    "type": "IPv6",
                    "explanation": "源 IPv6 地址"
                }
            ]
        },
        "server-port [parameter1]": {
            "template": "server-port [parameter1]",
            "command": "server-port 20000",
            "explanation": "配置 gRPC 服务的监听端口为 20000",
            "parameters": [
                {
                    "name": "server port",
                    "type": "integer",
                    "explanation": "监听端口"
                }
            ]
        },
        "server enable": {
            "template": "server enable",
            "command": "server enable",
            "explanation": "启用 gRPC 服务",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
