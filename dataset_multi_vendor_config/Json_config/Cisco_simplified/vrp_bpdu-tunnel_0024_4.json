{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建 VLAN 100",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "spanning-tree mode [parameter1]": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "配置生成树协议模式为快速 PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为交换端口",
            "parameters": []
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 200",
            "explanation": "将接口配置为访问模式，并分配到 VLAN 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        },
        "spanning-tree bpdufilter [parameter1]": {
            "template": "spanning-tree bpdufilter [parameter1]",
            "command": "spanning-tree bpdufilter enable",
            "explanation": "启用 BPDU 过滤",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "BPDU 过滤状态"
                }
            ]
        },
        "spanning-tree portfast [parameter1]": {
            "template": "spanning-tree portfast [parameter1]",
            "command": "spanning-tree portfast disable",
            "explanation": "禁用 PortFast 功能",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "PortFast 状态"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100,200",
            "explanation": "配置接口为 trunk 模式，并允许 VLAN 100 和 200 通过",
            "parameters": [
                {
                    "name": "VLAN list",
                    "type": "string",
                    "explanation": "允许通过的 VLAN 列表"
                }
            ]
        }
    }
}