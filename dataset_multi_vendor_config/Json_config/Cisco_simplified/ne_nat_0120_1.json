        "parameters": [
            {
                "name": "instance name",
                "type": "string",
                "explanation": "实例名称"
            }
        ],
        "nat static-mapping [parameter1]": {
            "template": "nat static-mapping [parameter1]",
            "command": "nat static-mapping 10",
