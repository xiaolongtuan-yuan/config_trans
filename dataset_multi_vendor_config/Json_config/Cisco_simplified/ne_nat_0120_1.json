            "parameters": [
                {
                    "name": "static mapping id",
                    "type": "integer",
                    "explanation": "静态映射ID"
                }
            ]
        },
        "service-instance-group [parameter1]": {
            "template": "service-instance-group [parameter1]",
            "command": "service-instance-group groupa",
