        "explanation": "设置设备的主机名为 'CGNA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip nat translation max-entries [parameter1]": {
        "template": "ip nat translation max-entries [parameter1]",
        "command": "ip nat translation max-entries 6",
        "explanation": "设置NAT转换表的最大条目数为6",
        "parameters": [
            {
                "name": "max entries",
                "type": "integer",
                "explanation": "最大条目数"
            }
        ]
    },
    "ip nat inside source static network [parameter1] [parameter2] [parameter3]": {
        "template": "ip nat inside source static network [parameter1] [parameter2] [parameter3]",
        "command": "ip nat inside source static network 192.168.10.128 255.255.255.128 11.11.11.101",
        "explanation": "配置NAT内部源地址静态映射，将网络192.168.10.128/25映射到外部地址11.11.11.101",
        "parameters": [
            {
                "name": "inside network",
                "type": "IPv4",
                "explanation": "内部网络地址"
            },
            {
                "name": "inside network mask",
                "type": "IPv4",
                "explanation": "内部网络掩码"
            },
            {
                "name": "outside address",
                "type": "IPv4",
                "explanation": "外部地址"
            }
        ]
    },
    "ip nat service instance-group [parameter1]": {
        "template": "ip nat service instance-group [parameter1]",
        "command": "ip nat service instance-group groupa",
        "explanation": "配置NAT服务实例组为'groupa'",
        "parameters": [
