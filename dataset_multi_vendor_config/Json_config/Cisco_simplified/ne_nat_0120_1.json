    "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]": {
        "template": "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]",
        "command": "access-list 3001 permit ip 192.168.10.0 0.0.0.255 any",
        "explanation": "配置访问控制列表3001，允许来自192.168.10.0/24网络的IP流量到任何目的地",
        "parameters": [
            {
                "name": "access list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source network",
                "type": "IPv4",
                "explanation": "源网络地址"
            },
            {
                "name": "source wildcard",
                "type": "IPv4",
                "explanation": "源网络通配符"
            },
            {
                "name": "destination",
                "type": "string",
                "explanation": "目的地"
            }
        ]
    },
