{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:101:101::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:101:101::1/64",
            "parameters": [
                {
                    "name": "ipv6 address and prefix",
                    "type": "IPv6",
                    "explanation": "IPv6 地址和前缀"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode ipv6ip 6rd",
            "explanation": "设置隧道模式为 IPv6 over IPv4 with 6RD",
            "parameters": [
                {
                    "name": "mode type",
                    "type": "string",
                    "explanation": "模式类型"
                },
                {
                    "name": "submode",
                    "type": "string",
                    "explanation": "子模式"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source GigabitEthernet1/0/1",
            "explanation": "指定隧道的源接口为 'GigabitEthernet1/0/1'",
            "parameters": [
                {
                    "name": "source interface name",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "tunnel 6rd prefix [parameter1]": {
            "template": "tunnel 6rd prefix [parameter1]",
            "command": "tunnel 6rd prefix 2001:db8::/32",
            "explanation": "配置 6RD 前缀为 2001:db8::/32",
            "parameters": [
                {
                    "name": "6RD prefix",
                    "type": "IPv6",
                    "explanation": "6RD 前缀"
                }
            ]
        },
        "tunnel 6rd br [parameter1]": {
            "template": "tunnel 6rd br [parameter1]",
            "command": "tunnel 6rd br 8",
            "explanation": "配置 6RD 的位注册为 8",
            "parameters": [
                {
                    "name": "bit registration value",
                    "type": "integer",
                    "explanation": "位注册值"
                }
            ]
        }
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route 2001:db8::/32 Tunnel1",
        "explanation": "配置 IPv6 静态路由，目标网络 2001:db8::/32，出接口 Tunnel1",
        "parameters": [
            {
                "name": "target network",
                "type": "IPv6",
                "explanation": "目标网络"
            },
            {
                "name": "outgoing interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}