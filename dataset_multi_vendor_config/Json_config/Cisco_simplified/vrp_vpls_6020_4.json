{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname SPE",
        "explanation": "设置设备的主机名为 'SPE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制设置 LDP 的路由器 ID 为 Loopback1 接口的 IP 地址",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "force",
                "type": "flag",
                "explanation": "强制设置"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "启用 MPLS IP 转发",
        "parameters": []
    },
    "vfi [parameter1] manual": {
        "template": "vfi [parameter1] manual",
        "command": "vfi vsi1 manual",
        "explanation": "手动配置虚拟转发实例 (VFI) vsi1",
        "parameters": [
            {
                "name": "vfi name",
                "type": "string",
                "explanation": "虚拟转发实例名称"
            }
        ],
        "vpn id [parameter1]": {
            "template": "vpn id [parameter1]",
            "command": "vpn id 2",
            "explanation": "设置 VPN ID 为 2",
            "parameters": [
                {
                    "name": "vpn id",
                    "type": "integer",
                    "explanation": "VPN ID"
                }
            ]
        },
        "neighbor [parameter1] encapsulation [parameter2]": {
            "template": "neighbor [parameter1] encapsulation [parameter2]",
            "command": "neighbor 1.1.1.1 encapsulation mpls",
            "explanation": "配置邻居 1.1.1.1 的封装类型为 MPLS",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "neighbor [parameter1] pw-id [parameter2]": {
            "template": "neighbor [parameter1] pw-id [parameter2]",
            "command": "neighbor 1.1.1.1 pw-id 1",
            "explanation": "配置邻居 1.1.1.1 的伪线 ID 为 1",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "pseudowire id",
                    "type": "integer",
                    "explanation": "伪线 ID"
                }
            ]
        },
        "neighbor [parameter1] control-word": {
            "template": "neighbor [parameter1] control-word",
            "command": "neighbor 1.1.1.1 control-word",
            "explanation": "启用邻居 1.1.1.1 的控制字",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                }
            ]
        },
        "neighbor [parameter1] pw-class [parameter2]": {
            "template": "neighbor [parameter1] pw-class [parameter2]",
            "command": "neighbor 1.1.1.1 pw-class bgp",
            "explanation": "配置邻居 1.1.1.1 的伪线类为 BGP",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "pseudowire class",
                    "type": "string",
                    "explanation": "伪线类"
                }
            ]
        },
        "neighbor [parameter1] router-id [parameter2]": {
            "template": "neighbor [parameter1] router-id [parameter2]",
            "command": "neighbor 1.1.1.1 router-id 1.1.1.1",
            "explanation": "配置邻居 1.1.1.1 的路由器 ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        }
    }
}