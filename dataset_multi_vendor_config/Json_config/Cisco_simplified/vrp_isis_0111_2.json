{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "isis circuit-type [parameter1]": {
            "template": "isis circuit-type [parameter1]",
            "command": "isis circuit-type level-1",
            "explanation": "设置 IS-IS 电路类型为 level-1",
            "parameters": [
                {
                    "name": "circuit type",
                    "type": "string",
                    "explanation": "IS-IS 电路类型"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0000.0003.00",
            "explanation": "配置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.4.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.4.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "设置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "IS-IS 网络类型"
                }
            ]
        }
    }
}