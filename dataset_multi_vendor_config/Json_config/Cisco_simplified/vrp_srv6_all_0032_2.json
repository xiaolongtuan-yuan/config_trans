{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "启用 BFD（双向转发检测）功能",
        "parameters": []
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-2-only",
            "explanation": "设置 IS-IS 类型为仅 Level-2",
            "parameters": [
                {
                    "name": "IS-IS type",
                    "type": "string",
                    "explanation": "IS-IS 类型"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置 IS-IS 的度量风格为宽",
            "parameters": [
                {
                    "name": "metric style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0004.00",
            "explanation": "配置 IS-IS 的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "bfd all-interfaces [parameter1]": {
            "template": "bfd all-interfaces [parameter1]",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用 BFD",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "启用或禁用"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:3::2/96",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:3::2/96",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "isis ipv6 enable [parameter1]": {
            "template": "isis ipv6 enable [parameter1]",
            "command": "isis ipv6 enable 1",
            "explanation": "在接口上启用 IS-IS IPv6 路由",
            "parameters": [
                {
                    "name": "IS-IS process ID",
                    "type": "integer",
                    "explanation": "IS-IS 进程 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}