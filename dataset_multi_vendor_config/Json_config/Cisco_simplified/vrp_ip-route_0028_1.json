{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用IPv6单播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:200::2/64",
            "explanation": "配置接口的IPv6地址为2001:db8:200::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0.0.0.0",
            "explanation": "将接口加入OSPFv3进程1，区域0.0.0.0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ]
        }
    },
    "ipv6 router ospf [parameter1]": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "配置OSPFv3进程1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置OSPFv3进程1的路由器ID为2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        }
    }
}