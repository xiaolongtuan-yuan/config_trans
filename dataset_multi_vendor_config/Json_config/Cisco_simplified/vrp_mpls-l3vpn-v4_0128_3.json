{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 100 min_rx 100 multiplier 3",
            "explanation": "配置BFD会话的间隔为100ms，最小接收间隔为100ms，乘数为3",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "BFD会话的间隔时间，单位毫秒"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "最小接收间隔时间，单位毫秒"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数，用于计算会话超时时间"
                }
            ]
        },
        "bfd neighbor [parameter1] interface [parameter2]": {
            "template": "bfd neighbor [parameter1] interface [parameter2]",
            "command": "bfd neighbor 10.1.1.2 interface GigabitEthernet1/0/0",
            "explanation": "配置BFD邻居的IP地址为10.1.1.2，接口为GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "BFD邻居的IP地址"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "bfd source-ip [parameter1]": {
            "template": "bfd source-ip [parameter1]",
            "command": "bfd source-ip 10.1.1.1",
            "explanation": "配置BFD源IP地址为10.1.1.1",
            "parameters": [
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "BFD源IP地址"
                }
            ]
        }
    },
    "ip load-sharing [parameter1]": {
        "template": "ip load-sharing [parameter1]",
        "command": "ip load-sharing per-packet",
        "explanation": "配置IP负载均衡为按包分配",
        "parameters": [
            {
                "name": "load-sharing mode",
                "type": "string",
                "explanation": "负载均衡模式"
            }
        ]
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 0.0.0.0 0.0.0.0 10.1.1.2",
        "explanation": "配置默认路由，下一跳地址为10.1.1.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "destination subnet mask",
                "type": "IPv4",
                "explanation": "目的网络子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    }
}