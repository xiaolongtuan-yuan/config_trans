{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 2.2.2.2",
            "explanation": "设置 BGP 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.2 remote-as 200",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.2，AS 号为 200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的 AS 号"
                }
            ]
        },
        "neighbor [parameter1] ebgp-multihop [parameter2]": {
            "template": "neighbor [parameter1] ebgp-multihop [parameter2]",
            "command": "neighbor 10.20.1.1 ebgp-multihop 255",
            "explanation": "配置 EBGP 多跳，最大跳数为 255",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "max hop count",
                    "type": "integer",
                    "explanation": "最大跳数"
                }
            ]
        },
        "neighbor [parameter1] timers bfd [parameter2] [parameter3] [parameter4]": {
            "template": "neighbor [parameter1] timers bfd [parameter2] [parameter3] [parameter4]",
            "command": "neighbor 10.20.1.1 timers bfd 100 100 4",
            "explanation": "配置 BFD 定时器，发送间隔为 100ms，接收间隔为 100ms，检测倍数为 4",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "transmit interval",
                    "type": "integer",
                    "explanation": "发送间隔（毫秒）"
                },
                {
                    "name": "receive interval",
                    "type": "integer",
                    "explanation": "接收间隔（毫秒）"
                },
                {
                    "name": "detect multiplier",
                    "type": "integer",
                    "explanation": "检测倍数"
                }
            ]
        },
        "neighbor [parameter1] bfd all-interfaces": {
            "template": "neighbor [parameter1] bfd all-interfaces",
            "command": "neighbor 10.20.1.1 bfd all-interfaces",
            "explanation": "在所有接口上启用 BFD",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                }
            ]
        },
        "network [parameter1] mask [parameter2]": {
            "template": "network [parameter1] mask [parameter2]",
            "command": "network 172.16.1.0 mask 255.255.255.0",
            "explanation": "在 BGP 中通告网络 172.16.1.0/24",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "neighbor [parameter1] activate": {
            "template": "neighbor [parameter1] activate",
            "command": "neighbor 10.1.1.2 activate",
            "explanation": "激活与邻居 10.1.1.2 的 BGP 会话",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                }
            ]
        },
        "neighbor [parameter1] route-policy [parameter2] out": {
            "template": "neighbor [parameter1] route-policy [parameter2] out",
            "command": "neighbor 10.20.1.1 route-policy 10 out",
            "explanation": "对邻居 10.20.1.1 的出站路由应用路由策略 10",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "route-policy",
                    "type": "string",
                    "explanation": "路由策略名称"
                }
            ]
        }
    },
    "route-map [parameter1] permit [parameter2]": {
        "template": "route-map [parameter1] permit [parameter2]",
        "command": "route-map 10 permit 10",
        "explanation": "创建路由策略 10，允许序列号为 10 的条目",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "路由策略名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set metric [parameter1]": {
            "template": "set metric [parameter1]",
            "command": "set metric 100",
            "explanation": "设置路由的度量值为 100",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "度量值"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}