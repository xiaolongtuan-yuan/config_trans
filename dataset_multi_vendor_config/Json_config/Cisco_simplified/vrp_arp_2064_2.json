{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE",
        "explanation": "设置设备的主机名为 'PE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2-4",
        "explanation": "批量创建VLAN 2到4",
        "parameters": [
            {
                "name": "vlan range",
                "type": "string",
                "explanation": "VLAN范围"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 4",
        "explanation": "配置VLAN 4",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "private-vlan primary": {
            "template": "private-vlan primary",
            "command": "private-vlan primary",
            "explanation": "设置VLAN 4为私有VLAN的主VLAN",
            "parameters": []
        },
        "private-vlan association [parameter1]": {
            "template": "private-vlan association [parameter1]",
            "command": "private-vlan association 2-3",
            "explanation": "设置VLAN 4与VLAN 2和3关联",
            "parameters": [
                {
                    "name": "associated vlan range",
                    "type": "string",
                    "explanation": "关联的VLAN范围"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan4",
        "explanation": "配置VLAN4接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.12 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.1.12，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip proxy-arp": {
            "template": "ip proxy-arp",
            "command": "ip proxy-arp",
            "explanation": "启用代理ARP",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "设置接口为交换端口",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2在trunk上",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    }
}