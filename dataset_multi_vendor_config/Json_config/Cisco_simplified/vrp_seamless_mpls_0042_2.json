            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "更新源接口名"
                }
            ]
        },
