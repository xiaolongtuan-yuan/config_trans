                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2.2.2.2 activate",
                "explanation": "激活与邻居 2.2.2.2 的 IPv4 单播会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
