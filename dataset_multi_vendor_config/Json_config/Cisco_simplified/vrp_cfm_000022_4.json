{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceE",
        "explanation": "设置设备的主机名为 'DeviceE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入 VLAN 2 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm": {
        "template": "cfm",
        "command": "cfm",
        "explanation": "进入 CFM (Connectivity Fault Management) 配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许 VLAN 2 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm mep domain [parameter1] level [parameter2]": {
        "template": "cfm mep domain [parameter1] level [parameter2]",
        "command": "cfm mep domain md1 level 6",
        "explanation": "配置 CFM MEP (Maintenance End Point) 域 'md1' 的级别为 6",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "级别"
            }
        ],
        "cfm mep service [parameter1] md [parameter2]": {
            "template": "cfm mep service [parameter1] md [parameter2]",
            "command": "cfm mep service ma1 md md1",
            "explanation": "在域 'md1' 下配置 CFM MEP 服务 'ma1'",
            "parameters": [
                {
                    "name": "service name",
                    "type": "string",
                    "explanation": "服务名"
                },
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "域名"
                }
            ],
            "cfm mep service vlan [parameter1]": {
                "template": "cfm mep service vlan [parameter1]",
                "command": "cfm mep service vlan 2",
                "explanation": "配置 CFM MEP 服务关联的 VLAN 为 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ],
                "cfm mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                    "template": "cfm mep mep-id [parameter1] interface [parameter2] [parameter3]",
                    "command": "cfm mep mep-id 3 interface gigabitethernet 1/0/1 inward",
                    "explanation": "配置 CFM MEP ID 为 3，关联接口 'gigabitethernet 1/0/1'，方向为 inward",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        },
                        {
                            "name": "interface name",
                            "type": "string",
                            "explanation": "接口名"
                        },
                        {
                            "name": "direction",
                            "type": "string",
                            "explanation": "方向"
                        }
                    ],
                    "cfm mep mep-id [parameter1] ccm-send": {
                        "template": "cfm mep mep-id [parameter1] ccm-send",
                        "command": "cfm mep mep-id 3 ccm-send",
                        "explanation": "配置 CFM MEP ID 为 3 的 CCM (Continuity Check Message) 发送",
                        "parameters": [
                            {
                                "name": "mep id",
                                "type": "integer",
                                "explanation": "MEP ID"
                            }
                        ]
                    }
                },
                "cfm mep remote-mep mep-id [parameter1]": {
                    "template": "cfm mep remote-mep mep-id [parameter1]",
                    "command": "cfm mep remote-mep mep-id 1",
                    "explanation": "配置 CFM 远程 MEP ID 为 1",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        }
                    ],
                    "cfm mep remote-mep mep-id [parameter1] ccm-receive": {
                        "template": "cfm mep remote-mep mep-id [parameter1] ccm-receive",
                        "command": "cfm mep remote-mep mep-id 1 ccm-receive",
                        "explanation": "配置 CFM 远程 MEP ID 为 1 的 CCM 接收",
                        "parameters": [
                            {
                                "name": "mep id",
                                "type": "integer",
                                "explanation": "MEP ID"
                            }
                        ]
                    }
                }
            }
        }
    },
    "exit": {
        "template": "exit",
        "command": "exit",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}