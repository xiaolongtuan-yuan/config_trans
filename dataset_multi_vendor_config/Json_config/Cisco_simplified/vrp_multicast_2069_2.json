{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]": {
        "template": "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]",
        "command": "access-list 2000 permit ip any 232.1.1.0 0.0.0.255",
        "explanation": "配置访问控制列表2000，允许所有IP流量到232.1.1.0/24",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source",
                "type": "string",
                "explanation": "源地址，'any'表示任意地址"
            },
            {
                "name": "destination",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "wildcard mask",
                "type": "IPv4",
                "explanation": "通配符掩码"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入IS-IS路由配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0003.00",
            "explanation": "配置IS-IS网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用IS-IS进程1",
            "parameters": [
                {
                    "name": "IS-IS process",
                    "type": "integer",
                    "explanation": "IS-IS进程编号"
                }
            ]
        }
    },
    "ip pim ssm-default [parameter1]": {
        "template": "ip pim ssm-default [parameter1]",
        "command": "ip pim ssm-default 2000",
        "explanation": "配置PIM SSM默认组范围为访问控制列表2000",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}