{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceF",
        "explanation": "设置设备的主机名为 'DeviceF'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2,3",
        "explanation": "创建 VLAN 2 和 VLAN 3",
        "parameters": [
            {
                "name": "vlan id",
                "type": "list",
                "explanation": "VLAN ID 列表"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用 CFM (Connectivity Fault Management) 功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许 VLAN 2 通过该 trunk 端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许通过的 VLAN ID"
                }
            ]
        }
    },
    "ethernet cfm md [parameter1] level [parameter2]": {
        "template": "ethernet cfm md [parameter1] level [parameter2]",
        "command": "ethernet cfm md md1 level 6",
        "explanation": "配置 CFM 维护域 'md1' 的级别为 6",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "维护域级别"
            }
        ],
        "mep cross-check mep-id [parameter1] mpid [parameter2] domain [parameter3] md [parameter4]": {
            "template": "mep cross-check mep-id [parameter1] mpid [parameter2] domain [parameter3] md [parameter4]",
            "command": "mep cross-check mep-id 1 mpid 1 domain 0 md md1",
            "explanation": "配置 MEP (Maintenance End Point) 交叉检查，MEP ID 为 1，MPID 为 1，域为 0，维护域为 'md1'",
            "parameters": [
                {
                    "name": "mep id",
                    "type": "integer",
                    "explanation": "MEP ID"
                },
                {
                    "name": "mpid",
                    "type": "integer",
                    "explanation": "MPID"
                },
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "域"
                },
                {
                    "name": "maintenance domain",
                    "type": "string",
                    "explanation": "维护域名"
                }
            ]
        }
    }
}