{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 3.3.3.3",
            "explanation": "设置 OSPF 路由器的 ID 为 3.3.3.3",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF 路由器 ID"
                }
            ]
        },
        "redistribute bgp [parameter1] subnets": {
            "template": "redistribute bgp [parameter1] subnets",
            "command": "redistribute bgp 65410 subnets",
            "explanation": "将 BGP 65410 的路由重分发到 OSPF 中，包含子网",
            "parameters": [
                {
                    "name": "as number",
                    "type": "integer",
                    "explanation": "BGP 自治系统号"
                }
            ]
        },
        "network [parameter1] area [parameter2]": {
            "template": "network [parameter1] area [parameter2]",
            "command": "network 2001:DB8:1::2/64 area 0.0.0.0",
            "explanation": "将网络 2001:DB8:1::2/64 加入到 OSPF 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv6",
                    "explanation": "网络地址"
                },
                {
                    "name": "area",
                    "type": "IPv4",
                    "explanation": "OSPF 区域"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0.0.0.0",
            "explanation": "将接口的 IPv6 地址加入到 OSPF 进程 1 的区域 0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPF 进程 ID"
                },
                {
                    "name": "area",
                    "type": "IPv4",
                    "explanation": "OSPF 区域"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 3.3.3.3 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 3.3.3.3，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "配置 BGP 进程 65410",
        "parameters": [
            {
                "name": "as number",
                "type": "integer",
                "explanation": "BGP 自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:DB8:1::1 remote-as 100",
            "explanation": "配置 BGP 邻居 2001:DB8:1::1，远程自治系统号为 100",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "IPv6",
                    "explanation": "BGP 邻居地址"
                },
                {
                    "name": "remote as",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family ipv4",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:DB8:1::1 activate",
                "explanation": "激活邻居 2001:DB8:1::1 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor",
                        "type": "IPv6",
                        "explanation": "BGP 邻居地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            }
        },
        "address-family ipv6": {
            "template": "address-family ipv6",
            "command": "address-family ipv6",
            "explanation": "进入 IPv6 地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:DB8:1::1 activate",
                "explanation": "激活邻居 2001:DB8:1::1 的 IPv6 地址族",
                "parameters": [
                    {
                        "name": "neighbor",
                        "type": "IPv6",
                        "explanation": "BGP 邻居地址"
                    }
                ]
            },
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "redistribute ospfv3 [parameter1] metric [parameter2]": {
                "template": "redistribute ospfv3 [parameter1] metric [parameter2]",
                "command": "redistribute ospfv3 1 metric 500",
                "explanation": "将 OSPFv3 进程 1 的路由重分发到 BGP 中，设置度量值为 500",
                "parameters": [
                    {
                        "name": "process id",
                        "type": "integer",
                        "explanation": "OSPFv3 进程 ID"
                    },
                    {
                        "name": "metric",
                        "type": "integer",
                        "explanation": "度量值"
                    }
                ]
            }
        }
    }
}