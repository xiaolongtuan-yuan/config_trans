{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "配置接口 'GigabitEthernet1/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1",
            "explanation": "配置接口的802.1Q封装，VLAN ID为1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识符"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为192.168.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "dhcp select [parameter1]": {
            "template": "dhcp select [parameter1]",
            "command": "dhcp select relay",
            "explanation": "配置接口使用DHCP中继",
            "parameters": [
                {
                    "name": "relay mode",
                    "type": "string",
                    "explanation": "DHCP中继模式"
                }
            ]
        },
        "ip helper-address [parameter1]": {
            "template": "ip helper-address [parameter1]",
            "command": "ip helper-address 192.168.1.1",
            "explanation": "配置接口的DHCP帮助地址为192.168.1.1",
            "parameters": [
                {
                    "name": "helper address",
                    "type": "IPv4",
                    "explanation": "帮助地址"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}