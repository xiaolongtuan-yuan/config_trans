{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 20",
        "explanation": "创建或进入 VLAN 20 的配置模式",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN 的标识符"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan20",
        "explanation": "配置 VLAN 20 的虚拟接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.17.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口配置为二层交换端口",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 20",
            "explanation": "将接口分配到 VLAN 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 的标识符"
                }
            ]
        },
        "tunnel mode [parameter1]": {
            "template": "tunnel mode [parameter1]",
            "command": "tunnel mode gre",
            "explanation": "设置隧道模式为 GRE (Generic Routing Encapsulation)",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source Loopback1",
            "explanation": "设置隧道的源地址为 'Loopback1' 接口的地址",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 1.1.1.9",
            "explanation": "设置隧道的目的地址为 1.1.1.9",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "目的地址"
                }
            ]
        },
        "keepalive [parameter1]": {
            "template": "keepalive [parameter1]",
            "command": "keepalive 20",
            "explanation": "设置隧道保持活动的时间间隔为 20 秒",
            "parameters": [
                {
                    "name": "keepalive interval",
                    "type": "integer",
                    "explanation": "保持活动的时间间隔"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "进入 OSPF 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程标识符"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.9 0.0.0.0 area 0",
            "explanation": "将地址 2.2.2.9 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域标识符"
                }
            ]
        }
    }
}