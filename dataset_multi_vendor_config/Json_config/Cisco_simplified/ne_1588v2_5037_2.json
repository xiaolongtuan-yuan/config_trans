{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置接口 'Loopback0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 3.3.3.3 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 3.3.3.3，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "启用 PTP (Precision Time Protocol)",
        "parameters": []
    },
    "ptp mode [parameter1]": {
        "template": "ptp mode [parameter1]",
        "command": "ptp mode client",
        "explanation": "设置 PTP 模式为客户端",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "PTP 模式 (client, server, etc.)"
            }
        ]
    },
    "ptp source-ip [parameter1]": {
        "template": "ptp source-ip [parameter1]",
        "command": "ptp source-ip 3.3.3.3",
        "explanation": "设置 PTP 源 IP 地址为 3.3.3.3",
        "parameters": [
            {
                "name": "source-ip",
                "type": "IPv4",
                "explanation": "PTP 源 IP 地址"
            }
        ]
    },
    "ptp server [parameter1]": {
        "template": "ptp server [parameter1]",
        "command": "ptp server 1.1.1.1",
        "explanation": "添加 PTP 服务器地址 1.1.1.1",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "PTP 服务器地址"
            }
        ]
    },
    "ptp sync-interval [parameter1]": {
        "template": "ptp sync-interval [parameter1]",
        "command": "ptp sync-interval 4",
        "explanation": "设置 PTP 同步间隔为 4 秒",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "同步间隔秒数"
            }
        ]
    },
    "ptp announce-interval [parameter1]": {
        "template": "ptp announce-interval [parameter1]",
        "command": "ptp announce-interval 12",
        "explanation": "设置 PTP 宣告间隔为 12 秒",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "宣告间隔秒数"
            }
        ]
    },
    "ptp delay-response-interval [parameter1]": {
        "template": "ptp delay-response-interval [parameter1]",
        "command": "ptp delay-response-interval 6",
        "explanation": "设置 PTP 延迟响应间隔为 6 秒",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "延迟响应间隔秒数"
            }
        ]
    },
    "ptp unicast-negotiate enable": {
        "template": "ptp unicast-negotiate enable",
        "command": "ptp unicast-negotiate enable",
        "explanation": "启用 PTP 单播协商",
        "parameters": []
    },
    "clock source [parameter1]": {
        "template": "clock source [parameter1]",
        "command": "clock source internal",
        "explanation": "设置时钟源为内部时钟",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "时钟源 (internal, ptp, etc.)"
            }
        ]
    },
    "clock source ptp priority [parameter1]": {
        "template": "clock source ptp priority [parameter1]",
        "command": "clock source ptp priority 1",
        "explanation": "设置 PTP 时钟源的优先级为 1",
        "parameters": [
            {
                "name": "priority",
                "type": "integer",
                "explanation": "PTP 优先级"
            }
        ]
    },
    "clock source ptp ssm [parameter1]": {
        "template": "clock source ptp ssm [parameter1]",
        "command": "clock source ptp ssm prc",
        "explanation": "设置 PTP SSM (Sync Status Message) 模式为 PRC (Primary Reference Clock)",
        "parameters": [
            {
                "name": "ssm mode",
                "type": "string",
                "explanation": "SSM 模式 (prc, etc.)"
            }
        ]
    }
}