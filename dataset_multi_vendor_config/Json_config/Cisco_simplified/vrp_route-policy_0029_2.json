{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "distribute-list prefix [parameter1] in [parameter2]": {
            "template": "distribute-list prefix [parameter1] in [parameter2]",
            "command": "distribute-list prefix in import",
            "explanation": "配置 OSPF 进程 1 的 distribute-list，允许导入前缀列表 'in'",
            "parameters": [
                {
                    "name": "prefix list name",
                    "type": "string",
                    "explanation": "前缀列表名称"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "方向，'in' 表示入方向"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.2.0 0.0.0.255 area 0",
            "explanation": "配置 OSPF 进程 1 的网络 192.168.2.0/24 在区域 0 中",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "ip prefix-list [parameter1] [parameter2] [parameter3]": {
        "template": "ip prefix-list [parameter1] [parameter2] [parameter3]",
        "command": "ip prefix-list in permit 172.16.18.0/24",
        "explanation": "配置前缀列表 'in'，允许 172.16.18.0/24 网络",
        "parameters": [
            {
                "name": "prefix list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作，'permit' 表示允许"
            },
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}