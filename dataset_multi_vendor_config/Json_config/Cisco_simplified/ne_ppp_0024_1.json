{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "配置接口 'Lmpif1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation [parameter1]": {
            "template": "encapsulation [parameter1]",
            "command": "encapsulation ppp",
            "explanation": "设置接口的封装类型为 PPP",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.110.0.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ppp authentication [parameter1]": {
            "template": "ppp authentication [parameter1]",
            "command": "ppp authentication chap",
            "explanation": "设置 PPP 认证为 CHAP",
            "parameters": [
                {
                    "name": "authentication type",
                    "type": "string",
                    "explanation": "认证类型"
                }
            ]
        },
        "ppp chap hostname [parameter1]": {
            "template": "ppp chap hostname [parameter1]",
            "command": "ppp chap hostname rtb",
            "explanation": "设置 CHAP 的主机名为 'rtb'",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "主机名"
                }
            ]
        },
        "ppp chap password [parameter1] [parameter2]": {
            "template": "ppp chap password [parameter1] [parameter2]",
            "command": "ppp chap password 0 @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
            "explanation": "设置 CHAP 的密码，明文显示",
            "parameters": [
                {
                    "name": "password type",
                    "type": "integer",
                    "explanation": "密码类型（0表示明文）"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "密码"
                }
            ]
        }
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "启用 AAA 新模型",
        "parameters": []
    },
    "username [parameter1] password [parameter2] [parameter3]": {
        "template": "username [parameter1] password [parameter2] [parameter3]",
        "command": "username rta password 0 @%@%EDF~DAdfFD934J3<DAF#*<!@%@%",
        "explanation": "创建用户名 'rta' 及其密码，明文显示",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "password type",
                "type": "integer",
                "explanation": "密码类型（0表示明文）"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "密码"
            }
        ]
    },
    "username [parameter1] service [parameter2]": {
        "template": "username [parameter1] service [parameter2]",
        "command": "username rta service ppp",
        "explanation": "指定用户名 'rta' 用于 PPP 服务",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "service type",
                "type": "string",
                "explanation": "服务类型"
            }
        ]
    },
    "aaa authentication login [parameter1] [parameter2]": {
        "template": "aaa authentication login [parameter1] [parameter2]",
        "command": "aaa authentication login default1 local",
        "explanation": "设置 AAA 登录认证使用本地数据库，认证列表 'default1'",
        "parameters": [
            {
                "name": "authentication list",
                "type": "string",
                "explanation": "认证列表名称"
            },
            {
                "name": "method",
                "type": "string",
                "explanation": "认证方法（本地数据库）"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}