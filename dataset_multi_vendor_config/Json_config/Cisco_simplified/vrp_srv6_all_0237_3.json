{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用IPv6单播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:13::2/96",
            "explanation": "配置接口的IPv6地址为2001:DB8:13::2，前缀长度为96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0",
            "explanation": "将接口加入到OSPFv3进程1的区域0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF进程ID"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "配置OSPFv3进程1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 0.0.0.0",
            "explanation": "设置OSPFv3进程1的路由器ID为0.0.0.0",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area [parameter1] range [parameter2]": {
            "template": "area [parameter1] range [parameter2]",
            "command": "area 0 range 2001:DB8:13::/96",
            "explanation": "在OSPFv3进程1的区域0中汇总2001:DB8:13::/96的地址范围",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                },
                {
                    "name": "ipv6 address range",
                    "type": "IPv6",
                    "explanation": "IPv6地址范围"
                }
            ]
        },
        "area [parameter1] stub no-summary": {
            "template": "area [parameter1] stub no-summary",
            "command": "area 0 stub no-summary",
            "explanation": "将OSPFv3进程1的区域0配置为无汇总的stub区域",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}