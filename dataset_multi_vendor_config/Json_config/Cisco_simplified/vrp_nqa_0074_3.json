{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.100.0.2 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.100.0.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程标识符"
            }
        ],
        "redistribute connected subnets": {
            "template": "redistribute connected subnets",
            "command": "redistribute connected subnets",
            "explanation": "将直连网络的路由信息重分发到 OSPF 中",
            "parameters": []
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.100.0.0 0.0.0.255 area 0",
            "explanation": "将网络 10.100.0.0/24 加入到 OSPF 区域 0 中",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "区域标识符"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}