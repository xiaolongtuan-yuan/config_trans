{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:101::2/96",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:101::2/96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 2.2.2.2",
            "explanation": "配置 BGP 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:db8:100::1 remote-as 100",
            "explanation": "配置 BGP 邻居，邻居的 IPv6 地址为 2001:db8:100::1，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor address",
                    "type": "IPv6",
                    "explanation": "邻居的 IPv6 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv6",
            "explanation": "进入 IPv6 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:db8:100::1 activate",
                "explanation": "激活与邻居 2001:db8:100::1 的 IPv6 BGP 会话",
                "parameters": [
                    {
                        "name": "neighbor address",
                        "type": "IPv6",
                        "explanation": "邻居的 IPv6 地址"
                    }
                ]
            },
            "neighbor [parameter1] next-hop-self": {
                "template": "neighbor [parameter1] next-hop-self",
                "command": "neighbor 2001:db8:101::1 next-hop-self",
                "explanation": "配置 BGP 将自身作为下一跳通告给邻居 2001:db8:101::1",
                "parameters": [
                    {
                        "name": "neighbor address",
                        "type": "IPv6",
                        "explanation": "邻居的 IPv6 地址"
                    }
                ]
            }
        }
    }
}