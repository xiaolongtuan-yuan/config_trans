{
    "enable": {
        "template": "enable",
        "command": "enable",
        "explanation": "进入特权模式",
        "parameters": []
    },
    "configure terminal": {
        "template": "configure terminal",
        "command": "configure terminal",
        "explanation": "进入全局配置模式",
        "parameters": []
    },
    "flow record [parameter1] interval [parameter2]": {
        "template": "flow record [parameter1] interval [parameter2]",
        "command": "flow record stats interval 100",
        "explanation": "配置流量记录统计间隔为100秒",
        "parameters": [
            {
                "name": "flow record name",
                "type": "string",
                "explanation": "流量记录名称"
            },
            {
                "name": "interval",
                "type": "integer",
                "explanation": "统计间隔时间（秒）"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 2/0/0",
        "explanation": "配置接口 'GigabitEthernet 2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "description [parameter1]": {
            "template": "description [parameter1]",
            "command": "description for IFM",
            "explanation": "设置接口描述为 'for IFM'",
            "parameters": [
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "接口描述"
                }
            ]
        },
        "mtu [parameter1]": {
            "template": "mtu [parameter1]",
            "command": "mtu 1000",
            "explanation": "设置接口的MTU为1000",
            "parameters": [
                {
                    "name": "mtu size",
                    "type": "integer",
                    "explanation": "最大传输单元（MTU）大小"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式并返回到特权模式",
        "parameters": []
    }
