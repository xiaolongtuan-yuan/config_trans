{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname NPE1",
        "explanation": "设置设备的主机名为 'NPE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制使用 Loopback1 接口的 IP 地址作为 LDP 的 Router ID",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 10 mode on",
            "explanation": "将接口加入到通道组 10，并启用通道组",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "通道组模式"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.30.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.30.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置 OSPF 的 Router ID 为 4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 4.4.4.4 0.0.0.0 area 0",
            "explanation": "将 4.4.4.4/32 网络加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "mpls ldp neighbor [parameter1] targeted": {
        "template": "mpls ldp neighbor [parameter1] targeted",
        "command": "mpls ldp neighbor 2.2.2.2 targeted",
        "explanation": "配置与 2.2.2.2 的 LDP 目标邻居关系",
        "parameters": [
            {
                "name": "neighbor address",
                "type": "IPv4",
                "explanation": "邻居地址"
            }
        ]
    },
    "exit": {
        "template": "exit",
        "command": "exit",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}