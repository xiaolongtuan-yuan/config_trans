{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "配置接口 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许 VLAN 100 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许通过的 VLAN ID"
                }
            ]
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        },
        "switchport trunk native vlan [parameter1]": {
            "template": "switchport trunk native vlan [parameter1]",
            "command": "switchport trunk native vlan 100",
            "explanation": "设置 trunk 接口的 native VLAN 为 100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Native VLAN 的 ID"
                }
            ]
        }
    }
}