{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp clock-period [parameter1]": {
        "template": "ntp clock-period [parameter1]",
        "command": "ntp clock-period 17179979",
        "explanation": "设置 NTP 的时钟周期为 17179979",
        "parameters": [
            {
                "name": "clock period",
                "type": "integer",
                "explanation": "时钟周期值"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ntp enable": {
            "template": "ntp enable",
            "command": "ntp enable",
            "explanation": "启用 NTP 客户端功能",
            "parameters": []
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "设置时钟优先级为 1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "时钟优先级"
                }
            ]
        },
        "ntp master [parameter1]": {
            "template": "ntp master [parameter1]",
            "command": "ntp master 1",
            "explanation": "配置接口为 NTP 主服务器，优先级 1",
            "parameters": [
                {
                    "name": "master priority",
                    "type": "integer",
                    "explanation": "NTP 主服务器优先级"
                }
            ]
        }
    }
}