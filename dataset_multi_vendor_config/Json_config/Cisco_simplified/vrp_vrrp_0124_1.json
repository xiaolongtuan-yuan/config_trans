{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "standby [parameter1] ip [parameter2]": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 10 ip 10.10.1.111",
            "explanation": "配置 HSRP 组 10 的虚拟 IP 地址为 10.10.1.111",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "virtual ip address",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "standby [parameter1] track [parameter2] [parameter3] decrement [parameter4]": {
            "template": "standby [parameter1] track [parameter2] [parameter3] decrement [parameter4]",
            "command": "standby 10 track GigabitEthernet1/0/4 1 decrement 10",
            "explanation": "配置 HSRP 组 10 跟踪接口 'GigabitEthernet1/0/4' 的状态，优先级降低 10",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "tracked interface",
                    "type": "string",
                    "explanation": "被跟踪的接口"
                },
                {
                    "name": "tracked object",
                    "type": "integer",
                    "explanation": "跟踪对象"
                },
                {
                    "name": "priority decrement",
                    "type": "integer",
                    "explanation": "优先级降低值"
                }
            ]
        },
        "standby [parameter1] preempt": {
            "template": "standby [parameter1] preempt",
            "command": "standby 1 preempt",
            "explanation": "配置 HSRP 组 1 的抢占模式",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.10.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.10.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    }
}