{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname RR",
        "explanation": "设置设备的主机名为 'RR'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 功能",
            "parameters": []
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 1.1.1.1，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.1 update-source Loopback1",
            "explanation": "配置 BGP 邻居 1.1.1.1 使用 Loopback1 接口作为更新源",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "更新源接口名"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 1.1.1.1 activate",
                "explanation": "激活邻居 1.1.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-reflector-client": {
                "template": "neighbor [parameter1] route-reflector-client",
                "command": "neighbor 1.1.1.1 route-reflector-client",
                "explanation": "配置邻居 1.1.1.1 为路由反射器客户端",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程号为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.2 0.0.0.0 area 0",
            "explanation": "配置 OSPF 网络，IP 地址为 2.2.2.2，通配符掩码为 0.0.0.0，区域为 0",
            "parameters": [
                {
                    "name": "network ip address",
                    "type": "IPv4",
                    "explanation": "网络 IP 地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}