{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "强制使用 Loopback1 接口的 IP 地址作为 LDP 的路由器 ID",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS",
            "parameters": []
        }
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由进程配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0002.00",
            "explanation": "设置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置 IS-IS 使用宽度量风格",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        }
    },
    "mpls traffic-eng router-id [parameter1]": {
        "template": "mpls traffic-eng router-id [parameter1]",
        "command": "mpls traffic-eng router-id Loopback1",
        "explanation": "设置 MPLS 流量工程的路由器 ID 为 Loopback1 接口的 IP 地址",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls traffic-eng level [parameter1]": {
        "template": "mpls traffic-eng level [parameter1]",
        "command": "mpls traffic-eng level 1",
        "explanation": "在 IS-IS 级别 1 上启用 MPLS 流量工程",
        "parameters": [
            {
                "name": "level",
                "type": "integer",
                "explanation": "IS-IS 级别"
            }
        ]
    },
    "mpls rsvp-te": {
        "template": "mpls rsvp-te",
        "command": "mpls rsvp-te",
