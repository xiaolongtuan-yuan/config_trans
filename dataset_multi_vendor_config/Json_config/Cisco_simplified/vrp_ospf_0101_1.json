{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPF 路由器 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF 路由器 ID"
                }
            ]
        },
        "bfd all-interfaces": {
            "template": "bfd all-interfaces",
            "command": "bfd all-interfaces",
            "explanation": "在所有接口上启用 BFD（双向转发检测）",
            "parameters": []
        },
        "timers throttle spf [parameter1] [parameter2] [parameter3]": {
            "template": "timers throttle spf [parameter1] [parameter2] [parameter3]",
            "command": "timers throttle spf 3000 200 500",
            "explanation": "设置 SPF 计算的时间参数",
            "parameters": [
                {
                    "name": "initial delay",
                    "type": "integer",
                    "explanation": "初始延迟时间（毫秒）"
                },
                {
                    "name": "minimum delay",
                    "type": "integer",
                    "explanation": "最小延迟时间（毫秒）"
                },
                {
                    "name": "maximum delay",
                    "type": "integer",
                    "explanation": "最大延迟时间（毫秒）"
                }
            ]
        },
        "timers throttle lsa [parameter1] [parameter2] [parameter3]": {
            "template": "timers throttle lsa [parameter1] [parameter2] [parameter3]",
            "command": "timers throttle lsa 3000 200 500",
            "explanation": "设置 LSA 生成的时间参数",
            "parameters": [
                {
                    "name": "initial delay",
                    "type": "integer",
                    "explanation": "初始延迟时间（毫秒）"
                },
                {
                    "name": "minimum delay",
                    "type": "integer",
                    "explanation": "最小延迟时间（毫秒）"
                },
                {
                    "name": "maximum delay",
                    "type": "integer",
                    "explanation": "最大延迟时间（毫秒）"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.1.0 0.0.0.255 area 0",
            "explanation": "将网络 192.168.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip ospf dead-interval minimal hello-multiplier [parameter1]": {
            "template": "ip ospf dead-interval minimal hello-multiplier [parameter1]",
            "command": "ip ospf dead-interval minimal hello-multiplier 3",
            "explanation": "设置 OSPF 死亡间隔为最小，并设置 hello 乘数为 3",
            "parameters": [
                {
                    "name": "hello multiplier",
                    "type": "integer",
                    "explanation": "hello 乘数"
                }
            ]
        }
    }
}