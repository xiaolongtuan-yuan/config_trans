            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP",
            "parameters": []
        }
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用MPLS LDP",
        "parameters": []
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 2.2.2.2",
        "explanation": "设置LSR ID为2.2.2.2",
        "parameters": [
            {
                "name": "LSR ID",
                "type": "IPv4",
                "explanation": "标签交换路由器的ID"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "全局启用MPLS IP",
        "parameters": []
    },
    "tunnel-policy [parameter1]": {
        "template": "tunnel-policy [parameter1]",
        "command": "tunnel-policy p1",
        "explanation": "配置隧道策略p1",
        "parameters": [
            {
                "name": "policy name",
                "type": "string",
                "explanation": "隧道策略名称"
            }
        ],
        "tunnel select-seq [parameter1] [parameter2] load-balance-number [parameter3]": {
            "template": "tunnel select-seq [parameter1] [parameter2] load-balance-number [parameter3]",
            "command": "tunnel select-seq ldp bgp load-balance-number 1",
            "explanation": "选择隧道顺序为LDP然后BGP，并设置负载均衡数量为1",
            "parameters": [
                {
                    "name": "selection sequence",
                    "type": "string",
                    "explanation": "隧道选择顺序"
                },
                {
                    "name": "load-balance number",
                    "type": "integer",
                    "explanation": "负载均衡的隧道数量"
