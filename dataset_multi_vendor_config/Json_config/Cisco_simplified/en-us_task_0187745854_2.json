{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ASBR1",
        "explanation": "设置设备的主机名为 'ASBR1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程，进程ID为1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "bgp-ls enable": {
            "template": "bgp-ls enable",
            "command": "bgp-ls enable",
            "explanation": "启用BGP-LS功能",
            "parameters": []
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.2 0.0.0.0 area 0",
            "explanation": "将网络2.2.2.2/32归属于OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF区域ID"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "启用BGP进程，AS号为100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.1 remote-as 100",
            "explanation": "配置邻居1.1.1.1，AS号为100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的AS号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.1 update-source Loopback1",
            "explanation": "指定与邻居1.1.1.1通信时使用的源接口为Loopback1",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的IP地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                },
                {
                    "name": "unicast/multicast",
                    "type": "string",
                    "explanation": "路由类型"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 1.1.1.1 activate",
                "explanation": "激活与邻居1.1.1.1的IPv4单播会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的IP地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
