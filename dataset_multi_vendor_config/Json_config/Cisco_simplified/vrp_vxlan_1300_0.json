{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device1",
        "explanation": "设置设备的主机名为 'Device1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis [parameter1]": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0001.00",
            "explanation": "配置 IS-IS 网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 路由进程 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2.2.2.2 remote-as 100",
            "explanation": "配置 BGP 邻居 2.2.2.2，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "remote AS",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 2.2.2.2 update-source Loopback0",
            "explanation": "配置 BGP 邻居 2.2.2.2 的更新源为 Loopback0 接口",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "更新源接口"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family l2vpn evpn",
            "explanation": "配置 L2VPN EVPN 地址族",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                },
                {
                    "name": "sub-address family",
                    "type": "string",
                    "explanation": "子地址族"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2.2.2.2 activate",
                "explanation": "激活 BGP 邻居 2.2.2.2 的 L2VPN EVPN 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] advertisement encapsulation [parameter2]": {
                "template": "neighbor [parameter1] advertisement encapsulation [parameter2]",
                "command": "neighbor 2.2.2.2 advertisement encapsulation vxlan",
                "explanation": "配置 BGP 邻居 2.2.2.2 的 L2VPN EVPN 地址族广告封装为 VXLAN",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    },
                    {
                        "name": "encapsulation type",
                        "type": "string",
                        "explanation": "封装类型"
                    }
                ]
            },
            "neighbor [parameter1] advertisement [parameter2]": {
                "template": "neighbor [parameter1] advertisement [parameter2]",
                "command": "neighbor 2.2.2.2 advertisement irb",
                "explanation": "配置 BGP 邻居 2.2.2.2 的 L2VPN EVPN 地址族广告为 IRB",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    },
                    {
                        "name": "advertisement type",
                        "type": "string",
                        "explanation": "广告类型"
                    }
                ]
            },
            "neighbor [parameter1] route-reflector-client": {
                "template": "neighbor [parameter1] route-reflector-client",
                "command": "neighbor 2.2.2.2 route-reflector-client",
                "explanation": "配置 BGP 邻居 2.2.2.2 为路由反射器客户端",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            }
        }
    }
}