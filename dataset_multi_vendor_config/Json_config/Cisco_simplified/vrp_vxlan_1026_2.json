{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device3",
        "explanation": "设置设备的主机名为 'Device3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 20",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 20",
            "explanation": "将子接口关联到桥接域 20",
            "parameters": [
                {
                    "name": "bridge domain ID",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        },
        "source-interface [parameter1]": {
            "template": "source-interface [parameter1]",
            "command": "source-interface Loopback1",
            "explanation": "设置 NVE 接口的源接口为 'Loopback1'",
            "parameters": [
                {
                    "name": "source interface name",
                    "type": "string",
                    "explanation": "源接口名"
                }
            ]
        },
        "member vni [parameter1] mcast-group [parameter2]": {
            "template": "member vni [parameter1] mcast-group [parameter2]",
            "command": "member vni 5020 mcast-group 239.1.1.1",
            "explanation": "配置 NVE 接口的成员 VNI 为 5020，并设置多播组地址为 239.1.1.1",
            "parameters": [
                {
                    "name": "VNI",
                    "type": "integer",
                    "explanation": "虚拟网络标识符"
                },
                {
                    "name": "multicast group address",
                    "type": "IPv4",
                    "explanation": "多播组地址"
                }
            ]
        },
        "headend peering ipv4 [parameter1]": {
            "template": "headend peering ipv4 [parameter1]",
            "command": "headend peering ipv4 3.3.3.3",
            "explanation": "配置 NVE 接口的头端对等体 IPv4 地址为 3.3.3.3",
            "parameters": [
                {
                    "name": "headend peering IPv4 address",
                    "type": "IPv4",
                    "explanation": "头端对等体 IPv4 地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 4.4.4.4 0.0.0.0 area 0",
            "explanation": "将 IP 地址 4.4.4.4 精确匹配（掩码 0.0.0.0）的网络加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "OSPF area",
                    "type": "integer",
                    "explanation": "OSPF 区域"
                }
            ]
        }
    }
}