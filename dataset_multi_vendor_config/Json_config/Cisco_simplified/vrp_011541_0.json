        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "cfm": {
        "template": "cfm",
        "command": "cfm",
        "explanation": "启用CFM（IEEE 802.1ag）功能",
        "parameters": []
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version 0",
        "explanation": "设置CFM版本为0",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "CFM版本号"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "启用接口的交换端口模式",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2在trunk上通行",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识号"
                }
            ]
        }
    },
    "cfm md [parameter1]": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
        "explanation": "配置CFM域 'md3'",
        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "CFM域名称"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "配置维护关联 'ma3'",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "mep mep-id [parameter1] interface [parameter2] md [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] md [parameter3]",
                "command": "mep mep-id 3 interface GigabitEthernet1/0/1 md md3",
                "explanation": "配置MEP ID 3在接口 GigabitEthernet1/0/1 上，属于MD md3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    },
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "md",
                        "type": "string",
                        "explanation": "CFM域名称"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1]": {
                "template": "mep ccm-send mep-id [parameter1]",
                "command": "mep ccm-send mep-id 3",
                "explanation": "配置MEP ID 3发送CCM（连续性检查消息）",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 4",
                "explanation": "配置远程MEP ID 4",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1]": {
                "template": "remote-mep ccm-receive mep-id [parameter1]",
                "command": "remote-mep ccm-receive mep-id 4",
                "explanation": "配置接收来自远程MEP ID 4的CCM",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "cfm test-id [parameter1] mep [parameter2] remote-mep [parameter3]": {
                "template": "cfm test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "cfm test-id 1 mep 3 remote-mep 4",
                "explanation": "配置CFM测试ID 1，本地MEP 3和远程MEP 4",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试标识号"
                    },
                    {
                        "name": "mep",
                        "type": "integer",
                        "explanation": "本地MEP标识号"
                    },
                    {
                        "name": "remote-mep",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ]
            },
            "cfm loss-measure dual-ended test-id [parameter1]": {
                "template": "cfm loss-measure dual-ended test-id [parameter1]",
                "command": "cfm loss-measure dual-ended test-id 1",
                "explanation": "配置双向损耗测量，测试ID 1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试标识号"
                    }
                ]
            }
        }
    }
}