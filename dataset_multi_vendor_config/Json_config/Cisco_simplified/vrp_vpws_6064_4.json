                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] send-community [parameter2]": {
                "template": "neighbor [parameter1] send-community [parameter2]",
                "command": "neighbor 1.1.1.9 send-community extended",
                "explanation": "配置 BGP 邻居 1.1.1.9 发送扩展团体属性",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居 IP 地址"
                    },
                    {
                        "name": "community type",
                        "type": "string",
