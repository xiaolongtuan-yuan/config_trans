        "template": "mpls l2vpn vfi [parameter1] manual",
        "command": "mpls l2vpn vfi vnp1 manual",
        "explanation": "手动配置 MPLS L2VPN VFI（虚拟转发实例）名称为 'vnp1'",
        "parameters": [
            {
                "name": "vfi name",
                "type": "string",
                "explanation": "VFI 名称"
            }
        ],
        "vpn id [parameter1]": {
            "template": "vpn id [parameter1]",
            "command": "vpn id 1",
            "explanation": "设置 VPN ID 为 1",
            "parameters": [
                {
                    "name": "vpn id",
                    "type": "integer",
                    "explanation": "VPN ID"
                }
            ]
        },
