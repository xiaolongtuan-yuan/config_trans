{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip ospf cost [parameter1]": {
            "template": "ip ospf cost [parameter1]",
            "command": "ip ospf cost 10",
            "explanation": "设置接口的 OSPF 成本为 10",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "OSPF 成本"
                }
            ]
        },
        "ip ospf [parameter1] area [parameter2]": {
            "template": "ip ospf [parameter1] area [parameter2]",
            "command": "ip ospf 1 area 0",
            "explanation": "将接口加入到 OSPF 进程 1 的区域 0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPF 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0",
            "explanation": "将网络 172.16.1.0/24 加入到 OSPF 进程 1 的区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    }
}