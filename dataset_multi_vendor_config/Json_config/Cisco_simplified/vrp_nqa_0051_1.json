{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许 VLAN 10 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许通过的 VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 10",
            "explanation": "配置子接口的 802.1Q 封装，VLAN ID 为 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "arp [parameter1] [parameter2] [parameter3]": {
        "template": "arp [parameter1] [parameter2] [parameter3]",
        "command": "arp 10.1.1.1 00e0.fc12.3456 arpa",
        "explanation": "静态 ARP 配置，将 IP 地址 10.1.1.1 映射到 MAC 地址 00e0.fc12.3456",
        "parameters": [
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IPv4 地址"
            },
            {
                "name": "mac address",
                "type": "MAC",
                "explanation": "MAC 地址"
            },
            {
                "name": "encapsulation type",
                "type": "string",
                "explanation": "封装类型"
            }
        ]
    },
    "ip sla [parameter1]": {
        "template": "ip sla [parameter1]",
        "command": "ip sla 1",
        "explanation": "配置 IP SLA 操作 1",
        "parameters": [
            {
                "name": "operation number",
                "type": "integer",
                "explanation": "IP SLA 操作编号"
            }
        ],
        "icmp-echo [parameter1] source-ip [parameter2]": {
            "template": "icmp-echo [parameter1] source-ip [parameter2]",
            "command": "icmp-echo 10.1.1.1 source-ip 10.1.1.2",
            "explanation": "配置 ICMP echo 操作，目标地址为 10.1.1.1，源地址为 10.1.1.2",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目标 IPv4 地址"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "源 IPv4 地址"
                }
            ]
        },
        "frequency [parameter1]": {
            "template": "frequency [parameter1]",
            "command": "frequency 5",
            "explanation": "设置 IP SLA 操作的频率为 5 秒",
            "parameters": [
                {
                    "name": "frequency",
                    "type": "integer",
                    "explanation": "操作频率（秒）"
                }
            ]
        },
        "timeout [parameter1]": {
            "template": "timeout [parameter1]",
            "command": "timeout 1000",
            "explanation": "设置 IP SLA 操作的超时时间为 1000 毫秒",
            "parameters": [
                {
                    "name": "timeout",
                    "type": "integer",
                    "explanation": "超时时间（毫秒）"
                }
            ]
        },
        "threshold [parameter1]": {
            "template": "threshold [parameter1]",
            "command": "threshold 2",
            "explanation": "设置 IP SLA 操作的阈值为 2",
            "parameters": [
                {
                    "name": "threshold",
                    "type": "integer",
                    "explanation": "阈值"
                }
            ]
        },
        "size [parameter1]": {
            "template": "size [parameter1]",
            "command": "size 64",
            "explanation": "设置 IP SLA 操作的数据包大小为 64 字节",
            "parameters": [
                {
                    "name": "size",
                    "type": "integer",
                    "explanation": "数据包大小（字节）"
                }
            ]
        },
        "tag [parameter1]": {
            "template": "tag [parameter1]",
            "command": "tag admin",
            "explanation": "为 IP SLA 操作设置标签 'admin'",
            "parameters": [
                {
                    "name": "tag",
                    "type": "string",
                    "explanation": "标签"
                }
            ]
        },
        "request-data-size [parameter1]": {
            "template": "request-data-size [parameter1]",
            "command": "request-data-size 0",
            "explanation": "设置 IP SLA 操作的请求数据大小为 0 字节",
            "parameters": [
                {
                    "name": "request data size",
                    "type": "integer",
                    "explanation": "请求数据大小（字节）"
                }
            ]
        },
        "history hours-of-statistics-kept [parameter1]": {
            "template": "history hours-of-statistics-kept [parameter1]",
            "command": "history hours-of-statistics-kept 2",
            "explanation": "设置 IP SLA 操作的历史统计信息保存时间为 2 小时",
            "parameters": [
                {
                    "name": "hours",
                    "type": "integer",
                    "explanation": "保存时间（小时）"
                }
            ]
        },
        "history distributions-of-statistics-kept [parameter1]": {
            "template": "history distributions-of-statistics-kept [parameter1]",
            "command": "history distributions-of-statistics-kept 2",
            "explanation": "设置 IP SLA 操作的历史统计信息分布保存数量为 2",
            "parameters": [
                {
                    "name": "distributions",
                    "type": "integer",
                    "explanation": "分布保存数量"
                }
            ]
        },
        "history buckets-of-statistics-kept [parameter1]": {
            "template": "history buckets-of-statistics-kept [parameter1]",
            "command": "history buckets-of-statistics-kept 2",
            "explanation": "设置 IP SLA 操作的历史统计信息桶保存数量为 2",
            "parameters": [
                {
                    "name": "buckets",
                    "type": "integer",
                    "explanation": "桶保存数量"
                }
            ]
        },
        "history filter [parameter1]": {
            "template": "history filter [parameter1]",
            "command": "history filter all",
            "explanation": "设置 IP SLA 操作的历史统计信息过滤器为 'all'",
            "parameters": [
                {
                    "name": "filter",
                    "type": "string",
                    "explanation": "过滤器"
                }
            ]
        },
        "history enhanced": {
            "template": "history enhanced",
            "command": "history enhanced",
            "explanation": "启用 IP SLA 操作的历史统计信息增强功能",
            "parameters": []
        }
    },
    "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]": {
        "template": "ip sla schedule [parameter1] life [parameter2] start-time [parameter3]",
        "command": "ip sla schedule 1 life forever start-time now",
        "explanation": "调度 IP SLA 操作 1，生命周期为永久，立即开始",
        "parameters": [
            {
                "name": "operation number",
                "type": "integer",
                "explanation": "IP SLA 操作编号"
            },
            {
                "name": "life",
                "type": "string",
                "explanation": "生命周期"
            },
            {
                "name": "start time",
                "type": "string",
                "explanation": "开始时间"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}