{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Hub",
        "explanation": "设置设备的主机名为 'Hub'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.10，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source 10.1.1.10",
            "explanation": "设置隧道的源地址为 10.1.1.10",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "隧道的源地址"
                }
            ]
        },
        "tunnel mode [parameter1]": {
            "template": "tunnel mode [parameter1]",
            "command": "tunnel mode gre multipoint",
            "explanation": "设置隧道模式为 GRE 多点模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "ip ospf network [parameter1]": {
            "template": "ip ospf network [parameter1]",
            "command": "ip ospf network point-to-multipoint",
            "explanation": "设置 OSPF 网络类型为点对多点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "OSPF 网络类型"
                }
            ]
        },
        "ip nhrp map multicast [parameter1]": {
            "template": "ip nhrp map multicast [parameter1]",
            "command": "ip nhrp map multicast dynamic",
            "explanation": "配置 NHRP 映射多播地址为动态",
            "parameters": [
                {
                    "name": "multicast mapping",
                    "type": "string",
                    "explanation": "NHRP 多播映射"
                }
            ]
        },
        "ip nhrp redirect": {
            "template": "ip nhrp redirect",
            "command": "ip nhrp redirect",
            "explanation": "启用 NHRP 重定向功能",
            "parameters": []
        },
        "ip nhrp nhs [parameter1] nbma [parameter2]": {
            "template": "ip nhrp nhs [parameter1] nbma [parameter2]",
            "command": "ip nhrp nhs 172.16.1.2 nbma 10.1.1.2",
            "explanation": "配置 NHRP 下一跳服务器为 172.16.1.2，NBMA 地址为 10.1.1.2",
            "parameters": [
                {
                    "name": "nhs address",
                    "type": "IPv4",
                    "explanation": "NHRP 下一跳服务器地址"
                },
                {
                    "name": "nbma address",
                    "type": "IPv4",
                    "explanation": "NBMA 地址"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "设置 OSPF 路由器的 ID 为 172.16.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF 路由器 ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0",
            "explanation": "配置 OSPF 网络 172.16.1.0/24 属于区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}