{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1.1",
        "explanation": "配置接口 'GigabitEthernet3/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 200",
            "explanation": "配置接口的封装类型为 dot1Q，并指定 VLAN ID 为 200",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        }
    },
    "cfm mep domain [parameter1]": {
        "template": "cfm mep domain [parameter1]",
        "command": "cfm mep domain md3",
        "explanation": "配置 CFM MEP 域为 'md3'",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名称"
            }
        ]
    },
    "cfm mep ma [parameter1]": {
        "template": "cfm mep ma [parameter1]",
        "command": "cfm mep ma ma3",
        "explanation": "配置 CFM MEP 维护关联为 'ma3'",
        "parameters": [
            {
                "name": "maintenance association name",
                "type": "string",
                "explanation": "维护关联名称"
            }
        ]
    },
    "cfm mep mep-id [parameter1] interface [parameter2] service vlan [parameter3] md [parameter4] ma [parameter5]": {
        "template": "cfm mep mep-id [parameter1] interface [parameter2] service vlan [parameter3] md [parameter4] ma [parameter5]",
        "command": "cfm mep mep-id 4 interface GigabitEthernet3/0/1.1 service vlan 200 md md3 ma ma3",
        "explanation": "配置 CFM MEP ID 为 4，关联接口 'GigabitEthernet3/0/1.1'，服务 VLAN 200，域 'md3'，维护关联 'ma3'",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN 标识符"
            },
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名称"
            },
            {
                "name": "maintenance association name",
                "type": "string",
                "explanation": "维护关联名称"
            }
        ]
    },
    "cfm mep mep-id [parameter1] ccm-send enable": {
        "template": "cfm mep mep-id [parameter1] ccm-send enable",
        "command": "cfm mep mep-id 4 ccm-send enable",
        "explanation": "启用 CFM MEP ID 4 的 CCM 发送功能",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            }
        ]
    },
    "cfm mep mep-id [parameter1] remote-mep": {
        "template": "cfm mep mep-id [parameter1] remote-mep",
        "command": "cfm mep mep-id 3 remote-mep",
        "explanation": "配置 CFM MEP ID 3 的远程 MEP",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            }
        ]
    },
    "cfm mep mep-id [parameter1] remote-mep ccm-receive enable": {
        "template": "cfm mep mep-id [parameter1] remote-mep ccm-receive enable",
        "command": "cfm mep mep-id 3 remote-mep ccm-receive enable",
        "explanation": "启用 CFM MEP ID 3 的远程 MEP CCM 接收功能",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            }
        ]
    },
    "cfm mep mep-id [parameter1] test [parameter2]": {
        "template": "cfm mep mep-id [parameter1] test [parameter2]",
        "command": "cfm mep mep-id 4 test 1",
        "explanation": "在 CFM MEP ID 4 上启动测试 1",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            },
            {
                "name": "test ID",
                "type": "integer",
                "explanation": "测试标识符"
            }
        ]
    },
    "cfm mep mep-id [parameter1] delay-measure two-way receive test-id [parameter2]": {
        "template": "cfm mep mep-id [parameter1] delay-measure two-way receive test-id [parameter2]",
        "command": "cfm mep mep-id 4 delay-measure two-way receive test-id 1",
        "explanation": "在 CFM MEP ID 4 上配置双向延迟测量，接收测试 ID 1",
        "parameters": [
            {
                "name": "MEP ID",
                "type": "integer",
                "explanation": "维护端点标识符"
            },
            {
                "name": "test ID",
                "type": "integer",
                "explanation": "测试标识符"
            }
        ]
    }
}