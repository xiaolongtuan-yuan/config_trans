{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "将子接口关联到桥域 '10'",
        "parameters": [
            {
                "name": "bridge domain ID",
                "type": "integer",
                "explanation": "桥域ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk10",
        "explanation": "配置接口 'Eth-Trunk10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 10 mode on",
            "explanation": "将接口加入到通道组 '10'，模式为 'on'",
            "parameters": [
                {
                    "name": "channel group ID",
                    "type": "integer",
                    "explanation": "通道组ID"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式"
                }
            ]
        }
    },
    "encapsulation dot1q [parameter1]": {
        "template": "encapsulation dot1q [parameter1]",
        "command": "encapsulation dot1q 100",
        "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 100",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "exit": {
        "template": "exit",
        "command": "exit",
        "explanation": "退出当前配置模式",
        "parameters": []
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式并保存配置",
        "parameters": []
    }
}