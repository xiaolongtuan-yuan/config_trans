{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.4.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.4.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "ip igmp join-group [parameter1]": {
            "template": "ip igmp join-group [parameter1]",
            "command": "ip igmp join-group 224.0.0.1",
            "explanation": "使接口加入组播组 224.0.0.1",
            "parameters": [
                {
                    "name": "multicast group",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置BGP进程，AS号为200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 192.168.3.1 remote-as 200",
            "explanation": "配置BGP邻居，IP地址为192.168.3.1，AS号为200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.3.1 activate",
                "explanation": "激活邻居192.168.3.1的IPv4单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居IP地址"
                    }
                ]
            }
        },
        "address-family ipv4 multicast": {
            "template": "address-family ipv4 multicast",
            "command": "address-family ipv4 multicast",
            "explanation": "进入IPv4组播地址族配置模式",
            "parameters": [],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.3.1 activate",
                "explanation": "激活邻居192.168.3.1的IPv4组播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居IP地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF进程，进程号为1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程号"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.3.0 0.0.0.255 area 0",
            "explanation": "将网络192.168.3.0/24加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}