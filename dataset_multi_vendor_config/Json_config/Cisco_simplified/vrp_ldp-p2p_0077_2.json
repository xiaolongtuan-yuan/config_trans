        "parameters": [
            {
                "name": "lsr-id",
                "type": "IPv4",
                "explanation": "MPLS LSR ID"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "进入 MPLS 配置模式",
        "parameters": [],
        "ldp": {
            "template": "ldp",
            "command": "ldp",
            "explanation": "进入 LDP 配置模式",
            "parameters": [],
