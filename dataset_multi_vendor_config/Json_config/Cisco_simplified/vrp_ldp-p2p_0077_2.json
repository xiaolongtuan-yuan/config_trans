                "template": "advertise-label",
                "command": "advertise-label",
                "explanation": "启用标签分发",
                "parameters": []
            }
        }
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "进入 MPLS LDP 配置模式",
        "parameters": []
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0003.00",
            "explanation": "设置 IS-IS 的网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-2-only",
            "explanation": "设置 IS-IS 路由类型为仅 Level-2",
            "parameters": [
                {
                    "name": "is-type",
                    "type": "string",
                    "explanation": "IS-IS 路由类型"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.4.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.4.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
