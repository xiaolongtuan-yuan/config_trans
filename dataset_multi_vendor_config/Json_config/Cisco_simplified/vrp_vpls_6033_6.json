    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用 MPLS LDP 功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
