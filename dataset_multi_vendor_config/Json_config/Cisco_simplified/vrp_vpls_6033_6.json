            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.4.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.4.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 功能",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP 功能",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 1",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect [parameter1] [parameter2] encapsulation [parameter3]": {
            "template": "xconnect [parameter1] [parameter2] encapsulation [parameter3]",
            "command": "xconnect 3.3.3.9 100 encapsulation mpls",
            "explanation": "配置子接口的 MPLS L2VPN 连接，对端地址为 3.3.3.9，VC ID 为 100，封装类型为 MPLS",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "对端地址"
                },
                {
                    "name": "vc id",
                    "type": "integer",
                    "explanation": "VC ID"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 5.5.5.9 0.0.0.0 area 0.0.0.0",
