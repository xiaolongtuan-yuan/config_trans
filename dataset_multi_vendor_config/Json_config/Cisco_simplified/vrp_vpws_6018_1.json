            "parameters": [
                {
                    "name": "template name",
                    "type": "string",
                    "explanation": "模板名"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "配置 trunk 接口允许的 VLAN 为 2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "bfd all-interfaces": {
        "template": "bfd all-interfaces",
        "command": "bfd all-interfaces",
        "explanation": "在所有接口上启用 BFD",
        "parameters": []
    },
    "bfd template single-hop [parameter1]": {
        "template": "bfd template single-hop [parameter1]",
        "command": "bfd template single-hop CPE1",
        "explanation": "配置单跳 BFD 模板 'CPE1'",
        "parameters": [
            {
                "name": "template name",
                "type": "string",
                "explanation": "模板名"
            }
        ],
        "interval min-tx [parameter1] min-rx [parameter2] multiplier [parameter3]": {
            "template": "interval min-tx [parameter1] min-rx [parameter2] multiplier [parameter3]",
            "command": "interval min-tx 100 min-rx 100 multiplier 3",
            "explanation": "配置 BFD 发送间隔为 100ms，接收间隔为 100ms，乘数为 3",
            "parameters": [
                {
                    "name": "min-tx",
                    "type": "integer",
                    "explanation": "最小发送间隔（毫秒）"
                },
                {
                    "name": "min-rx",
                    "type": "integer",
                    "explanation": "最小接收间隔（毫秒）"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        }
