    },
    "bfd discriminator remote [parameter1]": {
        "template": "bfd discriminator remote [parameter1]",
        "command": "bfd discriminator remote 16",
        "explanation": "配置远程 BFD 鉴别器为 16",
        "parameters": [
            {
                "name": "discriminator",
                "type": "integer",
                "explanation": "鉴别器"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
