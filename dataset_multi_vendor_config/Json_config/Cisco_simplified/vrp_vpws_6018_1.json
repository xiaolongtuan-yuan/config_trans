        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入 BFD 配置模式",
        "parameters": []
    },
    "interface [parameter1]": {
