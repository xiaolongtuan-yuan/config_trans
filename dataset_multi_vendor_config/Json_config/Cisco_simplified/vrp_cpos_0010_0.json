{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "controller [parameter1]": {
        "template": "controller [parameter1]",
        "command": "controller E1 3/0/0",
        "explanation": "配置 E1 控制器 '3/0/0'",
        "parameters": [
            {
                "name": "controller name",
                "type": "string",
                "explanation": "控制器名"
            }
        ],
        "channel-group [parameter1] timeslots [parameter2]": {
            "template": "channel-group [parameter1] timeslots [parameter2]",
            "command": "channel-group 1 timeslots 1-10",
            "explanation": "配置通道组 1 的时隙为 1-10",
            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "时隙范围"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用控制器（默认情况下控制器是关闭的）",
            "parameters": []
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial3/0/0/1:1",
        "explanation": "配置接口 'Serial3/0/0/1:1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation [parameter1]": {
            "template": "encapsulation [parameter1]",
            "command": "encapsulation ppp",
            "explanation": "配置接口的封装类型为 PPP",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "ppp multilink group [parameter1]": {
            "template": "ppp multilink group [parameter1]",
            "command": "ppp multilink group 1",
            "explanation": "配置接口的 PPP 多链路组为 1",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "组编号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}