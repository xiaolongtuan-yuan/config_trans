{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.0 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.17.1.0，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 150 min_rx 150 multiplier 3",
            "explanation": "配置 BFD 会话的间隔为 150ms，最小接收间隔为 150ms，乘数为 3",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "BFD 会话间隔（毫秒）"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "最小接收间隔（毫秒）"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        },
        "bfd echo interface [parameter1]": {
            "template": "bfd echo interface [parameter1]",
            "command": "bfd echo interface GigabitEthernet1/0/0",
            "explanation": "配置 BFD echo 模式，使用接口 'GigabitEthernet1/0/0'",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route 172.16.1.0 255.255.255.0 GigabitEthernet2/0/0 192.168.11.2",
        "explanation": "配置静态路由，目的网络为 172.16.1.0/24，下一跳为 192.168.11.2，出接口为 GigabitEthernet2/0/0",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "出接口名"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}