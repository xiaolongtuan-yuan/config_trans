{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "强制使用 Loopback0 接口的 IP 地址作为 MPLS LDP 的路由器 ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "在设备上启用 MPLS IP 转发功能",
        "parameters": []
    },
    "segment-routing": {
        "template": "segment-routing",
        "command": "segment-routing",
        "explanation": "启用段路由功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.9",
            "explanation": "设置 OSPF 的路由器 ID 为 2.2.2.9",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "mpls ldp autoconfig area [parameter1]": {
            "template": "mpls ldp autoconfig area [parameter1]",
            "command": "mpls ldp autoconfig area 0.0.0.0",
            "explanation": "在 OSPF 区域 0.0.0.0 上自动配置 MPLS LDP",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "mpls traffic-eng router-id [parameter1]": {
        "template": "mpls traffic-eng router-id [parameter1]",
        "command": "mpls traffic-eng router-id Loopback1",
        "explanation": "使用 Loopback1 接口的 IP 地址作为 MPLS 流量工程的路由器 ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls traffic-eng area [parameter1]": {
        "template": "mpls traffic-eng area [parameter1]",
        "command": "mpls traffic-eng area 0.0.0.0",
        "explanation": "在 OSPF 区域 0.0.0.0 上启用 MPLS 流量工程",
        "parameters": [
            {
                "name": "area id",
                "type": "IPv4",
                "explanation": "OSPF 区域 ID"
            }
        ]
    },
    "mpls traffic-eng global-reserved-bandwidth [parameter1] [parameter2]": {
        "template": "mpls traffic-eng global-reserved-bandwidth [parameter1] [parameter2]",
        "command": "mpls traffic-eng global-reserved-bandwidth 16000 47999",
        "explanation": "设置全局保留带宽为 16000 到 47999",
        "parameters": [
            {
                "name": "minimum bandwidth",
                "type": "integer",
                "explanation": "最小带宽"
            },
            {
                "name": "maximum bandwidth",
                "type": "integer",
                "explanation": "最大带宽"
            }
        ]
    },
    "mpls traffic-eng link-management": {
        "template": "mpls traffic-eng link-management",
        "command": "mpls traffic-eng link-management",
        "explanation": "启用 MPLS 流量工程的链路管理功能",
        "parameters": []
    },
    "mpls traffic-eng topology": {
        "template": "mpls traffic-eng topology",
        "command": "mpls traffic-eng topology",
        "explanation": "启用 MPLS 流量工程的拓扑功能",
        "parameters": []
    },
    "mpls traffic-eng interface [parameter1]": {
        "template": "mpls traffic-eng interface [parameter1]",
        "command": "mpls traffic-eng interface GigabitEthernet1/0/0",
        "explanation": "在接口 'GigabitEthernet1/0/0' 上启用 MPLS 流量工程",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}