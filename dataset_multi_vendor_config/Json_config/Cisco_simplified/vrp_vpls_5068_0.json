{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置MPLS标签分发协议为LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls l2vpn": {
        "template": "mpls l2vpn",
        "command": "mpls l2vpn",
        "explanation": "启用MPLS L2VPN功能",
        "parameters": []
    },
    "vfi [parameter1] manual": {
        "template": "vfi [parameter1] manual",
        "command": "vfi vsi1 manual",
        "explanation": "手动配置虚拟转发实例(VFI) 'vsi1'",
        "parameters": [
            {
                "name": "vfi name",
                "type": "string",
                "explanation": "虚拟转发实例名称"
            }
        ],
        "vpn id [parameter1]": {
            "template": "vpn id [parameter1]",
            "command": "vpn id 1",
            "explanation": "配置VPN ID为1",
            "parameters": [
                {
                    "name": "vpn id",
                    "type": "integer",
                    "explanation": "VPN标识符"
                }
            ]
        },
        "neighbor [parameter1] pw-id [parameter2]": {
            "template": "neighbor [parameter1] pw-id [parameter2]",
            "command": "neighbor 2.2.2.2 pw-id 1",
            "explanation": "配置邻居2.2.2.2的伪线ID为1",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居IP地址"
                },
                {
                    "name": "pseudo-wire id",
                    "type": "integer",
                    "explanation": "伪线标识符"
                }
            ]
        }
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用MPLS LDP功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP功能",
            "parameters": []
        },
        "mpls ldp autoconfig": {
            "template": "mpls ldp autoconfig",
            "command": "mpls ldp autoconfig",
            "explanation": "在接口上自动配置MPLS LDP",
            "parameters": []
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "配置子接口的封装类型为Dot1Q，VLAN ID为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN标识符"
                }
            ]
        },
        "xconnect vfi [parameter1]": {
            "template": "xconnect vfi [parameter1]",
            "command": "xconnect vfi vsi1",
            "explanation": "将子接口连接到虚拟转发实例 'vsi1'",
            "parameters": [
                {
                    "name": "vfi name",
                    "type": "string",
                    "explanation": "虚拟转发实例名称"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程标识符"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.1.1 0.0.0.0 area 0",
            "explanation": "将IP地址1.1.1.1/32加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域标识符"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}