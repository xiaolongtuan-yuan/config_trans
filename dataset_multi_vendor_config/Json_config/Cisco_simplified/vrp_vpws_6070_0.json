{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建 VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ethernet cfm": {
        "template": "ethernet cfm",
        "command": "ethernet cfm",
        "explanation": "启用以太网连接故障管理（CFM）",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan10",
        "explanation": "配置 VLAN 10 的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1] [parameter2]": {
            "template": "switchport trunk allowed vlan [parameter1] [parameter2]",
            "command": "switchport trunk allowed vlan add 10",
            "explanation": "允许 VLAN 10 通过 trunk 接口",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "操作类型（add/remove）"
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "ethernet cfm md [parameter1]": {
        "template": "ethernet cfm md [parameter1]",
        "command": "ethernet cfm md md1",
        "explanation": "配置以太网 CFM 维护域 'md1'",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "eth cfm ma [parameter1]": {
            "template": "eth cfm ma [parameter1]",
            "command": "eth cfm ma ma1",
            "explanation": "配置以太网 CFM 维护关联 'ma1'",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep domain vlan [parameter1]": {
                "template": "mep domain vlan [parameter1]",
                "command": "mep domain vlan 10",
                "explanation": "配置 MEP 域为 VLAN 10",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ],
                "mep id [parameter1]": {
                    "template": "mep id [parameter1]",
                    "command": "mep id 2",
                    "explanation": "配置 MEP ID 为 2",
                    "parameters": [
                        {
                            "name": "mep id",
                            "type": "integer",
                            "explanation": "MEP ID"
                        }
                    ],
                    "interface [parameter1]": {
                        "template": "interface [parameter1]",
                        "command": "interface GigabitEthernet1/0/0",
                        "explanation": "配置 MEP 的接口为 'GigabitEthernet1/0/0'",
                        "parameters": [
                            {
                                "name": "interface name",
                                "type": "string",
                                "explanation": "接口名"
                            }
                        ]
                    },
                    "direction [parameter1]": {
                        "template": "direction [parameter1]",
                        "command": "direction outward",
                        "explanation": "配置 MEP 方向为向外",
                        "parameters": [
                            {
                                "name": "direction",
                                "type": "string",
                                "explanation": "方向"
                            }
                        ]
                    },
                    "ccm send": {
                        "template": "ccm send",
                        "command": "ccm send",
                        "explanation": "启用 CCM 发送",
                        "parameters": []
                    }
                },
                "remote-mep id [parameter1]": {
                    "template": "remote-mep id [parameter1]",
                    "command": "remote-mep id 1",
                    "explanation": "配置远程 MEP ID 为 1",
                    "parameters": [
                        {
                            "name": "remote mep id",
                            "type": "integer",
                            "explanation": "远程 MEP ID"
                        }
                    ],
                    "ccm receive": {
                        "template": "ccm receive",
                        "command": "ccm receive",
                        "explanation": "启用 CCM 接收",
                        "parameters": []
                    }
                }
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}