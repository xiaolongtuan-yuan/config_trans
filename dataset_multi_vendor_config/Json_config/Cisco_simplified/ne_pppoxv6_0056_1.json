{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitEthernet1/0/0",
        "explanation": "配置接口 'gigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用IPv6功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址为2001:db8:1::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "进入BGP配置模式，AS号为100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统(AS)号"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 5.5.5.5",
            "explanation": "设置BGP的路由器ID为5.5.5.5",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:db8:1::2 remote-as 200",
            "explanation": "配置邻居路由器，地址为2001:db8:1::2，AS号为200",
            "parameters": [
                {
                    "name": "neighbor address",
                    "type": "IPv6",
                    "explanation": "邻居路由器的地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的AS号"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                },
                {
                    "name": "subtype",
                    "type": "string",
                    "explanation": "子类型，如unicast"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用同步",
                "parameters": []
            },
            "network [parameter1]": {
                "template": "network [parameter1]",
                "command": "network 2001:db8:5::5/128",
                "explanation": "通告网络2001:db8:5::5/128",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv6 with mask",
                        "explanation": "要通告的网络地址及掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:db8:1::2 activate",
                "explanation": "激活与邻居2001:db8:1::2的会话",
                "parameters": [
                    {
                        "name": "neighbor address",
                        "type": "IPv6",
                        "explanation": "邻居路由器的地址"
                    }
                ]
            }
        }
    }
}