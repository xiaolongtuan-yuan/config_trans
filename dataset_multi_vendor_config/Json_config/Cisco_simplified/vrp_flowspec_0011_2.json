    "access-list [parameter1] permit [parameter2] [parameter3] [parameter4] eq [parameter5]": {
        "template": "access-list [parameter1] permit [parameter2] [parameter3] [parameter4] eq [parameter5]",
        "command": "access-list 100 permit tcp any any eq 159",
