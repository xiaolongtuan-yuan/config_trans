{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device1",
        "explanation": "设置设备的主机名为 'Device1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "license boot module [parameter1]": {
        "template": "license boot module [parameter1]",
        "command": "license boot module c9400npe-flex",
        "explanation": "配置设备启动时加载的许可证模块为 'c9400npe-flex'",
        "parameters": [
            {
                "name": "module name",
                "type": "string",
                "explanation": "模块名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface TenGigabitEthernet1/1/1",
        "explanation": "配置接口 'TenGigabitEthernet1/1/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan all",
            "explanation": "允许所有 VLAN 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "string",
                    "explanation": "VLAN 列表"
                }
            ]
        },
        "switchport nonegotiate": {
            "template": "switchport nonegotiate",
            "command": "switchport nonegotiate",
            "explanation": "禁止接口进行 DTP 协商",
            "parameters": []
        }
    },
    "flexe group [parameter1]": {
        "template": "flexe group [parameter1]",
        "command": "flexe group 1",
        "explanation": "配置 FlexE 组号为 1",
        "parameters": [
            {
                "name": "group number",
                "type": "integer",
                "explanation": "组号"
            }
        ],
        "sub-time-slot granularity [parameter1] interface [parameter2]": {
            "template": "sub-time-slot granularity [parameter1] interface [parameter2]",
            "command": "sub-time-slot granularity 1G interface TenGigabitEthernet1/1/1:0-1",
            "explanation": "配置 FlexE 子时间槽粒度为 1G，并绑定到接口 'TenGigabitEthernet1/1/1:0-1'",
            "parameters": [
                {
                    "name": "granularity",
                    "type": "string",
                    "explanation": "粒度"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "binding interface [parameter1]": {
            "template": "binding interface [parameter1]",
            "command": "binding interface FlexE-50|100G1/1/1",
            "explanation": "绑定接口 'FlexE-50|100G1/1/1' 到 FlexE 组",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "flexe-group-num [parameter1]": {
            "template": "flexe-group-num [parameter1]",
            "command": "flexe-group-num 2345",
            "explanation": "配置 FlexE 组号为 2345",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "组号"
                }
            ]
        }
    },
    "flexe client-instance [parameter1] flexe-group [parameter2] flexe-type [parameter3] port-id [parameter4]": {
        "template": "flexe client-instance [parameter1] flexe-group [parameter2] flexe-type [parameter3] port-id [parameter4]",
        "command": "flexe client-instance 1 flexe-group 1 flexe-type full-function port-id 129",
        "explanation": "配置 FlexE 客户端实例 1，属于 FlexE 组 1，类型为全功能，端口 ID 为 129",
        "parameters": [
            {
                "name": "client instance",
                "type": "integer",
                "explanation": "客户端实例号"
            },
            {
                "name": "flexe group",
                "type": "integer",
                "explanation": "FlexE 组号"
            },
            {
                "name": "flexe type",
                "type": "string",
                "explanation": "FlexE 类型"
            },
            {
                "name": "port id",
                "type": "integer",
                "explanation": "端口 ID"
            }
        ],
        "bandwidth [parameter1]": {
            "template": "bandwidth [parameter1]",
            "command": "bandwidth 4000",
            "explanation": "配置带宽为 4000",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "带宽"
                }
            ]
        },
        "client-id [parameter1]": {
            "template": "client-id [parameter1]",
            "command": "client-id 1",
            "explanation": "配置客户端 ID 为 1",
            "parameters": [
                {
                    "name": "client id",
                    "type": "integer",
                    "explanation": "客户端 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}