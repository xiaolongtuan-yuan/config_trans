{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls traffic-eng tunnels": {
        "template": "mpls traffic-eng tunnels",
        "command": "mpls traffic-eng tunnels",
        "explanation": "启用 MPLS 流量工程隧道功能",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "xconnect [parameter1] [parameter2] encapsulation [parameter3]": {
            "template": "xconnect [parameter1] [parameter2] encapsulation [parameter3]",
            "command": "xconnect CE1-CE2 100 encapsulation mpls",
            "explanation": "配置接口的交叉连接，使用 MPLS 封装",
            "parameters": [
                {
                    "name": "peer",
                    "type": "string",
                    "explanation": "对等体标识"
                },
                {
                    "name": "vc id",
                    "type": "integer",
                    "explanation": "虚拟电路标识"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "mpls traffic-eng tunnel destination [parameter1]": {
            "template": "mpls traffic-eng tunnel destination [parameter1]",
            "command": "mpls traffic-eng tunnel destination 10.1.1.2",
            "explanation": "配置 MPLS 流量工程隧道的目的地址",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目的 IPv4 地址"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}