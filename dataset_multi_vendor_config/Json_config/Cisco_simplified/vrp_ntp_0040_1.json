{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.0.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.0.1.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "ntp authentication-key [parameter1] md5 [parameter2]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2]",
        "command": "ntp authentication-key 42 md5 %#%#>hD8))_H-XZVut2u3!_0lq3,+Ph=:OE}pX;T2M'9%#%#",
        "explanation": "配置 NTP 认证密钥 ID 42，使用 MD5 加密",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            },
            {
                "name": "md5 key",
                "type": "string",
                "explanation": "MD5 加密的密钥"
            }
        ]
    },
    "ntp trusted-key [parameter1]": {
        "template": "ntp trusted-key [parameter1]",
        "command": "ntp trusted-key 42",
        "explanation": "配置 NTP 信任的密钥 ID 42",
        "parameters": [
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            }
        ]
    },
    "ntp server [parameter1] key [parameter2] source [parameter3]": {
        "template": "ntp server [parameter1] key [parameter2] source [parameter3]",
        "command": "ntp server 2.2.2.2 key 42 source GigabitEthernet1/0/0",
        "explanation": "配置 NTP 服务器地址为 2.2.2.2，使用密钥 ID 42，源接口为 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP 服务器地址"
            },
            {
                "name": "key id",
                "type": "integer",
                "explanation": "密钥 ID"
            },
            {
                "name": "source interface",
                "type": "string",
                "explanation": "源接口"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}