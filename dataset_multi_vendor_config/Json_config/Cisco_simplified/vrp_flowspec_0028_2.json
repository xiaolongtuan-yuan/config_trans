        "parameters": [
            {
                "name": "access-list name",
                "type": "string",
                "explanation": "访问控制列表名称"
            }
        ],
        "permit tcp any any eq [parameter1]": {
            "template": "permit tcp any any eq [parameter1]",
            "command": "permit tcp any any eq 159",
            "explanation": "允许任何源地址到任何目的地址的 TCP 流量，目的端口号为 159",
            "parameters": [
                {
                    "name": "destination port",
                    "type": "integer",
                    "explanation": "目的端口号"
                }
            ]
        }
    },
