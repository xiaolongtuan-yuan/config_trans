        "parameters": [
            {
                "name": "address family",
                "type": "string",
                "explanation": "地址族类型"
            },
            {
                "name": "vrf name",
                "type": "string",
                "explanation": "VRF 名称"
            }
        ],
        "neighbor [parameter1] activate": {
            "template": "neighbor [parameter1] activate",
            "command": "neighbor 10.2.1.1 activate",
