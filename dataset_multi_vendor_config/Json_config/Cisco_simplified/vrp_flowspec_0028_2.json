                "explanation": "路由映射名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（允许或拒绝）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "match ipv6 source-port [parameter1]": {
            "template": "match ipv6 source-port [parameter1]",
            "command": "match ipv6 source-port 159",
