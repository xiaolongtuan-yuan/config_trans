            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                }
            ]
        }
    },
    "address-family [parameter1]": {
        "template": "address-family [parameter1]",
        "command": "address-family ipv6",
        "explanation": "进入 IPv6 地址族配置模式",
        "parameters": [
            {
                "name": "address family",
                "type": "string",
                "explanation": "地址族类型"
            }
        ],
        "neighbor [parameter1] activate": {
            "template": "neighbor [parameter1] activate",
            "command": "neighbor 10.2.1.1 activate",
            "explanation": "在 IPv6 地址族下激活与邻居 10.2.1.1 的 BGP 会话",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                }
            ]
        },
        "no synchronization": {
            "template": "no synchronization",
            "command": "no synchronization",
            "explanation": "禁用 BGP 和 IGP 同步",
            "parameters": []
        }
    },
    "vrf definition [parameter1]": {
        "template": "vrf definition [parameter1]",
        "command": "vrf definition vpna",
        "explanation": "定义名为 'vpna' 的 VRF",
        "parameters": [
            {
                "name": "vrf name",
                "type": "string",
                "explanation": "VRF 名称"
            }
        ]
    },
    "address-family [parameter1] vrf [parameter2]": {
        "template": "address-family [parameter1] vrf [parameter2]",
