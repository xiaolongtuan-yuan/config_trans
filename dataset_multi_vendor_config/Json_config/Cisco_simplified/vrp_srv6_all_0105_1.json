{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001::2/96",
            "explanation": "配置接口的 IPv6 地址为 2001::2，前缀长度为 96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf [parameter1] area [parameter2]": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0",
            "explanation": "将接口加入到 OSPFv3 进程 1 的区域 0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPFv3 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "配置 OSPFv3 进程 1",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPFv3 进程 1 的路由器 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "area [parameter1] range [parameter2]": {
            "template": "area [parameter1] range [parameter2]",
            "command": "area 0 range 2001::/96",
            "explanation": "在 OSPFv3 进程 1 的区域 0 中汇总 2001::/96 网络",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                },
                {
                    "name": "ipv6 network",
                    "type": "IPv6",
                    "explanation": "IPv6 网络地址"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}