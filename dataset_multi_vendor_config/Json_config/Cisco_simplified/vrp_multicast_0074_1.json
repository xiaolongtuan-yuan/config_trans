{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "ip prefix-list [parameter1] seq [parameter2] permit [parameter3] le [parameter4]": {
        "template": "ip prefix-list [parameter1] seq [parameter2] permit [parameter3] le [parameter4]",
        "command": "ip prefix-list list-c seq 10 permit 192.168.0.0/16 le 32",
        "explanation": "配置IP前缀列表，允许192.168.0.0/16网段，前缀长度小于等于32",
        "parameters": [
            {
                "name": "prefix-list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            },
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "网络地址"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "前缀长度"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.3.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.3.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        }
    },
    "ip pim rp-candidate [parameter1]": {
        "template": "ip pim rp-candidate [parameter1]",
        "command": "ip pim rp-candidate Loopback0",
        "explanation": "配置Loopback0接口为PIM RP候选",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "ip pim rp-address [parameter1]": {
        "template": "ip pim rp-address [parameter1]",
        "command": "ip pim rp-address 2.2.2.2",
        "explanation": "配置2.2.2.2为PIM RP地址",
        "parameters": [
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IPv4 地址"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.3.0 0.0.0.255 area 0",
            "explanation": "将192.168.3.0/24网络加入到OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "ip msdp peer [parameter1] connect-source [parameter2]": {
        "template": "ip msdp peer [parameter1] connect-source [parameter2]",
        "command": "ip msdp peer 192.168.1.1 connect-source GigabitEthernet1/0/0",
        "explanation": "配置MSDP对等体192.168.1.1，连接源为GigabitEthernet1/0/0接口",
        "parameters": [
            {
                "name": "peer ip address",
                "type": "IPv4",
                "explanation": "对等体IP地址"
            },
            {
                "name": "connect-source interface",
                "type": "string",
                "explanation": "连接源接口"
            }
        ]
    },
    "ip msdp originator-id [parameter1]": {
        "template": "ip msdp originator-id [parameter1]",
        "command": "ip msdp originator-id 192.168.1.1",
        "explanation": "配置MSDP源ID为192.168.1.1",
        "parameters": [
            {
                "name": "originator id",
                "type": "IPv4",
                "explanation": "源ID"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}