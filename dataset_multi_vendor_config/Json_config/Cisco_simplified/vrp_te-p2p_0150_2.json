{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P2",
        "explanation": "设置设备的主机名为 'P2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "强制使用Loopback0接口的IP地址作为MPLS LDP的Router ID",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "设置MPLS标签分发协议为LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议名"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入IS-IS路由进程配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0000.0002.00",
            "explanation": "配置IS-IS的网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "设置IS-IS的度量风格为wide",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "度量风格"
                }
            ]
        },
        "mpls traffic-eng [parameter1]": {
            "template": "mpls traffic-eng [parameter1]",
            "command": "mpls traffic-eng level-1-2",
            "explanation": "在IS-IS的level-1和level-2中启用MPLS流量工程",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "IS-IS级别"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis circuit-type [parameter1]": {
            "template": "isis circuit-type [parameter1]",
            "command": "isis circuit-type level-1-2",
            "explanation": "设置IS-IS电路类型为level-1-2",
            "parameters": [
                {
                    "name": "circuit type",
                    "type": "string",
                    "explanation": "电路类型"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用MPLS IP",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}