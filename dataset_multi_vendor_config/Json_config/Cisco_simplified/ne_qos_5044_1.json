    "class-map match-any [parameter1]": {
        "template": "class-map match-any [parameter1]",
        "command": "class-map match-any COS5",
        "explanation": "定义一个类映射，名称为 COS5，匹配方式为 match-any",
        "parameters": [
            {
                "name": "class-map-name",
                "type": "string",
                "explanation": "类映射的名称"
            }
        ],
        "match cos [parameter1]": {
            "template": "match cos [parameter1]",
            "command": "match cos 5",
            "explanation": "匹配 CoS 值为 5 的流量",
            "parameters": [
                {
                    "name": "cos-value",
                    "type": "integer",
                    "explanation": "CoS 值，范围通常是 0-7"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map COS5-POLICY",
        "explanation": "定义一个策略映射，名称为 COS5-POLICY",
        "parameters": [
            {
                "name": "policy-map-name",
                "type": "string",
                "explanation": "策略映射的名称"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class COS5",
            "explanation": "指定类映射 COS5",
            "parameters": [
                {
                    "name": "class-map-name",
                    "type": "string",
                    "explanation": "要应用的类映射名称"
                }
            ],
            "priority [parameter1]": {
                "template": "priority [parameter1]",
                "command": "priority 800",
                "explanation": "设置优先级队列，带宽为 800 kbps",
                "parameters": [
                    {
                        "name": "bandwidth",
                        "type": "integer",
                        "explanation": "优先级队列的带宽，单位 kbps"
                    }
                ]
            },
            "random-detect cos [parameter1] [parameter2] [parameter3] [parameter4]": {
                "template": "random-detect cos [parameter1] [parameter2] [parameter3] [parameter4]",
                "command": "random-detect cos 5 50 50 1",
                "explanation": "设置 CoS 为 5 的流量的 WRED 参数，最小阈值 50%，最大阈值 50%，丢弃概率 1%",
                "parameters": [
                    {
                        "name": "cos-value",
                        "type": "integer",
                        "explanation": "CoS 值"
                    },
                    {
                        "name": "min-threshold",
                        "type": "percentage",
                        "explanation": "最小阈值，百分比"
                    },
                    {
                        "name": "max-threshold",
                        "type": "percentage",
                        "explanation": "最大阈值，百分比"
                    },
                    {
                        "name": "drop-probability",
                        "type": "percentage",
                        "explanation": "丢弃概率，百分比"
                    }
                ]
            },
            "police [parameter1] [parameter2] [parameter3] conform-action [parameter4] exceed-action [parameter5] violate-action [parameter6]": {
                "template": "police [parameter1] [parameter2] [parameter3] conform-action [parameter4] exceed-action [parameter5] violate-action [parameter6]",
                "command": "police 120000 8000 8000 conform-action transmit exceed-action transmit violate-action drop",
                "explanation": "对流量进行速率限制，设置承诺信息速率 (CIR) 为 120000 bps，承诺突发尺寸 (CBS) 为 8000 bytes，超额突发尺寸 (EBS) 为 8000 bytes。符合 CIR 的流量传输，超过 CIR 但仍在 CBS 内的流量也传输，超过 CBS 的流量丢弃",
                "parameters": [
                    {
                        "name": "cir",
                        "type": "integer",
                        "explanation": "承诺信息速率，单位 bps"
                    },
                    {
                        "name": "cbs",
                        "type": "integer",
                        "explanation": "承诺突发尺寸，单位 bytes"
                    },
                    {
                        "name": "ebs",
                        "type": "integer",
                        "explanation": "超额突发尺寸，单位 bytes"
                    },
                    {
                        "name": "conform-action",
                        "type": "string",
                        "explanation": "符合 CIR 的动作，这里是传输"
                    },
                    {
                        "name": "exceed-action",
                        "type": "string",
                        "explanation": "超过 CIR 但仍在 CBS 内的动作，这里是传输"
                    },
                    {
                        "name": "violate-action",
                        "type": "string",
                        "explanation": "超过 CBS 的动作，这里是丢弃"
                    }
                ]
            }
        },
        "class class-default": {
