    "access-list [parameter1] deny ip [parameter2] [parameter3] [parameter4] [parameter5]": {
        "template": "access-list [parameter1] deny ip [parameter2] [parameter3] [parameter4] [parameter5]",
        "command": "access-list 3001 deny ip 10.1.1.0 0.0.0.255 10.1.2.0 0.0.0.255",
        "explanation": "创建访问控制列表 3001，拒绝从 10.1.1.0/24 到 10.1.2.0/24 的 IP 流量",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source network",
                "type": "IPv4",
                "explanation": "源网络地址"
            },
            {
                "name": "source wildcard mask",
                "type": "IPv4",
                "explanation": "源网络通配符掩码"
            },
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "destination wildcard mask",
                "type": "IPv4",
                "explanation": "目的网络通配符掩码"
            }
        ]
    },
    "class-map match-any [parameter1]": {
        "template": "class-map match-any [parameter1]",
        "command": "class-map match-any cm1",
        "explanation": "创建类映射 cm1，匹配任一条件",
        "parameters": [
            {
                "name": "class-map name",
                "type": "string",
                "explanation": "类映射名称"
            }
        ],
        "match access-group [parameter1]": {
            "template": "match access-group [parameter1]",
            "command": "match access-group 3001",
            "explanation": "匹配访问控制列表 3001",
            "parameters": [
                {
                    "name": "access-list number",
                    "type": "integer",
                    "explanation": "访问控制列表编号"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map pm1",
        "explanation": "创建策略映射 pm1",
        "parameters": [
            {
                "name": "policy-map name",
                "type": "string",
                "explanation": "策略映射名称"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class cm1",
            "explanation": "应用类映射 cm1",
            "parameters": [
                {
                    "name": "class-map name",
                    "type": "string",
                    "explanation": "类映射名称"
                }
            ],
            "drop": {
                "template": "drop",
                "command": "drop",
                "explanation": "丢弃匹配的流量",
                "parameters": []
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan10",
        "explanation": "配置 VLAN 10 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
