            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 编号"
                }
            ]
        },
        "service-policy input [parameter1]": {
            "template": "service-policy input [parameter1]",
            "command": "service-policy input pm1",
            "explanation": "在接口的输入方向应用策略映射 pm1",
            "parameters": [
                {
                    "name": "policy-map name",
                    "type": "string",
                    "explanation": "策略映射名称"
                }
