{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRE",
        "explanation": "设置设备的主机名为 'LSRE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.4.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.4.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        },
        "mpls traffic-eng tunnels": {
            "template": "mpls traffic-eng tunnels",
            "command": "mpls traffic-eng tunnels",
            "explanation": "在接口上启用 MPLS 流量工程隧道",
            "parameters": []
        },
        "mpls traffic-eng administrative-weight [parameter1]": {
            "template": "mpls traffic-eng administrative-weight [parameter1]",
            "command": "mpls traffic-eng administrative-weight 10",
            "explanation": "设置 MPLS 流量工程的管理权重为 10",
            "parameters": [
                {
                    "name": "weight",
                    "type": "integer",
                    "explanation": "管理权重"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "mpls traffic-eng area [parameter1]": {
            "template": "mpls traffic-eng area [parameter1]",
            "command": "mpls traffic-eng area 0",
            "explanation": "在 OSPF 区域 0 中启用 MPLS 流量工程",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 5.5.5.5 0.0.0.0 area 0",
            "explanation": "将 IP 地址 5.5.5.5 配置为 OSPF 区域 0 的一部分",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IP 地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "mpls traffic-eng router-id [parameter1]": {
        "template": "mpls traffic-eng router-id [parameter1]",
        "command": "mpls traffic-eng router-id Loopback1",
        "explanation": "设置 MPLS 流量工程的路由器 ID 为 Loopback1 接口的 IP 地址",
        "parameters": [
            {
                "name": "router id",
                "type": "string",
                "explanation": "路由器 ID"
            }
        ]
    }
}