{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip multicast-routing": {
        "template": "ip multicast-routing",
        "command": "ip multicast-routing",
        "explanation": "启用IP组播路由",
        "parameters": []
    },
    "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]": {
        "template": "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]",
        "command": "access-list 2000 permit ip 232.1.1.0 0.0.0.255 any",
        "explanation": "配置访问控制列表2000，允许源IP地址为232.1.1.0/24，目的地址为任意的IP流量",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source IP",
                "type": "IPv4",
                "explanation": "源IP地址"
            },
            {
                "name": "source wildcard",
                "type": "IPv4",
                "explanation": "源IP地址通配符"
            },
            {
                "name": "destination",
                "type": "string",
                "explanation": "目的地址"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入IS-IS路由配置模式",
        "parameters": [],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0003.00",
            "explanation": "配置IS-IS网络实体标题（NET）",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.4.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.4.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ip pim sparse-mode": {
            "template": "ip pim sparse-mode",
            "command": "ip pim sparse-mode",
            "explanation": "在接口上启用PIM稀疏模式",
            "parameters": []
        },
        "isis network point-to-point": {
            "template": "isis network point-to-point",
            "command": "isis network point-to-point",
            "explanation": "配置IS-IS网络类型为点对点",
            "parameters": []
        },
        "ip igmp version [parameter1]": {
            "template": "ip igmp version [parameter1]",
            "command": "ip igmp version 3",
            "explanation": "配置接口的IGMP版本为3",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "IGMP版本"
                }
            ]
        },
        "ip igmp join-group [parameter1]": {
            "template": "ip igmp join-group [parameter1]",
            "command": "ip igmp join-group 232.1.1.0",
            "explanation": "配置接口加入组播组232.1.1.0",
            "parameters": [
                {
                    "name": "group address",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                }
            ]
        }
    },
    "ip pim ssm default": {
        "template": "ip pim ssm default",
        "command": "ip pim ssm default",
        "explanation": "启用PIM SSM（源特定组播）默认范围",
        "parameters": []
    },
    "ip pim ssm range [parameter1] [parameter2]": {
        "template": "ip pim ssm range [parameter1] [parameter2]",
        "command": "ip pim ssm range 232.1.1.0 0.0.0.255",
        "explanation": "配置PIM SSM范围为232.1.1.0/24",
        "parameters": [
            {
                "name": "group address",
                "type": "IPv4",
                "explanation": "组播组地址"
            },
            {
                "name": "wildcard",
                "type": "IPv4",
                "explanation": "通配符"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
