{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "配置接口 'GigabitEthernet3/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口配置为二层交换端口",
            "parameters": []
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "设置接口模式为接入模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "monitor session [parameter1] source interface [parameter2]": {
            "template": "monitor session [parameter1] source interface [parameter2]",
            "command": "monitor session 1 source interface GigabitEthernet3/0/0",
            "explanation": "配置监控会话 1 的源接口为 'GigabitEthernet3/0/0'",
            "parameters": [
                {
                    "name": "session id",
                    "type": "integer",
                    "explanation": "监控会话 ID"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口"
                }
            ]
        },
        "monitor session [parameter1] destination interface [parameter2] ingress vlan [parameter3]": {
            "template": "monitor session [parameter1] destination interface [parameter2] ingress vlan [parameter3]",
            "command": "monitor session 1 destination interface GigabitEthernet3/0/1 ingress vlan 10",
            "explanation": "配置监控会话 1 的目的接口为 'GigabitEthernet3/0/1'，并指定入方向 VLAN 为 10",
            "parameters": [
                {
                    "name": "session id",
                    "type": "integer",
                    "explanation": "监控会话 ID"
                },
                {
                    "name": "destination interface",
                    "type": "string",
                    "explanation": "目的接口"
                },
                {
                    "name": "ingress vlan",
                    "type": "integer",
                    "explanation": "入方向 VLAN ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "port monitor [parameter1]": {
            "template": "port monitor [parameter1]",
            "command": "port monitor 1",
            "explanation": "将接口添加到监控会话 1",
            "parameters": [
                {
                    "name": "session id",
                    "type": "integer",
                    "explanation": "监控会话 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}