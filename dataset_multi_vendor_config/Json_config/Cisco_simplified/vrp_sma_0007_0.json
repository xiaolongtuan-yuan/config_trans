{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname AER_A",
        "explanation": "设置设备的主机名为 'AER_A'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用IPv6单播路由",
        "parameters": []
    },
    "ipv6 cef": {
        "template": "ipv6 cef",
        "command": "ipv6 cef",
        "explanation": "启用IPv6 Cisco Express Forwarding",
        "parameters": []
    },
    "ipv6 route [parameter1] [parameter2]": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route 2001:db8:4::2/128 Null0",
        "explanation": "配置IPv6静态路由，目的地址为2001:db8:4::2/128，下一跳为Null0接口",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "目的IPv6地址"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳地址或接口"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用IPv6",
            "parameters": []
        },
        "ipv6 address [parameter1] [parameter2]": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "配置接口的IPv6地址为2001:db8:1::1，前缀长度为64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        }
    }
}