{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname LSRA",
        "explanation": "设置设备的主机名为 'LSRA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "配置 MPLS 标签分发协议为 LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "标签分发协议"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "强制使用 Loopback0 接口的 IP 地址作为 LDP 的 router-id",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置 Loopback0 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP",
            "parameters": []
        },
        "mpls traffic-eng tunnels": {
            "template": "mpls traffic-eng tunnels",
            "command": "mpls traffic-eng tunnels",
            "explanation": "在接口上启用 MPLS 流量工程隧道",
            "parameters": []
        },
        "ip unnumbered [parameter1]": {
            "template": "ip unnumbered [parameter1]",
            "command": "ip unnumbered Loopback0",
            "explanation": "配置接口使用 Loopback0 接口的 IP 地址",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 3.3.3.3",
            "explanation": "配置隧道的目标地址为 3.3.3.3",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目标 IPv4 地址"
                }
            ]
        },
        "tunnel mode [parameter1]": {
            "template": "tunnel mode [parameter1]",
            "command": "tunnel mode mpls traffic-eng",
            "explanation": "配置隧道的模式为 MPLS 流量工程",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "隧道模式"
                }
            ]
        },
        "tunnel mpls traffic-eng autoroute announce": {
            "template": "tunnel mpls traffic-eng autoroute announce",
            "command": "tunnel mpls traffic-eng autoroute announce",
            "explanation": "启用隧道的自动路由通告",
            "parameters": []
        },
        "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]": {
            "template": "tunnel mpls traffic-eng path-option [parameter1] explicit name [parameter2]",
            "command": "tunnel mpls traffic-eng path-option 100 explicit name T10",
            "explanation": "配置隧道的路径选项 100 为显式路径，名称为 T10",
            "parameters": [
                {
                    "name": "path-option",
                    "type": "integer",
                    "explanation": "路径选项编号"
                },
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "路径名称"
                }
            ]
        }
    },
    "mpls traffic-eng path-option [parameter1] explicit name [parameter2]": {
        "template": "mpls traffic-eng path-option [parameter1] explicit name [parameter2]",
        "command": "mpls traffic-eng path-option 100 explicit name T20",
        "explanation": "配置 MPLS 流量工程的路径选项 100 为显式路径，名称为 T20",
        "parameters": [
            {
                "name": "path-option",
                "type": "integer",
                "explanation": "路径选项编号"
            },
            {
                "name": "name",
                "type": "string",
                "explanation": "路径名称"
            }
        ]
    }
}