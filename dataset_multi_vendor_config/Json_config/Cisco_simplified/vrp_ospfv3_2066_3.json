            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ospfv3 cost [parameter1]": {
            "template": "ospfv3 cost [parameter1]",
            "command": "ospfv3 cost 5",
            "explanation": "设置接口的 OSPFv3 成本为 5",
            "parameters": [
                {
                    "name": "cost",
                    "type": "integer",
                    "explanation": "OSPFv3 成本"
                }
            ]
        }
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "router ospfv3 [parameter1]": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "进入 OSPFv3 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置 OSPFv3 路由器的 ID 为 4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "bfd all-interfaces enable": {
            "template": "bfd all-interfaces enable",
            "command": "bfd all-interfaces enable",
            "explanation": "在所有接口上启用 BFD",
            "parameters": []
        },
        "bfd all-interfaces frr-binding": {
            "template": "bfd all-interfaces frr-binding",
            "command": "bfd all-interfaces frr-binding",
            "explanation": "在所有接口上启用 BFD 与 FRR 的绑定",
            "parameters": []
        },
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.1",
            "explanation": "配置 OSPFv3 区域 0.0.0.1",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域 ID"
                }
