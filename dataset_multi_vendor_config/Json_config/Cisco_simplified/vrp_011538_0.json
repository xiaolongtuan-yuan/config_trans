                    "template": "mep ccm-send interval [parameter1]",
                    "command": "mep ccm-send interval 3",
                    "explanation": "设置CCM发送间隔为3秒",
                    "parameters": [
                        {
                            "name": "interval",
                            "type": "integer",
                            "explanation": "CCM发送间隔时间，单位秒，这里为3"
