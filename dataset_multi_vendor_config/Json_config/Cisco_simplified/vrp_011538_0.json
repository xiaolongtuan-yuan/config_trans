                "continuity-check interval [parameter1] mep [parameter2] remote-mep [parameter3] peer-ip [parameter4]": {
                    "template": "continuity-check interval [parameter1] mep [parameter2] remote-mep [parameter3] peer-ip [parameter4]",
                    "command": "continuity-check interval 3 mep 1 remote-mep 2 peer-ip 1.1.1.1",
                    "explanation": "配置连通性检查参数",
                    "parameters": [
                        {
                            "name": "interval",
                            "type": "integer",
                            "explanation": "检查间隔时间，单位秒，这里为3"
                        },
                        {
                            "name": "local mep",
                            "type": "integer",
                            "explanation": "本地MEP ID，这里为1"
                        },
                        {
                            "name": "remote mep",
                            "type": "integer",
                            "explanation": "远程MEP ID，这里为2"
                        },
                        {
                            "name": "peer ip",
                            "type": "IPv4",
                            "explanation": "对等IP地址，这里为1.1.1.1"
                        }
                    ]
                },
