            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip igmp snooping static-router-port vlan [parameter1]": {
            "template": "ip igmp snooping static-router-port vlan [parameter1]",
            "command": "ip igmp snooping static-router-port vlan 10",
            "explanation": "将接口配置为 VLAN 10 的静态路由器端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许 VLAN 10 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip igmp snooping static-group [parameter1] vlan [parameter2]": {
            "template": "ip igmp snooping static-group [parameter1] vlan [parameter2]",
            "command": "ip igmp snooping static-group 224.1.1.1 vlan 10",
            "explanation": "将接口配置为 VLAN 10 的静态组播组 224.1.1.1 的成员",
            "parameters": [
                {
                    "name": "multicast group",
                    "type": "IPv4",
                    "explanation": "组播组地址"
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
