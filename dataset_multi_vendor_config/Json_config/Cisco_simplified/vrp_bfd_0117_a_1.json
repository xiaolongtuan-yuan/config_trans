{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel1",
        "explanation": "配置接口 'Port-channel1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:1::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:1::2，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 1 mode on",
            "explanation": "将接口加入到通道组 1 中，模式为 'on'",
            "parameters": [
                {
                    "name": "channel-group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "模式"
                }
            ]
        }
    },
    "bfd interval min-tx [parameter1] min-rx [parameter2]": {
        "template": "bfd interval min-tx [parameter1] min-rx [parameter2]",
        "command": "bfd interval min-tx 10 min-rx 10",
        "explanation": "配置 BFD 的最小发送间隔为 10 毫秒，最小接收间隔为 10 毫秒",
        "parameters": [
            {
                "name": "min-tx",
                "type": "integer",
                "explanation": "最小发送间隔（毫秒）"
            },
            {
                "name": "min-rx",
                "type": "integer",
                "explanation": "最小接收间隔（毫秒）"
            }
        ]
    },
    "ipv6 bfd btoa bind link-bundle peer-ipv6 [parameter1] interface [parameter2] source-ipv6 [parameter3]": {
        "template": "ipv6 bfd btoa bind link-bundle peer-ipv6 [parameter1] interface [parameter2] source-ipv6 [parameter3]",
        "command": "ipv6 bfd btoa bind link-bundle peer-ipv6 2001:DB8:1::1 interface Port-channel1 source-ipv6 2001:DB8:1::2",
        "explanation": "配置 IPv6 BFD 双向转发检测，绑定到链路捆绑，对端 IPv6 地址为 2001:DB8:1::1，接口为 Port-channel1，源 IPv6 地址为 2001:DB8:1::2",
        "parameters": [
            {
                "name": "peer-ipv6",
                "type": "IPv6",
                "explanation": "对端 IPv6 地址"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "source-ipv6",
                "type": "IPv6",
                "explanation": "源 IPv6 地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}