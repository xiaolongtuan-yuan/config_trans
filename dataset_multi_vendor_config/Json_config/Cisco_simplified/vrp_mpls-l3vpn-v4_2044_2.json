    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 11.1.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 11.1.1.2，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "remote AS",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family ipv4",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 2.2.2.9 mask 255.255.255.255",
                "explanation": "在 BGP 中通告网络 2.2.2.9/32",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 11.1.1.2 activate",
                "explanation": "激活 BGP 邻居 11.1.1.2 的 IPv4 地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            },
            "neighbor [parameter1] route-map [parameter2] [parameter3]": {
                "template": "neighbor [parameter1] route-map [parameter2] [parameter3]",
                "command": "neighbor 11.1.1.2 route-map policy1 out",
                "explanation": "对 BGP 邻居 11.1.1.2 的出站路由应用路由映射 'policy1'",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（in/out）"
                    }
                ]
            },
            "neighbor [parameter1] next-hop-self": {
                "template": "neighbor [parameter1] next-hop-self",
                "command": "neighbor 11.1.1.2 next-hop-self",
                "explanation": "配置 BGP 邻居 11.1.1.2 使用自身作为下一跳",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程号为 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "进程号"
            }
        ],
        "redistribute bgp [parameter1] subnets": {
            "template": "redistribute bgp [parameter1] subnets",
            "command": "redistribute bgp 200 subnets",
            "explanation": "重分发 BGP 200 的路由到 OSPF，包括子网",
            "parameters": [
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 2.2.2.9 0.0.0.0 area 0",
            "explanation": "在 OSPF 中通告网络 2.2.2.9/32，区域为 0",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "区域号"
                }
            ]
        }
    },
    "route-map [parameter1] [parameter2] [parameter3]": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map policy1 permit 10",
        "explanation": "配置路由映射 'policy1'，序列号为 10，操作为允许",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "操作（permit/deny）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "set mpls label": {
            "template": "set mpls label",
            "command": "set mpls label",
            "explanation": "设置 MPLS 标签",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
