{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE",
        "explanation": "设置设备的主机名为 'PE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥接域 10 的配置模式",
        "parameters": [
            {
                "name": "bridge-domain id",
                "type": "integer",
                "explanation": "桥接域的 ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif10",
        "explanation": "配置接口 'Vbdif10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "helper-address [parameter1]": {
            "template": "helper-address [parameter1]",
            "command": "helper-address 2.2.2.2",
            "explanation": "配置 DHCP 中继代理的辅助地址为 2.2.2.2",
            "parameters": [
                {
                    "name": "helper address",
                    "type": "IPv4",
                    "explanation": "DHCP 中继代理的辅助地址"
                }
            ]
        },
        "encapsulation dot1q [parameter1]": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 100",
            "explanation": "配置子接口的封装类型为 dot1q，并指定 VLAN ID 为 100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        },
        "bridge-group [parameter1]": {
            "template": "bridge-group [parameter1]",
            "command": "bridge-group 10",
            "explanation": "将子接口加入到桥接组 10",
            "parameters": [
                {
                    "name": "bridge-group id",
                    "type": "integer",
                    "explanation": "桥接组的 ID"
                }
            ]
        }
    },
    "bridge [parameter1] protocol [parameter2]": {
        "template": "bridge [parameter1] protocol [parameter2]",
        "command": "bridge 10 protocol ieee",
        "explanation": "配置桥接组 10 使用 IEEE 协议",
        "parameters": [
            {
                "name": "bridge-group id",
                "type": "integer",
                "explanation": "桥接组的 ID"
            },
            {
                "name": "protocol",
                "type": "string",
                "explanation": "协议类型"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}