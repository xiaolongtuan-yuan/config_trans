{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置接口 'GigabitEthernet0/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.0.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.2.2，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip ssh client enable first-time": {
        "template": "ip ssh client enable first-time",
        "command": "ip ssh client enable first-time",
        "explanation": "启用 SSH 客户端并进行首次配置",
        "parameters": []
    }
}