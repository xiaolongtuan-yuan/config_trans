{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "配置接口 'gigabitethernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 120 min_rx 50 multiplier 3",
            "explanation": "配置接口的BFD间隔为120ms，最小接收间隔为50ms，乘数为3",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "BFD间隔（毫秒）"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "最小接收间隔（毫秒）"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        }
    },
    "bfd template single-hop [parameter1]": {
        "template": "bfd template single-hop [parameter1]",
        "command": "bfd template single-hop BFD-TEMPLATE",
        "explanation": "配置单跳BFD模板 'BFD-TEMPLATE'",
        "parameters": [
            {
                "name": "template name",
                "type": "string",
                "explanation": "模板名"
            }
        ],
        "interval min-tx [parameter1] min-rx [parameter2] multiplier [parameter3]": {
            "template": "interval min-tx [parameter1] min-rx [parameter2] multiplier [parameter3]",
            "command": "interval min-tx 50 min-rx 50 multiplier 3",
            "explanation": "配置BFD模板的发送间隔为50ms，接收间隔为50ms，乘数为3",
            "parameters": [
                {
                    "name": "min-tx",
                    "type": "integer",
                    "explanation": "最小发送间隔（毫秒）"
                },
                {
                    "name": "min-rx",
                    "type": "integer",
                    "explanation": "最小接收间隔（毫秒）"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        }
    },
    "bfd discriminator local [parameter1]": {
        "template": "bfd discriminator local [parameter1]",
        "command": "bfd discriminator local 10",
        "explanation": "配置本地BFD鉴别器为10",
        "parameters": [
            {
                "name": "local discriminator",
                "type": "integer",
                "explanation": "本地鉴别器"
            }
        ]
    },
    "bfd discriminator remote [parameter1]": {
        "template": "bfd discriminator remote [parameter1]",
        "command": "bfd discriminator remote 20",
        "explanation": "配置远程BFD鉴别器为20",
        "parameters": [
            {
                "name": "remote discriminator",
                "type": "integer",
                "explanation": "远程鉴别器"
            }
        ]
    }
}