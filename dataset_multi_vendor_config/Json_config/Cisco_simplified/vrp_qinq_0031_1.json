{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 20",
            "explanation": "配置子接口的封装类型为 dot1Q，VLAN ID 为 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN 标识符"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.2 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.3.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65420",
        "explanation": "配置 BGP 路由进程，AS 号为 65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.2.1.1，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "synchronization none": {
                "template": "synchronization none",
                "command": "synchronization none",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 10.3.1.0 mask 255.255.255.0",
                "explanation": "宣告网络 10.3.1.0/24 到 BGP",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.1 activate",
                "explanation": "激活邻居 10.2.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}