{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id loopback0 force",
        "explanation": "强制使用 loopback0 接口的 IP 地址作为 MPLS LDP 的路由器 ID",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "启用 MPLS IP 转发",
        "parameters": []
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "启用 MPLS LDP",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "在接口上启用 MPLS IP 转发",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "在接口上启用 MPLS LDP",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
