{
    "enable": {
        "template": "enable",
        "command": "enable",
        "explanation": "进入特权执行模式",
        "parameters": []
    },
    "configure terminal": {
        "template": "configure terminal",
        "command": "configure terminal",
        "explanation": "进入全局配置模式",
        "parameters": []
    },
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "设置设备的主机名为 'P'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建 VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode trunk",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100,200",
            "explanation": "允许 VLAN 100 和 200 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "string",
                    "explanation": "允许通过的 VLAN 列表"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式并返回到特权执行模式",
        "parameters": []
    }
}