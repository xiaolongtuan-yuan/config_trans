{
    "sysname DeviceC": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ospfv3 1": {
        "template": "ospfv3 [parameter1]",
        "command": "ospfv3 1",
        "explanation": "启用OSPFv3进程1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3进程ID"
            }
        ],
        "router-id 4.4.4.4": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "设置OSPFv3进程1的路由器ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器ID"
                }
            ]
        },
        "area 0.0.0.1": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.1",
            "explanation": "配置OSPFv3进程1的区域为0.0.0.1",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "进入GigabitEthernet3/0/0接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address 2001:DB8:3::1/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:3::1/64",
            "explanation": "配置接口的IPv6地址为2001:DB8:3::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址及前缀长度"
                }
            ]
        },
        "ospfv3 1 area 0.0.0.1": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.1",
            "explanation": "将接口加入到OSPFv3进程1的区域0.0.0.1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3进程ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "区域ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回用户视图",
        "parameters": []
    }
}