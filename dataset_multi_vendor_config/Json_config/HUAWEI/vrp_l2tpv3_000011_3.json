{
  "sysname CE2": {
    "template": "sysname [parameter1]",
    "command": "sysname CE2",
    "explanation": "设置设备的主机名为 'CE2'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "portswitch": {
      "template": "portswitch",
      "command": "portswitch",
      "explanation": "将接口从三层模式切换到二层模式",
      "parameters": []
    },
    "undo shutdown": {
      "template": "undo shutdown",
      "command": "undo shutdown",
      "explanation": "启用接口 (默认情况下接口是关闭的)",
      "parameters": []
    },
    "port link-type trunk": {
      "template": "port link-type [parameter1]",
      "command": "port link-type trunk",
      "explanation": "设置接口的链路类型为trunk",
      "parameters": [
        {
          "name": "link type",
          "type": "string",
          "explanation": "链路类型"
        }
      ]
    },
    "port trunk allow-pass vlan 2": {
      "template": "port trunk allow-pass vlan [parameter1]",
      "command": "port trunk allow-pass vlan 2",
      "explanation": "允许VLAN 2通过该trunk接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出当前视图，返回到用户视图",
    "parameters": []
  }
}