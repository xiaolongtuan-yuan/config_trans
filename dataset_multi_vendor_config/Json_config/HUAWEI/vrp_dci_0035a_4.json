{
    "sysname CE2": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        }
    },
    "interface GigabitEthernet1/0/0.1 mode l2": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/0.1 mode l2",
        "explanation": "进入接口GigabitEthernet1/0/0.1的配置模式，并设置为二层模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式"
            }
        ],
        "encapsulation dot1q vid 10": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "配置接口的VLAN封装为802.1Q，并指定VLAN ID为10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "rewrite pop single": {
            "template": "rewrite pop [parameter1]",
            "command": "rewrite pop single",
            "explanation": "配置接口的标签操作为弹出单个标签",
            "parameters": [
                {
                    "name": "operation",
                    "type": "string",
                    "explanation": "标签操作"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
