{
    "sysname CE1": {
        "template": "sysname [hostname]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch 2": {
        "template": "vlan batch [vlan-id-list]",
        "command": "vlan batch 2",
        "explanation": "批量创建VLAN，这里创建VLAN 2",
        "parameters": [
            {
                "name": "vlan-id-list",
                "type": "integer",
                "explanation": "VLAN ID列表"
            }
        ]
    },
    "cfm version standard": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入指定接口的配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口配置为交换模式",
            "parameters": []
        },
        "port trunk allow-pass vlan 2": {
            "template": "port trunk allow-pass vlan [vlan-id-list]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2通过 trunk 端口",
            "parameters": [
                {
                    "name": "vlan-id-list",
                    "type": "integer",
                    "explanation": "允许通过的VLAN ID列表"
                }
            ]
        }
    },
    "cfm md md1": {
        "template": "cfm md [md-name]",
        "command": "cfm md md1",
        "explanation": "创建或进入维护域 md1",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "维护域名称"
            }
        ],
        "ma ma1": {
            "template": "ma [ma-name]",
            "command": "ma ma1",
            "explanation": "创建或进入维护关联 ma1",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "map vlan 2": {
                "template": "map vlan [vlan-id]",
                "command": "map vlan 2",
                "explanation": "将VLAN 2映射到MA",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id 2 interface GigabitEthernet1/0/1 outward": {
                "template": "mep mep-id [mep-id] interface [interface-name] [direction]",
                "command": "mep mep-id 2 interface GigabitEthernet1/0/1 outward",
                "explanation": "配置MEP ID为2，接口为GigabitEthernet1/0/1，方向为outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向，如inward或outward"
                    }
                ]
            },
            "mep ccm-send mep-id 2 enable": {
                "template": "mep ccm-send mep-id [mep-id] enable",
                "command": "mep ccm-send mep-id 2 enable",
                "explanation": "启用MEP ID 2的CCM发送",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id 1": {
                "template": "remote-mep mep-id [mep-id]",
                "command": "remote-mep mep-id 1",
                "explanation": "配置远程MEP ID为1",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id 1 enable": {
                "template": "remote-mep ccm-receive mep-id [mep-id] enable",
                "command": "remote-mep ccm-receive mep-id 1 enable",
                "explanation": "启用接收远程MEP ID 1的CCM",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "test-id 1 mep 2": {
                "template": "test-id [test-id] mep [mep-id]",
                "command": "test-id 1 mep 2",
                "explanation": "配置测试ID为1，MEP ID为2",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "loss-measure single-ended receive test-id 1": {
                "template": "loss-measure single-ended receive test-id [test-id]",
                "command": "loss-measure single-ended receive test-id 1",
                "explanation": "配置单端损耗测量，接收测试ID为1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级",
        "parameters": []
    }
}