{
    "sysname CE1": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch 10": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "批量创建VLAN，这里创建了VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式，这里选择了GigabitEthernet1/0/0接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口从三层模式切换到二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port link-type access": {
            "template": "port link-type [parameter1]",
            "command": "port link-type access",
            "explanation": "设置接口的链路类型为access模式",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "链路类型"
                }
            ]
        },
        "port default vlan 10": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "将接口的默认VLAN设置为10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}