            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "mep mep-id 3 interface GigabitEthernet1/0/2.1 vlan 2 outward": {
                "template": "mep mep-id [parameter1] interface [parameter2] vlan [parameter3] [parameter4]",
                "command": "mep mep-id 3 interface GigabitEthernet1/0/2.1 vlan 2 outward",
