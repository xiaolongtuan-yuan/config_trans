      {
        "name": "remote server1 ip",
        "type": "IPv4",
        "explanation": "远程服务器1的IP地址"
      }
    ]
  },
  "ptp-adaptive request sync-interval 4": {
    "template": "ptp-adaptive request sync-interval [parameter1]",
    "command": "ptp-adaptive request sync-interval 4",
    "explanation": "设置PTP自适应请求同步间隔为4",
    "parameters": [
      {
        "name": "sync interval",
        "type": "integer",
        "explanation": "同步间隔"
      }
    ]
  },
  "ptp-adaptive request announce-interval 12": {
    "template": "ptp-adaptive request announce-interval [parameter1]",
    "command": "ptp-adaptive request announce-interval 12",
    "explanation": "设置PTP自适应请求公告间隔为12",
    "parameters": [
      {
        "name": "announce interval",
        "type": "integer",
        "explanation": "公告间隔"
      }
    ]
  },
  "ptp-adaptive request delay-resp-interval 6": {
    "template": "ptp-adaptive request delay-resp-interval [parameter1]",
    "command": "ptp-adaptive request delay-resp-interval 6",
    "explanation": "设置PTP自适应请求延迟响应间隔为6",
    "parameters": [
      {
        "name": "delay resp interval",
        "type": "integer",
        "explanation": "延迟响应间隔"
      }
    ]
  },
  "ptp-adaptive acr unicast-negotiate enable": {
    "template": "ptp-adaptive acr unicast-negotiate enable",
    "command": "ptp-adaptive acr unicast-negotiate enable",
    "explanation": "启用PTP自适应ACR单播协商功能",
    "parameters": []
  },
  "clock source ptp synchronization enable": {
    "template": "clock source ptp synchronization enable",
    "command": "clock source ptp synchronization enable",
    "explanation": "启用PTP作为时钟源的同步功能",
    "parameters": []
  },
  "clock source ptp priority 1": {
    "template": "clock source ptp priority [parameter1]",
    "command": "clock source ptp priority 1",
    "explanation": "设置PTP作为时钟源的优先级为1",
    "parameters": [
      {
        "name": "priority",
        "type": "integer",
        "explanation": "优先级"
      }
    ]
  },
  "clock source ptp ssm prc": {
    "template": "clock source ptp ssm [parameter1]",
    "command": "clock source ptp ssm prc",
    "explanation": "设置PTP作为时钟源的SSM为PRC",
    "parameters": [
      {
        "name": "ssm",
        "type": "string",
        "explanation": "SSM类型"
      }
    ]
  },
  "interface Loopback0": {
    "template": "interface [parameter1]",
    "command": "interface Loopback0",
