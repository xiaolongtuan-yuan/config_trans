    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "ip address 2.2.2.2 255.255.255.255": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 2.2.2.2 255.255.255.255",
      "explanation": "配置接口的IPv4地址为2.2.2.2，子网掩码为255.255.255.255",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "sub musk",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出当前配置模式，返回到用户视图",
    "parameters": []
  }
}