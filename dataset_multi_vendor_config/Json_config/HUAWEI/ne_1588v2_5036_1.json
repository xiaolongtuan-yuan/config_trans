    "explanation": "设置设备的主机名为 'DeviceC'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "ptp-adaptive enable": {
    "template": "ptp-adaptive enable",
    "command": "ptp-adaptive enable",
    "explanation": "启用PTP自适应功能",
    "parameters": []
  },
  "ptp-adaptive device-type client": {
    "template": "ptp-adaptive device-type [parameter1]",
    "command": "ptp-adaptive device-type client",
    "explanation": "设置PTP自适应设备类型为客户端",
    "parameters": [
      {
        "name": "device type",
        "type": "string",
        "explanation": "设备类型"
      }
    ]
  },
  "ptp-adaptive local-ip 2.2.2.2": {
    "template": "ptp-adaptive local-ip [parameter1]",
    "command": "ptp-adaptive local-ip 2.2.2.2",
    "explanation": "设置PTP自适应本地IP地址为2.2.2.2",
    "parameters": [
      {
        "name": "local ip",
        "type": "IPv4",
        "explanation": "本地IP地址"
      }
    ]
  },
  "ptp-adaptive remote-server1-ip 1.1.1.1": {
    "template": "ptp-adaptive remote-server1-ip [parameter1]",
