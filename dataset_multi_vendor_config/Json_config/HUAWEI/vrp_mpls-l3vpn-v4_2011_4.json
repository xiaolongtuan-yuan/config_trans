    "bgp 65420": {
        "template": "bgp [parameter1]",
        "command": "bgp 65420",
        "explanation": "进入BGP配置模式，并设置本地AS号为65420",
        "parameters": [
            {
                "name": "local AS number",
                "type": "integer",
                "explanation": "本地AS号"
            }
        ],
        "peer 192.168.2.1 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 192.168.2.1 as-number 100",
            "explanation": "配置BGP对等体192.168.2.1，其AS号为100",
            "parameters": [
                {
                    "name": "peer IP address",
                    "type": "IPv4",
                    "explanation": "对等体的IPv4地址"
                },
                {
                    "name": "peer AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
