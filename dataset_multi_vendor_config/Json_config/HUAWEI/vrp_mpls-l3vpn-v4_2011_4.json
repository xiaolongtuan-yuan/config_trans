            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "network 11.11.11.11 32": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 11.11.11.11 32",
                "explanation": "在BGP中通告网络11.11.11.11/32",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "prefix length",
                        "type": "integer",
                        "explanation": "前缀长度"
                    }
                ]
            },
            "peer 192.168.2.1 enable": {
                "template": "peer [parameter1] enable",
