{
    "sysname PE1": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "l2tpv3 enable": {
        "template": "l2tpv3 enable",
        "command": "l2tpv3 enable",
        "explanation": "启用L2TPv3功能",
        "parameters": []
    },
    "l2tpv3 local connection dot1q interface GigabitEthernet1/0/1.4 out-interface GigabitEthernet2/0/1.4": {
        "template": "l2tpv3 local connection dot1q interface [parameter1] out-interface [parameter2]",
        "command": "l2tpv3 local connection dot1q interface GigabitEthernet1/0/1.4 out-interface GigabitEthernet2/0/1.4",
        "explanation": "配置L2TPv3本地连接，指定入接口和出接口",
        "parameters": [
            {
                "name": "in-interface",
                "type": "string",
                "explanation": "入接口"
            },
            {
                "name": "out-interface",
                "type": "string",
                "explanation": "出接口"
            }
        ]
    },
    "interface GigabitEthernet1/0/1.4 mode l2": {
        "template": "interface [parameter1] mode l2",
        "command": "interface GigabitEthernet1/0/1.4 mode l2",
        "explanation": "配置接口为二层模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1q vid 2": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 2",
            "explanation": "配置接口的VLAN ID为2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "interface GigabitEthernet2/0/1.4 mode l2": {
        "template": "interface [parameter1] mode l2",
        "command": "interface GigabitEthernet2/0/1.4 mode l2",
        "explanation": "配置接口为二层模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation dot1q vid 2": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 2",
            "explanation": "配置接口的VLAN ID为2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    }
}