{
    "sysname DeviceA": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": []
    },
    "interface gigabitethernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bfd atob bind peer-ip 10.1.1.2 interface gigabitEthernet1/0/0 one-arm-echo": {
        "template": "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3] one-arm-echo",
        "command": "bfd atob bind peer-ip 10.1.1.2 interface gigabitEthernet1/0/0 one-arm-echo",
        "explanation": "配置BFD会话，绑定对端IP地址为10.1.1.2，接口为gigabitEthernet1/0/0，使用单臂回声模式",
        "parameters": [
            {
                "name": "session name",
                "type": "string",
                "explanation": "BFD会话名称"
            },
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "discriminator local 1": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 1",
            "explanation": "设置本地BFD会话的标识符为1",
            "parameters": [
                {
                    "name": "discriminator",
                    "type": "integer",
                    "explanation": "本地BFD会话的标识符"
                }
            ]
        },
        "min-echo-rx-interval 100": {
            "template": "min-echo-rx-interval [parameter1]",
            "command": "min-echo-rx-interval 100",
            "explanation": "设置最小回声接收间隔为100毫秒",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "最小回声接收间隔，单位毫秒"
                }
            ]
        },
        "commit": {
            "template": "commit",
            "command": "commit",
            "explanation": "提交BFD配置",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}