{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address 2001:DB8:22::1/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:22::1/64",
            "explanation": "配置接口的IPv6地址为 2001:DB8:22::1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        }
    },
    "bgp 300": {
        "template": "bgp [parameter1]",
        "command": "bgp 300",
        "explanation": "进入BGP配置模式，AS号为300",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "router-id 5.5.5.5": {
            "template": "router-id [parameter1]",
            "command": "router-id 5.5.5.5",
            "explanation": "配置BGP的Router ID为5.5.5.5",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer 2001:DB8:22::2 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:DB8:22::2 as-number 100",
            "explanation": "配置BGP对等体2001:DB8:22::2，AS号为100",
            "parameters": [
                {
                    "name": "peer ipv6 address",
                    "type": "IPv6",
                    "explanation": "对等体的IPv6地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "ipv6-family unicast": {
            "template": "ipv6-family unicast",
            "command": "ipv6-family unicast",
            "explanation": "进入IPv6单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP同步功能",
                "parameters": []
            },
            "peer 2001:DB8:22::2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 2001:DB8:22::2 enable",
                "explanation": "启用对等体2001:DB8:22::2的IPv6单播地址族",
                "parameters": [
                    {
                        "name": "peer ipv6 address",
                        "type": "IPv6",
                        "explanation": "对等体的IPv6地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
