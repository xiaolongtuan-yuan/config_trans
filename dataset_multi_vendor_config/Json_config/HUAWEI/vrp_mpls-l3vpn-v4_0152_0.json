{
    "sysname CE1": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式，配置接口GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp 65001": {
        "template": "bgp [parameter1]",
        "command": "bgp 65001",
        "explanation": "进入BGP配置模式，配置BGP进程号为65001",
        "parameters": [
            {
                "name": "as number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "peer 10.1.1.2 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.1.1.2 as-number 100",
            "explanation": "配置BGP对等体10.1.1.2，其自治系统号为100",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "对等体的IPv4地址"
                },
                {
                    "name": "as number",
                    "type": "integer",
                    "explanation": "对等体的自治系统号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "引入直连路由到BGP",
                "parameters": []
            },
            "peer 10.1.1.2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.1.1.2 enable",
                "explanation": "使能对等体10.1.1.2的IPv4单播地址族",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "对等体的IPv4地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回用户视图",
        "parameters": []
    }
