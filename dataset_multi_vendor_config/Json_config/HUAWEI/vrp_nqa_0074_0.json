{
  "sysname DeviceA": {
    "template": "sysname [parameter1]",
    "command": "sysname DeviceA",
    "explanation": "设置设备的主机名为 'DeviceA'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet2/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet2/0/0",
    "explanation": "进入接口GigabitEthernet2/0/0的配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "undo shutdown": {
      "template": "undo shutdown",
      "command": "undo shutdown",
      "explanation": "启用接口 (默认情况下接口是关闭的)",
      "parameters": []
    }
  },
  "interface GigabitEthernet2/0/0.1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet2/0/0.1",
    "explanation": "进入子接口GigabitEthernet2/0/0.1的配置模式",
    "parameters": [
      {
        "name": "sub-interface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "vlan-type dot1q 10": {
      "template": "vlan-type dot1q [parameter1]",
      "command": "vlan-type dot1q 10",
      "explanation": "配置子接口的VLAN类型为dot1q，并指定VLAN ID为10",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "ip address 10.100.0.1 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.100.0.1 255.255.255.0",
      "explanation": "配置子接口的IPv4地址为10.100.0.1，子网掩码为255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "ospf 1": {
    "template": "ospf [parameter1]",
    "command": "ospf 1",
    "explanation": "进入OSPF进程1的配置模式",
    "parameters": [
      {
        "name": "process id",
        "type": "integer",
        "explanation": "OSPF进程ID"
      }
    ],
    "import-route direct": {
      "template": "import-route [parameter1]",
      "command": "import-route direct",
      "explanation": "将直连路由引入OSPF",
      "parameters": [
        {
          "name": "route type",
          "type": "string",
          "explanation": "路由类型"
        }
      ]
    },
    "area 0.0.0.0": {
      "template": "area [parameter1]",
      "command": "area 0.0.0.0",
      "explanation": "进入OSPF区域0.0.0.0的配置模式",
      "parameters": [
        {
          "name": "area id",
          "type": "IPv4",
          "explanation": "OSPF区域ID"
        }
      ],
      "network 10.100.0.0 0.0.0.255": {
        "template": "network [parameter1] [parameter2]",
        "command": "network 10.100.0.0 0.0.0.255",
        "explanation": "在OSPF区域0.0.0.0中宣告网络10.100.0.0，通配符掩码为0.0.0.255",
        "parameters": [
          {
            "name": "network address",
            "type": "IPv4",
            "explanation": "网络地址"
          },
          {
            "name": "wildcard mask",
            "type": "IPv4",
            "explanation": "通配符掩码"
          }
        ]
      }
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出当前配置模式，返回到用户视图",
    "parameters": []
  }
}