{
    "sysname DeviceA": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "nqa twamp-light": {
        "template": "nqa twamp-light",
        "command": "nqa twamp-light",
        "explanation": "进入TWAMP Light测试配置模式",
        "parameters": [],
        "client": {
            "template": "client",
            "command": "client",
            "explanation": "进入TWAMP Light客户端配置模式",
            "parameters": [],
            "test-session 1 sender-ip 1.1.1.1 reflector-ip 2.2.2.2 sender-port 2001 reflector-port 2010": {
                "template": "test-session [parameter1] sender-ip [parameter2] reflector-ip [parameter3] sender-port [parameter4] reflector-port [parameter5]",
                "command": "test-session 1 sender-ip 1.1.1.1 reflector-ip 2.2.2.2 sender-port 2001 reflector-port 2010",
                "explanation": "配置TWAMP Light测试会话，会话ID为1，发送端IP为1.1.1.1，反射端IP为2.2.2.2，发送端端口为2001，反射端端口为2010",
                "parameters": [
                    {
                        "name": "session id",
                        "type": "integer",
                        "explanation": "会话ID"
                    },
                    {
                        "name": "sender ip",
                        "type": "IPv4",
                        "explanation": "发送端IP地址"
                    },
                    {
                        "name": "reflector ip",
                        "type": "IPv4",
                        "explanation": "反射端IP地址"
                    },
                    {
                        "name": "sender port",
                        "type": "integer",
                        "explanation": "发送端端口"
                    },
                    {
                        "name": "reflector port",
                        "type": "integer",
                        "explanation": "反射端端口"
                    }
                ]
            }
        },
        "sender": {
            "template": "sender",
            "command": "sender",
            "explanation": "进入TWAMP Light发送端配置模式",
            "parameters": [],
            "test start-continual test-session 1 period 10": {
                "template": "test start-continual test-session [parameter1] period [parameter2]",
                "command": "test start-continual test-session 1 period 10",
                "explanation": "启动持续性的TWAMP Light测试，测试会话ID为1，测试周期为10秒",
                "parameters": [
                    {
                        "name": "session id",
                        "type": "integer",
                        "explanation": "会话ID"
                    },
                    {
                        "name": "period",
                        "type": "integer",
                        "explanation": "测试周期（秒）"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}