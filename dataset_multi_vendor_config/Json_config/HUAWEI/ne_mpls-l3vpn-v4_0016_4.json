{
    "sysname CE3": {
        "template": "sysname [parameter1]",
        "command": "sysname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Gigabitethernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface Gigabitethernet1/0/0",
        "explanation": "指定要配置的接口为 Gigabitethernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.3.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.3.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp 800": {
        "template": "bgp [parameter1]",
        "command": "bgp 800",
        "explanation": "启用BGP进程，AS号为800",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "BGP自治系统编号"
            }
        ],
        "peer 10.3.1.2 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.3.1.2 as-number 100",
            "explanation": "配置BGP对等体 10.3.1.2，AS号为100",
            "parameters": [
                {
                    "name": "peer IP",
                    "type": "IPv4",
                    "explanation": "对等体的IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族进行配置",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "禁用BGP同步",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "将直连路由引入BGP",
                "parameters": []
            },
            "peer 10.3.1.2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.3.1.2 enable",
                "explanation": "启用与对等体 10.3.1.2 的BGP会话",
                "parameters": [
                    {
                        "name": "peer IP",
                        "type": "IPv4",
                        "explanation": "对等体的IP地址"
                    }
                ]
            }
        }
    }
}