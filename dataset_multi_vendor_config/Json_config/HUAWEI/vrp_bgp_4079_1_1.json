{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp 65009": {
        "template": "bgp [parameter1]",
        "command": "bgp 65009",
        "explanation": "进入BGP配置模式，并设置本地AS号为65009",
        "parameters": [
            {
                "name": "local AS number",
                "type": "integer",
                "explanation": "本地AS号"
            }
        ],
        "peer 10.1.1.1 as-number 65008": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.1.1.1 as-number 65008",
            "explanation": "配置BGP对等体10.1.1.1，其AS号为65008",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "对等体的IPv4地址"
                },
                {
                    "name": "peer AS number",
                    "type": "integer",
                    "explanation": "对等体的AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族的配置模式",
            "parameters": [],
            "peer 10.1.1.1 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.1.1.1 enable",
                "explanation": "在对等体10.1.1.1上启用IPv4单播地址族",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "对等体的IPv4地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}