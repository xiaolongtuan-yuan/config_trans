{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口配置模式，配置GigabitEthernet1/0/0接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.10.3.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.3.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.10.3.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp 400": {
        "template": "bgp [parameter1]",
        "command": "bgp 400",
        "explanation": "进入BGP配置模式，配置AS号为400",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "AS号"
            }
        ],
        "router-id 4.4.4.4": {
            "template": "router-id [parameter1]",
            "command": "router-id 4.4.4.4",
            "explanation": "配置BGP的Router ID为4.4.4.4",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer 10.10.3.2 as-number 300": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.10.3.2 as-number 300",
            "explanation": "配置BGP对等体，IP地址为10.10.3.2，AS号为300",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "对等体IP地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "对等体AS号"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "进入IPv4单播地址族配置模式",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步",
                "parameters": []
            },
            "peer 10.10.3.2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.10.3.2 enable",
                "explanation": "启用与对等体10.10.3.2的BGP会话",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "对等体IP地址"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}