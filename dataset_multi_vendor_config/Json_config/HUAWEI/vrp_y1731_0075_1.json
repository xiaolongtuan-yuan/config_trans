            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入VLAN 2的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm version standard": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置CFM（Connectivity Fault Management）版本为标准版本",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "将接口模式切换为二层模式",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "port trunk allow-pass vlan 2": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "允许VLAN 2的流量通过该接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md md3": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
        "explanation": "进入CFM维护域md3的配置模式",
        "parameters": [
            {
                "name": "maintenance domain",
                "type": "string",
                "explanation": "维护域名"
            }
        ],
        "ma ma3": {
            "template": "ma [parameter1]",
            "command": "ma ma3",
            "explanation": "进入CFM维护关联ma3的配置模式",
            "parameters": [
                {
                    "name": "maintenance association",
                    "type": "string",
                    "explanation": "维护关联名"
                }
            ],
            "map vlan 2": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 2",
                "explanation": "将维护关联映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id 4 interface GigabitEthernet1/0/1 outward": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 4 interface GigabitEthernet1/0/1 outward",
                "explanation": "配置MEP（Maintenance End Point）ID为4，接口为GigabitEthernet1/0/1，方向为向外",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向"
                    }
                ]
            },
            "mep ccm-send mep-id 4 enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 4 enable",
                "explanation": "启用MEP ID为4的CCM（Continuity Check Message）发送功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id 3": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 3",
                "explanation": "配置远程MEP ID为3",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id 3 enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 3 enable",
                "explanation": "启用接收远程MEP ID为3的CCM消息功能",
                "parameters": [
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "test-id 1 mep 4 remote-mep 3": {
                "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "test-id 1 mep 4 remote-mep 3",
                "explanation": "配置测试ID为1，MEP ID为4，远程MEP ID为3",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "remote mep id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "loss-measure single-ended-synthetic receive test-id 1 time-out 300": {
                "template": "loss-measure single-ended-synthetic receive test-id [parameter1] time-out [parameter2]",
                "command": "loss-measure single-ended-synthetic receive test-id 1 time-out 300",
                "explanation": "配置单端合成丢失测量，接收测试ID为1，超时时间为300秒",
                "parameters": [
                    {
                        "name": "test id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "time-out",
                        "type": "integer",
                        "explanation": "超时时间"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回用户视图",
        "parameters": []
    }
