                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "关闭BGP与IGP的同步功能",
                "parameters": []
            },
            "peer 2001:db8:1::2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 2001:db8:1::2 enable",
