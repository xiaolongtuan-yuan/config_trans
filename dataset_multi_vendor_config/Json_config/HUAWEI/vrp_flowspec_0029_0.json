            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bgp 100": {
        "template": "bgp [parameter1]",
        "command": "bgp 100",
        "explanation": "进入BGP配置模式，配置AS号为100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "peer 2001:db8:1::2 as-number 200": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 2001:db8:1::2 as-number 200",
            "explanation": "配置BGP对等体2001:db8:1::2的AS号为200",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv6",
                    "explanation": "对等体IPv6地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
        "ipv6-family unicast": {
            "template": "ipv6-family [parameter1]",
