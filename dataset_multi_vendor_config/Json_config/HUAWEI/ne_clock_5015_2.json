{
    "sysname DeviceC": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "clock ssm-control on": {
        "template": "clock ssm-control [parameter1]",
        "command": "clock ssm-control on",
        "explanation": "启用SSM控制",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "控制状态"
            }
        ]
    },
    "clock bits-type bits0 2mbps": {
        "template": "clock bits-type [parameter1] [parameter2]",
        "command": "clock bits-type bits0 2mbps",
        "explanation": "设置BITS类型和速率",
        "parameters": [
            {
                "name": "bits type",
                "type": "string",
                "explanation": "BITS类型"
            },
            {
                "name": "rate",
                "type": "string",
                "explanation": "速率"
            }
        ]
    },
    "clock source bits0 synchronization enable": {
        "template": "clock source [parameter1] synchronization [parameter2]",
        "command": "clock source bits0 synchronization enable",
        "explanation": "启用BITS0同步",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "时钟源"
            },
            {
                "name": "synchronization state",
                "type": "string",
                "explanation": "同步状态"
            }
        ]
    },
    "clock source bits0 priority 1": {
        "template": "clock source [parameter1] priority [parameter2]",
        "command": "clock source bits0 priority 1",
        "explanation": "设置BITS0的优先级为1",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "时钟源"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "优先级"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入GigabitEthernet1/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock synchronization enable": {
            "template": "clock synchronization [parameter1]",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "同步状态"
                }
            ]
        }
    },
    "interface GigabitEthernet2/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "进入GigabitEthernet2/0/0接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock synchronization enable": {
            "template": "clock synchronization [parameter1]",
            "command": "clock synchronization enable",
            "explanation": "启用时钟同步",
            "parameters": [
                {
                    "name": "state",
                    "type": "string",
                    "explanation": "同步状态"
                }
            ]
        },
        "clock priority 3": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 3",
            "explanation": "设置时钟优先级为3",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        }
