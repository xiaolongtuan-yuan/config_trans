{
  "sysname client002": {
    "template": "sysname [parameter1]",
    "command": "sysname client002",
    "explanation": "设置设备的主机名为 'client002'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet0/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet0/0/0",
    "explanation": "进入接口配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "undo shutdown": {
      "template": "undo shutdown",
      "command": "undo shutdown",
      "explanation": "启用接口 (默认情况下接口是关闭的)",
      "parameters": []
    },
    "ip address 10.1.3.3 255.255.0.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.3.3 255.255.0.0",
      "explanation": "配置接口的IPv4地址为 10.1.3.3，子网掩码为 255.255.0.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "sub musk",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "rsa local-key-pair create 2048": {
    "template": "rsa local-key-pair create [parameter1]",
    "command": "rsa local-key-pair create 2048",
    "explanation": "生成长度为2048位的RSA本地密钥对",
    "parameters": [
      {
        "name": "key length",
        "type": "integer",
        "explanation": "密钥长度"
      }
    ]
  },
  "stelnet server enable": {
    "template": "stelnet server enable",
    "command": "stelnet server enable",
    "explanation": "启用STelnet服务器功能",
    "parameters": []
  },
  "ssh user admin authentication-type rsa": {
    "template": "ssh user [parameter1] authentication-type [parameter2]",
    "command": "ssh user admin authentication-type rsa",
    "explanation": "配置SSH用户 'admin' 的认证类型为RSA",
    "parameters": [
      {
        "name": "username",
        "type": "string",
        "explanation": "用户名"
      },
      {
        "name": "authentication type",
        "type": "string",
        "explanation": "认证类型"
      }
    ]
  },
  "rsa peer-public-key admin": {
    "template": "rsa peer-public-key [parameter1]",
    "command": "rsa peer-public-key admin",
    "explanation": "进入RSA对等公钥配置模式，配置名为 'admin' 的公钥",
    "parameters": [
      {
        "name": "key name",
        "type": "string",
        "explanation": "公钥名称"
      }
    ],
    "public-key-code begin": {
      "template": "public-key-code begin",
      "command": "public-key-code begin",
      "explanation": "开始输入公钥编码",
      "parameters": []
    },
    "public-key-code end": {
      "template": "public-key-code end",
      "command": "public-key-code end",
      "explanation": "结束输入公钥编码",
      "parameters": []
    }
