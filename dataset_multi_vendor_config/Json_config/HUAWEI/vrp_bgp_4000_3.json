        "template": "network [parameter1] [parameter2]",
        "command": "network 192.168.3.0 0.0.0.255",
        "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.3.0，通配符掩码为0.0.0.255",
        "parameters": [
          {
            "name": "network address",
            "type": "IPv4",
            "explanation": "网络地址"
          },
          {
            "name": "wildcard mask",
            "type": "IPv4",
            "explanation": "通配符掩码"
          }
        ]
      }
    }
  },
  "return": {
    "template": "return",
    "command": "return",
