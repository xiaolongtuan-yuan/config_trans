      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "sub musk",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "bgp 200": {
    "template": "bgp [parameter1]",
    "command": "bgp 200",
    "explanation": "进入BGP配置模式，配置AS号为200",
    "parameters": [
      {
        "name": "AS number",
        "type": "integer",
        "explanation": "AS号"
      }
    ],
    "router-id 4.4.4.4": {
      "template": "router-id [parameter1]",
      "command": "router-id 4.4.4.4",
      "explanation": "配置BGP的Router ID为4.4.4.4",
      "parameters": [
        {
          "name": "router id",
          "type": "IPv4",
          "explanation": "Router ID"
        }
      ]
    },
    "peer 192.168.3.1 as-number 200": {
      "template": "peer [parameter1] as-number [parameter2]",
      "command": "peer 192.168.3.1 as-number 200",
      "explanation": "配置BGP对等体，IP地址为192.168.3.1，AS号为200",
      "parameters": [
        {
          "name": "peer ip address",
          "type": "IPv4",
          "explanation": "对等体IP地址"
        },
        {
          "name": "AS number",
          "type": "integer",
          "explanation": "AS号"
        }
      ]
    },
    "ipv4-family unicast": {
      "template": "ipv4-family unicast",
      "command": "ipv4-family unicast",
      "explanation": "进入IPv4单播地址族配置模式",
      "parameters": [],
      "undo synchronization": {
        "template": "undo synchronization",
        "command": "undo synchronization",
        "explanation": "关闭BGP与IGP的同步",
        "parameters": []
      },
      "peer 192.168.3.1 enable": {
        "template": "peer [parameter1] enable",
        "command": "peer 192.168.3.1 enable",
        "explanation": "启用与对等体192.168.3.1的BGP会话",
        "parameters": [
          {
            "name": "peer ip address",
            "type": "IPv4",
            "explanation": "对等体IP地址"
          }
        ]
      }
    }
  },
  "ospf 1": {
    "template": "ospf [parameter1]",
    "command": "ospf 1",
    "explanation": "进入OSPF配置模式，配置进程号为1",
    "parameters": [
      {
        "name": "process id",
        "type": "integer",
        "explanation": "进程号"
      }
    ],
    "area 0.0.0.0": {
      "template": "area [parameter1]",
      "command": "area 0.0.0.0",
