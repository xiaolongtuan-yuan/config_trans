{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Lmpif1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "配置特定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "link-protocol ppp": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "设置接口的链路层协议为PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "链路层协议名称"
                }
            ]
        },
        "ip address 10.110.0.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.110.0.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ppp pap local-user rtb password cipher <password>": {
            "template": "ppp pap local-user [parameter1] password cipher [parameter2]",
            "command": "ppp pap local-user rtb password cipher <password>",
            "explanation": "配置PPP的PAP认证，本地用户为'rtb'，密码为加密的'<password>'",
            "parameters": [
                {
                    "name": "local-user",
                    "type": "string",
                    "explanation": "本地用户名"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "加密的密码"
                }
            ]
        }
    }
}