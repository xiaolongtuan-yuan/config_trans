            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "interface Eth-Trunk10": {
        "template": "interface [parameter1]",
