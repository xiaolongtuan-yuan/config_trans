{
  "sysname CE1": {
    "template": "sysname [parameter1]",
    "command": "sysname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan batch 10": {
    "template": "vlan batch [parameter1]",
    "command": "vlan batch 10",
    "explanation": "批量创建VLAN，这里创建了VLAN 10",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN ID"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "shutdown": {
      "template": "shutdown",
      "command": "shutdown",
      "explanation": "关闭接口",
      "parameters": []
    }
  },
  "interface GigabitEthernet1/0/0.10": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0.10",
    "explanation": "进入子接口GigabitEthernet1/0/0.10的配置模式",
    "parameters": [
      {
        "name": "sub-interface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "vlan-type dot1q 10": {
      "template": "vlan-type dot1q [parameter1]",
      "command": "vlan-type dot1q 10",
      "explanation": "配置子接口的VLAN类型为dot1q，并指定VLAN ID为10",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "ip address 10.1.1.1 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.1.1 255.255.255.0",
      "explanation": "配置子接口的IPv4地址为10.1.1.1，子网掩码为255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出当前配置模式，返回到用户视图",
    "parameters": []
