{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router id 2.2.2.2": {
        "template": "router id [parameter1]",
        "command": "router id 2.2.2.2",
        "explanation": "设置路由器的ID为2.2.2.2",
        "parameters": [
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "路由器ID"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 192.168.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为192.168.1.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ospf dr-priority 0": {
            "template": "ospf dr-priority [parameter1]",
            "command": "ospf dr-priority 0",
            "explanation": "设置OSPF的DR优先级为0",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "DR优先级"
                }
            ]
        }
    },
    "ospf 1": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "进入OSPF进程1的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "area 0.0.0.0": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "进入OSPF区域0.0.0.0的配置模式",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF区域ID"
                }
            ],
            "network 192.168.1.0 0.0.0.255": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.1.0 0.0.0.255",
                "explanation": "在OSPF区域0.0.0.0中宣告网络192.168.1.0，反掩码为0.0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "反掩码"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前视图，返回到用户视图",
        "parameters": []
    }
}