{
    "sysname DeviceC": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet 2/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 2/0/0",
        "explanation": "进入接口配置模式，配置接口 GigabitEthernet 2/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route-static 0.0.0.0 0.0.0.0 10.1.1.1": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 0.0.0.0 0.0.0.0 10.1.1.1",
        "explanation": "配置静态路由，目的地址为 0.0.0.0/0，下一跳地址为 10.1.1.1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "destination mask",
                "type": "IPv4",
                "explanation": "目的地址的子网掩码"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "下一跳地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
