{
  "sysname DeviceC": {
    "template": "sysname [parameter1]",
    "command": "sysname DeviceC",
    "explanation": "设置设备的主机名为 'DeviceC'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "router-id 3.3.3.3": {
    "template": "router-id [parameter1]",
    "command": "router-id 3.3.3.3",
    "explanation": "设置路由器的ID为 3.3.3.3",
    "parameters": [
      {
        "name": "router id",
        "type": "IPv4",
        "explanation": "路由器ID"
      }
    ]
  },
  "interface GigabitEthernet2/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet2/0/0",
    "explanation": "进入接口 GigabitEthernet2/0/0 的配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "undo shutdown": {
      "template": "undo shutdown",
      "command": "undo shutdown",
      "explanation": "启用接口 (默认情况下接口是关闭的)",
      "parameters": []
    },
    "ip address 10.1.1.2 255.0.0.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.1.2 255.0.0.0",
      "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.0.0.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "sub musk",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "ospf 1": {
    "template": "ospf [parameter1]",
    "command": "ospf 1",
    "explanation": "进入OSPF进程1的配置模式",
    "parameters": [
      {
        "name": "process id",
        "type": "integer",
        "explanation": "OSPF进程ID"
      }
    ],
    "area 0.0.0.0": {
      "template": "area [parameter1]",
      "command": "area 0.0.0.0",
      "explanation": "进入OSPF区域0.0.0.0的配置模式",
      "parameters": [
        {
          "name": "area id",
          "type": "IPv4",
          "explanation": "OSPF区域ID"
        }
      ],
      "network 10.0.0.0 0.255.255.255": {
        "template": "network [parameter1] [parameter2]",
        "command": "network 10.0.0.0 0.255.255.255",
        "explanation": "在OSPF区域0.0.0.0中宣告网络10.0.0.0，通配符掩码为0.255.255.255",
        "parameters": [
          {
            "name": "network address",
            "type": "IPv4",
            "explanation": "网络地址"
          },
          {
            "name": "wildcard mask",
            "type": "IPv4",
            "explanation": "通配符掩码"
          }
        ]
      }
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出当前配置模式，返回到用户视图",
    "parameters": []
  }
}