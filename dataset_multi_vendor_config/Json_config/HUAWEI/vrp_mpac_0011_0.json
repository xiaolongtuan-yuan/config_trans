{
    "sysname DeviceA": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "service-security global-binding ipv4 test": {
        "template": "service-security global-binding [parameter1] [parameter2]",
        "command": "service-security global-binding ipv4 test",
        "explanation": "全局绑定IPv4服务安全策略 'test'",
        "parameters": [
            {
                "name": "ip version",
                "type": "string",
                "explanation": "IP版本"
            },
            {
                "name": "policy name",
                "type": "string",
                "explanation": "策略名称"
            }
        ]
    },
    "service-security policy ipv4 test": {
        "template": "service-security policy [parameter1] [parameter2]",
        "command": "service-security policy ipv4 test",
        "explanation": "配置IPv4服务安全策略 'test'",
        "parameters": [
            {
                "name": "ip version",
                "type": "string",
                "explanation": "IP版本"
            },
            {
                "name": "policy name",
                "type": "string",
                "explanation": "策略名称"
            }
        ],
        "description rule 10 is deny ip packet which from 10.10.1.1": {
            "template": "description [parameter1]",
            "command": "description rule 10 is deny ip packet which from 10.10.1.1",
            "explanation": "描述规则10为拒绝来自10.10.1.1的IP包",
            "parameters": [
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "描述信息"
                }
            ]
        },
        "step 10": {
            "template": "step [parameter1]",
            "command": "step 10",
            "explanation": "设置策略步骤为10",
            "parameters": [
                {
                    "name": "step number",
                    "type": "integer",
                    "explanation": "步骤编号"
                }
            ]
        },
        "rule 10 deny protocol ip source-ip 10.10.1.1 0": {
            "template": "rule [parameter1] deny protocol [parameter2] source-ip [parameter3] [parameter4]",
            "command": "rule 10 deny protocol ip source-ip 10.10.1.1 0",
            "explanation": "配置规则10为拒绝协议为IP，源IP为10.10.1.1，通配符为0的流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "规则编号"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard",
                    "type": "integer",
                    "explanation": "通配符"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "进入接口GigabitEthernet1/0/0的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.10.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.10.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "service-security binding ipv4 test": {
            "template": "service-security binding [parameter1] [parameter2]",
            "command": "service-security binding ipv4 test",
            "explanation": "绑定IPv4服务安全策略 'test' 到接口",
            "parameters": [
                {
                    "name": "ip version",
                    "type": "string",
                    "explanation": "IP版本"
                },
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "策略名称"
                }
            ]
        }
    }
}