        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 172.17.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 172.17.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route-static 192.168.1.1 255.255.255.0 GigabitEthernet1/0/0": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 192.168.1.1 255.255.255.0 GigabitEthernet1/0/0",
        "explanation": "配置静态路由，目的地址为 192.168.1.1，子网掩码为 255.255.255.0，下一跳为接口 GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv4",
                "explanation": "目的地址"
            },
            {
                "name": "sub musk",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳接口"
            }
        ]
    },
