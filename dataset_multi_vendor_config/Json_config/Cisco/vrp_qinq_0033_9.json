{
    "hostname CE4": {
        "template": "hostname [parameter1]",
        "command": "hostname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "interface GigabitEthernet1/0/1.1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "配置子接口 'GigabitEthernet1/0/1.1'",
        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ],
        "encapsulation dot1Q 20": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 20",
            "explanation": "配置子接口的封装类型为 dot1Q，并指定 VLAN ID 为 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address 10.2.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.1 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.2.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}