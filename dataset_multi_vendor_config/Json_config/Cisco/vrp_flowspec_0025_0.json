{
  "hostname CE1": {
    "template": "hostname [parameter1]",
    "command": "hostname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "ipv6 enable": {
      "template": "ipv6 enable",
      "command": "ipv6 enable",
      "explanation": "启用接口的 IPv6 功能",
      "parameters": []
    },
    "ipv6 address 2001:db8:1::1/64": {
      "template": "ipv6 address [parameter1]",
      "command": "ipv6 address 2001:db8:1::1/64",
      "explanation": "配置接口的 IPv6 地址为 2001:db8:1::1，前缀长度为 64",
      "parameters": [
        {
          "name": "ipv6 address",
          "type": "IPv6",
          "explanation": "IPv6 地址"
        },
        {
          "name": "prefix length",
          "type": "integer",
          "explanation": "前缀长度"
        }
      ]
    }
  },
  "router bgp 100": {
    "template": "router bgp [parameter1]",
    "command": "router bgp 100",
    "explanation": "配置 BGP 进程，AS 号为 100",
    "parameters": [
      {
        "name": "AS number",
        "type": "integer",
        "explanation": "自治系统号"
      }
    ],
    "neighbor 2001:db8:1::2 remote-as 200": {
      "template": "neighbor [parameter1] remote-as [parameter2]",
      "command": "neighbor 2001:db8:1::2 remote-as 200",
      "explanation": "配置 BGP 邻居，邻居的 IPv6 地址为 2001:db8:1::2，远程 AS 号为 200",
      "parameters": [
        {
          "name": "neighbor ipv6 address",
          "type": "IPv6",
          "explanation": "邻居的 IPv6 地址"
        },
        {
          "name": "remote AS number",
          "type": "integer",
          "explanation": "远程自治系统号"
        }
      ]
    },
    "address-family ipv4 unicast": {
      "template": "address-family ipv4 unicast",
      "command": "address-family ipv4 unicast",
      "explanation": "进入 IPv4 单播地址族配置模式",
      "parameters": [],
      "no synchronization": {
        "template": "no synchronization",
        "command": "no synchronization",
        "explanation": "禁用 BGP 同步",
        "parameters": []
      }
    },
    "address-family ipv6 flow": {
      "template": "address-family ipv6 flow",
      "command": "address-family ipv6 flow",
      "explanation": "进入 IPv6 流地址族配置模式",
      "parameters": [],
      "neighbor 2001:db8:1::2 activate": {
        "template": "neighbor [parameter1] activate",
        "command": "neighbor 2001:db8:1::2 activate",
        "explanation": "激活邻居 2001:db8:1::2 的 IPv6 流地址族",
        "parameters": [
          {
            "name": "neighbor ipv6 address",
            "type": "IPv6",
            "explanation": "邻居的 IPv6 地址"
          }
        ]
      }
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}