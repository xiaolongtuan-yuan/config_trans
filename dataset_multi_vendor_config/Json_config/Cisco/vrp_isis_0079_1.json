{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis 1": {
        "template": "router isis [parameter1]",
        "command": "router isis 1",
        "explanation": "配置 IS-IS 路由进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS 进程 ID"
            }
        ],
        "isis level-1": {
            "template": "isis level-[parameter1]",
            "command": "isis level-1",
            "explanation": "配置 IS-IS 为 Level-1 路由",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "IS-IS 路由级别"
                }
            ]
        },
        "net 49.0000.0000.0002.00": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0002.00",
            "explanation": "配置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.2.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis enable 1": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "在接口上启用 IS-IS 进程 1",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS 进程 ID"
                }
            ]
        },
        "isis network point-to-point": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}