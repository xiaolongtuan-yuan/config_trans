{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address 2001:db8:1001::1/96": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1001::1/96",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1001::1/96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 ospf 1 area 0.0.0.0": {
            "template": "ipv6 ospf [parameter1] area [parameter2]",
            "command": "ipv6 ospf 1 area 0.0.0.0",
            "explanation": "在接口上启用 IPv6 OSPF 进程 1，并将其分配到区域 0.0.0.0",
            "parameters": [
                {
                    "name": "ospf process id",
                    "type": "integer",
                    "explanation": "OSPF 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        },
        "ipv6 ospf priority 100": {
            "template": "ipv6 ospf priority [parameter1]",
            "command": "ipv6 ospf priority 100",
            "explanation": "设置接口的 OSPF 优先级为 100",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "OSPF 优先级"
                }
            ]
        }
    },
    "ipv6 router ospf 1": {
        "template": "ipv6 router ospf [parameter1]",
        "command": "ipv6 router ospf 1",
        "explanation": "进入 IPv6 OSPF 进程 1 的配置模式",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id 1.1.1.1": {
            "template": "router-id [parameter1]",
            "command": "router-id 1.1.1.1",
            "explanation": "设置 OSPF 进程的 router ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF router ID"
                }
            ]
        },
        "area 0.0.0.0": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPF 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}