{
  "interface GigabitEthernet2/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet2/0/0",
    "explanation": "配置接口 'GigabitEthernet2/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "ipv6 enable": {
      "template": "ipv6 enable",
      "command": "ipv6 enable",
      "explanation": "启用接口的 IPv6 功能",
      "parameters": []
    },
    "ipv6 address 2001:db8:3::2/64": {
      "template": "ipv6 address [parameter1]",
      "command": "ipv6 address 2001:db8:3::2/64",
      "explanation": "配置接口的 IPv6 地址为 2001:db8:3::2，前缀长度为 64",
      "parameters": [
        {
          "name": "ipv6 address",
          "type": "IPv6",
          "explanation": "IPv6 地址"
        }
      ]
    },
    "ipv6 ospf 1 area 2": {
      "template": "ipv6 ospf [parameter1] area [parameter2]",
      "command": "ipv6 ospf 1 area 2",
      "explanation": "将接口加入到 OSPFv3 进程 1 的区域 2 中",
      "parameters": [
        {
          "name": "ospf process id",
          "type": "integer",
          "explanation": "OSPF 进程 ID"
        },
        {
          "name": "area id",
          "type": "integer",
          "explanation": "区域 ID"
        }
      ]
    }
  },
  "router ospfv3 1": {
    "template": "router ospfv3 [parameter1]",
    "command": "router ospfv3 1",
    "explanation": "配置 OSPFv3 进程 1",
    "parameters": [
      {
        "name": "ospf process id",
        "type": "integer",
        "explanation": "OSPF 进程 ID"
      }
    ],
    "router-id 4.4.4.4": {
      "template": "router-id [parameter1]",
      "command": "router-id 4.4.4.4",
      "explanation": "设置 OSPFv3 进程 1 的路由器 ID 为 4.4.4.4",
      "parameters": [
        {
          "name": "router id",
          "type": "IPv4",
          "explanation": "路由器 ID"
        }
      ]
    },
    "area 2 ipv4 0.0.0.2": {
      "template": "area [parameter1] ipv4 [parameter2]",
      "command": "area 2 ipv4 0.0.0.2",
      "explanation": "配置 OSPFv3 进程 1 的区域 2 的 IPv4 地址为 0.0.0.2",
      "parameters": [
        {
          "name": "area id",
          "type": "integer",
          "explanation": "区域 ID"
        },
        {
          "name": "ipv4 address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        }
      ]
    }
  }
}