            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入 BFD 配置模式",
        "parameters": []
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address 2001:db8:1::1/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        }
    },
    "ipv6 route ::/0 2001:db8:1::2": {
        "template": "ipv6 route [parameter1] [parameter2]",
        "command": "ipv6 route ::/0 2001:db8:1::2",
        "explanation": "配置 IPv6 默认路由，下一跳地址为 2001:db8:1::2",
        "parameters": [
            {
                "name": "destination prefix",
                "type": "IPv6",
                "explanation": "目的前缀"
            },
            {
                "name": "next-hop address",
                "type": "IPv6",
                "explanation": "下一跳地址"
            }
        ],
        "bfd interval 250 min_rx 250 multiplier 3": {
            "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
            "command": "bfd interval 250 min_rx 250 multiplier 3",
            "explanation": "配置 BFD 会话参数，发送间隔为 250ms，接收间隔为 250ms，乘数为 3",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "发送间隔（毫秒）"
                },
                {
                    "name": "min_rx",
                    "type": "integer",
                    "explanation": "接收间隔（毫秒）"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "乘数"
                }
            ]
        }
    },
    "bfd template local-remote": {
        "template": "bfd template [parameter1]",
        "command": "bfd template local-remote",
        "explanation": "创建名为 'local-remote' 的 BFD 模板",
        "parameters": [
            {
                "name": "template name",
                "type": "string",
                "explanation": "模板名称"
            }
        ],
        "discriminator local 10": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 10",
            "explanation": "配置本地 BFD 会话标识符为 10",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地会话标识符"
                }
            ]
        },
        "discriminator remote 20": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 20",
            "explanation": "配置远程 BFD 会话标识符为 20",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远程会话标识符"
                }
            ]
        }
    },
    "bfd peer 2001:db8:1::2 template local-remote": {
        "template": "bfd peer [parameter1] template [parameter2]",
        "command": "bfd peer 2001:db8:1::2 template local-remote",
        "explanation": "配置 BFD 对等体，使用 'local-remote' 模板",
        "parameters": [
            {
                "name": "peer address",
                "type": "IPv6",
                "explanation": "对等体地址"
            },
            {
                "name": "template name",
                "type": "string",
                "explanation": "模板名称"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}