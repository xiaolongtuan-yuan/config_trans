{
    "hostname CE2": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 100": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ],
        "name bridge-domain 10": {
            "template": "name [parameter1]",
            "command": "name bridge-domain 10",
            "explanation": "将 VLAN 100 命名为 'bridge-domain 10'",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "VLAN 的名称"
                }
            ]
        }
    },
    "interface Vbdif10": {
        "template": "interface [parameter1]",
        "command": "interface Vbdif10",
        "explanation": "配置接口 'Vbdif10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 192.168.1.12 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.12 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.12，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "interface GigabitEthernet1/0/0.100": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0.100",
        "explanation": "配置子接口 'GigabitEthernet1/0/0.100'",
        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ],
        "encapsulation dot1q 100 second-dot1q 100": {
            "template": "encapsulation dot1q [parameter1] second-dot1q [parameter2]",
            "command": "encapsulation dot1q 100 second-dot1q 100",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 100，第二层 VLAN ID 也为 100",
            "parameters": [
                {
                    "name": "first VLAN ID",
                    "type": "integer",
                    "explanation": "第一层 VLAN ID"
                },
                {
                    "name": "second VLAN ID",
                    "type": "integer",
                    "explanation": "第二层 VLAN ID"
                }
            ]
        },
        "bridge-domain 10": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将子接口关联到桥接域 10",
            "parameters": [
                {
                    "name": "bridge domain ID",
                    "type": "integer",
                    "explanation": "桥接域 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}