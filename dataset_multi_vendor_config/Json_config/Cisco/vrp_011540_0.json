      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan batch 2": {
    "template": "vlan batch [parameter1]",
    "command": "vlan batch 2",
    "explanation": "批量创建 VLAN，此处为 VLAN 2",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN ID"
      }
    ]
  },
  "cfm version standard": {
    "template": "cfm version [parameter1]",
    "command": "cfm version standard",
    "explanation": "设置 CFM 版本为标准版本",
    "parameters": [
      {
        "name": "version",
        "type": "string",
        "explanation": "CFM 版本"
      }
    ]
  },
  "cfm": {
    "template": "cfm",
    "command": "cfm",
    "explanation": "启用 CFM 功能",
    "parameters": []
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "设置接口模式为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "switchport trunk allowed vlan add 2": {
      "template": "switchport trunk allowed vlan add [parameter1]",
      "command": "switchport trunk allowed vlan add 2",
      "explanation": "允许 VLAN 2 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    }
  },
  "cfm md md3": {
    "template": "cfm md [parameter1]",
    "command": "cfm md md3",
    "explanation": "配置 CFM 维护域为 md3",
    "parameters": [
      {
        "name": "maintenance domain",
        "type": "string",
        "explanation": "维护域名"
      }
    ],
    "cfm ma ma3": {
      "template": "cfm ma [parameter1]",
      "command": "cfm ma ma3",
      "explanation": "配置 CFM 维护关联为 ma3",
      "parameters": [
        {
          "name": "maintenance association",
          "type": "string",
          "explanation": "维护关联名"
        }
      ],
      "cfm ma ma3 vlan 2": {
        "template": "cfm ma [parameter1] vlan [parameter2]",
        "command": "cfm ma ma3 vlan 2",
        "explanation": "将维护关联 ma3 与 VLAN 2 绑定",
        "parameters": [
          {
            "name": "maintenance association",
            "type": "string",
            "explanation": "维护关联名"
          },
          {
            "name": "vlan id",
            "type": "integer",
            "explanation": "VLAN ID"
          }
        ]
      },
      "cfm mep mep-id 3 interface GigabitEthernet1/0/1 direction outward": {
        "template": "cfm mep mep-id [parameter1] interface [parameter2] direction [parameter3]",
        "command": "cfm mep mep-id 3 interface GigabitEthernet1/0/1 direction outward",
        "explanation": "配置 MEP ID 为 3，接口为 GigabitEthernet1/0/1，方向为 outward",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "MEP ID"
          },
          {
            "name": "interface name",
            "type": "string",
            "explanation": "接口名"
          },
          {
            "name": "direction",
            "type": "string",
            "explanation": "方向"
          }
        ]
      },
      "cfm mep mep-id 3 ccm-send enable": {
        "template": "cfm mep mep-id [parameter1] ccm-send [parameter2]",
        "command": "cfm mep mep-id 3 ccm-send enable",
        "explanation": "启用 MEP ID 为 3 的 CCM 发送功能",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "MEP ID"
          },
          {
            "name": "ccm send",
            "type": "string",
            "explanation": "CCM 发送状态"
          }
        ]
      },
      "cfm mep mep-id 4 remote-mep": {
        "template": "cfm mep mep-id [parameter1] remote-mep",
        "command": "cfm mep mep-id 4 remote-mep",
        "explanation": "配置 MEP ID 为 4 的远程 MEP",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "MEP ID"
          }
        ]
      },
      "cfm mep mep-id 4 ccm-receive enable": {
        "template": "cfm mep mep-id [parameter1] ccm-receive [parameter2]",
        "command": "cfm mep mep-id 4 ccm-receive enable",
        "explanation": "启用 MEP ID 为 4 的 CCM 接收功能",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "MEP ID"
          },
          {
            "name": "ccm receive",
            "type": "string",
            "explanation": "CCM 接收状态"
          }
        ]
      },
      "cfm mep mep-id 3 test-id 1 remote-mep 4": {
        "template": "cfm mep mep-id [parameter1] test-id [parameter2] remote-mep [parameter3]",
        "command": "cfm mep mep-id 3 test-id 1 remote-mep 4",
        "explanation": "配置 MEP ID 为 3 的测试 ID 为 1，远程 MEP 为 4",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "MEP ID"
          },
          {
            "name": "test id",
            "type": "integer",
            "explanation": "测试 ID"
          },
          {
            "name": "remote mep",
            "type": "integer",
            "explanation": "远程 MEP ID"
          }
        ]
      }
    }
