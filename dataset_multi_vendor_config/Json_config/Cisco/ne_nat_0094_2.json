    "parameters": [
      {
        "name": "access-list number",
        "type": "integer",
        "explanation": "访问控制列表编号"
      },
      {
        "name": "source network",
        "type": "IPv4",
        "explanation": "源网络地址"
      },
      {
        "name": "wildcard mask",
        "type": "IPv4",
        "explanation": "通配符掩码"
      }
    ]
  },
  "ip nat inside source list 2001 pool nat1 overload": {
    "template": "ip nat inside source list [parameter1] pool [parameter2] overload",
    "command": "ip nat inside source list 2001 pool nat1 overload",
    "explanation": "配置NAT，将内部源地址列表2001映射到地址池nat1，并启用端口地址转换（PAT）",
    "parameters": [
      {
        "name": "access-list number",
        "type": "integer",
        "explanation": "访问控制列表编号"
      },
      {
        "name": "pool name",
        "type": "string",
        "explanation": "地址池名称"
      }
    ]
  },
  "ip nat pool nat1 10.34.161.101 10.34.161.105 netmask 255.255.255.0": {
    "template": "ip nat pool [parameter1] [parameter2] [parameter3] netmask [parameter4]",
    "command": "ip nat pool nat1 10.34.161.101 10.34.161.105 netmask 255.255.255.0",
    "explanation": "定义一个名为nat1的NAT地址池，地址范围为10.34.161.101到10.34.161.105，子网掩码为255.255.255.0",
    "parameters": [
      {
        "name": "pool name",
        "type": "string",
        "explanation": "地址池名称"
      },
      {
        "name": "start IP",
        "type": "IPv4",
        "explanation": "起始IP地址"
      },
      {
        "name": "end IP",
        "type": "IPv4",
        "explanation": "结束IP地址"
      },
      {
        "name": "netmask",
        "type": "IPv4",
        "explanation": "子网掩码"
      }
    ]
  },
