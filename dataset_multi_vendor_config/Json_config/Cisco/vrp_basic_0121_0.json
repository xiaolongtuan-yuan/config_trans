{
    "hostname Router1": {
        "template": "hostname [parameter1]",
        "command": "hostname Router1",
        "explanation": "Set the device host name to 'Router1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "the hostname of this device"
            }
        ]
    },
    "interface FastEthernet0/0": {
        "template": "interface [parameter1]",
        "command": "interface FastEthernet0/0",
        "explanation": "Configure interface 'FastEthernet0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "interface name"
            }
        ],
        "ip address 192.168.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "The IPv4 address of the configuration interface is 192.168.1.1, and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "subnet mask"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable the interface (the interface is disabled by default)",
            "parameters": []
