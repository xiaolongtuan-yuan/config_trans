{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "controller E1 5/0/0": {
        "template": "controller [parameter1]",
        "command": "controller E1 5/0/0",
        "explanation": "配置 E1 控制器 '5/0/0'",
        "parameters": [
            {
                "name": "controller name",
                "type": "string",
                "explanation": "控制器名"
            }
        ],
        "framing NO-CRC4": {
            "template": "framing [parameter1]",
            "command": "framing NO-CRC4",
            "explanation": "设置 E1 控制器的帧格式为 'NO-CRC4'",
            "parameters": [
                {
                    "name": "framing type",
                    "type": "string",
                    "explanation": "帧格式类型"
                }
            ]
        },
        "channel-group 0 timeslots 1-31": {
            "template": "channel-group [parameter1] timeslots [parameter2]",
            "command": "channel-group 0 timeslots 1-31",
            "explanation": "配置 E1 控制器的通道组 0，时隙为 1-31",
            "parameters": [
                {
                    "name": "channel group",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "时隙范围"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用 E1 控制器（默认情况下控制器是关闭的）",
            "parameters": []
        }
    },
    "interface Multilink5/0/1": {
        "template": "interface [parameter1]",
        "command": "interface Multilink5/0/1",
        "explanation": "配置接口 'Multilink5/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address <IP_ADDRESS> <SUBNET_MASK>": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address <IP_ADDRESS> <SUBNET_MASK>",
            "explanation": "配置接口的 IPv4 地址为 <IP_ADDRESS>，子网掩码为 <SUBNET_MASK>",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "interface Serial5/0/0:0": {
        "template": "interface [parameter1]",
        "command": "interface Serial5/0/0:0",
        "explanation": "配置接口 'Serial5/0/0:0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "encapsulation ppp": {
            "template": "encapsulation [parameter1]",
            "command": "encapsulation ppp",
            "explanation": "设置接口的封装类型为 'PPP'",
            "parameters": [
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "封装类型"
                }
            ]
        },
        "ppp multilink group 5/0/1": {
            "template": "ppp multilink group [parameter1]",
            "command": "ppp multilink group 5/0/1",
            "explanation": "将接口加入到多链路 PPP 组 '5/0/1'",
            "parameters": [
                {
                    "name": "multilink group",
                    "type": "string",
                    "explanation": "多链路 PPP 组名"
                }
            ]
        }
    }
}