{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode access": {
            "template": "switchport mode access",
            "command": "switchport mode access",
            "explanation": "将接口模式设置为访问模式",
            "parameters": []
        },
        "switchport access vlan 10": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/2": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "配置接口 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode trunk",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为中继模式",
            "parameters": []
        },
        "switchport trunk allowed vlan 10": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许 VLAN 10 通过中继接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
