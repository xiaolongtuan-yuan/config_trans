{
    "hostname DeviceC": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ntp master 2": {
        "template": "ntp master [parameter1]",
        "command": "ntp master 2",
        "explanation": "配置设备为 NTP 主服务器，层级为 2",
        "parameters": [
            {
                "name": "stratum level",
                "type": "integer",
                "explanation": "NTP 层级"
            }
        ]
    },
    "ntp server 10.0.1.1 source GigabitEthernet1/0/0": {
        "template": "ntp server [parameter1] source [parameter2]",
        "command": "ntp server 10.0.1.1 source GigabitEthernet1/0/0",
        "explanation": "配置设备使用 '10.0.1.1' 作为 NTP 服务器，并通过 'GigabitEthernet1/0/0' 接口发送 NTP 请求",
        "parameters": [
            {
                "name": "ntp server address",
                "type": "IPv4",
                "explanation": "NTP 服务器地址"
            },
            {
                "name": "source interface",
                "type": "string",
                "explanation": "发送 NTP 请求的源接口"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.0.1.31 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.1.31 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.1.31，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "ntp broadcast client": {
            "template": "ntp broadcast client",
            "command": "ntp broadcast client",
            "explanation": "配置接口为 NTP 广播客户端",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}