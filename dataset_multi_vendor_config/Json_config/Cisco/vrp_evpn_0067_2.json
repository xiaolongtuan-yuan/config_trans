{
  "hostname CE": {
    "template": "hostname [parameter1]",
    "command": "hostname CE",
    "explanation": "设置设备的主机名为 'CE'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan 1-4094": {
    "template": "vlan [parameter1]",
    "command": "vlan 1-4094",
    "explanation": "创建 VLAN 1 到 4094",
    "parameters": [
      {
        "name": "vlan range",
        "type": "range",
        "explanation": "VLAN 范围"
      }
    ]
  },
  "interface Port-channel1": {
    "template": "interface [parameter1]",
    "command": "interface Port-channel1",
    "explanation": "配置接口 'Port-channel1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "switchport": {
      "template": "switchport",
      "command": "switchport",
      "explanation": "将接口配置为二层交换端口",
      "parameters": []
    },
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "将接口模式设置为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "switchport trunk allowed vlan 1-2": {
      "template": "switchport trunk allowed vlan [parameter1]",
      "command": "switchport trunk allowed vlan 1-2",
      "explanation": "允许 VLAN 1 和 2 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan range",
          "type": "range",
          "explanation": "允许通过的 VLAN 范围"
        }
      ]
    }
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "channel-group 1 mode on": {
      "template": "channel-group [parameter1] mode [parameter2]",
      "command": "channel-group 1 mode on",
      "explanation": "将接口加入到通道组 1 并设置为 on 模式",
      "parameters": [
        {
          "name": "channel-group number",
          "type": "integer",
          "explanation": "通道组编号"
        },
        {
          "name": "mode",
          "type": "string",
          "explanation": "通道组模式"
        }
      ]
    }
  },
  "interface GigabitEthernet1/0/2": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/2",
    "explanation": "配置接口 'GigabitEthernet1/0/2'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "channel-group 1 mode on": {
      "template": "channel-group [parameter1] mode [parameter2]",
      "command": "channel-group 1 mode on",
      "explanation": "将接口加入到通道组 1 并设置为 on 模式",
      "parameters": [
        {
          "name": "channel-group number",
          "type": "integer",
          "explanation": "通道组编号"
        },
        {
          "name": "mode",
          "type": "string",
          "explanation": "通道组模式"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
