{
    "hostname DeviceD": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "配置接口 'GigabitEthernet3/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router rip": {
        "template": "router [parameter1]",
        "command": "router rip",
        "explanation": "进入 RIP 路由协议的配置模式",
        "parameters": [
            {
                "name": "routing protocol",
                "type": "string",
                "explanation": "路由协议"
            }
        ],
        "version 2": {
            "template": "version [parameter1]",
            "command": "version 2",
            "explanation": "设置 RIP 协议的版本为 2",
            "parameters": [
                {
                    "name": "version",
                    "type": "integer",
                    "explanation": "版本号"
                }
            ]
        },
        "network 10.0.0.0": {
            "template": "network [parameter1]",
            "command": "network 10.0.0.0",
            "explanation": "在 RIP 协议中宣告网络 10.0.0.0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出当前配置模式，返回到特权 EXEC 模式",
        "parameters": []
    }
}