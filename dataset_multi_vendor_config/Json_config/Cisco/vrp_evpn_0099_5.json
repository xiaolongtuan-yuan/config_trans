{
  "hostname CE2": {
    "template": "hostname [parameter1]",
    "command": "hostname CE2",
    "explanation": "设置设备的主机名为 'CE2'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "bridge-domain 10": {
    "template": "bridge-domain [parameter1]",
    "command": "bridge-domain 10",
    "explanation": "创建或进入桥域 10 的配置模式",
    "parameters": [
      {
        "name": "bridge-domain ID",
        "type": "integer",
        "explanation": "桥域标识符"
      }
    ]
  },
  "interface Vbdif10": {
    "template": "interface [parameter1]",
    "command": "interface Vbdif10",
    "explanation": "配置虚拟桥域接口 'Vbdif10'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "ip address 192.168.1.12 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 192.168.1.12 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 192.168.1.12，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    }
  },
  "interface GigabitEthernet1/0/0.10": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0.10",
    "explanation": "配置子接口 'GigabitEthernet1/0/0.10'",
    "parameters": [
      {
        "name": "sub-interface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 10": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为 dot1q，并指定 VLAN ID 为 10",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN 标识符"
        }
      ]
    },
    "bridge-domain 10": {
      "template": "bridge-domain [parameter1]",
      "command": "bridge-domain 10",
      "explanation": "将子接口关联到桥域 10",
      "parameters": [
        {
          "name": "bridge-domain ID",
          "type": "integer",
          "explanation": "桥域标识符"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}