{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet3/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1",
        "explanation": "配置接口 'GigabitEthernet3/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 172.16.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "interface Loopback0": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置环回接口 'Loopback0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 1.1.1.1 255.255.255.255": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置环回接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 65008": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65008",
        "explanation": "配置 BGP 进程，AS 号为 65008",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "bgp router-id 1.1.1.1": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 1.1.1.1",
            "explanation": "设置 BGP 路由器的 ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "neighbor 172.16.1.2 remote-as 65009": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.1.2 remote-as 65009",
            "explanation": "配置 BGP 邻居，IP 地址为 172.16.1.2，远程 AS 号为 65009",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居 IP 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                }
            ],
            "redistribute connected": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "重分发直连路由到 BGP",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "源协议"
                    }
                ]
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}