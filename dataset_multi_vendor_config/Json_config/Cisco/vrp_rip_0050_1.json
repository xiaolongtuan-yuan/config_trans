{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "access-list 2000 deny ip 192.168.4.0 0.0.0.255 any": {
        "template": "access-list [parameter1] deny ip [parameter2] [parameter3] [parameter4]",
        "command": "access-list 2000 deny ip 192.168.4.0 0.0.0.255 any",
        "explanation": "创建一个访问控制列表，拒绝从 192.168.4.0/24 网段到任何目的地的 IP 流量",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source network",
                "type": "IPv4",
                "explanation": "源网络地址"
            },
            {
                "name": "source wildcard mask",
                "type": "IPv4",
                "explanation": "源网络通配符掩码"
            },
            {
                "name": "destination",
                "type": "keyword",
                "explanation": "目的地，'any' 表示任何地址"
            }
        ]
    },
    "access-list 2000 permit any": {
        "template": "access-list [parameter1] permit [parameter2]",
        "command": "access-list 2000 permit any",
        "explanation": "允许任何流量通过访问控制列表 2000",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source",
                "type": "keyword",
                "explanation": "源，'any' 表示任何地址"
            }
        ]
    },
