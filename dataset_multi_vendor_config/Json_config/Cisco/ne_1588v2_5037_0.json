{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp clock-domain 1": {
        "template": "ptp clock-domain [parameter1]",
        "command": "ptp clock-domain 1",
        "explanation": "配置 PTP（精确时间协议）时钟域 1",
        "parameters": [
            {
                "name": "clock domain number",
                "type": "integer",
                "explanation": "时钟域的编号"
            }
        ],
        "device-type server": {
            "template": "device-type [parameter1]",
            "command": "device-type server",
            "explanation": "设置设备类型为服务器",
            "parameters": [
                {
                    "name": "device type",
                    "type": "string",
                    "explanation": "设备类型，如服务器或客户端"
                }
            ]
        },
        "local-ip 1.1.1.1": {
            "template": "local-ip [parameter1]",
            "command": "local-ip 1.1.1.1",
            "explanation": "设置本地 IP 地址为 1.1.1.1",
            "parameters": [
                {
                    "name": "local IP",
                    "type": "IPv4",
                    "explanation": "本地 IP 地址"
                }
            ]
        },
        "unicast-negotiate enable": {
            "template": "unicast-negotiate [parameter1]",
            "command": "unicast-negotiate enable",
            "explanation": "启用单播协商",
            "parameters": [
                {
                    "name": "negotiation status",
                    "type": "string",
                    "explanation": "协商状态，如启用或禁用"
                }
            ]
        }
    },
    "interface Loopback0": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置 Loopback0 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "ip address 1.1.1.1 255.255.255.255": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 1.1.1.1，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}