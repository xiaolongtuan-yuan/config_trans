{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 100": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "spanning-tree mode pvst": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode pvst",
        "explanation": "设置生成树协议模式为 PVST (Per-VLAN Spanning Tree)",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan 100": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许 VLAN 100 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "spanning-tree vlan 100 root primary": {
            "template": "spanning-tree vlan [parameter1] root primary",
            "command": "spanning-tree vlan 100 root primary",
            "explanation": "设置 VLAN 100 的生成树根桥为主根桥",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}