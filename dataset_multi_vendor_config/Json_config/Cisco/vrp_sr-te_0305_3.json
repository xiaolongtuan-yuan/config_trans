            "parameters": [
                {
                    "name": "circuit type",
                    "type": "string",
                    "explanation": "电路类型"
                }
            ]
        },
        "isis wide-metric-style": {
            "template": "isis wide-metric-style",
            "command": "isis wide-metric-style",
