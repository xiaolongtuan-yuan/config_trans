            "parameters": []
        },
        "isis net-entity 10.0000.0000.0005.00": {
            "template": "isis net-entity [parameter1]",
            "command": "isis net-entity 10.0000.0000.0005.00",
            "explanation": "配置 IS-IS 网络实体标题 (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "网络实体标题"
                }
            ]
