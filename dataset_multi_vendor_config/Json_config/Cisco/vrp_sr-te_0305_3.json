            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由进程配置模式",
        "parameters": [],
        "isis circuit-type level-2-only": {
            "template": "isis circuit-type [parameter1]",
            "command": "isis circuit-type level-2-only",
