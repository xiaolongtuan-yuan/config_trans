{
  "hostname CE1": {
    "template": "hostname [parameter1]",
    "command": "hostname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet2/0/0.1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet2/0/0.1",
    "explanation": "配置子接口 'GigabitEthernet2/0/0.1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 1": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 1",
      "explanation": "配置子接口的封装类型为 dot1q，并指定 VLAN ID 为 1",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN 标识符"
        }
      ]
    },
    "ipv6 enable": {
      "template": "ipv6 enable",
      "command": "ipv6 enable",
      "explanation": "启用接口的 IPv6 功能",
      "parameters": []
    },
    "ipv6 address 2001:DB8::1/64": {
      "template": "ipv6 address [parameter1]",
      "command": "ipv6 address 2001:DB8::1/64",
      "explanation": "配置接口的 IPv6 地址为 2001:DB8::1，前缀长度为 64",
      "parameters": [
        {
          "name": "IPv6 address",
          "type": "IPv6",
          "explanation": "IPv6 地址"
        },
        {
          "name": "prefix length",
          "type": "integer",
          "explanation": "前缀长度"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}