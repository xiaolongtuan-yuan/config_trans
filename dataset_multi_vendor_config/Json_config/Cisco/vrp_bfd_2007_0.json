{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入 BFD 配置模式",
        "parameters": []
    },
    "router ospfv3 1": {
        "template": "router ospfv3 [parameter1]",
        "command": "router ospfv3 1",
        "explanation": "进入 OSPFv3 进程 1 的配置模式",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPFv3 进程 ID"
            }
        ],
        "router-id 1.1.1.1": {
            "template": "router-id [parameter1]",
            "command": "router-id 1.1.1.1",
            "explanation": "设置 OSPFv3 进程的 Router ID 为 1.1.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "area 0.0.0.0": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "配置 OSPFv3 区域 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address 2001:db8:1::1/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:1::1，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "前缀长度"
                }
            ]
        },
        "ospfv3 1 area 0.0.0.0": {
            "template": "ospfv3 [parameter1] area [parameter2]",
            "command": "ospfv3 1 area 0.0.0.0",
            "explanation": "将接口加入到 OSPFv3 进程 1 的区域 0.0.0.0",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "OSPFv3 进程 ID"
                },
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSPFv3 区域 ID"
                }
            ]
        }
    },
    "bfd ipv6 session 2001:db8:2::2": {
        "template": "bfd ipv6 session [parameter1]",
        "command": "bfd ipv6 session 2001:db8:2::2",
        "explanation": "配置 BFD IPv6 会话，对端地址为 2001:db8:2::2",
        "parameters": [
            {
                "name": "peer ipv6 address",
                "type": "IPv6",
                "explanation": "对端 IPv6 地址"
            }
        ],
        "local discriminator 1": {
            "template": "local discriminator [parameter1]",
            "command": "local discriminator 1",
            "explanation": "设置本地鉴别器为 1",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地鉴别器"
                }
            ]
        },
        "remote discriminator 2": {
            "template": "remote discriminator [parameter1]",
            "command": "remote discriminator 2",
            "explanation": "设置远端鉴别器为 2",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端鉴别器"
                }
            ]
        }
    }
}