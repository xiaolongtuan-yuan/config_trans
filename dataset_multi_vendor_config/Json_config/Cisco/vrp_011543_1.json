{
    "hostname CE2": {
        "template": "hostname [hostname]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [vlan-id]",
        "command": "vlan 2",
        "explanation": "创建或配置VLAN 2",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "cfm version standard": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [mode]",
            "command": "switchport mode trunk",
            "explanation": "设置接口的交换端口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "端口模式（access或trunk）"
                }
            ]
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [vlan-list]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2通过trunk接口",
            "parameters": [
                {
                    "name": "vlan-list",
                    "type": "string",
                    "explanation": "允许的VLAN列表"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "ethernet cfm mode on": {
        "template": "ethernet cfm mode [mode]",
        "command": "ethernet cfm mode on",
        "explanation": "设置以太网CFM模式为on",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "模式（on或off）"
            }
        ]
    },
    "ethernet cfm md md3": {
        "template": "ethernet cfm md [md-name]",
        "command": "ethernet cfm md md3",
        "explanation": "配置CFM域md3",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "CFM域名称"
            }
        ],
        "ethernet cfm ma ma3": {
            "template": "ethernet cfm ma [ma-name]",
            "command": "ethernet cfm ma ma3",
            "explanation": "配置CFM维护关联ma3",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "维护关联名称"
                }
            ],
            "ethernet cfm ma vlan 2": {
                "template": "ethernet cfm ma vlan [vlan-id]",
                "command": "ethernet cfm ma vlan 2",
                "explanation": "将MA关联到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN标识号"
                    }
                ]
            },
            "ethernet cfm mep 4 interface GigabitEthernet1/0/1 direction egress": {
                "template": "ethernet cfm mep [mep-id] interface [interface-name] direction [direction]",
                "command": "ethernet cfm mep 4 interface GigabitEthernet1/0/1 direction egress",
                "explanation": "配置MEP ID 4在接口GigabitEthernet1/0/1上，方向为egress",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（ingress或egress）"
                    }
                ]
            },
            "ethernet cfm mep 4 ccm-send enable": {
                "template": "ethernet cfm mep [mep-id] ccm-send enable",
                "command": "ethernet cfm mep 4 ccm-send enable",
                "explanation": "启用MEP 4的CCM发送",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    }
                ]
            },
            "ethernet cfm remote-mep 3": {
                "template": "ethernet cfm remote-mep [remote-mep-id]",
                "command": "ethernet cfm remote-mep 3",
                "explanation": "配置远程MEP ID 3",
                "parameters": [
                    {
                        "name": "remote-mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    }
                ],
                "ethernet cfm remote-mep 3 ccm-receive enable": {
                    "template": "ethernet cfm remote-mep [remote-mep-id] ccm-receive enable",
                    "command": "ethernet cfm remote-mep 3 ccm-receive enable",
                    "explanation": "启用远程MEP 3的CCM接收",
                    "parameters": [
                        {
                            "name": "remote-mep-id",
                            "type": "integer",
                            "explanation": "远程MEP标识号"
                        }
                    ]
                }
            },
            "ethernet cfm delay-measure receive test-id 1 mep 4": {
                "template": "ethernet cfm delay-measure receive test-id [test-id] mep [mep-id]",
                "command": "ethernet cfm delay-measure receive test-id 1 mep 4",
                "explanation": "配置延迟测量接收，测试ID 1，MEP 4",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    }
                ]
            },
            "ethernet cfm delay-measure send test-id 2 mep 4 remote-mep 3 interval 1000": {
                "template": "ethernet cfm delay-measure send test-id [test-id] mep [mep-id] remote-mep [remote-mep-id] interval [interval]",
                "command": "ethernet cfm delay-measure send test-id 2 mep 4 remote-mep 3 interval 1000",
                "explanation": "配置延迟测量发送，测试ID 2，MEP 4，远程MEP 3，间隔1000毫秒",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP标识号"
                    },
                    {
                        "name": "remote-mep-id",
                        "type": "integer",
                        "explanation": "远程MEP标识号"
                    },
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "间隔时间（毫秒）"
                    }
                ]
            }
        }
    }
}