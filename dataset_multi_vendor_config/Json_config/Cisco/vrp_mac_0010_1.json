{
    "hostname CE": {
        "template": "hostname [parameter1]",
        "command": "hostname CE",
        "explanation": "设置设备的主机名为 'CE'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或进入 VLAN 2 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "mac access-list extended MAC-LIMIT": {
        "template": "mac access-list extended [parameter1]",
        "command": "mac access-list extended MAC-LIMIT",
        "explanation": "创建一个名为 'MAC-LIMIT' 的扩展 MAC 访问控制列表",
        "parameters": [
            {
                "name": "access-list name",
                "type": "string",
                "explanation": "访问控制列表的名称"
            }
        ],
        "permit any": {
            "template": "permit [parameter1]",
            "command": "permit any",
            "explanation": "允许所有 MAC 地址通过",
            "parameters": [
                {
                    "name": "source",
                    "type": "string",
                    "explanation": "源地址，'any' 表示任何地址"
                }
            ]
        },
        "exit": {
            "template": "exit",
            "command": "exit",
            "explanation": "退出当前配置模式",
            "parameters": []
        }
    },
    "mac address-table static MAC-LIMIT vlan 2 interface GigabitEthernet1/0/1 limit threshold 100 action forward": {
        "template": "mac address-table static [parameter1] vlan [parameter2] interface [parameter3] limit threshold [parameter4] action [parameter5]",
        "command": "mac address-table static MAC-LIMIT vlan 2 interface GigabitEthernet1/0/1 limit threshold 100 action forward",
        "explanation": "在 VLAN 2 中为接口 GigabitEthernet1/0/1 静态配置 MAC 地址表，限制阈值为 100，动作为转发",
        "parameters": [
            {
                "name": "access-list name",
                "type": "string",
                "explanation": "访问控制列表的名称"
            },
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称"
            },
            {
                "name": "threshold",
                "type": "integer",
                "explanation": "限制阈值"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作，'forward' 表示转发"
            }
        ]
    },
    "mac address-table static MAC-LIMIT vlan 2 interface GigabitEthernet2/0/1 limit threshold 100 action forward": {
        "template": "mac address-table static [parameter1] vlan [parameter2] interface [parameter3] limit threshold [parameter4] action [parameter5]",
        "command": "mac address-table static MAC-LIMIT vlan 2 interface GigabitEthernet2/0/1 limit threshold 100 action forward",
        "explanation": "在 VLAN 2 中为接口 GigabitEthernet2/0/1 静态配置 MAC 地址表，限制阈值为 100，动作为转发",
        "parameters": [
            {
                "name": "access-list name",
                "type": "string",
                "explanation": "访问控制列表的名称"
            },
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称"
            },
            {
                "name": "threshold",
                "type": "integer",
                "explanation": "限制阈值"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作，'forward' 表示转发"
            }
