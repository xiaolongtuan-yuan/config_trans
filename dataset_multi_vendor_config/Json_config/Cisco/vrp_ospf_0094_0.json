      "parameters": [
        {
          "name": "router id",
          "type": "IPv4",
          "explanation": "OSPF 路由器 ID"
        }
      ]
    },
    "network 192.168.0.0 0.0.0.255 area 0": {
      "template": "network [parameter1] [parameter2] area [parameter3]",
      "command": "network 192.168.0.0 0.0.0.255 area 0",
