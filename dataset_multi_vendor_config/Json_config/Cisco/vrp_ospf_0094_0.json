      "parameters": [
        {
          "name": "network address",
          "type": "IPv4",
          "explanation": "网络地址"
        },
        {
          "name": "wildcard mask",
          "type": "IPv4",
          "explanation": "通配符掩码"
        },
        {
          "name": "area id",
          "type": "integer",
          "explanation": "OSPF 区域 ID"
        }
      ]
    },
    "network 192.168.1.0 0.0.0.255 area 1": {
