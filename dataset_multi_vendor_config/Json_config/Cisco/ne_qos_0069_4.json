{
    "hostname CE2": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet2/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.12.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.12.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.12.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router ospf 1": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置OSPF路由协议，进程ID为1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF进程ID"
            }
        ],
        "network 10.12.1.0 0.0.0.255 area 0": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.12.1.0 0.0.0.255 area 0",
            "explanation": "将网络10.12.1.0/24归属于OSPF区域0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF区域ID"
                }
            ]
        }
    }
}