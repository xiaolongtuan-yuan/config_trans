{
  "hostname CE4": {
    "template": "hostname [parameter1]",
    "command": "hostname CE4",
    "explanation": "设置设备的主机名为 'CE4'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "ip address 10.4.1.1 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.4.1.1 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 10.4.1.1，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "router bgp 65440": {
    "template": "router bgp [parameter1]",
    "command": "router bgp 65440",
    "explanation": "配置 BGP 路由进程，AS 号为 65440",
    "parameters": [
      {
        "name": "AS number",
        "type": "integer",
        "explanation": "自治系统号"
      }
    ],
    "neighbor 10.4.1.2 remote-as 100": {
      "template": "neighbor [parameter1] remote-as [parameter2]",
      "command": "neighbor 10.4.1.2 remote-as 100",
      "explanation": "配置 BGP 邻居，IP 地址为 10.4.1.2，远程 AS 号为 100",
      "parameters": [
        {
          "name": "neighbor ip address",
          "type": "IPv4",
          "explanation": "邻居的 IPv4 地址"
        },
        {
          "name": "remote AS number",
          "type": "integer",
          "explanation": "远程自治系统号"
        }
      ]
    },
    "address-family ipv4": {
      "template": "address-family [parameter1]",
      "command": "address-family ipv4",
      "explanation": "进入 IPv4 地址族配置模式",
      "parameters": [
        {
          "name": "address family",
          "type": "string",
          "explanation": "地址族类型"
        }
      ],
      "neighbor 10.4.1.2 activate": {
        "template": "neighbor [parameter1] activate",
        "command": "neighbor 10.4.1.2 activate",
        "explanation": "激活邻居 10.4.1.2 的 IPv4 地址族",
        "parameters": [
          {
            "name": "neighbor ip address",
            "type": "IPv4",
            "explanation": "邻居的 IPv4 地址"
          }
        ]
      },
      "neighbor 10.4.1.2 route-map direct-routes in": {
        "template": "neighbor [parameter1] route-map [parameter2] in",
        "command": "neighbor 10.4.1.2 route-map direct-routes in",
        "explanation": "对来自邻居 10.4.1.2 的路由应用名为 'direct-routes' 的路由映射",
        "parameters": [
          {
            "name": "neighbor ip address",
            "type": "IPv4",
            "explanation": "邻居的 IPv4 地址"
          },
          {
            "name": "route-map name",
            "type": "string",
            "explanation": "路由映射名称"
          }
        ]
      },
      "exit-address-family": {
        "template": "exit-address-family",
        "command": "exit-address-family",
        "explanation": "退出地址族配置模式",
        "parameters": []
      }
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}