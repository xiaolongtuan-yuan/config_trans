{
    "hostname DeviceF": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceF",
        "explanation": "设置设备的主机名为 'DeviceF'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf 1": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id 6.6.6.6": {
            "template": "router-id [parameter1]",
            "command": "router-id 6.6.6.6",
            "explanation": "设置 OSPF 路由器的 ID 为 6.6.6.6",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "路由器 ID"
                }
            ]
        },
        "passive-interface default": {
            "template": "passive-interface default",
            "command": "passive-interface default",
            "explanation": "默认情况下，所有接口都设置为被动模式，不发送 OSPF 包",
            "parameters": []
        },
        "no passive-interface GigabitEthernet2/0/0": {
            "template": "no passive-interface [parameter1]",
            "command": "no passive-interface GigabitEthernet2/0/0",
            "explanation": "取消接口 'GigabitEthernet2/0/0' 的被动模式，允许发送 OSPF 包",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "network 172.17.1.0 0.0.0.255 area 2": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.17.1.0 0.0.0.255 area 2",
            "explanation": "将网络 172.17.1.0/24 加入到 OSPF 区域 2",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "区域 ID"
                }
            ]
        }
    },
    "interface GigabitEthernet2/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "配置接口 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 172.17.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.17.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}