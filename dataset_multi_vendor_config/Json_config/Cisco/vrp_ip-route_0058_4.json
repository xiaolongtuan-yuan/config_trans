            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:db8:2001::1 remote-as 100",
            "explanation": "配置BGP邻居，地址为2001:db8:2001::1，AS号为100",
            "parameters": [
                {
                    "name": "neighbor address",
                    "type": "IPv6",
                    "explanation": "邻居地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "自治系统号"
                }
            ]
        },
