{
    "hostname CE2": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 100": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建或进入 VLAN 100 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "spanning-tree mode rapid-pvst": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "设置生成树协议模式为快速 PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "switchport trunk allowed vlan add 100": {
            "template": "switchport trunk allowed vlan add [parameter1]",
            "command": "switchport trunk allowed vlan add 100",
            "explanation": "允许 VLAN 100 通过该 Trunk 端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        },
        "spanning-tree vlan 100 bpduguard enable": {
            "template": "spanning-tree vlan [parameter1] bpduguard [parameter2]",
            "command": "spanning-tree vlan 100 bpduguard enable",
            "explanation": "在 VLAN 100 上启用 BPDU Guard 功能",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                },
                {
                    "name": "bpduguard",
                    "type": "string",
                    "explanation": "BPDU Guard 功能状态"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}