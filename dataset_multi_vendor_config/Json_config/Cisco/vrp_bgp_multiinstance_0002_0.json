{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet0/1/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/1/0",
        "explanation": "配置接口 'GigabitEthernet0/1/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 200": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "配置 BGP 进程，AS 号为 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor 10.1.1.2 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.2，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族"
                },
                {
                    "name": "unicast/multicast",
                    "type": "string",
                    "explanation": "单播/多播"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "redistribute static": {
                "template": "redistribute [parameter1]",
                "command": "redistribute static",
                "explanation": "重分发静态路由到 BGP",
                "parameters": [
                    {
                        "name": "protocol",
                        "type": "string",
                        "explanation": "协议"
                    }
                ]
            },
            "neighbor 10.1.1.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.2 activate",
                "explanation": "激活邻居 10.1.1.2 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    },
    "ip route 192.168.1.1 255.255.255.255 Null0": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 192.168.1.1 255.255.255.255 Null0",
        "explanation": "配置静态路由，目的地址为 192.168.1.1，子网掩码为 255.255.255.255，下一跳为 Null0 接口",
        "parameters": [
            {
                "name": "destination ip",
                "type": "IPv4",
                "explanation": "目的 IP 地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "子网掩码"
            },
            {
                "name": "next hop",
                "type": "string",
                "explanation": "下一跳"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    },
    "wr": {
        "template": "wr",
        "command": "wr",
        "explanation": "保存当前配置",
        "parameters": []
    }
}