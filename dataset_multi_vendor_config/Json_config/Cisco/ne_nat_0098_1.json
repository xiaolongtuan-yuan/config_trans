    "ip nat pool pool1 11.11.11.106 11.11.11.110 netmask 255.255.255.0": {
        "template": "ip nat pool [parameter1] [parameter2] [parameter3] netmask [parameter4]",
        "command": "ip nat pool pool1 11.11.11.106 11.11.11.110 netmask 255.255.255.0",
        "explanation": "配置 NAT 地址池 'pool1'，地址范围为 11.11.11.106 到 11.11.11.110，子网掩码为 255.255.255.0",
