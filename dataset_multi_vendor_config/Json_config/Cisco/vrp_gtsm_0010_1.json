{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router ospf 1": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "启用 OSPF 进程 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "router-id 2.2.2.2": {
            "template": "router-id [parameter1]",
            "command": "router-id 2.2.2.2",
            "explanation": "设置 OSPF 路由器的 ID 为 2.2.2.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "OSPF 路由器 ID"
                }
            ]
        },
        "passive-interface default": {
            "template": "passive-interface default",
            "command": "passive-interface default",
            "explanation": "默认情况下，所有接口都设置为被动模式",
            "parameters": []
        },
        "no passive-interface GigabitEthernet1/0/0": {
            "template": "no passive-interface [parameter1]",
            "command": "no passive-interface GigabitEthernet1/0/0",
            "explanation": "取消接口 GigabitEthernet1/0/0 的被动模式",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "no passive-interface GigabitEthernet2/0/0": {
            "template": "no passive-interface [parameter1]",
            "command": "no passive-interface GigabitEthernet2/0/0",
            "explanation": "取消接口 GigabitEthernet2/0/0 的被动模式",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "network 192.168.0.0 0.0.0.255 area 0": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.0.0 0.0.0.255 area 0",
            "explanation": "将网络 192.168.0.0/24 加入到 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        },
        "network 192.168.2.0 0.0.0.255 area 2": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.2.0 0.0.0.255 area 2",
            "explanation": "将网络 192.168.2.0/24 加入到 OSPF 区域 2",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "通配符掩码"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    }
}