{
    "hostname PE3": {
        "template": "hostname [parameter1]",
        "command": "hostname PE3",
        "explanation": "设置设备的主机名为 'PE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "进入 IS-IS 路由协议配置模式",
        "parameters": [],
        "isis router-id 10.0.0.2": {
            "template": "isis router-id [parameter1]",
            "command": "isis router-id 10.0.0.2",
            "explanation": "配置 IS-IS 路由器的 ID 为 10.0.0.2",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "IS-IS 路由器的 ID"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 192.168.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "isis network point-to-point": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "配置 IS-IS 网络类型为点对点",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "网络类型"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}