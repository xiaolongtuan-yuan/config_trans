        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 10.10.10.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.10.10.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "standby 1 ip 10.10.10.100": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 1 ip 10.10.10.100",
            "explanation": "配置 HSRP 组 1 的虚拟 IP 地址为 10.10.10.100",
            "parameters": [
                {
                    "name": "hsrp group",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "standby 1 priority 200": {
            "template": "standby [parameter1] priority [parameter2]",
            "command": "standby 1 priority 200",
            "explanation": "配置 HSRP 组 1 的优先级为 200",
            "parameters": [
                {
                    "name": "hsrp group",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        },
        "standby 1 preempt delay minimum 600": {
            "template": "standby [parameter1] preempt delay minimum [parameter2]",
            "command": "standby 1 preempt delay minimum 600",
            "explanation": "配置 HSRP 组 1 的抢占延迟最小为 600 秒",
            "parameters": [
                {
                    "name": "hsrp group",
                    "type": "integer",
                    "explanation": "HSRP 组号"
                },
                {
                    "name": "delay",
                    "type": "integer",
                    "explanation": "延迟时间（秒）"
                }
            ]
        },
        "ip dhcp server": {
            "template": "ip dhcp server",
            "command": "ip dhcp server",
            "explanation": "启用 DHCP 服务器功能",
            "parameters": []
        }
    },
