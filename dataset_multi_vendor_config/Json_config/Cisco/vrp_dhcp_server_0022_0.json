                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "default-router 10.10.10.1": {
            "template": "default-router [parameter1]",
