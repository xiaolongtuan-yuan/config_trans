            "template": "switchport mode trunk",
            "command": "switchport mode trunk",
            "explanation": "将接口配置为 trunk 模式",
            "parameters": []
        },
        "switchport trunk allowed vlan 100": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
