{
    "hostname CE4": {
        "template": "hostname [parameter1]",
        "command": "hostname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "interface GigabitEthernet1/0/1.20": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.20",
        "explanation": "配置子接口 'GigabitEthernet1/0/1.20'",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ],
        "encapsulation dot1q 20": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 20",
            "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 20",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address 10.4.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.1.2 255.255.255.0",
            "explanation": "配置子接口的 IPv4 地址为 10.4.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 65421": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65421",
        "explanation": "配置 BGP 路由进程，AS 号为 65421",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor 10.4.1.1 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.4.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.4.1.1，远程 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "synchronization": {
                "template": "synchronization",
                "command": "synchronization",
                "explanation": "启用 BGP 和 IGP 同步",
                "parameters": []
            },
            "no import-route direct": {
                "template": "no import-route direct",
                "command": "no import-route direct",
                "explanation": "禁止直接路由导入 BGP",
                "parameters": []
            },
            "neighbor 10.4.1.1 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.4.1.1 activate",
                "explanation": "激活邻居 10.4.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor IP address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    }
}