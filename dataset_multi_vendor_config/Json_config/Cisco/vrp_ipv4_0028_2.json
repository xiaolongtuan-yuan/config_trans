{
  "hostname DeviceC": {
    "template": "hostname [parameter1]",
    "command": "hostname DeviceC",
    "explanation": "设置设备的主机名为 'DeviceC'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet 2/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet 2/0/0",
    "explanation": "配置接口 'GigabitEthernet 2/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "ip address 10.1.1.2 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.1.2 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "ip route 0.0.0.0 0.0.0.0 10.1.1.1": {
    "template": "ip route [parameter1] [parameter2] [parameter3]",
    "command": "ip route 0.0.0.0 0.0.0.0 10.1.1.1",
    "explanation": "配置静态路由，目的网络为 0.0.0.0/0，下一跳地址为 10.1.1.1",
    "parameters": [
      {
        "name": "destination network",
        "type": "IPv4",
        "explanation": "目的网络地址"
      },
      {
        "name": "destination subnet mask",
        "type": "IPv4",
        "explanation": "目的网络子网掩码"
      },
      {
        "name": "next hop",
        "type": "IPv4",
        "explanation": "下一跳地址"
      }
    ]
  }
}