{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "ip sla 1": {
        "template": "ip sla [parameter1]",
        "command": "ip sla 1",
        "explanation": "创建一个 IP SLA 操作，编号为 1",
        "parameters": [
            {
                "name": "operation number",
                "type": "integer",
                "explanation": "IP SLA 操作的编号"
            }
        ],
        "icmp-echo 10.1.1.1 source-interface GigabitEthernet1/0/1": {
            "template": "icmp-echo [parameter1] source-interface [parameter2]",
            "command": "icmp-echo 10.1.1.1 source-interface GigabitEthernet1/0/1",
            "explanation": "配置 IP SLA 操作为 ICMP echo，目标地址为 10.1.1.1，源接口为 GigabitEthernet1/0/1",
            "parameters": [
                {
                    "name": "destination ip",
                    "type": "IPv4",
                    "explanation": "目标 IP 地址"
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "源接口名称"
                }
            ]
        },
        "frequency 5": {
            "template": "frequency [parameter1]",
            "command": "frequency 5",
            "explanation": "设置 IP SLA 操作的频率为 5 秒",
            "parameters": [
                {
                    "name": "frequency",
                    "type": "integer",
                    "explanation": "操作频率，单位为秒"
                }
            ]
        },
        "timeout 3000": {
            "template": "timeout [parameter1]",
            "command": "timeout 3000",
            "explanation": "设置 IP SLA 操作的超时时间为 3000 毫秒",
            "parameters": [
                {
                    "name": "timeout",
                    "type": "integer",
                    "explanation": "超时时间，单位为毫秒"
                }
            ]
        },
        "threshold 2": {
            "template": "threshold [parameter1]",
            "command": "threshold 2",
            "explanation": "设置 IP SLA 操作的阈值为 2",
            "parameters": [
                {
                    "name": "threshold",
                    "type": "integer",
                    "explanation": "操作阈值"
                }
            ]
        }
    },
    "interface GigabitEthernet 1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/1",
        "explanation": "配置接口 'GigabitEthernet 1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan 10": {
            "template": "switchport trunk allowed vlan [parameter1]",
