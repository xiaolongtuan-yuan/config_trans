{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd all-interfaces": {
        "template": "bfd all-interfaces",
        "command": "bfd all-interfaces",
        "explanation": "在所有接口上启用BFD（双向转发检测）",
        "parameters": []
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "bfd bind peer-ip 10.1.1.2 interface GigabitEthernet1/0/0 one-arm-echo": {
            "template": "bfd bind peer-ip [parameter1] interface [parameter2] one-arm-echo",
            "command": "bfd bind peer-ip 10.1.1.2 interface GigabitEthernet1/0/0 one-arm-echo",
            "explanation": "配置BFD绑定，对端IP为10.1.1.2，接口为GigabitEthernet1/0/0，使用单臂回声模式",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "对端IP地址"
                },
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ]
        },
        "bfd discriminator local 1": {
            "template": "bfd discriminator local [parameter1]",
            "command": "bfd discriminator local 1",
            "explanation": "配置本地BFD鉴别器为1",
            "parameters": [
                {
                    "name": "discriminator",
                    "type": "integer",
                    "explanation": "BFD鉴别器"
                }
            ]
        },
        "bfd min-interval 100": {
            "template": "bfd min-interval [parameter1]",
            "command": "bfd min-interval 100",
            "explanation": "配置BFD最小间隔时间为100毫秒",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "最小间隔时间（毫秒）"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}