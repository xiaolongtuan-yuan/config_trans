{
    "hostname DeviceD": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "配置接口 'GigabitEthernet3/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address 2001:db8:3::2/96": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:3::2/96",
            "explanation": "配置接口的 IPv6 地址为 2001:db8:3::2/96",
            "parameters": [
                {
                    "name": "IPv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 rip 1 enable": {
            "template": "ipv6 rip [parameter1] enable",
            "command": "ipv6 rip 1 enable",
            "explanation": "在接口上启用 IPv6 RIP 进程 1",
            "parameters": [
                {
                    "name": "RIP process",
                    "type": "integer",
                    "explanation": "RIP 进程号"
                }
            ]
        }
    },
    "ipv6 router rip 1": {
        "template": "ipv6 router rip [parameter1]",
        "command": "ipv6 router rip 1",
        "explanation": "配置 IPv6 RIP 路由进程 1",
        "parameters": [
            {
                "name": "RIP process",
                "type": "integer",
                "explanation": "RIP 进程号"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}