{
    "hostname Controller": {
        "template": "hostname [parameter1]",
        "command": "hostname Controller",
        "explanation": "设置设备的主机名为 'Controller'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "配置接口 'GigabitEthernet3/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.2.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.2.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 100": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 进程，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor 10.2.1.1 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.1 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.2.1.1，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "邻居的自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "禁用 BGP 同步",
                "parameters": []
            },
            "neighbor 10.2.1.1 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.1 activate",
                "explanation": "激活邻居 10.2.1.1 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            }
        }
    },
    "mpls traffic-eng router-id Loopback0": {
        "template": "mpls traffic-eng router-id [parameter1]",
        "command": "mpls traffic-eng router-id Loopback0",
        "explanation": "配置 MPLS 流量工程的 Router ID 为 Loopback0 接口的 IP 地址",
        "parameters": [
            {
                "name": "router id",
                "type": "string",
                "explanation": "Router ID"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}