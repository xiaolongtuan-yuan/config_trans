{
  "hostname CE1": {
    "template": "hostname [parameter1]",
    "command": "hostname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    }
  },
  "interface GigabitEthernet1/0/1.1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1.1",
    "explanation": "配置子接口 'GigabitEthernet1/0/1.1'",
    "parameters": [
      {
        "name": "subinterface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 10": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN 标识符"
        }
      ]
    },
    "ip address 10.1.1.2 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.1.1.2 255.255.255.0",
      "explanation": "配置子接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "router bgp 65410": {
    "template": "router bgp [parameter1]",
    "command": "router bgp 65410",
    "explanation": "配置 BGP 路由进程，AS 号为 65410",
    "parameters": [
      {
        "name": "AS number",
        "type": "integer",
        "explanation": "自治系统号"
      }
    ],
    "neighbor 10.1.1.1 remote-as 100": {
      "template": "neighbor [parameter1] remote-as [parameter2]",
      "command": "neighbor 10.1.1.1 remote-as 100",
      "explanation": "配置 BGP 邻居，IP 地址为 10.1.1.1，远程 AS 号为 100",
      "parameters": [
        {
          "name": "neighbor IP address",
          "type": "IPv4",
          "explanation": "邻居的 IPv4 地址"
        },
        {
          "name": "remote AS number",
          "type": "integer",
          "explanation": "远程自治系统号"
        }
      ]
    },
    "no synchronization": {
      "template": "no synchronization",
      "command": "no synchronization",
      "explanation": "禁用 BGP 和 IGP 同步",
      "parameters": []
    },
    "address-family ipv4 unicast": {
      "template": "address-family [parameter1]",
      "command": "address-family ipv4 unicast",
      "explanation": "进入 IPv4 单播地址族配置模式",
      "parameters": [
        {
          "name": "address family",
          "type": "string",
          "explanation": "地址族类型"
        }
      ],
      "redistribute connected": {
        "template": "redistribute [parameter1]",
        "command": "redistribute connected",
        "explanation": "重分发直连路由到 BGP",
        "parameters": [
          {
            "name": "source protocol",
            "type": "string",
            "explanation": "源协议"
          }
        ]
      },
      "neighbor 10.1.1.1 activate": {
        "template": "neighbor [parameter1] activate",
        "command": "neighbor 10.1.1.1 activate",
        "explanation": "激活邻居 10.1.1.1 的 IPv4 单播地址族",
        "parameters": [
          {
            "name": "neighbor IP address",
            "type": "IPv4",
            "explanation": "邻居的 IPv4 地址"
          }
        ]
      }
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}