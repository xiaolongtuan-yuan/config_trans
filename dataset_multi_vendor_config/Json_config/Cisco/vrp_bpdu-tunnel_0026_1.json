{
    "hostname CE2": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 100": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建 VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "spanning-tree mode rapid-pvst": {
        "template": "spanning-tree mode [parameter1]",
        "command": "spanning-tree mode rapid-pvst",
        "explanation": "配置生成树协议模式为快速 PVST+",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "生成树协议模式"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "配置接口模式为 trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan 100": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许 VLAN 100 通过 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "spanning-tree bpdufilter enable": {
            "template": "spanning-tree bpdufilter [parameter1]",
            "command": "spanning-tree bpdufilter enable",
            "explanation": "启用 BPDU 过滤",
            "parameters": [
                {
                    "name": "status",
                    "type": "string",
                    "explanation": "BPDU 过滤状态"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}