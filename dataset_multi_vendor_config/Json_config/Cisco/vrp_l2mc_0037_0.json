{
    "hostname PE1": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 的 ID"
            }
        ]
    },
    "ip igmp snooping": {
        "template": "ip igmp snooping",
        "command": "ip igmp snooping",
        "explanation": "启用 IGMP 监听功能",
        "parameters": []
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode access": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "设置接口模式为访问模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport access vlan 10": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN 的 ID"
                }
            ]
        }
    },
    "access-list 2008 permit ip host 224.1.1.1 any": {
        "template": "access-list [parameter1] permit ip host [parameter2] any",
        "command": "access-list 2008 permit ip host 224.1.1.1 any",
        "explanation": "配置访问控制列表 2008，允许源 IP 为 224.1.1.1 的数据包通过",
        "parameters": [
            {
                "name": "access list number",
                "type": "integer",
                "explanation": "访问控制列表编号"
            },
            {
                "name": "source ip",
                "type": "IPv4",
                "explanation": "源 IP 地址"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}