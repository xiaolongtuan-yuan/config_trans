{
    "hostname UPE1": {
        "template": "hostname [parameter1]",
        "command": "hostname UPE1",
        "explanation": "设置设备的主机名为 'UPE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 100": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "创建 VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan 100": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "允许 VLAN 100 通过该 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许通过的 VLAN ID"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport mode trunk": {
            "template": "switchport mode trunk",
            "command": "switchport mode trunk",
            "explanation": "将接口模式设置为 trunk",
            "parameters": []
        },
        "switchport trunk allowed vlan 10,100": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10,100",
            "explanation": "允许 VLAN 10 和 100 通过该 trunk 接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "list",
                    "explanation": "允许通过的 VLAN ID 列表"
                }
            ]
        },
        "switchport trunk native vlan 10": {
            "template": "switchport trunk native vlan [parameter1]",
            "command": "switchport trunk native vlan 10",
            "explanation": "设置 trunk 接口的 native VLAN 为 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "native VLAN ID"
                }
            ]
        }
    }
}