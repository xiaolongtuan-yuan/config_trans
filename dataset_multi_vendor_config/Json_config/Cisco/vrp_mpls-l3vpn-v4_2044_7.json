{
    "hostname CE4": {
        "template": "hostname [parameter1]",
        "command": "hostname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 172.16.2.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.2.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 65420": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65420",
        "explanation": "配置 BGP 路由进程，AS 号为 65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor 172.16.2.2 remote-as 300": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.2.2 remote-as 300",
            "explanation": "配置 BGP 邻居，IP 地址为 172.16.2.2，远程 AS 号为 300",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "synchronization": {
                "template": "synchronization",
                "command": "synchronization",
                "explanation": "启用 BGP 和 IGP 同步",
                "parameters": []
            },
            "neighbor 172.16.2.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 172.16.2.2 activate",
                "explanation": "激活邻居 172.16.2.2 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "exit-address-family": {
                "template": "exit-address-family",
                "command": "exit-address-family",
                "explanation": "退出地址族配置模式",
                "parameters": []
            }
        }
    }
}