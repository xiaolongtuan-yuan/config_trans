{
  "hostname DeviceC": {
    "template": "hostname [parameter1]",
    "command": "hostname DeviceC",
    "explanation": "设置设备的主机名为 'DeviceC'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "ip address 10.3.1.3 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.3.1.3 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 10.3.1.3，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    },
    "description DeviceC to Ethernet": {
      "template": "description [parameter1]",
      "command": "description DeviceC to Ethernet",
      "explanation": "设置接口描述为 'DeviceC to Ethernet'",
      "parameters": [
        {
          "name": "description",
          "type": "string",
          "explanation": "接口描述"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}