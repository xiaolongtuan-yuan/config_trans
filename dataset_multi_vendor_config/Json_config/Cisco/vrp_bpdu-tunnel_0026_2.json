{
  "hostname CE3": {
    "template": "hostname [parameter1]",
    "command": "hostname CE3",
    "explanation": "设置设备的主机名为 'CE3'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan 200": {
    "template": "vlan [parameter1]",
    "command": "vlan 200",
    "explanation": "创建或进入 VLAN 200 的配置模式",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN ID"
      }
    ]
  },
  "spanning-tree mode rapid-pvst": {
    "template": "spanning-tree mode [parameter1]",
    "command": "spanning-tree mode rapid-pvst",
    "explanation": "设置生成树协议模式为快速 PVST+",
    "parameters": [
      {
        "name": "mode",
        "type": "string",
        "explanation": "生成树协议模式"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "switchport": {
      "template": "switchport",
      "command": "switchport",
      "explanation": "将接口配置为二层交换端口",
      "parameters": []
    },
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "将接口模式设置为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "switchport trunk allowed vlan 200": {
      "template": "switchport trunk allowed vlan [parameter1]",
      "command": "switchport trunk allowed vlan 200",
      "explanation": "允许 VLAN 200 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "spanning-tree bpduguard enable": {
      "template": "spanning-tree bpduguard [parameter1]",
      "command": "spanning-tree bpduguard enable",
      "explanation": "启用 BPDU guard 功能",
      "parameters": [
        {
          "name": "state",
          "type": "string",
          "explanation": "启用或禁用"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}