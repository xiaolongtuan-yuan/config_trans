{
    "hostname Switch": {
        "template": "hostname [parameter1]",
        "command": "hostname Switch",
        "explanation": "设置设备的主机名为 'Switch'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
