{
    "sysname CE4": {
        "template": "sysname [parameter1]",
        "command": "sysname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 200": {
        "template": "vlan [parameter1]",
        "command": "vlan 200",
        "explanation": "创建或进入 VLAN 200 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "stp enable": {
        "template": "stp enable",
        "command": "stp enable",
        "explanation": "启用生成树协议（STP）",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "switchport trunk allowed vlan 200": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 200",
            "explanation": "允许 VLAN 200 通过该 trunk 端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "spanning-tree vlan 200 bpdufilter enable": {
            "template": "spanning-tree vlan [parameter1] bpdufilter enable",
            "command": "spanning-tree vlan 200 bpdufilter enable",
            "explanation": "在 VLAN 200 上启用 BPDU 过滤",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}