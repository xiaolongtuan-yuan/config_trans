        "parameters": [
            {
                "name": "test id",
                "type": "integer",
                "explanation": "测试 ID"
            },
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "本地维护端点 ID"
            },
            {
                "name": "remote mep id",
                "type": "integer",
                "explanation": "远程维护端点 ID"
            }
        ]
    },
    "loss-measure single-ended-synthetic continual send test-id 1 interval 1000": {
        "template": "loss-measure single-ended-synthetic continual send test-id [parameter1] interval [parameter2]",
        "command": "loss-measure single-ended-synthetic continual send test-id 1 interval 1000",
        "explanation": "配置单端合成丢失测量，持续发送测试 ID 为 1 的测试包，间隔为 1000 毫秒",
        "parameters": [
            {
                "name": "test id",
                "type": "integer",
                "explanation": "测试 ID"
            },
            {
                "name": "interval",
                "type": "integer",
                "explanation": "发送间隔（毫秒）"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
