            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md md3": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md3",
