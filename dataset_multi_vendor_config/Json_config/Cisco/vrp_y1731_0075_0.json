        "parameters": [
            {
                "name": "maintenance association",
                "type": "string",
                "explanation": "维护关联名"
            }
        ]
    },
    "mep mep-id 3 interface GigabitEthernet1/0/1 direction outward": {
        "template": "mep mep-id [parameter1] interface [parameter2] direction [parameter3]",
        "command": "mep mep-id 3 interface GigabitEthernet1/0/1 direction outward",
        "explanation": "配置维护端点（MEP）ID 为 3，关联接口为 'GigabitEthernet1/0/1'，方向为向外",
        "parameters": [
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "维护端点 ID"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            },
            {
                "name": "direction",
                "type": "string",
                "explanation": "方向（向内或向外）"
            }
        ]
    },
    "mep ccm-send mep-id 3 enable": {
        "template": "mep ccm-send mep-id [parameter1] enable",
        "command": "mep ccm-send mep-id 3 enable",
        "explanation": "启用维护端点 ID 为 3 的 CCM（Continuity Check Message）发送功能",
        "parameters": [
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "维护端点 ID"
            }
        ]
    },
    "remote-mep mep-id 4": {
        "template": "remote-mep mep-id [parameter1]",
        "command": "remote-mep mep-id 4",
        "explanation": "配置远程维护端点（RMEP）ID 为 4",
        "parameters": [
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "维护端点 ID"
            }
        ]
    },
    "remote-mep ccm-receive mep-id 4 enable": {
        "template": "remote-mep ccm-receive mep-id [parameter1] enable",
        "command": "remote-mep ccm-receive mep-id 4 enable",
        "explanation": "启用远程维护端点 ID 为 4 的 CCM 接收功能",
        "parameters": [
            {
                "name": "mep id",
                "type": "integer",
                "explanation": "维护端点 ID"
            }
        ]
    },
    "test-id 1 mep 3 remote-mep 4": {
        "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
        "command": "test-id 1 mep 3 remote-mep 4",
