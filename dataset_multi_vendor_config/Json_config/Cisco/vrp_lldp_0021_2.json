        "parameters": []
    },
    "lldp timer tx 60": {
        "template": "lldp timer tx [parameter1]",
        "command": "lldp timer tx 60",
        "explanation": "设置LLDP传输定时器为60秒",
        "parameters": [
            {
                "name": "transmission interval",
                "type": "integer",
                "explanation": "传输间隔时间，单位为秒"
            }
        ]
    },
    "lldp timer tx-delay 9": {
        "template": "lldp timer tx-delay [parameter1]",
        "command": "lldp timer tx-delay 9",
        "explanation": "设置LLDP传输延迟为9秒",
        "parameters": [
            {
                "name": "transmission delay",
                "type": "integer",
                "explanation": "传输延迟时间，单位为秒"
            }
        ]
    },
    "lldp timer reinit 3": {
        "template": "lldp timer reinit [parameter1]",
        "command": "lldp timer reinit 3",
        "explanation": "设置LLDP重新初始化定时器为3秒",
        "parameters": [
            {
                "name": "reinitialization interval",
                "type": "integer",
                "explanation": "重新初始化间隔时间，单位为秒"
