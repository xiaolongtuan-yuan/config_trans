        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 10.10.10.3 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.3 255.255.255.0",
