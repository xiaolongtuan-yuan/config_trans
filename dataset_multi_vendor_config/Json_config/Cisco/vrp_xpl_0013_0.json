                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            },
            "neighbor 1.1.5.1 route-map export-r1 out": {
                "template": "neighbor [parameter1] route-map [parameter2] [parameter3]",
                "command": "neighbor 1.1.5.1 route-map export-r1 out",
                "explanation": "对邻居 1.1.5.1 的出站路由应用路由映射 'export-r1'",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "应用方向（in/out）"
                    }
                ]
            },
