        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.3.3 255.255.0.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.3 255.255.0.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.3.3，子网掩码为 255.255.0.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "crypto key generate rsa": {
        "template": "crypto key generate rsa",
        "command": "crypto key generate rsa",
        "explanation": "生成 RSA 密钥对用于加密操作",
        "parameters": []
    },
    "ssh version 2": {
        "template": "ssh version [parameter1]",
        "command": "ssh version 2",
