{
    "hostname client001": {
        "template": "hostname [parameter1]",
        "command": "hostname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet0/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置接口 'GigabitEthernet0/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 10.1.2.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.2.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "crypto key generate rsa general-keys modulus 2048": {
        "template": "crypto key generate rsa general-keys modulus [parameter1]",
        "command": "crypto key generate rsa general-keys modulus 2048",
        "explanation": "生成一个2048位的RSA密钥对",
        "parameters": [
            {
                "name": "modulus size",
                "type": "integer",
                "explanation": "RSA密钥的模数大小"
            }
        ]
    },
    "ip ssh version 2": {
        "template": "ip ssh version [parameter1]",
        "command": "ip ssh version 2",
        "explanation": "设置SSH版本为2",
        "parameters": [
            {
                "name": "SSH version",
                "type": "integer",
                "explanation": "SSH版本号"
            }
        ]
    },
    "line vty 0 4": {
        "template": "line vty [parameter1] [parameter2]",
        "command": "line vty 0 4",
        "explanation": "配置虚拟终端线路0到4",
        "parameters": [
            {
                "name": "start line number",
                "type": "integer",
                "explanation": "起始线路号"
            },
            {
                "name": "end line number",
                "type": "integer",
                "explanation": "结束线路号"
            }
        ],
        "transport input ssh": {
            "template": "transport input [parameter1]",
            "command": "transport input ssh",
            "explanation": "设置虚拟终端线路的输入传输协议为SSH",
            "parameters": [
                {
                    "name": "transport protocol",
                    "type": "string",
                    "explanation": "传输协议"
                }
            ]
        },
        "login local": {
            "template": "login local",
            "command": "login local",
            "explanation": "启用本地登录认证",
            "parameters": []
        }
    }
}