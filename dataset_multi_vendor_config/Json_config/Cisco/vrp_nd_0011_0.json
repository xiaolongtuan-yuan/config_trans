{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "启用 IPv6 单播路由",
        "parameters": []
    },
    "interface Vlan10": {
        "template": "interface [parameter1]",
        "command": "interface Vlan10",
        "explanation": "配置 VLAN 10 的虚拟接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "在接口上启用 IPv6",
            "parameters": []
        },
        "ipv6 address 2001:DB8:300:400::3/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:DB8:300:400::3/64",
            "explanation": "配置接口的 IPv6 地址为 2001:DB8:300:400::3，前缀长度为 64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 地址"
                }
            ]
        },
        "ipv6 nd managed-config-flag": {
            "template": "ipv6 nd managed-config-flag",
            "command": "ipv6 nd managed-config-flag",
            "explanation": "设置 IPv6 邻居发现协议的 managed-config-flag，指示主机使用 DHCPv6 获取地址",
            "parameters": []
        },
        "ipv6 nd other-config-flag": {
            "template": "ipv6 nd other-config-flag",
            "command": "ipv6 nd other-config-flag",
            "explanation": "设置 IPv6 邻居发现协议的 other-config-flag，指示主机使用 DHCPv6 获取其他配置信息",
            "parameters": []
        },
        "ipv6 nd ra suppress all": {
            "template": "ipv6 nd ra suppress [parameter1]",
            "command": "ipv6 nd ra suppress all",
            "explanation": "抑制所有 IPv6 路由器通告",
            "parameters": [
                {
                    "name": "suppress type",
                    "type": "string",
                    "explanation": "抑制类型"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode access": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "设置接口模式为 access",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport access vlan 10": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "将接口分配到 VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
