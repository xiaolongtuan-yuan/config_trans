{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bfd all-interfaces": {
        "template": "bfd all-interfaces",
        "command": "bfd all-interfaces",
        "explanation": "在所有接口上启用BFD（双向转发检测）",
        "parameters": [],
        "bfd template single-hop TEMPLATE": {
            "template": "bfd template single-hop [parameter1]",
            "command": "bfd template single-hop TEMPLATE",
            "explanation": "配置BFD单跳模板",
            "parameters": [
                {
                    "name": "template name",
                    "type": "string",
                    "explanation": "模板名称"
                }
            ],
            "interval min-tx 200 min-rx 200 multiplier 3": {
                "template": "interval min-tx [parameter1] min-rx [parameter2] multiplier [parameter3]",
                "command": "interval min-tx 200 min-rx 200 multiplier 3",
                "explanation": "配置BFD的最小发送间隔、最小接收间隔和检测倍数",
                "parameters": [
                    {
                        "name": "min-tx",
                        "type": "integer",
                        "explanation": "最小发送间隔（毫秒）"
                    },
                    {
                        "name": "min-rx",
                        "type": "integer",
                        "explanation": "最小接收间隔（毫秒）"
                    },
                    {
                        "name": "multiplier",
                        "type": "integer",
                        "explanation": "检测倍数"
                    }
                ]
            }
        },
        "interface GigabitEthernet1/0/0": {
            "template": "interface [parameter1]",
            "command": "interface GigabitEthernet1/0/0",
            "explanation": "配置接口 'GigabitEthernet1/0/0' 的BFD参数",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "接口名"
                }
            ],
            "bfd interval 200 min_rx 200 multiplier 3": {
                "template": "bfd interval [parameter1] min_rx [parameter2] multiplier [parameter3]",
                "command": "bfd interval 200 min_rx 200 multiplier 3",
                "explanation": "配置接口的BFD间隔、最小接收间隔和检测倍数",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "BFD间隔（毫秒）"
                    },
                    {
                        "name": "min_rx",
                        "type": "integer",
                        "explanation": "最小接收间隔（毫秒）"
                    },
                    {
                        "name": "multiplier",
                        "type": "integer",
                        "explanation": "检测倍数"
                    }
                ]
            },
            "bfd echo disable": {
                "template": "bfd echo disable",
                "command": "bfd echo disable",
                "explanation": "禁用BFD的echo功能",
                "parameters": []
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
    }
}