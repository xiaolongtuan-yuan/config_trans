{
  "hostname CE2": {
    "template": "hostname [parameter1]",
    "command": "hostname CE2",
    "explanation": "设置设备的主机名为 'CE2'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan 10": {
    "template": "vlan [parameter1]",
    "command": "vlan 10",
    "explanation": "创建或进入 VLAN 10 的配置模式",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN 的 ID"
      }
    ]
  },
  "interface Port-channel1": {
    "template": "interface [parameter1]",
    "command": "interface Port-channel1",
    "explanation": "配置接口 'Port-channel1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "channel-group 1 mode on": {
      "template": "channel-group [parameter1] mode [parameter2]",
      "command": "channel-group 1 mode on",
      "explanation": "将接口加入通道组 1，并设置为 on 模式",
      "parameters": [
        {
          "name": "channel group number",
          "type": "integer",
          "explanation": "通道组编号"
        },
        {
          "name": "mode",
          "type": "string",
          "explanation": "模式"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}