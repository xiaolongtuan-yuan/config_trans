        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 20": {
        "template": "vlan [parameter1]",
        "command": "vlan 20",
        "explanation": "创建 VLAN 20",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface GigabitEthernet1/0/2": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "配置接口 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "将接口模式设置为二层交换端口",
            "parameters": []
        },
        "switchport vlan mapping 20 100": {
            "template": "switchport vlan mapping [parameter1] [parameter2]",
            "command": "switchport vlan mapping 20 100",
            "explanation": "将 VLAN 20 映射到 VLAN 100",
            "parameters": [
                {
                    "name": "original vlan",
                    "type": "integer",
                    "explanation": "原始 VLAN ID"
                },
                {
                    "name": "mapped vlan",
                    "type": "integer",
                    "explanation": "映射后的 VLAN ID"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport trunk allowed vlan add 20": {
            "template": "switchport trunk allowed vlan add [parameter1]",
            "command": "switchport trunk allowed vlan add 20",
            "explanation": "允许 VLAN 20 通过该 trunk 端口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "退出配置模式",
        "parameters": []
