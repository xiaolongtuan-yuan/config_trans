      "parameters": []
    },
    "timers spf 3000 200 500": {
      "template": "timers spf [parameter1] [parameter2] [parameter3]",
      "command": "timers spf 3000 200 500",
      "explanation": "设置 SPF 定时器，初始延迟为 3000 毫秒，最小间隔为 200 毫秒，最大间隔为 500 毫秒",
      "parameters": [
        {
          "name": "initial delay",
          "type": "integer",
          "explanation": "初始延迟（毫秒）"
