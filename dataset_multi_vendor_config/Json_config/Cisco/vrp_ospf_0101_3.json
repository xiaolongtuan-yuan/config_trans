        {
          "name": "minimum interval",
          "type": "integer",
          "explanation": "最小间隔（毫秒）"
        },
        {
          "name": "maximum interval",
          "type": "integer",
          "explanation": "最大间隔（毫秒）"
        }
      ]
    },
