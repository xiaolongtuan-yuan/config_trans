        },
        {
          "name": "maximum interval",
          "type": "integer",
          "explanation": "最大间隔（毫秒）"
        }
      ]
    },
    "timers lsa-originate 3000 200 500": {
      "template": "timers lsa-originate [parameter1] [parameter2] [parameter3]",
