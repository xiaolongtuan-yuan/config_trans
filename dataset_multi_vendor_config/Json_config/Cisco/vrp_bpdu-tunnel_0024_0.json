{
  "hostname CE1": {
    "template": "hostname [parameter1]",
    "command": "hostname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "spanning-tree vlan 1-4094": {
    "template": "spanning-tree vlan [parameter1]",
    "command": "spanning-tree vlan 1-4094",
    "explanation": "为 VLAN 1 到 4094 启用生成树协议",
    "parameters": [
      {
        "name": "vlan range",
        "type": "range",
        "explanation": "VLAN 范围"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "switchport": {
      "template": "switchport",
      "command": "switchport",
      "explanation": "将接口配置为二层交换端口",
      "parameters": []
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}