{
  "hostname CE1": {
    "template": "hostname [parameter1]",
    "command": "hostname CE1",
    "explanation": "设置设备的主机名为 'CE1'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    }
  },
  "interface GigabitEthernet1/0/0.10": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0.10",
    "explanation": "配置子接口 'GigabitEthernet1/0/0.10'",
    "parameters": [
      {
        "name": "subinterface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 10": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "bridge-group 10": {
      "template": "bridge-group [parameter1]",
      "command": "bridge-group 10",
      "explanation": "将子接口加入到桥接组 10",
      "parameters": [
        {
          "name": "bridge group number",
          "type": "integer",
          "explanation": "桥接组编号"
        }
      ]
    },
    "bridge-group 10 spanning-disabled": {
      "template": "bridge-group [parameter1] spanning-disabled",
      "command": "bridge-group 10 spanning-disabled",
      "explanation": "在桥接组 10 中禁用生成树协议",
      "parameters": [
        {
          "name": "bridge group number",
          "type": "integer",
          "explanation": "桥接组编号"
        }
      ]
    },
    "rewrite ingress tag pop 1 symmetric": {
      "template": "rewrite ingress tag pop [parameter1] symmetric",
      "command": "rewrite ingress tag pop 1 symmetric",
      "explanation": "配置入方向标签操作为弹出 1 层标签，并对称处理",
      "parameters": [
        {
          "name": "number of tags to pop",
          "type": "integer",
          "explanation": "弹出的标签层数"
        }
      ]
    }
  },
  "return": {
    "template": "return",
    "command": "return",
    "explanation": "退出配置模式",
    "parameters": []
  }
