{
    "hostname CE4": {
        "template": "hostname [parameter1]",
        "command": "hostname CE4",
        "explanation": "设置设备的主机名为 'CE4'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 172.16.2.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.2.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 172.16.2.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 65420": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65420",
        "explanation": "配置 BGP 路由进程，AS 号为 65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统号"
            }
        ],
        "neighbor 172.16.2.2 remote-as 300": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.2.2 remote-as 300",
            "explanation": "配置 BGP 邻居，IP 地址为 172.16.2.2，远程 AS 号为 300",
            "parameters": [
                {
                    "name": "neighbor ip address",
                    "type": "IPv4",
                    "explanation": "邻居的 IPv4 地址"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "远程自治系统号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [],
            "synchronization": {
                "template": "synchronization",
                "command": "synchronization",
                "explanation": "启用 BGP 和 IGP 同步",
                "parameters": []
            },
            "neighbor 172.16.2.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 172.16.2.2 activate",
                "explanation": "激活邻居 172.16.2.2 的 IPv4 单播地址族",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    }
                ]
            },
            "neighbor 172.16.2.2 route-map direct-import in": {
                "template": "neighbor [parameter1] route-map [parameter2] in",
                "command": "neighbor 172.16.2.2 route-map direct-import in",
                "explanation": "对来自邻居 172.16.2.2 的路由应用名为 'direct-import' 的路由映射",
                "parameters": [
                    {
                        "name": "neighbor ip address",
                        "type": "IPv4",
                        "explanation": "邻居的 IPv4 地址"
                    },
                    {
                        "name": "route-map name",
                        "type": "string",
                        "explanation": "路由映射名称"
                    }
                ]
            }
        }
    },
    "route-map direct-import permit 10": {
        "template": "route-map [parameter1] [parameter2] [parameter3]",
        "command": "route-map direct-import permit 10",
        "explanation": "创建名为 'direct-import' 的路由映射，序列号为 10，动作为允许",
        "parameters": [
            {
                "name": "route-map name",
                "type": "string",
                "explanation": "路由映射名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit 或 deny）"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "序列号"
            }
        ],
        "match ip address prefix-list DIRECT_ROUTES": {
            "template": "match ip address prefix-list [parameter1]",
            "command": "match ip address prefix-list DIRECT_ROUTES",
            "explanation": "匹配 IP 地址前缀列表 'DIRECT_ROUTES'",
            "parameters": [
                {
                    "name": "prefix-list name",
                    "type": "string",
                    "explanation": "前缀列表名称"
                }
            ]
        }
    },
    "ip prefix-list DIRECT_ROUTES permit 172.16.0.0/16": {
        "template": "ip prefix-list [parameter1] [parameter2] [parameter3]",
        "command": "ip prefix-list DIRECT_ROUTES permit 172.16.0.0/16",
        "explanation": "创建名为 'DIRECT_ROUTES' 的前缀列表，动作为允许，匹配 172.16.0.0/16 网段",
        "parameters": [
            {
                "name": "prefix-list name",
                "type": "string",
                "explanation": "前缀列表名称"
            },
            {
                "name": "action",
                "type": "string",
                "explanation": "动作（permit 或 deny）"
            },
            {
                "name": "network",
                "type": "CIDR",
                "explanation": "网络地址及掩码"
            }
        ]
    }
}