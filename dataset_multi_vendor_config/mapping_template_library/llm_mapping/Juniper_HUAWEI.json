{
    "set system login user layer2lease1": [
        "aaa"
    ],
    "set protocols isis no-ipv4-routing": [
        "isis ipv6 enable"
    ],
    "set forwarding-options sampling family inet output source-ip 10.1.10.1": [
        "sflow agent ip 10.1.10.1"
    ],
    "set firewall policer class2-policer": [
        "traffic behavior class2-policer"
    ],
    "set protocols ospf reference-bandwidth 10000m": [
        "ospf 1"
    ],
    "set routing-instances vpn1": [
        "route-distinguisher 100:1"
    ],
    "set system login user client001": [
        "local-user client001 service-type ssh telnet terminal",
        "aaa",
        "local-user client001 privilege level 15"
    ],
    "set system login user client002": [
        "local-user client002 service-type ssh"
    ]
}