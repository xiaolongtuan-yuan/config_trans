{
    "if-match acl 2001": [
        "match access-group 2001"
    ],
    "if-match acl 2002": [
        "match access-group 2002"
    ],
    "mpls-te enable": [
        "network 10.20.1.0 0.0.0.255 area 0",
        "network 10.1.7.0 0.0.0.255 area 0",
        "mpls traffic-eng area 0"
    ],
    "cfm version standard": [
        "ethernet cfm domain md3 level 3"
    ],
    "policy vpn-target": [
        "address-family l2vpn vpls"
    ],
    "map vlan 10": [
        "service instance 10 ethernet"
    ],
    "ssh user admin authentication-type rsa": [
        "username admin"
    ],
    "vrrp vrid 1 virtual-ip 10.1.1.111": [
        "standby 1 ip 10.1.1.111"
    ],
    "ssh server authentication-type default password": [
        "transport input ssh"
    ],
    "local-user client001 service-type ssh": [
        "ip ssh version 2",
        "username client001 privilege 15 secret @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "transport input ssh",
        "line vty 0 4"
    ],
    "local-user client002 service-type ssh": [
        "transport input ssh"
    ]
}