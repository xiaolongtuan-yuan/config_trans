{
    "hostname CE3": {
        "template": "hostname [parameter1]",
        "command": "hostname CE3",
        "explanation": "设置设备的主机名为 'CE3'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.3.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.3.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 800": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 800",
        "explanation": "进入 BGP 路由器配置模式，AS 号为 800",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "BGP 自治系统编号"
            }
        ],
        "neighbor 10.3.1.2 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.3.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居 10.3.1.2，其 AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "remote AS",
                    "type": "integer",
                    "explanation": "邻居的自治系统编号"
                }
            ]
        },
        "address-family ipv4": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "进入 IPv4 地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "不同步 IGP 和 BGP",
                "parameters": []
            },
            "network 10.3.1.0 mask 255.255.255.0": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 10.3.1.0 mask 255.255.255.0",
                "explanation": "宣告网络 10.3.1.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "网络地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "neighbor 10.3.1.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.3.1.2 activate",
                "explanation": "激活与邻居 10.3.1.2 的会话",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    }
}