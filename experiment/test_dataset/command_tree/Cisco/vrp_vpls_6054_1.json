{
  "hostname CE2": {
    "template": "hostname [parameter1]",
    "command": "hostname CE2",
    "explanation": "设置设备的主机名为 'CE2'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0.1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0.1",
    "explanation": "配置子接口 'GigabitEthernet1/0/0.1'",
    "parameters": [
      {
        "name": "sub-interface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 10": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 10",
      "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 10",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN 标识符"
        }
      ]
    },
    "ip address 10.10.1.2 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.10.1.2 255.255.255.0",
      "explanation": "配置子接口的 IPv4 地址为 10.10.1.2，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
