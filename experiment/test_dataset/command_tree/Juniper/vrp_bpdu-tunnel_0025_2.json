{
  "set system": {
    "set system host-name CE3": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name CE3",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set vlans": {
    "set vlans vlan200 vlan-id 200": {
      "template": "set vlans [parameter1] vlan-id [parameter2]",
      "command": "set vlans vlan200 vlan-id 200",
      "explanation": "配置VLAN的ID。",
      "parameters": [
        {
          "name": "vlan-name",
          "type": "string",
          "explanation": "VLAN的名称，例如vlan200。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号，用于标识不同的VLAN。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols rstp": {
      "template": "set protocols [parameter1]",
      "command": "set protocols rstp",
      "explanation": "启用RSTP协议。",
      "parameters": [
        {
          "name": "protocol",
          "type": "string",
          "explanation": "启用的协议名称，例如rstp。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 200": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members 200",
      "explanation": "配置接口的VLAN成员。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "vlan-id",
          "type": "integer",
          "explanation": "VLAN的ID号，接口将加入此VLAN。"
        }
      ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-filter": {
      "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching bpdu-filter",
      "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-filter",
      "explanation": "在接口上启用BPDU过滤。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        }
      ]
    },
    "set interfaces ge-1/0/1 disable": {
      "template": "set interfaces [parameter1] disable",
      "command": "set interfaces ge-1/0/1 disable",
      "explanation": "禁用指定接口。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/1。"
        }
      ]
    }
  }
}