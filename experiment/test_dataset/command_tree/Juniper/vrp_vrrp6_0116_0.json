{
  "set system": {
    "set system host-name DeviceA": {
      "template": "set system host-name [parameter1]",
      "command": "set system host-name DeviceA",
      "explanation": "配置设备的主机名。",
      "parameters": [
        {
          "name": "hostname",
          "type": "string",
          "explanation": "设备的主机名，用于标识网络中的设备。"
        }
      ]
    }
  },
  "set routing-options": {
    "set routing-options router-id 1.1.1.1": {
      "template": "set routing-options router-id [parameter1]",
      "command": "set routing-options router-id 1.1.1.1",
      "explanation": "配置路由器的ID。",
      "parameters": [
        {
          "name": "router-id",
          "type": "string",
          "explanation": "路由器的ID，用于标识路由器。"
        }
      ]
    }
  },
  "set protocols": {
    "set protocols ospf instance 1": {
      "template": "set protocols ospf instance [parameter1]",
      "command": "set protocols ospf instance 1",
      "explanation": "配置OSPF实例。",
      "parameters": [
        {
          "name": "instance",
          "type": "integer",
          "explanation": "OSPF实例的编号。"
        }
      ]
    },
    "set protocols ospf instance 1 router-id 1.1.1.1": {
      "template": "set protocols ospf instance [parameter1] router-id [parameter2]",
      "command": "set protocols ospf instance 1 router-id 1.1.1.1",
      "explanation": "配置OSPF实例的路由器ID。",
      "parameters": [
        {
          "name": "instance",
          "type": "integer",
          "explanation": "OSPF实例的编号。"
        },
        {
          "name": "router-id",
          "type": "string",
          "explanation": "路由器的ID，用于标识路由器。"
        }
      ]
    },
    "set protocols ospf3 area 0 interface ge-0/0/0.0": {
      "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
      "command": "set protocols ospf3 area 0 interface ge-0/0/0.0",
      "explanation": "配置OSPFv3区域和接口。",
      "parameters": [
        {
          "name": "area",
          "type": "integer",
          "explanation": "OSPFv3区域的编号。"
        },
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0.0。"
        }
      ]
    },
    "set protocols ospf3 area 0 interface ge-1/0/0.0": {
      "template": "set protocols ospf3 area [parameter1] interface [parameter2]",
      "command": "set protocols ospf3 area 0 interface ge-1/0/0.0",
      "explanation": "配置OSPFv3区域和接口。",
      "parameters": [
        {
          "name": "area",
          "type": "integer",
          "explanation": "OSPFv3区域的编号。"
        },
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/0.0。"
        }
      ]
    }
  },
  "set interfaces": {
    "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:DB8::1/64": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
      "command": "set interfaces ge-0/0/0 unit 0 family inet6 address 2001:DB8::1/64",
      "explanation": "配置接口的IPv6地址及前缀长度。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv6地址。"
        },
        {
          "name": "prefix-length",
          "type": "integer",
          "explanation": "IPv6地址的前缀长度。"
        }
      ]
    },
    "set interfaces ge-0/0/0 unit 0 dhcpv6 state enable": {
      "template": "set interfaces [parameter1] unit [parameter2] dhcpv6 state [parameter3]",
      "command": "set interfaces ge-0/0/0 unit 0 dhcpv6 state enable",
      "explanation": "配置接口的DHCPv6状态。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-0/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "state",
          "type": "string",
          "explanation": "DHCPv6的状态，例如enable或disable。"
        }
      ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:DB8:1::1/64": {
      "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
      "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:DB8:1::1/64",
      "explanation": "配置接口的IPv6地址及前缀长度。",
      "parameters": [
        {
          "name": "interface",
          "type": "string",
          "explanation": "接口名称，例如ge-1/0/0。"
        },
        {
          "name": "unit",
          "type": "integer",
          "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
        },
        {
          "name": "ip-address",
          "type": "string",
          "explanation": "分配给接口的IPv6地址。"
        },
        {
          "name": "prefix-length",
          "type": "integer",
          "explanation": "IPv6地址的前缀长度。"
        }
      ]
    }
  }
}