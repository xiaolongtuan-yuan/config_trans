    "set security nat source rule-set rs1": {
        "template": "set security nat source rule-set [parameter1]",
        "command": "set security nat source rule-set rs1",
        "explanation": "This command configures a source NAT rule set in Junos, defining a collection of rules for translating source IP addresses in traffic matching specified criteria.",
        "parameters": [
            {
                "name": "rule-set-name",
                "type": "string",
                "explanation": "Name of the NAT rule book."
            }
        ],
        "from zone trust": {
            "template": "from zone [parameter2]",
            "command": "from zone trust",
            "explanation": "Configure the source safety area for the NAT ruleset application.",
            "parameters": [
                {
                    "name": "zone",
                    "type": "string",
                    "explanation": "Name of the source security area."
                }
            ]
        },
        "to zone untrust": {
            "template": "to zone [parameter2]",
            "command": "to zone untrust",
            "explanation": "Configure the purpose safe area for the NAT ruleset application.",
            "parameters": [
                {
                    "name": "zone",
                    "type": "string",
                    "explanation": "The name of the destination security area."
                }
            ]
        },
        "rule r1": {
            "template": "rule [parameter2]",
            "command": "rule r1",
            "explanation": "This command configures a source NAT rule within a specified rule-set, defining how traffic matching the rule is translated before leaving the network.",
            "parameters": [
                {
                    "name": "rule-name",
                    "type": "string",
                    "explanation": "Name of the NAT rule."
                }
            ],
            "match source-address 192.168.10.0/24": {
                "template": "match source-address [parameter3]/[parameter4]",
                "command": "match source-address 192.168.10.0/24",
                "explanation": "Configures the source address that the NAT rules match.",
                "parameters": [
                    {
                        "name": "source-address",
                        "type": "string",
                        "explanation": "Matches the source address."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "_Other Organiser"
                    }
                ]
            },
            "then source-nat interface": {
                "template": "then source-nat [parameter3]",
                "command": "then source-nat interface",
                "explanation": "The command `then source-nat [parameter3]` in Junos configures source NAT (Network Address Translation) using the specified NAT pool or interface defined in `[parameter3]`.",
                "parameters": [
                    {
                        "name": "source-nat",
                        "type": "string",
                        "explanation": "Source NAT action, for example, interface."
                    }
                ]
            }
        }
