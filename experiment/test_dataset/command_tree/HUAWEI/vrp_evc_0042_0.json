{
  "sysname PE": {
    "template": "sysname [parameter1]",
    "command": "sysname PE",
    "explanation": "设置设备的主机名为 'PE'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan batch 100": {
    "template": "vlan batch [parameter1]",
    "command": "vlan batch 100",
    "explanation": "批量创建VLAN，这里创建了VLAN 100",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN ID"
      }
    ]
  },
  "bridge-domain 10": {
    "template": "bridge-domain [parameter1]",
    "command": "bridge-domain 10",
    "explanation": "创建桥域10",
    "parameters": [
      {
        "name": "bridge-domain id",
        "type": "integer",
        "explanation": "桥域ID"
      }
    ]
  },
  "interface Vbdif10": {
    "template": "interface [parameter1]",
    "command": "interface Vbdif10",
    "explanation": "进入Vbdif10接口配置模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "ip address 1.1.1.1 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 1.1.1.1 255.255.255.0",
      "explanation": "配置接口的IPv4地址为 1.1.1.1，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    },
    "dhcp select relay": {
      "template": "dhcp select [parameter1]",
      "command": "dhcp select relay",
      "explanation": "配置接口使用DHCP中继",
      "parameters": [
        {
          "name": "dhcp mode",
          "type": "string",
          "explanation": "DHCP模式"
        }
      ]
    },
    "ip relay address 2.2.2.2": {
      "template": "ip relay address [parameter1]",
      "command": "ip relay address 2.2.2.2",
      "explanation": "配置DHCP中继地址为2.2.2.2",
      "parameters": [
        {
          "name": "relay address",
          "type": "IPv4",
          "explanation": "中继地址"
        }
      ]
    }
  },
  "interface Ethernet1/0/1.1 mode l2": {
    "template": "interface [parameter1] mode [parameter2]",
    "command": "interface Ethernet1/0/1.1 mode l2",
    "explanation": "进入Ethernet1/0/1.1接口配置模式，并设置为二层模式",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      },
      {
        "name": "mode",
        "type": "string",
        "explanation": "接口模式"
      }
    ],
    "encapsulation dot1q vid 100": {
      "template": "encapsulation dot1q vid [parameter1]",
      "command": "encapsulation dot1q vid 100",
      "explanation": "配置接口封装为dot1q，并指定VLAN ID为100",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "rewrite pop single": {
      "template": "rewrite pop [parameter1]",
      "command": "rewrite pop single",
      "explanation": "配置接口的标签操作为弹出单个标签",
      "parameters": [
        {
          "name": "operation",
          "type": "string",
          "explanation": "标签操作"
        }
      ]
    },
    "bridge-domain 10": {
      "template": "bridge-domain [parameter1]",
      "command": "bridge-domain 10",
      "explanation": "将接口加入到桥域10",
      "parameters": [
        {
          "name": "bridge-domain id",
          "type": "integer",
          "explanation": "桥域ID"
        }
      ]
    }
