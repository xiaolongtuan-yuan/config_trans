{
    "set system host-name Device": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Device",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan10": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "Vlan's name, like Vlan100."
            }
        ],
        "vlan-id 10": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family ethernet-switching interface-mode access": {
            "template": "unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "unit 0 family ethernet-switching interface-mode access",
            "explanation": "Configure the interface with an ethnet exchange mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "Interface mode, for example, access."
                }
            ]
        },
        "unit 0 family ethernet-switching vlan members vlan10": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members vlan10",
            "explanation": "Configure the VLAN to which the interface belongs.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "vlan",
                    "type": "string",
                    "explanation": "Vlan's name."
                }
            ]
        }
    },
    "set interfaces ge-2/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-2/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
