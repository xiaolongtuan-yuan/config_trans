{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE3",
        "explanation": "Sets the device's hostname \"CE3\"",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 10",
            "explanation": "Configure sub-interface VLAN type 802.1Q and specify VLAN ID to 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN identifier"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.4 255.255.255.0",
            "explanation": "The IPv4 address for the configuration sub-interface is 10.1.1.4 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view",
        "parameters": []
    }
}