{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "controller [parameter1]": {
        "template": "controller [parameter1]",
        "command": "controller Cpos3/0/0",
        "explanation": "Configure CPOS controller 3/0/0",
        "parameters": [
            {
                "name": "controller id",
                "type": "string",
                "explanation": "controller identifier"
            }
        ],
        "e1 [parameter1] channel-set [parameter2] timeslot-list [parameter3]": {
            "template": "e1 [parameter1] channel-set [parameter2] timeslot-list [parameter3]",
            "command": "e1 1 channel-set 1 timeslot-list 1-15",
            "explanation": "Configure E1 channel 1, channel group 1, time slot 1-15",
            "parameters": [
                {
                    "name": "e1 number",
                    "type": "integer",
                    "explanation": "E1 channel number"
                },
                {
                    "name": "channel-set number",
                    "type": "integer",
                    "explanation": "Channel Group Number"
                },
                {
                    "name": "timeslot-list",
                    "type": "string",
                    "explanation": "Timespace List"
                }
            ]
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable controller (the controller is closed by default)",
            "parameters": []
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Mp-group3/0/1",
        "explanation": "Configure multi-link team interface 3/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set interfaced link protocol to PPP",
            "parameters": [
                {
                    "name": "protocol name",
                    "type": "string",
                    "explanation": "Link protocol name"
                }
            ]
        },
        "ppp mp [parameter1]": {
            "template": "ppp mp [parameter1]",
            "command": "ppp mp Mp-group3/0/1",
            "explanation": "Configure PPP multi-link, using multi-link group Mp-group3/0/1",
            "parameters": [
                {
                    "name": "mp-group name",
                    "type": "string",
                    "explanation": "Multilink Group Name"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode and return to the previous mode",
        "parameters": []
    }
}