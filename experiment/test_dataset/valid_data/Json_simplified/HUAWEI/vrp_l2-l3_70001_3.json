            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "OSF Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.10.1.0 0.0.0.255",
                "explanation": "Declares the network in 0.0.0.0 in the OSPF area",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
