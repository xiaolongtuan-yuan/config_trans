            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration sub-interface is 10.10.1.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
