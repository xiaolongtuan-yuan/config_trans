{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system authentication-order [parameter1]": {
        "template": "set system authentication-order [parameter1]",
        "command": "set system authentication-order tacplus",
        "explanation": "Configure the authentication order of the system.",
        "parameters": [
            {
                "name": "authentication-method",
                "type": "string",
                "explanation": "Authentication methods, such as Radius."
            }
        ]
    },
    "set system login user [parameter1]": {
        "template": "set system login user [parameter1]",
        "command": "set system login user nms2-admin",
        "explanation": "This command fragment configures a user account on a Junos device, where `[parameter1]` specifies the username for login authentication and management access.",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "User name."
            }
        ],
        "authentication encrypted-password [parameter2]": {
            "template": "authentication encrypted-password [parameter2]",
            "command": "authentication encrypted-password \"$1$gXnG$Oa1s4f1Sx6lQ4z1mGAb7Q1\"",
            "explanation": "Configure encrypted authentication passwords for users.",
            "parameters": [
                {
                    "name": "encrypted-password",
                    "type": "string",
                    "explanation": "Encrypted password."
                }
            ]
        }
    },
    "set snmp v3 usm local-engine user [parameter1]": {
        "template": "set snmp v3 usm local-engine user [parameter1]",
        "command": "set snmp v3 usm local-engine user nms2-admin",
        "explanation": "This command configures a local SNMPv3 user on the device, specifying the username (`[parameter1]`) for User-based Security Model (USM) authentication and access.",
        "parameters": [
            {
                "name": "user",
                "type": "string",
                "explanation": "SNMPv3 username."
            }
        ],
        "authentication-sha [parameter2] privacy-aes128 [parameter3]": {
            "template": "authentication-sha [parameter2] privacy-aes128 [parameter3]",
            "command": "authentication-sha \"%$%$n}=%C*UimYlx9-:$>T=*_y4PX*e~u6I_Aa9s=I1$%$%\" privacy-aes128 \"%$%$at{pQGh!uMyq..8WSJ(<bU`~K_)[f-}s&*Gmw!iE%$%$\"",
            "explanation": "Configure SNMPv3 user security authentication and encryption parameters.",
            "parameters": [
                {
                    "name": "authentication-sha",
                    "type": "string",
                    "explanation": "SHA authentication key."
                },
                {
                    "name": "privacy-aes128",
                    "type": "string",
                    "explanation": "AES128 encryption key."
                }
            ]
        }
    },
    "set snmp community [parameter1]": {
        "template": "set snmp community [parameter1]",
        "command": "set snmp community public",
        "explanation": "This command configures an SNMP community string (`[parameter1]`) for access control and authentication in Junos devices.",
        "parameters": [
            {
                "name": "community",
                "type": "string",
                "explanation": "SNMP community string."
            }
        ],
        "authorization [parameter2]": {
            "template": "authorization [parameter2]",
            "command": "authorization read-only",
            "explanation": "Configure SNMP community strings and their permissions.",
            "parameters": [
                {
                    "name": "authorization",
                    "type": "string",
                    "explanation": "Type of authorization, e.g. read-only."
                }
            ]
        }
    },
    "set snmp trap-options [parameter1]": {
        "template": "set snmp trap-options [parameter1]",
        "command": "set snmp trap-options link-down",
        "explanation": "Configure the SNMP trap option to break the link.",
        "parameters": [
            {
                "name": "trap-option",
                "type": "string",
                "explanation": "SNMP trap options, such as Link-down."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 1.1.2.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-0/0/0",
            "explanation": "Configures the OSPF interface.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "interface name."
                }
            ]
        }
    },
    "set snmp trap-group [parameter1]": {
        "template": "set snmp trap-group [parameter1]",
        "command": "set snmp trap-group default",
        "explanation": "Enables SNMP trip to specify the target group.",
        "parameters": [
            {
                "name": "trap-group",
                "type": "string",
                "explanation": "SNMP track target group name."
            }
        ],
        "targets [parameter2]": {
            "template": "targets [parameter2]",
            "command": "targets 1.1.2.1",
            "explanation": "Configure the target address of the SNMP trap group.",
            "parameters": [
                {
                    "name": "target-address",
                    "type": "string",
                    "explanation": "Target IP address."
                }
            ]
        },
        "version [parameter2]": {
            "template": "version [parameter2]",
            "command": "version v3",
            "explanation": "Configure the version of the SNMP trap group.",
            "parameters": [
                {
                    "name": "version",
                    "type": "string",
                    "explanation": "SNMP version, e.g. v3."
                }
            ]
        },
        "categories [parameter2]": {
            "template": "categories [parameter2]",
            "command": "categories authentication",
            "explanation": "Configure the authentication categories for the SNMP trap group.",
            "parameters": [
                {
                    "name": "category",
                    "type": "string",
                    "explanation": "Type of trap, for example."
                }
            ]
        }
    },
    "set snmp contact [parameter1]": {
        "template": "set snmp contact [parameter1]",
        "command": "set snmp contact \"Operator",
        "explanation": "Can not open message",
        "parameters": [
            {
                "name": "contact",
                "type": "string",
                "explanation": "Contact information for devices."
            }
        ]
    }
}