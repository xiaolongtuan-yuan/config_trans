{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment used to identify the equipment in the network."
            }
        ]
    },
    "set routing-options router-id [parameter1]": {
        "template": "set routing-options router-id [parameter1]",
        "command": "set routing-options router-id 1.1.1.1",
        "explanation": "Set the route ID for moving problems",
        "parameters": [
            {
                "name": "router-id",
                "type": "IPv4 address",
                "explanation": "The route ID in IPv4"
            }
        ]
    },
    "set protocols ospf area [area_id]": {
        "template": "set protocols ospf area [area_id]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "♪ With the OAS program settlings in Junos.",
        "parameters": [
            {
                "name": "area_id",
                "type": "string",
                "explanation": "OSF area identifier"
            }
        ],
        "interface [interface_name]": {
            "template": "interface [interface_name]",
            "command": "interface ge-0/0/0.0",
            "explanation": "Configuration OSF program to include an interface in a spectic area",
            "parameters": [
                {
                    "name": "interface_name",
                    "type": "string",
                    "explanation": "Name of the interface to be included in the OSS area"
                }
            ]
        },
        "interface [interface_name] authentication [authentication_type] [key_id] key [key_value]": {
            "template": "interface [interface_name] authentication [authentication_type] [key_id] key [key_value]",
            "command": "interface ge-0/0/0.0 authentication md5 1 key \"$9$H3LloW0rld\"",
            "explanation": "Configuration OSF programme with MD5 education for a specific interface in a given area",
            "parameters": [
                {
                    "name": "interface_name",
                    "type": "string",
                    "explanation": "Name of the interface to be compromised"
                },
                {
                    "name": "authentication_type",
                    "type": "string",
                    "explanation": "Type of education (e.g., md5)"
                },
                {
                    "name": "key_id",
                    "type": "integer",
                    "explanation": "Identifier for the key"
                },
                {
                    "name": "key_value",
                    "type": "string",
                    "explanation": "The actual key value for"
                }
            ]
        },
        "interface [interface_name] authentication [auth_type] [key_id] key [key_value]": {
            "template": "interface [interface_name] authentication [auth_type] [key_id] key [key_value]",
            "command": "interface ge-0/0/1.0 authentication md5 1 key \"$9$H3LloW0rld\"",
            "explanation": "Of course, it's not a problem.",
            "parameters": [
                {
                    "name": "interface_name",
                    "type": "string",
                    "explanation": "Interface name"
                },
                {
                    "name": "auth_type",
                    "type": "string",
                    "explanation": "Autonomy type (e.g., md5)"
                },
                {
                    "name": "key_id",
                    "type": "integer",
                    "explanation": "Hey, hey, hey, hey."
                },
                {
                    "name": "key_value",
                    "type": "string",
                    "explanation": "Key value for economy"
                }
            ]
        }
    },
    "set protocols ospf reference-bandwidth [parameter1]": {
        "template": "set protocols ospf reference-bandwidth [parameter1]",
        "command": "set protocols ospf reference-bandwidth 10000m",
        "explanation": "Set the OSF reference handwidth to adjust the cost calcation of OSF links",
        "parameters": [
            {
                "name": "bandwidth value",
                "type": "string",
                "explanation": "The relevance value in megabits per second (m)"
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 192.168.0.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    }
}