{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "Sets the device 's hostname 'DeviceC '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.0.0.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ntp authentication-key [parameter1] md5 [parameter2]": {
        "template": "ntp authentication-key [parameter1] md5 [parameter2]",
        "command": "ntp authentication-key 42 md5 %#%#m:fVJfk*r&3x\"1J`21^K`Y;LH;B+g(t2<ZX^}Q_~%#%#",
        "explanation": "Configure NTP authentication key, ID 42, encryption with MD5, key with specified string",
        "parameters": [
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "Key ID"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "Key"
            }
        ]
    },
    "ntp trusted-key [parameter1]": {
        "template": "ntp trusted-key [parameter1]",
        "command": "ntp trusted-key 42",
        "explanation": "Mark ID as 42 as trusted NTP key",
        "parameters": [
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "Key ID"
            }
        ]
    },
    "ntp server [parameter1] key [parameter2]": {
        "template": "ntp server [parameter1] key [parameter2]",
        "command": "ntp server 10.0.0.1 key 42",
        "explanation": "Configure NTP server address 10.0.0.1 and authenticate with ID 42 keys",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "NTP Server Address"
            },
            {
                "name": "key ID",
                "type": "integer",
                "explanation": "Key ID"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode",
        "parameters": []
    }
}