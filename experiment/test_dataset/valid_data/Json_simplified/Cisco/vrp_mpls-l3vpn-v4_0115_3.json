{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "Sets the device 's hostname 'P '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "Configures the LDP road ID to use a protected loopback interface and forces the change.",
        "parameters": [
            {
                "name": "loopback interface",
                "type": "string",
                "explanation": "The loopback interface to be used as the LDP road ID."
            },
            {
                "name": "force",
                "type": "flag",
                "explanation": "Forces the LD project ID change without propping for protection."
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192,168.1.2 and the subnet mask is 255,255,255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "Enable MPLS IP forwarding on interface",
            "parameters": []
        },
        "mpls ldp autoconfig": {
            "template": "mpls ldp autoconfig",
            "command": "mpls ldp autoconfig",
            "explanation": "Allows MPLS LDP on all interfaces that are running or IS-IS.",
            "parameters": []
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Configure OSF Process 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSF Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.35.5.9 0.0.0.0 area 0",
            "explanation": "Add network 10.35.5.9/32 to the OSF area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "Area ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode",
        "parameters": []
    }
}