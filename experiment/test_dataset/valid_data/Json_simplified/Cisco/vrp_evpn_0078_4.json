{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "Link sub-interface to Bridge Area '10'",
        "parameters": [
            {
                "name": "bridge domain ID",
                "type": "integer",
                "explanation": "Bridge ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk10",
        "explanation": "Configure interface 'Eth-Trunk10'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "encapsulation dot1q [parameter1]": {
        "template": "encapsulation dot1q [parameter1]",
        "command": "encapsulation dot1q 100",
        "explanation": "Configure the package type of sub-interface to dot1q, VLAN ID to 100",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "no shutdown": {
        "template": "no shutdown",
        "command": "no shutdown",
        "explanation": "Enable interface (the interface is closed by default)",
        "parameters": []
    },
    "channel-group [parameter1] mode [parameter2]": {
        "template": "channel-group [parameter1] mode [parameter2]",
        "command": "channel-group 10 mode on",
        "explanation": "Add interface to channel group '10 ', mode 'on'",
        "parameters": [
            {
                "name": "channel group ID",
                "type": "integer",
                "explanation": "Channel Group ID"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "Mode"
            }
        ]
    },
    "exit": {
        "template": "exit",
        "command": "exit",
        "explanation": "Exit Current Configuration Mode",
        "parameters": []
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit configuration mode and save configuration",
        "parameters": []
    }
