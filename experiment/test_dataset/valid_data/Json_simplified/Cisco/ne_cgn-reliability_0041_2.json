    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "Configures the MPLS LDP routed ID to use the protected loopback interface and forces the change",
        "parameters": [
            {
                "name": "loopback interface",
                "type": "string",
                "explanation": "The loopback interface to be used as the MPLS LDP mode ID"
            },
            {
                "name": "force",
                "type": "flag",
                "explanation": "Forces the migration ID change without propping for conformation"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "Configure interface 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "no shutdown": {
        "template": "no shutdown",
        "command": "no shutdown",
        "explanation": "Enable interface (the interface is closed by default)",
        "parameters": []
    },
    "ip address [parameter1] [parameter2]": {
        "template": "ip address [parameter1] [parameter2]",
        "command": "ip address 10.2.1.2 255.255.255.0",
