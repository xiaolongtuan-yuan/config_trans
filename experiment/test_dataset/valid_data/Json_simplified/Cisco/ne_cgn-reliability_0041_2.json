        "command": "mpls ip",
        "explanation": "Enable MPLS IP on interface",
        "parameters": []
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "Configure MPLS tag protocol to LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "Tag protocol name (e.g. LDP)"
            }
        ]
    },
    "router ospf [parameter1]": {
