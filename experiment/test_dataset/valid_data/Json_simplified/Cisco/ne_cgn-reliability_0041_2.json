        "parameters": [
            {
                "name": "network address",
                "type": "IPv4",
                "explanation": "Chile"
            },
            {
                "name": "wildcard mask",
                "type": "IPv4",
                "explanation": "Countermask"
            },
            {
                "name": "area id",
