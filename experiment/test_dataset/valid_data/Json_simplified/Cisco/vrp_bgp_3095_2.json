{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "Sets the device 's hostname 'DeviceC '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/1",
        "explanation": "Configure interface 'GigabitEthernet3/0/1 '",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.4.2 255.255.255.0",
            "explanation": "IPv4 for configuration interface at 172.16.4.2 and subnet mask at 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 200",
        "explanation": "Configure BGP process, AS 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 3.3.3.3",
            "explanation": "The ID for the configuration BGP router is 3.3.3.3",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "ID of BGP Router"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.4.1 remote-as 65009",
            "explanation": "Configure BGP Neighbor, IP address 172.16.4.1 Remote AS number 65009",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                },
                {
                    "name": "remote AS",
                    "type": "integer",
                    "explanation": "Remote Autonomy System"
                }
            ]
        }
    },
    "address-family [parameter1]": {
        "template": "address-family [parameter1]",
        "command": "address-family ipv4",
        "explanation": "Enter IPv4 Addresser Configuration Mode",
        "parameters": [
            {
                "name": "address family",
                "type": "string",
                "explanation": "Address family type"
            }
        ],
        "no synchronization": {
            "template": "no synchronization",
            "command": "no synchronization",
            "explanation": "Disable BGP and IGP Sync",
            "parameters": []
        },
        "network [parameter1] mask [parameter2]": {
            "template": "network [parameter1] mask [parameter2]",
            "command": "network 172.16.4.0 mask 255.255.255.0",
            "explanation": "Circular network in BGP 172.16.4.0/24",
            "parameters": [
                {
                    "name": "network",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "neighbor [parameter1] activate": {
            "template": "neighbor [parameter1] activate",
            "command": "neighbor 172.16.4.1 activate",
            "explanation": "Activate the IPv4 address of the BGP neighbour 172.16.4.1",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                }
            ]
        },
        "exit-address-family": {
            "template": "exit-address-family",
            "command": "exit-address-family",
            "explanation": "Quit Addresser Configuration Mode",
            "parameters": []
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode",
        "parameters": []
    }
}