{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 100",
        "explanation": "Batch to create VLAN, here to create VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "Configure interface 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set interface mode to trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Interface Mode"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "Allow VLAN 100 to trunk interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "switchport trunk allowed vlan add [parameter1]": {
            "template": "switchport trunk allowed vlan add [parameter1]",
            "command": "switchport trunk allowed vlan add 10,100",
            "explanation": "Allow VLAN 10 and 100 to trunk interface",
            "parameters": [
                {
                    "name": "vlan ids",
                    "type": "list",
                    "explanation": "VLAN ID list"
                }
            ]
        }
    }
}