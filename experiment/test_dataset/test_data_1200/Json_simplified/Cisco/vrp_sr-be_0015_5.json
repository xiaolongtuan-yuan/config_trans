{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "Set the hostname of the device",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The name to be assigned to the device"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "interface name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.1 255.255.255.0",
            "explanation": "Assign an IP address and subnet mask to an interface",
            "parameters": [
                {
                    "name": "IP address",
                    "type": "string",
                    "explanation": "The IP address to be assigned to the interface"
                },
                {
                    "name": "Subnet mask",
                    "type": "string",
                    "explanation": "The subnet mask corresponding to the IP address"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65420",
        "explanation": "Configure BGP routing process",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System number"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.2.1.2 remote-as 100",
            "explanation": "Configure a BGP neighbor with a remote autonomous system number",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "string",
                    "explanation": "IP address of the BGP neighbor"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "Autonomous system number of the remote BGP neighbor"
                }
            ]
        },
        "network [parameter1] mask [parameter2]": {
            "template": "network [parameter1] mask [parameter2]",
            "command": "network 10.22.2.2 mask 255.255.255.255",
            "explanation": "Configure network address and subnet mask",
            "parameters": [
                {
                    "name": "network address",
                    "type": "string",
                    "explanation": "IP address of the network"
                },
                {
                    "name": "subnet mask",
                    "type": "string",
                    "explanation": "Subnet mask of the network"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "Configure address family settings for IPv4",
            "parameters": [
                {
                    "name": "address family type",
                    "type": "string",
                    "explanation": "Specifies the type of address family, such as ipv4 or ipv6"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.2.1.2 activate",
                "explanation": "Activate a BGP neighbor",
                "parameters": [
                    {
                        "name": "neighbor IP address",
                        "type": "string",
                        "explanation": "IP address of the BGP neighbor to activate"
                    }
                ]
            }
        }
    }
}