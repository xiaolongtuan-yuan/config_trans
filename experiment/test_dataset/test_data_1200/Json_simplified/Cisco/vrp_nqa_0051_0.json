{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Create or enter configuration mode for VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "ID of VLAN"
            }
        ]
    },
    "icmp-echo [parameter1] source-interface [parameter2]": {
        "template": "icmp-echo [parameter1] source-interface [parameter2]",
        "command": "icmp-echo 10.1.1.1 source-interface GigabitEthernet1/0/1",
        "explanation": "Configure IP SLA as ICMP echo with a target address of 10.1.1, source interface of GigabitEthernet 1/0/1",
        "parameters": [
            {
                "name": "destination ip",
                "type": "IPv4",
                "explanation": "Destination IP Address"
            },
            {
                "name": "source interface",
                "type": "string",
                "explanation": "Source Interface Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/1",
        "explanation": "Configure interface 'GigabitEthernet 1/0/1 '",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set interface mode to trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "The Internet Mode"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "(The interface is closed by default)",
            "parameters": []
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "Allow VLAN 10 to turn interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID allowed"
                }
            ]
        }
    }
}