            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "ID of VLAN"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "Configure interface 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set interface mode to trunk mode",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "The Internet Mode"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 100",
            "explanation": "Allow VLAN 100 to trunk interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "ID of VLAN"
                }
            ]
        },
        "switchport trunk native vlan [parameter1]": {
            "template": "switchport trunk native vlan [parameter1]",
            "command": "switchport trunk native vlan 10",
            "explanation": "Settive VLAN for trunk interface to 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "ID of VLAN"
                }
            ]
        },
        "switchport trunk allowed vlan add [parameter1]": {
            "template": "switchport trunk allowed vlan add [parameter1]",
            "command": "switchport trunk allowed vlan add 100",
            "explanation": "Allow VLAN 100 to turn interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "ID of VLAN"
                }
            ]
        }
