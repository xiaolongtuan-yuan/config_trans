{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 10.1.1.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group external-peers",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, e.g. external."
                }
            ]
        },
        "neighbor [parameter2] peer-as [parameter3]": {
            "template": "neighbor [parameter2] peer-as [parameter3]",
            "command": "neighbor 10.1.1.2 peer-as 100",
            "explanation": "Configure BGP neighbor AS.",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP neighbor's IP address."
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP neighbor AS."
                }
            ]
        },
        "neighbor [parameter2] family inet unicast": {
            "template": "neighbor [parameter2] family inet unicast",
            "command": "neighbor 10.1.1.2 family inet unicast",
            "explanation": "This post is part of our special coverage Global Voices 2011.",
            "parameters": [
                {
                    "name": "neighbor-ip",
                    "type": "string",
                    "explanation": "BGP neighbor's IP address."
                }
            ]
        }
    },
    "set routing-options autonomous-system [parameter1]": {
        "template": "set routing-options autonomous-system [parameter1]",
        "command": "set routing-options autonomous-system 65010",
        "explanation": "Autonomy system number with equipment.",
        "parameters": [
            {
                "name": "autonomous-system",
                "type": "integer",
                "explanation": "Autonomy system number for equipment, used for route agreements such as BGP."
            }
        ]
    }
}