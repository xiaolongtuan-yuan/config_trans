{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "service-security global-binding [parameter1] [parameter2]": {
        "template": "service-security global-binding [parameter1] [parameter2]",
        "command": "service-security global-binding ipv4 test",
        "explanation": "Global IPv4 service security policy 'test'",
        "parameters": [
            {
                "name": "ip version",
                "type": "string",
                "explanation": "IP Version"
            },
            {
                "name": "policy name",
                "type": "string",
                "explanation": "Policy Name"
            }
        ]
    },
    "service-security policy [parameter1] [parameter2]": {
        "template": "service-security policy [parameter1] [parameter2]",
        "command": "service-security policy ipv4 test",
        "explanation": "Configure IPv4 service security policy 'test'",
        "parameters": [
            {
                "name": "ip version",
                "type": "string",
                "explanation": "IP Version"
            },
            {
                "name": "policy name",
                "type": "string",
                "explanation": "Policy Name"
            }
        ],
        "description [parameter1]": {
            "template": "description [parameter1]",
            "command": "description rule 10 is deny ip packet which from 10.10.1.1",
            "explanation": "Description of rule 10 as rejection of IP package from 10.10.1.1",
            "parameters": [
                {
                    "name": "description",
                    "type": "string",
                    "explanation": "Synchronising folder"
                }
            ]
        },
        "step [parameter1]": {
            "template": "step [parameter1]",
            "command": "step 10",
            "explanation": "Set the policy step to 10",
            "parameters": [
                {
                    "name": "step number",
                    "type": "integer",
                    "explanation": "Step Number"
                }
            ]
        },
        "rule [parameter1] deny protocol [parameter2] source-ip [parameter3] [parameter4]": {
            "template": "rule [parameter1] deny protocol [parameter2] source-ip [parameter3] [parameter4]",
            "command": "rule 10 deny protocol ip source-ip 10.10.1.1 0",
            "explanation": "Configure Rule 10 is the flow of a rejection protocol with a source IP of 10.10.1.1 and a wildcard of 0",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "Rule number"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Type of agreement"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "Source IP Address"
                },
                {
                    "name": "wildcard",
                    "type": "integer",
                    "explanation": "wildcard"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "service-security binding [parameter1] [parameter2]": {
            "template": "service-security binding [parameter1] [parameter2]",
            "command": "service-security binding ipv4 test",
            "explanation": "Tie IPv4 service security policy 'test' to interface",
            "parameters": [
                {
                    "name": "ip version",
                    "type": "string",
                    "explanation": "IP Version"
                },
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "Policy Name"
                }
            ]
        }
    }
}