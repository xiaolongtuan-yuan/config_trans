        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "Configure mode into interface GigabitEthernet1/0/3",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "Set the link type of interface is trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Chain Type"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 100",
            "explanation": "Allow VLAN 100 to cross the trunk link.",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "port vlan-stacking vlan [parameter1] stack-vlan [parameter2]": {
            "template": "port vlan-stacking vlan [parameter1] stack-vlan [parameter2]",
            "command": "port vlan-stacking vlan 10 stack-vlan 100",
            "explanation": "Configure the interface 's VLAN Stacking function, encapsulating VLAN 10 traffic in VLAN 100",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Original VLAN ID"
                },
                {
                    "name": "stack vlan id",
                    "type": "integer",
                    "explanation": "Cover VLAN ID"
                }
            ]
