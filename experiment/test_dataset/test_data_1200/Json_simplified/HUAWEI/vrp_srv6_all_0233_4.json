{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Set the system name",
        "parameters": [
            {
                "name": "system name",
                "type": "string",
                "explanation": "The name to be assigned to the system"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "Create VLANs in batch",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "The ID of the VLAN to be created"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter the interface configuration mode for GigabitEthernet 1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface name"
            }
        ],
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type access",
            "explanation": "Configure the port link type",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Specifies the link type of the port, such as access, trunk, or hybrid"
                }
            ]
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "Set the default VLAN for the port",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "The VLAN ID to set as the default for the port"
