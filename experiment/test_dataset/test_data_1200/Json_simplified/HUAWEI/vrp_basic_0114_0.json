{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname SSH_Server",
        "explanation": "Sets the device 's hostname 'SSH_Server '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ip domain-name [parameter1]": {
        "template": "ip domain-name [parameter1]",
        "command": "ip domain-name example.com",
        "explanation": "Set Domain Name",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "Domain Name"
            }
        ]
    },
    "rsa local-key-pair create [parameter1]": {
        "template": "rsa local-key-pair create [parameter1]",
        "command": "rsa local-key-pair create 2048",
        "explanation": "Create RSA local key pair with specified key length",
        "parameters": [
            {
                "name": "key length",
                "type": "integer",
                "explanation": "The length of the RSA key pair to be created, in bits"
            }
        ]
    },
    "ssh server enable": {
        "template": "ssh server enable",
        "command": "ssh server enable",
        "explanation": "Enable SSH Server"
    },
    "ssh server compatibility enable": {
        "template": "ssh server compatibility enable",
        "command": "ssh server compatibility enable",
        "explanation": "Enable SSH server compatibility mode"
    },
    "ssh server version [parameter1]": {
        "template": "ssh server version [parameter1]",
        "command": "ssh server version 2",
        "explanation": "Set SSH server version to 2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "SSH protocol version"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface LoopBack0",
        "explanation": "Enter LoopBack0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.1 with subnet mask 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ssh server cipher [parameter1] [parameter2] [parameter3]": {
        "template": "ssh server cipher [parameter1] [parameter2] [parameter3]",
        "command": "ssh server cipher aes128-ctr aes192-ctr aes256-ctr",
        "explanation": "Configure SSH server to use specified cipher algorithms",
        "parameters": [
            {
                "name": "cipher algorithm 1",
                "type": "string",
                "explanation": "First cipher algorithm for SSH server"
            },
            {
                "name": "cipher algorithm 2",
                "type": "string",
                "explanation": "Second cipher algorithm for SSH server"
            },
            {
                "name": "cipher algorithm 3",
                "type": "string",
                "explanation": "Third cipher algorithm for SSH server"
            }
        ]
    },
    "aaa": {
        "template": "aaa",
        "command": "aaa",
        "explanation": "Enter AAA Configuration Mode"
    },
    "local-user [parameter1] password irreversible-cipher [parameter2]": {
        "template": "local-user [parameter1] password irreversible-cipher [parameter2]",
        "command": "local-user client001 password irreversible-cipher @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "Create local user clit001 and set unreversible password",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "Password"
            }
        ]
    },
    "local-user [parameter1] privilege level [parameter2]": {
        "template": "local-user [parameter1] privilege level [parameter2]",
        "command": "local-user client001 privilege level 15",
        "explanation": "Set permission level for user cent001 to 15",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            },
            {
                "name": "privilege level",
                "type": "integer",
                "explanation": "Permission Level"
            }
        ]
    },
    "local-user [parameter1] service-type ssh": {
        "template": "local-user [parameter1] service-type ssh",
        "command": "local-user client001 service-type ssh",
        "explanation": "Sets the service type of usercent001 to SSH",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            }
        ]
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "Enter VTTy user interface configuration mode, ranging from 0 to 4",
        "parameters": [
            {
                "name": "start vty line",
                "type": "integer",
                "explanation": "Start VTTy Line"
