{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE",
        "explanation": "Set the host name of the device",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "Batch to create VLAN, here to create VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "mac-address aging-time [parameter1]": {
        "template": "mac-address aging-time [parameter1]",
        "command": "mac-address aging-time 500",
        "explanation": "Set MAC address to age 500 seconds",
        "parameters": [
            {
                "name": "aging time",
                "type": "integer",
                "explanation": "Time of ageing in seconds"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode into interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 2",
            "explanation": "Set the default VLAN for interface 2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "mac-address static [parameter1] [parameter2] [parameter3]": {
        "template": "mac-address static [parameter1] [parameter2] [parameter3]",
        "command": "mac-address static 00e0-fc12-3458 GigabitEthernet1/0/1 vlan 2",
        "explanation": "Static binding MAC address 00e0-fc12-3458 to interface VLAN 2",
        "parameters": [
            {
                "name": "mac address",
                "type": "MAC",
                "explanation": "MAC Address"
            },
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            },
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    }
}