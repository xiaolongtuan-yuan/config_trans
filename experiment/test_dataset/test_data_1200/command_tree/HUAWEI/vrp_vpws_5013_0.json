{
    "sysname CE1": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.252": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.252",
            "explanation": "Configure interface IPv4 address 10.1.1.1 Subnet mask 255.255.255.25252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip address 10.1.2.1 255.255.255.252 sub": {
            "template": "ip address [parameter1] [parameter2] sub",
            "command": "ip address 10.1.2.1 255.255.255.252 sub",
            "explanation": "Configure the second IPv4 address for the interface with 10.1.2.1 subnet mask with 255.255.255.25252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                },
                {
                    "name": "sub",
                    "type": "keyword",
                    "explanation": "Which means this is the second IP address."
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view",
        "parameters": []
    }
