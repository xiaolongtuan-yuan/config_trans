{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment used to identify the equipment in the network."
            }
        ]
    },
    "set bridge-domains 10": {
        "template": "set bridge-domains [parameter1]",
        "command": "set bridge-domains 10",
        "explanation": "Creates a bridge field.",
        "parameters": [
            {
                "name": "bridge-domain-id",
                "type": "integer",
                "explanation": "Bridge field ID."
            }
        ]
    },
    "set interfaces ae10 unit 1 vlan-id 100": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ae10 unit 1 vlan-id 100",
        "explanation": "Configure VLAN IDs for the aggregate interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "The name of the polymer interface, e.g. ae10."
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID, used to identify different VLANs."
            }
        ]
    },
    "set bridge-domains 10 interface ae10.1": {
        "template": "set bridge-domains [parameter1] interface [parameter2]",
        "command": "set bridge-domains 10 interface ae10.1",
        "explanation": "Adds the interface to the bridge field.",
        "parameters": [
            {
                "name": "bridge-domain-id",
                "type": "integer",
                "explanation": "Bridge field ID."
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. ae10.1."
            }
        ]
    },
    "set interfaces ge-0/0/0 gigether-options 802.3ad ae10": {
        "template": "set interfaces [parameter1] gigether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-0/0/0 gigether-options 802.3ad ae10",
        "explanation": "Adds the physical interface to the polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Name of physical interface, e.g., g-0/0/0."
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "The name of the polymer interface, e.g. ae10."
            }
        ]
    },
