{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family ethernet-switching interface-mode trunk": {
            "template": "unit [parameter2] family ethernet-switching interface-mode [parameter3]",
            "command": "unit 0 family ethernet-switching interface-mode trunk",
            "explanation": "Configures the interface with trunk exchange mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "interface-mode",
                    "type": "string",
                    "explanation": "Interface mode, for example, trunk."
                }
            ]
        },
        "unit 0 family ethernet-switching vlan members 2": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members 2",
            "explanation": "Configure the VLAN members of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, ID VLAN."
                }
            ]
        },
        "disable": {
            "template": "disable",
            "command": "disable",
            "explanation": "Disables the specified interface.",
            "parameters": []
        }
    },
    "set vlans vlan-2": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 2": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, ID VLAN."
                }
            ]
        }
    }
}