{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols pim interface all": {
        "template": "set protocols pim interface [parameter1]",
        "command": "set protocols pim interface all",
        "explanation": "This command enables Protocol Independent Multicast (PIM) on a specified network interface (`[parameter1]`) for multicast routing in Junos OS.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "mode sparse": {
            "template": "mode [parameter2]",
            "command": "mode sparse",
            "explanation": "Enable a thin PIM mode (an independent multicast protocol) on all interfaces.",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM mode, sparse means thin mode."
                }
            ]
        }
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family inet address 192.168.2.2/24": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 192.168.2.2/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        },
        "enable": {
            "template": "enable",
            "command": "enable",
            "explanation": "Enable a specific interface",
            "parameters": []
        }
    },
