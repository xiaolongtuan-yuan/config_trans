{
    "set system host-name client002": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name client002",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-0/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family inet address 10.1.3.3/24": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 10.1.3.3/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set system services ssh": {
        "template": "set system services [parameter1]",
        "command": "set system services ssh",
        "explanation": "Enable system services such as SSH.",
        "parameters": [
            {
                "name": "service",
                "type": "string",
                "explanation": "System service name, e.g. ssh."
            }
        ]
    },
    "set security zones security-zone trust": {
        "template": "set security zones security-zone [parameter1]",
        "command": "set security zones security-zone trust",
        "explanation": "This command fragment configures a security zone named `[parameter1]` within the Junos security zones hierarchy, defining a logical boundary for security policies and interfaces.",
        "parameters": [
            {
                "name": "zone-name",
                "type": "string",
                "explanation": "Name of the safe area."
            }
        ],
        "interfaces ge-0/0/0.0 host-inbound-traffic system-services ssh": {
            "template": "interfaces [parameter2] host-inbound-traffic system-services [parameter3]",
            "command": "interfaces ge-0/0/0.0 host-inbound-traffic system-services ssh",
            "explanation": "Configure the port traffic services allowed in the safe area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-0/0/0.0."
                },
                {
                    "name": "service",
                    "type": "string",
                    "explanation": "Allowed entry and flow service names, such as ssh."
                }
            ]
        },
        "interfaces ge-0/0/0.0": {
            "template": "interfaces [parameter2]",
            "command": "interfaces ge-0/0/0.0",
            "explanation": "Allocates the interface to the designated security area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-0/0/0.0."
                }
            ]
        }
    }
}