{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE3",
        "explanation": "Sets the device's hostname \"CE3\"",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Gigabitethernet1/0/0",
        "explanation": "Specify the interface to configure as Gigabitethernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.3.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 800",
        "explanation": "Enable BGP process, AS 800",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "BGP Autonomous System Number"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.3.1.2 as-number 100",
            "explanation": "Configure BGP equivalents 10.3.1.2, AS 100",
            "parameters": [
                {
                    "name": "peer IP",
                    "type": "IPv4",
                    "explanation": "IP address of peer"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
