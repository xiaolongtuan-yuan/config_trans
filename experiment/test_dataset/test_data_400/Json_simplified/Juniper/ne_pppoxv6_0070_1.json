{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae100",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "aggregated-ether-options lacp [parameter2]": {
            "template": "aggregated-ether-options lacp [parameter2]",
            "command": "aggregated-ether-options lacp active",
            "explanation": "Configure the LACP model of the Convergence Interface as a proactive model.",
            "parameters": [
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP model, active expression of initiative model."
                }
            ]
        },
        "unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members 100",
            "explanation": "Configure the Ethernet interface for VLAN members.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, ID VLAN."
                }
            ]
        },
        "gigether-options 802.3ad [parameter2]": {
            "template": "gigether-options 802.3ad [parameter2]",
            "command": "gigether-options 802.3ad ae100",
            "explanation": "Adds the physical interface to the polymer interface.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "The name of the polymer interface, e.g. ae100."
                }
            ]
        },
        "ether-options no-auto-negotiation": {
            "template": "ether-options no-auto-negotiation",
            "command": "ether-options no-auto-negotiation",
            "explanation": "Disables automatic consultation of interfaces.",
            "parameters": []
        }
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans VLAN100",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 100",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, ID VLAN."
                }
            ]
        },
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ae100",
            "explanation": "Ties VLAN to the specified interface.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g. ae100."
                }
            ]
        }
    }
}