{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Device",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "unit 0 family ethernet-switching port-mode access",
            "explanation": "Configure the interface with an ethnet exchange port mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "Port mode, for example, access."
                }
            ]
        },
        "unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members vlan10",
            "explanation": "Configure the VLAN members of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "Name of VLAN member."
                }
            ]
        },
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 10.10.1.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set forwarding-options port-mirroring input [parameter1]": {
        "template": "set forwarding-options port-mirroring input [parameter1]",
        "command": "set forwarding-options port-mirroring input ingress",
        "explanation": "The command configures port mirroring to copy incoming traffic from the specified interface (`[parameter1]`) to a monitoring interface for analysis.",
        "parameters": [
            {
                "name": "direction",
                "type": "string",
                "explanation": "Data flow direction, e.g. ingress."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-1/0/0",
            "explanation": "Configure the input direction and interface of the port mirror.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0."
                }
            ]
        }
    },
    "set forwarding-options port-mirroring output interface [parameter1]": {
        "template": "set forwarding-options port-mirroring output interface [parameter1]",
        "command": "set forwarding-options port-mirroring output interface ge-1/0/1",
        "explanation": "Configure the output interface for port mirrors.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/1."
            }
        ]
    }
}