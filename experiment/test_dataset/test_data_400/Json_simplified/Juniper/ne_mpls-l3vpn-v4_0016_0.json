{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-2/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 10.4.1.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set routing-options static route [parameter1]/[parameter2]": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 0.0.0.0/0",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop [parameter3]": {
            "template": "next-hop [parameter3]",
            "command": "next-hop 10.1.1.2",
            "explanation": "Configures the static route.",
            "parameters": [
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "Prefix length of target network."
                },
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group IBGP",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, e.g. external."
                }
            ]
        },
        "peer-as [parameter2]": {
            "template": "peer-as [parameter2]",
            "command": "peer-as 100",
            "explanation": "Configure the BGP group's equivalent AS.",
            "parameters": [
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "Peer AS."
                }
            ]
        },
        "neighbor [parameter2]": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 10.1.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ]
        },
        "family inet [parameter2]": {
            "template": "family inet [parameter2]",
            "command": "family inet unicast",
            "explanation": "Configure the addresses of the BGP group.",
            "parameters": [
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "Address type, e.g., unicast."
                }
            ]
        },
        "export [parameter2]": {
            "template": "export [parameter2]",
            "command": "export BGP-NETWORKS",
            "explanation": "Configure the export policy of the BGP group.",
            "parameters": [
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "Name of the export policy."
                }
            ]
        }
    },
    "set policy-options policy-statement [parameter1]": {
        "template": "set policy-options policy-statement [parameter1]",
        "command": "set policy-options policy-statement BGP-NETWORKS",
        "explanation": "This command fragment defines a routing policy named `[parameter1]` in Junos, allowing you to configure specific routing rules, actions, and conditions for traffic control.",
        "parameters": [
            {
                "name": "policy-statement",
                "type": "string",
                "explanation": "name of the policy statement."
            }
        ],
        "term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]": {
            "template": "term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]",
            "command": "term 1 from route-filter 10.1.1.0/24 exact",
            "explanation": "Configure the matching conditions for the policy statement.",
            "parameters": [
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "The term number of the policy statement."
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "Route filter, which matches a specific route."
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "Route prefix length."
                },
                {
                    "name": "match-type",
                    "type": "string",
                    "explanation": "Match type, for example."
                }
            ]
        },
        "term [parameter2] then [parameter3]": {
            "template": "term [parameter2] then [parameter3]",
            "command": "term 1 then accept",
            "explanation": "Configure the action for the policy statement.",
            "parameters": [
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "The term number of the policy statement."
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "Actions, like accept."
                }
            ]
        }
    }
}