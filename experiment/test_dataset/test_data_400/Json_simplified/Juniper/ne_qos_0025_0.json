{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set firewall policer [parameter1]": {
        "template": "set firewall policer [parameter1]",
        "command": "set firewall policer class1-policer",
        "explanation": "The command `set firewall policer [parameter1]` configures a policer in Junos, defining traffic rate limits and actions for exceeding them.",
        "parameters": [
            {
                "name": "policer-name",
                "type": "string",
                "explanation": "_Other Organiser"
            }
        ],
        "if-exceeding bandwidth-limit [parameter2]": {
            "template": "if-exceeding bandwidth-limit [parameter2]",
            "command": "if-exceeding bandwidth-limit 5000000",
            "explanation": "Configure bandwidth limits for firewall policyrs.",
            "parameters": [
                {
                    "name": "bandwidth-limit",
                    "type": "integer",
                    "explanation": "Bandwidth limit, unit bps."
                }
            ]
        },
        "if-exceeding burst-size-limit [parameter2]": {
            "template": "if-exceeding burst-size-limit [parameter2]",
            "command": "if-exceeding burst-size-limit 62500",
            "explanation": "Configure the sudden size limits for firewalls.",
            "parameters": [
                {
                    "name": "burst-size-limit",
                    "type": "integer",
                    "explanation": "Sudden size limit value, unit bytes."
                }
            ]
        },
        "if-exceeding peak-information-rate [parameter2]": {
            "template": "if-exceeding peak-information-rate [parameter2]",
            "command": "if-exceeding peak-information-rate 6000000",
            "explanation": "Configures the peak information rate for firewalls.",
            "parameters": [
                {
                    "name": "peak-information-rate",
                    "type": "integer",
                    "explanation": "Peak information speed, in bps."
                }
            ]
        },
        "if-exceeding peak-burst-size-limit [parameter2]": {
            "template": "if-exceeding peak-burst-size-limit [parameter2]",
            "command": "if-exceeding peak-burst-size-limit 62500",
            "explanation": "Configure the peak size limit for firewalls.",
            "parameters": [
                {
                    "name": "peak-burst-size-limit",
                    "type": "integer",
                    "explanation": "Peak sudden size limit, unit bytes."
                }
            ]
        },
        "then color-over [parameter2] [parameter3]": {
            "template": "then color-over [parameter2] [parameter3]",
            "command": "then color-over green forward",
            "explanation": "Configures the colour action of the firewall policyr.",
            "parameters": [
                {
                    "name": "color",
                    "type": "string",
                    "explanation": "Colour tags such as green, yellow, red."
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "Actions like Forward, Discard."
                }
            ]
        }
    },
    "set firewall family inet filter [parameter1]": {
        "template": "set firewall family inet filter [parameter1]",
        "command": "set firewall family inet filter policy1",
        "explanation": "This command fragment configures an IPv4 firewall filter named `[parameter1]` in Junos OS, defining rules to control traffic based on specified conditions.",
        "parameters": [
            {
                "name": "filter",
                "type": "string",
                "explanation": "Firewall filter name."
            }
        ],
        "term [parameter2] from source-address [parameter3]/[parameter4]": {
            "template": "term [parameter2] from source-address [parameter3]/[parameter4]",
            "command": "term class1 from source-address 1.1.1.1/32",
            "explanation": "Configures the source address conditions for firewall filters.",
            "parameters": [
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "condition name."
                },
                {
                    "name": "source-address",
                    "type": "string",
                    "explanation": "Source address."
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "Prefix length."
                }
            ]
        },
        "term [parameter2] then policer [parameter3]": {
            "template": "term [parameter2] then policer [parameter3]",
            "command": "term class1 then policer class1-policer",
            "explanation": "Configure the firewall filter's strategyr action.",
            "parameters": [
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "condition name."
                },
                {
                    "name": "policer-name",
                    "type": "string",
                    "explanation": "_Other Organiser"
                }
            ]
        },
        "term [parameter2] then [parameter3]": {
            "template": "term [parameter2] then [parameter3]",
            "command": "term class1 then accept",
            "explanation": "Configure the receiving actions for firewall filters.",
            "parameters": [
                {
                    "name": "term-name",
                    "type": "string",
                    "explanation": "condition name."
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "Actions, like accept, discard."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet filter input [parameter3]": {
            "template": "unit [parameter2] family inet filter input [parameter3]",
            "command": "unit 0 family inet filter input policy1",
            "explanation": "Configure the input filter for the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "filter-name",
                    "type": "string",
                    "explanation": "Filter name."
                }
            ]
        },
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 1.1.1.3/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    }
}