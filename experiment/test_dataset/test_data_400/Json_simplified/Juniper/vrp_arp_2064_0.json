{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans VLAN2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "unit 0 family ethernet-switching port-mode access",
            "explanation": "Configure the interface with an ethnet exchange port mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "Port mode, for example, access or trunk."
                }
            ]
        },
        "unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members VLAN2",
            "explanation": "Configure the VLAN members of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "VLAN members, such as VLAN2."
                }
            ]
        }
    }
}