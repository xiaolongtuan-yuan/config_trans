        "explanation": "Configure interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "interface name"
            }
        ]
    },
    "interface [parameter1].[parameter2]": {
        "template": "interface [parameter1].[parameter2]",
        "command": "interface GigabitEthernet1/0/0.1",
        "explanation": "Configure subinterface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "The main interface name"
            },
            {
                "name": "subinterface number",
                "type": "integer",
                "explanation": "The subinterface number"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 1",
            "explanation": "Configure VLAN encapsulation using IEEE 802.1Q standard",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "The VLAN identifier"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.1 255.255.255.0",
            "explanation": "Assign an IP address and subnet mask to an interface",
            "parameters": [
                {
                    "name": "IP address",
                    "type": "string",
