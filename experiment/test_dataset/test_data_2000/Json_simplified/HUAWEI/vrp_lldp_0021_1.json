{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "lldp enable": {
        "template": "lldp enable",
        "command": "lldp enable",
        "explanation": "Enable LLDP (Link Layer Discovery Protocol) functionality",
        "parameters": []
    },
    "lldp message-transmission interval [parameter1]": {
        "template": "lldp message-transmission interval [parameter1]",
        "command": "lldp message-transmission interval 60",
        "explanation": "Set LLDP message send interval of 60 seconds",
        "parameters": [
            {
                "name": "interval",
                "type": "integer",
                "explanation": "LLDDP message send interval in seconds"
            }
        ]
    },
    "lldp message-transmission delay [parameter1]": {
        "template": "lldp message-transmission delay [parameter1]",
        "command": "lldp message-transmission delay 9",
        "explanation": "Set LLDDP message sent late 9 seconds",
        "parameters": [
            {
                "name": "delay",
                "type": "integer",
                "explanation": "LLDP message sent late in seconds"
            }
        ]
    },
    "lldp restart-delay [parameter1]": {
        "template": "lldp restart-delay [parameter1]",
        "command": "lldp restart-delay 3",
        "explanation": "Set LLDDP restart delay of 3 seconds",
        "parameters": [
            {
                "name": "restart-delay",
                "type": "integer",
                "explanation": "LLDP restart delay in seconds"
            }
        ]
    },
    "lldp fast-count [parameter1]": {
        "template": "lldp fast-count [parameter1]",
        "command": "lldp fast-count 3",
        "explanation": "Set the LLDDP fast send count to 3",
        "parameters": [
            {
                "name": "fast-count",
                "type": "integer",
                "explanation": "LLDDP fast dispatch count"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode into interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.10.2 and the subnet mask is 255255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
