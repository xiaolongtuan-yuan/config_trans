            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 172.19.139.1 255.255.255.252": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.19.139.1 255.255.255.252",
            "explanation": "The IPv4 address for the configuration interface is 172.191339.1 and the subnet mask is 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip urpf strict allow-default": {
            "template": "ip urpf [parameter1] [parameter2]",
            "command": "ip urpf strict allow-default",
            "explanation": "Configure strict URL (Unicast River Path Forwaring) mode and allow default routers",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "URL mode (strict)"
