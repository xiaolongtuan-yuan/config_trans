{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family inet address [parameter3]/[parameter4]": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 10.1.2.2/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group external",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, e.g. external."
                }
            ]
        },
        "local-address [parameter2]": {
            "template": "local-address [parameter2]",
            "command": "local-address 3.3.3.3",
            "explanation": "Configure the local address of the BGP group.",
            "parameters": [
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "Local address of the BGP group."
                }
            ]
        },
        "family [parameter2] [parameter3]": {
            "template": "family [parameter2] [parameter3]",
            "command": "family inet unicast",
            "explanation": "Configure BGP protocol settings for a specific group and address family",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "The address family (e.g., inet)"
                },
                {
                    "name": "sub-address family",
                    "type": "string",
                    "explanation": "The sub-address family (e.g., unicast)"
                }
            ]
        },
        "peer-as [parameter2]": {
            "template": "peer-as [parameter2]",
            "command": "peer-as 100",
            "explanation": "Configure the BGP group's equivalent AS.",
            "parameters": [
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "Peer AS."
                }
            ]
        },
        "neighbor [parameter2]": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 1.1.1.1",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ]
        },
        "export [parameter2]": {
            "template": "export [parameter2]",
            "command": "export static",
            "explanation": "Configure BGP groups to export static routes.",
            "parameters": [
                {
                    "name": "export",
                    "type": "string",
                    "explanation": "Type of route exported, e.g., static."
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure the interface for OSPF area zero.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g. lo0.0."
                }
            ]
        }
    },
    "set routing-options static route [parameter1]/[parameter2] [parameter3]": {
        "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
        "command": "set routing-options static route 10.20.1.0/24 discard",
        "explanation": "Configures the static route and specifies the next jump to discard.",
        "parameters": [
            {
                "name": "route",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "bits of subnet mask."
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "Next jump address, like Discard."
            }
        ]
    }
}