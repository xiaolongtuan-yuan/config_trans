                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        },
        "unit [parameter2] enable": {
            "template": "unit [parameter2] enable",
            "command": "unit 0 enable",
            "explanation": "Enables specified interface units.",
