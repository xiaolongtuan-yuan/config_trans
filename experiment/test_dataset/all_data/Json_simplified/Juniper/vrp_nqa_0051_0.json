{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set services rpm probe [parameter1]": {
        "template": "set services rpm probe [parameter1]",
        "command": "set services rpm probe sla-test",
        "explanation": "The command fragment `set services rpm probe [parameter1]` configures a Real-Time Performance Monitoring (RPM) probe in Junos, defining its name or identifier as `[parameter1]`.",
        "parameters": [
            {
                "name": "probe-name",
                "type": "string",
                "explanation": "The name of the probe test."
            }
        ],
        "test [parameter2] source-interface [parameter3]": {
            "template": "test [parameter2] source-interface [parameter3]",
            "command": "test icmp-test source-interface ge-1/0/1",
            "explanation": "Configure the source interface for RPM probe testing.",
            "parameters": [
                {
                    "name": "test-name",
                    "type": "string",
                    "explanation": "The name of the test."
                },
                {
                    "name": "source-interface",
                    "type": "string",
                    "explanation": "Source interface name."
                }
            ]
        },
        "test [parameter2] target address [parameter3]": {
            "template": "test [parameter2] target address [parameter3]",
            "command": "test icmp-test target address 10.1.1.1",
            "explanation": "Configure the target address for RPM probe testing.",
            "parameters": [
                {
                    "name": "test-name",
                    "type": "string",
                    "explanation": "The name of the test."
                },
                {
                    "name": "target-address",
                    "type": "string",
                    "explanation": "Target IP address."
                }
            ]
        },
        "test [parameter2] probe-count [parameter3]": {
            "template": "test [parameter2] probe-count [parameter3]",
            "command": "test icmp-test probe-count 2",
            "explanation": "Configure the number of probes tested by RPM probes.",
            "parameters": [
                {
                    "name": "test-name",
                    "type": "string",
                    "explanation": "The name of the test."
                },
                {
                    "name": "probe-count",
                    "type": "integer",
                    "explanation": "The number of probes."
                }
            ]
        },
        "test [parameter2] probe-interval [parameter3]": {
            "template": "test [parameter2] probe-interval [parameter3]",
            "command": "test icmp-test probe-interval 5",
            "explanation": "Configure the time between probes for RPM probe testing.",
            "parameters": [
                {
                    "name": "test-name",
                    "type": "string",
                    "explanation": "The name of the test."
                },
                {
                    "name": "probe-interval",
                    "type": "integer",
                    "explanation": "Time between probes (seconds)."
                }
            ]
        },
        "test [parameter2] test-interval [parameter3]": {
            "template": "test [parameter2] test-interval [parameter3]",
            "command": "test icmp-test test-interval 3",
            "explanation": "Configure the time between tests for RPM probes.",
            "parameters": [
                {
                    "name": "test-name",
                    "type": "string",
                    "explanation": "The name of the test."
                },
                {
                    "name": "test-interval",
                    "type": "integer",
                    "explanation": "Time between tests (secs)."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2] family ethernet-switching port-mode [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "unit 0 family ethernet-switching port-mode trunk",
            "explanation": "Configure the interface with an ethnet exchange port mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number."
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "Port mode, such as trunk or access."
                }
            ]
        },
        "unit [parameter2] family ethernet-switching vlan members [parameter3]": {
            "template": "unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "unit 0 family ethernet-switching vlan members vlan-10",
            "explanation": "Configure the VLAN members of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number."
                },
                {
                    "name": "vlan-members",
                    "type": "string",
                    "explanation": "Name of VLAN member."
                }
            ]
        },
        "enable": {
            "template": "enable",
            "command": "enable",
            "explanation": "Enable a specific interface",
            "parameters": []
        }
    }
}