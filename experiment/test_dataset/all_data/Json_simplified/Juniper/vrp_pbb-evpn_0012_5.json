{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "aggregated-ether-options": {
            "template": "aggregated-ether-options",
            "command": "aggregated-ether-options",
            "explanation": "Configure the options for the etho-net interface.",
            "parameters": []
        },
        "enable": {
            "template": "enable",
            "command": "enable",
            "explanation": "Enables the specified interface.",
            "parameters": []
        },
        "ether-options 802.3ad [parameter2]": {
            "template": "ether-options 802.3ad [parameter2]",
            "command": "ether-options 802.3ad ae1",
            "explanation": "Configure the Ethernet option for the interface, and add it to the specified Convergence Ethernet interface.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Aggregation is given the name of the ethnet interface, e.g. ae1."
                }
            ]
        }
    }
}