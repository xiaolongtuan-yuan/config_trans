{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment used to identify the equipment in the network."
            }
        ]
    },
    "set chassis fpc [parameter1]": {
        "template": "set chassis fpc [parameter1]",
        "command": "set chassis fpc 2",
        "explanation": "Sets the protected parent for a Flexible PIC Concentrator (FPC) in the Junos chasis, cofiguring hardware-specific before or national state.",
        "parameters": [
            {
                "name": "fpc",
                "type": "integer",
                "explanation": "FPC number."
            }
        ],
        "pic [parameter2] e1 [parameter3] channel-set [parameter4] timeslot-list [parameter5]": {
            "template": "pic [parameter2] e1 [parameter3] channel-set [parameter4] timeslot-list [parameter5]",
            "command": "pic 0 e1 0 channel-set 1 timeslot-list 1-31",
            "explanation": "A list of channel sets and time gaps for the E1 interface.",
            "parameters": [
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC (Physical Interface Card) number."
                },
                {
                    "name": "e1",
                    "type": "integer",
                    "explanation": "E1 interface number."
                },
                {
                    "name": "channel-set",
                    "type": "integer",
                    "explanation": "Channel set number."
                },
                {
                    "name": "timeslot-list",
                    "type": "string",
                    "explanation": "list, specify the gap range to be used."
                }
            ]
        },
        "pic [parameter2] e1 [parameter3] loopback-type [parameter4]": {
            "template": "pic [parameter2] e1 [parameter3] loopback-type [parameter4]",
            "command": "pic 0 e1 0 loopback-type remote",
            "explanation": "The type of loop return that configures the E1 interface is a remote loop return.",
            "parameters": [
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC (Physical Interface Card) number."
                },
                {
                    "name": "e1",
                    "type": "integer",
                    "explanation": "E1 interface number."
                },
                {
                    "name": "loopback-type",
                    "type": "string",
                    "explanation": "Ringback type, e.g. remote means long-range ringback."
                }
            ]
        }
    },
    "deactivate chassis fpc [parameter1]": {
        "template": "deactivate chassis fpc [parameter1]",
        "command": "deactivate chassis fpc 2",
        "explanation": "The company develops the Specialized Flexible PIC Concentrator in a Junos Chassis, disabling its operations.",
        "parameters": [
            {
                "name": "fpc",
                "type": "integer",
                "explanation": "FPC (Flexible PIC Concentrator) number."
            }
        ],
        "pic [parameter2] e1 [parameter3] loopback-type [parameter4]": {
            "template": "pic [parameter2] e1 [parameter3] loopback-type [parameter4]",
            "command": "pic 0 e1 0 loopback-type remote",
            "explanation": "Cancels the remote loop back configuration for the E1 interface.",
            "parameters": [
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "PIC (Physical Interface Card) number."
                },
                {
                    "name": "e1",
                    "type": "integer",
                    "explanation": "E1 interface number."
                },
                {
                    "name": "loopback-type",
                    "type": "string",
                    "explanation": "Ringback type, e.g. remote means long-range ringback."
                }
            ]
        }
    }
