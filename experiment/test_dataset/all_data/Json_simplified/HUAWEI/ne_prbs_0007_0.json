{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "controller E1 [parameter1]": {
        "template": "controller E1 [parameter1]",
        "command": "controller E1 1/0/0",
        "explanation": "Configure E1 controller interface",
        "parameters": [
            {
                "name": "controller interface",
                "type": "string",
                "explanation": "E1 controller interface"
            }
        ],
        "channel-set [parameter1] timeslot-list [parameter2]": {
            "template": "channel-set [parameter1] timeslot-list [parameter2]",
            "command": "channel-set 1 timeslot-list 1-31",
            "explanation": "Set interval 1 to 31 for channel set 1",
            "parameters": [
                {
                    "name": "channel set number",
                    "type": "integer",
                    "explanation": "Channel set number"
                },
                {
                    "name": "timeslot list",
                    "type": "string",
                    "explanation": "list, which can be a single time gap or range, e.g. 1-31"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial1/0/0:1",
        "explanation": "Configure Serial 1/0/0:1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface name, e.g. Serial 1/0/0:1"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol tdm",
            "explanation": "Conform the link protocol type",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "The type of link protocol, such as tdm"
                }
            ]
        },
        "test connectivity interface [parameter1] uni-direction pattern [parameter2] interval [parameter3] [parameter4] interval-repeat [parameter5]": {
            "template": "test connectivity interface [parameter1] uni-direction pattern [parameter2] interval [parameter3] [parameter4] interval-repeat [parameter5]",
            "command": "test connectivity interface Serial1/0/0:1 uni-direction pattern prbs15 interval second 20 interval-repeat 5",
            "explanation": "Test interface Serial 1/0/0:1 connectivity, one-way, using the PRBS15 pattern, 20 seconds apart, repeat 5 times",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "Interface name, e.g. Serial 1/0/0:1"
                },
                {
                    "name": "pattern",
                    "type": "string",
                    "explanation": "Test patterns such as prbs15"
                },
                {
                    "name": "interval unit",
                    "type": "string",
                    "explanation": "Spacing unit, e.g. second"
                },
                {
                    "name": "interval value",
                    "type": "integer",
                    "explanation": "Interval values, e.g. 20"
                },
                {
                    "name": "repeat count",
                    "type": "integer",
                    "explanation": "Number of repeats, e.g. 5"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode and return to the previous mode",
        "parameters": []
    }
}