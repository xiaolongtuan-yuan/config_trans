{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "Configure specific interfaces, in this case Pos1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set interfaced link protocol to PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Link protocol name"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.2 and the subnet mask is 255.255.255.252.",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "clock slave": {
            "template": "clock slave",
            "command": "clock slave",
            "explanation": "Set the clock from mode",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode and return to the previous mode",
        "parameters": []
    }
}