{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the data's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "HostName"
            }
        ]
    },
    "clock ssm-control [parameter1]": {
        "template": "clock ssm-control [parameter1]",
        "command": "clock ssm-control on",
        "explanation": "You can have SSM control.",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "Control status, on or off"
            }
        ]
    },
    "clock bits-type [parameter1] [parameter2]": {
        "template": "clock bits-type [parameter1] [parameter2]",
        "command": "clock bits-type bits0 2mbps",
        "explanation": "Set BITS Type",
        "parameters": [
            {
                "name": "bits-id",
                "type": "string",
                "explanation": "BITS Identification"
            },
            {
                "name": "type",
                "type": "string",
                "explanation": "Type, e.g."
            }
        ]
    },
    "clock source [parameter1] synchronization [parameter2]": {
        "template": "clock source [parameter1] synchronization [parameter2]",
        "command": "clock source bits0 synchronization enable",
        "explanation": "I'm sure you'll be able to do that.",
        "parameters": [
            {
                "name": "source-id",
                "type": "string",
                "explanation": "Clear source Identification"
            },
            {
                "name": "synchronization-state",
                "type": "string",
                "explanation": "Synchronization status, capable or unsettled"
            }
        ]
    },
    "clock source [parameter1] priority [parameter2]": {
        "template": "clock source [parameter1] priority [parameter2]",
        "command": "clock source bits0 priority 1",
        "explanation": "Set the priority of the lock source",
        "parameters": [
            {
                "name": "source-id",
                "type": "string",
                "explanation": "Clear source Identification"
            },
            {
                "name": "priority-level",
                "type": "integer",
                "explanation": "Priority level"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "The command `interface [parameter1]` enters interface configuration mode for the specified interface (e.g., GigabitEthernet0/0/1) on a Huawei device.",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "InterfaceName"
            }
        ],
        "clock synchronization [parameter1]": {
            "template": "clock synchronization [parameter1]",
            "command": "clock synchronization enable",
            "explanation": "It's not like you're in trouble.",
            "parameters": [
                {
                    "name": "synchronization-state",
                    "type": "string",
                    "explanation": "Synchronization status, capable or unsettled"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 2",
            "explanation": "Set lock quality",
            "parameters": [
                {
                    "name": "priority-level",
                    "type": "integer",
                    "explanation": "Priority level"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode and return to the previous mode",
        "parameters": []
    }
}