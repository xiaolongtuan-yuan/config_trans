    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65410",
        "explanation": "Enter BGP configuration mode with BGP process number 65410",
        "parameters": [
            {
                "name": "as number",
                "type": "integer",
                "explanation": "BGP Process Number"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.2 as-number 200",
            "explanation": "Configure BGP equivalent 172.16.1.2 with AS 200",
            "parameters": [
                {
                    "name": "peer ip",
                    "type": "IPv4",
                    "explanation": "IPv4 addresses for peers"
                },
                {
                    "name": "as number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
