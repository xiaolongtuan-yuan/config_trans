{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.0.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 172.16.0.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ip route-static [destination_address] [subnet_mask] [next_hop]": {
        "template": "ip route-static [destination_address] [subnet_mask] [next_hop]",
        "command": "ip route-static 1.1.1.1 255.255.255.0 172.16.0.1",
        "explanation": "Configure a static route",
        "parameters": [
            {
                "name": "destination_address",
                "type": "IPv4 address",
                "explanation": "The destination network address"
            },
            {
                "name": "subnet_mask",
                "type": "IPv4 subnet mask",
                "explanation": "The subnet mask of the destination network"
            },
            {
                "name": "next_hop",
                "type": "IPv4 address",
                "explanation": "The next hop address to reach the destination network"
            }
        ]
    }
}