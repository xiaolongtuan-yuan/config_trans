                    "explanation": "VLAN identifier"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration sub-interface is 10.10.10.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "arp-proxy inner-sub-vlan-proxy enable": {
            "template": "arp-proxy inner-sub-vlan-proxy enable",
            "command": "arp-proxy inner-sub-vlan-proxy enable",
            "explanation": "Enable the ARP proxy for the inner layer of VLAN",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view",
