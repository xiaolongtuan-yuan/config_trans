{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "Sets the device 's hostname 'PE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "Enable IS-IS process1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS process ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-1",
