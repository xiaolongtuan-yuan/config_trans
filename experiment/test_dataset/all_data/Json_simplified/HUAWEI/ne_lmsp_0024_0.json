            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "Level, take value: level-1 or level-2 or level-1-2"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 1111.1111.1111.1111.00",
            "explanation": "Name of the network entity setting IS-IS",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "IS-IS network entity ID"
                }
            ]
        },
        "graceful-restart": {
            "template": "graceful-restart",
            "command": "graceful-restart",
            "explanation": "Enable IS-IS elegance to restart",
            "parameters": []
        },
        "cost-style [parameter1]": {
            "template": "cost-style [parameter1]",
            "command": "cost-style wide-compatible",
            "explanation": "Set Cost Styles to Wide Compatibility Mode",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "Styles, take values: wide-compatible or narow"
                }
            ]
        },
        "timer spf [parameter1] [parameter2] [parameter3]": {
            "template": "timer spf [parameter1] [parameter2] [parameter3]",
            "command": "timer spf 1 1 50",
            "explanation": "Set the timer for SPF calculations",
            "parameters": [
                {
                    "name": "initial-delay",
                    "type": "integer",
                    "explanation": "Initial delay (sec)"
                },
                {
                    "name": "hold-time",
                    "type": "integer",
                    "explanation": "Time (sec)"
                },
                {
                    "name": "maximum-delay",
                    "type": "integer",
                    "explanation": "Maximum delay (sec)"
                }
            ]
        },
        "traffic-eng [parameter1]": {
            "template": "traffic-eng [parameter1]",
            "command": "traffic-eng level-1-2",
            "explanation": "Enable traffic engineering at level level level 1-2",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "Level, take value: level-1 or level-2 or level-1-2"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitEthernet 2/0/1",
        "explanation": "Enter gigabitEthernet 2/0/1 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "Enable IS-IS process 1 on interface",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS process ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 32",
            "explanation": "Configure interface IPv4 address 1.1.1.1, subnet mask 32",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "integer",
                    "explanation": "Prefix length of subnet mask"
