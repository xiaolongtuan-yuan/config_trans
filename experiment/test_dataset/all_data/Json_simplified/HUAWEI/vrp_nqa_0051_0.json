{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Create or enter configuration mode for VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "nqa reflector [reflector_id] interface [interface_type] [interface_number] ipv4 [ipv4_address] vlan [vlan_id]": {
        "template": "nqa reflector [reflector_id] interface [interface_type] [interface_number] ipv4 [ipv4_address] vlan [vlan_id]",
        "command": "nqa reflector 1 interface GigabitEthernet 1/0/1 ipv4 10.1.1.1 vlan 10",
        "explanation": "Configure NQA reflector with specified interface, IPv4 address, and VLAN ID",
        "parameters": [
            {
                "name": "reflector_id",
                "type": "integer",
                "explanation": "The ID of the NQA reflector"
            },
            {
                "name": "interface_type",
                "type": "string",
                "explanation": "The type of the interface (e.g., GigabitEthernet)"
            },
            {
                "name": "interface_number",
                "type": "string",
                "explanation": "The number of the interface"
            },
            {
                "name": "ipv4_address",
                "type": "string",
                "explanation": "The IPv4 address for the reflector"
            },
            {
                "name": "vlan_id",
                "type": "integer",
                "explanation": "The VLAN ID for the reflector"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/1",
        "explanation": "Configure mode to access interface GigabitEthernet 1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "Switch interface from root mode to exchange mode",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "(The interface is closed by default)",
            "parameters": []
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "Set the link type of interface is trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Chain Type"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "Allo VLAN 10 traffic through this trunk interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    }
}