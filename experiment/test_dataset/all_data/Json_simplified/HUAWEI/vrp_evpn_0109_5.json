{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192,168.2.2 and the subnet mask is 255,255,255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 65420",
        "explanation": "Enter BGP configuration mode, local AS 65420",
        "parameters": [
            {
                "name": "local AS number",
                "type": "integer",
                "explanation": "Local AS"
            }
        ],
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 192.168.2.1 as-number 200",
            "explanation": "Configure AS number 200 for BGP equivalent 192.168.2.1",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 addresses for peers"
                },
                {
                    "name": "peer AS number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "Enter IPv4 solo view",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "Close BGP Sync with IGP",
                "parameters": []
            },
            "import-route [parameter1]": {
                "template": "import-route [parameter1]",
                "command": "import-route direct",
                "explanation": "Introduce direct connection to BGP",
                "parameters": [
                    {
                        "name": "route type",
                        "type": "string",
                        "explanation": "Route Type"
                    }
                ]
            },
            "peer [parameter1] enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 192.168.2.1 enable",
                "explanation": "Equivalent equivalent 192.168.2.1",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "IPv4 addresses for peers"
                    }
                ]
            }
        }
    }
