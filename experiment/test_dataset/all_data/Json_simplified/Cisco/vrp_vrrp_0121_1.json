{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "Configure Interface 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.2.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192,168.2.1 and the subnet mask is 255,255,255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "standby [parameter1] ip [parameter2]": {
            "template": "standby [parameter1] ip [parameter2]",
            "command": "standby 1 ip 10.1.1.111",
            "explanation": "Configure Virtual IP address for HSRP group 1 with 10.1.1111",
            "parameters": [
                {
                    "name": "HSRP group number",
                    "type": "integer",
                    "explanation": "HSRP Group Number"
                },
                {
                    "name": "virtual IP address",
                    "type": "IPv4",
                    "explanation": "Virtual IP address"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enable OSF process 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSF Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.2.0 0.0.0.255 area 0",
            "explanation": "Add the network 192.168.2.0/24 to the OSF area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "Area ID"
                }
            ]
        }
    }
}