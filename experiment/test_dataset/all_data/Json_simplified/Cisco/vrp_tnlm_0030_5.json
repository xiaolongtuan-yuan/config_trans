        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.1.1 255.255.255.252",
            "explanation": "The IPv4 address for the configuration interface is 10.4.1.1 and the subnet mask is 255.255.255.252.",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65420",
        "explanation": "Configure BGP Route Process, AS 65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.4.1.2 remote-as 100",
            "explanation": "Configure BGP Neighbor, IP address 10.4.1.2, remote AS 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "Neighbor's IPv4 address"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "Remote Autonomy System"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family ipv4 unicast",
            "command": "address-family ipv4 unicast",
            "explanation": "Enter IPv4 solitaire configuration mode",
            "parameters": [],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "Disable BGP Sync",
                "parameters": []
            },
            "redistribute connected": {
                "template": "redistribute connected",
                "command": "redistribute connected",
                "explanation": "Redo direct route to BGP",
                "parameters": []
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.4.1.2 activate",
                "explanation": "Activate the IPv4 family of neighbours 10.4.1.2",
                "parameters": [
                    {
                        "name": "neighbor ip",
