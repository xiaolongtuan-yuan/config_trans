{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.2 255.255.255.252",
            "explanation": "The IPv4 address for the configuration interface is 192,168.1.2 and the subnet mask is 255,255,255.252.",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "Configure BGP Route Process, AS 65410",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 192.168.1.1 remote-as 100",
            "explanation": "Configure BGP Neighbor, IP address 192,168.1, remote AS 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "Neighbor's IPv4 address"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "Remote Autonomy System"
                }
            ]
        },
        "address-family [parameter1]": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4",
            "explanation": "Enter IPv4 Addresser Configuration Mode",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type"
                }
            ],
            "no synchronization": {
                "template": "no synchronization",
                "command": "no synchronization",
                "explanation": "Disable BGP Sync",
                "parameters": []
            },
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 22.22.22.22 mask 255.255.255.255",
                "explanation": "22.22.22.22 in BGP, masked at 255.255.255.255",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "mask",
                        "type": "IPv4",
                        "explanation": "Subnet mask"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 192.168.1.1 activate",
                "explanation": "Activate the IPv4 address of neighbor 192.168.1.1",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "Neighbor's IPv4 address"
                    }
                ]
            }
        }
    }
}