{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 192.168.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192,168.1, subnet mask 255,255,255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router ospf 1": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enable OSF process 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSF Process ID"
            }
        ],
        "network 192.168.1.0 0.0.0.255 area 0": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 192.168.1.0 0.0.0.255 area 0",
            "explanation": "Add the network 192.168.1.0/24 to the OSF area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSS Area ID"
                }
            ]
        }
    }
