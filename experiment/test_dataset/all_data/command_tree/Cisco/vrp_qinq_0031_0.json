        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "Sub-interface name"
            }
        ],
        "encapsulation dot1q 10": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 10",
            "explanation": "Configure the package type of sub-interface as dot1q, VLAN ID as 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN identifier"
                }
            ]
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration sub-interface is 10.1.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp 65410": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "Configure BGP Route Process, AS 65410",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "neighbor 10.1.1.1 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.1.1.1 remote-as 100",
            "explanation": "Configure BGP Neighbor, IP address 10.1.1, remote AS number 100",
            "parameters": [
                {
                    "name": "neighbor IP address",
                    "type": "IPv4",
                    "explanation": "Neighbor's IPv4 address"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "Remote Autonomy System"
                }
            ]
        },
        "no synchronization": {
            "template": "no synchronization",
            "command": "no synchronization",
            "explanation": "Disable BGP and IGP Sync",
            "parameters": []
        },
        "address-family ipv4 unicast": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
            "explanation": "Enter IPv4 solitaire configuration mode",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type"
                }
            ],
            "redistribute connected": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "Redo direct route to BGP",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "Source Protocol"
                    }
                ]
            },
            "neighbor 10.1.1.1 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.1.1.1 activate",
