                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN identifier"
                }
            ]
        },
        "ip address 192.168.10.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.1 255.255.255.0",
