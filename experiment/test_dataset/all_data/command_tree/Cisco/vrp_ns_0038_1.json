        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address 172.17.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.17.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 172.17.1.1 The subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
