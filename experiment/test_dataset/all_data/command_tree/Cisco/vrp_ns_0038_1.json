                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ip route 1.1.1.0 255.255.255.0 172.17.1.1": {
        "template": "ip route [destination_network] [subnet_mask] [next_hop]",
        "command": "ip route 1.1.1.0 255.255.255.0 172.17.1.1",
        "explanation": "Configure a static route",
        "parameters": [
            {
                "name": "destination_network",
                "type": "string",
