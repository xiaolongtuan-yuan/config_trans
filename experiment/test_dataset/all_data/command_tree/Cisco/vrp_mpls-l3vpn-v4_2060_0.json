            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type"
                }
            ],
            "synchronization": {
                "template": "synchronization",
                "command": "synchronization",
                "explanation": "Enable BGP and IGP synchronization",
                "parameters": []
            },
            "redistribute connected": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "Redo direct route to BGP",
                "parameters": [
                    {
                        "name": "source protocol",
                        "type": "string",
                        "explanation": "Source Protocol"
                    }
                ]
            },
            "neighbor 172.16.1.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 172.16.1.2 activate",
                "explanation": "Activate the IPv4 family of neighbours 172.16.1.2",
                "parameters": [
                    {
                        "name": "neighbor ip",
                        "type": "IPv4",
                        "explanation": "Neighbor's IP address"
