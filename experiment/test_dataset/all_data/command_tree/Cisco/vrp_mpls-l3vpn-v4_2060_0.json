        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 172.16.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 172.16.1.1 The subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp 65410": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65410",
        "explanation": "Configure BGP Route Process, AS 65410",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "neighbor 172.16.1.2 remote-as 200": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 172.16.1.2 remote-as 200",
            "explanation": "Configure BGP Neighbor, IP address 17216.1.2, remote AS 200",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                },
                {
                    "name": "remote AS number",
                    "type": "integer",
                    "explanation": "Remote Autonomy System"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family [parameter1]",
            "command": "address-family ipv4 unicast",
