{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address 172.16.0.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.0.1 255.255.255.0",
            "explanation": "IPv4 for the configuration interface at 172.16.0.1 and subnet mask at 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        }
    },
    "ip route 1.1.1.1 255.255.255.0 172.16.0.1": {
        "template": "ip route [destination] [mask] [next-hop]",
        "command": "ip route 1.1.1.1 255.255.255.0 172.16.0.1",
        "explanation": "Configure a static route",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Destination network address"
            },
            {
                "name": "mask",
                "type": "string",
                "explanation": "Subnet mask of the destination network"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "Next hop address to reach the destination network"
            }
        ]
    }
}