{
    "sysname CE2": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode for entering the interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        }
    },
    "interface GigabitEthernet1/0/1.1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "Enter configuration mode for geobitaEthernet1/0/1.1",
        "parameters": [
            {
                "name": "sub-interface name",
                "type": "string",
                "explanation": "Sub-interface name"
            }
        ],
        "vlan-type dot1q 10": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 10",
            "explanation": "Configure sub-interface VLAN envelope type dot1q and specify VLAN ID as 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration sub-interface is 10.1.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
}