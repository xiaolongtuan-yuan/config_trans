{
    "sysname CE2": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode into interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "Switching interface from three to two layers",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "port link-type trunk": {
            "template": "port link-type [parameter1]",
            "command": "port link-type trunk",
            "explanation": "Set the link type of interface is trunk",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Chain Type"
                }
            ]
        },
        "port trunk allow-pass vlan 2": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "Allow VLAN 2 to pass this trunk interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    }
