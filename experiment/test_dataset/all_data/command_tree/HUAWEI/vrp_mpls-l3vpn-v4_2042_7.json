{
    "sysname CE4": {
        "template": "sysname [parameter1]",
        "command": "sysname CE4",
        "explanation": "Set the host name of the device \"CE4\"",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 172.16.2.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 172.16.2.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 172.16.2.1 and the subnet mask is 255255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "bgp 65420": {
        "template": "bgp [parameter1]",
        "command": "bgp 65420",
        "explanation": "Enter BGP configuration mode and set local AS number 65420",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Local AS"
            }
        ],
        "peer 172.16.2.2 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.2.2 as-number 100",
            "explanation": "Configure BGP equivalent 172.16.2.2 with AS number 100",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 addresses for peers"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "Enter IPv4 solo community configuration mode",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
                "explanation": "Close BGP and IGP sync functionality",
                "parameters": []
            },
            "import-route direct": {
                "template": "import-route direct",
                "command": "import-route direct",
                "explanation": "Introduce direct connection to BGP",
                "parameters": []
            },
            "peer 172.16.2.2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 172.16.2.2 enable",
                "explanation": "Enabling IPv4 solo addresses of equivalent 172.16.2.2",
                "parameters": [
                    {
                        "name": "peer ip address",
                        "type": "IPv4",
                        "explanation": "IPv4 addresses for peers"
                    }
                ]
            }
        }
    }
}