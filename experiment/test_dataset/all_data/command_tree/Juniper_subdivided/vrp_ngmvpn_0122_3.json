        "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
        "command": "set routing-options static route 0.0.0.0/0 discard",
        "explanation": "Configures the static route and specifies the next jump to discard.",
        "parameters": [
            {
                "name": "route",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "bits of subnet mask."
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "Next jump address, like Discard."
            }
        ]
    },
