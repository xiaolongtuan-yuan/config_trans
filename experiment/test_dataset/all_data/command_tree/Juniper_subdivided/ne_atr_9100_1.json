{
    "set system host-name ATR_Device": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name ATR_Device",
        "explanation": "Set the system host name",
        "parameters": [
            {
                "name": "host-name",
                "type": "string",
                "explanation": "The name to be set as the system host name"
            }
        ]
    },
    "set interfaces lo0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family inet address 2.2.2.2/32": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 2.2.2.2/32",
            "explanation": "Contact IPv4 addresses and subnetmasks for loop back interfaces.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface without number to listen to the multi-ethnic relations under the same environment."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 arrived agreed to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet."
                }
            ]
        }
    }
