{
    "set system host-name UPE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name UPE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans VLAN-100": {
        "template": "set vlans [parameter1]",
        "command": "set vlans VLAN-100",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 100": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 100",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID."
                }
            ]
        }
    },
    "set interfaces ge-0/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family ethernet-switching port-mode trunk": {
            "template": "unit [parameter2] family ethernet-switching port-mode [parameter3]",
            "command": "unit 0 family ethernet-switching port-mode trunk",
            "explanation": "Configures the interface with trunk exchange mode.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "port-mode",
                    "type": "string",
                    "explanation": "Interfacing modes, such as trunk."
                }
            ]
        },
        "unit 0 family ethernet-switching vlan members 100": {
