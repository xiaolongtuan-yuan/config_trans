{
    "set system host-name CE3": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE3",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0 family inet address 172.16.1.1/24": {
            "template": "unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "unit 0 family inet address 172.16.1.1/24",
            "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit number to distinguish between multiple logical configurations under the same interface."
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "The IPv4 address assigned to the interface."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "Bits of IPv4 subnet mask."
                }
            ]
        }
    },
    "set protocols bgp group external": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group external",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type external": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, e.g. external."
                }
            ]
        },
        "local-address 172.16.1.1": {
            "template": "local-address [parameter2]",
            "command": "local-address 172.16.1.1",
            "explanation": "Configure the local address of the BGP group.",
            "parameters": [
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "The local IPv4 address of the BGP group."
                }
            ]
        },
        "peer-as 200": {
            "template": "peer-as [parameter2]",
            "command": "peer-as 200",
            "explanation": "Configure the BGP group's equivalent AS.",
            "parameters": [
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "BGP team's equivalent AS."
                }
            ]
        },
        "neighbor 172.16.1.2": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 172.16.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "BGP team neighbor IPv4 address."
                }
            ]
        },
        "family inet unicast": {
            "template": "family inet unicast",
            "command": "family inet unicast",
            "explanation": "Configure BGP groups to support IPv4 solo addresses.",
            "parameters": []
        },
        "import direct": {
            "template": "import [parameter2]",
            "command": "import direct",
            "explanation": "Configure the direct route that BGP groups import.",
            "parameters": [
                {
                    "name": "import-policy",
                    "type": "string",
                    "explanation": "Import policies, such as direct."
                }
            ]
        }
    }
}