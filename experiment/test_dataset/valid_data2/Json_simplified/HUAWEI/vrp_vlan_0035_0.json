{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 5 9",
        "explanation": "Create VLANs in batch",
        "parameters": [
            {
                "name": "VLAN ID 1",
                "type": "integer",
                "explanation": "First VLAN ID to be created"
            },
            {
                "name": "VLAN ID 2",
                "type": "integer",
                "explanation": "Second VLAN ID to be created"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode into interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "Switching into place from three to two players",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "(The interface is closed by default)",
            "parameters": []
        },
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type access",
            "explanation": "Set the link type of interface to access",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Chain Type"
                }
            ]
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 5",
            "explanation": "Set the default VLAN for interface to 5",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1] [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] [parameter2]",
            "command": "port trunk allow-pass vlan 5 9",
            "explanation": "Allows specified VLANs to pass through the trunk port",
            "parameters": [
                {
                    "name": "VLAN ID 1",
                    "type": "integer",
                    "explanation": "First VLAN ID to allow through the trunk port"
                },
                {
                    "name": "VLAN ID 2",
                    "type": "integer",
                    "explanation": "Second VLAN ID to allow through the trunk port"
                }
            ]
        }
    }
