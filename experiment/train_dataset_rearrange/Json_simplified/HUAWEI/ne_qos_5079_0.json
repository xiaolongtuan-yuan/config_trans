                {
                    "name": "bridge domain ID",
                    "type": "integer",
                    "explanation": "Identification of the bridge field"
                }
            ]
        },
        "trust upstream [parameter1]": {
            "template": "trust upstream [parameter1]",
            "command": "trust upstream gina",
