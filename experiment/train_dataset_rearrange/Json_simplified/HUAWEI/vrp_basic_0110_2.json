{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname client002",
        "explanation": "Sets the device's hostname 'client002'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.3 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.3.3 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "stelnet server enable": {
        "template": "stelnet server enable",
        "command": "stelnet server enable",
        "explanation": "Enable STELNET server"
    },
    "ssh server version [parameter1]": {
        "template": "ssh server version [parameter1]",
        "command": "ssh server version 2",
        "explanation": "Set SSH server version to 2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "Version number of SSH protocol"
            }
        ]
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "Configure VTTy user interfaces from 0 to 4",
        "parameters": [
            {
                "name": "start vty number",
                "type": "integer",
                "explanation": "Start number of VTTY"
            },
            {
                "name": "end vty number",
                "type": "integer",
                "explanation": "End number of VTTY"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Ends the current configuration or returns the previous configuration"
    }
}