            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "ip route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 10.1.3.0 255.255.255.0 10.100.0.10",
        "explanation": "Configure a static route, target network 10.1.3/24, next jump address 10.100.0.10",
        "parameters": [
            {
                "name": "destination network",
