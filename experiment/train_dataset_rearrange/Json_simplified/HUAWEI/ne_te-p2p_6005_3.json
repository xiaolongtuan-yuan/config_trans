        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "vlan-type dot1q [parameter1]": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 10",
            "explanation": "Configure interface VLAN type dot1q, VLAN ID 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "mpls l2vc [parameter1] [parameter2]": {
            "template": "mpls l2vc [parameter1] [parameter2]",
