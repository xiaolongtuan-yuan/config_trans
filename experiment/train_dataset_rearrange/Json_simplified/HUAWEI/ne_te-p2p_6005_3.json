    },
    "mpls l2vpn": {
        "template": "mpls l2vpn",
        "command": "mpls l2vpn",
        "explanation": "Enter MPLS L2VPN configuration mode"
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "Enter MPLS LDP Configuration Mode"
    },
