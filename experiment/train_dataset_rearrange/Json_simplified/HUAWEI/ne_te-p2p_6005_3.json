                {
                    "name": "remote IP",
                    "type": "IPv4",
                    "explanation": "IP address for remote peer"
                },
                {
                    "name": "VC ID",
                    "type": "integer",
                    "explanation": "VC ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.4.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.4.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "Configuration mode for accessing OSF process 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
