            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 4.4.4.9",
