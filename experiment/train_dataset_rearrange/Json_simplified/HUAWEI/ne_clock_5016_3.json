{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "Sets the device 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "Enable extended SSM control",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "Status, on or off"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Select the interface GigabitEthernet1/0/0 for configuration",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "Set clock priority to 1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "Priority value"
                }
            ]
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 9",
            "explanation": "Set clock ID to 9",
            "parameters": [
                {
                    "name": "clock id",
                    "type": "integer",
                    "explanation": "Clock ID value"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode or return to the next level"
    }
}