{
    "system-view": {
        "template": "system-view",
        "command": "system-view",
        "explanation": "Enter System View"
    },
    "user-interface console [parameter1]": {
        "template": "user-interface console [parameter1]",
        "command": "user-interface console 0",
        "explanation": "Enter console user interface view",
        "parameters": [
            {
                "name": "console number",
                "type": "integer",
                "explanation": "Console number"
            }
        ],
        "user privilege level [parameter1]": {
            "template": "user privilege level [parameter1]",
            "command": "user privilege level 15",
            "explanation": "Set user permission level to 15",
            "parameters": [
                {
                    "name": "privilege level",
                    "type": "integer",
                    "explanation": "User Permission Level"
                }
            ]
        },
        "set authentication password cipher [parameter1]": {
            "template": "set authentication password cipher [parameter1]",
            "command": "set authentication password cipher <password>",
            "explanation": "Set authentication password as secret",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Password"
                }
            ]
        },
        "history-command max-size [parameter1]": {
            "template": "history-command max-size [parameter1]",
            "command": "history-command max-size 20",
            "explanation": "Maximum number of historical command records set is 20",
            "parameters": [
                {
                    "name": "max size",
                    "type": "integer",
                    "explanation": "Maximum"
                }
            ]
        },
        "idle-timeout [parameter1] [parameter2]": {
            "template": "idle-timeout [parameter1] [parameter2]",
            "command": "idle-timeout 30 0",
            "explanation": "Set the free time limit for 30 minutes and 0 seconds.",
            "parameters": [
                {
                    "name": "minutes",
                    "type": "integer",
                    "explanation": "min"
                },
                {
                    "name": "seconds",
                    "type": "integer",
                    "explanation": "sec"
                }
            ]
        },
        "databits [parameter1]": {
            "template": "databits [parameter1]",
            "command": "databits 6",
            "explanation": "Set Data Level to 6",
            "parameters": [
                {
                    "name": "data bits",
                    "type": "integer",
                    "explanation": "Data bits"
                }
            ]
        },
        "parity [parameter1]": {
            "template": "parity [parameter1]",
            "command": "parity even",
            "explanation": "Set validation to a checkout",
            "parameters": [
                {
                    "name": "parity",
                    "type": "string",
                    "explanation": "Verify"
                }
            ]
        },
        "stopbits [parameter1]": {
            "template": "stopbits [parameter1]",
            "command": "stopbits 2",
            "explanation": "Set stop to 2",
            "parameters": [
                {
                    "name": "stop bits",
                    "type": "integer",
                    "explanation": "Stop position"
                }
            ]
        },
        "speed [parameter1]": {
            "template": "speed [parameter1]",
            "command": "speed 4800",
            "explanation": "Set the Porter rate at 4800.",
            "parameters": [
                {
                    "name": "speed",
                    "type": "integer",
                    "explanation": "Porter Rate"
                }
            ]
        },
        "screen-length [parameter1]": {
            "template": "screen-length [parameter1]",
            "command": "screen-length 30",
            "explanation": "Set screen display to 30 lines",
            "parameters": [
                {
                    "name": "length",
                    "type": "integer",
                    "explanation": "Show length"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quit to User View"
    }
}