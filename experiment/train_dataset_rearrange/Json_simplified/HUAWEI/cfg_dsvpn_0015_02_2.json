{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "Set the device 's hostname is 'Spoke2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP (Next Hope Regulation)"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.3.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "Tie the interface to the GRE tunnel.",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "Tunnel type"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source LoopBack0",
            "explanation": "Set tunnel source interface to LoopBack0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        },
        "ipsec policy [parameter1]": {
            "template": "ipsec policy [parameter1]",
            "command": "ipsec policy IPSEC_PROFILE",
            "explanation": "Apply IPSec policy IPSEC_PROFILE to interface",
            "parameters": [
                {
                    "name": "ipsec policy name",
                    "type": "string",
                    "explanation": "IPSec Policy Name"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "Set tunnel protocol to GRE P2MP (dot to multiple)",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol"
                },
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "Tunnel Mode"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 10.1.1.10",
            "explanation": "The purpose of the tunnel is 10.1.1.10.",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "Destination Address"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.3",
        "explanation": "Configure OSPF router ID for OSPF process 1 to 172.16.1.3",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure mode for entering OSF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "Declaration of network in OSPF area 0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}