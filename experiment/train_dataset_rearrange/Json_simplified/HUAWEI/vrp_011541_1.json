{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname CE2",
        "explanation": "The hostname for setting the device is CE2",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [vlan-id]": {
        "template": "vlan [vlan-id]",
        "command": "vlan 2",
        "explanation": "Create or enter configuration mode for VLAN 2",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "cfm version [version]": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "Set CFM version to standard",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM version"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "Enable CFM"
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode into interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port trunk allow-pass vlan [vlan-id]": {
            "template": "port trunk allow-pass vlan [vlan-id]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "Allow VLAN 2 to trunk port",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
    },
    "cfm md [md-name]": {
        "template": "cfm md [md-name]",
        "command": "cfm md md3",
        "explanation": "Configure mode to enter or create CFM domain md3",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "CFM domain name"
            }
        ],
        "ma [ma-name]": {
            "template": "ma [ma-name]",
            "command": "ma ma3",
            "explanation": "Enter or create configuration mode to maintain associated ma3",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "Maintain Association Name"
                }
            ],
            "map vlan [vlan-id]": {
                "template": "map vlan [vlan-id]",
                "command": "map vlan 2",
                "explanation": "Map MA to VLAN 2",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN identification number"
                    }
                ]
            },
            "mep mep-id [mep-id] interface [interface-name] [direction]": {
                "template": "mep mep-id [mep-id] interface [interface-name] [direction]",
                "command": "mep mep-id 4 interface GigabitEthernet1/0/1 outward",
                "explanation": "Configure MEP ID 4 on interface GigabitEthernet1/0/1 in an outward direction",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP identification number"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "Interface Name"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "Direction, like inward or outward"
                    }
                ]
            },
            "mep ccm-send mep-id [mep-id] enable": {
                "template": "mep ccm-send mep-id [mep-id] enable",
                "command": "mep ccm-send mep-id 4 enable",
                "explanation": "Enable CCM send for MEP ID 4",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP identification number"
                    }
                ]
            },
            "remote-mep mep-id [mep-id]": {
                "template": "remote-mep mep-id [mep-id]",
                "command": "remote-mep mep-id 3",
                "explanation": "Configure remote MEP ID 3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [mep-id] enable": {
                "template": "remote-mep ccm-receive mep-id [mep-id] enable",
                "command": "remote-mep ccm-receive mep-id 3 enable",
                "explanation": "Enable reception of CCM from remote MEP ID 3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]": {
                "template": "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]",
                "command": "test-id 1 mep 4 remote-mep 3",
                "explanation": "Configure test ID 1, local MEP ID 4 and remote MEP ID 3",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Local MEP identification number"
                    },
                    {
                        "name": "remote-mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "loss-measure dual-ended continual test-id [test-id]": {
                "template": "loss-measure dual-ended continual test-id [test-id]",
                "command": "loss-measure dual-ended continual test-id 1",
                "explanation": "Configure double-end continuous-discretion measurement, test ID 1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit Current Configuration Mode"
    }
}