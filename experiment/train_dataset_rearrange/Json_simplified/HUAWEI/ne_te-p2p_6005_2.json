{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname P2",
        "explanation": "Sets the device 's hostname 'P2 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 3.3.3.9",
        "explanation": "Sets the MPLS tag exchange router with 3.3.3.9 ID",
        "parameters": [
            {
                "name": "LSR-ID",
                "type": "IPv4",
                "explanation": "Only mark for MPLS router"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "Enable MPLS on interface"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/3",
        "explanation": "Enter gigabitEthernet3/0/3 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.3.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "Configuration mode for accessing OSF process 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSF process identifier"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure mode for entering OSF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "OSF Area identifier"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 3.3.3.9 0.0.0.0",
                "explanation": "Add interface 3.3.3.9 to OSF area",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to parent mode"
    }
