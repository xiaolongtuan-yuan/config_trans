{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke1",
        "explanation": "Sets the device 's hostname 'Spoke1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP (Next Hope Promotion)"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.10 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.2.10 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "Tie the interface to the GRE tunnel.",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "Tunnel type"
                }
            ]
        },
        "nhrp entry [parameter1] [parameter2] register": {
            "template": "nhrp entry [parameter1] [parameter2] register",
            "command": "nhrp entry 172.16.1.1 10.1.1.10 register",
            "explanation": "The next jump address registered in NHRP is 172.16.1.1 and the NBMA is 10.1.1.10.",
            "parameters": [
                {
                    "name": "next hop address",
                    "type": "IPv4",
                    "explanation": "Next Jump Address"
                },
                {
                    "name": "NBMA address",
                    "type": "IPv4",
                    "explanation": "NBMA Address"
                }
            ]
        },
        "tunnel-protocol [parameter1]": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol gre",
            "explanation": "Set tunnel protocol to GRE",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Sets the tunnel 's source interface to GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination 10.1.1.10",
            "explanation": "The purpose of the tunnel is 10.1.1.10.",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "Destination Address"
                }
            ]
        },
        "ipsec policy [parameter1]": {
            "template": "ipsec policy [parameter1]",
            "command": "ipsec policy <IPSEC_PROFILE_NAME>",
            "explanation": "Apply IPSec policy to tunnel interface",
            "parameters": [
                {
                    "name": "IPSec policy name",
                    "type": "string",
                    "explanation": "IPSec Policy Name"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.2",
        "explanation": "Configure OSPF process 1 and set router ID to 172.16.1.2",
        "parameters": [
            {
                "name": "OSPF process ID",
                "type": "integer",
                "explanation": "OSS Process ID"
            },
            {
                "name": "router ID",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Enter OSPF area 0.0.0.0 configuration mode",
            "parameters": [
                {
                    "name": "area ID",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "Declaration of network in OSPF area 0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        },
        "silent-interface [parameter1]": {
            "template": "silent-interface [parameter1]",
            "command": "silent-interface all",
            "explanation": "Set all interfaces to silent interface without sending OSPF Hello",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface"
                }
            ]
        },
        "undo silent-interface [parameter1]": {
            "template": "undo silent-interface [parameter1]",
            "command": "undo silent-interface GigabitEthernet1/0/0",
            "explanation": "Cancel the silence of the GigabitEthernet1/0/0 interface and allow the sending of OSPF Hello",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}