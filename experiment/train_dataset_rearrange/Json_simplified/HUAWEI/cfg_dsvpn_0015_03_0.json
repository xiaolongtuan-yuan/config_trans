{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Hub",
        "explanation": "Sets the device 's hostname 'Hub '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP (Next Hope Promotion)"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "Tie the interface to the GRE tunnel.",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "Tunnel type"
                }
            ]
        },
        "tunnel destination [parameter1]": {
            "template": "tunnel destination [parameter1]",
            "command": "tunnel destination 172.16.1.2",
            "explanation": "The purpose of the tunnel is 172.16.1.2.",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "Destination Address"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre ip",
            "explanation": "Set tunnel protocol to GRE over IP",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover Type"
                }
            ]
        },
        "tunnel key [parameter1]": {
            "template": "tunnel key [parameter1]",
            "command": "tunnel key 100",
            "explanation": "Set the key to the tunnel to 100.",
            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "Tunnel Key"
                }
            ]
        },
        "tunnel-protection ipsec profile [parameter1]": {
            "template": "tunnel-protection ipsec profile [parameter1]",
            "command": "tunnel-protection ipsec profile GRE-PROF",
            "explanation": "Configure IPSec protection for tunnels using IPSec profile called GRE-PROF",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "IPSec profile name"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Sets the tunnel 's source interface to GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 100",
        "explanation": "Enter BGP configuration mode, AS 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "Router ID for BGP is 172.16.1.1",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.2 as-number 200",
            "explanation": "Configure BGP equivalent 172.16.1.2 with AS 200",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "Peer Address"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Autonomous System Number"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.1",
        "explanation": "Enter configuration mode for OSPF process 1, setting Router ID to 172.16.1.1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "Process ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure mode for entering OSF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.0.0 0.0.0.255",
                "explanation": "Declaration of network 192.168.0.0 in OSPF area 0.0.0.0 with cipher code 0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}