{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Create or enter configuration mode for VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode for entering the GigabitEthernet1/0/1 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type access",
            "explanation": "Sets the link type of the interface to access mode",
            "parameters": [
                {
                    "name": "link-type",
                    "type": "string",
                    "explanation": "Connection type, e. g. access or trunk"
                }
            ]
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "Set the default VLAN for interface to 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Default VLAN identifier"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "Allow VLAN 10 to pass the trunking interface",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Passable VLAN ID."
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the previous configuration mode"
    }
}