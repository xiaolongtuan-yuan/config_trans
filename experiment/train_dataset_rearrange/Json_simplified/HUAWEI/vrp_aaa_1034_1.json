                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "Server IP Address"
                }
            ]
        },
        "hwtacacs-server authorization [parameter1] secondary": {
            "template": "hwtacacs-server authorization [parameter1] secondary",
            "command": "hwtacacs-server authorization 172.16.1.2 secondary",
            "explanation": "Configure standby authorized server address 172.16.1.2",
            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "Server IP Address"
                },
                {
                    "name": "secondary",
                    "type": "keyword",
                    "explanation": "Assigned as backup server"
                }
            ]
        },
        "hwtacacs-server shared-key cipher [parameter1]": {
            "template": "hwtacacs-server shared-key cipher [parameter1]",
            "command": "hwtacacs-server shared-key cipher %#%#pbft&Zu2$Z<,,g4=vX~7958dF@U%YGfREMUAQA{:%#%#",
            "explanation": "Set shared key for HWTACCS server",
            "parameters": [
                {
                    "name": "shared key",
                    "type": "string",
                    "explanation": "Shared Key"
                }
            ]
        }
    },
