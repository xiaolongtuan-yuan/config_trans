{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname HUAWEIA",
        "explanation": "Sets the device's hostname 'HUAWEIA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "hwtacacs enable": {
        "template": "hwtacacs enable",
        "command": "hwtacacs enable",
        "explanation": "Enable HWTACCS service"
    },
    "hwtacacs-server template [parameter1]": {
        "template": "hwtacacs-server template [parameter1]",
        "command": "hwtacacs-server template ht",
        "explanation": "Create a HWTACCS server template called 'ht'",
        "parameters": [
            {
                "name": "template name",
                "type": "string",
                "explanation": "Template Name"
            }
        ],
        "hwtacacs-server authentication [parameter1]": {
            "template": "hwtacacs-server authentication [parameter1]",
            "command": "hwtacacs-server authentication 172.16.1.1",
            "explanation": "Configure authentication server address 172.16.1.1",
            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "Server IP Address"
                }
            ]
        },
        "hwtacacs-server authentication [parameter1] secondary": {
            "template": "hwtacacs-server authentication [parameter1] secondary",
            "command": "hwtacacs-server authentication 172.16.1.2 secondary",
