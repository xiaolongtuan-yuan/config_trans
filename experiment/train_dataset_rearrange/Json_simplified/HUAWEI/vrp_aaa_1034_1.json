            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "Server IP Address"
                },
                {
                    "name": "secondary",
                    "type": "keyword",
                    "explanation": "Assigned as backup server"
                }
            ]
        },
        "hwtacacs-server authorization [parameter1]": {
            "template": "hwtacacs-server authorization [parameter1]",
            "command": "hwtacacs-server authorization 172.16.1.1",
