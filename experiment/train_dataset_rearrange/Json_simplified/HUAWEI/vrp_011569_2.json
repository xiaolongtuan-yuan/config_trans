{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "Batch to create VLAN, here to create VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "Enable CFM"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode for entering specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "Allow trunk port to transfer specified VLAN, this is VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md1 level 6",
        "explanation": "Configure CFM domain, domain md1, level 6",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "CFM domain name"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "CFM Level"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma1",
            "explanation": "Configure maintenance associated with ma1",
            "parameters": [
                {
                    "name": "maintenance association name",
                    "type": "string",
                    "explanation": "Maintain Association Name"
                }
            ],
            "map vlan [parameter1]": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 10",
                "explanation": "Map VLAN 10 to maintain association",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 1 interface GigabitEthernet1/0/1 outward",
                "explanation": "Configure MEP, MEP ID to 1, interface to GigabitEthernet 1/0/1, direction to outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP identifier"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "Interface Name"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "Direction, like inward or outward"
                    }
                ]
            },
            "mep ccm-send mep-id [parameter1] enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 1 enable",
                "explanation": "Enable CCM sent by MEP ID 1",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP identifier"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 2",
                "explanation": "Configure remote MEP, MEP ID to 2",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP identifier"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [parameter1] enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 2 enable",
                "explanation": "Enable CCM acceptance of remote MEP ID 2",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP identifier"
                    }
                ]
            }
        }
    }
}