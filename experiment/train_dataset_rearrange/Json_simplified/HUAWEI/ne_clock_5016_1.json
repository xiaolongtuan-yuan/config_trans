{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "Enable extended SSM control",
        "parameters": [
            {
                "name": "state",
                "type": "string",
                "explanation": "Status, can be 'on' or 'off'"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode for entering specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "Set clock priority",
            "parameters": [
                {
                    "name": "priority level",
                    "type": "integer",
                    "explanation": "Priority level"
                }
            ]
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 4",
            "explanation": "Set clock ID",
            "parameters": [
                {
                    "name": "clock ID",
                    "type": "integer",
                    "explanation": "Clock ID"
                }
            ]
        }
    }
}