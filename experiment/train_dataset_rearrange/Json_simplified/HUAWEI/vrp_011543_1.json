{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [vlan-id]": {
        "template": "vlan [vlan-id]",
        "command": "vlan 2",
        "explanation": "Create or configure VLAN 2",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm version [version]": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "Set CFM version to standard",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "Version Name"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "Enable CFM"
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure GigabitEthernet1/0/1 interface",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port trunk allow-pass vlan [vlan-id]": {
            "template": "port trunk allow-pass vlan [vlan-id]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "Allow VLAN 2 to pass this trunk interface",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md [md-name]": {
        "template": "cfm md [md-name]",
        "command": "cfm md md3",
        "explanation": "Configure MD md3",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "Maintain domain name"
            }
        ],
        "ma [ma-name]": {
            "template": "ma [ma-name]",
            "command": "ma ma3",
            "explanation": "Configure MA ma3",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "Maintain Association Name"
                }
            ],
            "map vlan [vlan-id]": {
                "template": "map vlan [vlan-id]",
                "command": "map vlan 2",
                "explanation": "Map MA to VLAN 2",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id [mep-id] interface [interface-name] [direction]": {
                "template": "mep mep-id [mep-id] interface [interface-name] [direction]",
                "command": "mep mep-id 4 interface GigabitEthernet1/0/1 outward",
                "explanation": "Configure MEP ID 4 on interface GigabitEthernet1/0/1 in an outward direction",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "Interface Name"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "Direction, like inward or outward"
                    }
                ]
            },
            "mep ccm-send mep-id [mep-id] enable": {
                "template": "mep ccm-send mep-id [mep-id] enable",
                "command": "mep ccm-send mep-id 4 enable",
                "explanation": "Enable MEP ID 4 to send CCM",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id [mep-id]": {
                "template": "remote-mep mep-id [mep-id]",
                "command": "remote-mep mep-id 3",
                "explanation": "Configure remote MEP ID 3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id [mep-id] enable": {
                "template": "remote-mep ccm-receive mep-id [mep-id] enable",
                "command": "remote-mep ccm-receive mep-id 3 enable",
                "explanation": "Enable CCM for receiving remote MEP ID 3",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "test-id [test-id] mep [mep-id]": {
                "template": "test-id [test-id] mep [mep-id]",
                "command": "test-id 1 mep 4",
                "explanation": "Configure Test ID 1, MEP ID 4",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "delay-measure two-way receive test-id [test-id]": {
                "template": "delay-measure two-way receive test-id [test-id]",
                "command": "delay-measure two-way receive test-id 1",
                "explanation": "Configure delayed measurements, two-way reception, test ID 1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    }
                ]
            },
            "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]": {
                "template": "test-id [test-id] mep [mep-id] remote-mep [remote-mep-id]",
                "command": "test-id 2 mep 4 remote-mep 3",
                "explanation": "Configure test ID 2, MEP ID 4, remote MEP ID 3",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "remote-mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "delay-measure two-way continual send test-id [test-id] interval [interval]": {
                "template": "delay-measure two-way continual send test-id [test-id] interval [interval]",
                "command": "delay-measure two-way continual send test-id 2 interval 1000",
                "explanation": "Configure delay measurements, two-way continuous, test ID 2, 1,000 ms interval",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    },
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "Period in milliseconds"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Returns the previous configuration mode"
    }
}