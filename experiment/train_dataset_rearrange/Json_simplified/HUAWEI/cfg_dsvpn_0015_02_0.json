{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Hub",
        "explanation": "Sets the device 's hostname 'Hub '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "Tie the interface to the GRE tunnel.",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "Tunnel type"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "Set the tunnel protocol to GRE in a multi-point mode",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Mode"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Sets the tunnel 's source interface to GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        },
        "nhrp network-id [parameter1]": {
            "template": "nhrp network-id [parameter1]",
            "command": "nhrp network-id 1",
            "explanation": "Set NHRP Network ID to 1",
            "parameters": [
                {
                    "name": "network id",
                    "type": "integer",
                    "explanation": "Network ID"
                }
            ]
        },
        "ospf network-type [parameter1]": {
            "template": "ospf network-type [parameter1]",
            "command": "ospf network-type p2mp",
            "explanation": "Set OSPF network type to multiple points",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "Network Type"
                }
            ]
        },
        "nhrp nhs [parameter1] [parameter2]": {
            "template": "nhrp nhs [parameter1] [parameter2]",
            "command": "nhrp nhs 172.16.1.1 multicast",
            "explanation": "Set NHRP 's next jumper to 172.16.1.1 and enable multiplay",
            "parameters": [
                {
                    "name": "next hop server",
                    "type": "IPv4",
                    "explanation": "Next Jump Server"
                },
                {
                    "name": "multicast",
                    "type": "string",
                    "explanation": "Multiplay"
                }
            ]
        },
        "nhrp entry [parameter1] [parameter2]": {
            "template": "nhrp entry [parameter1] [parameter2]",
            "command": "nhrp entry multicast dynamic",
            "explanation": "Set NHRP Entry as Multicast Dynamic",
            "parameters": [
                {
                    "name": "entry type",
                    "type": "string",
                    "explanation": "Entry Type"
                },
                {
                    "name": "dynamic",
                    "type": "string",
                    "explanation": "Dynamic"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.1",
        "explanation": "Configure OSPF process 1 with router ID of 172.16.1.1",
        "parameters": [
            {
                "name": "ospf process",
                "type": "integer",
                "explanation": "OSF Process"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Enter OSPF area 0.0.0.0 configuration mode",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "Add network 172.16.1.0/24 to OSPF area 0.0.0.0",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}