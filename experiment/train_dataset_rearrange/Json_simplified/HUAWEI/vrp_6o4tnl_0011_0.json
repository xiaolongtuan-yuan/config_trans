{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure the specified interface, this is GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.0.0.0",
            "explanation": "The IPv4 address for the configuration interface is 1.1.1.1, subnet mask is 255.0.0.",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2002:101:101:1::1/64",
            "explanation": "The IPv6 address for the configuration interface is 2002:101:101:1:1:1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 Address"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol ipv6-ipv4 6to4",
            "explanation": "Set tunnel protocol to 6to4 of IPv6 over IPv4",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "Tunnel protocol type"
                },
                {
                    "name": "subtype",
                    "type": "string",
                    "explanation": "Subtype of protocol"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source 1.1.1.1",
            "explanation": "Specify the source IPv4 address of the tunnel as 1.1.1",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "Source IPv4 Address"
                }
            ]
        }
    },
    "ipv6 route-static [parameter1] [parameter2] [parameter3]": {
        "template": "ipv6 route-static [parameter1] [parameter2] [parameter3]",
        "command": "ipv6 route-static :: 0 2002:202:202::1",
        "explanation": "Configure static IPv6 route, target address */0, next jump 2002:202:202:1",
        "parameters": [
            {
                "name": "destination address",
                "type": "IPv6",
                "explanation": "Destination Address"
            },
            {
                "name": "prefix length",
                "type": "integer",
                "explanation": "Prefix Length"
            },
            {
                "name": "next hop",
                "type": "IPv6",
                "explanation": "Next Jump Address"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit the current configuration mode or return to the next level"
    }
}