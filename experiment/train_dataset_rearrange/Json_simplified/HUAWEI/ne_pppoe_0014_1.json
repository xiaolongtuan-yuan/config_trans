            "command": "radius-server authentication 2001:db8::1:1 1645 weight 0",
            "explanation": "Configure IP addresses, ports and weights of the authentication server",
            "parameters": [
                {
                    "name": "server IP",
                    "type": "IPv6",
                    "explanation": "IP address of RADIUS server"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "Authentication Port"
                },
                {
                    "name": "weight",
                    "type": "integer",
                    "explanation": "Server weights"
                }
            ]
        },
