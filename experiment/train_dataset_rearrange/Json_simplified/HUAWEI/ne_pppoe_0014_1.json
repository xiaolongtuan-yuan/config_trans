            "parameters": [
                {
                    "name": "server IP",
                    "type": "IPv6",
                    "explanation": "IP address of RADIUS server"
                },
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "Fee port"
                },
                {
                    "name": "weight",
                    "type": "integer",
                    "explanation": "Server weights"
                }
            ]
        },
