{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set interfaced chain layer protocol to PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Chain Layer Protocol Name"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.110.0.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ppp chap user [parameter1]": {
            "template": "ppp chap user [parameter1]",
            "command": "ppp chap user rtb",
            "explanation": "Configure usernames for PPP CHAP authentication",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "CHAP authentication username"
                }
            ]
        },
        "ppp chap password cipher [parameter1]": {
            "template": "ppp chap password cipher [parameter1]",
            "command": "ppp chap password cipher @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
            "explanation": "Configure passwords for PPP CHAP authentication, encryption using Cipher",
            "parameters": [
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "Encrypted Password String"
                }
            ]
        }
    }
}