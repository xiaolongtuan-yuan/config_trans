{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "Set the device 's hostname 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "diffserv domain [parameter1]": {
        "template": "diffserv domain [parameter1]",
        "command": "diffserv domain gina",
        "explanation": "Create or enter the differential service field 'gina'",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "Name of the differential service field"
            }
        ],
        "8021p-inbound [parameter1] phb [parameter2] [parameter3]": {
            "template": "8021p-inbound [parameter1] phb [parameter2] [parameter3]",
            "command": "8021p-inbound 2 phb af1 green",
            "explanation": "Configure 802.1p Priority 2 map to PHB af1, colour marked as green",
            "parameters": [
                {
                    "name": "8021p priority",
                    "type": "integer",
                    "explanation": "802.1p priority value"
                },
                {
                    "name": "phb",
                    "type": "string",
                    "explanation": "PHB category"
                },
                {
                    "name": "color",
                    "type": "string",
                    "explanation": "Colour Tags"
                }
            ]
        }
    },
    "bridge-domain [parameter1]": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "Link interface to bridge area 10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "Identification number of the bridge area"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure mode for entering the GigabitEthernet1/0/1 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet 1/0/1.1 mode l2",
        "explanation": "Enter configuration mode for the GigabitEthernet1/0/1.1 interface and set mode l2",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "Interface mode, e.g., l2"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "Configure interface wraps as dot1q and VLAN ID as 10",
            "parameters": [
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "Link interface to bridge area 10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "Identification number of the bridge area"
                }
            ]
        },
        "trust upstream [parameter1]": {
            "template": "trust upstream [parameter1]",
            "command": "trust upstream gina",
            "explanation": "Set trusted upstream differential service domain 'gina '",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "Name of the differential service field"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit Current Configuration Mode"
    }
}