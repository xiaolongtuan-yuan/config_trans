        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.3",
        "explanation": "Enter OSPF process 1 configuration mode, setting Router ID to 172.16.1.3",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "Process ID"
