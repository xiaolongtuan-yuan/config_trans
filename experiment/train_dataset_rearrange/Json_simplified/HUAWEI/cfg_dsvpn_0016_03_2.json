            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "Key"
                }
            ]
        },
        "ipsec profile [parameter1]": {
            "template": "ipsec profile [parameter1]",
            "command": "ipsec profile IPSEC_PROFILE_NAME",
