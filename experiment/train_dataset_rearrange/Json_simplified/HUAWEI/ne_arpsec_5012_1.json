{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device",
        "explanation": "Sets the device 's hostname 'Device '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 100",
        "explanation": "Create VLAN 100",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port trunk allow-pass vlan [parameter1] [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] [parameter2]",
            "command": "port trunk allow-pass vlan 100 200",
            "explanation": "Configure trunk port allowed via VLAN 100 and 200",
            "parameters": [
                {
                    "name": "vlan id1",
                    "type": "integer",
                    "explanation": "First VLAN ID"
                },
                {
                    "name": "vlan id2",
                    "type": "integer",
                    "explanation": "Second VLAN ID"
                }
            ]
        },
        "arp rate-limit [parameter1]": {
            "template": "arp rate-limit [parameter1]",
            "command": "arp rate-limit 50",
            "explanation": "Set the ARP speed limit to 50",
            "parameters": [
                {
                    "name": "rate limit value",
                    "type": "integer",
                    "explanation": "ARP Speed Limit"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Returns the previous configuration mode"
    }
}