{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname DeviceA",
        "explanation": "Set the device to the name 'DeviceA'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [interface_name]": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure interface GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [ip_address] [subnet_mask]": {
            "template": "ip address [ip_address] [subnet_mask]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip_address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet_mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ipv6 address [ipv6_address] [prefix_length]": {
            "template": "ipv6 address [ipv6_address] [prefix_length]",
            "command": "ipv6 address 2001:db8:101:101::1 64",
            "explanation": "Configure interface IPv6 address 2001: db8:101:101:1 with prefix length 64",
            "parameters": [
                {
                    "name": "ipv6_address",
                    "type": "IPv6",
                    "explanation": "IPv6 Address"
                },
                {
                    "name": "prefix_length",
                    "type": "integer",
                    "explanation": "Prefix Length"
                }
            ]
        },
        "tunnel-protocol [protocol]": {
            "template": "tunnel-protocol [protocol]",
            "command": "tunnel-protocol ipv6-ipv4 6rd",
            "explanation": "Set tunnel protocol to ipv6-ipv4 6rd",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol type"
                }
            ]
        },
        "source [interface_name]": {
            "template": "source [interface_name]",
            "command": "source GigabitEthernet1/0/1",
            "explanation": "Set the tunnel 's source interface to GigabitEthernet1/0/1",
            "parameters": [
                {
                    "name": "interface_name",
                    "type": "string",
                    "explanation": "Source Interface Name"
                }
            ]
        },
        "ipv6-prefix [ipv6_prefix]": {
            "template": "ipv6-prefix [ipv6_prefix]",
            "command": "ipv6-prefix 2001:db8::/32",
            "explanation": "Set IPv6 prefix to 2001: db8:32",
            "parameters": [
                {
                    "name": "ipv6_prefix",
                    "type": "IPv6 prefix",
                    "explanation": "IPv6 Prefix"
                }
            ]
        },
        "ipv4-prefix length [length]": {
            "template": "ipv4-prefix length [length]",
            "command": "ipv4-prefix length 8",
            "explanation": "Set IPv4 prefix length to 8",
            "parameters": [
                {
                    "name": "length",
                    "type": "integer",
                    "explanation": "Prefix length of IPv4"
                }
            ]
        }
    },
    "ipv6 route-static [destination] [prefix_length] [interface]": {
        "template": "ipv6 route-static [destination] [prefix_length] [interface]",
        "command": "ipv6 route-static 2001:db8:: 32 Tunnel1",
        "explanation": "Configure static IPv6 route, destination 2001:db8:32, interface with Tunnel1",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv6",
                "explanation": "Destination IPv6 Address"
            },
            {
                "name": "prefix_length",
                "type": "integer",
                "explanation": "Prefix Length"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "Out interface."
            }
        ]
    }
}