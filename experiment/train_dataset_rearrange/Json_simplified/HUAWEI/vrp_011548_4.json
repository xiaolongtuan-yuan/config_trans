{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "cfm version [parameter1]": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "Set CFM version to standard",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM version"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "Enable CFM"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Enter gigabitEthernet1/0/1 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "Allow VLAN 10 to trunk port",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
    },
    "cfm md [parameter1] level [parameter2]": {
        "template": "cfm md [parameter1] level [parameter2]",
        "command": "cfm md md2 level 6",
        "explanation": "Configure CFM domainmd2 with level 6",
        "parameters": [
            {
                "name": "md name",
                "type": "string",
                "explanation": "CFM domain name"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "Level"
            }
        ],
        "ma [parameter1]": {
            "template": "ma [parameter1]",
            "command": "ma ma2",
            "explanation": "Configure MA (Maintenance Association) name ma2",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "MA Name"
                }
            ],
            "map mpls vlan [parameter1]": {
                "template": "map mpls vlan [parameter1]",
                "command": "map mpls vlan 10",
                "explanation": "Map VLAN 10 to MPLS",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN identification number"
                    }
                ]
            },
            "mep mep-id [parameter1] interface [parameter2] [parameter3]": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 62 interface gigabitEthernet1/0/1 outward",
                "explanation": "Configure MEP ID to 62, interface to GigabitEthernet 1/0/1, orientation to outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP identification number"
                    },
                    {
                        "name": "interface",
                        "type": "string",
                        "explanation": "Interface Name"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "Direction (inward or outward)"
                    }
                ]
            },
            "ccm-interval [parameter1]": {
                "template": "ccm-interval [parameter1]",
                "command": "ccm-interval 10000",
                "explanation": "Set CCM (Continuity Check Message) at 10,000 ms interval",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "CCM interval (ms)"
                    }
                ]
            },
            "remote-mep mep-id [parameter1]": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 61",
                "explanation": "Configure remote MEP ID to 61",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Returns the previous configuration mode"
    }
}