{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "Sets the device 's hostname 'DeviceC '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp-adaptive enable": {
        "template": "ptp-adaptive enable",
        "command": "ptp-adaptive enable",
        "explanation": "Enable PTP self-adaptation"
    },
    "ptp-adaptive device-type [parameter1]": {
        "template": "ptp-adaptive device-type [parameter1]",
        "command": "ptp-adaptive device-type client",
        "explanation": "Set PTP Adaptation Device Type as Client",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "Device Type"
            }
        ]
    },
    "ptp-adaptive local-ip [parameter1]": {
        "template": "ptp-adaptive local-ip [parameter1]",
        "command": "ptp-adaptive local-ip 2.2.2.2",
        "explanation": "Set PTP to fit local IP address 2.2.2.2",
        "parameters": [
            {
                "name": "local ip",
                "type": "IPv4",
                "explanation": "Chile"
            }
        ]
    },
    "ptp-adaptive remote-server1-ip [parameter1]": {
        "template": "ptp-adaptive remote-server1-ip [parameter1]",
        "command": "ptp-adaptive remote-server1-ip 1.1.1.1",
        "explanation": "Set IP address for PTP to adapt to remote server 1 to 1.1.1.1",
        "parameters": [
            {
                "name": "remote server1 ip",
                "type": "IPv4",
                "explanation": "IP address for remote server 1"
            }
        ]
    },
    "ptp-adaptive request sync-interval [parameter1]": {
        "template": "ptp-adaptive request sync-interval [parameter1]",
        "command": "ptp-adaptive request sync-interval 4",
        "explanation": "Set PTP synchronisation from adaptation request to 4",
        "parameters": [
            {
                "name": "sync interval",
                "type": "integer",
                "explanation": "Synchronise interval"
            }
        ]
    },
    "ptp-adaptive request announce-interval [parameter1]": {
        "template": "ptp-adaptive request announce-interval [parameter1]",
        "command": "ptp-adaptive request announce-interval 12",
        "explanation": "Set PTP from the request for adaptation to be advertised at 12 intervals",
        "parameters": [
            {
                "name": "announce interval",
                "type": "integer",
                "explanation": "Bulletin interval"
            }
        ]
    },
    "ptp-adaptive request delay-resp-interval [parameter1]": {
        "template": "ptp-adaptive request delay-resp-interval [parameter1]",
        "command": "ptp-adaptive request delay-resp-interval 6",
        "explanation": "Set PTP time interval from delayed response to adaptation request to 6",
        "parameters": [
            {
                "name": "delay resp interval",
                "type": "integer",
                "explanation": "Delay response interval"
            }
        ]
    },
    "ptp-adaptive acr unicast-negotiate enable": {
        "template": "ptp-adaptive acr unicast-negotiate enable",
        "command": "ptp-adaptive acr unicast-negotiate enable",
        "explanation": "Enable PTP to adapt to ACR Radio Consultation"
    },
    "clock source ptp synchronization enable": {
        "template": "clock source ptp synchronization enable",
        "command": "clock source ptp synchronization enable",
        "explanation": "Enabling PTP to synchronize as a clock source"
    },
    "clock source ptp priority [parameter1]": {
        "template": "clock source ptp priority [parameter1]",
        "command": "clock source ptp priority 1",
        "explanation": "Set PTP as a clock source with 1 priority",
        "parameters": [
            {
                "name": "priority",
                "type": "integer",
                "explanation": "Priority"
            }
        ]
    },
    "clock source ptp ssm [parameter1]": {
        "template": "clock source ptp ssm [parameter1]",
        "command": "clock source ptp ssm prc",
        "explanation": "Sets the SSM of PTP as a clock source to PRC",
        "parameters": [
            {
                "name": "ssm",
                "type": "string",
                "explanation": "SSM Type"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "Enter Loopback0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 2.2.2.2 and the subnet mask is 255.255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}