{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname PE1",
        "explanation": "Sets the device 's system name 'PE1 '",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "System name of the device"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "Enable PTP on interface"
    },
    "ptp profile [profile_name] enable": {
        "template": "ptp profile [profile_name] enable",
        "command": "ptp profile g-8275-1 enable",
        "explanation": "Enable specific PTP profile 'g-8275-1'",
        "parameters": [
            {
                "name": "profile_name",
                "type": "string",
                "explanation": "PTP profile name"
            }
        ]
    },
    "ptp device-type [device_type]": {
        "template": "ptp device-type [device_type]",
        "command": "ptp device-type t-bc",
        "explanation": "Sets the device 's PTP type to 't-bc '",
        "parameters": [
            {
                "name": "device_type",
                "type": "string",
                "explanation": "PTP Device Type"
            }
        ]
    },
    "interface [interface_name]": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode for entering the GigabitEthernet1/0/0 interface",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    }
}