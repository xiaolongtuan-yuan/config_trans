{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke1",
        "explanation": "Sets the device 's hostname 'Spoke1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP (Next Hope Promotion)"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.2.10 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.2.10 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "binding tunnel [parameter1]": {
            "template": "binding tunnel [parameter1]",
            "command": "binding tunnel gre",
            "explanation": "Tie the interface to the GRE tunnel.",
            "parameters": [
                {
                    "name": "tunnel type",
                    "type": "string",
                    "explanation": "Tunnel type"
                }
            ]
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile IPSEC-PROFILE",
            "explanation": "Configure IPSec protection for tunnels using IPSec profile called IPSEC-PROFILE",
            "parameters": [
                {
                    "name": "ipsec profile",
                    "type": "string",
                    "explanation": "IPSec profile name"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "Configure Tunnel Protocol to GRE point to multiple",
            "parameters": [
                {
                    "name": "tunnel protocol",
                    "type": "string",
                    "explanation": "Tunnel protocol"
                },
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "Tunnel Mode"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Sets the tunnel 's source interface to GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        },
        "nhrp entry [parameter1] [parameter2] register": {
            "template": "nhrp entry [parameter1] [parameter2] register",
            "command": "nhrp entry 172.16.1.1 10.1.1.10 register",
            "explanation": "Registered NHRP entry, destination address 172.16.1.1, next jump address 10.1.1.10",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "Destination Address"
                },
                {
                    "name": "next hop address",
                    "type": "IPv4",
                    "explanation": "Next Jump Address"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 200",
        "explanation": "Enter BGP configuration mode, AS 200",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.2",
            "explanation": "The ID for the BGP router is 172.16.1.2",
            "parameters": [
                {
                    "name": "router id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.1 as-number 100",
            "explanation": "Configure BGP equivalent, IP address 172.16.1.1 and AS 100",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "Peer IP Address"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Autonomous System Number"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.2",
        "explanation": "Enter configuration mode for OSPF process 1, setting router ID to 172.16.1.2",
        "parameters": [
            {
                "name": "ospf process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            },
            {
                "name": "router id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure mode for entering OSF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.1.0 0.0.0.255",
                "explanation": "Declares the network 192.168.1.0 in OSPF area 0.0.0.0, with a wildcard mask of 0.0.255",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}