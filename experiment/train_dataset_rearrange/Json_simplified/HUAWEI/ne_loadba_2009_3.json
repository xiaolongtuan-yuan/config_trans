{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerD",
        "explanation": "Sets the device 'routerD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "Enable ISIS Process 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "ISIS Process ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-1",
            "explanation": "Set ISIS to level 1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "Level of ISIS, level-1 or level-2"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 10.0000.0000.0004.00",
            "explanation": "Set the name of the network entity for ISIS",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "Web entity title for ISIS"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.50.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.50.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "Enable ISIS process 1 on interface",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "ISIS Process ID"
                }
            ]
        }
    }
