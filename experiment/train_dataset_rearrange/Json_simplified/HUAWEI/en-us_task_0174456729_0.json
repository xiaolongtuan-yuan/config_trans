{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls label protocol [parameter1]": {
        "template": "mpls label protocol [parameter1]",
        "command": "mpls label protocol ldp",
        "explanation": "Configure tag distribution protocol to LDP",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "Tag Distribution Protocol, here is LDP"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "Enable MPLS"
    },
    "segment-routing": {
        "template": "segment-routing",
        "command": "segment-routing",
        "explanation": "Enable segment router"
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "Enable ISIS process1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "ISIS process ID"
            }
        ],
        "is-level [parameter1]": {
            "template": "is-level [parameter1]",
            "command": "is-level level-1",
            "explanation": "Set ISIS level to Level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "ISIS level, level-1 or level-2"
                }
            ]
        },
        "cost-style [parameter1]": {
            "template": "cost-style [parameter1]",
            "command": "cost-style wide",
            "explanation": "Set Cost Style to Wide",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "Cost style, e. g. wide"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 49.0001.0000.0000.00",
            "explanation": "Name of the network entity setting ISIS",
            "parameters": [
                {
                    "name": "net",
                    "type": "string",
                    "explanation": "Web entity title for ISIS"
                }
            ]
        },
        "segment-routing global-block [parameter1] [parameter2]": {
            "template": "segment-routing global-block [parameter1] [parameter2]",
            "command": "segment-routing global-block 16000 23999",
            "explanation": "Configure global SRGB block",
            "parameters": [
                {
                    "name": "start",
                    "type": "integer",
                    "explanation": "Start Tab Value"
                },
                {
                    "name": "end",
                    "type": "integer",
                    "explanation": "End Tab Value"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "Enable ISIS process 1 on interface",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "ISIS process ID"
                }
            ]
        },
        "isis network-type [parameter1]": {
            "template": "isis network-type [parameter1]",
            "command": "isis network-type p2p",
            "explanation": "Set ISIS network type to point to point",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Network type, e.g. p2p"
                }
            ]
        },
        "isis prefix-sid index [parameter1]": {
            "template": "isis prefix-sid index [parameter1]",
            "command": "isis prefix-sid index 10",
            "explanation": "Configure prefix SID index to 10",
            "parameters": [
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "Prefix SID index value"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the next level"
    }
}