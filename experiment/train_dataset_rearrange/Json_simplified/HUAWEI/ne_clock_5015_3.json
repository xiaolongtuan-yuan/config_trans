{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "Sets the device's host name 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "clock ssm-control [parameter1]": {
        "template": "clock ssm-control [parameter1]",
        "command": "clock ssm-control on",
        "explanation": "Enable SSM (Synchronous Status Messaging) control",
        "parameters": [
            {
                "name": "ssm-control",
                "type": "string",
                "explanation": "SSM Control Status"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode into interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "clock synchronization [parameter1]": {
            "template": "clock synchronization [parameter1]",
            "command": "clock synchronization enable",
            "explanation": "Enable interfacing clock sync",
            "parameters": [
                {
                    "name": "synchronization",
                    "type": "string",
                    "explanation": "Sync Status"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "Set the clock priority for interface 1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "Clock Priority"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit current configuration mode and return to user view"
    }
}