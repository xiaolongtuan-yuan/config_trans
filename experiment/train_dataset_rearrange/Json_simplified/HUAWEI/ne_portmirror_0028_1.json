{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "Set the device 's hostname 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure Specific Interfaces",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "interface [parameter1] mode [parameter2]": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet1/0/1.1 mode l2",
        "explanation": "Configure sub-interface and set mode to L2",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Sub-interface name"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "Mode Type (L2)"
            }
        ],
        "encapsulation dot1q vid [parameter1]": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "Set the envelope type dot1q and configure VLAN ID to 10",
            "parameters": [
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain [parameter1]": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "Link interface to bridge area 10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "Bridge Area ID"
                }
            ]
        },
        "rewrite map [parameter1] vid [parameter2]": {
            "template": "rewrite map [parameter1] vid [parameter2]",
            "command": "rewrite map 1-to-1 vid 10",
            "explanation": "Configure rewrite map to map VLAN ID from 1 to 10",
            "parameters": [
                {
                    "name": "map name",
                    "type": "string",
                    "explanation": "Map Name"
                },
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Returns previous configuration mode"
    }
