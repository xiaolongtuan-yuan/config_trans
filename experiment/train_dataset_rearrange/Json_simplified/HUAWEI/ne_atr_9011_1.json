{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Server2",
        "explanation": "Set the device 's hostname 'Server2 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp-adaptive enable": {
        "template": "ptp-adaptive enable",
        "command": "ptp-adaptive enable",
        "explanation": "Enable PTP self-adaptation"
    },
    "ptp-adaptive device-type [parameter1]": {
        "template": "ptp-adaptive device-type [parameter1]",
        "command": "ptp-adaptive device-type server",
        "explanation": "Set device type as server",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "Device Type"
            }
        ]
    },
    "ptp-adaptive time profile": {
        "template": "ptp-adaptive time profile",
        "command": "ptp-adaptive time profile",
        "explanation": "Configure Time Profile"
    },
    "ptp-adaptive domain [parameter1]": {
        "template": "ptp-adaptive domain [parameter1]",
        "command": "ptp-adaptive domain 45",
        "explanation": "Set PTP domain to 45",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "PTP Domain"
            }
        ]
    },
    "ptp-adaptive local-ip [parameter1]": {
        "template": "ptp-adaptive local-ip [parameter1]",
        "command": "ptp-adaptive local-ip 2.2.2.2",
        "explanation": "Set local IP address to 2.2.2.2",
        "parameters": [
            {
                "name": "local IP address",
                "type": "IPv4",
                "explanation": "Chile"
            }
        ]
    },
    "ptp-adaptive atr unicast-negotiate enable": {
        "template": "ptp-adaptive atr unicast-negotiate enable",
        "command": "ptp-adaptive atr unicast-negotiate enable",
        "explanation": "Enable ATR Radio Consultation"
    },
    "ptp-adaptive dscp [parameter1]": {
        "template": "ptp-adaptive dscp [parameter1]",
        "command": "ptp-adaptive dscp 60",
        "explanation": "Set DSCP value to 60",
        "parameters": [
            {
                "name": "DSCP value",
                "type": "integer",
                "explanation": "DSCP value"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "Enter Loopback0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 2.2.2.2 and the subnet mask is 255.255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
}