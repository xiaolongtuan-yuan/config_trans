{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "Set the device 's hostname 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "Enable PTP functionality on interface"
    },
    "ptp clock-source [parameter1] [parameter2]": {
        "template": "ptp clock-source [parameter1] [parameter2]",
        "command": "ptp clock-source bits1 on",
        "explanation": "Set clock source to bits1 and enable",
        "parameters": [
            {
                "name": "clock source name",
                "type": "string",
                "explanation": "Clock Source Name"
            },
            {
                "name": "status",
                "type": "string",
                "explanation": "Status, on or off"
            }
        ]
    },
    "ptp clock-source [parameter1] priority1 [parameter2]": {
        "template": "ptp clock-source [parameter1] priority1 [parameter2]",
        "command": "ptp clock-source bits1 priority1 1",
        "explanation": "Set the priority of clock source bits1 to 1",
        "parameters": [
            {
                "name": "clock source name",
                "type": "string",
                "explanation": "Clock Source Name"
            },
            {
                "name": "priority",
                "type": "integer",
                "explanation": "Priority value"
            }
        ]
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type bc",
        "explanation": "Set PTP Device Type to Broadcast",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "Type of equipment, e.g. bc (broadcasting)"
            }
        ]
    },
    "ptp domain [parameter1]": {
        "template": "ptp domain [parameter1]",
        "command": "ptp domain 1",
        "explanation": "Set PTP domain to 1",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "Domain ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode for entering specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.0.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192.168.0.1 and the subnet mask is 255.252.55.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ptp delay-mechanism [parameter1]": {
            "template": "ptp delay-mechanism [parameter1]",
            "command": "ptp delay-mechanism pdelay",
            "explanation": "Set PTP Delay to pdelay",
            "parameters": [
                {
                    "name": "delay mechanism",
                    "type": "string",
                    "explanation": "Type of mechanism to delay, e.g. pdelay"
                }
            ]
        },
        "ptp announce-interval [parameter1]": {
            "template": "ptp announce-interval [parameter1]",
            "command": "ptp announce-interval 8",
            "explanation": "Set the interval between PTP announce messages to 8 seconds",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "Interval time, in seconds"
                }
            ]
        },
        "ptp min-delayreq-interval [parameter1]": {
            "template": "ptp min-delayreq-interval [parameter1]",
            "command": "ptp min-delayreq-interval 10",
            "explanation": "Set PTP minimum interval of 10 seconds",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "Interval time, in seconds"
                }
            ]
        },
        "ptp udp-egress source-ip [parameter1] destination-ip [parameter2]": {
            "template": "ptp udp-egress source-ip [parameter1] destination-ip [parameter2]",
            "command": "ptp udp-egress source-ip 192.168.0.1 destination-ip 192.168.0.2",
            "explanation": "Set IP and destination IP for PTP UDP exports",
            "parameters": [
                {
                    "name": "source-ip",
                    "type": "IPv4",
                    "explanation": "Source IP Address"
                },
                {
                    "name": "destination-ip",
                    "type": "IPv4",
                    "explanation": "Destination IP Address"
                }
            ]
        },
        "ptp udp-egress destination-mac [parameter1]": {
            "template": "ptp udp-egress destination-mac [parameter1]",
            "command": "ptp udp-egress destination-mac 00e0-fc22-4444",
            "explanation": "Set up MAC address for PTP UDP export",
            "parameters": [
                {
                    "name": "destination-mac",
                    "type": "MAC address",
                    "explanation": "Destination MAC Address"
                }
            ]
        },
        "ptp announce receipt-timeout [parameter1]": {
            "template": "ptp announce receipt-timeout [parameter1]",
            "command": "ptp announce receipt-timeout 10",
            "explanation": "Set the time limit for receiving PTP announce messages to 10 seconds",
            "parameters": [
                {
                    "name": "timeout",
                    "type": "integer",
                    "explanation": "Timeout, unit of seconds"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "Enable OSF process1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Set OSPF area to 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.0.0.0 0.0.0.255",
                "explanation": "Integration of network 10.0.0/24 into the OSPF region",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Countermask"
                    }
                ]
            }
        }
    }
}