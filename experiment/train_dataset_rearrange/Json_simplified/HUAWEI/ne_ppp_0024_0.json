{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "Enter interface configuration mode and configure specific interfaces",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set interfaced chain layer protocol to PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Chain Layer Protocol Name"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.110.0.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ppp authentication-mode [parameter1]": {
            "template": "ppp authentication-mode [parameter1]",
            "command": "ppp authentication-mode chap",
            "explanation": "Set PPP authentication mode to CHAP",
            "parameters": [
                {
                    "name": "authentication mode",
                    "type": "string",
                    "explanation": "Authentication mode"
                }
            ]
        },
        "ppp chap user [parameter1]": {
            "template": "ppp chap user [parameter1]",
            "command": "ppp chap user rta",
            "explanation": "The username for the configuration of PPP CHAP is 'rta'",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                }
            ]
        },
        "ppp chap password cipher [parameter1]": {
            "template": "ppp chap password cipher [parameter1]",
            "command": "ppp chap password cipher @%@%EDF~DAdfFD934J3<DAF#*<!@%@%",
            "explanation": "Configure encryption password for PPCAP",
            "parameters": [
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "Encryption password"
                }
            ]
        },
        "pppoe-client dial-bundle-number [parameter1]": {
            "template": "pppoe-client dial-bundle-number [parameter1]",
            "command": "pppoe-client dial-bundle-number 1",
            "explanation": "Configure dial-up package number 1 for PPPE client",
            "parameters": [
                {
                    "name": "bundle number",
                    "type": "integer",
                    "explanation": "Dial Package Number"
                }
            ]
        }
    },
    "aaa": {
        "template": "aaa",
        "command": "aaa",
        "explanation": "Enter AAA Configuration Mode",
        "local-user [parameter1] password cipher [parameter2]": {
            "template": "local-user [parameter1] password cipher [parameter2]",
            "command": "local-user rtb password cipher @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
            "explanation": "Configure encryption password for local user'rtb '",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                },
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "Encryption password"
                }
            ]
        },
        "local-user [parameter1] service-type [parameter2]": {
            "template": "local-user [parameter1] service-type [parameter2]",
            "command": "local-user rtb service-type ppp",
            "explanation": "Configure local user 'rtb 'service type as PPP",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                },
                {
                    "name": "service type",
                    "type": "string",
                    "explanation": "Type of service"
                }
            ]
        },
        "authentication-scheme [parameter1]": {
            "template": "authentication-scheme [parameter1]",
            "command": "authentication-scheme default1",
            "explanation": "Enter authentication program configuration mode, name 'default1'",
            "parameters": [
                {
                    "name": "scheme name",
                    "type": "string",
                    "explanation": "Name of the authentication programme"
                }
            ]
        }
    },
    "ip pool [parameter1]": {
        "template": "ip pool [parameter1]",
        "command": "ip pool pool1",
        "explanation": "Create or enter IP Address Pool Configuration Mode with the name `pool1'",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "Address Pool Name"
            }
        ],
        "gateway [parameter1]": {
            "template": "gateway [parameter1]",
            "command": "gateway 10.110.0.1",
            "explanation": "The default gateway to configure the address pool is 10.110.0.1",
            "parameters": [
                {
                    "name": "gateway address",
                    "type": "IPv4",
                    "explanation": "Gateway Address"
                }
            ]
        },
        "network [parameter1] mask [parameter2]": {
            "template": "network [parameter1] mask [parameter2]",
            "command": "network 10.110.0.0 mask 255.255.255.0",
            "explanation": "Configure address and subnet mask for address pool",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "section [parameter1] [parameter2]": {
            "template": "section [parameter1] [parameter2]",
            "command": "section 10.110.0.2 10.110.0.254",
            "explanation": "Configure IP sections of the address pool, from 10.110.0.2 to 10.110.0.254",
            "parameters": [
                {
                    "name": "start address",
                    "type": "IPv4",
                    "explanation": "Start Address"
                },
                {
                    "name": "end address",
                    "type": "IPv4",
                    "explanation": "End Address"
                }
            ]
        }
    },
    "dialer-rule": {
        "template": "dialer-rule",
        "command": "dialer-rule",
        "explanation": "Enter dial-up rule configuration mode",
        "dialer-rule [parameter1] ip permit": {
            "template": "dialer-rule [parameter1] ip permit",
            "command": "dialer-rule 1 ip permit",
            "explanation": "Configure dial-up rule 1, allow IP traffic",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "Rule number"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the next level"
    }
}