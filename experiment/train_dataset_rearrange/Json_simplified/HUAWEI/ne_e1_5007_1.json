            "parameters": [
                {
                    "name": "clock source",
                    "type": "string",
                    "explanation": "Clock source, this is Internal."
                }
            ]
        },
        "line-impedance [parameter1]": {
            "template": "line-impedance [parameter1]",
            "command": "line-impedance 75-ohm",
            "explanation": "Set up a line to block 75 om.",
            "parameters": [
                {
                    "name": "impedance value",
                    "type": "string",
                    "explanation": "Line resistance, 75-ohm."
                }
            ]
        },
        "cable-length [parameter1] [parameter2]": {
            "template": "cable-length [parameter1] [parameter2]",
            "command": "cable-length long 0db",
