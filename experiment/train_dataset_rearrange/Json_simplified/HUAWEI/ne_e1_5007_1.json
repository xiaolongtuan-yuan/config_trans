        "parameters": [
            {
                "name": "controller type",
                "type": "string",
                "explanation": "Control type, this is E1."
            },
            {
                "name": "controller slot",
                "type": "string",
                "explanation": "Control tank, this is 2/0/0."
            }
        ],
        "framing [parameter1]": {
            "template": "framing [parameter1]",
            "command": "framing CRC4",
            "explanation": "Set frame check sequence to CRC4",
            "parameters": [
                {
                    "name": "framing type",
                    "type": "string",
                    "explanation": "Frame check sequence type. This is CRC4."
                }
            ]
        },
