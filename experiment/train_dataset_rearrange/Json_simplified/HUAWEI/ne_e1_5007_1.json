            "parameters": [
                {
                    "name": "cable length type",
                    "type": "string",
                    "explanation": "Cable length type. This is long."
                },
                {
                    "name": "attenuation",
                    "type": "string",
                    "explanation": "Decomposition, zero db."
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial2/0/0:0",
        "explanation": "Configure Serial2/0/0:0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface name."
            }
        ],
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set a link protocol to PPP",
            "parameters": [
                {
                    "name": "protocol name",
                    "type": "string",
                    "explanation": "Chain protocol name. This is ppp."
                }
            ]
        },
