{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 3001",
        "explanation": "Create or enter configuration mode for ACL number 3001",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "Access control list number"
            }
        ],
        "rule [parameter1] permit ip source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit ip source [parameter2] [parameter3]",
            "command": "rule 5 permit ip source 10.100.0.11 0.0.0.255",
            "explanation": "Add a rule to the ACL to allow IP traffic with source address of 10.100.0.11/24",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "Rule number"
                },
                {
                    "name": "source ip",
                    "type": "IPv4",
                    "explanation": "Source IP Address"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Tunnel30",
        "explanation": "Configure mode for accessing the Tunnel 30 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "policy-based-route [parameter1] permit node [parameter2] map-instance [parameter3]": {
            "template": "policy-based-route [parameter1] permit node [parameter2] map-instance [parameter3]",
            "command": "policy-based-route aaa permit node 5 map-instance 5",
            "explanation": "Create a strategic route named aaa, node 5, map example 5",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "Policy Name"
                },
                {
                    "name": "node number",
                    "type": "integer",
                    "explanation": "Node Number"
                },
                {
                    "name": "map instance",
                    "type": "integer",
                    "explanation": "Map instance number"
                }
            ],
            "if-match acl name [parameter1]": {
                "template": "if-match acl name [parameter1]",
                "command": "if-match acl name a3001",
                "explanation": "Matching ACL to a3001 traffic",
                "parameters": [
                    {
                        "name": "acl name",
                        "type": "string",
                        "explanation": "ACL Name"
                    }
                ]
            },
            "apply output-interface [parameter1]": {
                "template": "apply output-interface [parameter1]",
                "command": "apply output-interface Tunnel30",
                "explanation": "Apply output interface as Tunnel30",
                "parameters": [
                    {
                        "name": "output interface",
                        "type": "string",
                        "explanation": "Output interface name"
                    }
                ]
            }
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.100.0.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.100.0.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip policy-based-route [parameter1]": {
            "template": "ip policy-based-route [parameter1]",
            "command": "ip policy-based-route aaa",
            "explanation": "Apply policy routeaaa to interface",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "Policy Name"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit Current Configuration Mode"
    }
