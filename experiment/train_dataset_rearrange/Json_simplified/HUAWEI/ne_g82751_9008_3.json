{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device2",
        "explanation": "Sets the device's hostname 'Device2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "Enable PTP on interface"
    },
    "ptp profile [parameter1] enable": {
        "template": "ptp profile [parameter1] enable",
        "command": "ptp profile g-8275-1 enable",
        "explanation": "Enable specified PTP profile",
        "parameters": [
            {
                "name": "profile name",
                "type": "string",
                "explanation": "PTP profile name"
            }
        ]
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type t-bc",
        "explanation": "Sets the PTP device type as a transparent clock border clock",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "PTP Device Type"
            }
        ]
    },
    "ptp passive-measure enable": {
        "template": "ptp passive-measure enable",
        "command": "ptp passive-measure enable",
        "explanation": "Enable passive measurement"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode for entering specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 10",
            "explanation": "Set clock priority",
            "parameters": [
                {
                    "name": "priority level",
                    "type": "integer",
                    "explanation": "Clock Priority Level"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit Current Configuration Mode"
    }
}