{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ntp-service clock-period [parameter1]": {
        "template": "ntp-service clock-period [parameter1]",
        "command": "ntp-service clock-period 3600",
        "explanation": "Set an interface with a clock cycle of 3600 ms",
        "parameters": [
            {
                "name": "clock period",
                "type": "integer",
                "explanation": "Clock cycle value in milliseconds"
            }
        ]
    },
    "ntp-service server [parameter1]": {
        "template": "ntp-service server [parameter1]",
        "command": "ntp-service server 10.0.0.1",
        "explanation": "Configure NTP server address 10.0.0.1",
        "parameters": [
            {
                "name": "server address",
                "type": "IPv4",
                "explanation": "IP address of NTP server"
            }
        ]
    },
    "clock timezone [parameter1] offset [parameter2]": {
        "template": "clock timezone [parameter1] offset [parameter2]",
        "command": "clock timezone PST offset -8",
        "explanation": "Set the time zone to PST, offset to 8 hours",
        "parameters": [
            {
                "name": "timezone name",
                "type": "string",
                "explanation": "Timezone Name"
            },
            {
                "name": "offset",
                "type": "integer",
                "explanation": "Time zone offset in hours"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ntp-service clock-period [parameter1]": {
            "template": "ntp-service clock-period [parameter1]",
            "command": "ntp-service clock-period 3600",
            "explanation": "Set an interface with a clock cycle of 3600 ms",
            "parameters": [
                {
                    "name": "clock period",
                    "type": "integer",
                    "explanation": "Clock cycle value in milliseconds"
                }
            ]
        },
        "ntp-service server [parameter1] prefer": {
            "template": "ntp-service server [parameter1] prefer",
            "command": "ntp-service server 10.0.0.1 prefer",
            "explanation": "Configure preferred NTP server addresses 10.0.0.1",
            "parameters": [
                {
                    "name": "server address",
                    "type": "IPv4",
                    "explanation": "IP address of the preferred NTP server"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 1",
            "explanation": "Set clock priority to 1",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "Clock Priority"
                }
            ]
        }
    }
}