{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname PE",
        "explanation": "Sets the device 's hostname 'PE '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1] to [parameter2]": {
        "template": "vlan batch [parameter1] to [parameter2]",
        "command": "vlan batch 2 to 4",
        "explanation": "Batch creation of VLAN 2 to 4",
        "parameters": [
            {
                "name": "start vlan id",
                "type": "integer",
                "explanation": "Start VLAN ID"
            },
            {
                "name": "end vlan id",
                "type": "integer",
                "explanation": "End VLAN ID"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 4",
        "explanation": "Configure mode for VLAN 4",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "access-vlan [parameter1] to [parameter2]": {
            "template": "access-vlan [parameter1] to [parameter2]",
            "command": "access-vlan 2 to 3",
            "explanation": "Set VLAN 4 members to 2-3",
            "parameters": [
                {
                    "name": "start access vlan id",
                    "type": "integer",
                    "explanation": "Initial Member VLAN ID"
                },
                {
                    "name": "end access vlan id",
                    "type": "integer",
                    "explanation": "End member VLAN ID"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlanif4",
        "explanation": "Configure mode to VLAN interface 4",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.12 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.12 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "Set interface to allow VLAN 2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Allow pass VLAN ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Returns the previous configuration mode"
    }
}