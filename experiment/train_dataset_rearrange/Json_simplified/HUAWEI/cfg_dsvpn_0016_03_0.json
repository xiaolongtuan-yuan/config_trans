{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Hub",
        "explanation": "Sets the device 's hostname 'Hub '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "tunnel-protocol [parameter1] [parameter2]": {
            "template": "tunnel-protocol [parameter1] [parameter2]",
            "command": "tunnel-protocol gre p2mp",
            "explanation": "The protocol for setting up the tunnel is GRE.",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "Tunnel protocol type"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Tunnel Mode"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Specify the source interface of the tunnel as GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface Name"
                }
            ]
        }
    },
    "bgp [parameter1]": {
        "template": "bgp [parameter1]",
        "command": "bgp 100",
        "explanation": "Enable BGP process, AS 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomy system number"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "Router-id for BGP is 172.16.1.1",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "peer [parameter1] as-number [parameter2]": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 172.16.1.2 as-number 200",
            "explanation": "Configure BGP equivalent 172.16.1.2, AS 200",
            "parameters": [
                {
                    "name": "peer address",
                    "type": "IPv4",
                    "explanation": "Peer Address"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.1",
        "explanation": "Enable OSF process 1 and set Router-id to 172.16.1.1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            },
            {
                "name": "router-id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure OSPF area 0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 192.168.0.0 0.0.0.255",
                "explanation": "Add the network 192.168.0.0/24 to the OSPF area",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Countermask"
                    }
                ]
            }
        }
    }
}