{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "Set the data hostname to 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Hostname of the data"
            }
        ]
    },
    "vlan batch [parameter1] [parameter2]": {
        "template": "vlan batch [parameter1] [parameter2]",
        "command": "vlan batch 10 30",
        "explanation": "Create VLANs 10 and 30 in watch",
        "parameters": [
            {
                "name": "vlan id1",
                "type": "integer",
                "explanation": "VLAN ID 1"
            },
            {
                "name": "vlan id2",
                "type": "integer",
                "explanation": "VLAN ID 2"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Enter configuration mode for GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Name of the interface"
            }
        ],
        "port link-type [parameter1]": {
            "template": "port link-type [parameter1]",
            "command": "port link-type access",
            "explanation": "Set the interface link type to access",
            "parameters": [
                {
                    "name": "link type",
                    "type": "string",
                    "explanation": "Type of link, such as access or turn"
                }
            ]
        },
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 30",
            "explanation": "Set the default VLAN for the interface to 30",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "port trunk allow-pass vlan [parameter1] [parameter2]": {
            "template": "port trunk allow-pass vlan [parameter1] [parameter2]",
            "command": "port trunk allow-pass vlan 10 30",
            "explanation": "Allow VLANs 10 and 30 to pass through the trunk interface",
            "parameters": [
                {
                    "name": "vlan id1",
                    "type": "integer",
                    "explanation": "VLAN ID 1"
                },
                {
                    "name": "vlan id2",
                    "type": "integer",
                    "explanation": "VLAN ID 2"
                }
            ]
        }
    }
}