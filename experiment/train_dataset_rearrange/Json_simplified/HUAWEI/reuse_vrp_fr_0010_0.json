{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "Configure the specified interface, this is POS 1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "interface [parameter1] p2p": {
        "template": "interface [parameter1] p2p",
        "command": "interface Pos1/0/0.1 p2p",
        "explanation": "Configure point-to-point interface POS1/0/0.1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Sub-interface name"
            },
            {
                "name": "subinterface type",
                "type": "string",
                "explanation": "Sub-interface type, here is point-to-point (p2p)"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "fr dlci [parameter1]": {
            "template": "fr dlci [parameter1]",
            "command": "fr dlci 100",
            "explanation": "Configure frame relaying DLCI (Data Link Connection Identifier) to 100",
            "parameters": [
                {
                    "name": "dlci",
                    "type": "integer",
                    "explanation": "DLCI Value"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the first or the main mode"
    }
}