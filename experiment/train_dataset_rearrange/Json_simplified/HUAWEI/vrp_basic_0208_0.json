{
    "system-view": {
        "template": "system-view",
        "command": "system-view",
        "explanation": "Enter System View"
    },
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname SSH_Server",
        "explanation": "Sets the device 's hostname 'SSH_Server '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "Enter the configuration view of the interface GigabitEthernet0/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ssh server-source -i [parameter1]": {
            "template": "ssh server-source -i [parameter1]",
            "command": "ssh server-source -i GigabitEthernet0/0/0",
            "explanation": "Set the source interface of the SSH server to GigabitEthernet0/0/0",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "Interface Name"
                }
            ]
        }
    },
    "rsa local-key-pair create": {
        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "Create RSA local key pair",
        "[parameter1]": {
            "template": "[parameter1]",
            "command": "2048",
            "explanation": "Specify key length at 2048",
            "parameters": [
                {
                    "name": "key length",
                    "type": "integer",
                    "explanation": "Key Length"
                }
            ]
        }
    },
    "aaa": {
        "template": "aaa",
        "command": "aaa",
        "explanation": "Enter AAA Configuration View",
        "local-user [parameter1] password irreversible-cipher [parameter2]": {
            "template": "local-user [parameter1] password irreversible-cipher [parameter2]",
            "command": "local-user client001 password irreversible-cipher @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
            "explanation": "Configure local user client001 passwords as irreversible encryption@@@%UyQs4, KTtSwjo (4QmW#K, LC:@%@%",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Password"
                }
            ]
        },
        "local-user [parameter1] privilege level [parameter2]": {
            "template": "local-user [parameter1] privilege level [parameter2]",
            "command": "local-user client001 privilege level 3",
            "explanation": "Set permission level 3 for local user cent001",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                },
                {
                    "name": "privilege level",
                    "type": "integer",
                    "explanation": "Permission Level"
                }
            ]
        },
        "local-user [parameter1] service-type [parameter2]": {
            "template": "local-user [parameter1] service-type [parameter2]",
            "command": "local-user client001 service-type ssh",
            "explanation": "Sets the service type of local user clit001 to SSH",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username"
                },
                {
                    "name": "service type",
                    "type": "string",
                    "explanation": "Type of service"
                }
            ]
        }
    },
    "stelnet server enable": {
        "template": "stelnet server enable",
        "command": "stelnet server enable",
        "explanation": "Enable Stellnet server functionality"
    },
    "ssh user [parameter1] authentication-type [parameter2]": {
        "template": "ssh user [parameter1] authentication-type [parameter2]",
        "command": "ssh user client001 authentication-type password",
        "explanation": "Sets the authentication type of SSH usercent001 as password authentication",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            },
            {
                "name": "authentication type",
                "type": "string",
                "explanation": "Type of authentication"
            }
        ]
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "Enter VTY user interface view, configure VTY0 to VTY4",
        "parameters": [
            {
                "name": "start vty number",
                "type": "integer",
                "explanation": "Start VTY Number"
            },
            {
                "name": "end vty number",
                "type": "integer",
                "explanation": "End VTY Number"
            }
        ],
        "authentication-mode [parameter1]": {
            "template": "authentication-mode [parameter1]",
            "command": "authentication-mode aaa",
            "explanation": "Set authentication mode to AAA",
            "parameters": [
                {
                    "name": "authentication mode",
                    "type": "string",
                    "explanation": "Authentication mode"
                }
            ]
        },
        "protocol inbound [parameter1]": {
            "template": "protocol inbound [parameter1]",
            "command": "protocol inbound ssh",
            "explanation": "Set entry protocol to SSH",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Agreements"
                }
            ]
        },
        "user privilege level [parameter1]": {
            "template": "user privilege level [parameter1]",
            "command": "user privilege level 3",
            "explanation": "Set user permission level to 3",
            "parameters": [
                {
                    "name": "privilege level",
                    "type": "integer",
                    "explanation": "Permission Level"
                }
            ]
        }
    }
}