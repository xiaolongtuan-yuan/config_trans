{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname P2",
        "explanation": "Sets the device 's hostname 'P2 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "acl number [parameter1]": {
        "template": "acl number [parameter1]",
        "command": "acl number 2000",
        "explanation": "Create or enter configuration mode for ACL number 2000",
        "parameters": [
            {
                "name": "acl number",
                "type": "integer",
                "explanation": "Access control list number"
            }
        ],
        "rule [parameter1] permit source [parameter2] [parameter3]": {
            "template": "rule [parameter1] permit source [parameter2] [parameter3]",
            "command": "rule 5 permit source 1.1.1.1 0",
            "explanation": "Add a rule to the ACL that allows flow at source address 1.1.1.1",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
                    "explanation": "Rule number"
                },
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "Source IP Address"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/1",
        "explanation": "Configuration mode for entering the GigabitEthernet1/0/1 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 2.1.1.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "user-interface vty [parameter1] [parameter2]": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "Enter VTY user interface configuration mode from 0 to 4",
        "parameters": [
            {
                "name": "start vty line",
                "type": "integer",
                "explanation": "Start VTY Line Number"
            },
            {
                "name": "end vty line",
                "type": "integer",
                "explanation": "End VTY Line Number"
            }
        ],
        "authentication-mode [parameter1]": {
            "template": "authentication-mode [parameter1]",
            "command": "authentication-mode password",
            "explanation": "Set authentication mode to password authentication",
            "parameters": [
                {
                    "name": "authentication mode",
                    "type": "string",
                    "explanation": "Type of authentication mode"
                }
            ]
        },
        "set authentication password cipher [parameter1]": {
            "template": "set authentication password cipher [parameter1]",
            "command": "set authentication password cipher @%@%(t7h+Qu=a#pz`3Kylk1/,JXR%iy(DA!x8&+!|#b&.dEW65~.lEqGm~Np$O#2M]xJM@%@%",
            "explanation": "Set authentication password as encryption",
            "parameters": [
                {
                    "name": "encrypted password",
                    "type": "string",
                    "explanation": "Encrypted Password String"
                }
            ]
        },
        "acl [parameter1] inbound": {
            "template": "acl [parameter1] inbound",
            "command": "acl 2000 inbound",
            "explanation": "Apply ACL 2000 to VTY interface entry orientation",
            "parameters": [
                {
                    "name": "acl number",
                    "type": "integer",
                    "explanation": "Access control list number"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "Direction, entry or exit"
                }
            ]
        }
    }
