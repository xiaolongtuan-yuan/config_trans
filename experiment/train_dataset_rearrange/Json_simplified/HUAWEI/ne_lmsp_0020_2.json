{
    "sysname [hostname]": {
        "template": "sysname [hostname]",
        "command": "sysname P",
        "explanation": "Set the device 's system name is 'P '",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Hostname of device"
            }
        ]
    },
    "mpls lsr-id [ip-address]": {
        "template": "mpls lsr-id [ip-address]",
        "command": "mpls lsr-id 192.168.1.4",
        "explanation": "Sets the MPLS LSR ID for 192.168.1.4",
        "parameters": [
            {
                "name": "ip-address",
                "type": "IPv4",
                "explanation": "IP address of LSR"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "Enable MPLS on interface"
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "Enable MPLS LDP on interface"
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Name of interface"
            }
        ],
        "ip address [ip-address] [subnet-mask]": {
            "template": "ip address [ip-address] [subnet-mask]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IPv4 address for interface"
                },
                {
                    "name": "subnet-mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ospf [process-id]": {
        "template": "ospf [process-id]",
        "command": "ospf 1",
        "explanation": "Enter OSPF process configuration mode, process ID 1",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSS process ID"
            }
        ],
        "area [area-id]": {
            "template": "area [area-id]",
            "command": "area 0.0.0.0",
            "explanation": "Definition of OSPF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area-id",
                    "type": "IPv4",
                    "explanation": "OSPF Area ID"
                }
            ],
            "network [ip-address] [wildcard-mask]": {
                "template": "network [ip-address] [wildcard-mask]",
                "command": "network 192.168.1.4 0.0.0.0",
                "explanation": "Add loop back interface to OSF area",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "IPv4",
                        "explanation": "IP address of the network"
                    },
                    {
                        "name": "wildcard-mask",
                        "type": "IPv4",
                        "explanation": "Countermask"
                    }
                ]
            }
        }
    }
}