{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname P",
        "explanation": "Sets the device 's hostname 'P '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 2.2.2.9",
        "explanation": "Set MPLS LSR to 2.2.2.9",
        "parameters": [
            {
                "name": "lsr-id",
                "type": "IPv4",
                "explanation": "LSR Identification"
            }
        ]
    },
    "mpls": {
        "template": "mpls",
        "command": "mpls",
        "explanation": "Enable MPLS on interface"
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "Enable MPLS LDP on interface"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "ospf [parameter1]": {
        "template": "ospf [parameter1]",
        "command": "ospf 1",
        "explanation": "Configuration mode for accessing OSF process 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure OSPF area 0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 10.1.1.0 0.0.0.255",
                "explanation": "Add the network 10.1.1.0/24 to the OSPF area",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Countermask"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Exit Current Configuration Mode"
    }
}