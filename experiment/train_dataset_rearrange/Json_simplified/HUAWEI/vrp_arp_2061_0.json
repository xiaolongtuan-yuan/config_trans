{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "arp static [parameter1] [parameter2]": {
        "template": "arp static [parameter1] [parameter2]",
        "command": "arp static 10.1.1.1 00e0-fc41-0200",
        "explanation": "Configure static ARP entries, map IP address 10.1.1.1 to MAC address 00e0-fc41-0200",
        "parameters": [
            {
                "name": "ip address",
                "type": "IPv4",
                "explanation": "IP address for static ARP entry"
            },
            {
                "name": "mac address",
                "type": "MAC",
                "explanation": "Corresponding MAC Address"
            }
        ]
    }
}