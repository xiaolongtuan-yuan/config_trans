            }
        ]
    },
    "ip dhcp snooping rate-limit unicast threshold [parameter1] burst [parameter2]": {
        "template": "ip dhcp snooping rate-limit unicast threshold [parameter1] burst [parameter2]",
        "command": "ip dhcp snooping rate-limit unicast threshold 100 burst 10",
        "explanation": "Sets the DHCP Snooping data package speed limit with a threshold of 100 and a flash of 10",
        "parameters": [
            {
                "name": "threshold",
                "type": "integer",
                "explanation": "Threshold of the speed limit for a radio package"
            },
            {
                "name": "burst",
                "type": "integer",
                "explanation": "Number of sudden-onset packages allowed"
            }
        ]
    }
