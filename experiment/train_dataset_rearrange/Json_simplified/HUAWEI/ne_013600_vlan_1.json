    "ip pool [parameter1] bas local": {
        "template": "ip pool [parameter1] bas local",
        "command": "ip pool pool1 bas local",
        "explanation": "Create and access the IP address pool 'pool1' for distribution of local addresses for broadband access servers (BAS)",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "Name of IP Address Pool"
            }
        ],
        "gateway [parameter1] [parameter2]": {
            "template": "gateway [parameter1] [parameter2]",
            "command": "gateway 172.30.0.1 255.255.255.0",
            "explanation": "Set gateway address and subnet mask for address pool",
            "parameters": [
                {
                    "name": "gateway address",
                    "type": "IPv4",
                    "explanation": "Gateway IPv4 address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "section [parameter1] [parameter2] [parameter3]": {
            "template": "section [parameter1] [parameter2] [parameter3]",
            "command": "section 0 172.30.0.2 172.30.0.200",
            "explanation": "Define distribution segments of the address pool, from 172.0.0.2 to 172.0.0.200",
            "parameters": [
                {
                    "name": "section id",
                    "type": "integer",
                    "explanation": "Number of the assigned paragraph"
                },
                {
                    "name": "start address",
                    "type": "IPv4",
                    "explanation": "Start IP Address"
                },
                {
                    "name": "end address",
                    "type": "IPv4",
                    "explanation": "End IP Address"
                }
            ]
        },
        "excluded-ip-address [parameter1]": {
            "template": "excluded-ip-address [parameter1]",
            "command": "excluded-ip-address 172.30.0.8",
            "explanation": "Exclude specific IP address in address pool 172.3.0.0.8 without distribution",
            "parameters": [
                {
                    "name": "excluded ip address",
                    "type": "IPv4",
                    "explanation": "IP address to exclude"
                }
            ]
        }
    },
