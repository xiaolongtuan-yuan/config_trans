    "radius-server shared-key cipher [parameter1]": {
        "template": "radius-server shared-key cipher [parameter1]",
        "command": "radius-server shared-key cipher <password>",
        "explanation": "Configure shared keys for RADIUS servers to encrypt communications",
        "parameters": [
            {
                "name": "shared key",
                "type": "string",
                "explanation": "Share key in secret"
            }
        ]
    },
    "radius-server [parameter1] auth-port [parameter2] acct-port [parameter3]": {
        "template": "radius-server [parameter1] auth-port [parameter2] acct-port [parameter3]",
        "command": "radius-server 172.30.0.8 auth-port 1812 acct-port 1813",
        "explanation": "Configure IP addresses, authentication ports and billing ports for RADIUS servers",
        "parameters": [
            {
                "name": "server ip address",
                "type": "IPv4",
                "explanation": "IPv4 address of RADIUS server"
            },
            {
                "name": "authentication port",
                "type": "integer",
                "explanation": "Authentication port number, usually 1812"
            },
            {
                "name": "accounting port",
                "type": "integer",
                "explanation": "Fee port number, usually 1813."
            }
        ]
    },
