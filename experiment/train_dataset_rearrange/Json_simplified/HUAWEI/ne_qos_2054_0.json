{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "diffserv domain [parameter1]": {
        "template": "diffserv domain [parameter1]",
        "command": "diffserv domain default",
        "explanation": "Configure differential service fields as default",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "Name of the differential service field"
            }
        ],
        "8021p-inbound [parameter1] phb [parameter2] [parameter3]": {
            "template": "8021p-inbound [parameter1] phb [parameter2] [parameter3]",
            "command": "8021p-inbound 2 phb ef green",
            "explanation": "Configure 802.1p Priority 2 map to PHB EF, colour marked green",
            "parameters": [
                {
                    "name": "802.1p priority",
                    "type": "integer",
                    "explanation": "802.1p priority value"
                },
                {
                    "name": "PHB",
                    "type": "string",
                    "explanation": "Type of service quality"
                },
                {
                    "name": "color mark",
                    "type": "string",
                    "explanation": "Colour Tags (Green, Yellow, Red)"
                }
            ]
        },
        "ip-dscp-outbound [parameter1] [parameter2] map [parameter3]": {
            "template": "ip-dscp-outbound [parameter1] [parameter2] map [parameter3]",
            "command": "ip-dscp-outbound ef green map 34",
            "explanation": "Configure exit IP DSCP values to EF, colour to green, map to 34",
            "parameters": [
                {
                    "name": "PHB",
                    "type": "string",
                    "explanation": "Type of service quality"
                },
                {
                    "name": "color mark",
                    "type": "string",
                    "explanation": "Colour Tags (Green, Yellow, Red)"
                },
                {
                    "name": "mapped value",
                    "type": "integer",
                    "explanation": "Map DSCP value"
                }
            ]
        }
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Create or enter configuration mode for VLAN 10",
        "parameters": [
            {
                "name": "VLAN ID",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet 1/0/0",
        "explanation": "Configure mode to enter GigabitEthernet 1/0/0 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Name of interface"
            }
        ],
        "port trunk allow-pass vlan [parameter1]": {
            "template": "port trunk allow-pass vlan [parameter1]",
            "command": "port trunk allow-pass vlan 10",
            "explanation": "Allow VLAN 10 to trunk port",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "Allowed VLAN identification number"
                }
            ]
        },
        "trust upstream default vlan [parameter1]": {
            "template": "trust upstream default vlan [parameter1]",
            "command": "trust upstream default vlan 10",
            "explanation": "Configure Upstream Trust Default VLAN 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "Default VLAN identification number"
                }
            ]
        },
        "trust 8021p vlan [parameter1]": {
            "template": "trust 8021p vlan [parameter1]",
            "command": "trust 8021p vlan 10",
            "explanation": "Configure 802.1p priority for trust VLAN 10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the next level"
    }
}