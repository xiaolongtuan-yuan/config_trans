{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Device",
        "explanation": "Sets the device 's hostname 'Device '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 10",
        "explanation": "Batch to create VLAN, here to create VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Enter VLAN 10 configuration mode",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "suppression inbound enable": {
        "template": "suppression inbound enable",
        "command": "suppression inbound enable",
        "explanation": "Enable inhibition, possibly to inhibit certain types of traffic"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure mode for entering specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "port default vlan [parameter1]": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 10",
            "explanation": "Set the default VLAN for interface to 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        },
        "broadcast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]": {
            "template": "broadcast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]",
            "command": "broadcast-suppression cir 38400 cbs 7200000 inbound vlan 10",
            "explanation": "Configure the containment of the broadcast traffic, setting the promised information rate (CIR) at 38,400, the promised sudden size (CBS) at 7200000, and the incoming traffic for VLAN 10",
            "parameters": [
                {
                    "name": "cir",
                    "type": "integer",
                    "explanation": "Commitment information rate"
                },
                {
                    "name": "cbs",
                    "type": "integer",
                    "explanation": "Promised surprise size."
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        },
        "multicast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]": {
            "template": "multicast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]",
            "command": "multicast-suppression cir 38400 cbs 7200000 inbound vlan 10",
            "explanation": "Configure the containment of group flow, setting the promised information rate (CIR) at 38,400, the promised sudden size (CBS) at 7200000, for VLAN 10",
            "parameters": [
                {
                    "name": "cir",
                    "type": "integer",
                    "explanation": "Commitment information rate"
                },
                {
                    "name": "cbs",
                    "type": "integer",
                    "explanation": "Promised surprise size."
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        },
        "unknown-unicast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]": {
            "template": "unknown-unicast-suppression cir [parameter1] cbs [parameter2] inbound vlan [parameter3]",
            "command": "unknown-unicast-suppression cir 38400 cbs 7200000 inbound vlan 10",
            "explanation": "Configure the inhibition of the unknown stream, setting the promised information rate (CIR) at 38,400, the promised sudden size (CBS) at 7200000, and the incoming traffic for VLAN 10",
            "parameters": [
                {
                    "name": "cir",
                    "type": "integer",
                    "explanation": "Commitment information rate"
                },
                {
                    "name": "cbs",
                    "type": "integer",
                    "explanation": "Promised surprise size."
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode, returns the previous one"
    }
