{
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface Loopback0",
        "explanation": "Configure Loopback0 interface",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [ip-address] [mask]": {
            "template": "ip address [ip-address] [mask]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "Configure interface IP address and subnet mask",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IP address for interface"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ptp-adaptive device-type [type]": {
            "template": "ptp-adaptive device-type [type]",
            "command": "ptp-adaptive device-type client",
            "explanation": "Set device type as client",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Device type, e.g., client"
                }
            ]
        },
        "ptp-adaptive local-ip [ip-address]": {
            "template": "ptp-adaptive local-ip [ip-address]",
            "command": "ptp-adaptive local-ip 2.2.2.2",
            "explanation": "Set Local IP Address",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "Chile"
                }
            ]
        },
        "ptp-adaptive remote-server1-ip [ip-address]": {
            "template": "ptp-adaptive remote-server1-ip [ip-address]",
            "command": "ptp-adaptive remote-server1-ip 1.1.1.1",
            "explanation": "Configure IP addresses for remote server 1",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IP address for remote server 1"
                }
            ]
        },
        "ptp-adaptive dscp [value]": {
            "template": "ptp-adaptive dscp [value]",
            "command": "ptp-adaptive dscp 60",
            "explanation": "Set DSCP values",
            "parameters": [
                {
                    "name": "value",
                    "type": "integer",
                    "explanation": "DSCP value"
                }
            ]
        },
        "ptp device-type [type]": {
            "template": "ptp device-type [type]",
            "command": "ptp device-type bc",
            "explanation": "Set PTP Device Type as Border Clock",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Device type, e.g. bc (border clock)"
                }
            ]
        },
        "clock source ptp priority [value]": {
            "template": "clock source ptp priority [value]",
            "command": "clock source ptp priority 5",
            "explanation": "Set PTP Priority",
            "parameters": [
                {
                    "name": "value",
                    "type": "integer",
                    "explanation": "Priority value"
                }
            ]
        }
    }
}