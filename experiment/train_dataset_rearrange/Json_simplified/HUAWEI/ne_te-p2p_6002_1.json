                {
                    "name": "level",
                    "type": "string",
                    "explanation": "Level of ISIS"
                }
            ]
        },
        "network-entity [parameter1]": {
            "template": "network-entity [parameter1]",
            "command": "network-entity 00.0005.0000.0000.0002.00",
