            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "mpls te bandwidth max-reservable-bandwidth [parameter1]": {
            "template": "mpls te bandwidth max-reservable-bandwidth [parameter1]",
            "command": "mpls te bandwidth max-reservable-bandwidth 100000",
            "explanation": "Sets the maximum reserved bandwidth for MPLS TE on the interface to 100,000",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "Maximum preset bandwidth value"
                }
            ]
        },
        "mpls te bandwidth bc0 [parameter1]": {
            "template": "mpls te bandwidth bc0 [parameter1]",
            "command": "mpls te bandwidth bc0 100000",
            "explanation": "Set the BC0 bandwidth of MPLS TE on the interface to 100,000",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "BC0 bandwidth value"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
