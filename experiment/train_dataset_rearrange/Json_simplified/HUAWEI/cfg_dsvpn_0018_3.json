{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "Set the device 's hostname is 'Spoke2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "nhrp enable": {
        "template": "nhrp enable",
        "command": "nhrp enable",
        "explanation": "Enable NHRP (Next Hope Regulation)"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure gigabitEthernet1/0/0 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.3.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "source [parameter1]": {
            "template": "source [parameter1]",
            "command": "source GigabitEthernet1/0/0",
            "explanation": "Specify the source interface of the tunnel as GigabitEthernet1/0/0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface Name"
                }
            ]
        },
        "destination [parameter1]": {
            "template": "destination [parameter1]",
            "command": "destination [IP address of the spoke2 hub]",
            "explanation": "Specify the target address of the tunnel as the IP address of spoke2hub",
            "parameters": [
                {
                    "name": "destination IP address",
                    "type": "IPv4",
                    "explanation": "Destination IP Address"
                }
            ]
        },
        "ipsec profile [parameter1]": {
            "template": "ipsec profile [parameter1]",
            "command": "ipsec profile [IPsec profile name]",
            "explanation": "Apply IPsec profile",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "IPsec profile name"
                }
            ]
        }
    },
    "ospf [parameter1] router-id [parameter2]": {
        "template": "ospf [parameter1] router-id [parameter2]",
        "command": "ospf 1 router-id 172.16.1.3",
        "explanation": "Configure OSPF process 1, setting Router ID to 172.16.1.3",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            },
            {
                "name": "router-id",
                "type": "IPv4",
                "explanation": "Router ID"
            }
        ],
        "area [parameter1]": {
            "template": "area [parameter1]",
            "command": "area 0.0.0.0",
            "explanation": "Configure OSPF area 0.0.0.0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ],
            "network [parameter1] [parameter2]": {
                "template": "network [parameter1] [parameter2]",
                "command": "network 172.16.1.0 0.0.0.255",
                "explanation": "Add network 172.16.1.0/24 to the OSPF area",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Countermask"
                    }
                ]
            },
            "nexthop [parameter1] weight [parameter2]": {
                "template": "nexthop [parameter1] weight [parameter2]",
                "command": "nexthop [IP address of the spoke2 hub] weight 1",
                "explanation": "Configure next jump address and weight",
                "parameters": [
                    {
                        "name": "next hop IP address",
                        "type": "IPv4",
                        "explanation": "Next Jump IP Address"
                    },
                    {
                        "name": "weight",
                        "type": "integer",
                        "explanation": "Weight Value"
                    }
                ]
            }
        }
    }
}