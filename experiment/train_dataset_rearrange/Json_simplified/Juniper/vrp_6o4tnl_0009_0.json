{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.50.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "description [parameter3]": {
                "template": "description [parameter3]",
                "command": "description \"Tunnel10\"",
                "explanation": "Configure the description of the interface.",
                "parameters": [
                    {
                        "name": "description",
                        "type": "string",
                        "explanation": "Description of the interface."
                    }
                ]
            },
            "encapsulation [parameter3]": {
                "template": "encapsulation [parameter3]",
                "command": "encapsulation gre",
                "explanation": "Configure the envelope type of the interface.",
                "parameters": [
                    {
                        "name": "encapsulation",
                        "type": "string",
                        "explanation": "Cover type, e.g., pp."
                    }
                ]
            },
            "tunnel source [parameter3]": {
                "template": "tunnel source [parameter3]",
                "command": "tunnel source ge-1/0/0",
                "explanation": "Configure tunnel source interfaces.",
                "parameters": [
                    {
                        "name": "source-interface",
                        "type": "string",
                        "explanation": "Name of tunnel source interface, e.g. lo0.0."
                    }
                ]
            },
            "tunnel destination [parameter3]": {
                "template": "tunnel destination [parameter3]",
                "command": "tunnel destination 192.168.51.2",
                "explanation": "Configure the tunnel destination address.",
                "parameters": [
                    {
                        "name": "destination-address",
                        "type": "string",
                        "explanation": "Tunnel destination address."
                    }
                ]
            }
        }
    },
    "set routing-options static route [parameter1]/[parameter2]": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 192.168.51.0/24",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop [parameter3]": {
            "template": "next-hop [parameter3]",
            "command": "next-hop 192.168.50.1",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    }
}