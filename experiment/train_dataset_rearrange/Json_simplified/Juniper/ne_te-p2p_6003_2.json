{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name P3",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols mpls interface [parameter1]": {
        "template": "set protocols mpls interface [parameter1]",
        "command": "set protocols mpls interface ge-1/0/0.0",
        "explanation": "Enables the MPLS protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set protocols rsvp interface [parameter1]": {
        "template": "set protocols rsvp interface [parameter1]",
        "command": "set protocols rsvp interface ge-1/0/0.0",
        "explanation": "The command configures RSVP (Resource Reservation Protocol) on a specific network interface, enabling it to reserve resources for traffic engineering or QoS purposes.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0.0."
            }
        ],
        "bandwidth [parameter2]": {
            "template": "bandwidth [parameter2]",
            "command": "bandwidth 20000",
            "explanation": "The command `bandwidth [parameter2]` sets the interface's bandwidth to the specified value in kilobits per second (kbps) for traffic management and routing calculations.",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "bandwidth, in kbps."
                }
            ]
        }
    },
    "set protocols ospf3 area [parameter1]": {
        "template": "set protocols ospf3 area [parameter1]",
        "command": "set protocols ospf3 area 0.0.0.0",
        "explanation": "Configure the OSPFv3 area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPFv3 area number."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-1/0/0.0",
            "explanation": "Configure OSPFv3 regions and interfaces.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.2.1.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}