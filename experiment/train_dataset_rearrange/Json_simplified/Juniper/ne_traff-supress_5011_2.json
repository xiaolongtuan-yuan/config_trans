        ],
        "next-hop [parameter3]": {
            "template": "next-hop [parameter3]",
            "command": "next-hop ge-2/0/0.0",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    },
    "set protocols l2circuit neighbor [parameter1]": {
        "template": "set protocols l2circuit neighbor [parameter1]",
        "command": "set protocols l2circuit neighbor 3.3.3.3",
        "explanation": "Configures a Layer 2 Circuit (L2Circuit) neighbor with the specified IP address (`[parameter1]`) for point-to-point pseudowire connectivity.",
        "parameters": [
            {
                "name": "neighbor-ip",
                "type": "string",
                "explanation": "Neighbor's IP address."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-1/0/0.1",
            "explanation": "This command configures a Layer 2 Circuit (L2Circuit) by specifying a neighbor device (`parameter1`) and associating it with a local interface (`parameter2`) for pseudowire establishment.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "interface name."
                }
            ],
            "virtual-circuit-id [parameter3]": {
                "template": "virtual-circuit-id [parameter3]",
                "command": "virtual-circuit-id 2",
                "explanation": "The L2 circuit is equipped with neighbours, interfaces and virtual circuit ID.",
                "parameters": [
                    {
                        "name": "virtual-circuit-id",
                        "type": "integer",
                        "explanation": "Virtual circuit identifier."
                    }
                ]
            }
        },
        "pw-class [parameter2]": {
            "template": "pw-class [parameter2]",
            "command": "pw-class default",
            "explanation": "The `pw-class [parameter2]` command in Junos configures a pseudowire class, where `[parameter2]` specifies parameters like encapsulation type or control-word settings for MPLS pseudowires.",
            "parameters": [
                {
                    "name": "pw-class",
                    "type": "string",
                    "explanation": "The name of the PW class."
                }
            ]
        }
    },
