        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. g-0/0/0."
            }
        ]
    },
    "set protocols ldp targeted-hello": {
        "template": "set protocols ldp targeted-hello",
        "command": "set protocols ldp targeted-hello",
        "explanation": "Enables the LDP 's targed hello."
