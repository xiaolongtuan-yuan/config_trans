    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode [parameter3]": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            },
            "input-vlan-map [parameter3]": {
                "template": "input-vlan-map [parameter3]",
                "command": "input-vlan-map pop",
                "explanation": "The `input-vlan-map [parameter3]` command in Junos maps incoming VLAN tags to a specified VLAN ID or action defined by `[parameter3]` for traffic processing.",
                "parameters": [
                    {
                        "name": "operation",
                        "type": "string",
                        "explanation": "Operations type, e.g. pop."
                    }
                ]
            },
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 172.16.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        },
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN IDs for sub-interfaces.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, used to identify different VLANs."
                }
            ]
        },
        "encapsulation [parameter2]": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation vlan-ccc",
            "explanation": "Configure the type of envelope for the sub-interface.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover type, e.g. othernet-bridging."
                }
            ]
        }
    },
    "set routing-options static route [parameter1]/[parameter2]": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 3.3.3.3/32",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
