        ],
        "instance-type [parameter2]": {
            "template": "instance-type [parameter2]",
            "command": "instance-type virtual-router",
            "explanation": "Configure the type of route example that is a virtual router.",
            "parameters": [
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "Type of route example, e.g. virtual-router."
                }
            ]
        },
        "route-distinguisher [parameter2]": {
            "template": "route-distinguisher [parameter2]",
            "command": "route-distinguisher 100:1",
            "explanation": "Configure routers for example.",
            "parameters": [
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "Routers, used to distinguish between different VPN routes."
                }
            ]
        },
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure interfaces in route examples.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/2."
                }
            ]
        },
        "routing-options static route [parameter2]/[parameter3]": {
            "template": "routing-options static route [parameter2]/[parameter3]",
            "command": "routing-options static route 3.3.3.3/32",
            "explanation": "This command configures a static route in a specified routing instance, defining the destination network (`parameter2`) and its subnet mask (`parameter3`).",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "Target network address."
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "Prefix length of target network."
                }
            ],
            "next-hop [parameter4]": {
                "template": "next-hop [parameter4]",
                "command": "next-hop 10.0.0.2",
                "explanation": "Configure the static route for the route example.",
                "parameters": [
                    {
                        "name": "next-hop",
                        "type": "string",
                        "explanation": "Next jump address."
                    }
                ]
            }
        }
    }
