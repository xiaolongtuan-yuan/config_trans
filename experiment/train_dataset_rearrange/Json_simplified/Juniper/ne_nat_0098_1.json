{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CGN2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set firewall family inet filter [parameter1]": {
        "template": "set firewall family inet filter [parameter1]",
        "command": "set firewall family inet filter ACL-3001",
        "explanation": "This command fragment configures an IPv4 firewall filter named `[parameter1]` in Junos OS, defining rules to control traffic based on specified conditions.",
        "parameters": [
            {
                "name": "filter",
                "type": "string",
                "explanation": "Firewall filter name."
            }
        ],
        "term [parameter2]": {
            "template": "term [parameter2]",
            "command": "term 1",
            "explanation": "This command fragment creates a term within an IPv4 firewall filter, where `[parameter1]` is the filter name and `[parameter2]` is the term name.",
            "parameters": [
                {
                    "name": "term",
                    "type": "string",
                    "explanation": "Filter term name."
                }
            ],
            "from source-address [parameter3]/[parameter4]": {
                "template": "from source-address [parameter3]/[parameter4]",
                "command": "from source-address 192.168.10.0/24",
                "explanation": "Configures the source address conditions for access to the control list.",
                "parameters": [
                    {
                        "name": "source-address",
                        "type": "string",
                        "explanation": "Source IP address."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Number of subnet masks in source IP address."
                    }
                ]
            },
            "then [parameter3]": {
                "template": "then [parameter3]",
                "command": "then accept",
                "explanation": "Configure firewall filter terminologies and accept all traffic.",
                "parameters": [
                    {
                        "name": "action",
                        "type": "string",
                        "explanation": "Action, accept indicates acceptance of traffic."
                    }
                ]
            }
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-2/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.10.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "family inet filter input [parameter3]": {
                "template": "family inet filter input [parameter3]",
                "command": "family inet filter input POLICY-1",
                "explanation": "Configure the input filter for the interface.",
                "parameters": [
                    {
                        "name": "filter-name",
                        "type": "string",
                        "explanation": "Filter name."
                    }
                ]
            }
        }
    },
    "set routing-options static route [parameter1]/[parameter2]": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 0.0.0.0/0",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop [parameter3]": {
            "template": "next-hop [parameter3]",
            "command": "next-hop ge-0/0/0.0",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    }
}