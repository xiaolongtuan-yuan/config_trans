{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set routing-instances [parameter1]": {
        "template": "set routing-instances [parameter1]",
        "command": "set routing-instances evpna",
        "explanation": "This command fragment configures a routing instance named `[parameter1]` in Junos, allowing for separate routing tables and protocols within that instance.",
        "parameters": [
            {
                "name": "routing-instance",
                "type": "string",
                "explanation": "Name of route example, e.g. net."
            }
        ],
        "instance-type [parameter2]": {
            "template": "instance-type [parameter2]",
            "command": "instance-type virtual-router",
            "explanation": "Configure the type of route example that is a virtual router.",
            "parameters": [
                {
                    "name": "instance-type",
                    "type": "string",
                    "explanation": "Type of route example, e.g. virtual-router."
                }
            ]
        },
        "route-distinguisher [parameter2]": {
            "template": "route-distinguisher [parameter2]",
            "command": "route-distinguisher 100:1",
            "explanation": "Configure routers for example.",
            "parameters": [
                {
                    "name": "route-distinguisher",
                    "type": "string",
                    "explanation": "Routers, used to distinguish between different VPN routes."
                }
            ]
        }
    },
    "set bridge-domains [parameter1]": {
        "template": "set bridge-domains [parameter1]",
        "command": "set bridge-domains 10",
        "explanation": "Create a bridge field.",
        "parameters": [
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "Bridge domain names, such as vlan10."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-0/0/1.1",
            "explanation": "Configure interfaces to bridge domains.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "interface name."
                }
            ]
        },
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure the VLAN ID of the bridge domain.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, used to identify VLAN."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1.1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode [parameter3]": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            },
            "family ethernet-switching vlan members [parameter3]": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members 10",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        },
        "encapsulation [parameter2]": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation flexible-ethernet-services",
            "explanation": "Configure the type of envelope for the sub-interface.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover type, e.g. othernet-bridging."
                }
            ],
            "vlan-id [parameter3]": {
                "template": "vlan-id [parameter3]",
                "command": "vlan-id 2",
                "explanation": "Configure an interface with a VLAN bridge and specify VLAN ID.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "Vlan's ID."
                    }
                ]
            }
        }
    }
}