{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name ASBR1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 2.2.2.2/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set protocols mpls interface [parameter1]": {
        "template": "set protocols mpls interface [parameter1]",
        "command": "set protocols mpls interface ge-0/0/0.0",
        "explanation": "Enables the MPLS protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set protocols ldp interface [parameter1]": {
        "template": "set protocols ldp interface [parameter1]",
        "command": "set protocols ldp interface ge-0/0/0.0",
        "explanation": "Enables the LDP protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. g-0/0/0."
            }
        ]
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group EBGP-TO-AS100",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, for example, external."
                }
            ]
        },
        "neighbor [parameter2]": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 1.1.1.1",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ],
            "peer-as [parameter3]": {
                "template": "peer-as [parameter3]",
                "command": "peer-as 100",
                "explanation": "Configure the BGP group's neighbours and their equivalents.",
                "parameters": [
                    {
                        "name": "peer-as",
                        "type": "integer",
                        "explanation": "Peer AS."
                    }
                ]
            }
        },
        "local-address [parameter2]": {
            "template": "local-address [parameter2]",
            "command": "local-address 2.2.2.2",
            "explanation": "Configure the local address of the BGP group.",
            "parameters": [
                {
                    "name": "local-address",
                    "type": "string",
                    "explanation": "Local address of the BGP group."
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    },
    "set protocols ospf traffic-engineering": {
        "template": "set protocols ospf traffic-engineering",
        "command": "set protocols ospf traffic-engineering",
        "explanation": "Enables the flow engineering function of the OSF protocol."
    }
}