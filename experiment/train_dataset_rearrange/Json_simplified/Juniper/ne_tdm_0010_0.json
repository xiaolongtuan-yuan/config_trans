{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.2.2/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "encapsulation [parameter3]": {
                "template": "encapsulation [parameter3]",
                "command": "encapsulation ppp",
                "explanation": "Configure the envelope type of the interface.",
                "parameters": [
                    {
                        "name": "encapsulation",
                        "type": "string",
                        "explanation": "Cover type, e.g., pp."
                    }
                ]
            }
        },
        "framing [parameter2]": {
            "template": "framing [parameter2]",
            "command": "framing crc4",
            "explanation": "The frame format for the E1 interface is no-crc4.",
            "parameters": [
                {
                    "name": "framing",
                    "type": "string",
                    "explanation": "Frame formats, such as no-crc4."
                }
            ]
        }
    },
    "set protocols mpls interface [parameter1]": {
        "template": "set protocols mpls interface [parameter1]",
        "command": "set protocols mpls interface ge-2/0/0.0",
        "explanation": "Enables the MPLS protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set protocols ldp router-id [parameter1]": {
        "template": "set protocols ldp router-id [parameter1]",
        "command": "set protocols ldp router-id 192.168.2.2",
        "explanation": "Configure the LDP protocol router ID.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID for LDP protocol."
            }
        ]
    },
    "set protocols ldp targeted-hello [parameter1] [parameter2]": {
        "template": "set protocols ldp targeted-hello [parameter1] [parameter2]",
        "command": "set protocols ldp targeted-hello 192.168.2.2 192.168.3.3",
        "explanation": "Configure directed Hello messages for the LDP protocol.",
        "parameters": [
            {
                "name": "source-address",
                "type": "string",
                "explanation": "Source address, for example, 192.168.2.2."
            },
            {
                "name": "destination-address",
                "type": "string",
                "explanation": "The destination address, for example, 192.168.3.3."
            }
        ]
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    }
}