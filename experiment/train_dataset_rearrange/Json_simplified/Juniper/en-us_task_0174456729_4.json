{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceE",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols mpls interface [parameter1]": {
        "template": "set protocols mpls interface [parameter1]",
        "command": "set protocols mpls interface lo0.0",
        "explanation": "Enables the MPLS protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set protocols ldp interface [parameter1]": {
        "template": "set protocols ldp interface [parameter1]",
        "command": "set protocols ldp interface lo0.0",
        "explanation": "Enables the LDP protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. g-0/0/0."
            }
        ]
    },
    "set protocols ldp transport-address [parameter1]": {
        "template": "set protocols ldp transport-address [parameter1]",
        "command": "set protocols ldp transport-address 5.5.5.9",
        "explanation": "Configures the transfer address for the LDP protocol.",
        "parameters": [
            {
                "name": "transport-address",
                "type": "string",
                "explanation": "the transfer address of the LDP protocol."
            }
        ]
    },
    "set protocols ldp router-id [parameter1]": {
        "template": "set protocols ldp router-id [parameter1]",
        "command": "set protocols ldp router-id 5.5.5.9",
        "explanation": "Configure the LDP protocol router ID.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID for LDP protocol."
            }
        ]
    },
    "set protocols isis level [parameter1]": {
        "template": "set protocols isis level [parameter1]",
        "command": "set protocols isis level 1",
        "explanation": "Configure the level of the ISIS protocol.",
        "parameters": [
            {
                "name": "level",
                "type": "integer",
                "explanation": "Level of IS-IS agreement, e.g. 2."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 5.5.5.9/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}