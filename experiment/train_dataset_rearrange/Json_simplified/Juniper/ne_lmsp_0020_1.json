{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols mpls label-protocol [parameter1]": {
        "template": "set protocols mpls label-protocol [parameter1]",
        "command": "set protocols mpls label-protocol ldp",
        "explanation": "Configures the tag distribution protocol for MPLS as LDP.",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "Label distribution protocols, such as ldp."
            }
        ]
    },
    "set protocols mpls l2vpn": {
        "template": "set protocols mpls l2vpn",
        "command": "set protocols mpls l2vpn",
        "explanation": "Enables MPLS L2VPN."
    },
    "set protocols mpls l2vpn pseudowire-class [parameter1]": {
        "template": "set protocols mpls l2vpn pseudowire-class [parameter1]",
        "command": "set protocols mpls l2vpn pseudowire-class 3to1",
        "explanation": "Configures a pseudowire class for MPLS Layer 2 VPN, specifying parameters like encapsulation type or control-word settings for traffic forwarding.",
        "parameters": [
            {
                "name": "pseudowire-class",
                "type": "string",
                "explanation": "Hypothetical line type names."
            }
        ],
        "encapsulation [parameter2]": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation mpls",
            "explanation": "Configures the false line class of L2VPN and the type of envelope.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover types, such as MPLS."
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "network [parameter2]/[parameter3]": {
            "template": "network [parameter2]/[parameter3]",
            "command": "network 192.168.1.3/32",
            "explanation": "Configure the network within the OSPF area.",
            "parameters": [
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "Web address."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "bits of subnet mask."
                }
            ]
        }
    },
    "set protocols mpls ldp remote-peer [parameter1]": {
        "template": "set protocols mpls ldp remote-peer [parameter1]",
        "command": "set protocols mpls ldp remote-peer 192.168.1.2",
        "explanation": "Configures the remote equivalent of LDP.",
        "parameters": [
            {
                "name": "remote-peer",
                "type": "string",
                "explanation": "Remote peer IP address."
            }
        ]
    },
    "set protocols mpls ldp remote-ip [parameter1]": {
        "template": "set protocols mpls ldp remote-ip [parameter1]",
        "command": "set protocols mpls ldp remote-ip 192.168.1.2",
        "explanation": "Configure the remote IP address of LDP.",
        "parameters": [
            {
                "name": "remote-ip",
                "type": "string",
                "explanation": "Remote IP address."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.2.2.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "aps group [parameter3]": {
                "template": "aps group [parameter3]",
                "command": "aps group 1",
                "explanation": "Configure the APS group for the interface.",
                "parameters": [
                    {
                        "name": "aps-group",
                        "type": "integer",
                        "explanation": "APS group number."
                    }
                ],
                "aps protect aps mode [parameter4] [parameter5]": {
                    "template": "aps protect aps mode [parameter4] [parameter5]",
                    "command": "aps protect aps mode one-plus-one unidirectional",
                    "explanation": "Configure the APS protection mode of the interface.",
                    "parameters": [
                        {
                            "name": "aps-mode",
                            "type": "string",
                            "explanation": "APS models, such as one-plus-one."
                        },
                        {
                            "name": "direction",
                            "type": "string",
                            "explanation": "Direction, for example unidirectional."
                        }
                    ]
                }
            }
        },
        "encapsulation [parameter2]": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation mpls",
            "explanation": "Configure the type of envelope for the sub-interface.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover type, e.g. othernet-bridging."
                }
            ]
        },
        "mpls l2vc pw-template [parameter2] [parameter3]": {
            "template": "mpls l2vc pw-template [parameter2] [parameter3]",
            "command": "mpls l2vc pw-template 3to1 100",
            "explanation": "Configure the interface's MPLS L2VC pseudoline template.",
            "parameters": [
                {
                    "name": "pw-template",
                    "type": "string",
                    "explanation": "The name of the pseudoline template."
                },
                {
                    "name": "vc-id",
                    "type": "integer",
                    "explanation": "Virtual circuit ID."
                }
            ]
        }
    },
    "set routing-options router-id [parameter1]": {
        "template": "set routing-options router-id [parameter1]",
        "command": "set routing-options router-id 192.168.1.3",
        "explanation": "Configure the device's Router ID.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID of equipment for OSPF, BGP, etc."
            }
        ]
    }
}