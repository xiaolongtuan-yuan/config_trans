{
    "set system authentication-order [parameter1]": {
        "template": "set system authentication-order [parameter1]",
        "command": "set system authentication-order tacplus",
        "explanation": "Configure the authentication order of the system.",
        "parameters": [
            {
                "name": "authentication-method",
                "type": "string",
                "explanation": "Authentication methods, such as Radius."
            }
        ]
    },
    "set system tacplus-server [parameter1]": {
        "template": "set system tacplus-server [parameter1]",
        "command": "set system tacplus-server 10.137.217.251",
        "explanation": "This command configures a TACACS+ server on a Junos device, specifying parameters like the server's IP address, shared secret, or timeout settings for authentication and accounting.",
        "parameters": [
            {
                "name": "server-ip",
                "type": "string",
                "explanation": "IP address of TACCS+ server."
            }
        ],
        "secret [parameter2]": {
            "template": "secret [parameter2]",
            "command": "secret cisco",
            "explanation": "Configure IP addresses and shared keys for TACCS+ servers.",
            "parameters": [
                {
                    "name": "secret",
                    "type": "string",
                    "explanation": "Share key with TACCS+ server."
                }
            ]
        }
    },
    "set system login user [parameter1]": {
        "template": "set system login user [parameter1]",
        "command": "set system login user admin@aaa",
        "explanation": "This command fragment configures a user account on a Junos device, where `[parameter1]` specifies the username for login authentication and management access.",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "User name."
            }
        ],
        "class [parameter2]": {
            "template": "class [parameter2]",
            "command": "class super-user",
            "explanation": "Configure the type of system login user.",
            "parameters": [
                {
                    "name": "user-class",
                    "type": "string",
                    "explanation": "User categories, e.g. super-user."
                }
            ],
            "authentication plaintext-password [parameter3]": {
                "template": "authentication plaintext-password [parameter3]",
                "command": "authentication plaintext-password \"pPgn;|W90$J72.Ak$Y,IQ:gqIfPBTLjqW%,N`M_~\"",
                "explanation": "The command sets a plaintext password for authentication, where `[parameter3]` specifies the actual password string to be used.",
                "parameters": [
                    {
                        "name": "plaintext-password",
                        "type": "string",
                        "explanation": "The user's plaintext password."
                    }
                ]
            }
        }
    },
    "set system services ssh": {
        "template": "set system services ssh",
        "command": "set system services ssh",
        "explanation": "Enable SSH services."
    },
    "set system services telnet": {
        "template": "set system services telnet",
        "command": "set system services telnet",
        "explanation": "Enable the Telnet service."
    },
    "set system session-id common": {
        "template": "set system session-id common",
        "command": "set system session-id common",
        "explanation": "The command explanation is: Configure the system session ID to universal mode."
    },
    "set system services ssh root-login allow": {
        "template": "set system services ssh root-login allow",
        "command": "set system services ssh root-login allow",
        "explanation": "The command explanation is: Allow root user login via SSH service."
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.137.217.251/23",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options static route [parameter1]/[parameter2]": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 0.0.0.0/0",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop [parameter3]": {
            "template": "next-hop [parameter3]",
            "command": "next-hop 10.137.216.1",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    }
}