{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system domain-name [parameter1]": {
        "template": "set system domain-name [parameter1]",
        "command": "set system domain-name example.com",
        "explanation": "Configure the system domain name.",
        "parameters": [
            {
                "name": "domain-name",
                "type": "string",
                "explanation": "System domain name."
            }
        ]
    },
    "set system services ssh": {
        "template": "set system services ssh",
        "command": "set system services ssh",
        "explanation": "Enable SSH services."
    },
    "set system services ssh protocol-version [parameter1]": {
        "template": "set system services ssh protocol-version [parameter1]",
        "command": "set system services ssh protocol-version v2",
        "explanation": "Configure the protocol version used for SSH services.",
        "parameters": [
            {
                "name": "protocol-version",
                "type": "string",
                "explanation": "SSH protocol version, v2 indicates use of SSH version 2."
            }
        ]
    },
    "set system login user [parameter1]": {
        "template": "set system login user [parameter1]",
        "command": "set system login user client001",
        "explanation": "This command fragment configures a user account on a Junos device, where `[parameter1]` specifies the username for login authentication and management access.",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "User name."
            }
        ],
        "class [parameter2]": {
            "template": "class [parameter2]",
            "command": "class super-user",
            "explanation": "Configure the type of system login user.",
            "parameters": [
                {
                    "name": "user-class",
                    "type": "string",
                    "explanation": "User categories, e.g. super-user."
                }
            ]
        },
        "authentication plain-text-password [parameter2]": {
            "template": "authentication plain-text-password [parameter2]",
            "command": "authentication plain-text-password \"@%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%\"",
            "explanation": "Configure the system login user's authentication as an explicit password.",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Express password."
                }
            ]
        }
    },
    "set system services ftp": {
        "template": "set system services ftp",
        "command": "set system services ftp",
        "explanation": "Enables FTP service."
    },
    "set system services ssh root-login [parameter1]": {
        "template": "set system services ssh root-login [parameter1]",
        "command": "set system services ssh root-login deny",
        "explanation": "Configure SSH services, prohibiting root users from login.",
        "parameters": [
            {
                "name": "root-login",
                "type": "string",
                "explanation": "Whether or not to control root users can log in through SSH and Deny says no."
            }
        ]
    },
    "set system services ssh max-sessions-per-connection [parameter1]": {
        "template": "set system services ssh max-sessions-per-connection [parameter1]",
        "command": "set system services ssh max-sessions-per-connection 4",
        "explanation": "Configures the maximum number of minutes per SSH connection.",
        "parameters": [
            {
                "name": "max-sessions",
                "type": "integer",
                "explanation": "Maximum number of General Assembly messages per SSH connection."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group BGP-GROUP",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, for example, external."
                }
            ]
        },
        "local-as [parameter2]": {
            "template": "local-as [parameter2]",
            "command": "local-as 65410",
            "explanation": "Configure local self-government system numbers for BGP groups.",
            "parameters": [
                {
                    "name": "local-as",
                    "type": "integer",
                    "explanation": "Local self-government system number."
                }
            ]
        },
        "neighbor [parameter2]": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 10.1.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ],
            "peer-as [parameter3]": {
                "template": "peer-as [parameter3]",
                "command": "peer-as 100",
                "explanation": "Configure the BGP group's neighbours and their equivalents.",
                "parameters": [
                    {
                        "name": "peer-as",
                        "type": "integer",
                        "explanation": "Peer AS."
                    }
                ]
            },
            "family inet [parameter3]": {
                "template": "family inet [parameter3]",
                "command": "family inet unicast",
                "explanation": "Configure the addresses of the BGP neighbors.",
                "parameters": [
                    {
                        "name": "address-family",
                        "type": "string",
                        "explanation": "Addresses of BGP neighbours, e.g. not unicast."
                    }
                ]
            },
            "local-address [parameter3]": {
                "template": "local-address [parameter3]",
                "command": "local-address 10.1.1.1",
                "explanation": "Configure the local address of the BGP peer group.",
                "parameters": [
                    {
                        "name": "local-address",
                        "type": "string",
                        "explanation": "Local address, for BGP sessions."
                    }
                ]
            },
            "export [parameter3]": {
                "template": "export [parameter3]",
                "command": "export NEXT-HOP-SELF",
                "explanation": "Configure BGP neighbours' export strategy.",
                "parameters": [
                    {
                        "name": "export-policy",
                        "type": "string",
                        "explanation": "Export the policy name."
                    }
                ]
            }
        }
    }
}