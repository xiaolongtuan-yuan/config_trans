{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Server1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system ptp mode [parameter1]": {
        "template": "set system ptp mode [parameter1]",
        "command": "set system ptp mode boundary",
        "explanation": "Configure the PTP (exact time protocol) mode as the boundary clock mode.",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "PTP mode, e.g. baseary means boundary clock mode."
            }
        ]
    },
    "set system ptp domain [parameter1]": {
        "template": "set system ptp domain [parameter1]",
        "command": "set system ptp domain 45",
        "explanation": "Configure PTP domain numbers.",
        "parameters": [
            {
                "name": "domain",
                "type": "integer",
                "explanation": "PTP domain numbering to distinguish between different PTP domains."
            }
        ]
    },
    "set system ptp clock-class [parameter1]": {
        "template": "set system ptp clock-class [parameter1]",
        "command": "set system ptp clock-class 248",
        "explanation": "Configure the categories of PTP clocks.",
        "parameters": [
            {
                "name": "clock-class",
                "type": "integer",
                "explanation": "PTP clock type, affects the priority of the clock."
            }
        ]
    },
    "set system ptp priority1 [parameter1]": {
        "template": "set system ptp priority1 [parameter1]",
        "command": "set system ptp priority1 128",
        "explanation": "Configure PTP priority 1.",
        "parameters": [
            {
                "name": "priority1",
                "type": "integer",
                "explanation": "PTP Priority 1 for clock elections."
            }
        ]
    },
    "set system ptp priority2 [parameter1]": {
        "template": "set system ptp priority2 [parameter1]",
        "command": "set system ptp priority2 128",
        "explanation": "Configure PTP priority 2.",
        "parameters": [
            {
                "name": "priority2",
                "type": "integer",
                "explanation": "PTP Priority 2 for clock elections."
            }
        ]
    },
    "set system ptp unicast-negotiation": {
        "template": "set system ptp unicast-negotiation",
        "command": "set system ptp unicast-negotiation",
        "explanation": "Enables PTP to broadcast the consultation."
    },
    "set system ptp dscp [parameter1]": {
        "template": "set system ptp dscp [parameter1]",
        "command": "set system ptp dscp 60",
        "explanation": "Configures the DSCP value for PTP messages.",
        "parameters": [
            {
                "name": "dscp",
                "type": "integer",
                "explanation": "DSCP values for QoS tag PTP messages."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 1.1.1.1/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}