{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set ethernet-switching-options cfm version [parameter1]": {
        "template": "set ethernet-switching-options cfm version [parameter1]",
        "command": "set ethernet-switching-options cfm version standard",
        "explanation": "Configure the version of the CFM that is used as a criterion for exchange options.",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM version, standard version here."
            }
        ]
    },
    "set ethernet-switching-options cfm maintenance-domain [parameter1]": {
        "template": "set ethernet-switching-options cfm maintenance-domain [parameter1]",
        "command": "set ethernet-switching-options cfm maintenance-domain md3",
        "explanation": "This command fragment configures a Connectivity Fault Management (CFM) maintenance domain in Junos, defining a specific domain for Ethernet OAM fault detection and monitoring.",
        "parameters": [
            {
                "name": "maintenance-domain",
                "type": "string",
                "explanation": "Maintains the name of the domain."
            }
        ],
        "level [parameter2]": {
            "template": "level [parameter2]",
            "command": "level 3",
            "explanation": "Configure the level of the CFM maintenance field.",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "Maintenance level."
                }
            ]
        },
        "maintenance-association [parameter2]": {
            "template": "maintenance-association [parameter2]",
            "command": "maintenance-association ma3",
            "explanation": "This command configures CFM (Connectivity Fault Management) by defining a maintenance domain (`parameter1`) and a maintenance association (`parameter2`) for Ethernet switching.",
            "parameters": [
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "Maintains the name of the association."
                }
            ],
            "vlan-id [parameter3]": {
                "template": "vlan-id [parameter3]",
                "command": "vlan-id 2",
                "explanation": "Configure VLAN IDs in CFM maintenance.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID."
                    }
                ]
            },
            "mep [parameter3]": {
                "template": "mep [parameter3]",
                "command": "mep 3",
                "explanation": "This command configures a Connectivity Fault Management (CFM) Maintenance End Point (MEP) within a specified maintenance domain and association for Ethernet switching, enabling fault detection and monitoring.",
                "parameters": [
                    {
                        "name": "mep",
                        "type": "integer",
                        "explanation": "Maintains the ID of the endpoint (MEP)."
                    }
                ],
                "interface [parameter4]": {
                    "template": "interface [parameter4]",
                    "command": "interface ge-1/0/1",
                    "explanation": "Configures a Maintenance End Point (MEP) on a specific interface within a CFM maintenance domain and association for Ethernet OAM fault detection and performance monitoring.",
                    "parameters": [
                        {
                            "name": "interface",
                            "type": "string",
                            "explanation": "interface name."
                        }
                    ],
                    "direction [parameter5]": {
                        "template": "direction [parameter5]",
                        "command": "direction down",
                        "explanation": "Configure CFM maintenance domains to maintain associated MEP interfaces and their direction.",
                        "parameters": [
                            {
                                "name": "direction",
                                "type": "string",
                                "explanation": "MEP direction, here is down."
                            }
                        ]
                    }
                },
                "ccm [parameter4]": {
                    "template": "ccm [parameter4]",
                    "command": "ccm enable",
                    "explanation": "Enables CCM in the CFM maintenance domain to maintain associated MEPs.",
                    "parameters": [
                        {
                            "name": "ccm",
                            "type": "string",
                            "explanation": "CCM functionality enabled."
                        }
                    ]
                },
                "remote-mep-id [parameter4]": {
                    "template": "remote-mep-id [parameter4]",
                    "command": "remote-mep-id 4",
                    "explanation": "Configure the remote MEP ID for maintaining associated MEPs in the CFM maintenance domain.",
                    "parameters": [
                        {
                            "name": "remote-mep-id",
                            "type": "integer",
                            "explanation": "Remotely maintains the ID of the endpoint (MEP)."
                        }
                    ]
                }
            }
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode [parameter3]": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            },
            "family ethernet-switching vlan members [parameter3]": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members vlan2",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        }
    }
}