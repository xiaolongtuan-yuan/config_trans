{
    "hostname [hostname]": {
        "template": "hostname [hostname]",
        "command": "hostname CE2",
        "explanation": "Sets the device's hostname 'CE2'",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan [vlan-id]": {
        "template": "vlan [vlan-id]",
        "command": "vlan 2",
        "explanation": "Create or configure VLAN 2",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure interface 'GigabitEthernet1/0/1 '",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [mode]": {
            "template": "switchport mode [mode]",
            "command": "switchport mode trunk",
            "explanation": "Set interface exchange port mode to trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Port mode (access or trunk)"
                }
            ]
        },
        "switchport trunk allowed vlan [vlan-list]": {
            "template": "switchport trunk allowed vlan [vlan-list]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "Allow VLAN 2 to cross the trunk interface",
            "parameters": [
                {
                    "name": "vlan-list",
                    "type": "string",
                    "explanation": "Allowed VLAN List"
                }
            ]
        }
    },
    "ethernet cfm mode [mode]": {
        "template": "ethernet cfm mode [mode]",
        "command": "ethernet cfm mode on",
        "explanation": "Set the ethnet CFM mode toon",
        "parameters": [
            {
                "name": "mode",
                "type": "string",
                "explanation": "Mode (on or off)"
            }
        ]
    },
    "ethernet cfm md [md-name]": {
        "template": "ethernet cfm md [md-name]",
        "command": "ethernet cfm md md3",
        "explanation": "Configure CFM Fieldmd3",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "CFM domain name"
            }
        ],
        "ethernet cfm ma [ma-name]": {
            "template": "ethernet cfm ma [ma-name]",
            "command": "ethernet cfm ma ma3",
            "explanation": "Configure CFM maintenance connection ma3",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "Maintain Association Name"
                }
            ],
            "ethernet cfm ma vlan [vlan-id]": {
                "template": "ethernet cfm ma vlan [vlan-id]",
                "command": "ethernet cfm ma vlan 2",
                "explanation": "Link MA to VLAN 2",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN identification number"
                    }
                ],
                "ethernet cfm mep [mep-id] interface [interface-name] direction [direction]": {
                    "template": "ethernet cfm mep [mep-id] interface [interface-name] direction [direction]",
                    "command": "ethernet cfm mep 4 interface GigabitEthernet1/0/1 direction egress",
                    "explanation": "Configure MEP ID 4 on interface GigabitEthernet1/0/1 in the direction of egress",
                    "parameters": [
                        {
                            "name": "mep-id",
                            "type": "integer",
                            "explanation": "MEP identification number"
                        },
                        {
                            "name": "interface-name",
                            "type": "string",
                            "explanation": "Interface Name"
                        },
                        {
                            "name": "direction",
                            "type": "string",
                            "explanation": "Direction (ingress or orientation)"
                        }
                    ]
                },
                "ethernet cfm mep [mep-id] ccm-send enable": {
                    "template": "ethernet cfm mep [mep-id] ccm-send enable",
                    "command": "ethernet cfm mep 4 ccm-send enable",
                    "explanation": "Enable CCM send for MEP 4",
                    "parameters": [
                        {
                            "name": "mep-id",
                            "type": "integer",
                            "explanation": "MEP identification number"
                        }
                    ]
                },
                "ethernet cfm remote-mep [remote-mep-id]": {
                    "template": "ethernet cfm remote-mep [remote-mep-id]",
                    "command": "ethernet cfm remote-mep 3",
                    "explanation": "Configure remote MEP ID 3",
                    "parameters": [
                        {
                            "name": "remote-mep-id",
                            "type": "integer",
                            "explanation": "Remote MEP ID"
                        }
                    ]
                },
                "ethernet cfm remote-mep [remote-mep-id] ccm-receive enable": {
                    "template": "ethernet cfm remote-mep [remote-mep-id] ccm-receive enable",
                    "command": "ethernet cfm remote-mep 3 ccm-receive enable",
                    "explanation": "Enable CCM reception for remote MEP 3",
                    "parameters": [
                        {
                            "name": "remote-mep-id",
                            "type": "integer",
                            "explanation": "Remote MEP ID"
                        }
                    ]
                },
                "ethernet cfm delay-measure receive test-id [test-id] mep [mep-id]": {
                    "template": "ethernet cfm delay-measure receive test-id [test-id] mep [mep-id]",
                    "command": "ethernet cfm delay-measure receive test-id 1 mep 4",
                    "explanation": "Configure delayed measurement reception, test ID 1, MEP 4",
                    "parameters": [
                        {
                            "name": "test-id",
                            "type": "integer",
                            "explanation": "Test ID"
                        },
                        {
                            "name": "mep-id",
                            "type": "integer",
                            "explanation": "MEP identification number"
                        }
                    ]
                },
                "ethernet cfm delay-measure send test-id [test-id] mep [mep-id] remote-mep [remote-mep-id] interval [interval]": {
                    "template": "ethernet cfm delay-measure send test-id [test-id] mep [mep-id] remote-mep [remote-mep-id] interval [interval]",
                    "command": "ethernet cfm delay-measure send test-id 2 mep 4 remote-mep 3 interval 1000",
                    "explanation": "Configure delayed measurement sent, test ID 2, MEP 4, remote MEP 3, 1,000 ms interval",
                    "parameters": [
                        {
                            "name": "test-id",
                            "type": "integer",
                            "explanation": "Test ID"
                        },
                        {
                            "name": "mep-id",
                            "type": "integer",
                            "explanation": "MEP identification number"
                        },
                        {
                            "name": "remote-mep-id",
                            "type": "integer",
                            "explanation": "Remote MEP ID"
                        },
                        {
                            "name": "interval",
                            "type": "integer",
                            "explanation": "Period (ms)"
                        }
                    ]
                }
            }
        }
    }
}