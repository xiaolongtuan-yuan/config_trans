{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "Enter IS-IS route protocol configuration mode",
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "Set IS-IS instance to Level-1 type",
            "parameters": [
                {
                    "name": "IS-IS level",
                    "type": "string",
                    "explanation": "IS-IS level, Level-1 or Level-2"
                }
            ]
        },
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 10.0000.0000.0002.00",
            "explanation": "The name of the network entity (NET) that configures IS-IS",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "Name of the network entity, used to identify examples of IS-IS"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "Configure ISIS interface network type as point-to-point",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "Network type, point-to-point or broadcast"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
    }
}