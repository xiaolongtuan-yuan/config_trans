{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Hub1",
        "explanation": "Sets the device's hostname 'Hub1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]": {
        "template": "access-list [parameter1] permit ip [parameter2] [parameter3] [parameter4]",
        "command": "access-list 2000 permit ip 192.168.0.0 0.0.0.255 any",
        "explanation": "Define access control list 2000 to allow any IP traffic from 192.168.0.0/24 network",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "Access control list number"
            },
            {
                "name": "source network",
                "type": "IPv4",
                "explanation": "Source Network Address"
            },
            {
                "name": "wildcard mask",
                "type": "IPv4",
                "explanation": "Wildcard Mask"
            },
            {
                "name": "destination",
                "type": "string",
                "explanation": "Destination, 'any' indicates any address."
            }
        ]
    },
    "route-map [parameter1] permit [parameter2]": {
        "template": "route-map [parameter1] permit [parameter2]",
        "command": "route-map 1 permit 10",
        "explanation": "Define route map 1, serial number 10, move as permitted",
        "parameters": [
            {
                "name": "route-map name",
                "type": "integer",
                "explanation": "Route Map Name"
            },
            {
                "name": "sequence number",
                "type": "integer",
                "explanation": "Serial number"
            }
        ],
        "match ip address [parameter1]": {
            "template": "match ip address [parameter1]",
            "command": "match ip address 2000",
            "explanation": "Match IP address defined in ACL 2000",
            "parameters": [
                {
                    "name": "access-list number",
                    "type": "integer",
                    "explanation": "Access control list number"
                }
            ]
        }
    },
    "interface [parameter1]": {
