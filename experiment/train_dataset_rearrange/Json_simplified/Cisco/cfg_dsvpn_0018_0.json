            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "Source Address"
                }
            ]
        },
        "tunnel key [parameter1]": {
            "template": "tunnel key [parameter1]",
            "command": "tunnel key 0",
            "explanation": "Set tunnel key to 0",
            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "Key"
                }
            ]
        },
        "tunnel protection ipsec profile [parameter1]": {
            "template": "tunnel protection ipsec profile [parameter1]",
            "command": "tunnel protection ipsec profile <profile-name>",
            "explanation": "Sets the tunnel to be protected by IPSec, using the specified programme",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "Profile Name"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enable OSF process1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "Process ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 172.16.1.1",
            "explanation": "Sets the OSPF process 1 router ID to 172.16.1.1",
            "parameters": [
                {
                    "name": "router ID",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "redistribute ospf [parameter1] subnets route-map [parameter2]": {
            "template": "redistribute ospf [parameter1] subnets route-map [parameter2]",
            "command": "redistribute ospf 3 subnets route-map 1",
            "explanation": "Redistribution of OSPF process 3 route to OSPF process 1 using route map 1",
            "parameters": [
                {
                    "name": "OSPF process ID",
                    "type": "integer",
                    "explanation": "OSS Process ID"
                },
                {
                    "name": "route-map name",
                    "type": "integer",
                    "explanation": "Route Map Name"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 172.16.1.0 0.0.0.255 area 0",
            "explanation": "Add network 172.16.1.0/24 to OSPF process 1 area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Wildcard Mask"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "Area ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
    }
