        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0000.0005.00",
            "explanation": "Set the name of the IS-IS network entity (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "Network Entity Title"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "Set IS-IS router type to Level-1",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "IS-IS Type"
                }
            ]
        },
        "mpls traffic-eng router-id [parameter1]": {
            "template": "mpls traffic-eng router-id [parameter1]",
