                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip router isis [parameter1]": {
            "template": "ip router isis [parameter1]",
            "command": "ip router isis 1",
            "explanation": "Enable IS-IS router 1 on interface",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "IS-IS Process ID"
                }
            ]
        },
        "ip router isis [parameter1] prefix-sid index [parameter2]": {
            "template": "ip router isis [parameter1] prefix-sid index [parameter2]",
            "command": "ip router isis 1 prefix-sid index 50",
            "explanation": "Configure prefix SID index to 50 for IS-IS route process 1",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "IS-IS Process ID"
                },
                {
                    "name": "index",
                    "type": "integer",
                    "explanation": "Prefix SID Index"
                }
            ]
        }
