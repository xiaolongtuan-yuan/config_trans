{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE",
        "explanation": "Sets the device 's hostname 'PE '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch [parameter1]": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2-4",
        "explanation": "Batch creation of VLAN 2 to 4",
        "parameters": [
            {
                "name": "vlan range",
                "type": "string",
                "explanation": "VLAN Range"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 4",
        "explanation": "Configure VLAN 4",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ],
        "private-vlan association [parameter1]": {
            "template": "private-vlan association [parameter1]",
            "command": "private-vlan association 2-3",
            "explanation": "Set VLAN 4 to VLAN 2 and 3",
            "parameters": [
                {
                    "name": "associated vlan range",
                    "type": "string",
                    "explanation": "VLAN range associated"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Vlan4",
        "explanation": "Configure VLAN4 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.12 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1.12 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set interface mode to trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Interface Mode"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "Allow VLAN 2 on trunk",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
