{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname Spoke2",
        "explanation": "Set the device 's system name is 'Spoke2 '",
        "parameters": [
            {
                "name": "system name",
                "type": "string",
                "explanation": "System name of the device"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.10 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.3.10 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "tunnel source [parameter1]": {
            "template": "tunnel source [parameter1]",
            "command": "tunnel source LoopBack0",
            "explanation": "Set tunnel source interface to LoopBack0",
            "parameters": [
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source interface of the tunnel"
                }
            ]
        },
        "tunnel mode [parameter1] [parameter2]": {
            "template": "tunnel mode [parameter1] [parameter2]",
            "command": "tunnel mode gre multipoint",
            "explanation": "Set tunnel mode more to GRE",
            "parameters": [
                {
                    "name": "tunnel mode",
                    "type": "string",
                    "explanation": "Tunnel Mode Type"
                },
                {
                    "name": "multipoint",
                    "type": "string",
                    "explanation": "More tunnels."
                }
            ]
        },
        "tunnel key [parameter1]": {
            "template": "tunnel key [parameter1]",
            "command": "tunnel key 1",
            "explanation": "Set tunnel key to 1",
            "parameters": [
                {
                    "name": "key",
                    "type": "integer",
                    "explanation": "The key to the tunnel"
                }
            ]
        },
        "ip nhrp network-id [parameter1]": {
            "template": "ip nhrp network-id [parameter1]",
            "command": "ip nhrp network-id 1",
            "explanation": "Set NHRP Network ID to 1",
            "parameters": [
                {
                    "name": "network-id",
                    "type": "integer",
                    "explanation": "NHRP Network ID"
                }
            ]
        },
        "ip nhrp nhs [parameter1] nbma [parameter2]": {
            "template": "ip nhrp nhs [parameter1] nbma [parameter2]",
            "command": "ip nhrp nhs 172.16.1.1 nbma 10.1.1.10",
            "explanation": "Configure NHRP's next jumper is 172.16.1.1 and NBMA's address is 10.1.1.10.",
            "parameters": [
                {
                    "name": "nhs address",
                    "type": "IPv4",
                    "explanation": "Next NHRP Jump Server Address"
                },
                {
                    "name": "nbma address",
                    "type": "IPv4",
                    "explanation": "NBMA Address"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 2",
        "explanation": "Enter OSPF router configuration mode, process ID 2",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "router-id [parameter1]": {
            "template": "router-id [parameter1]",
            "command": "router-id 10.1.3.10",
            "explanation": "Set OSPF router ID to 10.1.3.10",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "OSF router ID"
                }
            ]
        },
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.1.3.0 0.0.0.255 area 0.0.0.1",
            "explanation": "Classification of network in OSPF area 0.0.1",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Countermask"
                },
                {
                    "name": "area",
                    "type": "IPv4",
                    "explanation": "OSF Area ID"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3]": {
        "template": "ip route [parameter1] [parameter2] [parameter3]",
        "command": "ip route 192.168.0.0 255.255.255.0 172.16.1.1",
        "explanation": "Configure static route, moving 192.168.0.0/24 route to 172.16.1.1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "Destination Network Address"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "Subnet mask"
            },
            {
                "name": "next hop",
                "type": "IPv4",
                "explanation": "Next Jump Address"
            }
        ]
    }
}