        "parameters": [
            {
                "name": "list name",
                "type": "string",
                "explanation": "Authentication list name"
            },
            {
                "name": "group",
                "type": "string",
                "explanation": "Accreditation Methodology Group"
            },
            {
                "name": "fallback method",
                "type": "string",
                "explanation": "Alternative authentication method"
            }
        ]
    },
    "aaa authorization exec [parameter1] group [parameter2] [parameter3]": {
        "template": "aaa authorization exec [parameter1] group [parameter2] [parameter3]",
        "command": "aaa authorization exec default group radius if-authenticated",
        "explanation": "Configure the default list for executing authorizations, first try the RADIUS server and allow execution if the user is certified",
        "parameters": [
            {
                "name": "list name",
                "type": "string",
                "explanation": "Authorized List Name"
            },
            {
                "name": "group",
                "type": "string",
