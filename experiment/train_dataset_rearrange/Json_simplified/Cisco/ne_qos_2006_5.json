{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE3",
        "explanation": "Sets the device's hostname \"CE3\"",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.3.1.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 65430",
        "explanation": "Enter BGP configuration mode, AS 65430",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomous System (AS) No."
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.3.1.2 remote-as 100",
            "explanation": "Configure BGP Neighbors 10.3.1.2 with AS 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Neighbor's AS."
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "Enter IPv4 solitaire configuration mode",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type, e.g. 'ipv4'"
                },
                {
                    "name": "subtype",
                    "type": "string",
                    "explanation": "Subtypes such as 'unicast '"
                }
            ],
            "network [parameter1] mask [parameter2]": {
                "template": "network [parameter1] mask [parameter2]",
                "command": "network 10.3.1.0 mask 255.255.255.0",
                "explanation": "Declares network 10.3.1.0/24 to BGP",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "Subnet mask"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.3.1.2 activate",
                "explanation": "Activate meetings with neighbours 10.3.1.2",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "Neighbor's IP address"
                    }
                ]
            }
        }
    }
}