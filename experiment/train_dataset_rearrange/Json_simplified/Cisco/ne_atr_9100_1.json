{
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface Loopback0",
        "explanation": "Configure interface Loopback0",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [ip-address] [subnet-mask]": {
            "template": "ip address [ip-address] [subnet-mask]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "Configure interface IPv4 address 2.2.2.2 with subnet mask 255.255.255.255.255",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet-mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ptp device-type [type]": {
            "template": "ptp device-type [type]",
            "command": "ptp device-type boundary",
            "explanation": "Set PTP Device Type as Border Clock",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Device type, this is 'bundary'"
                }
            ]
        },
        "ptp priority [priority-value]": {
            "template": "ptp priority [priority-value]",
            "command": "ptp priority 5",
            "explanation": "Set PTP priority to 5",
            "parameters": [
                {
                    "name": "priority-value",
                    "type": "integer",
                    "explanation": "Priority value"
                }
            ]
        },
        "ptp adaptive device-type [type]": {
            "template": "ptp adaptive device-type [type]",
            "command": "ptp adaptive device-type client",
            "explanation": "Set self-adaptor type as client",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Device type, this is 'client'"
                }
            ]
        },
        "ptp adaptive local-ip [ip-address]": {
            "template": "ptp adaptive local-ip [ip-address]",
            "command": "ptp adaptive local-ip 2.2.2.2",
            "explanation": "Set local IP address to 2.2.2.2",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "Local IP Address"
                }
            ]
        },
        "ptp adaptive remote-server1-ip [ip-address]": {
            "template": "ptp adaptive remote-server1-ip [ip-address]",
            "command": "ptp adaptive remote-server1-ip 1.1.1.1",
            "explanation": "Set remote server IP address to 1.1.1",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "Remote Server IP Address"
                }
            ]
        },
        "ptp adaptive dscp [dscp-value]": {
            "template": "ptp adaptive dscp [dscp-value]",
            "command": "ptp adaptive dscp 60",
            "explanation": "Set DSCP value to 60",
            "parameters": [
                {
                    "name": "dscp-value",
                    "type": "integer",
                    "explanation": "DSCP value"
                }
            ]
        }
    }
}