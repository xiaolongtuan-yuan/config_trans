{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface gigabitEthernet1/0/0",
        "explanation": "Configure interface 'gigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:1::1/64",
            "explanation": "The IPv6 address for the configuration interface is 2001: db8:1:1/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 Address"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "Enter BGP configuration mode, AS 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomy Systems (AS)"
            }
        ],
        "bgp router-id [parameter1]": {
            "template": "bgp router-id [parameter1]",
            "command": "bgp router-id 5.5.5.5",
            "explanation": "Set BGP router ID to 5.5.5.5",
            "parameters": [
                {
                    "name": "router-id",
                    "type": "IPv4",
                    "explanation": "Router ID"
                }
            ]
        },
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 2001:db8:1::2 remote-as 200",
            "explanation": "Configure neighboring router at: 2001: db8:2:2, AS: 200",
            "parameters": [
                {
                    "name": "neighbor address",
                    "type": "IPv6",
                    "explanation": "The address of the neighbor router."
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Neighbor's AS."
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "Enter IPv4 solo community configuration mode",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type"
                },
                {
                    "name": "subtype",
                    "type": "string",
                    "explanation": "Subtype, e.g. unicast"
                }
            ],
            "network [parameter1]": {
                "template": "network [parameter1]",
                "command": "network 2001:db8:5::5/128",
                "explanation": "Communication Network 2001: db8:5:5:5/128",
                "parameters": [
                    {
                        "name": "network",
                        "type": "IPv6 with mask",
                        "explanation": "Network address and mask to announce"
                    }
                ]
            },
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 2001:db8:1::2 activate",
                "explanation": "Activate sessions with neighbours 2001: db8:1:2",
                "parameters": [
                    {
                        "name": "neighbor address",
                        "type": "IPv6",
                        "explanation": "The address of the neighbor router."
                    }
                ]
            }
        }
    }
}