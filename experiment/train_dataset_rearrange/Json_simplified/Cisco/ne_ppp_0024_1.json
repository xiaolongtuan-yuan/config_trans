{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "Configure interface 'Lmpif1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ppp authentication [parameter1]": {
            "template": "ppp authentication [parameter1]",
            "command": "ppp authentication chap",
            "explanation": "Set PPP as CHAP",
            "parameters": [
                {
                    "name": "authentication type",
                    "type": "string",
                    "explanation": "Type of authentication"
                }
            ]
        },
        "ppp chap hostname [parameter1]": {
            "template": "ppp chap hostname [parameter1]",
            "command": "ppp chap hostname rtb",
            "explanation": "Sets the hostname 'rtb 'for CHAP",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "Host Name"
                }
            ]
        },
        "ppp chap password [parameter1] [parameter2]": {
            "template": "ppp chap password [parameter1] [parameter2]",
            "command": "ppp chap password 0 @%@%j]v~7%f[#S'W>j9zzM)3,*!u@%@%",
            "explanation": "Set the CCAP password to show explicitly",
            "parameters": [
                {
                    "name": "password type",
                    "type": "integer",
                    "explanation": "Password type (0 indicates express)"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Password"
                }
            ]
        }
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "Enable AAA new model"
    },
    "username [parameter1] password [parameter2] [parameter3]": {
        "template": "username [parameter1] password [parameter2] [parameter3]",
        "command": "username rta password 0 @%@%EDF~DAdfFD934J3<DAF#*<!@%@%",
        "explanation": "Creates the username 'rta 'and its password, clearly displayed",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            },
            {
                "name": "password type",
                "type": "integer",
                "explanation": "Password type (0 indicates express)"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "Password"
            }
        ]
    },
    "aaa authentication login [parameter1] [parameter2]": {
        "template": "aaa authentication login [parameter1] [parameter2]",
        "command": "aaa authentication login default1 local",
        "explanation": "Sets AAA login authentication using local databases, authentication list 'default1'",
        "parameters": [
            {
                "name": "authentication list",
                "type": "string",
                "explanation": "Authentication list name"
            },
            {
                "name": "method",
                "type": "string",
                "explanation": "Authentication method (local database)"
            }
        ]
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "End Configuration Mode"
    }
}