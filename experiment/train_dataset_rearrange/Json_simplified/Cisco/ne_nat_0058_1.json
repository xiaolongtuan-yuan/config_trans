        ]
    },
    "ip nat inside source list [parameter1] pool [parameter2]": {
        "template": "ip nat inside source list [parameter1] pool [parameter2]",
        "command": "ip nat inside source list 100 pool NATPOOL",
        "explanation": "Configure NAT, convert the access control list 100 matching internal IP address to the address in NAT address pool 'NATPOOL'",
        "parameters": [
            {
                "name": "access-list number",
                "type": "integer",
                "explanation": "Access control list number"
            },
            {
                "name": "pool name",
                "type": "string",
                "explanation": "NAM Address Pool Name"
            }
        ]
    },
    "ip nat inside source static [parameter1] [parameter2]": {
        "template": "ip nat inside source static [parameter1] [parameter2]",
        "command": "ip nat inside source static 192.168.10.10 1.1.1.100",
