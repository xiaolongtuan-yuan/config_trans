        "command": "hostname PE2",
        "explanation": "Set the device 's hostname 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ip vrf [parameter1]": {
        "template": "ip vrf [parameter1]",
