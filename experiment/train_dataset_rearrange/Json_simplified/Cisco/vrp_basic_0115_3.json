        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.2 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 10.3.1.2 and the subnet mask is 255.255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "vrf forwarding [parameter1]": {
            "template": "vrf forwarding [parameter1]",
            "command": "vrf forwarding vpn1",
