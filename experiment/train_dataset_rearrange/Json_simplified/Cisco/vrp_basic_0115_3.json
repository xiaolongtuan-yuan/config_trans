            "parameters": [
                {
                    "name": "vrf name",
                    "type": "string",
                    "explanation": "VRF instance name"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "Enter BGP configuration mode, AS 100",
        "parameters": [
            {
                "name": "as number",
                "type": "integer",
                "explanation": "Autonomous System Number"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.9 remote-as 100",
            "explanation": "Configure BGP Neighbor, IP address 1.1.1.9, AS 100",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                },
                {
                    "name": "as number",
                    "type": "integer",
                    "explanation": "Neighbor's Home Rule System."
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.9 update-source Loopback1",
            "explanation": "Configure BGP Update Source to Ringback Interface 'Loopback1 '",
            "parameters": [
                {
                    "name": "neighbor ip",
                    "type": "IPv4",
                    "explanation": "Neighbor's IP address"
                },
                {
                    "name": "update source",
                    "type": "string",
                    "explanation": "Update Source Interface Name"
                }
            ]
        },
        "address-family ipv4 vrf [parameter1]": {
            "template": "address-family ipv4 vrf [parameter1]",
            "command": "address-family ipv4 vrf vpn1",
            "explanation": "IPv4 address group configuration for VRF 'vpn1 '",
            "parameters": [
                {
                    "name": "vrf name",
                    "type": "string",
                    "explanation": "VRF instance name"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
