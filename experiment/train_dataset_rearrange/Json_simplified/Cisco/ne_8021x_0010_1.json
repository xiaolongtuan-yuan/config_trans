            "command": "dot1x auth-fail action reauthenticate",
            "explanation": "Set movement after authentication failed as reaccreditation",
            "parameters": [
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "Actions like reauthenticate etc."
                }
            ]
        },
        "dot1x timeout reauth-period [parameter1]": {
            "template": "dot1x timeout reauth-period [parameter1]",
            "command": "dot1x timeout reauth-period 60",
            "explanation": "Sets a new authentication cycle of 60 seconds",
            "parameters": [
                {
                    "name": "reauth period",
                    "type": "integer",
                    "explanation": "Reaccreditation cycle, unit seconds"
                }
            ]
