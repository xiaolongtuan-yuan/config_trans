        "parameters": [
            {
                "name": "group name",
                "type": "string",
                "explanation": "RADIUS Group Name"
            }
        ]
    },
    "aaa authorization network default group [parameter1]": {
        "template": "aaa authorization network default group [parameter1]",
        "command": "aaa authorization network default group radius",
        "explanation": "Configure the network to authorize the use of RADIUS groups",
        "parameters": [
            {
                "name": "group name",
                "type": "string",
                "explanation": "RADIUS Group Name"
            }
        ]
    },
