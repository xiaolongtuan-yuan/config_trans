{
    "radius-server host [parameter1] auth-port [parameter2] key [parameter3]": {
        "template": "radius-server host [parameter1] auth-port [parameter2] key [parameter3]",
        "command": "radius-server host 10.7.66.66 auth-port 1812 key <shared-secret-key>",
        "explanation": "Configure RADIUS server addresses, authentication ports and keys",
        "parameters": [
            {
                "name": "host address",
                "type": "IPv4",
                "explanation": "IP address of RADIUS server"
            },
            {
                "name": "auth-port",
                "type": "integer",
                "explanation": "Authentication port number"
            },
            {
                "name": "key",
                "type": "string",
                "explanation": "Shared Key"
            }
        ]
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "Enable new AAA model"
    },
    "aaa authentication dot1x default group [parameter1]": {
        "template": "aaa authentication dot1x default group [parameter1]",
