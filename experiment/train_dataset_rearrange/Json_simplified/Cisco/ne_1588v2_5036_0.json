{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp": {
        "template": "ptp",
        "command": "ptp",
        "explanation": "Enter PTP Configuration Mode",
        "ptp profile [parameter1]": {
            "template": "ptp profile [parameter1]",
            "command": "ptp profile default",
            "explanation": "Select the default PTP profile",
            "parameters": [
                {
                    "name": "profile name",
                    "type": "string",
                    "explanation": "Profile Name"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "Configure Loopback0 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 1.1.1.1 The subnet mask is 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
}