{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname Device1",
        "explanation": "Sets the device's hostname 'Device1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp enable": {
        "template": "ptp enable",
        "command": "ptp enable",
        "explanation": "Enable interface PTP functionality"
    },
    "ptp profile [parameter1] enable": {
        "template": "ptp profile [parameter1] enable",
        "command": "ptp profile g8275-1 enable",
        "explanation": "Enable specified PTP profile",
        "parameters": [
            {
                "name": "profile name",
                "type": "string",
                "explanation": "PTP profile name"
            }
        ]
    },
    "ptp device-type [parameter1]": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type tbc",
        "explanation": "Set PTP Device Type to TBC (to be determined)",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "PTP Device Type"
            }
        ]
    },
    "ptp passive-measure enable": {
        "template": "ptp passive-measure enable",
        "command": "ptp passive-measure enable",
        "explanation": "Enable passive measurement"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ptp disable [parameter1]": {
            "template": "ptp disable [parameter1]",
            "command": "ptp disable notslave",
            "explanation": "Disables the nottslave function of PTP",
            "parameters": [
                {
                    "name": "feature",
                    "type": "string",
                    "explanation": "PTP functionality to disable"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 10",
            "explanation": "Set clock priority to 10",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "Clock Priority"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "End Configuration Mode"
    }
}