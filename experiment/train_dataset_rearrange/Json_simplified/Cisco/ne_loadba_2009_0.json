{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname routerA",
        "explanation": "Sets the device's hostname 'routerA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "router [parameter1]": {
        "template": "router [parameter1]",
        "command": "router isis",
        "explanation": "Enter ISIS router configuration mode",
        "parameters": [
            {
                "name": "routing protocol",
                "type": "string",
                "explanation": "Specify the route. This is ISIS."
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "Configure ISIS network type as point-to-point",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "Two devices of ISIS network type, point-to-point for direct connection"
                }
            ]
        },
        "ip load-sharing [parameter1]": {
            "template": "ip load-sharing [parameter1]",
            "command": "ip load-sharing per-packet",
            "explanation": "Configure IP load balance to package distribution",
            "parameters": [
                {
                    "name": "load-sharing method",
                    "type": "string",
                    "explanation": "Load balancing method, per-packet indicates distribution by package"
                }
            ]
        }
    }
}