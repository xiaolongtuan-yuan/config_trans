        "command": "hostname PE1",
        "explanation": "Sets the device 's hostname 'PE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "Enable MPLS IP on interface"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "Configure interface 'GigabitEthernet1/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 1",
            "explanation": "Sets the cover type of interface to dot1Q, VLAN ID to 1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "xconnect [parameter1] [parameter2] encapsulation [parameter3]": {
            "template": "xconnect [parameter1] [parameter2] encapsulation [parameter3]",
            "command": "xconnect 2.2.2.2 1001 encapsulation mpls",
            "explanation": "Configure cross-connection with end IP 2.2.2.2, VLAN ID 1001 and cover type MPLS",
            "parameters": [
                {
                    "name": "peer ip address",
                    "type": "IPv4",
                    "explanation": "Host IP Address"
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                },
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "Cover type, here is 'mpls'"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192.168.1.1 and the subnet mask is 255.252.55.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enter OSPF router configuration, process ID 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.1.1 0.0.0.0 area 0",
            "explanation": "Link 1.1.1.1/32 to OSF 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Countermask"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF Area Number"
                }
            ]
        }
    }
