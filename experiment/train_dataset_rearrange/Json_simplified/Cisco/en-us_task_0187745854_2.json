{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname ASBR1",
        "explanation": "Sets the device's hostname 'ASBR1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enable OSF process, process ID 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.10.1.0 0.0.0.255 area 0",
            "explanation": "10.10.1.0/24 at OSF 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Countermask"
                },
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSF Area ID"
                }
            ]
        }
    },
    "router bgp [parameter1]": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "Enable BGP process, AS 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomy system number"
            }
        ],
        "neighbor [parameter1] remote-as [parameter2]": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 1.1.1.1 remote-as 100",
            "explanation": "Configure neighbor 1.1.1.1, AS 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "The neighbor's IP address."
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Neighbor's AS."
                }
            ]
        },
        "neighbor [parameter1] update-source [parameter2]": {
            "template": "neighbor [parameter1] update-source [parameter2]",
            "command": "neighbor 1.1.1.1 update-source Loopback1",
            "explanation": "Designation of the source interface to be used for communication with neighbour 1.1.1.1 as Loopback1",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "The neighbor's IP address."
                },
                {
                    "name": "source interface",
                    "type": "string",
                    "explanation": "Source Interface"
                }
            ]
        },
        "address-family [parameter1] [parameter2]": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "Enter IPv4 solo community configuration mode",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "Address family type"
                },
                {
                    "name": "unicast/multicast",
                    "type": "string",
                    "explanation": "Route Type"
                }
            ],
            "neighbor [parameter1] activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 1.1.1.1 activate",
                "explanation": "Activate L2VPN VPLS with neighbor 1.1.1.1",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "The neighbor's IP address."
                    }
                ]
            }
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface GigabitEthernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.2.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.2.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "mpls ldp": {
        "template": "mpls ldp",
        "command": "mpls ldp",
        "explanation": "Enable MPLS LDP"
    },
    "mpls lsr-id [parameter1]": {
        "template": "mpls lsr-id [parameter1]",
        "command": "mpls lsr-id 2.2.2.2",
        "explanation": "Set LSR ID to 2.2.2.2",
        "parameters": [
            {
                "name": "LSR ID",
                "type": "IPv4",
                "explanation": "Tag exchange router ID"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "global enable MPLS IP"
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "End Configuration Mode"
    }
}