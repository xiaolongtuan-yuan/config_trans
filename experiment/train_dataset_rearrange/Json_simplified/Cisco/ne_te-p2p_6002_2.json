{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P2",
        "explanation": "Sets the device 's hostname 'P2 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ldp router-id [parameter1] force": {
        "template": "mpls ldp router-id [parameter1] force",
        "command": "mpls ldp router-id Loopback0 force",
        "explanation": "Force the IP address of the Loopback0 interface as a router ID for MPLS LDP",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface Name"
            }
        ]
    },
    "mpls traffic-eng tunnels": {
        "template": "mpls traffic-eng tunnels",
        "command": "mpls traffic-eng tunnels",
        "explanation": "Enable MPLS flow engineering tunnel on interface"
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "Enter IS-IS router configuration mode",
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 00.0005.0000.0000.0003.00",
            "explanation": "Set the name of the IS-IS network entity (NET)",
            "parameters": [
                {
                    "name": "NET",
                    "type": "string",
                    "explanation": "Network Entity Title"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-2-only",
            "explanation": "Set IS-IS router type only",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Router Type"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "Set IS-IS measurement style to be wide",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "Measurement style"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.3.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.3.1.1 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip rsvp bandwidth [parameter1]": {
            "template": "ip rsvp bandwidth [parameter1]",
            "command": "ip rsvp bandwidth 100000",
            "explanation": "Configure interfaced RSVP bandwidth with 100,000 kbps",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "Bandwidth (kbps)"
                }
            ]
        },
        "ip router isis [parameter1]": {
            "template": "ip router isis [parameter1]",
            "command": "ip router isis 1",
            "explanation": "Enable IS-IS router 1 on interface",
            "parameters": [
                {
                    "name": "process ID",
                    "type": "integer",
                    "explanation": "IS-IS Process ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
    }
}