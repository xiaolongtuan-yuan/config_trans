        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 100",
        "explanation": "Configure OSPF Process 100",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "mpls traffic-eng router-id [parameter1]": {
            "template": "mpls traffic-eng router-id [parameter1]",
            "command": "mpls traffic-eng router-id Loopback0",
            "explanation": "Configure Router ID for MPLS traffic project as IP address for Loopback0 interface",
            "parameters": [
                {
                    "name": "interface name",
                    "type": "string",
                    "explanation": "Interface Name"
                }
            ]
        },
        "mpls traffic-eng area [parameter1]": {
            "template": "mpls traffic-eng area [parameter1]",
            "command": "mpls traffic-eng area 0",
            "explanation": "Enable MPLS flow project in OSPF area 0",
            "parameters": [
                {
                    "name": "area id",
                    "type": "integer",
                    "explanation": "OSF Area ID"
                }
            ],
            "network [parameter1] [parameter2] area [parameter3]": {
                "template": "network [parameter1] [parameter2] area [parameter3]",
                "command": "network 10.1.5.0 0.0.0.255 area 0",
                "explanation": "Declares the network in OSPF area 010.1.5.0/24",
                "parameters": [
                    {
                        "name": "network address",
                        "type": "IPv4",
                        "explanation": "Chile"
                    },
                    {
                        "name": "wildcard mask",
                        "type": "IPv4",
                        "explanation": "Wildcard Mask"
                    },
                    {
                        "name": "area id",
                        "type": "integer",
                        "explanation": "OSF Area ID"
                    }
                ]
            }
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
    }
