            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "Channel Group Number"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "Gap Range"
                }
            ]
        }
    },
