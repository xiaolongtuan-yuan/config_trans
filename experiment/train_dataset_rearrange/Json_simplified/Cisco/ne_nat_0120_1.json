{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname CGNA",
        "explanation": "Set the host name of the device",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ip nat translation max-entries [parameter1]": {
        "template": "ip nat translation max-entries [parameter1]",
        "command": "ip nat translation max-entries 6",
        "explanation": "Sets the maximum number of entries in the NAT conversion table to 6",
        "parameters": [
            {
                "name": "max entries",
                "type": "integer",
                "explanation": "Maximum number of entries"
            }
        ]
    },
    "ip nat inside source static network [parameter1] [parameter2] [parameter3]": {
        "template": "ip nat inside source static network [parameter1] [parameter2] [parameter3]",
        "command": "ip nat inside source static network 192.168.10.128 255.255.255.128 11.11.11.101",
        "explanation": "Configure static mapping of the internal NAT source address, mapping the network to an external address of 11.11.11.1001",
        "parameters": [
            {
                "name": "inside network",
                "type": "IPv4",
                "explanation": "Internal Network Address"
            },
            {
                "name": "inside network mask",
                "type": "IPv4",
                "explanation": "Internal network mask"
            },
            {
                "name": "outside address",
                "type": "IPv4",
                "explanation": "External Address"
            }
        ]
    },
    "class-map [parameter1]": {
        "template": "class-map [parameter1]",
        "command": "class-map c1",
        "explanation": "Configure class map 'c1'",
        "parameters": [
            {
                "name": "class map name",
                "type": "string",
                "explanation": "Class map name"
            }
        ],
        "match access-group [parameter1]": {
            "template": "match access-group [parameter1]",
            "command": "match access-group 3001",
            "explanation": "Match Access Control List 3001",
            "parameters": [
                {
                    "name": "access list number",
                    "type": "integer",
                    "explanation": "Access control list number"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map b1",
        "explanation": "Configure Policy Map 'b1 '",
        "parameters": [
            {
                "name": "policy map name",
                "type": "string",
                "explanation": "PolicyMap Name"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class c1",
            "explanation": "Apply class map 'c1'",
            "parameters": [
                {
                    "name": "class map name",
                    "type": "string",
                    "explanation": "Class map name"
                }
            ],
            "service-policy [parameter1]": {
                "template": "service-policy [parameter1]",
                "command": "service-policy b1",
                "explanation": "Apply policy map 'b1'",
                "parameters": [
                    {
                        "name": "policy map name",
                        "type": "string",
                        "explanation": "PolicyMap Name"
                    }
                ]
