        "command": "interface GigabitEthernet 2/0/0",
        "explanation": "Configure interface 'GigabitEthernet 2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 192,168.10.1, the subnet mask is 255,255,255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
