            "explanation": "I'm not sure if it's a good idea.",
            "parameters": [
                {
                    "name": "address_family",
                    "type": "string",
                    "explanation": "Address family type"
                }
            ],
            "neighbor [ip_address] activate": {
                "template": "neighbor [ip_address] activate",
                "command": "neighbor 3.3.3.9 activate",
                "explanation": "Activates the BGP Nepal in this conclusion family",
