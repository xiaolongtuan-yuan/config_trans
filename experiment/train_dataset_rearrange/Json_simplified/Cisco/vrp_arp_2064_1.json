        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure interface 'GigabitEthernet1/0/1 '",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "Set interface mode to access mode",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Interface Mode"
                }
            ]
        },
        "switchport access vlan [parameter1]": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 3",
