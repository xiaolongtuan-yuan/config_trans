{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P3",
        "explanation": "Sets the device 's hostname 'P3 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "Enable MPLS IP function on interface"
    },
    "mpls traffic-eng tunnels": {
        "template": "mpls traffic-eng tunnels",
        "command": "mpls traffic-eng tunnels",
        "explanation": "Enable MPLS flow engineering tunnel on interface"
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.2.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.2.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "bandwidth [parameter1]": {
            "template": "bandwidth [parameter1]",
            "command": "bandwidth 20000",
            "explanation": "Set the bandwidth of the interface to 20000 kbps",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "Bandwidth, in kbps"
                }
            ]
        },
        "ip rsvp bandwidth [parameter1]": {
            "template": "ip rsvp bandwidth [parameter1]",
            "command": "ip rsvp bandwidth 20000",
            "explanation": "Set interfaced RSVP bandwidth to 20000 kbps",
            "parameters": [
                {
                    "name": "bandwidth",
                    "type": "integer",
                    "explanation": "RSVP bandwidth value in kbps"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Configure OSF Process 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSF Process ID"
            }
        ],
        "area [parameter1] nssa no-summary": {
            "template": "area [parameter1] nssa no-summary",
            "command": "area 0.0.0.0 nssa no-summary",
            "explanation": "Configure area 0 to NSSA and do not summarize external routes",
            "parameters": [
                {
                    "name": "area",
                    "type": "IPv4",
                    "explanation": "Area ID"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "Exit Configuration Mode"
    }
}