            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "Allow VLAN 2 to transfer on trunk link",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "Allowed VLAN ID number"
