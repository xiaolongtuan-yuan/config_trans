            "police 120000 8000 8000 conform-action transmit exceed-action transmit violate-action drop": {
                "template": "police [parameter1] [parameter2] [parameter3] conform-action [parameter4] exceed-action [parameter5] violate-action [parameter6]",
                "command": "police 120000 8000 8000 conform-action transmit exceed-action transmit violate-action drop",
                "explanation": "Limit traffic and set the rate of commitment information (%) The CIR is 120,000 bps and the promised sudden size (CBS) is 8000 bytes and the excess bytes is 8000 bytes. Flows that match CIR, more than CIR, but still within CBS, and more than CBS are discarded",
                "parameters": [
                    {
                        "name": "cir",
                        "type": "integer",
                        "explanation": "Commitment information rate, units bps"
                    },
                    {
                        "name": "cbs",
                        "type": "integer",
                        "explanation": "Promised sudden size, bytes"
                    },
                    {
                        "name": "ebs",
                        "type": "integer",
                        "explanation": "Oversized, bytes"
                    },
                    {
                        "name": "conform-action",
                        "type": "string",
                        "explanation": "Actions matching CIR. This is the transfer."
                    },
                    {
                        "name": "exceed-action",
                        "type": "string",
                        "explanation": "More than CIR, but still inside CBS, this is transmission."
                    },
                    {
                        "name": "violate-action",
                        "type": "string",
                        "explanation": "Actions beyond CBS, here's discard"
                    }
                ]
            }
        }
    },
