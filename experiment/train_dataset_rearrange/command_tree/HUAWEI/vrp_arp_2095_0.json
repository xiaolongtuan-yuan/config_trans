{
    "sysname DeviceA": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "arp expire-time 5": {
            "template": "arp expire-time [parameter1]",
            "command": "arp expire-time 5",
            "explanation": "Set the expiry time of ARP Table to 5 minutes",
            "parameters": [
                {
                    "name": "expire time",
                    "type": "integer",
                    "explanation": "Expiry time (minutes)"
                }
            ]
        },
        "arp static 10.1.1.2 interface-name mac-address": {
            "template": "arp static [parameter1] [parameter2] [parameter3]",
            "command": "arp static 10.1.1.2 interface-name mac-address",
            "explanation": "Configure static ARP entries, map IP address 10.1.1.2 to the MAC address of the specified interface",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "interface-name",
                    "type": "string",
                    "explanation": "Interface Name"
                },
                {
                    "name": "mac-address",
                    "type": "string",
                    "explanation": "MAC Address"
                }
            ]
        }
    },
    "return": {}
}