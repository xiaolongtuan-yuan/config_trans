{
    "sysname CE1": {
        "template": "sysname [hostname]",
        "command": "sysname CE1",
        "explanation": "Sets the device 's hostname 'CE1 '",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "vlan batch 2": {
        "template": "vlan batch [vlan-id-list]",
        "command": "vlan batch 2",
        "explanation": "Batch to create VLAN, here to create VLAN 2",
        "parameters": [
            {
                "name": "vlan-id-list",
                "type": "integer",
                "explanation": "VLAN ID list"
            }
        ]
    },
    "cfm version standard": {
        "template": "cfm version [version]",
        "command": "cfm version standard",
        "explanation": "Set CFM version to standard",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM version"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "Enable CFM",
        "parameters": []
    },
    "interface  GigabitEthernet1/0/1": {
        "portswitch": {
            "template": "portswitch",
            "command": "portswitch",
            "explanation": "Configure interfaces to exchange mode",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "port trunk allow-pass vlan 2": {
            "template": "port trunk allow-pass vlan [vlan-id-list]",
            "command": "port trunk allow-pass vlan 2",
            "explanation": "Allow VLAN 2 to trunk port",
            "parameters": [
                {
                    "name": "vlan-id-list",
                    "type": "integer",
                    "explanation": "List of VLAN IDs allowed"
                }
            ]
        }
    },
    "cfm md md1": {
        "template": "cfm md [md-name]",
        "command": "cfm md md1",
        "explanation": "Create or enter maintenance md1",
        "parameters": [
            {
                "name": "md-name",
                "type": "string",
                "explanation": "Maintain domain name"
            }
        ],
        "ma ma1": {
            "template": "ma [ma-name]",
            "command": "ma ma1",
            "explanation": "Create or enter maintenance association ma1",
            "parameters": [
                {
                    "name": "ma-name",
                    "type": "string",
                    "explanation": "Maintain Association Name"
                }
            ],
            "map vlan 2": {
                "template": "map vlan [vlan-id]",
                "command": "map vlan 2",
                "explanation": "Map VLAN 2 to MA",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id 2 interface GigabitEthernet1/0/1 outward": {
                "template": "mep mep-id [mep-id] interface [interface-name] [direction]",
                "command": "mep mep-id 2 interface GigabitEthernet1/0/1 outward",
                "explanation": "Configure MEP ID to 2, interface to GigabitEthernet 1/0/1, orientation to outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface-name",
                        "type": "string",
                        "explanation": "Interface Name"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "Direction, like inward or outward"
                    }
                ]
            },
            "mep ccm-send mep-id 2 enable": {
                "template": "mep ccm-send mep-id [mep-id] enable",
                "command": "mep ccm-send mep-id 2 enable",
                "explanation": "Enable CCM sent by MEP ID 2",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id 1": {
                "template": "remote-mep mep-id [mep-id]",
                "command": "remote-mep mep-id 1",
                "explanation": "Configure remote MEP ID to 1",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id 1 enable": {
                "template": "remote-mep ccm-receive mep-id [mep-id] enable",
                "command": "remote-mep ccm-receive mep-id 1 enable",
                "explanation": "Enable CCM to receive remote MEP ID 1",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "Remote MEP ID"
                    }
                ]
            },
            "test-id 1 mep 2": {
                "template": "test-id [test-id] mep [mep-id]",
                "command": "test-id 1 mep 2",
                "explanation": "Configure test ID 1 and MEP ID 2",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    },
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "loss-measure single-ended receive test-id 1": {
                "template": "loss-measure single-ended receive test-id [test-id]",
                "command": "loss-measure single-ended receive test-id 1",
                "explanation": "Configure single-end loss measurements, receive test ID 1",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID"
                    }
                ]
            }
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the next level",
        "parameters": []
    }
}