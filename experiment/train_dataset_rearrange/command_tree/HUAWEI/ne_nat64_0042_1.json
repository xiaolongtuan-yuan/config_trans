{
    "sysname HUAWEI": {
        "template": "sysname [parameter1]",
        "command": "sysname HUAWEI",
        "explanation": "Sets the device's hostname 'HUAWEI'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "license": {
        "active nat session-table size 16 slot 1 engine 0": {},
        "active nat64 vsuf slot 1": {}
    },
    "service-location 1": {
        "location slot 1 engine 0": {}
    },
    "service-instance-group 1": {
        "service-location 1": {}
    },
    "nat64 instance nat1 id 1": {
        "service-instance-group 1": {},
        "nat64 address-group address-group1 group-id 1 11.11.11.100 11.11.11.105": {},
        "nat64 outbound any address-group address-group1": {},
        "nat64 prefix 64:FF9B:: prefix-length 96 1": {}
    },
    "acl ipv6 number 3003": {
        "rule 5 permit ipv6 source 2001:db8::1:1112/126 destination 64:FF9B::/96": {}
    },
    "traffic classifier c1": {
        "if-match ipv6 acl 3003": {}
    },
    "traffic behavior b1": {
        "nat64 bind instance nat1": {}
    },
    "traffic policy p1": {
        "share-mode": {},
        "classifier c1 behavior b1": {}
    },
    "interface GigabitEthernet2/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/1",
        "explanation": "Configure interface GigabitEthernet2/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "Enable interface IPv6 functionality",
            "parameters": []
        },
        "ipv6 address 2001:db8::1:110e 126": {
            "template": "ipv6 address [parameter1] [parameter2]",
            "command": "ipv6 address 2001:db8::1:110e 126",
            "explanation": "Configure interface IPv6 address 2001: db8: 1:110e with prefix length 126",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 Address"
                },
                {
                    "name": "prefix length",
                    "type": "integer",
                    "explanation": "Prefix Length"
                }
            ]
        },
        "traffic-policy p1 inbound": {
            "template": "traffic-policy [parameter1] inbound",
            "command": "traffic-policy p1 inbound",
            "explanation": "Application of traffic policy p1 into the interface",
            "parameters": [
                {
                    "name": "traffic policy name",
                    "type": "string",
                    "explanation": "Traffic Policy Name"
                }
            ]
        }
    },
    "return": {}
