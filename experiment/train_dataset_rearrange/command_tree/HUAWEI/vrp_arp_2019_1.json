{
    "sysname Device": {
        "template": "sysname [parameter1]",
        "command": "sysname Device",
        "explanation": "Sets the device 's hostname 'Device '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "arp speed-limit destination-ip maximum 50 slot 1": {
        "template": "arp speed-limit [parameter1] maximum [parameter2] slot [parameter3]",
        "command": "arp speed-limit destination-ip maximum 50 slot 1",
        "explanation": "Set ARP speed limit with a maximum IP value of 50 at destination, slot 1",
        "parameters": [
            {
                "name": "type",
                "type": "string",
                "explanation": "Limit type, here is destinization-ip"
            },
            {
                "name": "maximum value",
                "type": "integer",
                "explanation": "Maximum"
            },
            {
                "name": "slot",
                "type": "integer",
                "explanation": "Slot"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure the specified interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "arp learning strict force-enable": {
            "template": "arp learning [parameter1] [parameter2]",
            "command": "arp learning strict force-enable",
            "explanation": "Set the ARP learning mode to be strict and enforced",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Learning mode. This is Stict."
                },
                {
                    "name": "force-enable",
                    "type": "boolean",
                    "explanation": "Whether to enforce"
                }
            ]
        },
        "arp-limit maximum 20": {
            "template": "arp-limit maximum [parameter1]",
            "command": "arp-limit maximum 20",
            "explanation": "Set ARP entry maximum of 20",
            "parameters": [
                {
                    "name": "maximum value",
                    "type": "integer",
                    "explanation": "Max. ARP entries"
                }
            ]
        }
    },
    "return": {}
