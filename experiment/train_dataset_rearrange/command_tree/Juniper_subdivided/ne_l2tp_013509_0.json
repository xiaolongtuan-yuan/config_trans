    "set system radius-server 10.20.20.1": {
        "template": "set system radius-server [parameter1]",
        "command": "set system radius-server 10.20.20.1",
        "explanation": "Configures a RADIUS server with the specified parameters, such as IP address, port, and shared secret, for network authentication and accounting purposes.",
        "parameters": [
            {
                "name": "radius-server-ip",
                "type": "string",
                "explanation": "IP address of RADIUS server."
            }
        ],
        "port 1812": {
            "template": "port [parameter2]",
            "command": "port 1812",
            "explanation": "Configures the RADIUS server with `[parameter1]` as the server address and `[parameter2]` as the port number for authentication and accounting communication.",
            "parameters": [
                {
                    "name": "port",
                    "type": "integer",
                    "explanation": "Port number for the RADIGUS server."
                }
            ],
            "secret <key>": {
                "template": "secret [parameter3]",
                "command": "secret <key>",
                "explanation": "Configure the IP address, port and shared key of the RADIUS server.",
                "parameters": [
                    {
                        "name": "secret",
                        "type": "string",
                        "explanation": "Share key for RADIGUS server."
                    }
                ]
            }
        },
        "accounting-port 1813": {
            "template": "accounting-port [parameter2]",
            "command": "accounting-port 1813",
