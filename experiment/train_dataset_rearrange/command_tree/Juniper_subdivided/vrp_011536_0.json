{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan-2": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 2": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set ethernet-switching-options cfm mep-database md md1": {
        "template": "set ethernet-switching-options cfm mep-database md [parameter1]",
        "command": "set ethernet-switching-options cfm mep-database md md1",
        "explanation": "This command configures a Maintenance End Point (MEP) database for Connectivity Fault Management (CFM) under a specific Maintenance Domain (MD) named `[parameter1]`.",
        "parameters": [
            {
                "name": "md",
                "type": "string",
                "explanation": "Maintains domain names."
            }
        ],
        "ma ma2": {
            "template": "ma [parameter2]",
            "command": "ma ma2",
            "explanation": "This command configures a Connectivity Fault Management (CFM) Maintenance End Point (MEP) database with specified Maintenance Domain (MD) and Maintenance Association (MA) parameters.",
            "parameters": [
                {
                    "name": "ma",
                    "type": "string",
                    "explanation": "Maintain associated name."
                }
            ],
            "vlan-id 2": {
                "template": "vlan-id [parameter3]",
                "command": "vlan-id 2",
                "explanation": "This command configures a Connectivity Fault Management (CFM) Maintenance End Point (MEP) database for a specific Maintenance Domain (MD) and Association (MA) within a VLAN.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID."
                    }
                ],
                "mep-id 3": {
                    "template": "mep-id [parameter4]",
                    "command": "mep-id 3",
                    "explanation": "This command configures a Connectivity Fault Management (CFM) Maintenance End Point (MEP) in the specified Maintenance Domain (MD), Association (MA), VLAN, and with a unique MEP ID.",
                    "parameters": [
                        {
                            "name": "mep-id",
                            "type": "integer",
                            "explanation": "MEP ID."
                        }
                    ],
                    "interface ge-1/0/1": {
                        "template": "interface [parameter5]",
                        "command": "interface ge-1/0/1",
                        "explanation": "Configures a Connectivity Fault Management (CFM) Maintenance End Point (MEP) database entry for a specific VLAN and interface in Junos.",
                        "parameters": [
                            {
                                "name": "interface",
                                "type": "string",
                                "explanation": "interface name."
                            }
                        ],
                        "direction outward": {
                            "template": "direction [parameter6]",
                            "command": "direction outward",
                            "explanation": "Configure the CFM MEP database, specifying MD, MA, VLAN ID, MEP ID, interface and direction.",
                            "parameters": [
                                {
                                    "name": "direction",
                                    "type": "string",
                                    "explanation": "MEP direction, outward or inward."
                                }
                            ]
                        }
                    },
                    "ccm-enable": {
                        "template": "ccm-enable",
                        "command": "ccm-enable",
                        "explanation": "Enables CCM for CFM MEP.",
                        "parameters": []
                    },
                    "remote-mep 4": {
                        "template": "remote-mep [parameter5]",
                        "command": "remote-mep 4",
                        "explanation": "Configure the remote MEP for CFM MEP.",
                        "parameters": [
                            {
                                "name": "remote-mep",
                                "type": "integer",
                                "explanation": "Remote MEP ID number."
                            }
                        ]
                    },
                    "loss-measurement single-ended receive test-id 2": {
                        "template": "loss-measurement single-ended receive test-id [parameter5]",
                        "command": "loss-measurement single-ended receive test-id 2",
                        "explanation": "Configures a single-end receipt measurement for CFM MEP.",
                        "parameters": [
                            {
                                "name": "test-id",
                                "type": "integer",
                                "explanation": "Test ID."
                            }
                        ]
                    }
                }
            }
        }
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode trunk": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            },
            "family ethernet-switching vlan members vlan-2": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members vlan-2",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "disable": {
                "template": "disable",
                "command": "disable",
                "explanation": "Disables the specified interface unit.",
                "parameters": []
            }
        }
    }
}