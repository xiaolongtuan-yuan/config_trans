{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name HUAWEI",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system authentication-order [parameter1]": {
        "template": "set system authentication-order [parameter1]",
        "command": "set system authentication-order radius",
        "explanation": "Configure the authentication order of the system.",
        "parameters": [
            {
                "name": "authentication-method",
                "type": "string",
                "explanation": "Authentication methods, such as Radius."
            }
        ]
    },
    "set system login user [parameter1]": {
        "template": "set system login user [parameter1]",
        "command": "set system login user noauth",
        "explanation": "This command fragment configures a user account on a Junos device, where `[parameter1]` specifies the username for login authentication and management access.",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "User name."
            }
        ],
        "class [parameter2]": {
            "template": "class [parameter2]",
            "command": "class super-user",
            "explanation": "Configure the type of system login user.",
            "parameters": [
                {
                    "name": "user-class",
                    "type": "string",
                    "explanation": "User categories, e.g. super-user."
                }
            ]
        },
        "authentication plain-text-password [parameter2]": {
            "template": "authentication plain-text-password [parameter2]",
            "command": "authentication plain-text-password \"\"",
            "explanation": "Configure the system login user's authentication as an explicit password.",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Express password."
                }
            ]
        }
    },
    "set system services dhcp-local-server group [parameter1]": {
        "template": "set system services dhcp-local-server group [parameter1]",
        "command": "set system services dhcp-local-server group DHCP-Pool1",
        "explanation": "Configure DHCP local server group.",
        "parameters": [
            {
                "name": "group-name",
                "type": "string",
                "explanation": "Name of DHCP server group."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface irb.1",
            "explanation": "Specify an interface for the DHCP server group.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name and unit number, e.g. g-1/0/1.1."
                }
            ]
        }
    },
    "set access address-assignment pool [parameter1]": {
        "template": "set access address-assignment pool [parameter1]",
        "command": "set access address-assignment pool pool1",
        "explanation": "This command fragment configures an address-assignment pool named `[parameter1]` for dynamic IP address allocation in Junos.",
        "parameters": [
            {
                "name": "pool-name",
                "type": "string",
                "explanation": "Address allocated pool name."
            }
        ],
        "family inet network [parameter2]/[parameter3]": {
            "template": "family inet network [parameter2]/[parameter3]",
            "command": "family inet network 10.10.10.0/24",
            "explanation": "Configure the network address and subnet mask for the distribution pool.",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "Web address."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "bits of subnet mask."
                }
            ]
        },
        "family inet range [parameter2]": {
            "template": "family inet range [parameter2]",
            "command": "family inet range pool1-range",
            "explanation": "Configures an IPv4 address range (`parameter2`) within an address-assignment pool (`parameter1`) for dynamic host configuration.",
            "parameters": [
                {
                    "name": "range-name",
                    "type": "string",
                    "explanation": "Name of the address range."
                }
            ],
            "low [parameter3]": {
                "template": "low [parameter3]",
                "command": "low 10.10.10.3",
                "explanation": "Configures the minimum address range of the address pool.",
                "parameters": [
                    {
                        "name": "low-address",
                        "type": "string",
                        "explanation": "address range."
                    }
                ]
            },
            "high [parameter3]": {
                "template": "high [parameter3]",
                "command": "high 10.10.10.100",
                "explanation": "Configure the maximum address range for the distribution pool.",
                "parameters": [
                    {
                        "name": "high-address",
                        "type": "string",
                        "explanation": "The maximum address for the address range."
                    }
                ]
            }
        },
        "family inet dhcp-attributes router [parameter2]": {
            "template": "family inet dhcp-attributes router [parameter2]",
            "command": "family inet dhcp-attributes router 10.10.10.2",
            "explanation": "The address of the router that configures DHCP properties.",
            "parameters": [
                {
                    "name": "router-address",
                    "type": "string",
                    "explanation": "Router's IP address."
                }
            ]
        },
        "family inet dhcp-attributes name-server [parameter2]": {
            "template": "family inet dhcp-attributes name-server [parameter2]",
            "command": "family inet dhcp-attributes name-server 10.20.20.1",
            "explanation": "Configures the name server address for DHCP properties.",
            "parameters": [
                {
                    "name": "name-server-address",
                    "type": "string",
                    "explanation": "Name server's IP address."
                }
            ]
        }
    },
    "set access profile [parameter1]": {
        "template": "set access profile [parameter1]",
        "command": "set access profile isp1",
        "explanation": "This command fragment sets an access profile in Junos, defining a named profile (parameter1) to configure security policies, authentication, or authorization settings for network access.",
        "parameters": [
            {
                "name": "profile-name",
                "type": "string",
                "explanation": "Accesses the name of the profile."
            }
        ],
        "authentication-order [parameter2]": {
            "template": "authentication-order [parameter2]",
            "command": "authentication-order none",
            "explanation": "Configures the authentication order for access to the profile.",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "Method of authentication, e.g. none."
                }
            ]
        },
        "client user [parameter2]": {
            "template": "client user [parameter2]",
            "command": "client user noauth",
            "explanation": "Configure the client who accesses the profile.",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "User name."
                }
            ]
        },
        "address-assignment pool [parameter2]": {
            "template": "address-assignment pool [parameter2]",
            "command": "address-assignment pool pool1",
            "explanation": "Configure the address distribution pool for access to the configuration file.",
            "parameters": [
                {
                    "name": "pool-name",
                    "type": "string",
                    "explanation": "Address allocated pool name."
                }
            ]
        }
    },
    "set vlans [parameter1]": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan1",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 1",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        },
        "l3-interface [parameter2]": {
            "template": "l3-interface [parameter2]",
            "command": "l3-interface irb.1",
            "explanation": "Configure VLAN's L3 interface.",
            "parameters": [
                {
                    "name": "l3-interface",
                    "type": "string",
                    "explanation": "L3 interface name."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching port-mode [parameter3]": {
                "template": "family ethernet-switching port-mode [parameter3]",
                "command": "family ethernet-switching port-mode access",
                "explanation": "Configure the interface 's port mode is trunk.",
                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
                        "explanation": "Port mode, for example, trunk."
                    }
                ]
            },
            "family ethernet-switching vlan members [parameter3]": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members vlan1",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.10.10.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}