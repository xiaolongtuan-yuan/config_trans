{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "tunnel source [parameter3]": {
                "template": "tunnel source [parameter3]",
                "command": "tunnel source 10.1.1.1",
                "explanation": "Configure tunnel source interfaces.",
                "parameters": [
                    {
                        "name": "source-interface",
                        "type": "string",
                        "explanation": "Name of tunnel source interface, e.g. lo0.0."
                    }
                ]
            },
            "tunnel destination [parameter3]": {
                "template": "tunnel destination [parameter3]",
                "command": "tunnel destination 0.0.0.0",
                "explanation": "Configure the tunnel destination address.",
                "parameters": [
                    {
                        "name": "destination-address",
                        "type": "string",
                        "explanation": "Tunnel destination address."
                    }
                ]
            },
            "family inet6 address [parameter3]/[parameter4]": {
                "template": "family inet6 address [parameter3]/[parameter4]",
                "command": "family inet6 address 2001:db8:101:100::1/56",
                "explanation": "Configure the IPv6 address of the interface and the length of the subnet prefix.",
                "parameters": [
                    {
                        "name": "ipv6-address",
                        "type": "string",
                        "explanation": "The IPv6 address assigned to the interface."
                    },
                    {
                        "name": "prefix-length",
                        "type": "integer",
                        "explanation": "Subnet prefix length for IPv6."
                    }
                ]
            },
            "tunnel mode [parameter3]": {
                "template": "tunnel mode [parameter3]",
                "command": "tunnel mode 6rd",
                "explanation": "The command `tunnel mode [parameter3]` in Junos sets the encapsulation mode for a tunnel interface, where `[parameter3]` specifies the protocol (e.g., GRE, IPIP).",
                "parameters": [
                    {
                        "name": "mode",
                        "type": "string",
                        "explanation": "Tunnel pattern, for example, 6rd."
                    }
                ]
            },
            "6rd prefix [parameter3]/[parameter4]": {
                "template": "6rd prefix [parameter3]/[parameter4]",
                "command": "6rd prefix 2001:db8::/32",
                "explanation": "The command configures a 6rd (IPv6 Rapid Deployment) prefix with the specified IPv6 prefix (`[parameter3]`) and prefix length (`[parameter4]`) for IPv6 over IPv4 tunneling.",
                "parameters": [
                    {
                        "name": "prefix",
                        "type": "string",
                        "explanation": "6rd Tunnel IPv6 prefix."
                    },
                    {
                        "name": "prefix-length",
                        "type": "integer",
                        "explanation": "Length of prefix IPv6."
                    }
                ]
            },
            "6rd ipv4-prefix-length [parameter3]": {
                "template": "6rd ipv4-prefix-length [parameter3]",
                "command": "6rd ipv4-prefix-length 8",
                "explanation": "The command sets the length of the IPv4 prefix used in 6rd (IPv6 Rapid Deployment) tunnels, where `[parameter3]` specifies the prefix length in bits.",
                "parameters": [
                    {
                        "name": "ipv4-prefix-length",
                        "type": "integer",
                        "explanation": "6rd Tunnel IPv4 prefix length."
                    }
                ]
            }
        }
    },
    "set routing-options rib [parameter1]": {
        "template": "set routing-options rib [parameter1]",
        "command": "set routing-options rib inet6.0",
        "explanation": "This command fragment creates or modifies a custom Routing Information Base (RIB) named `[parameter1]` within the routing options, allowing for separate routing tables.",
        "parameters": [
            {
                "name": "rib",
                "type": "string",
                "explanation": "RIB name, e.g. not."
            }
        ],
        "static route [parameter2]": {
            "template": "static route [parameter2]",
            "command": "static route 2001:db8::/32",
            "explanation": "This command adds a static route `[parameter2]` to the specified Routing Information Base (RIB) `[parameter1]` in Junos routing configuration.",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "Target IPv6 network address and prefix length."
                }
            ],
            "next-hop [parameter3]": {
                "template": "next-hop [parameter3]",
                "command": "next-hop gr-0/0/0.1",
                "explanation": "Configure IPv6 static routers.",
                "parameters": [
                    {
                        "name": "next-hop",
                        "type": "string",
                        "explanation": "Next jump IPv6 address."
                    }
                ]
            }
        }
    }
}