        ]
    },
    "set services l2tp enable": {
        "template": "set services l2tp enable",
        "command": "set services l2tp enable",
        "explanation": "Enables the L2TP service.",
        "parameters": []
    },
    "set services l2tp lns-group [parameter1]": {
        "template": "set services l2tp lns-group [parameter1]",
        "command": "set services l2tp lns-group LNS",
        "explanation": "This command configures an L2TP LNS (Layer 2 Tunneling Protocol Network Server) group named `[parameter1]` for handling L2TP tunnel connections in a Junos device.",
        "parameters": [
            {
                "name": "lns-group",
                "type": "string",
                "explanation": "The name of the LNS group."
            }
        ],
        "tunnel password [parameter2]": {
            "template": "tunnel password [parameter2]",
            "command": "tunnel password <password>",
            "explanation": "Configure the tunnel password for the L2TP LNS group.",
            "parameters": [
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Tunnel code."
                }
            ]
        },
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface vt-1/0/0",
            "explanation": "Configure interfaces for L2TP LNS groups.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "interface name."
                }
            ]
        }
    },
    "set access profile [parameter1]": {
        "template": "set access profile [parameter1]",
        "command": "set access profile radius-profile",
        "explanation": "This command fragment sets an access profile in Junos, defining a named profile (parameter1) to configure security policies, authentication, or authorization settings for network access.",
        "parameters": [
            {
                "name": "profile-name",
                "type": "string",
                "explanation": "Accesses the name of the profile."
            }
        ],
        "authentication-order [parameter2]": {
            "template": "authentication-order [parameter2]",
            "command": "authentication-order radius",
            "explanation": "Configures the authentication order for access to the profile.",
            "parameters": [
                {
                    "name": "authentication-method",
                    "type": "string",
                    "explanation": "Method of authentication, e.g. none."
                }
            ]
        },
        "radius-server [parameter2]": {
            "template": "radius-server [parameter2]",
            "command": "radius-server 10.20.20.1",
            "explanation": "This command configures a RADIUS server for an access profile, where `[parameter1]` is the profile name and `[parameter2]` is the RADIUS server IP address or hostname.",
            "parameters": [
                {
                    "name": "radius-server",
                    "type": "string",
                    "explanation": "IP address of RADIUS server."
                }
            ],
            "port [parameter3]": {
                "template": "port [parameter3]",
                "command": "port 1812",
                "explanation": "This Junos command configures a RADIUS server on a specified port within an access profile for authentication purposes.",
                "parameters": [
                    {
                        "name": "port",
                        "type": "integer",
                        "explanation": "Port number for the RADIGUS server."
                    }
                ],
                "secret [parameter4]": {
                    "template": "secret [parameter4]",
                    "command": "secret <key>",
                    "explanation": "Configures the address, port and shared key of the RADIUS server.",
                    "parameters": [
                        {
                            "name": "secret",
                            "type": "string",
                            "explanation": "Share key for RADIGUS server."
                        }
                    ]
                }
            }
        },
        "accounting-port [parameter2]": {
            "template": "accounting-port [parameter2]",
            "command": "accounting-port 1813",
            "explanation": "Configure RADIUS billing port.",
            "parameters": [
                {
                    "name": "accounting-port",
                    "type": "integer",
                    "explanation": "RADIUS billing port number."
                }
            ]
        }
    },
    "set access address-assignment pool [parameter1]": {
        "template": "set access address-assignment pool [parameter1]",
        "command": "set access address-assignment pool bas",
        "explanation": "This command fragment configures an address-assignment pool named `[parameter1]` for dynamic IP address allocation in Junos.",
        "parameters": [
            {
                "name": "pool-name",
                "type": "string",
                "explanation": "Address allocated pool name."
            }
        ],
        "family inet network [parameter2]/[parameter3]": {
            "template": "family inet network [parameter2]/[parameter3]",
            "command": "family inet network 192.168.0.0/24",
            "explanation": "Configure the network address and subnet mask for the distribution pool.",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "Web address."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "bits of subnet mask."
                }
            ]
        },
        "family inet range [parameter2]": {
            "template": "family inet range [parameter2]",
            "command": "family inet range 192.168.0.10-192.168.0.100",
            "explanation": "Configures an IPv4 address range (`parameter2`) within an address-assignment pool (`parameter1`) for dynamic host configuration.",
            "parameters": [
                {
                    "name": "range-name",
                    "type": "string",
                    "explanation": "Name of the address range."
                }
            ],
            "-[parameter3]": {
                "template": "-[parameter3]",
                "command": "",
                "explanation": "This command fragment configures an IPv4 address pool (`family inet`) with a range of IP addresses (`range [parameter2]-[parameter3]`) in the specified address-assignment pool (`[parameter1]`).",
                "parameters": [
                    {
                        "name": "end-address",
                        "type": "string",
                        "explanation": "End address of address range."
                    }
                ]
            }
        }
    },
