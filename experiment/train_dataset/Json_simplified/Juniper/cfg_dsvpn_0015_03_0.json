                ]
            },
            "tunnel destination [parameter3]": {
                "template": "tunnel destination [parameter3]",
                "command": "tunnel destination 172.16.1.2",
                "explanation": "Configure the tunnel destination address.",
                "parameters": [
                    {
                        "name": "destination-address",
                        "type": "string",
                        "explanation": "Tunnel destination address."
                    }
                ]
            },
            "tunnel key [parameter3]": {
                "template": "tunnel key [parameter3]",
                "command": "tunnel key 100",
