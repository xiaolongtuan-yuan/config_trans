{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols mpls ldp router-id [parameter1]": {
        "template": "set protocols mpls ldp router-id [parameter1]",
        "command": "set protocols mpls ldp router-id 1.1.1.9",
        "explanation": "Configures the Router ID of the LDP protocol.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID for LDP protocol."
            }
        ]
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0.0.0.0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2] [parameter3]": {
            "template": "interface [parameter2] [parameter3]",
            "command": "interface lo0.0 passive",
            "explanation": "Configure the OSPF protocol area and interface and set the interface to passive mode.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "interface name."
                },
                {
                    "name": "passive",
                    "type": "string",
                    "explanation": "Sets the interface to passive mode and does not send the OSF Hello package."
                }
            ]
        },
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-0/0/0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "mpls": {
                "template": "mpls",
                "command": "mpls",
                "explanation": "Enables MPLS on the interface.",
                "parameters": []
            },
            "encapsulation [parameter3]": {
                "template": "encapsulation [parameter3]",
                "command": "encapsulation mpls",
                "explanation": "Configure the envelope type of the interface.",
                "parameters": [
                    {
                        "name": "encapsulation",
                        "type": "string",
                        "explanation": "Cover type, e.g., pp."
                    }
                ]
            },
            "xconnect peer-address [parameter3]": {
                "template": "xconnect peer-address [parameter3]",
                "command": "xconnect peer-address 3.3.3.9",
                "explanation": "This command configures a point-to-point Layer 2 VPN connection (xconnect) on a Junos interface unit, specifying the peer device's IP address for the pseudowire.",
                "parameters": [
                    {
                        "name": "peer-address",
                        "type": "string",
                        "explanation": "Peer address to specify the cross-connected peer address."
                    }
                ],
                "vpn-id [parameter4]": {
                    "template": "vpn-id [parameter4]",
                    "command": "vpn-id 101",
                    "explanation": "Configure the interface unit's cross-connection, specifying the equivalent address and VPN ID.",
                    "parameters": [
                        {
                            "name": "vpn-id",
                            "type": "integer",
                            "explanation": "VPN ID for identification of VPN."
                        }
                    ]
                }
            }
        },
        "encapsulation [parameter2]": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation vlan-ccc",
            "explanation": "Configure the type of envelope for the sub-interface.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover type, e.g. othernet-bridging."
                }
            ]
        },
        "vlan-id [parameter2]": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 1",
            "explanation": "Configure VLAN IDs for sub-interfaces.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, used to identify different VLANs."
                }
            ]
        }
    }
}