{
    "set system host-name [parameter1]": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces [parameter1]": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit [parameter2]": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address [parameter3]/[parameter4]": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.20.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set protocols bgp group [parameter1]": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group internal",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type [parameter2]": {
            "template": "type [parameter2]",
            "command": "type internal",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, for example, external."
                }
            ]
        },
        "neighbor [parameter2]": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 10.20.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ],
            "peer-as [parameter3]": {
                "template": "peer-as [parameter3]",
                "command": "peer-as 100",
                "explanation": "Configure the BGP group's neighbours and their equivalents.",
                "parameters": [
                    {
                        "name": "peer-as",
                        "type": "integer",
                        "explanation": "Peer AS."
                    }
                ]
            },
            "family [parameter3] [parameter4]": {
                "template": "family [parameter3] [parameter4]",
                "command": "family inet unicast",
                "explanation": "The address of the neighbours of the BGP group is IPv6.",
                "parameters": [
                    {
                        "name": "address-family",
                        "type": "string",
                        "explanation": "Address community type, e.g., inert6."
                    },
                    {
                        "name": "sub-address-family",
                        "type": "string",
                        "explanation": "Sub-address type, e.g., unicast."
                    }
                ]
            }
        },
        "family [parameter2] [parameter3]": {
            "template": "family [parameter2] [parameter3]",
            "command": "family inet unicast",
            "explanation": "Configure BGP teams to support the IPv6 solo community.",
            "parameters": [
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "Address community type, e.g., inert6."
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "Address family subtype, e.g., unicast."
                }
            ]
        },
        "import-route [parameter2]": {
            "template": "import-route [parameter2]",
            "command": "import-route connected",
            "explanation": "The command `import-route [parameter2]` imports routes from the specified routing instance or protocol (parameter2) into the current routing table.",
            "parameters": [
                {
                    "name": "import-route",
                    "type": "string",
                    "explanation": "The type of route being imported, such as \"connected.\""
                }
            ]
        }
    },
    "set protocols ospf area [parameter1]": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface [parameter2]": {
            "template": "interface [parameter2]",
            "command": "interface ge-1/0/0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    }
}