                }
            ]
        }
    },
    "set policy-options policy-statement [parameter1]": {
        "template": "set policy-options policy-statement [parameter1]",
        "command": "set policy-options policy-statement static-to-ospf",
        "explanation": "This command fragment defines a routing policy named `[parameter1]` in Junos, allowing you to configure specific routing rules, actions, and conditions for traffic control.",
        "parameters": [
            {
                "name": "policy-statement",
                "type": "string",
                "explanation": "name of the policy statement."
            }
        ],
        "term [parameter2]": {
            "template": "term [parameter2]",
            "command": "term 1",
