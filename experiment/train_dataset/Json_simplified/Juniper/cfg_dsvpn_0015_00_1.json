            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    },
    "set protocols ospf export [parameter1]": {
        "template": "set protocols ospf export [parameter1]",
