        "explanation": "Map COS 2 to DSCP 46",
        "parameters": [
            {
                "name": "cos value",
                "type": "integer",
                "explanation": "Class of Service"
            },
            {
                "name": "dscp value",
                "type": "integer",
                "explanation": "Different Services Code Point"
            }
        ]
    },
    "vlan [parameter1]": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "Create or configure VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identifier"
            }
        ],
        "name [parameter1]": {
            "template": "name [parameter1]",
            "command": "name VLAN10",
            "explanation": "Set VLAN name to 'VLAN10'",
            "parameters": [
                {
                    "name": "vlan name",
                    "type": "string",
                    "explanation": "Name of VLAN"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
