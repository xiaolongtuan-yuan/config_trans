{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mls qos map cos-dscp [parameter1] [parameter2]": {
        "template": "mls qos map cos-dscp [parameter1] [parameter2]",
