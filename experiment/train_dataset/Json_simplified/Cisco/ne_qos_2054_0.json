        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "switchport mode [parameter1]": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set interface to trunk mode",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Interface mode such as access or trunk"
                }
            ]
        },
        "switchport trunk allowed vlan [parameter1]": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "Allow VLAN 10 to pass on trunk",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "list of integers",
                    "explanation": "Allowed VLAN List"
                }
            ]
        },
        "mls qos trust [parameter1]": {
            "template": "mls qos trust [parameter1]",
            "command": "mls qos trust dscp",
            "explanation": "Trust DSCP values for QoS categories",
            "parameters": [
                {
                    "name": "trust type",
                    "type": "string",
                    "explanation": "Trusted QoS type, e. g. dscp or cos"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "service-policy output [parameter1]": {
            "template": "service-policy output [parameter1]",
            "command": "service-policy output QOS-POLICY",
            "explanation": "Apply policy map 'QOS-POLICY' in output direction",
            "parameters": [
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "Name of the policy"
                }
            ]
        }
    },
    "class-map match-any [parameter1]": {
        "template": "class-map match-any [parameter1]",
        "command": "class-map match-any EF-CLASS",
        "explanation": "Create a class map 'EF-CLASS' to match any flow that meets the condition",
        "parameters": [
            {
                "name": "class name",
                "type": "string",
                "explanation": "Class name"
            }
        ],
        "match dscp [parameter1]": {
            "template": "match dscp [parameter1]",
            "command": "match dscp ef",
            "explanation": "Flow matching DSCP value EF (46)",
            "parameters": [
                {
                    "name": "dscp value",
                    "type": "string or integer",
                    "explanation": "DSCP value, which can be a decimal number or name, e. g. ef"
                }
            ]
        }
    },
    "policy-map [parameter1]": {
        "template": "policy-map [parameter1]",
        "command": "policy-map QOS-POLICY",
        "explanation": "Create a policy map 'QOS-POLICY'",
