            {
                "name": "policy name",
                "type": "string",
                "explanation": "Name of the policy"
            }
        ],
        "class [parameter1]": {
            "template": "class [parameter1]",
            "command": "class EF-CLASS",
            "explanation": "Specify class 'EF-CLASS' in policy map",
            "parameters": [
                {
                    "name": "class name",
                    "type": "string",
                    "explanation": "Class name"
                }
            ],
            "set dscp [parameter1]": {
                "template": "set dscp [parameter1]",
                "command": "set dscp 34",
                "explanation": "Set DSCP value to 34",
                "parameters": [
                    {
                        "name": "dscp value",
                        "type": "integer",
                        "explanation": "DSCP value"
                    }
                ]
            }
