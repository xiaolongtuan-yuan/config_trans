{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "Sets the device 's hostname 'P '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/0",
        "explanation": "Configure interface 'GigabitEthernet2/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "Enable MPLS IP forwarding on interface",
            "parameters": []
        },
        "mpls ldp": {
            "template": "mpls ldp",
            "command": "mpls ldp",
            "explanation": "Enable MPLS LDP on interface",
            "parameters": []
        }
    },
    "mpls ldp router-id [parameter1]": {
        "template": "mpls ldp router-id [parameter1]",
        "command": "mpls ldp router-id Loopback0",
        "explanation": "Sets the router ID for MPLS LDP as the IP address for the Loopback0 interface",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enable OSF process 1",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "OSF Process ID"
            }
        ]
    }
}