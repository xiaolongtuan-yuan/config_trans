        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "Enable MPLS IP on interface",
            "parameters": []
        }
    },
    "mpls ldp router-id [parameter1]": {
        "template": "mpls ldp router-id [parameter1]",
        "command": "mpls ldp router-id Loopback0",
        "explanation": "Configure MPLS LDP router ID as IP address for Loopback0 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface name for the router ID"
            }
        ]
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Enter OSPF router configuration mode, process ID 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.10.1.0 0.0.0.255 area 0",
            "explanation": "Declaring networks 10.10.1.0, wildcard mask 0.0.0.255, area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Countermask"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF Area Number"
                }
            ]
        }
    }
