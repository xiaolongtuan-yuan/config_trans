{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname P",
        "explanation": "Sets the device 's hostname 'P '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "router isis": {
        "template": "router isis",
        "command": "router isis",
        "explanation": "Enable IS-IS route protocols",
        "parameters": []
    },
    "is-type [parameter1]": {
        "template": "is-type [parameter1]",
        "command": "is-type level-1",
        "explanation": "Set IS-IS type to Level-1",
        "parameters": [
            {
                "name": "level type",
                "type": "string",
                "explanation": "IS-IS level type, level-1 indicates only within region"
            }
        ]
    },
    "net [parameter1]": {
        "template": "net [parameter1]",
        "command": "net 49.0000.0000.0002.00",
        "explanation": "Configure IS-IS NET addresses",
        "parameters": [
            {
                "name": "net address",
                "type": "string",
                "explanation": "Name of IS-IS network entity (NET)"
            }
        ]
    },
    "ipv6 unicast-routing": {
        "template": "ipv6 unicast-routing",
        "command": "ipv6 unicast-routing",
        "explanation": "Enable IPv6 single router",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "Enable interface IPv6 functionality",
            "parameters": []
        },
        "ipv6 address [parameter1]": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:10::2/64",
            "explanation": "The IPv6 address for the configuration interface is 2001: db8:10:2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6 Address and Prefix Length"
                }
            ]
        },
        "ipv6 router isis [parameter1]": {
            "template": "ipv6 router isis [parameter1]",
            "command": "ipv6 router isis 1",
            "explanation": "Enable IPv6 route for IS-IS process 1 on interface",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS process ID"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 2.2.2.2 and the subnet mask is 255.255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
