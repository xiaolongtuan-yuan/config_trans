{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ip": {
        "template": "mpls ip",
        "command": "mpls ip",
        "explanation": "Enable MPLS IP functionality",
        "parameters": []
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "Set the LDP router ID to Loopback1 and enforce it",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface Name"
            },
            {
                "name": "force",
                "type": "keyword",
                "explanation": "Force specified interface as router ID"
            }
        ]
    },
    "router [parameter1]": {
        "template": "router [parameter1]",
        "command": "router isis",
        "explanation": "Enter ISIS router configuration mode",
        "parameters": [
            {
                "name": "routing protocol",
                "type": "string",
                "explanation": "Route protocol name"
            }
        ],
        "net [parameter1]": {
            "template": "net [parameter1]",
            "command": "net 49.0000.0000.0002.00",
            "explanation": "Configure NET addresses for ISIS",
            "parameters": [
                {
                    "name": "net address",
                    "type": "string",
                    "explanation": "ISIS' NET address"
                }
            ]
        },
        "is-type [parameter1]": {
            "template": "is-type [parameter1]",
            "command": "is-type level-1",
            "explanation": "Set ISIS type to Level-1",
            "parameters": [
                {
                    "name": "level",
                    "type": "string",
                    "explanation": "Level type of ISIS"
                }
            ]
        },
        "metric-style [parameter1]": {
            "template": "metric-style [parameter1]",
            "command": "metric-style wide",
            "explanation": "Set the measurement style as the width",
            "parameters": [
                {
                    "name": "style",
                    "type": "string",
                    "explanation": "Measurement style type"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.1.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis network [parameter1]": {
            "template": "isis network [parameter1]",
            "command": "isis network point-to-point",
            "explanation": "Configure ISIS network type as point-to-point",
            "parameters": [
                {
                    "name": "network type",
                    "type": "string",
                    "explanation": "Network Type"
                }
            ]
        },
        "isis metric [parameter1]": {
            "template": "isis metric [parameter1]",
            "command": "isis metric 10",
            "explanation": "Set ISIS to 10",
            "parameters": [
                {
                    "name": "metric",
                    "type": "integer",
                    "explanation": "Measure"
                }
            ]
        }
    }
}