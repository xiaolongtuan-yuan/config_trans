            },
            {
                "name": "end IP",
                "type": "IPv4",
                "explanation": "End IP address in pool"
            },
            {
                "name": "netmask",
                "type": "IPv4",
                "explanation": "Subnet mask"
            }
        ]
    },
    "ip nat inside source list [parameter1] pool [parameter2] overload": {
        "template": "ip nat inside source list [parameter1] pool [parameter2] overload",
        "command": "ip nat inside source list 3001 pool address-group1 overload",
        "explanation": "Configure NAT, which uses the ACL 3001-defined flow from the internal interface to source NAT through the Adress-group1 pool and allows port reuse",
        "parameters": [
            {
                "name": "ACL number",
                "type": "integer",
                "explanation": "Apply access control list number"
            },
            {
                "name": "pool name",
                "type": "string",
                "explanation": "Name of NAT pool used"
            },
            {
                "name": "overload",
                "type": "string",
                "explanation": "Allow port reuse"
            }
        ]
    },
