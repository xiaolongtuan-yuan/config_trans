        "parameters": []
    },
    "network-clock select [parameter1] [parameter2]": {
        "template": "network-clock select [parameter1] [parameter2]",
        "command": "network-clock select 1 BITS0",
        "explanation": "Select Clock Source 1 as BITS0",
        "parameters": [
            {
                "name": "时钟源编号",
                "type": "integer",
                "explanation": "Clock Source Number"
            },
            {
                "name": "时钟源名称",
                "type": "string",
                "explanation": "Name of the clock source"
            }
        ]
    },
    "network-clock select [parameter1] output [parameter2]": {
        "template": "network-clock select [parameter1] output [parameter2]",
        "command": "network-clock select 1 output 2M",
        "explanation": "Select output of clock source 1 as 2M",
        "parameters": [
            {
                "name": "时钟源编号",
                "type": "integer",
                "explanation": "Clock Source Number"
            },
            {
                "name": "输出类型",
                "type": "string",
                "explanation": "Output clock frequency"
            }
        ]
    },
