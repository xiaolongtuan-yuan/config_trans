{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "Configure interface 'Lmpif1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.110.0.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ppp authentication [parameter1]": {
            "template": "ppp authentication [parameter1]",
            "command": "ppp authentication pap",
            "explanation": "Configure PPP authentication as PAP",
            "parameters": [
                {
                    "name": "authentication type",
                    "type": "string",
                    "explanation": "Could not close temporary folder: %s"
                }
            ]
        },
        "ppp pap sent-username [parameter1] password [parameter2] [parameter3]": {
            "template": "ppp pap sent-username [parameter1] password [parameter2] [parameter3]",
            "command": "ppp pap sent-username rtb password 0 <password>",
            "explanation": "Configure send usernames and passwords for PPP PAP",
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "explanation": "Username sent"
                },
                {
                    "name": "password type",
                    "type": "integer",
                    "explanation": "Password type, 0 means explicit"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Password"
                }
            ]
        }
    }
}