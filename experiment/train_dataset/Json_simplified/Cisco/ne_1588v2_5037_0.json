{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp clock-domain [parameter1]": {
        "template": "ptp clock-domain [parameter1]",
        "command": "ptp clock-domain 1",
        "explanation": "Configure PTP (exact time protocol) clock domain 1",
        "parameters": [
            {
                "name": "clock domain number",
                "type": "integer",
                "explanation": "The number of the clock field"
            }
        ],
        "device-type [parameter1]": {
            "template": "device-type [parameter1]",
            "command": "device-type server",
            "explanation": "Set device type as server",
            "parameters": [
                {
                    "name": "device type",
                    "type": "string",
                    "explanation": "Device type, e.g. server or client"
                }
            ]
        },
        "local-ip [parameter1]": {
            "template": "local-ip [parameter1]",
            "command": "local-ip 1.1.1.1",
            "explanation": "Set local IP address to 1.1.1",
            "parameters": [
                {
                    "name": "local IP",
                    "type": "IPv4",
                    "explanation": "Local IP Address"
                }
            ]
        },
        "unicast-negotiate [parameter1]": {
            "template": "unicast-negotiate [parameter1]",
            "command": "unicast-negotiate enable",
            "explanation": "Enable radio consultations",
            "parameters": [
                {
                    "name": "negotiation status",
                    "type": "string",
                    "explanation": "Consultation status, e.g. enabled or disabled"
                }
            ]
        }
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "Configure Loopback0 interface",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 1.1.1.1 The subnet mask is 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
}