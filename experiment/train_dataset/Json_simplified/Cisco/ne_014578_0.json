{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname PE1",
        "explanation": "Sets the device 's hostname 'PE1 '",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "mpls ldp router-id [parameter1] [parameter2]": {
        "template": "mpls ldp router-id [parameter1] [parameter2]",
        "command": "mpls ldp router-id Loopback1 force",
        "explanation": "Force LDP router ID to Loopback1 address",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name for the router ID"
            },
            {
                "name": "force",
                "type": "keyword",
                "explanation": "Force router ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "mpls ip": {
            "template": "mpls ip",
            "command": "mpls ip",
            "explanation": "Enable MPLS IP on interface",
            "parameters": []
        },
        "encapsulation dot1Q [parameter1]": {
            "template": "encapsulation dot1Q [parameter1]",
            "command": "encapsulation dot1Q 1",
            "explanation": "Set the envelope for the sub-interface to dot1Q, VLAN ID to 1",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        },
        "xconnect [parameter1] [parameter2] encapsulation [parameter3]": {
            "template": "xconnect [parameter1] [parameter2] encapsulation [parameter3]",
            "command": "xconnect 3.3.3.9 101 encapsulation mpls",
            "explanation": "Configure cross-connection to remote PE 3.3.3.9, pseudo-ID 101, encapsulation MPLS",
            "parameters": [
                {
                    "name": "remote PE address",
                    "type": "IPv4",
                    "explanation": "Remote PE IP address"
                },
                {
                    "name": "pw id",
                    "type": "integer",
                    "explanation": "False LineID"
                },
                {
                    "name": "encapsulation type",
                    "type": "string",
                    "explanation": "Cover type, this is MPLS"
                }
            ]
        }
    },
    "router ospf [parameter1]": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "Access to OSPF process, process ID 1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "OSS Process ID"
            }
        ],
        "network [parameter1] [parameter2] area [parameter3]": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 1.1.1.9 0.0.0.0 area 0",
            "explanation": "Network 1.1.1.9/32 attributed to OSF Area 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "Chile"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "Countermask"
                },
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF Area Number"
                }
            ]
        }
    }
}