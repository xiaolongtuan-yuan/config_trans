        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Serial1/0/0",
        "explanation": "Configure interface 'Serial 1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "frame-relay interface-dlci [parameter1]": {
            "template": "frame-relay interface-dlci [parameter1]",
            "command": "frame-relay interface-dlci 100",
            "explanation": "Configure the DLCI number of the frame relay interface",
            "parameters": [
                {
                    "name": "dlci number",
                    "type": "integer",
                    "explanation": "DLCI number"
                }
            ]
        }
    },
    "interface [parameter1] [parameter2]": {
        "template": "interface [parameter1] [parameter2]",
        "command": "interface Serial1/0/0.1 point-to-point",
        "explanation": "Configure sub-interface 'Serial 1/0/0.1 ', type of point-to-point",
        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "Sub-interface name"
            },
            {
                "name": "subinterface type",
                "type": "string",
                "explanation": "Sub-interface Type"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.1.1, subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
