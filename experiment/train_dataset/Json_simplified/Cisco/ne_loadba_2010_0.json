{
    "hostname [parameter1]": {
        "template": "hostname [parameter1]",
        "command": "hostname routerA",
        "explanation": "Sets the device's hostname 'routerA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Port-channel1",
        "explanation": "Configure interface 'Port-channel1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.1 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.40.1, subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "channel-group [parameter1] mode [parameter2]": {
            "template": "channel-group [parameter1] mode [parameter2]",
            "command": "channel-group 1 mode active",
            "explanation": "Add interface to port channel group 1 and set the mode to active",
            "parameters": [
                {
                    "name": "group number",
                    "type": "integer",
                    "explanation": "Port Channel Group Number"
                },
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Working mode (active, passive, on etc.)"
                }
            ]
        }
    },
    "ip route [parameter1] [parameter2] [parameter3] [parameter4]": {
        "template": "ip route [parameter1] [parameter2] [parameter3] [parameter4]",
        "command": "ip route 10.20.1.0 255.255.255.0 GigabitEthernet2/0/0 10.30.1.2",
        "explanation": "Configure static routers, target network 10.20.1.0/24, next jump interface GigabitEthernet2/0/0, next jump IP 10.30.1.2",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "Destination Network Address"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "Subnet mask"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "Export interface"
            },
            {
                "name": "next hop IP",
                "type": "IPv4",
                "explanation": "Next Jump IP Address"
            }
        ]
    }
}