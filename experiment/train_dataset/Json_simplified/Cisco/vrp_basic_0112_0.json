{
    "username [parameter1] password [parameter2] [parameter3]": {
        "template": "username [parameter1] password [parameter2] [parameter3]",
        "command": "username huawei password 0 @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
        "explanation": "Creates a user named 'huawei' and sets the password to '@@@%UyQs4, KTtSwjo (4QmW#K, LC:@%@%', password type 0 (specify)",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "Username"
            },
            {
                "name": "password type",
                "type": "integer",
                "explanation": "Password type, 0 means explicit"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "Password"
            }
        ]
    },
