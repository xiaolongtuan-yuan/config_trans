{
    "interface [interface-name]": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configures the specified interface.",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "Name of interface, e.g. GihabitEthernet1/0/1"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enables the interface to unclose.",
            "parameters": []
        },
        "ip address [ip-address] [mask]": {
            "template": "ip address [ip-address] [mask]",
            "command": "ip address 2.1.1.1 255.255.255.0",
            "explanation": "Configure the IP address and subnet mask for the interface.",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "interface IP address."
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask."
                }
            ]
        }
    }
}