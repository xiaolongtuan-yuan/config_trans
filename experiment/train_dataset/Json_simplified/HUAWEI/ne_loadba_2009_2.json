{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname routerC",
        "explanation": "Set the host name of the device",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "isis [parameter1]": {
        "template": "isis [parameter1]",
        "command": "isis 1",
        "explanation": "Enable IS-IS process1",
        "parameters": [
            {
                "name": "process id",
                "type": "integer",
                "explanation": "IS-IS process ID"
            }
        ]
    },
    "is-level [parameter1]": {
        "template": "is-level [parameter1]",
        "command": "is-level level-1",
        "explanation": "Set IS-IS to level 1",
        "parameters": [
            {
                "name": "level",
                "type": "string",
                "explanation": "IS-IS level (level-1 or level-2)"
            }
        ]
    },
    "network-entity [parameter1]": {
        "template": "network-entity [parameter1]",
        "command": "network-entity 10.0000.0000.0003.00",
        "explanation": "Name of the network entity setting IS-IS",
        "parameters": [
            {
                "name": "net",
                "type": "string",
                "explanation": "Title of IS-IS network entity"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.40.1.2 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.40.1.2 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "isis enable [parameter1]": {
            "template": "isis enable [parameter1]",
            "command": "isis enable 1",
            "explanation": "Enable IS-IS process 1 on interface",
            "parameters": [
                {
                    "name": "process id",
                    "type": "integer",
                    "explanation": "IS-IS process ID"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "Quits the current configuration mode and returns the next level",
        "parameters": []
    }
}