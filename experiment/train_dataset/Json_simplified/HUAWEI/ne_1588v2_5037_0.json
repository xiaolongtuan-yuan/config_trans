{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ptp-adaptive enable": {
        "template": "ptp-adaptive enable",
        "command": "ptp-adaptive enable",
        "explanation": "Enable PTP self-adaptation",
        "parameters": []
    },
    "ptp-adaptive device-type [parameter1]": {
        "template": "ptp-adaptive device-type [parameter1]",
        "command": "ptp-adaptive device-type server",
        "explanation": "Set device type as server",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "Device type, e. g. 'server ' or 'client'"
            }
        ]
    },
    "ptp-adaptive local-ip [parameter1]": {
        "template": "ptp-adaptive local-ip [parameter1]",
        "command": "ptp-adaptive local-ip 1.1.1.1",
        "explanation": "Set local IP address to 1.1.1",
        "parameters": [
            {
                "name": "local IP",
                "type": "IPv4",
                "explanation": "Local IP Address"
            }
        ]
    },
    "ptp-adaptive acr unicast-negotiate enable": {
        "template": "ptp-adaptive acr unicast-negotiate enable",
        "command": "ptp-adaptive acr unicast-negotiate enable",
        "explanation": "Enable PTP ACR solo consultation",
        "parameters": []
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "Enter Loopback0 interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface name, e. g. 'Loopback0'"
            }
        ],
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 1.1.1.1 255.255.255.255",
            "explanation": "The IPv4 address for the configuration interface is 1.1.1.1 The subnet mask is 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    }
}