{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "Sets the device's host name 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface Lmpif1/0/0",
        "explanation": "Configure Specific Interfaces",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "link-protocol [parameter1]": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "Set interfaced chain layer protocol to PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "Chain Layer Protocol Name"
                }
            ]
        },
        "ip address [parameter1] [parameter2]": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.110.0.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.110.0.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ppp pap local-user [parameter1] password cipher [parameter2]": {
            "template": "ppp pap local-user [parameter1] password cipher [parameter2]",
            "command": "ppp pap local-user rtb password cipher <password>",
            "explanation": "PAP authentication to configure PPP, local user'rtb', password encrypted '<password>'",
            "parameters": [
                {
                    "name": "local-user",
                    "type": "string",
                    "explanation": "Local username"
                },
                {
                    "name": "password",
                    "type": "string",
                    "explanation": "Encryption password"
                }
            ]
        }
    }
}