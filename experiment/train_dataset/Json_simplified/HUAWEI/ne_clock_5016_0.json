{
    "sysname [parameter1]": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "Sets the data's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "HostName"
            }
        ]
    },
    "clock extend-ssm-control [parameter1]": {
        "template": "clock extend-ssm-control [parameter1]",
        "command": "clock extend-ssm-control on",
        "explanation": "It's not like you're going to have to do it.",
        "parameters": [
            {
                "name": "control state",
                "type": "string",
                "explanation": "Control status, on for ready, off for disabled"
            }
        ]
    },
    "clock bits-type [parameter1] [parameter2]": {
        "template": "clock bits-type [parameter1] [parameter2]",
        "command": "clock bits-type bits0 2mbps",
        "explanation": "Set BITS type to bits0, 2 mbps",
        "parameters": [
            {
                "name": "bits type",
                "type": "string",
                "explanation": "BITS Type"
            },
            {
                "name": "rate",
                "type": "string",
                "explanation": "Clock Rate"
            }
        ]
    },
    "clock source [parameter1] clock-id [parameter2]": {
        "template": "clock source [parameter1] clock-id [parameter2]",
        "command": "clock source bits0 clock-id 1",
        "explanation": "Set clock source to bits 0 and lock ID to 1",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "Clock Source"
            },
            {
                "name": "clock-id",
                "type": "integer",
                "explanation": "Clock ID"
            }
        ]
    },
    "interface [parameter1]": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Enter gigabitEthernet1/0/interface configuration mode",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "InterfaceName"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "(The interface is closed by default)",
            "parameters": []
        },
        "clock synchronization enable": {
            "template": "clock synchronization enable",
            "command": "clock synchronization enable",
            "explanation": "It's not like you're in trouble.",
            "parameters": []
        },
        "clock clock-id [parameter1]": {
            "template": "clock clock-id [parameter1]",
            "command": "clock clock-id 2",
            "explanation": "Set lock ID to 2",
            "parameters": [
                {
                    "name": "clock-id",
                    "type": "integer",
                    "explanation": "Clock ID"
                }
            ]
        },
        "clock priority [parameter1]": {
            "template": "clock priority [parameter1]",
            "command": "clock priority 3",
            "explanation": "Set lock capacity to 3",
            "parameters": [
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "Clark Priority"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
