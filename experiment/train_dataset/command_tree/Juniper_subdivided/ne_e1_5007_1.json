{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-0/0/2": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/2",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members 100": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members 100",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "encapsulation ppp": {
                "template": "encapsulation [parameter3]",
                "command": "encapsulation ppp",
                "explanation": "Configure the envelope type of the interface.",
                "parameters": [
                    {
                        "name": "encapsulation",
                        "type": "string",
                        "explanation": "Cover type, e.g., pp."
                    }
                ]
            },
            "mtu 1500": {
                "template": "mtu [parameter3]",
                "command": "mtu 1500",
                "explanation": "Configure the MTU size of the interface.",
                "parameters": [
                    {
                        "name": "mtu-size",
                        "type": "integer",
                        "explanation": "MTU size in bytes."
                    }
                ]
            },
            "family inet address 10.1.1.2/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "disable": {
                "template": "disable",
                "command": "disable",
                "explanation": "Disables the specified interface unit.",
                "parameters": []
            }
        },
        "disable": {
            "template": "disable",
            "command": "disable",
            "explanation": "Disables the specified interface.",
            "parameters": []
        }
    }
}