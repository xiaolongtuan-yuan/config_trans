            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set chassis network-clock synchronization": {
        "template": "set chassis network-clock synchronization",
        "command": "set chassis network-clock synchronization",
        "explanation": "Enables network clock sync.",
        "parameters": []
    },
    "set chassis network-clock source BITS0": {
        "template": "set chassis network-clock source [parameter1]",
        "command": "set chassis network-clock source BITS0",
        "explanation": "Configure the network clock source.",
        "parameters": [
            {
                "name": "source",
                "type": "string",
                "explanation": "Web clock source name, e.g. BITS0."
            }
        ]
    },
    "set chassis network-clock output-frequency 2M": {
        "template": "set chassis network-clock output-frequency [parameter1]",
        "command": "set chassis network-clock output-frequency 2M",
        "explanation": "Configure the network clock output frequency.",
        "parameters": [
            {
                "name": "frequency",
                "type": "string",
                "explanation": "Network clock output frequency, e.g. 2M."
            }
        ]
    },
    "set chassis network-clock priority 1 BITS0": {
        "template": "set chassis network-clock priority [parameter1] [parameter2]",
        "command": "set chassis network-clock priority 1 BITS0",
        "explanation": "Configure the priority of the web clock source.",
        "parameters": [
            {
                "name": "priority",
                "type": "integer",
                "explanation": "The higher the value, the smaller the priority of the web clock."
