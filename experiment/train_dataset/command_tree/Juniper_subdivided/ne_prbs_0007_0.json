{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set chassis fpc 0": {
        "template": "set chassis fpc [parameter1]",
        "command": "set chassis fpc 0",
        "explanation": "Sets the specified parameter for a Flexible PIC Concentrator (FPC) in the Junos chassis, configuring hardware-specific behavior or operational state.",
        "parameters": [
            {
                "name": "fpc",
                "type": "integer",
                "explanation": "FPC number."
            }
        ],
        "pic 0": {
            "template": "pic [parameter2]",
            "command": "pic 0",
            "explanation": "This command configures a Flexible PIC Concentrator (FPC) and its associated Physical Interface Card (PIC) in a Junos device, specifying parameters for hardware settings.",
            "parameters": [
                {
                    "name": "pic",
                    "type": "integer",
                    "explanation": "Physical Interface Card (PIC) number."
                }
            ],
            "e1 1/0/0": {
                "template": "e1 [parameter3]",
                "command": "e1 1/0/0",
                "explanation": "This command configures an E1 interface on a specific Physical Interface Card (PIC) within a Flexible PIC Concentrator (FPC) in a Junos device.",
                "parameters": [
                    {
                        "name": "e1-interface",
                        "type": "string",
                        "explanation": "E1 interface name."
                    }
                ],
                "channel-group 1": {
                    "template": "channel-group [parameter4]",
                    "command": "channel-group 1",
                    "explanation": "This command configures an E1 interface on a specific PIC in an FPC, assigning it to a channel group for aggregation or multiplexing.",
                    "parameters": [
                        {
                            "name": "channel-group",
                            "type": "integer",
                            "explanation": "Channel group number."
                        }
                    ],
                    "timeslots 1-31": {
                        "template": "timeslots [parameter5]",
                        "command": "timeslots 1-31",
                        "explanation": "Configure channel groups and time slots for FPC, PIC, E1 interfaces in aircraft boxes.",
                        "parameters": [
                            {
                                "name": "timeslots",
                                "type": "string",
                                "explanation": "Time slot range, e.g. 1-31."
                            }
                        ]
                    }
                }
            }
        }
    },
    "set interfaces t1-1/0/0:1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces t1-1/0/0:1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "encapsulation ppp": {
            "template": "encapsulation [parameter2]",
            "command": "encapsulation ppp",
            "explanation": "Configure the type of envelope for the sub-interface.",
            "parameters": [
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "Cover type, e.g. othernet-bridging."
                }
            ]
        },
        "clocking external": {
            "template": "clocking [parameter2]",
            "command": "clocking external",
            "explanation": "The clock source for the E1 interface is internal.",
            "parameters": [
                {
                    "name": "clocking",
                    "type": "string",
                    "explanation": "Clock source, like internal."
                }
            ]
        },
        "clock-rate 64000": {
            "template": "clock-rate [parameter2]",
            "command": "clock-rate 64000",
            "explanation": "Configure the clock rate for the interface.",
            "parameters": [
                {
                    "name": "clock-rate",
                    "type": "integer",
                    "explanation": "The clock rate, in bps."
                }
            ]
        }
    },
    "set services diagnostics tdr interface t1-1/0/0:1": {
        "template": "set services diagnostics tdr interface [parameter1]",
        "command": "set services diagnostics tdr interface t1-1/0/0:1",
        "explanation": "This command configures Time Domain Reflectometry (TDR) diagnostics on a specified interface (`[parameter1]`) to detect and analyze cable faults or issues.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. t1-1/0/0:1."
            }
        ],
        "interval 20": {
            "template": "interval [parameter2]",
            "command": "interval 20",
            "explanation": "Configure the interface and interval between the diagnosis of TDR (Time Domain Reflectometry).",
            "parameters": [
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "Diagnosis interval, in seconds."
                }
            ]
        },
        "pattern prbs15": {
            "template": "pattern [parameter2]",
            "command": "pattern prbs15",
            "explanation": "Configure interfaces and test modes for TRR diagnostics.",
            "parameters": [
                {
                    "name": "pattern",
                    "type": "string",
                    "explanation": "Test mode, for example, prbs15."
                }
            ]
        }
    }
}