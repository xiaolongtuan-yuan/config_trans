{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set firewall policer p1 if-exceeding bandwidth-limit 10000k": {
        "template": "set firewall policer [parameter1] if-exceeding bandwidth-limit [parameter2]",
        "command": "set firewall policer p1 if-exceeding bandwidth-limit 10000k",
        "explanation": "配置防火墙策略器的带宽限制。",
