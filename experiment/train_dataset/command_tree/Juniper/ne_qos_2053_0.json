            {
                "name": "policer-name",
                "type": "string",
                "explanation": "策略器名称。"
            },
            {
                "name": "bandwidth-limit",
                "type": "string",
                "explanation": "带宽限制值，单位可以是k（千比特每秒）。"
            }
        ]
    },
    "set firewall policer p1 if-exceeding burst-size-limit 150000": {
        "template": "set firewall policer [parameter1] if-exceeding burst-size-limit [parameter2]",
        "command": "set firewall policer p1 if-exceeding burst-size-limit 150000",
        "explanation": "配置防火墙策略器的突发大小限制。",
        "parameters": [
            {
                "name": "policer-name",
                "type": "string",
