{
    "set system host-name client002": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name client002",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set system services ssh": {
        "template": "set system services ssh",
        "command": "set system services ssh",
        "explanation": "启用SSH服务。",
        "parameters": []
    },
    "set system login user admin class super-user": {
        "template": "set system login user [parameter1] class [parameter2]",
        "command": "set system login user admin class super-user",
        "explanation": "配置用户登录类别。",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名。"
            },
            {
                "name": "class",
                "type": "string",
                "explanation": "用户类别，例如super-user。"
            }
        ]
    },
    "set system login user admin authentication ssh-rsa \"<paste the SSH public key here>\"": {
        "template": "set system login user [parameter1] authentication ssh-rsa [parameter2]",
        "command": "set system login user admin authentication ssh-rsa \"<paste the SSH public key here>\"",
        "explanation": "配置用户SSH认证的公钥。",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名。"
            },
            {
                "name": "ssh-rsa-key",
                "type": "string",
                "explanation": "SSH RSA公钥。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 family inet address 10.1.3.3/16": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.3.3/16",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 disable": {
        "template": "set interfaces [parameter1] unit [parameter2] disable",
        "command": "set interfaces ge-0/0/0 unit 0 disable",
        "explanation": "禁用指定接口单元。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
    "delete security ssh protocol-version v1": {
        "template": "delete security ssh protocol-version [parameter1]",
        "command": "delete security ssh protocol-version v1",
        "explanation": "删除SSH协议版本v1的配置。",
        "parameters": [
            {
                "name": "protocol-version",
                "type": "string",
                "explanation": "SSH协议版本，例如v1。"
            }
        ]
    }
}