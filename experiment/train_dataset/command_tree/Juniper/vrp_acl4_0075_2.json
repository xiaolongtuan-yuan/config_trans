{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set system services telnet": {
        "template": "set system services telnet",
        "command": "set system services telnet",
        "explanation": "启用设备的telnet服务。",
        "parameters": []
    },
    "set system services ssh": {
        "template": "set system services ssh",
        "command": "set system services ssh",
        "explanation": "启用设备的SSH服务。",
        "parameters": []
    },
    "set routing-instances vpnb instance-type vrf": {
        "template": "set routing-instances [parameter1] instance-type [parameter2]",
        "command": "set routing-instances vpnb instance-type vrf",
        "explanation": "配置路由实例的类型为VRF。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "instance-type",
                "type": "string",
                "explanation": "路由实例的类型，此处为VRF。"
            }
        ]
    },
    "set routing-instances vpnb route-distinguisher 100:2": {
        "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
        "command": "set routing-instances vpnb route-distinguisher 100:2",
        "explanation": "配置路由实例的路由区分器。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "route-distinguisher",
                "type": "string",
                "explanation": "路由区分器，用于区分不同VRF中的相同IP地址。"
            }
        ]
    },
    "set routing-instances vpnb vrf-target target:222:2": {
        "template": "set routing-instances [parameter1] vrf-target [parameter2]",
        "command": "set routing-instances vpnb vrf-target target:222:2",
        "explanation": "配置路由实例的VRF目标。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "vrf-target",
                "type": "string",
                "explanation": "VRF目标，用于控制路由的导入和导出。"
            }
        ]
    },
    "set routing-instances vpnb interface ge-1/0/0.0": {
        "template": "set routing-instances [parameter1] interface [parameter2]",
        "command": "set routing-instances vpnb interface ge-1/0/0.0",
        "explanation": "将接口绑定到路由实例。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，包括单元号。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.2.1.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 vlan-id 0": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/0 unit 0 vlan-id 0",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，用于标识不同的VLAN。"
            }
        ]
    }
}