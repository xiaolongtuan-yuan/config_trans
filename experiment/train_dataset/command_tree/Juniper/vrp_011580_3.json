{
    "set system host-name PE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set routing-instances evpna instance-type virtual-router": {
        "template": "set routing-instances [parameter1] instance-type [parameter2]",
        "command": "set routing-instances evpna instance-type virtual-router",
        "explanation": "配置路由实例的类型。",
        "parameters": [
            {
                "name": "routing-instance",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "instance-type",
                "type": "string",
                "explanation": "路由实例的类型，例如virtual-router。"
            }
        ]
    },
    "set routing-instances evpna route-distinguisher 200:1": {
        "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
        "command": "set routing-instances evpna route-distinguisher 200:1",
        "explanation": "配置路由实例的路由区分器。",
        "parameters": [
            {
                "name": "routing-instance",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "route-distinguisher",
                "type": "string",
                "explanation": "路由区分器，用于区分不同的路由实例。"
            }
        ]
    },
    "set bridge-domains bridge-domain-10 vlan-id 10": {
        "template": "set bridge-domains [parameter1] vlan-id [parameter2]",
        "command": "set bridge-domains bridge-domain-10 vlan-id 10",
        "explanation": "配置桥接域的VLAN ID。",
        "parameters": [
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "桥接域的名称。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID。"
            }
        ]
    },
    "set interfaces ge-0/0/1.1 unit 0 family ethernet-switching filter input bridge-domain-10": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching filter input [parameter3]",
        "command": "set interfaces ge-0/0/1.1 unit 0 family ethernet-switching filter input bridge-domain-10",
        "explanation": "配置接口的输入过滤器，关联指定的桥接域。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1.1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "filter",
                "type": "string",
                "explanation": "过滤器名称。"
            },
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "桥接域的名称。"
            }
        ]
    },
    "set interfaces ge-0/0/1.1 unit 0 family ethernet-switching filter output bridge-domain-10": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching filter output [parameter3]",
        "command": "set interfaces ge-0/0/1.1 unit 0 family ethernet-switching filter output bridge-domain-10",
        "explanation": "配置接口的输出过滤器，关联指定的桥接域。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1.1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "filter",
                "type": "string",
                "explanation": "过滤器名称。"
            },
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "桥接域的名称。"
            }
        ]
    }
}