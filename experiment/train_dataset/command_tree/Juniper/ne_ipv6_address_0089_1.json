{
    "set system host-name Device": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Device",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set routing-options rib inet6.0 static route ::/0 next-hop 2001:DB82::2:2": {
        "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
        "command": "set routing-options rib inet6.0 static route ::/0 next-hop 2001:DB82::2:2",
        "explanation": "配置IPv6静态路由的下一跳地址。",
        "parameters": [
            {
                "name": "rib",
                "type": "string",
                "explanation": "路由信息库的名称。"
            },
            {
                "name": "route",
                "type": "string",
                "explanation": "静态路由的目标地址。"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "静态路由的下一跳地址。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 1 encapsulation vlan-bridge": {
        "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
        "command": "set interfaces ge-0/0/1 unit 1 encapsulation vlan-bridge",
        "explanation": "配置接口的封装类型为VLAN桥接。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "接口的封装类型。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 1 vlan-id 1": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-0/0/1 unit 1 vlan-id 1",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号。"
            }
        ]
    }
}