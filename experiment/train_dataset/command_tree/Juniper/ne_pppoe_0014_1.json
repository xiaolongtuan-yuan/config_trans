{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set system radius-server 2001:db8::1:1 port 1645 secret \"132B0B124F0E\"": {
        "template": "set system radius-server [parameter1] port [parameter2] secret [parameter3]",
        "command": "set system radius-server 2001:db8::1:1 port 1645 secret \"132B0B124F0E\"",
        "explanation": "配置RADIUS服务器。",
        "parameters": [
            {
                "name": "server-address",
                "type": "string",
                "explanation": "RADIUS服务器的IPv6地址。"
            },
            {
                "name": "port",
                "type": "integer",
                "explanation": "RADIUS服务器的端口号。"
            },
            {
                "name": "secret",
                "type": "string",
                "explanation": "RADIUS服务器的共享密钥。"
            }
        ]
    },
    "set system radius-server 2001:db8::1:1 accounting-port 1646": {
        "template": "set system radius-server [parameter1] accounting-port [parameter2]",
        "command": "set system radius-server 2001:db8::1:1 accounting-port 1646",
        "explanation": "配置RADIUS服务器的计费端口。",
        "parameters": [
            {
                "name": "server-address",
                "type": "string",
                "explanation": "RADIUS服务器的IPv6地址。"
            },
            {
                "name": "accounting-port",
                "type": "integer",
                "explanation": "RADIUS服务器的计费端口号。"
            }
        ]
    },
    "set system login user admin class super-user authentication plain-text-password": {
        "template": "set system login user [parameter1] class [parameter2] authentication [parameter3]",
        "command": "set system login user admin class super-user authentication plain-text-password",
        "explanation": "配置用户登录信息。",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名。"
            },
            {
                "name": "class",
                "type": "string",
                "explanation": "用户类别，例如super-user。"
            },
            {
                "name": "authentication-method",
                "type": "string",
                "explanation": "认证方法，例如plain-text-password。"
            }
        ]
    },
    "set interfaces ge-1/0/2 unit 1 vlan-id 1": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/2 unit 1 vlan-id 1",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/2。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID。"
            }
        ]
    }
}