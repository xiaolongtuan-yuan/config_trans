{
    "set system host-name DeviceC": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 192.168.51.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 192.168.51.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces gr-0/0/10 encapsulation gre": {
        "template": "set interfaces [parameter1] encapsulation [parameter2]",
        "command": "set interfaces gr-0/0/10 encapsulation gre",
        "explanation": "配置接口的封装类型。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如gr-0/0/10。"
            },
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "封装类型，例如gre。"
            }
        ]
    },
    "set routing-options static route 192.168.50.0/24 next-hop 192.168.51.1": {
        "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set routing-options static route 192.168.50.0/24 next-hop 192.168.51.1",
        "explanation": "配置静态路由。",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "目标网络地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "目标网络的前缀长度。"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳地址。"
            }
        ]
    }
}