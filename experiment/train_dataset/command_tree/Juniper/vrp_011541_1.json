{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set vlans vlan2 vlan-id 2": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan2 vlan-id 2",
        "explanation": "配置VLAN的ID。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching interface-mode trunk",
        "explanation": "配置接口的以太网交换模式和接口模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "interface-mode",
                "type": "string",
                "explanation": "接口模式，如trunk或access。"
            }
        ]
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan2": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan members vlan2",
        "explanation": "配置接口的VLAN成员。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "vlan-members",
                "type": "string",
                "explanation": "VLAN成员名称。"
            }
        ]
    },
    "set interfaces ge-1/0/1 disable": {
        "template": "set interfaces [parameter1] disable",
        "command": "set interfaces ge-1/0/1 disable",
        "explanation": "禁用指定接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            }
        ]
    }
}