{
    "set system host-name PE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set routing-instances evpna instance-type virtual-router": {
        "template": "set routing-instances [parameter1] instance-type [parameter2]",
        "command": "set routing-instances evpna instance-type virtual-router",
        "explanation": "配置路由实例的类型为虚拟路由器。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "instance-type",
                "type": "string",
                "explanation": "路由实例的类型，virtual-router表示虚拟路由器。"
            }
        ]
    },
    "set routing-instances evpna route-distinguisher 100:1": {
        "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
        "command": "set routing-instances evpna route-distinguisher 100:1",
        "explanation": "配置路由实例的路由区分器。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称。"
            },
            {
                "name": "route-distinguisher",
                "type": "string",
                "explanation": "路由区分器，用于区分不同路由实例的路由。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members 10": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
        "command": "set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members 10",
        "explanation": "配置接口的以太网交换VLAN成员。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "vlan-members",
                "type": "integer",
                "explanation": "VLAN成员ID。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 0 encapsulation vlan-bridge": {
        "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
        "command": "set interfaces ge-0/0/1 unit 0 encapsulation vlan-bridge",
        "explanation": "配置接口的封装类型为VLAN桥接。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "封装类型。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 0 vlan-id 2": {
        "template": "set interfaces [parameter1] unit [parameter2] vlan-id [parameter3]",
        "command": "set interfaces ge-0/0/1 unit 0 vlan-id 2",
        "explanation": "配置接口的VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID。"
            }
        ]
    }
}