{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set vlans vlan-2 vlan-id 2": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan-2 vlan-id 2",
        "explanation": "配置VLAN的ID。",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN的名称，例如vlan-2。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID号，用于区分不同的VLAN。"
            }
        ]
    }
}