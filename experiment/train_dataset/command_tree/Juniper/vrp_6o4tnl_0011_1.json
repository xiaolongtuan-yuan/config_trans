{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set system root-authentication encrypted-password \"<password>\"": {
        "template": "set system root-authentication encrypted-password [parameter1]",
        "command": "set system root-authentication encrypted-password \"<password>\"",
        "explanation": "配置root用户的加密密码。",
        "parameters": [
            {
                "name": "encrypted-password",
                "type": "string",
                "explanation": "root用户的加密密码。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 2.2.2.2/8": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 2.2.2.2/8",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set interfaces st0.10 encapsulation ip6ip": {
        "template": "set interfaces [parameter1] encapsulation [parameter2]",
        "command": "set interfaces st0.10 encapsulation ip6ip",
        "explanation": "配置接口的封装类型。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如st0.10。"
            },
            {
                "name": "encapsulation",
                "type": "string",
                "explanation": "接口的封装类型，例如ip6ip。"
            }
        ]
    },
    "set interfaces st0.10 tunnel source ge-1/0/0": {
        "template": "set interfaces [parameter1] tunnel source [parameter2]",
        "command": "set interfaces st0.10 tunnel source ge-1/0/0",
        "explanation": "配置隧道接口的源接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "隧道接口名称，例如st0.10。"
            },
            {
                "name": "source-interface",
                "type": "string",
                "explanation": "隧道源接口名称，例如ge-1/0/0。"
            }
        ]
    },
    "set routing-options rib inet6.0 static route 2002::/16 next-hop st0.10": {
        "template": "set routing-options rib [parameter1] static route [parameter2] next-hop [parameter3]",
        "command": "set routing-options rib inet6.0 static route 2002::/16 next-hop st0.10",
        "explanation": "配置IPv6静态路由。",
        "parameters": [
            {
                "name": "rib",
                "type": "string",
                "explanation": "路由信息库名称，例如inet6.0。"
            },
            {
                "name": "route",
                "type": "string",
                "explanation": "静态路由的目的网络地址及前缀长度。"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳地址或接口。"
            }
        ]
    }
}