{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set system services ssh": {
        "template": "set system services ssh",
        "command": "set system services ssh",
        "explanation": "启用SSH服务。",
        "parameters": []
    },
    "set system services telnet": {
        "template": "set system services telnet",
        "command": "set system services telnet",
        "explanation": "启用Telnet服务。",
        "parameters": []
    },
    "set system login user root authentication plain-text-password": {
        "template": "set system login user [parameter1] authentication plain-text-password",
        "command": "set system login user root authentication plain-text-password",
        "explanation": "为root用户设置明文密码。",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名，例如root。"
            }
        ]
    },
    "set routing-instances vpna instance-type vrf": {
        "template": "set routing-instances [parameter1] instance-type [parameter2]",
        "command": "set routing-instances vpna instance-type vrf",
        "explanation": "配置路由实例的类型为VRF。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称，例如vpna。"
            },
            {
                "name": "instance-type",
                "type": "string",
                "explanation": "路由实例的类型，例如vrf。"
            }
        ]
    },
    "set routing-instances vpna route-distinguisher 100:1": {
        "template": "set routing-instances [parameter1] route-distinguisher [parameter2]",
        "command": "set routing-instances vpna route-distinguisher 100:1",
        "explanation": "配置路由实例的路由区分器。",
        "parameters": [
            {
                "name": "instance-name",
                "type": "string",
                "explanation": "路由实例的名称，例如vpna。"
            },
            {
                "name": "route-distinguisher",
                "type": "string",
                "explanation": "路由区分器，用于区分不同的路由实例，格式为ASN:nn或IP:nn。"
            }
        ]
    },
    "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    }
}