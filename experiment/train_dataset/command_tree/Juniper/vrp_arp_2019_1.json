{
    "set system host-name Device": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Device",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 family ethernet-switching": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
        "command": "set interfaces ge-0/0/0 unit 0 family ethernet-switching",
        "explanation": "配置接口为以太网交换模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 disable": {
        "template": "set interfaces [parameter1] unit [parameter2] disable",
        "command": "set interfaces ge-0/0/0 unit 0 disable",
        "explanation": "禁用指定接口单元。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    }
}