{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ge-0/0/1 unit 0 family inet address 172.16.1.2/24": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
        "command": "set interfaces ge-0/0/1 unit 0 family inet address 172.16.1.2/24",
        "explanation": "配置接口的IPv4地址及子网掩码。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            }
        ]
    },
    "set protocols ospf area 0 interface ge-0/0/1": {
        "template": "set protocols ospf area [parameter1] interface [parameter2]",
        "command": "set protocols ospf area 0 interface ge-0/0/1",
        "explanation": "配置OSPF区域0的接口。",
        "parameters": [
            {
                "name": "area",
                "type": "integer",
                "explanation": "OSPF区域号。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            }
        ]
    },
    "set protocols ospf area 0 interface tunnel.1": {
        "template": "set protocols ospf area [parameter1] interface [parameter2]",
        "command": "set protocols ospf area 0 interface tunnel.1",
        "explanation": "配置OSPF区域0的隧道接口。",
        "parameters": [
            {
                "name": "area",
                "type": "integer",
                "explanation": "OSPF区域号。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如tunnel.1。"
            }
        ]
    },
    "set protocols ospf area 0 interface lo0": {
        "template": "set protocols ospf area [parameter1] interface [parameter2]",
        "command": "set protocols ospf area 0 interface lo0",
        "explanation": "配置OSPF区域0的环回接口。",
        "parameters": [
            {
                "name": "area",
                "type": "integer",
                "explanation": "OSPF区域号。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如lo0。"
            }
        ]
    }
}