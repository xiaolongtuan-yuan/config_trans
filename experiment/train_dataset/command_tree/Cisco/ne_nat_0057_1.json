                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip nat pool address-group1 11.11.11.101 11.11.11.105 netmask 255.255.255.0": {
        "template": "ip nat pool [parameter1] [parameter2] [parameter3] netmask [parameter4]",
        "command": "ip nat pool address-group1 11.11.11.101 11.11.11.105 netmask 255.255.255.0",
        "explanation": "配置NAT池，名称为address-group1，IP范围从11.11.11.101到11.11.11.105，子网掩码255.255.255.0",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "NAT池的名称"
            },
            {
                "name": "start IP",
                "type": "IPv4",
                "explanation": "池中起始IP地址"
            },
            {
                "name": "end IP",
                "type": "IPv4",
                "explanation": "池中结束IP地址"
            },
            {
                "name": "netmask",
                "type": "IPv4",
                "explanation": "子网掩码"
            }
        ]
    },
    "ip nat inside source list 3001 pool address-group1 overload": {
        "template": "ip nat inside source list [parameter1] pool [parameter2] overload",
        "command": "ip nat inside source list 3001 pool address-group1 overload",
        "explanation": "配置NAT，将内部接口上ACL 3001定义的流量通过address-group1池进行源NAT，并允许端口重用",
        "parameters": [
            {
                "name": "ACL number",
                "type": "integer",
                "explanation": "应用的访问控制列表编号"
            },
            {
                "name": "pool name",
                "type": "string",
                "explanation": "使用的NAT池名称"
            },
            {
                "name": "overload",
                "type": "string",
                "explanation": "允许端口重用"
            }
        ]
    },
