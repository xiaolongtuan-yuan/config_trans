{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface POS1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface POS1/0/0",
        "explanation": "配置接口 'POS1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "interface POS1/0/0.1 point-to-point": {
            "template": "interface [parameter1] [parameter2]",
            "command": "interface POS1/0/0.1 point-to-point",
            "explanation": "配置子接口 'POS1/0/0.1'，类型为点对点",
            "parameters": [
                {
                    "name": "subinterface name",
                    "type": "string",
                    "explanation": "子接口名"
                },
                {
                    "name": "interface type",
                    "type": "string",
                    "explanation": "接口类型，这里是 'point-to-point'"
                }
            ],
            "ip address 10.1.1.2 255.255.255.0": {
                "template": "ip address [parameter1] [parameter2]",
                "command": "ip address 10.1.1.2 255.255.255.0",
                "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.0",
                "parameters": [
                    {
                        "name": "ip address",
                        "type": "IPv4",
                        "explanation": "IPv4 地址"
                    },
                    {
                        "name": "subnet mask",
                        "type": "IPv4",
                        "explanation": "子网掩码"
                    }
                ]
            },
            "frame-relay interface-dlci 100": {
                "template": "frame-relay interface-dlci [parameter1]",
                "command": "frame-relay interface-dlci 100",
                "explanation": "配置帧中继接口的 DLCI 号码为 100",
                "parameters": [
                    {
                        "name": "dlci number",
                        "type": "integer",
                        "explanation": "DLCI 号码"
                    }
                ]
            }
        }
    }
}