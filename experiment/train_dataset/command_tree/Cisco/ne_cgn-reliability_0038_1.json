{
    "hostname CGN1": {
        "template": "hostname [parameter1]",
        "command": "hostname CGN1",
        "explanation": "设置设备的主机名为 'CGN1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/3": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/3",
        "explanation": "配置接口 'GigabitEthernet1/0/3'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 10.0.0.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.0.0.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.0.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "vrrp 10 ip 10.0.0.3": {
            "template": "vrrp [parameter1] ip [parameter2]",
            "command": "vrrp 10 ip 10.0.0.3",
            "explanation": "配置 VRRP 组 10 的虚拟 IP 地址为 10.0.0.3",
            "parameters": [
                {
                    "name": "group id",
                    "type": "integer",
                    "explanation": "VRRP 组 ID"
                },
                {
                    "name": "virtual ip",
                    "type": "IPv4",
                    "explanation": "虚拟 IP 地址"
                }
            ]
        },
        "vrrp 10 priority 150": {
            "template": "vrrp [parameter1] priority [parameter2]",
            "command": "vrrp 10 priority 150",
            "explanation": "设置 VRRP 组 10 的优先级为 150",
            "parameters": [
                {
                    "name": "group id",
                    "type": "integer",
                    "explanation": "VRRP 组 ID"
                },
                {
                    "name": "priority",
                    "type": "integer",
                    "explanation": "优先级"
                }
            ]
        }
    }
