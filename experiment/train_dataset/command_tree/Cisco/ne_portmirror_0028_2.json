        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN identification number"
            }
        ]
    },
    "interface_GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "Configure interface 'GigabitEthernet1/0/1 '",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no_shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "Enable interface exchange port mode",
            "parameters": []
        },
        "switchport_mode_access": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "Set interface exchange port mode as access mode",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Port mode, e. g. 'access ' or 'trunk'"
                }
            ]
        },
        "switchport_access_vlan_10": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 10",
            "explanation": "Assign access mode to VLAN 10",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
    },
    "interface_GigabitEthernet1/0/2": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "Configure Interface 'GigabitEthernet1/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no_shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "Enable interface exchange port mode",
            "parameters": []
        },
        "switchport_mode_trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "Set the interface exchange port mode to repeat",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "Port mode, e. g. 'access ' or 'trunk'"
                }
            ]
        },
        "switchport_trunk_allowed_vlan_10": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "Configure interface relay mode to allow VLAN 10 to pass",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN identification number"
                }
            ]
        }
