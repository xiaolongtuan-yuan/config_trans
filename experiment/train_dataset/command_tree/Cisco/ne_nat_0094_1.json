{
    "hostname CR": {
        "template": "hostname [parameter1]",
        "command": "hostname CR",
        "explanation": "设置设备的主机名为 'CR'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "class-map c1": {
        "template": "class-map [parameter1]",
        "command": "class-map c1",
        "explanation": "定义一个类映射，名称为'c1'",
        "parameters": [
            {
                "name": "class name",
                "type": "string",
                "explanation": "类的名称"
            }
        ],
        "match access-group 2001": {
            "template": "match access-group [parameter1]",
            "command": "match access-group 2001",
            "explanation": "将类映射与访问控制列表2001关联",
            "parameters": [
                {
                    "name": "access-list number",
                    "type": "integer",
                    "explanation": "访问控制列表的编号"
                }
            ]
        }
    },
    "policy-map p1": {
        "template": "policy-map [parameter1]",
        "command": "policy-map p1",
        "explanation": "定义一个策略映射，名称为'p1'",
        "parameters": [
            {
                "name": "policy name",
                "type": "string",
                "explanation": "策略的名称"
            }
        ],
        "class c1": {
            "template": "class [parameter1]",
            "command": "class c1",
            "explanation": "在策略映射中定义一个类，名称为'c1'",
            "parameters": [
                {
                    "name": "class name",
                    "type": "string",
                    "explanation": "类的名称"
                }
            ],
            "set ip next-hop 192.168.11.2": {
                "template": "set ip next-hop [parameter1]",
                "command": "set ip next-hop 192.168.11.2",
                "explanation": "设置IP下一跳地址为192.168.11.2",
                "parameters": [
                    {
                        "name": "next-hop address",
                        "type": "IPv4",
                        "explanation": "下一跳的IP地址"
                    }
                ]
            }
        }
    },
    "interface GigabitEthernet2/0/2": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet2/0/2",
        "explanation": "配置接口 'GigabitEthernet2/0/2'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 192.168.10.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.10.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为192.168.10.2，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "service-policy input p1": {
            "template": "service-policy input [parameter1]",
            "command": "service-policy input p1",
            "explanation": "在接口的输入方向应用策略映射'p1'",
            "parameters": [
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "流量方向，这里是'input'"
                },
                {
                    "name": "policy name",
                    "type": "string",
                    "explanation": "策略的名称"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}