{
    "hostname CE2": {
        "template": "hostname [parameter1]",
        "command": "hostname CE2",
        "explanation": "设置设备的主机名为 'CE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或配置VLAN 10",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识符"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入接口GigabitEthernet1/0/1的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口的交换端口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "端口模式（trunk或access）"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口",
            "parameters": []
        },
        "switchport trunk allowed vlan 10": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "允许VLAN 10通过trunk接口",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "string",
                    "explanation": "允许的VLAN列表"
                }
            ]
        }
    }
}