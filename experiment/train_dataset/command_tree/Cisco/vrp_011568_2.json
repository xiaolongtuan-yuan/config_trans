{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 10": {
        "template": "vlan [parameter1]",
        "command": "vlan 10",
        "explanation": "创建或进入 VLAN 10 的配置模式",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN 标识号"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入 GigabitEthernet1/0/1 接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "启用接口的交换端口模式",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan 10": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 10",
            "explanation": "配置允许通过 trunk 链路的 VLAN，包括 VLAN 10",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "list of integers",
                    "explanation": "允许的 VLAN 列表"
                }
            ]
        }
    }
}