{
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "启用AAA新模型，允许使用AAA进行认证、授权和计费。",
        "parameters": []
    },
    "aaa authentication login default local": {
        "template": "aaa authentication login [default] [local]",
        "command": "aaa authentication login default local",
        "explanation": "设置默认的登录认证方法为本地数据库。",
        "parameters": [
            {
                "name": "default",
                "type": "string",
                "explanation": "默认认证列表"
            },
            {
                "name": "local",
                "type": "string",
                "explanation": "使用本地数据库进行认证"
            }
        ]
    },
    "aaa authorization exec default local": {
        "template": "aaa authorization exec [default] [local]",
        "command": "aaa authorization exec default local",
        "explanation": "设置默认的执行授权方法为本地数据库。",
        "parameters": [
            {
                "name": "default",
                "type": "string",
                "explanation": "默认授权列表"
            },
            {
                "name": "local",
                "type": "string",
                "explanation": "使用本地数据库进行授权"
            }
        ]
    },
    "aaa authorization network default local": {
        "template": "aaa authorization network [default] [local]",
        "command": "aaa authorization network default local",
        "explanation": "设置默认的网络授权方法为本地数据库。",
        "parameters": [
            {
                "name": "default",
                "type": "string",
                "explanation": "默认网络授权列表"
            },
            {
                "name": "local",
                "type": "string",
                "explanation": "使用本地数据库进行网络授权"
            }
        ]
    },
    "username admin@aaa privilege 15 password 0 pPgn;|W90$J72.Ak$Y,IQ:gqIfPBTLjqW%,N`M_~": {
        "template": "username [username] privilege [privilege_level] password [password_type] [password]",
        "command": "username admin@aaa privilege 15 password 0 pPgn;|W90$J72.Ak$Y,IQ:gqIfPBTLjqW%,N`M_~",
        "explanation": "创建一个用户名为admin@aaa的用户，特权级别为15，密码为明文。",
        "parameters": [
            {
                "name": "username",
                "type": "string",
                "explanation": "用户名"
            },
            {
                "name": "privilege_level",
                "type": "integer",
                "explanation": "用户的特权级别"
            },
            {
                "name": "password_type",
                "type": "string",
                "explanation": "密码类型，0表示明文"
            },
            {
                "name": "password",
                "type": "string",
                "explanation": "用户密码"
            }
        ]
    },
    "aaa group server tacacs+ admin": {
        "template": "aaa group server tacacs+ [group_name]",
        "command": "aaa group server tacacs+ admin",
        "explanation": "创建一个TACACS+服务器组，名称为admin。",
        "parameters": [
            {
                "name": "group_name",
                "type": "string",
                "explanation": "服务器组的名称"
            }
        ]
    },
    "aaa session-id common": {
        "template": "aaa session-id common",
        "command": "aaa session-id common",
        "explanation": "设置AAA会话ID为common模式。",
        "parameters": []
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [interface_name]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "进入GigabitEthernet3/0/0接口配置模式。",
        "parameters": [
            {
                "name": "interface_name",
                "type": "string",
                "explanation": "接口的名称"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口。",
            "parameters": []
        },
        "ip address 10.137.217.251 255.255.254.0": {
            "template": "ip address [ip_address] [subnet_mask]",
            "command": "ip address 10.137.217.251 255.255.254.0",
            "explanation": "配置接口的IP地址和子网掩码。",
            "parameters": [
                {
                    "name": "ip_address",
                    "type": "IPv4",
                    "explanation": "接口的IP地址"
                },
                {
                    "name": "subnet_mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip route 0.0.0.0 0.0.0.0 10.137.216.1": {
        "template": "ip route [destination] [mask] [next_hop]",
        "command": "ip route 0.0.0.0 0.0.0.0 10.137.216.1",
        "explanation": "配置默认路由，下一跳为10.137.216.1。",
        "parameters": [
            {
                "name": "destination",
                "type": "IPv4",
                "explanation": "目的网络地址"
            },
            {
                "name": "mask",
                "type": "IPv4",
                "explanation": "网络掩码"
            },
            {
                "name": "next_hop",
                "type": "IPv4",
                "explanation": "下一跳IP地址"
            }
        ]
    },
    "line vty 0 4": {
        "template": "line vty [start] [end]",
        "command": "line vty 0 4",
        "explanation": "进入虚拟终端线路配置模式，范围从0到4。",
        "parameters": [
            {
                "name": "start",
                "type": "integer",
                "explanation": "起始线路编号"
            },
            {
                "name": "end",
                "type": "integer",
                "explanation": "结束线路编号"
            }
        ],
        "login authentication default": {
            "template": "login authentication [list_name]",
            "command": "login authentication default",
            "explanation": "设置登录认证使用默认的认证列表。",
            "parameters": [
                {
                    "name": "list_name",
                    "type": "string",
                    "explanation": "认证列表的名称"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式，返回到特权执行模式。",
        "parameters": []
    }
