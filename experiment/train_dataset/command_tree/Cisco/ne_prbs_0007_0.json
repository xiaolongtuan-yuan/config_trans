{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "controller E1 1/0/0": {
        "template": "controller [parameter1] [parameter2]",
        "command": "controller E1 1/0/0",
        "explanation": "配置E1控制器，控制器类型为E1，位置为1/0/0",
        "parameters": [
            {
                "name": "controller type",
                "type": "string",
                "explanation": "控制器类型"
            },
            {
                "name": "controller location",
                "type": "string",
                "explanation": "控制器位置"
            }
        ],
        "channel-group 1 timeslots 1-31": {
            "template": "channel-group [parameter1] timeslots [parameter2]",
            "command": "channel-group 1 timeslots 1-31",
            "explanation": "配置通道组1， timeslots 1-31",
            "parameters": [
                {
                    "name": "channel group number",
                    "type": "integer",
                    "explanation": "通道组编号"
                },
                {
                    "name": "timeslots",
                    "type": "string",
                    "explanation": "timeslots范围"
                }
            ]
        }
    },
    "interface Serial1/0/0:1": {
        "template": "interface [parameter1]",
        "command": "interface Serial1/0/0:1",
        "explanation": "配置接口 'Serial1/0/0:1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "clock rate 64000": {
            "template": "clock rate [parameter1]",
            "command": "clock rate 64000",
            "explanation": "设置时钟速率位64000",
            "parameters": [
                {
                    "name": "clock rate",
                    "type": "integer",
                    "explanation": "时钟速率"
                }
            ]
        }
    }
