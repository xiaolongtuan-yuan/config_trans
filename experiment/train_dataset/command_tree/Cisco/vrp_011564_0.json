{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或配置VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport": {
            "template": "switchport",
            "command": "switchport",
            "explanation": "启用接口的交换端口模式",
            "parameters": []
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2通过trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许的VLAN标识号"
                }
            ]
        }
    },
    "ethernet cfm domain md1 level 0": {
        "template": "ethernet cfm domain [parameter1] level [parameter2]",
        "command": "ethernet cfm domain md1 level 0",
        "explanation": "配置以太网CFM域 'md1'，级别为0",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "CFM域名称"
            },
            {
                "name": "level",
                "type": "integer",
                "explanation": "域级别"
            }
        ],
        "service ma1 vlan 2": {
            "template": "service [parameter1] vlan [parameter2]",
            "command": "service ma1 vlan 2",
            "explanation": "配置服务 'ma1'，关联到VLAN 2",
            "parameters": [
                {
                    "name": "service name",
                    "type": "string",
                    "explanation": "服务名称"
                },
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "关联的VLAN标识号"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}