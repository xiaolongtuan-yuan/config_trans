        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip vrf forwarding vpna": {
            "template": "ip vrf forwarding [parameter1]",
            "command": "ip vrf forwarding vpna",
