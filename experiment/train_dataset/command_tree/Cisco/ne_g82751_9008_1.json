{
    "hostname PE2": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp profile g8275-1": {
        "template": "ptp profile [parameter1]",
        "command": "ptp profile g8275-1",
        "explanation": "配置PTP profile名为 'g8275-1'",
        "parameters": [
            {
                "name": "profile name",
                "type": "string",
                "explanation": "PTP profile的名字"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "clock source internal": {
            "template": "clock source [parameter1]",
            "command": "clock source internal",
            "explanation": "设置时钟源为内部时钟",
            "parameters": [
                {
                    "name": "clock source",
                    "type": "string",
                    "explanation": "时钟源的类型，例如 'internal'、'external'等"
                }
            ]
        },
        "ptp domain 0": {
            "template": "ptp domain [parameter1]",
            "command": "ptp domain 0",
            "explanation": "设置PTP域为0",
            "parameters": [
                {
                    "name": "domain",
                    "type": "integer",
                    "explanation": "PTP域的编号"
                }
            ]
        }
    }
}