    "ip nat pool POOL-1 11.11.11.101 11.11.11.105 netmask 255.255.255.0": {
        "template": "ip nat pool [parameter1] [parameter2] [parameter3] netmask [parameter4]",
        "command": "ip nat pool POOL-1 11.11.11.101 11.11.11.105 netmask 255.255.255.0",
        "explanation": "创建一个NAT池，名称为POOL-1，包含IP地址从11.11.11.101到11.11.11.105，子网掩码为255.255.255.0",
