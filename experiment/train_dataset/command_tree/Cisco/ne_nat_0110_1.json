            },
            {
                "name": "end IP",
                "type": "IPv4",
                "explanation": "池中结束IP地址"
            },
            {
                "name": "netmask",
                "type": "IPv4",
                "explanation": "子网掩码"
            }
        ]
    },
    "ip nat inside source list ACL-3001 pool POOL-1": {
        "template": "ip nat inside source list [parameter1] pool [parameter2]",
        "command": "ip nat inside source list ACL-3001 pool POOL-1",
        "explanation": "将内部接口的流量，根据ACL-3001，使用POOL-1池进行源NAT",
        "parameters": [
            {
                "name": "access list name",
                "type": "string",
                "explanation": "关联的访问控制列表名称"
            },
            {
                "name": "pool name",
                "type": "string",
                "explanation": "关联的NAT池名称"
            }
        ]
    },
