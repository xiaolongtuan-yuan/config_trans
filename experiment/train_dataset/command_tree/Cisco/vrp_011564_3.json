{
    "hostname PE2": {
        "template": "hostname [parameter1]",
        "command": "hostname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bridge-domain 10": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "配置桥域 '10'",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥域的标识号"
            }
        ]
    },
    "interface GigabitEthernet1/0/1.1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1.1",
        "explanation": "配置接口 'GigabitEthernet1/0/1.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口的名称"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口的交换端口模式为trunk",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "端口模式，这里是 'trunk'"
                }
            ]
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2通过trunk接口",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许的VLAN ID"
                }
            ]
        },
        "encapsulation dot1q 2": {
            "template": "encapsulation dot1q [parameter1]",
            "command": "encapsulation dot1q 2",
            "explanation": "设置封装类型为dot1q，VLAN ID为2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain 10": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将接口关联到桥域10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥域的标识号"
                }
            ]
        }
    }
}