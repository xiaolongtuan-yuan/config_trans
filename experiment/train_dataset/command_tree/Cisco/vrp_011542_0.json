{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "ethernet cfm": {
        "template": "ethernet cfm",
        "command": "ethernet cfm",
        "explanation": "进入以太网CFM配置模式",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口为trunk模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式，如trunk或access"
                }
            ]
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2通过trunk接口",
            "parameters": [
                {
                    "name": "vlan list",
                    "type": "list of integers",
                    "explanation": "允许通过的VLAN列表"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    }
}