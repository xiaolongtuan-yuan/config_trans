{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan 2": {
        "template": "vlan [parameter1]",
        "command": "vlan 2",
        "explanation": "创建或配置VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN标识号"
            }
        ]
    },
    "ethernet cfm": {
        "template": "ethernet cfm",
        "command": "ethernet cfm",
        "explanation": "启用以太网CFM",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "switchport mode trunk": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode trunk",
            "explanation": "设置接口为trunk模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport trunk allowed vlan 2": {
            "template": "switchport trunk allowed vlan [parameter1]",
            "command": "switchport trunk allowed vlan 2",
            "explanation": "允许VLAN 2在trunk上",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "允许的VLAN标识号"
                }
            ]
        },
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口",
            "parameters": []
        }
    }
