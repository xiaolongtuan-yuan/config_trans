        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "monitor session 1 source interface GigabitEthernet1/0/1": {
        "template": "monitor session [parameter1] source interface [parameter2]",
        "command": "monitor session 1 source interface GigabitEthernet1/0/1",
        "explanation": "创建监控会话1，指定源接口 GigabitEthernet1/0/1",
        "parameters": [
            {
                "name": "session number",
                "type": "integer",
                "explanation": "监控会话的编号"
            },
            {
                "name": "source interface",
                "type": "string",
                "explanation": "源接口"
            }
        ]
    },
