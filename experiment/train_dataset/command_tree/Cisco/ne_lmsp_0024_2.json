{
    "router isis 1": {
        "template": "router isis [process-id]",
        "command": "router isis 1",
        "explanation": "启动ISIS路由协议，并指定进程ID为1。",
        "parameters": [
            {
                "name": "process-id",
                "type": "integer",
                "explanation": "ISIS进程的唯一标识符。"
            }
        ]
    },
    "is-type level-1": {
        "template": "is-type [level]",
        "command": "is-type level-1",
        "explanation": "设置ISIS路由器的类型为Level-1，即仅参与区域内路由。",
        "parameters": [
            {
                "name": "level",
                "type": "string",
                "explanation": "ISIS的层次级别，可以是level-1或level-2。"
            }
        ]
    },
    "net 49.0003.0033.0033.0033.00": {
        "template": "net [net-address]",
        "command": "net 49.0003.0033.0033.0033.00",
        "explanation": "配置ISIS的NET地址，用于标识路由器。",
        "parameters": [
            {
                "name": "net-address",
                "type": "string",
                "explanation": "ISIS的网络实体标题，用于唯一标识路由器。"
            }
        ]
    },
    "lsp-gen-interval 1 1 50": {
        "template": "lsp-gen-interval [initial] [max] [steady-state]",
        "command": "lsp-gen-interval 1 1 50",
        "explanation": "设置链路状态PDU的生成间隔时间。",
        "parameters": [
            {
                "name": "initial",
                "type": "integer",
                "explanation": "初始LSP生成间隔时间（秒）。"
            },
            {
                "name": "max",
                "type": "integer",
                "explanation": "最大LSP生成间隔时间（秒）。"
            },
            {
                "name": "steady-state",
                "type": "integer",
                "explanation": "稳定状态下的LSP生成间隔时间（秒）。"
            }
        ]
    },
    "interface GigabitEthernet 2/0/2": {
        "template": "interface [interface-id]",
        "command": "interface GigabitEthernet 2/0/2",
        "explanation": "进入GigabitEthernet 2/0/2接口的配置模式。",
        "parameters": [
            {
                "name": "interface-id",
                "type": "string",
                "explanation": "接口的标识符。"
            }
        ],
        "ip router isis 1": {
            "template": "ip router isis [process-id]",
            "command": "ip router isis 1",
            "explanation": "将此接口加入到ISIS进程1中。",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "ISIS进程的标识符。"
                }
            ]
        }
    },
    "interface GigabitEthernet 2/0/1": {
        "template": "interface [interface-id]",
        "command": "interface GigabitEthernet 2/0/1",
        "explanation": "进入GigabitEthernet 2/0/1接口的配置模式。",
        "parameters": [
            {
                "name": "interface-id",
                "type": "string",
                "explanation": "接口的标识符。"
            }
        ],
        "ip router isis 1": {
            "template": "ip router isis [process-id]",
            "command": "ip router isis 1",
            "explanation": "将此接口加入到ISIS进程1中。",
            "parameters": [
                {
                    "name": "process-id",
                    "type": "integer",
                    "explanation": "ISIS进程的标识符。"
                }
            ]
        }
    },
    "interface Loopback 0": {
        "template": "interface [interface-id]",
        "command": "interface Loopback 0",
        "explanation": "进入Loopback 0接口的配置模式。",
        "parameters": [
            {
                "name": "interface-id",
                "type": "string",
                "explanation": "接口的标识符。"
            }
        ],
        "ip address 3.3.3.3 255.255.255.255": {
            "template": "ip address [address] [mask]",
            "command": "ip address 3.3.3.3 255.255.255.255",
            "explanation": "配置Loopback 0接口的IP地址为3.3.3.3，子网掩码为255.255.255.255。",
            "parameters": [
                {
                    "name": "address",
                    "type": "IPv4",
                    "explanation": "IP地址。"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "子网掩码。"
                }
            ]
        }
    }
}