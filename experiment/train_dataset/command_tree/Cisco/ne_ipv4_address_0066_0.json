{
    "hostname HUAWEI": {
        "template": "hostname [parameter1]",
        "command": "hostname HUAWEI",
        "explanation": "设置设备的主机名为 'HUAWEI'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ip dhcp pool pool1": {
        "template": "ip dhcp pool [parameter1]",
        "command": "ip dhcp pool pool1",
        "explanation": "配置 DHCP 地址池 'pool1'",
        "parameters": [
            {
                "name": "pool name",
                "type": "string",
                "explanation": "DHCP 地址池名称"
            }
        ],
        "network 10.10.10.0 255.255.255.0": {
            "template": "network [parameter1] [parameter2]",
            "command": "network 10.10.10.0 255.255.255.0",
            "explanation": "配置 DHCP 地址池的网络地址为 10.10.10.0，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "default-router 10.10.10.2": {
            "template": "default-router [parameter1]",
            "command": "default-router 10.10.10.2",
            "explanation": "配置 DHCP 地址池的默认网关为 10.10.10.2",
            "parameters": [
                {
                    "name": "default gateway",
                    "type": "IPv4",
                    "explanation": "默认网关"
                }
            ]
        },
        "dns-server 10.20.20.1": {
            "template": "dns-server [parameter1]",
            "command": "dns-server 10.20.20.1",
            "explanation": "配置 DHCP 地址池的 DNS 服务器为 10.20.20.1",
            "parameters": [
                {
                    "name": "dns server",
                    "type": "IPv4",
                    "explanation": "DNS 服务器地址"
                }
            ]
        }
    },
    "aaa new-model": {
        "template": "aaa new-model",
        "command": "aaa new-model",
        "explanation": "启用 AAA 新模型",
        "parameters": []
    },
    "aaa authentication login clcl none": {
        "template": "aaa authentication login [parameter1] [parameter2]",
        "command": "aaa authentication login clcl none",
        "explanation": "配置登录认证方法列表 'clcl' 为无认证",
        "parameters": [
            {
                "name": "list name",
                "type": "string",
                "explanation": "认证方法列表名称"
            },
            {
                "name": "method",
                "type": "string",
                "explanation": "认证方法"
            }
        ]
    },
    "aaa accounting exec default stop-only group none": {
        "template": "aaa accounting exec [parameter1] [parameter2] group [parameter3]",
        "command": "aaa accounting exec default stop-only group none",
        "explanation": "配置执行命令的记账方法为 'default'，记账类型为 'stop-only'，组为 'none'",
        "parameters": [
            {
                "name": "accounting list",
                "type": "string",
                "explanation": "记账列表名称"
            },
            {
                "name": "accounting type",
                "type": "string",
                "explanation": "记账类型"
            },
            {
                "name": "group",
                "type": "string",
                "explanation": "组名称"
            }
        ]
    },
    "aaa accounting delay-start": {
        "template": "aaa accounting delay-start",
        "command": "aaa accounting delay-start",
        "explanation": "启用记账延迟启动",
        "parameters": []
    },
    "interface GigabitEthernet1/0/0.1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0.1",
        "explanation": "配置子接口 'GigabitEthernet1/0/0.1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "switchport mode access": {
            "template": "switchport mode [parameter1]",
            "command": "switchport mode access",
            "explanation": "配置接口模式为访问模式",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "接口模式"
                }
            ]
        },
        "switchport access vlan 1": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 1",
            "explanation": "配置接口的访问 VLAN 为 1",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "配置接口 'GigabitEthernet3/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.20.20.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.20.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.20.20.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}