{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface POS1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface POS1/0/0",
        "explanation": "配置接口 'POS1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.1.1.2 255.255.255.252": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.2，子网掩码为 255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "clock source line": {
            "template": "clock source [parameter1]",
            "command": "clock source line",
            "explanation": "设置时钟源为线路",
            "parameters": [
                {
                    "name": "clock source",
                    "type": "string",
                    "explanation": "时钟源"
                }
            ]
        },
        "clock rate 2000000": {
            "template": "clock rate [parameter1]",
            "command": "clock rate 2000000",
            "explanation": "设置时钟速率 2000000 单位是波特率",
            "parameters": [
                {
                    "name": "clock rate",
                    "type": "integer",
                    "explanation": "时钟速率"
                }
            ]
        }
    },
    "end": {
        "template": "end",
        "command": "end",
        "explanation": "结束配置模式",
        "parameters": []
    }
}