{
    "hostname CE1": {
        "template": "hostname [parameter1]",
        "command": "hostname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch 2": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "批量创建VLAN 2",
        "parameters": [
            {
                "name": "vlan numbers",
                "type": "integer",
                "explanation": "要创建的VLAN编号"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置接口 'GigabitEthernet1/0/1'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "switchport access vlan 2": {
            "template": "switchport access vlan [parameter1]",
            "command": "switchport access vlan 2",
            "explanation": "将接口设置为访问模式，并分配到VLAN 2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN编号"
                }
            ]
        }
    }
}