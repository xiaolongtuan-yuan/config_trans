{
    "sysname DeviceC": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "设备的主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置 GigabitEthernet1/0/0 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "要配置的接口的名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 192.168.51.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.51.2 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 192.168.51.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "接口的 IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "interface Tunnel 10": {
        "template": "interface [parameter1]",
        "command": "interface Tunnel 10",
        "explanation": "配置 Tunnel 10 接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "要配置的接口的名称"
            }
        ],
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的 IPv6 功能",
            "parameters": []
        },
        "ipv6 address 2001:db8::2/64": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8::2/64",
            "explanation": "配置接口的 IPv6 地址为 2001:db8::2/64",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "接口的 IPv6 地址及前缀长度"
                }
            ]
        },
        "tunnel-protocol ipv6-ipv4": {
            "template": "tunnel-protocol [parameter1]",
            "command": "tunnel-protocol ipv6-ipv4",
            "explanation": "设置隧道协议为 IPv6 over IPv4",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "隧道协议类型"
                }
            ]
        },
        "source 192.168.51.2": {
            "template": "source [parameter1]",
            "command": "source 192.168.51.2",
            "explanation": "设置隧道的源 IPv4 地址",
            "parameters": [
                {
                    "name": "source address",
                    "type": "IPv4",
                    "explanation": "隧道的源 IPv4 地址"
                }
            ]
        },
        "destination 192.168.50.2": {
            "template": "destination [parameter1]",
            "command": "destination 192.168.50.2",
            "explanation": "设置隧道的目的 IPv4 地址",
            "parameters": [
                {
                    "name": "destination address",
                    "type": "IPv4",
                    "explanation": "隧道的目的 IPv4 地址"
                }
            ]
        }
    },
    "ip route-static 192.168.50.0 255.255.255.0 192.168.51.1": {
        "template": "ip route-static [parameter1] [parameter2] [parameter3]",
        "command": "ip route-static 192.168.50.0 255.255.255.0 192.168.51.1",
        "explanation": "配置静态路由，目标网络 192.168.50.0/24，下一跳地址 192.168.51.1",
        "parameters": [
            {
                "name": "destination network",
                "type": "IPv4",
                "explanation": "静态路由的目标网络地址"
            },
            {
                "name": "subnet mask",
                "type": "IPv4",
                "explanation": "目标网络的子网掩码"
            },
            {
                "name": "next hop address",
                "type": "IPv4",
                "explanation": "到达目标网络的下一跳路由器的 IP 地址"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式并返回上一级模式",
        "parameters": []
    }
}