            }
        ],
        "rule 1 permit ip source 192.168.10.0 0.0.0.255": {
            "template": "rule [parameter1] permit ip source [parameter2] [parameter3]",
            "command": "rule 1 permit ip source 192.168.10.0 0.0.0.255",
            "explanation": "在ACL中添加一条规则，允许源地址为192.168.10.0/255.255.255.0的IP流量",
            "parameters": [
                {
                    "name": "rule number",
                    "type": "integer",
