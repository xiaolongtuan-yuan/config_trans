                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "许可动作，如permit或deny"
                },
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "协议类型，如ip"
                },
                {
                    "name": "source IP",
                    "type": "IPv4",
                    "explanation": "源IP地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                }
            ]
        }
    },
