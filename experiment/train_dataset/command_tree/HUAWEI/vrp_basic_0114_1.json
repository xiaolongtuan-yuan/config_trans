{
    "sysname client001": {
        "template": "sysname [parameter1]",
        "command": "sysname client001",
        "explanation": "设置设备的主机名为 'client001'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet0/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet0/0/0",
        "explanation": "配置指定的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 192.168.0.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 192.168.0.1 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 192.168.0.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "ip domain example.com": {
        "template": "ip domain [parameter1]",
        "command": "ip domain example.com",
        "explanation": "设置IP域名",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "域名"
            }
        ]
    },
    "rsa local-key-pair create": {
        "template": "rsa local-key-pair create",
        "command": "rsa local-key-pair create",
        "explanation": "生成本地RSA密钥对",
        "parameters": []
    },
    "ssh server enable": {
        "template": "ssh server enable",
        "command": "ssh server enable",
        "explanation": "启用SSH服务器",
        "parameters": []
    },
    "ssh authentication-type default password": {
        "template": "ssh authentication-type default [parameter1]",
        "command": "ssh authentication-type default password",
        "explanation": "设置SSH默认认证类型为密码",
        "parameters": [
            {
                "name": "authentication type",
                "type": "string",
                "explanation": "认证类型"
            }
        ]
    },
    "user-interface vty 0 4": {
        "template": "user-interface vty [parameter1] [parameter2]",
        "command": "user-interface vty 0 4",
        "explanation": "配置VTTY用户界面",
        "parameters": [
            {
                "name": "start vty number",
                "type": "integer",
                "explanation": "起始VTTY编号"
            },
            {
                "name": "end vty number",
                "type": "integer",
                "explanation": "结束VTTY编号"
            }
        ],
        "authentication-mode aaa": {
            "template": "authentication-mode [parameter1]",
            "command": "authentication-mode aaa",
            "explanation": "设置认证模式为AAA",
            "parameters": [
                {
                    "name": "authentication mode",
                    "type": "string",
                    "explanation": "认证模式"
                }
            ]
        },
        "protocol inbound ssh": {
            "template": "protocol inbound [parameter1]",
            "command": "protocol inbound ssh",
            "explanation": "允许SSH协议进入",
            "parameters": [
                {
                    "name": "protocol type",
                    "type": "string",
                    "explanation": "协议类型"
                }
            ]
        }
    }
}