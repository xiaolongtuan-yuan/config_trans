            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 10.1.3.3 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.3.3 255.255.255.0",
            "explanation": "配置接口的IPv4地址为10.1.3.3，子网掩码为255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "stelnet server enable": {
        "template": "stelnet server enable",
        "command": "stelnet server enable",
        "explanation": "启用STELNET服务器",
        "parameters": []
    },
    "ssh server version 2": {
        "template": "ssh server version [parameter1]",
        "command": "ssh server version 2",
        "explanation": "设置SSH服务器的版本为2",
        "parameters": [
            {
                "name": "version",
                "type": "integer",
                "explanation": "SSH协议的版本号"
            }
        ]
    },
    "user-interface vty 0 4": {
        "template": "user-interface vty [parameter1] [parameter2]",
