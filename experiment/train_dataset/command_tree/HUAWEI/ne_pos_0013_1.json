{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Pos1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "配置特定的接口，这里是指 Pos1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "link-protocol ppp": {
            "template": "link-protocol [parameter1]",
            "command": "link-protocol ppp",
            "explanation": "设置接口的链路协议为PPP",
            "parameters": [
                {
                    "name": "protocol",
                    "type": "string",
                    "explanation": "链路协议名称"
                }
            ]
        },
        "ip address 10.1.1.2 255.255.255.252": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.252",
            "explanation": "配置接口的IPv4地址为10.1.1.2，子网掩码为255.255.255.252",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "clock slave": {
            "template": "clock slave",
            "command": "clock slave",
            "explanation": "设置时钟为从模式",
            "parameters": []
        },
        "clock frequency 2000000": {
            "template": "clock frequency [parameter1]",
            "command": "clock frequency 2000000",
            "explanation": "设置时钟频率为2,000,000 Hz",
            "parameters": [
                {
                    "name": "frequency",
                    "type": "integer",
                    "explanation": "时钟频率值"
                }
            ]
        }
    }
}