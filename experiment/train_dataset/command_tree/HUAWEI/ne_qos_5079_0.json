        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "差分服务域的名称"
            }
        ],
        "8021p-outbound cs6 red map 5": {
            "template": "8021p-outbound [parameter1] [parameter2] [parameter3]",
            "command": "8021p-outbound cs6 red map 5",
