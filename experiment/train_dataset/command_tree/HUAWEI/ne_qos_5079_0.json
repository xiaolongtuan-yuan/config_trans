{
    "sysname PE1": {
        "template": "sysname [parameter1]",
        "command": "sysname PE1",
        "explanation": "设置设备的主机名为 'PE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "diffserv domain gina": {
