            "parameters": [
                {
                    "name": "service class",
                    "type": "string",
                    "explanation": "服务等级代码"
                },
                {
                    "name": "color mark",
                    "type": "string",
                    "explanation": "颜色标记"
                },
                {
                    "name": "map value",
                    "type": "integer",
                    "explanation": "映射的优先级值"
                }
            ]
        }
    },
    "bridge-domain 10": {
        "template": "bridge-domain [parameter1]",
