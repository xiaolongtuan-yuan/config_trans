{
    "interface GigabitEthernet1/0/1": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "配置指定的接口。",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口的名称，例如 GigabitEthernet1/0/1"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口，取消关闭状态。",
            "parameters": []
        },
        "ip address 2.1.1.1 255.255.255.0": {
            "template": "ip address [ip-address] [mask]",
            "command": "ip address 2.1.1.1 255.255.255.0",
            "explanation": "配置接口的IP地址和子网掩码。",
            "parameters": [
                {
                    "name": "ip-address",
                    "type": "IPv4",
                    "explanation": "接口的IP地址。"
                },
                {
                    "name": "mask",
                    "type": "IPv4",
                    "explanation": "子网掩码。"
                }
            ]
        }
    }
}