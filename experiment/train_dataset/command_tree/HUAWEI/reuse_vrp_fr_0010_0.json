{
    "sysname DeviceA": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceA",
        "explanation": "设置设备的主机名为 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Pos1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "配置指定的接口，这里是 POS 1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "link-protocol fr": {
            "template": "link-protocol fr",
            "command": "link-protocol fr",
            "explanation": "设置接口的链路层协议为帧中继 (Frame Relay)",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "fr interface-type dce": {
            "template": "fr interface-type dce",
            "command": "fr interface-type dce",
            "explanation": "设置接口的帧中继接口类型为 DCE (Data Communication Equipment)",
            "parameters": []
        }
    },
    "interface Pos1/0/0.1 p2p": {
        "template": "interface [parameter1] p2p",
        "command": "interface Pos1/0/0.1 p2p",
        "explanation": "配置点对点子接口 POS1/0/0.1",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "subinterface type",
                "type": "string",
                "explanation": "子接口类型，这里是点对点 (p2p)"
            }
        ],
        "ip address 10.1.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.1.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "fr dlci 100": {
            "template": "fr dlci [parameter1]",
            "command": "fr dlci 100",
            "explanation": "配置帧中继的 DLCI (Data Link Connection Identifier) 为 100",
            "parameters": [
                {
                    "name": "dlci",
                    "type": "integer",
                    "explanation": "DLCI 值"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回上一级或主模式",
        "parameters": []
    }
}