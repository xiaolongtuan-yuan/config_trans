                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Eth-Trunk1": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1",
        "explanation": "进入Eth-Trunk1接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
