            "parameters": []
        }
    },
    "interface Eth-Trunk1.1": {
        "template": "interface [parameter1]",
        "command": "interface Eth-Trunk1.1",
        "explanation": "进入Eth-Trunk1.1子接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "子接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用子接口 (默认情况下子接口是关闭的)",
            "parameters": []
        },
        "vlan-type dot1q 10": {
            "template": "vlan-type dot1q [parameter1]",
            "command": "vlan-type dot1q 10",
            "explanation": "配置子接口的VLAN类型为dot1q，并指定VLAN ID为10",
            "parameters": [
                {
                    "name": "VLAN ID",
                    "type": "integer",
                    "explanation": "VLAN标识符"
                }
            ]
        },
        "ip address 10.10.10.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.10.1 255.255.255.0",
            "explanation": "配置子接口的IPv4地址为 10.10.10.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "arp-proxy inner-sub-vlan-proxy enable": {
            "template": "arp-proxy inner-sub-vlan-proxy enable",
            "command": "arp-proxy inner-sub-vlan-proxy enable",
            "explanation": "启用子接口的内层子VLAN的ARP代理功能",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
