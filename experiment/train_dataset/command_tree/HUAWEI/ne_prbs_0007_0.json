    "test connectivity interface Serial1/0/0:1 uni-direction pattern prbs15 interval second 20 interval-repeat 5": {
        "template": "test connectivity interface [parameter1] uni-direction pattern [parameter2] interval [parameter3] [parameter4] interval-repeat [parameter5]",
        "command": "test connectivity interface Serial1/0/0:1 uni-direction pattern prbs15 interval second 20 interval-repeat 5",
        "explanation": "测试接口Serial1/0/0:1的连通性，单向，使用PRBS15图案，间隔20秒，重复5次",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称，例如Serial1/0/0:1"
            },
            {
                "name": "pattern",
                "type": "string",
                "explanation": "测试图案，例如prbs15"
            },
            {
                "name": "interval unit",
                "type": "string",
                "explanation": "间隔单位，例如second"
            },
            {
                "name": "interval value",
                "type": "integer",
                "explanation": "间隔值，例如20"
            },
            {
                "name": "repeat count",
                "type": "integer",
                "explanation": "重复次数，例如5"
            }
        ]
    }
