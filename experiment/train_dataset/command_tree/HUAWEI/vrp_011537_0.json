{
    "sysname CE1": {
        "template": "sysname [parameter1]",
        "command": "sysname CE1",
        "explanation": "设置设备的主机名为 'CE1'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "vlan batch 2": {
        "template": "vlan batch [parameter1]",
        "command": "vlan batch 2",
        "explanation": "批量创建VLAN 2",
        "parameters": [
            {
                "name": "vlan id",
                "type": "integer",
                "explanation": "VLAN ID"
            }
        ]
    },
    "cfm version standard": {
        "template": "cfm version [parameter1]",
        "command": "cfm version standard",
        "explanation": "设置CFM版本为标准",
        "parameters": [
            {
                "name": "version",
                "type": "string",
                "explanation": "CFM版本"
            }
        ]
    },
    "cfm enable": {
        "template": "cfm enable",
        "command": "cfm enable",
        "explanation": "启用CFM功能",
        "parameters": []
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "port default vlan 2": {
            "template": "port default vlan [parameter1]",
            "command": "port default vlan 2",
            "explanation": "设置接口的默认VLAN为2",
            "parameters": [
                {
                    "name": "vlan id",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        }
    },
    "cfm md md1": {
        "template": "cfm md [parameter1]",
        "command": "cfm md md1",
        "explanation": "创建或进入CFM域md1的配置模式",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "CFM域名称"
            }
        ],
        "ma ma2": {
            "template": "ma [parameter1]",
            "command": "ma ma2",
            "explanation": "创建或进入MA ma2的配置模式",
            "parameters": [
                {
                    "name": "ma name",
                    "type": "string",
                    "explanation": "MA名称"
                }
            ],
            "map vlan 2": {
                "template": "map vlan [parameter1]",
                "command": "map vlan 2",
                "explanation": "将MA映射到VLAN 2",
                "parameters": [
                    {
                        "name": "vlan id",
                        "type": "integer",
                        "explanation": "VLAN ID"
                    }
                ]
            },
            "mep mep-id 3 interface GigabitEthernet1/0/1 outward": {
                "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
                "command": "mep mep-id 3 interface GigabitEthernet1/0/1 outward",
                "explanation": "配置MEP ID 3在接口GigabitEthernet1/0/1上，方向为outward",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    },
                    {
                        "name": "interface name",
                        "type": "string",
                        "explanation": "接口名称"
                    },
                    {
                        "name": "direction",
                        "type": "string",
                        "explanation": "方向（inward或outward）"
                    }
                ]
            },
            "mep ccm-send mep-id 3 enable": {
                "template": "mep ccm-send mep-id [parameter1] enable",
                "command": "mep ccm-send mep-id 3 enable",
                "explanation": "启用MEP ID 3的CCM发送",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "MEP ID"
                    }
                ]
            },
            "remote-mep mep-id 4": {
                "template": "remote-mep mep-id [parameter1]",
                "command": "remote-mep mep-id 4",
                "explanation": "配置远程MEP ID 4",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "remote-mep ccm-receive mep-id 4 enable": {
                "template": "remote-mep ccm-receive mep-id [parameter1] enable",
                "command": "remote-mep ccm-receive mep-id 4 enable",
                "explanation": "启用远程MEP ID 4的CCM接收",
                "parameters": [
                    {
                        "name": "mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "test-id 2 mep 3 remote-mep 4": {
                "template": "test-id [parameter1] mep [parameter2] remote-mep [parameter3]",
                "command": "test-id 2 mep 3 remote-mep 4",
                "explanation": "配置测试ID 2，本地MEP 3和远程MEP 4",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    },
                    {
                        "name": "local mep-id",
                        "type": "integer",
                        "explanation": "本地MEP ID"
                    },
                    {
                        "name": "remote mep-id",
                        "type": "integer",
                        "explanation": "远程MEP ID"
                    }
                ]
            },
            "loss-measure dual-ended continual test-id 2": {
                "template": "loss-measure dual-ended continual test-id [parameter1]",
                "command": "loss-measure dual-ended continual test-id 2",
                "explanation": "配置双端连续性测试，测试ID为2",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "测试ID"
                    }
                ]
            }
        }
    }
}