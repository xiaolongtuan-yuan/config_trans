{
    "sysname PE2": {
        "template": "sysname [parameter1]",
        "command": "sysname PE2",
        "explanation": "设置设备的主机名为 'PE2'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "diffserv domain gina": {
        "template": "diffserv domain [parameter1]",
        "command": "diffserv domain gina",
        "explanation": "创建或进入差分服务域 'gina'",
        "parameters": [
            {
                "name": "domain name",
                "type": "string",
                "explanation": "差分服务域的名称"
            }
        ],
        "8021p-inbound 2 phb af1 green": {
            "template": "8021p-inbound [parameter1] phb [parameter2] [parameter3]",
            "command": "8021p-inbound 2 phb af1 green",
            "explanation": "配置802.1p优先级2映射到PHB af1，颜色标记为green",
            "parameters": [
                {
                    "name": "8021p priority",
                    "type": "integer",
                    "explanation": "802.1p优先级值"
                },
                {
                    "name": "phb",
                    "type": "string",
                    "explanation": "PHB类别"
                },
                {
                    "name": "color",
                    "type": "string",
                    "explanation": "颜色标记"
                }
            ]
        }
    },
    "bridge-domain 10": {
        "template": "bridge-domain [parameter1]",
        "command": "bridge-domain 10",
        "explanation": "创建或进入桥接域10",
        "parameters": [
            {
                "name": "bridge domain id",
                "type": "integer",
                "explanation": "桥接域的标识号"
            }
        ]
    },
    "interface GigabitEthernet1/0/1": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/1",
        "explanation": "进入GigabitEthernet1/0/1接口的配置模式",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        }
    },
    "interface GigabitEthernet 1/0/1.1 mode l2": {
        "template": "interface [parameter1] mode [parameter2]",
        "command": "interface GigabitEthernet 1/0/1.1 mode l2",
        "explanation": "进入GigabitEthernet1/0/1.1接口的配置模式，并设置模式为l2",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名称"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式，如l2"
            }
        ],
        "encapsulation dot1q vid 10": {
            "template": "encapsulation dot1q vid [parameter1]",
            "command": "encapsulation dot1q vid 10",
            "explanation": "配置接口的封装为dot1q，VLAN ID为10",
            "parameters": [
                {
                    "name": "vid",
                    "type": "integer",
                    "explanation": "VLAN ID"
                }
            ]
        },
        "bridge-domain 10": {
            "template": "bridge-domain [parameter1]",
            "command": "bridge-domain 10",
            "explanation": "将接口关联到桥接域10",
            "parameters": [
                {
                    "name": "bridge domain id",
                    "type": "integer",
                    "explanation": "桥接域的标识号"
                }
            ]
        },
        "trust upstream gina": {
            "template": "trust upstream [parameter1]",
            "command": "trust upstream gina",
            "explanation": "设置信任上游的差分服务域 'gina'",
            "parameters": [
                {
                    "name": "domain name",
                    "type": "string",
                    "explanation": "差分服务域的名称"
                }
            ]
        },
        "qos phb outer-8021p disable": {
            "template": "qos phb outer-8021p disable",
            "command": "qos phb outer-8021p disable",
            "explanation": "禁用外层802.1p优先级的PHB",
            "parameters": []
        },
        "qos phb mpls-exp disable": {
            "template": "qos phb mpls-exp disable",
            "command": "qos phb mpls-exp disable",
            "explanation": "禁用MPLS实验位的PHB",
            "parameters": []
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式",
        "parameters": []
    }
}