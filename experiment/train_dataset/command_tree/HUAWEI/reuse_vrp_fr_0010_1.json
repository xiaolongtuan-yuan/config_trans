{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface Pos1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface Pos1/0/0",
        "explanation": "配置特定的接口，这里是Pos1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "link-protocol fr": {
            "template": "link-protocol fr",
            "command": "link-protocol fr",
            "explanation": "设置链路协议为帧中继 (FR)",
            "parameters": []
        },
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        }
    },
    "interface Pos1/0/0.1 p2p": {
        "template": "interface [parameter1] p2p",
        "command": "interface Pos1/0/0.1 p2p",
        "explanation": "配置子接口 Pos1/0/0.1 为点对点 (p2p) 模式",
        "parameters": [
            {
                "name": "subinterface name",
                "type": "string",
                "explanation": "子接口名"
            },
            {
                "name": "mode",
                "type": "string",
                "explanation": "接口模式，这里是 p2p"
            }
        ],
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        },
        "fr dlci 100": {
            "template": "fr dlci [parameter1]",
            "command": "fr dlci 100",
            "explanation": "配置帧中继的 DLCI (Data Link Connection Identifier) 为 100",
            "parameters": [
                {
                    "name": "dlci",
                    "type": "integer",
                    "explanation": "数据链路连接标识符"
                }
            ]
        }
    }
}