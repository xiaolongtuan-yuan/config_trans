            "parameters": [
                {
                    "name": "802.1p priority",
                    "type": "integer",
                    "explanation": "802.1p优先级值"
                },
                {
                    "name": "PHB",
                    "type": "string",
                    "explanation": "服务质量类别"
                },
                {
                    "name": "color mark",
                    "type": "string",
                    "explanation": "颜色标记（绿色、黄色、红色）"
                }
            ]
        },
        "ip-dscp-outbound ef green map 34": {
            "template": "ip-dscp-outbound [parameter1] [parameter2] map [parameter3]",
            "command": "ip-dscp-outbound ef green map 34",
            "explanation": "配置出站IP DSCP值为EF，颜色标记为绿色，映射到34",
            "parameters": [
                {
                    "name": "PHB",
                    "type": "string",
                    "explanation": "服务质量类别"
                },
                {
                    "name": "color mark",
                    "type": "string",
                    "explanation": "颜色标记（绿色、黄色、红色）"
                },
                {
                    "name": "mapped value",
                    "type": "integer",
                    "explanation": "映射的DSCP值"
                }
            ]
        }
