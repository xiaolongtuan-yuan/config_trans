                "explanation": "源网络地址"
            },
            {
                "name": "wildcard mask",
                "type": "IPv4",
                "explanation": "通配符掩码"
            },
            {
                "name": "destination",
                "type": "string",
                "explanation": "目标地址，'any' 表示任意地址"
            }
        ]
    },
