{
    "set system": {
        "set system host-name CE3": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE3",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces ge-1/0/0 unit 0 family inet address 10.3.1.1/24": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-1/0/0 unit 0 family inet address 10.3.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        },
        "set interfaces ge-1/0/0 unit 0 disable": {
            "template": "set interfaces [parameter1] unit [parameter2] disable",
            "command": "set interfaces ge-1/0/0 unit 0 disable",
            "explanation": "禁用指定接口单元。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        }
    },
    "set routing-options": {
        "set routing-options autonomous-system 65430": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 65430",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "autonomous-system",
                    "type": "integer",
                    "explanation": "设备的自治系统号，用于BGP等协议。"
                }
            ]
        }
    },
    "set protocols": {
        "set protocols bgp group BGP-PEERS type external": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group BGP-PEERS type external",
            "explanation": "配置BGP组的类型为外部。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group BGP-PEERS peer-as 100": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group BGP-PEERS peer-as 100",
            "explanation": "配置BGP组的对等体自治系统号。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp group BGP-PEERS neighbor 10.3.1.2": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group BGP-PEERS neighbor 10.3.1.2",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group BGP-PEERS family inet unicast": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group BGP-PEERS family inet unicast",
            "explanation": "配置BGP组支持IPv4单播地址族。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族的具体类型，例如unicast。"
                }
            ]
        },
        "set protocols bgp group BGP-PEERS export EXPORT-NETWORK": {
            "template": "set protocols bgp group [parameter1] export [parameter2]",
            "command": "set protocols bgp group BGP-PEERS export EXPORT-NETWORK",
            "explanation": "配置BGP组使用指定的导出策略。",
            "parameters": [
                {
                    "name": "group",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "export-policy",
                    "type": "string",
                    "explanation": "导出策略的名称。"
                }
            ]
        }
    },
    "set policy-options": {
        "set policy-options policy-statement EXPORT-NETWORK term 1 from route-filter 10.3.1.0/24 exact": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] from route-filter [parameter3]/[parameter4] [parameter5]",
            "command": "set policy-options policy-statement EXPORT-NETWORK term 1 from route-filter 10.3.1.0/24 exact",
            "explanation": "配置策略语句的匹配条件。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "route-filter",
                    "type": "string",
                    "explanation": "路由过滤器的网络地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "路由过滤器的子网掩码位数。"
                },
                {
                    "name": "match-type",
                    "type": "string",
                    "explanation": "匹配类型，例如exact。"
                }
            ]
        },
        "set policy-options policy-statement EXPORT-NETWORK term 1 then accept": {
            "template": "set policy-options policy-statement [parameter1] term [parameter2] then [parameter3]",
            "command": "set policy-options policy-statement EXPORT-NETWORK term 1 then accept",
            "explanation": "配置策略语句的动作。",
            "parameters": [
                {
                    "name": "policy-statement",
                    "type": "string",
                    "explanation": "策略语句的名称。"
                },
                {
                    "name": "term",
                    "type": "integer",
                    "explanation": "策略语句的术语编号。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "动作类型，例如accept。"
                }
            ]
        }
    }
}