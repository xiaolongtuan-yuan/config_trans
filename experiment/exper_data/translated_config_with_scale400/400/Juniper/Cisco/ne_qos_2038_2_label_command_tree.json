{
    "hostname DeviceC": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceC",
        "explanation": "设置设备的主机名为 'DeviceC'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "配置接口 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "启用接口（默认情况下接口是关闭的）",
            "parameters": []
        },
        "ip address 10.20.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.20.1.1 255.255.255.0",
            "explanation": "配置接口的 IPv4 地址为 10.20.1.1，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "router bgp 100": {
        "template": "router bgp [parameter1]",
        "command": "router bgp 100",
        "explanation": "配置 BGP 路由器，AS 号为 100",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "自治系统编号"
            }
        ],
        "neighbor 10.20.1.2 remote-as 100": {
            "template": "neighbor [parameter1] remote-as [parameter2]",
            "command": "neighbor 10.20.1.2 remote-as 100",
            "explanation": "配置 BGP 邻居，IP 地址为 10.20.1.2，AS 号为 100",
            "parameters": [
                {
                    "name": "neighbor IP",
                    "type": "IPv4",
                    "explanation": "邻居的 IP 地址"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "邻居的 AS 号"
                }
            ]
        },
        "address-family ipv4 unicast": {
            "template": "address-family [parameter1] [parameter2]",
            "command": "address-family ipv4 unicast",
            "explanation": "进入 IPv4 单播地址族配置模式",
            "parameters": [
                {
                    "name": "address family",
                    "type": "string",
                    "explanation": "地址族类型"
                },
                {
                    "name": "unicast",
                    "type": "string",
                    "explanation": "单播类型"
                }
            ],
            "synchronization": {
                "template": "synchronization",
                "command": "synchronization",
                "explanation": "启用 BGP 同步",
                "parameters": []
            },
            "redistribute connected": {
                "template": "redistribute [parameter1]",
                "command": "redistribute connected",
                "explanation": "重分布直连路由到 BGP",
                "parameters": [
                    {
                        "name": "routing protocol",
                        "type": "string",
                        "explanation": "要重分布的路由协议"
                    }
                ]
            },
            "neighbor 10.20.1.2 activate": {
                "template": "neighbor [parameter1] activate",
                "command": "neighbor 10.20.1.2 activate",
                "explanation": "激活指定邻居在当前地址族",
                "parameters": [
                    {
                        "name": "neighbor IP",
                        "type": "IPv4",
                        "explanation": "邻居的 IP 地址"
                    }
                ]
            }
        }
    },
    "router ospf 1": {
        "template": "router ospf [parameter1]",
        "command": "router ospf 1",
        "explanation": "配置 OSPF 进程，进程 ID 为 1",
        "parameters": [
            {
                "name": "process ID",
                "type": "integer",
                "explanation": "OSPF 进程 ID"
            }
        ],
        "network 10.20.1.0 0.0.0.255 area 0": {
            "template": "network [parameter1] [parameter2] area [parameter3]",
            "command": "network 10.20.1.0 0.0.0.255 area 0",
            "explanation": "将网络 10.20.1.0/24 归属于 OSPF 区域 0",
            "parameters": [
                {
                    "name": "network address",
                    "type": "IPv4",
                    "explanation": "网络地址"
                },
                {
                    "name": "wildcard mask",
                    "type": "IPv4",
                    "explanation": "反掩码"
                },
                {
                    "name": "area ID",
                    "type": "integer",
                    "explanation": "OSPF 区域 ID"
                }
            ]
        }
    }
}