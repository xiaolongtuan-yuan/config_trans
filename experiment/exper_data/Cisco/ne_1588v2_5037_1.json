{
    "hostname DeviceB": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "ptp domain 0": {
        "template": "ptp domain [parameter1]",
        "command": "ptp domain 0",
        "explanation": "设置 PTP（精密时间协议）的域号为 0",
        "parameters": [
            {
                "name": "domain number",
                "type": "integer",
                "explanation": "PTP 域号"
            }
        ]
    },
    "ptp clock-domain 0": {
        "template": "ptp clock-domain [parameter1]",
        "command": "ptp clock-domain 0",
        "explanation": "设置 PTP 的时钟域号为 0",
        "parameters": [
            {
                "name": "clock domain number",
                "type": "integer",
                "explanation": "PTP 时钟域号"
            }
        ]
    },
    "ptp device-type server": {
        "template": "ptp device-type [parameter1]",
        "command": "ptp device-type server",
        "explanation": "设置设备的 PTP 类型为服务器",
        "parameters": [
            {
                "name": "device type",
                "type": "string",
                "explanation": "PTP 设备类型，如服务器、客户端等"
            }
        ]
    },
    "ptp local-clock 0": {
        "template": "ptp local-clock [parameter1]",
        "command": "ptp local-clock 0",
        "explanation": "设置本地 PTP 时钟为 0",
        "parameters": [
            {
                "name": "local clock number",
                "type": "integer",
                "explanation": "本地 PTP 时钟编号"
            }
        ]
    },
    "ptp local-ip 2.2.2.2": {
        "template": "ptp local-ip [parameter1]",
        "command": "ptp local-ip 2.2.2.2",
        "explanation": "设置 PTP 的本地 IP 地址为 2.2.2.2",
        "parameters": [
            {
                "name": "local IP",
                "type": "IPv4",
                "explanation": "PTP 本地 IP 地址"
            }
        ]
    },
    "ptp unicast-negotiate enable": {
        "template": "ptp unicast-negotiate [parameter1]",
        "command": "ptp unicast-negotiate enable",
        "explanation": "启用 PTP 的单播协商功能",
        "parameters": [
            {
                "name": "enable status",
                "type": "string",
                "explanation": "启用或禁用单播协商，如 enable 或 disable"
            }
        ]
    },
    "interface Loopback0": {
        "template": "interface [parameter1]",
        "command": "interface Loopback0",
        "explanation": "配置接口 'Loopback0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "ip address 2.2.2.2 255.255.255.255": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 2.2.2.2 255.255.255.255",
            "explanation": "配置接口的 IPv4 地址为 2.2.2.2，子网掩码为 255.255.255.255",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 地址"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    }
}