{
  "hostname CE3": {
    "template": "hostname [parameter1]",
    "command": "hostname CE3",
    "explanation": "设置设备的主机名为 'CE3'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface Vlan20": {
    "template": "interface [parameter1]",
    "command": "interface Vlan20",
    "explanation": "配置接口 'Vlan20'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "ip address 192.168.2.12 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 192.168.2.12 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 192.168.2.12，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    }
  },
  "interface GigabitEthernet1/0/0.20": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0.20",
    "explanation": "配置子接口 'GigabitEthernet1/0/0.20'",
    "parameters": [
      {
        "name": "subinterface name",
        "type": "string",
        "explanation": "子接口名"
      }
    ],
    "encapsulation dot1q 20": {
      "template": "encapsulation dot1q [parameter1]",
      "command": "encapsulation dot1q 20",
      "explanation": "配置子接口的封装类型为 dot1q，VLAN ID 为 20",
      "parameters": [
        {
          "name": "VLAN ID",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "bridge-domain 20": {
      "template": "bridge-domain [parameter1]",
      "command": "bridge-domain 20",
      "explanation": "将子接口加入到桥接域 20",
      "parameters": [
        {
          "name": "bridge domain ID",
          "type": "integer",
          "explanation": "桥接域 ID"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}