{
  "hostname UPE3": {
    "template": "hostname [parameter1]",
    "command": "hostname UPE3",
    "explanation": "设置设备的主机名为 'UPE3'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "ip ftp server": {
    "template": "ip ftp server",
    "command": "ip ftp server",
    "explanation": "启用设备的 FTP 服务器功能",
    "parameters": []
  },
  "cfm md MEG-1": {
    "template": "cfm md [parameter1]",
    "command": "cfm md MEG-1",
    "explanation": "配置 CFM（Connectivity Fault Management）的维护域为 'MEG-1'",
    "parameters": [
      {
        "name": "maintenance domain",
        "type": "string",
        "explanation": "维护域名"
      }
    ]
  },
  "cfm ma MA-1 md MEG-1": {
    "template": "cfm ma [parameter1] md [parameter2]",
    "command": "cfm ma MA-1 md MEG-1",
    "explanation": "配置 CFM 的维护关联为 'MA-1'，并关联到维护域 'MEG-1'",
    "parameters": [
      {
        "name": "maintenance association",
        "type": "string",
        "explanation": "维护关联名"
      },
      {
        "name": "maintenance domain",
        "type": "string",
        "explanation": "维护域名"
      }
    ]
  },
  "cfm enable": {
    "template": "cfm enable",
    "command": "cfm enable",
    "explanation": "启用 CFM 功能",
    "parameters": []
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "设置接口模式为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "switchport trunk allowed vlan 2": {
      "template": "switchport trunk allowed vlan [parameter1]",
      "command": "switchport trunk allowed vlan 2",
      "explanation": "允许 VLAN 2 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    },
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    }
  },
