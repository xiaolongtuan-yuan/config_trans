    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "vlan 3": {
    "template": "vlan [parameter1]",
    "command": "vlan 3",
    "explanation": "创建或进入 VLAN 3 的配置模式",
    "parameters": [
      {
        "name": "vlan id",
        "type": "integer",
        "explanation": "VLAN ID"
      }
    ]
  },
  "cfm": {
    "template": "cfm",
    "command": "cfm",
    "explanation": "进入 CFM（Connectivity Fault Management）配置模式",
    "parameters": []
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
