    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "将接口模式设置为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "switchport trunk allowed vlan 3": {
      "template": "switchport trunk allowed vlan [parameter1]",
      "command": "switchport trunk allowed vlan 3",
      "explanation": "允许 VLAN 3 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    }
  },
  "interface GigabitEthernet1/0/2": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/2",
    "explanation": "配置接口 'GigabitEthernet1/0/2'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "switchport mode trunk": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode trunk",
      "explanation": "将接口模式设置为 trunk",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式"
        }
      ]
    },
    "switchport trunk allowed vlan 3": {
      "template": "switchport trunk allowed vlan [parameter1]",
      "command": "switchport trunk allowed vlan 3",
      "explanation": "允许 VLAN 3 通过 trunk 接口",
      "parameters": [
        {
          "name": "vlan id",
          "type": "integer",
          "explanation": "VLAN ID"
        }
      ]
    }
  },
  "ethernet cfm md md1 level 6": {
    "template": "ethernet cfm md [parameter1] level [parameter2]",
    "command": "ethernet cfm md md1 level 6",
    "explanation": "配置 CFM 维护域 'md1' 的级别为 6",
    "parameters": [
      {
        "name": "maintenance domain",
        "type": "string",
        "explanation": "维护域名"
      },
      {
        "name": "level",
        "type": "integer",
        "explanation": "维护域级别"
      }
    ],
    "mep ma2": {
      "template": "mep [parameter1]",
      "command": "mep ma2",
      "explanation": "配置维护端点 'ma2'",
      "parameters": [
        {
          "name": "maintenance endpoint",
          "type": "string",
          "explanation": "维护端点"
        }
      ],
      "ccm-send mep-id 2 enable": {
        "template": "ccm-send mep-id [parameter1] enable",
        "command": "ccm-send mep-id 2 enable",
        "explanation": "启用维护端点 ID 2 的 CCM（Continuity Check Message）发送功能",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "维护端点 ID"
          }
        ]
      },
      "mep mep-id 2 interface GigabitEthernet1/0/0 inward": {
        "template": "mep mep-id [parameter1] interface [parameter2] [parameter3]",
        "command": "mep mep-id 2 interface GigabitEthernet1/0/0 inward",
        "explanation": "配置维护端点 ID 2 绑定到接口 'GigabitEthernet1/0/0'，方向为 inward",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "维护端点 ID"
          },
          {
            "name": "interface name",
            "type": "string",
            "explanation": "接口名"
          },
          {
            "name": "direction",
            "type": "string",
            "explanation": "方向"
          }
        ]
      },
      "remote-mep mep-id 1": {
        "template": "remote-mep mep-id [parameter1]",
        "command": "remote-mep mep-id 1",
        "explanation": "配置远程维护端点 ID 1",
        "parameters": [
          {
            "name": "mep id",
            "type": "integer",
            "explanation": "维护端点 ID"
          }
        ],
        "ccm-receive mep-id 1 enable": {
          "template": "ccm-receive mep-id [parameter1] enable",
          "command": "ccm-receive mep-id 1 enable",
          "explanation": "启用维护端点 ID 1 的 CCM 接收功能",
          "parameters": [
            {
              "name": "mep id",
              "type": "integer",
              "explanation": "维护端点 ID"
            }
          ]
        }
      }
    }
  }
}