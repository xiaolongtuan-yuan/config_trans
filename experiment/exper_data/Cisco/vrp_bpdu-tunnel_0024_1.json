{
  "hostname CE2": {
    "template": "hostname [parameter1]",
    "command": "hostname CE2",
    "explanation": "设置设备的主机名为 'CE2'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "spanning-tree mode enable": {
    "template": "spanning-tree mode [parameter1]",
    "command": "spanning-tree mode enable",
    "explanation": "启用生成树协议",
    "parameters": [
      {
        "name": "mode",
        "type": "string",
        "explanation": "模式，此处为启用"
      }
    ]
  },
  "interface GigabitEthernet1/0/1": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/1",
    "explanation": "配置接口 'GigabitEthernet1/0/1'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "switchport mode access": {
      "template": "switchport mode [parameter1]",
      "command": "switchport mode access",
      "explanation": "设置接口模式为访问模式",
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "explanation": "接口模式，此处为访问模式"
        }
      ]
    }
  },
  "end": {
    "template": "end",
    "command": "end",
    "explanation": "退出配置模式",
    "parameters": []
  }
}