{
  "hostname DeviceC": {
    "template": "hostname [parameter1]",
    "command": "hostname DeviceC",
    "explanation": "设置设备的主机名为 'DeviceC'",
    "parameters": [
      {
        "name": "host name",
        "type": "string",
        "explanation": "主机名"
      }
    ]
  },
  "interface GigabitEthernet1/0/0": {
    "template": "interface [parameter1]",
    "command": "interface GigabitEthernet1/0/0",
    "explanation": "配置接口 'GigabitEthernet1/0/0'",
    "parameters": [
      {
        "name": "interface name",
        "type": "string",
        "explanation": "接口名"
      }
    ],
    "no shutdown": {
      "template": "no shutdown",
      "command": "no shutdown",
      "explanation": "启用接口（默认情况下接口是关闭的）",
      "parameters": []
    },
    "ip address 10.2.1.2 255.255.255.0": {
      "template": "ip address [parameter1] [parameter2]",
      "command": "ip address 10.2.1.2 255.255.255.0",
      "explanation": "配置接口的 IPv4 地址为 10.2.1.2，子网掩码为 255.255.255.0",
      "parameters": [
        {
          "name": "ip address",
          "type": "IPv4",
          "explanation": "IPv4 地址"
        },
        {
          "name": "subnet mask",
          "type": "IPv4",
          "explanation": "子网掩码"
        }
      ]
    }
  },
  "ip route 10.1.1.0 255.255.255.0 10.2.1.1": {
    "template": "ip route [parameter1] [parameter2] [parameter3]",
    "command": "ip route 10.1.1.0 255.255.255.0 10.2.1.1",
    "explanation": "配置静态路由，目的网络为 10.1.1.0/24，下一跳地址为 10.2.1.1",
    "parameters": [
      {
        "name": "destination network",
        "type": "IPv4",
        "explanation": "目的网络地址"
      },
      {
        "name": "subnet mask",
        "type": "IPv4",
        "explanation": "子网掩码"
      },
      {
        "name": "next hop",
        "type": "IPv4",
        "explanation": "下一跳地址"
      }
    ]
  },
  "bfd all-interfaces": {
    "template": "bfd all-interfaces",
    "command": "bfd all-interfaces",
    "explanation": "在所有接口上启用 BFD（双向转发检测）",
    "parameters": [],
    "discriminator local 20": {
      "template": "discriminator local [parameter1]",
      "command": "discriminator local 20",
      "explanation": "设置本地 BFD 会话的标识符为 20",
      "parameters": [
        {
          "name": "local discriminator",
          "type": "integer",
          "explanation": "本地 BFD 会话标识符"
        }
      ]
    },
    "discriminator remote 10": {
      "template": "discriminator remote [parameter1]",
      "command": "discriminator remote 10",
      "explanation": "设置远程 BFD 会话的标识符为 10",
      "parameters": [
        {
          "name": "remote discriminator",
          "type": "integer",
          "explanation": "远程 BFD 会话标识符"
        }
      ]
    }
  },
  "bfd neighbor 10.1.1.1": {
    "template": "bfd neighbor [parameter1]",
    "command": "bfd neighbor 10.1.1.1",
    "explanation": "配置 BFD 邻居，邻居地址为 10.1.1.1",
    "parameters": [
      {
        "name": "neighbor address",
        "type": "IPv4",
        "explanation": "BFD 邻居的 IPv4 地址"
      }
    ]
  }
}