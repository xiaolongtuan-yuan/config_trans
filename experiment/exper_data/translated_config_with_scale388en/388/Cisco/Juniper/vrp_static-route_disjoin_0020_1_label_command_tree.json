        "set routing-options static route 0.0.0.0/0 next-hop 10.10.1.1": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3]",
            "command": "set routing-options static route 0.0.0.0/0 next-hop 10.10.1.1",
