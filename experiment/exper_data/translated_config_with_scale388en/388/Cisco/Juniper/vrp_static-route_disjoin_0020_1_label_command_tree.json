                }
            ]
        },
        "set routing-options static route 1.1.1.1/32 next-hop 10.10.1.1 bfd-liveness-detection minimum-interval 1000": {
            "template": "set routing-options static route [parameter1]/[parameter2] next-hop [parameter3] bfd-liveness-detection minimum-interval [parameter4]",
            "command": "set routing-options static route 1.1.1.1/32 next-hop 10.10.1.1 bfd-liveness-detection minimum-interval 1000",
            "explanation": "配置静态路由，并启用BFD存活检测。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目标网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目标网络的前缀长度。"
                },
                {
                    "name": "next-hop",
