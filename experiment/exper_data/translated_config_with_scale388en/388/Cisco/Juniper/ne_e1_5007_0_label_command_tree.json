{
    "set system": {
        "set system host-name DeviceA": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces e1-1/0/0 framing no-crc4": {
            "template": "set interfaces [parameter1] framing [parameter2]",
            "command": "set interfaces e1-1/0/0 framing no-crc4",
            "explanation": "配置E1接口的帧格式为no-crc4。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "framing",
                    "type": "string",
                    "explanation": "帧格式，例如no-crc4。"
                }
            ]
        },
        "set interfaces e1-1/0/0 encoding hdb3": {
            "template": "set interfaces [parameter1] encoding [parameter2]",
            "command": "set interfaces e1-1/0/0 encoding hdb3",
            "explanation": "配置E1接口的编码方式为hdb3。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "encoding",
                    "type": "string",
                    "explanation": "编码方式，例如hdb3。"
                }
            ]
        },
        "set interfaces e1-1/0/0 clocking internal": {
            "template": "set interfaces [parameter1] clocking [parameter2]",
            "command": "set interfaces e1-1/0/0 clocking internal",
            "explanation": "配置E1接口的时钟源为内部时钟。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "clocking",
                    "type": "string",
                    "explanation": "时钟源，例如internal。"
                }
            ]
        },
        "set interfaces e1-1/0/0 cable-length long": {
            "template": "set interfaces [parameter1] cable-length [parameter2]",
            "command": "set interfaces e1-1/0/0 cable-length long",
            "explanation": "配置E1接口的电缆长度为长距离。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "cable-length",
                    "type": "string",
                    "explanation": "电缆长度，例如long。"
                }
            ]
        },
        "set interfaces e1-1/0/0 unit 0 encapsulation ppp": {
            "template": "set interfaces [parameter1] unit [parameter2] encapsulation [parameter3]",
            "command": "set interfaces e1-1/0/0 unit 0 encapsulation ppp",
            "explanation": "配置E1接口的单元0的封装类型为PPP。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "encapsulation",
                    "type": "string",
                    "explanation": "封装类型，例如ppp。"
                }
            ]
        },
        "set interfaces e1-1/0/0 unit 0 ppp-options multilink group 1": {
            "template": "set interfaces [parameter1] unit [parameter2] ppp-options multilink group [parameter3]",
            "command": "set interfaces e1-1/0/0 unit 0 ppp-options multilink group 1",
            "explanation": "配置E1接口的单元0的PPP多链路选项，加入组1。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如e1-1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "group",
                    "type": "integer",
                    "explanation": "多链路组号，例如1。"
                }
            ]
        },
        "set interfaces multilink-1 unit 0 family inet address 10.1.1.1/24": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces multilink-1 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置多链路接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如multilink-1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    }
}