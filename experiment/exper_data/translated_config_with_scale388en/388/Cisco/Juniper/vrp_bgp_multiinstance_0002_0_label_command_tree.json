{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-0/1/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/1/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.1.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options static route 192.168.1.1/32 discard": {
        "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
        "command": "set routing-options static route 192.168.1.1/32 discard",
        "explanation": "Configures the static route and specifies the next jump to discard.",
        "parameters": [
            {
                "name": "route",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "bits of subnet mask."
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "Next jump address, like Discard."
            }
        ]
    },
    "set routing-options autonomous-system 200": {
        "template": "set routing-options autonomous-system [parameter1]",
        "command": "set routing-options autonomous-system 200",
        "explanation": "Autonomy system number with equipment.",
        "parameters": [
            {
                "name": "autonomous-system",
                "type": "integer",
                "explanation": "Autonomy system number for equipment, used for route agreements such as BGP."
            }
        ]
    },
    "set protocols bgp group EBGP-100": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group EBGP-100",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type external": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, for example, external."
                }
            ]
        },
        "peer-as 100": {
            "template": "peer-as [parameter2]",
            "command": "peer-as 100",
            "explanation": "The equivalent autonomy system number for BGP groups.",
            "parameters": [
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "Equivalent Autonomy System Number."
                }
            ]
        },
        "neighbor 10.1.1.2": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 10.1.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ]
        },
        "family inet unicast": {
            "template": "family inet [parameter2]",
            "command": "family inet unicast",
            "explanation": "Configure the IPv4 solo address of the BGP group.",
            "parameters": [
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "Address community type."
                }
            ]
        }
    }
}