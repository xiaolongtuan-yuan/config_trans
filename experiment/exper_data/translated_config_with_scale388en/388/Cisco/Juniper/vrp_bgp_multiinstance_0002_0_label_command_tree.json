{
    "set system": {
        "set system host-name DeviceA": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceA",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces ge-0/1/0 unit 0 family inet address 10.1.1.1/24": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4]",
            "command": "set interfaces ge-0/1/0 unit 0 family inet address 10.1.1.1/24",
            "explanation": "配置接口的IPv4地址及子网掩码。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/1/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv4地址。"
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "IPv4子网掩码的位数。"
                }
            ]
        }
    },
    "set routing-options": {
        "set routing-options static route 192.168.1.1/32 discard": {
            "template": "set routing-options static route [parameter1]/[parameter2] [parameter3]",
            "command": "set routing-options static route 192.168.1.1/32 discard",
            "explanation": "配置静态路由，指定目的地址和操作。",
            "parameters": [
                {
                    "name": "destination",
                    "type": "string",
                    "explanation": "目的网络地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "目的网络地址的前缀长度。"
                },
                {
                    "name": "action",
                    "type": "string",
                    "explanation": "对匹配该路由的流量执行的操作，例如discard。"
                }
            ]
        },
        "set routing-options autonomous-system 200": {
            "template": "set routing-options autonomous-system [parameter1]",
            "command": "set routing-options autonomous-system 200",
            "explanation": "配置设备的自治系统号。",
            "parameters": [
                {
                    "name": "as-number",
                    "type": "integer",
                    "explanation": "设备的自治系统号。"
                }
            ]
        }
    },
    "set protocols": {
        "set protocols bgp group EBGP-100 type external": {
            "template": "set protocols bgp group [parameter1] type [parameter2]",
            "command": "set protocols bgp group EBGP-100 type external",
            "explanation": "配置BGP组的类型。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "BGP组的类型，例如external。"
                }
            ]
        },
        "set protocols bgp group EBGP-100 peer-as 100": {
            "template": "set protocols bgp group [parameter1] peer-as [parameter2]",
            "command": "set protocols bgp group EBGP-100 peer-as 100",
            "explanation": "配置BGP组的对等体自治系统号。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "peer-as",
                    "type": "integer",
                    "explanation": "对等体的自治系统号。"
                }
            ]
        },
        "set protocols bgp group EBGP-100 neighbor 10.1.1.2": {
            "template": "set protocols bgp group [parameter1] neighbor [parameter2]",
            "command": "set protocols bgp group EBGP-100 neighbor 10.1.1.2",
            "explanation": "配置BGP组的邻居地址。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "neighbor-address",
                    "type": "string",
                    "explanation": "邻居的IP地址。"
                }
            ]
        },
        "set protocols bgp group EBGP-100 family inet unicast": {
            "template": "set protocols bgp group [parameter1] family inet [parameter2]",
            "command": "set protocols bgp group EBGP-100 family inet unicast",
            "explanation": "配置BGP组的地址族。",
            "parameters": [
                {
                    "name": "group-name",
                    "type": "string",
                    "explanation": "BGP组的名称。"
                },
                {
                    "name": "address-family",
                    "type": "string",
                    "explanation": "地址族类型，例如inet unicast。"
                }
            ]
        }
    }
}