{
    "set system host-name PE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols rstp interface all": {
        "template": "set protocols rstp interface [parameter1]",
        "command": "set protocols rstp interface all",
        "explanation": "Enables RSTP protocols on all interfaces.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface range, call indicates all interfaces."
            }
        ]
    },
    "set protocols rstp vlan 10": {
        "template": "set protocols rstp vlan [parameter1]",
        "command": "set protocols rstp vlan 10",
        "explanation": "Enables RSTP protocols on specified VLAN.",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID."
            }
        ],
        "root-priority 0": {
            "template": "root-priority [parameter2]",
            "command": "root-priority 0",
            "explanation": "Configures the VLAN root priority of the RSTP protocol.",
            "parameters": [
                {
                    "name": "root-priority",
                    "type": "integer",
                    "explanation": "Root Bridge priority."
                }
            ]
        }
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members 100": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members 100",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "family ethernet-switching interface-mode access": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode access",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            }
        },
        "disable false": {
            "template": "disable [parameter2]",
            "command": "disable false",
            "explanation": "Enable interfaces.",
            "parameters": [
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "Disables the interface, false means enabled."
                }
            ]
        }
    },
