{
    "set system": {
        "set system host-name CE1": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name CE1",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set ethernet-switching": {
        "set ethernet-switching bridge-domain 10": {
            "template": "set ethernet-switching bridge-domain [parameter1]",
            "command": "set ethernet-switching bridge-domain 10",
            "explanation": "配置以太网交换桥接域。",
            "parameters": [
                {
                    "name": "bridge-domain",
                    "type": "integer",
                    "explanation": "桥接域的编号。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces eth-trunk 10 ether-options 802.3ad": {
            "template": "set interfaces [parameter1] ether-options [parameter2]",
            "command": "set interfaces eth-trunk 10 ether-options 802.3ad",
            "explanation": "配置以太网链路聚合控制协议（LACP）。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如eth-trunk 10。"
                },
                {
                    "name": "ether-options",
                    "type": "string",
                    "explanation": "以太网选项，例如802.3ad表示链路聚合控制协议。"
                }
            ]
        },
        "set interfaces eth-trunk 10.1 unit 0 family ethernet-switching vlan members 100": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan members [parameter3]",
            "command": "set interfaces eth-trunk 10.1 unit 0 family ethernet-switching vlan members 100",
            "explanation": "配置接口的以太网交换VLAN成员。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如eth-trunk 10.1。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "vlan-members",
                    "type": "integer",
                    "explanation": "VLAN成员编号。"
                }
            ]
        },
        "set interfaces gigabitethernet-1/0/0 ether-options 802.3ad ae10": {
            "template": "set interfaces [parameter1] ether-options [parameter2] [parameter3]",
            "command": "set interfaces gigabitethernet-1/0/0 ether-options 802.3ad ae10",
            "explanation": "配置接口的以太网选项，并将其绑定到聚合接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet-1/0/0。"
                },
                {
                    "name": "ether-options",
                    "type": "string",
                    "explanation": "以太网选项，例如802.3ad表示链路聚合控制协议。"
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "聚合接口名称，例如ae10。"
                }
            ]
        },
        "set interfaces gigabitethernet-1/0/0 disable": {
            "template": "set interfaces [parameter1] disable",
            "command": "set interfaces gigabitethernet-1/0/0 disable",
            "explanation": "禁用指定接口。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitethernet-1/0/0。"
                }
            ]
        }
    }
}