{
    "set system host-name PE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode trunk": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            }
        },
        "unit 1": {
            "template": "unit [parameter2]",
            "command": "unit 1",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "vlan-id 100": {
                "template": "vlan-id [parameter3]",
                "command": "vlan-id 100",
                "explanation": "Configure VLAN IDs for interface units.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID, used to identify VLAN."
                    }
                ]
            },
            "family inet address 10.1.1.254/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.254/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "proxy-arp restricted": {
                "template": "proxy-arp [parameter3]",
                "command": "proxy-arp restricted",
                "explanation": "Configures the local ARP for the IRB interface.",
                "parameters": [
                    {
                        "name": "proxy-arp",
                        "type": "string",
                        "explanation": "Agent ARP type, for example, local."
                    }
                ]
            }
        }
    },
    "activate interfaces ge-1/0/1": {
        "template": "activate interfaces [parameter1]",
        "command": "activate interfaces ge-1/0/1",
        "explanation": "Activate the configuration of the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "deactivate interfaces ge-1/0/1 unit 1 proxy-arp": {
        "template": "deactivate interfaces [parameter1] unit [parameter2] proxy-arp",
        "command": "deactivate interfaces ge-1/0/1 unit 1 proxy-arp",
        "explanation": "停用接口单元的代理ARP功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    }
}