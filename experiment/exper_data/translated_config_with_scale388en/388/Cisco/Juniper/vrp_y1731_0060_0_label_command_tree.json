                    ]
                }
            },
            "family dot1q remote-mac-persistent-id 4": {
                "template": "family dot1q remote-mac-persistent-id [parameter3]",
                "command": "family dot1q remote-mac-persistent-id 4",
                "explanation": "Configures the dot1q remote MAC persistence ID of the interface.",
                "parameters": [
                    {
                        "name": "remote-mac-persistent-id",
                        "type": "integer",
                        "explanation": "Remote Mac Persistence ID."
                    }
                ]
            },
            "family ethernet-switching port-mode trunk": {
                "template": "family ethernet-switching port-mode [parameter3]",
                "command": "family ethernet-switching port-mode trunk",
                "explanation": "Configure the interface 's port mode is trunk.",
                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
