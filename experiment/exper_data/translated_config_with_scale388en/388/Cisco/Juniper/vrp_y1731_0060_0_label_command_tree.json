{
    "set interfaces ge-3/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-3/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 1": {
            "template": "unit [parameter2]",
            "command": "unit 1",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family dot1q encapsulation": {
                "template": "family dot1q encapsulation",
                "command": "family dot1q encapsulation",
                "explanation": "Configure the dot1q envelope type for the interface.",
                "parameters": []
            },
            "family dot1q vlan-map ma3": {
                "template": "family dot1q vlan-map [parameter3]",
                "command": "family dot1q vlan-map ma3",
                "explanation": "This command maps VLAN ID `[parameter3]` to a logical interface `[parameter2]` on `[parameter1]` for 802.1Q VLAN tagging.",
                "parameters": [
                    {
                        "name": "vlan-map",
                        "type": "string",
                        "explanation": "VLAN map name."
                    }
                ],
                "mac-persistent 3": {
                    "template": "mac-persistent [parameter4]",
                    "command": "mac-persistent 3",
                    "explanation": "Configure the dot1q VLAN map of the interface and the MAC persistence.",
                    "parameters": [
                        {
                            "name": "mac-persistent",
                            "type": "integer",
                            "explanation": "MAC Persistence Marker."
