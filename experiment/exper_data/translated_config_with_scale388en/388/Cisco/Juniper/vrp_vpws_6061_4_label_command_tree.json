{
    "set system": {
        "set system host-name PE2": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name PE2",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "set protocols ldp discovery interface ge-0/0/0": {
            "template": "set protocols ldp discovery interface [parameter1]",
            "command": "set protocols ldp discovery interface ge-0/0/0",
            "explanation": "配置LDP协议在指定接口上进行邻居发现。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，LDP协议将在该接口上进行邻居发现。"
                }
            ]
        },
        "set protocols mpls label_protocol ldp": {
            "template": "set protocols mpls label_protocol [parameter1]",
            "command": "set protocols mpls label_protocol ldp",
            "explanation": "配置MPLS使用的标签分发协议为LDP。",
            "parameters": [
                {
                    "name": "label_protocol",
                    "type": "string",
                    "explanation": "标签分发协议，此处为LDP。"
                }
            ]
        },
        "set protocols l2vpn vpns vpn1 interface ge-0/0/0 unit 0": {
            "template": "set protocols l2vpn vpns [parameter1] interface [parameter2] unit [parameter3]",
            "command": "set protocols l2vpn vpns vpn1 interface ge-0/0/0 unit 0",
            "explanation": "配置L2VPN的VPN实例与接口的绑定。",
            "parameters": [
                {
                    "name": "vpn_name",
                    "type": "string",
                    "explanation": "VPN实例的名称。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，与VPN实例绑定的接口。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                }
            ]
        },
        "set protocols bgp peer-as 100": {
            "template": "set protocols bgp peer-as [parameter1]",
            "command": "set protocols bgp peer-as 100",
            "explanation": "配置BGP协议的对等体AS号。",
            "parameters": [
                {
                    "name": "peer_as",
                    "type": "integer",
                    "explanation": "BGP对等体的AS号。"
                }
            ]
        },
        "set protocols ospf area 0 interface ge-0/0/0.0": {
            "template": "set protocols ospf area [parameter1] interface [parameter2]",
            "command": "set protocols ospf area 0 interface ge-0/0/0.0",
            "explanation": "配置OSPF协议在指定区域内的接口。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，OSPF协议将在该接口上运行。"
                }
            ]
        },
        "set protocols ospf area 0 network 192.168.10.0/24": {
            "template": "set protocols ospf area [parameter1] network [parameter2]",
            "command": "set protocols ospf area 0 network 192.168.10.0/24",
            "explanation": "配置OSPF协议在指定区域内宣告的网络。",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF区域号。"
                },
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "网络地址及子网掩码，OSPF协议将宣告该网络。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces ge-0/0/0 unit 0 family ethernet-switching": {
            "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching",
