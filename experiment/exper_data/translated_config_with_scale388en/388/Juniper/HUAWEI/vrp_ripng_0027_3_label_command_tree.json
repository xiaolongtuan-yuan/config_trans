{
    "sysname DeviceD": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceD",
        "explanation": "设置设备的主机名为 'DeviceD'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "interface GigabitEthernet3/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet3/0/0",
        "explanation": "进入接口配置模式，配置名为 GigabitEthernet3/0/0 的接口",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ipv6 enable": {
            "template": "ipv6 enable",
            "command": "ipv6 enable",
            "explanation": "启用接口的IPv6功能",
            "parameters": []
        },
        "ipv6 address 2001:db8:3::2/96": {
            "template": "ipv6 address [parameter1]",
            "command": "ipv6 address 2001:db8:3::2/96",
            "explanation": "配置接口的IPv6地址为 2001:db8:3::2/96",
            "parameters": [
                {
                    "name": "ipv6 address",
                    "type": "IPv6",
                    "explanation": "IPv6地址"
                }
            ]
        },
        "ripng 1 enable": {
            "template": "ripng [parameter1] enable",
            "command": "ripng 1 enable",
            "explanation": "在接口上启用RIPng进程1",
            "parameters": [
                {
                    "name": "ripng process",
                    "type": "integer",
                    "explanation": "RIPng进程号"
                }
            ]
        }
    },
    "ripng 1": {
        "template": "ripng [parameter1]",
        "command": "ripng 1",
        "explanation": "进入RIPng进程1的配置模式",
        "parameters": [
            {
                "name": "ripng process",
                "type": "integer",
                "explanation": "RIPng进程号"
            }
        ]
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}