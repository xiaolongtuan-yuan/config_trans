{
    "sysname DeviceB": {
        "template": "sysname [parameter1]",
        "command": "sysname DeviceB",
        "explanation": "设置设备的主机名为 'DeviceB'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "主机名"
            }
        ]
    },
    "bfd": {
        "template": "bfd",
        "command": "bfd",
        "explanation": "进入BFD配置模式",
        "parameters": [],
        "delay-up 120": {
            "template": "delay-up [parameter1]",
            "command": "delay-up 120",
            "explanation": "设置BFD会话启动延迟时间为120秒",
            "parameters": [
                {
                    "name": "delay time",
                    "type": "integer",
                    "explanation": "延迟时间，单位为秒"
                }
            ]
        }
    },
    "interface gigabitethernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface gigabitethernet1/0/0",
        "explanation": "进入接口配置模式，配置接口gigabitethernet1/0/0",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "启用接口 (默认情况下接口是关闭的)",
            "parameters": []
        },
        "ip address 10.1.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.1.1.2 255.255.255.0",
            "explanation": "配置接口的IPv4地址为 10.1.1.2，子网掩码为 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4地址"
                },
                {
                    "name": "sub musk",
                    "type": "IPv4",
                    "explanation": "子网掩码"
                }
            ]
        }
    },
    "bfd btoa bind peer-ip 10.1.1.1 interface gigabitethernet 1/0/0": {
        "template": "bfd [parameter1] bind peer-ip [parameter2] interface [parameter3]",
        "command": "bfd btoa bind peer-ip 10.1.1.1 interface gigabitethernet 1/0/0",
        "explanation": "配置BFD会话，绑定对端IP地址为10.1.1.1，接口为gigabitethernet1/0/0",
        "parameters": [
            {
                "name": "session name",
                "type": "string",
                "explanation": "BFD会话名称"
            },
            {
                "name": "peer ip",
                "type": "IPv4",
                "explanation": "对端IP地址"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名"
            }
        ],
        "discriminator local 20": {
            "template": "discriminator local [parameter1]",
            "command": "discriminator local 20",
            "explanation": "设置本地BFD会话标识符为20",
            "parameters": [
                {
                    "name": "local discriminator",
                    "type": "integer",
                    "explanation": "本地BFD会话标识符"
                }
            ]
        },
        "discriminator remote 10": {
            "template": "discriminator remote [parameter1]",
            "command": "discriminator remote 10",
            "explanation": "设置远端BFD会话标识符为10",
            "parameters": [
                {
                    "name": "remote discriminator",
                    "type": "integer",
                    "explanation": "远端BFD会话标识符"
                }
            ]
        }
    },
    "return": {
        "template": "return",
        "command": "return",
        "explanation": "退出当前配置模式，返回到用户视图",
        "parameters": []
    }
}