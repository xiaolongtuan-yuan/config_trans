{
    "set system host-name PE3": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE3",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols isis netpoint GigabitEthernet1/0/1": {
        "template": "set protocols isis netpoint [parameter1]",
        "command": "set protocols isis netpoint GigabitEthernet1/0/1",
        "explanation": "配置ISIS协议的netpoint接口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "指定ISIS协议的netpoint接口。"
            }
        ]
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching": {
                "template": "family ethernet-switching",
                "command": "family ethernet-switching",
                "explanation": "Configure the interface to exchange with the Ethernet.",
                "parameters": []
            },
            "family inet address 192.168.1.2/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.1.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}