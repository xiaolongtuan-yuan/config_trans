            "template": "set interfaces [parameter1] encap-type dot1q [parameter2]",
            "command": "set interfaces ge-0/0/3.1 encap-type dot1q 10",
            "explanation": "配置接口的封装类型为dot1q，并指定VLAN ID。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如ge-0/0/3.1。"
