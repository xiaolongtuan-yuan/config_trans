{
    "set system": {
        "set system name PE4": {
            "template": "set system name [parameter1]",
            "command": "set system name PE4",
            "explanation": "配置设备的名称。",
            "parameters": [
                {
                    "name": "name",
                    "type": "string",
                    "explanation": "设备的名称，用于标识网络中的设备。"
                }
            ]
        },
        "set system services dhcpv4 server pool 10.1.5.0/24 address-range low 10.1.5.1 high 10.1.5.254": {
            "template": "set system services dhcpv4 server pool [parameter1] address-range low [parameter2] high [parameter3]",
            "command": "set system services dhcpv4 server pool 10.1.5.0/24 address-range low 10.1.5.1 high 10.1.5.254",
            "explanation": "配置DHCPv4服务器的地址池及地址范围。",
            "parameters": [
                {
                    "name": "pool",
                    "type": "string",
                    "explanation": "DHCPv4服务器的地址池，例如10.1.5.0/24。"
                },
                {
                    "name": "low",
                    "type": "string",
                    "explanation": "地址范围的起始地址。"
                },
                {
                    "name": "high",
                    "type": "string",
                    "explanation": "地址范围的结束地址。"
                }
            ]
        }
    },
