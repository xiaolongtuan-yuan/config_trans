                }
            ]
        }
    },
    "set protocols rstp interface all": {
        "template": "set protocols rstp interface [parameter1]",
        "command": "set protocols rstp interface all",
        "explanation": "Enables RSTP protocols on all interfaces.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface range, call indicates all interfaces."
            }
        ],
        "mode rapid-pvst": {
            "template": "mode [parameter2]",
            "command": "mode rapid-pvst",
            "explanation": "Configure the RSTP protocol with a fast PVST model for all interfaces.",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "RSTP mode, Rapid-pvst means fast PVST mode."
                }
            ]
        }
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members vlan200": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members vlan200",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "family ethernet-switching bpdu-filter enable": {
                "template": "family ethernet-switching bpdu-filter [parameter3]",
                "command": "family ethernet-switching bpdu-filter enable",
                "explanation": "Enables BPDU filtering for interfaces.",
                "parameters": [
                    {
                        "name": "bpdu-filter",
                        "type": "string",
                        "explanation": "The BPDU filter is enabled."
                    }
                ]
            },
            "family ethernet-switching port-mode access": {
                "template": "family ethernet-switching port-mode [parameter3]",
                "command": "family ethernet-switching port-mode access",
                "explanation": "Configure the interface 's port mode is trunk.",
                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
                        "explanation": "Port mode, for example, trunk."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching port-fast enable": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching port-fast [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching port-fast enable",
        "explanation": "配置接口的以太网交换端口快速功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "port-fast",
                "type": "string",
                "explanation": "端口快速功能的状态，例如enable。"
            }
        ]
    },
