{
    "set system": {
        "set system host-name DeviceB": {
            "template": "set system host-name [parameter1]",
            "command": "set system host-name DeviceB",
            "explanation": "配置设备的主机名。",
            "parameters": [
                {
                    "name": "hostname",
                    "type": "string",
                    "explanation": "设备的主机名，用于标识网络中的设备。"
                }
            ]
        }
    },
    "set protocols": {
        "set protocols bfd all-interfaces": {
            "template": "set protocols bfd [parameter1]",
            "command": "set protocols bfd all-interfaces",
            "explanation": "在所有接口上启用BFD协议。",
            "parameters": [
                {
                    "name": "bfd-configuration",
                    "type": "string",
                    "explanation": "BFD协议的配置选项，例如'all-interfaces'表示在所有接口上启用BFD。"
                }
            ]
        },
        "set protocols ospf 1 area 0.0.0.0": {
            "template": "set protocols ospf [parameter1] area [parameter2]",
            "command": "set protocols ospf 1 area 0.0.0.0",
            "explanation": "配置OSPF协议的实例和区域。",
            "parameters": [
                {
                    "name": "ospf-instance",
                    "type": "integer",
                    "explanation": "OSPF实例的编号。"
                },
                {
                    "name": "area",
                    "type": "string",
                    "explanation": "OSPF区域的标识符。"
                }
            ]
        }
    },
    "set interfaces": {
        "set interfaces gigabitETHERNET1/0/0 unit 0 family inet6 address 2001:DB8::2/64": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces gigabitETHERNET1/0/0 unit 0 family inet6 address 2001:DB8::2/64",
            "explanation": "配置接口的IPv6地址及子网前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitETHERNET1/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces gigabitETHERNET2/0/0 unit 0 family inet6 address 2001:DB8:2::1/64": {
            "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4]",
            "command": "set interfaces gigabitETHERNET2/0/0 unit 0 family inet6 address 2001:DB8:2::1/64",
            "explanation": "配置接口的IPv6地址及子网前缀长度。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitETHERNET2/0/0。"
                },
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
                },
                {
                    "name": "ip-address",
                    "type": "string",
                    "explanation": "分配给接口的IPv6地址。"
                },
                {
                    "name": "prefix-length",
                    "type": "integer",
                    "explanation": "IPv6地址的前缀长度。"
                }
            ]
        },
        "set interfaces gigabitETHERNET1/0/0 bfd interval 50 mul 3 receive 50": {
            "template": "set interfaces [parameter1] bfd interval [parameter2] mul [parameter3] receive [parameter4]",
            "command": "set interfaces gigabitETHERNET1/0/0 bfd interval 50 mul 3 receive 50",
            "explanation": "配置接口的BFD参数，包括发送间隔、乘数和接收间隔。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitETHERNET1/0/0。"
                },
                {
                    "name": "interval",
                    "type": "integer",
                    "explanation": "BFD发送间隔时间，单位为毫秒。"
                },
                {
                    "name": "multiplier",
                    "type": "integer",
                    "explanation": "BFD乘数，用于计算检测时间。"
                },
                {
                    "name": "receive-interval",
                    "type": "integer",
                    "explanation": "BFD接收间隔时间，单位为毫秒。"
                }
            ]
        },
        "set interfaces gigabitETHERNET1/0/0 bfd local-discriminator 2": {
            "template": "set interfaces [parameter1] bfd local-discriminator [parameter2]",
            "command": "set interfaces gigabitETHERNET1/0/0 bfd local-discriminator 2",
            "explanation": "配置接口的BFD本地标识符。",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "接口名称，例如gigabitETHERNET1/0/0。"
                },
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "BFD本地标识符，用于唯一标识BFD会话。"
                }
            ]
        }
    },
