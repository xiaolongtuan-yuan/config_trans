{
    "set interfaces ge-0/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 1": {
            "template": "unit [parameter2]",
            "command": "unit 1",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family dot1q vlan-id 200": {
                "template": "family dot1q vlan-id [parameter3]",
                "command": "family dot1q vlan-id 200",
                "explanation": "This command configures a logical interface unit with IEEE 802.1Q VLAN tagging, assigning a specific VLAN ID to the interface for traffic segregation.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID, used to identify different VLANs."
                    }
                ],
                "encapsulation dot1q 200": {
                    "template": "encapsulation dot1q [parameter4]",
                    "command": "encapsulation dot1q 200",
                    "explanation": "Configure the VLAN ID and containment type of the interface.",
                    "parameters": [
                        {
                            "name": "encapsulation",
                            "type": "string",
                            "explanation": "Cover type, e.g. dot1q."
                        }
                    ]
                }
            },
            "cfm etherenet domain ma3": {
                "template": "cfm etherenet domain [parameter3]",
                "command": "cfm etherenet domain ma3",
                "explanation": "This command configures Ethernet CFM (Connectivity Fault Management) on a specific interface unit, associating it with a defined CFM domain for fault detection and monitoring.",
                "parameters": [
                    {
                        "name": "domain",
                        "type": "string",
                        "explanation": "CFM with an etho-network domain name."
                    }
                ],
                "mode md": {
                    "template": "mode [parameter4]",
                    "command": "mode md",
                    "explanation": "Configure the interfaced CFM Ether domain and mode.",
                    "parameters": [
                        {
                            "name": "mode",
                            "type": "string",
                            "explanation": "CFM models, for example, md."
                        }
                    ]
                }
            },
            "cfm event-type all": {
                "template": "cfm event-type [parameter3]",
                "command": "cfm event-type all",
                "explanation": "This command configures a Connectivity Fault Management (CFM) event type for a specific interface unit to monitor and report network faults or anomalies.",
                "parameters": [
                    {
                        "name": "event-type",
                        "type": "string",
                        "explanation": "Type of CFM event, e.g. all."
                    }
                ],
                "action enable": {
                    "template": "action [parameter4]",
                    "command": "action enable",
                    "explanation": "Enables all CFM event type actions on the interface.",
                    "parameters": [
                        {
                            "name": "action",
                            "type": "string",
                            "explanation": "Actions, like an enable."
                        }
                    ]
                }
            },
            "ccm-management interval 1": {
                "template": "ccm-management interval [parameter3]",
                "command": "ccm-management interval 1",
                "explanation": "Configure the CCM management interval.",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "integer",
                        "explanation": "CCM management interval in seconds."
                    }
                ]
            },
            "ccm-management transmit": {
                "template": "ccm-management transmit",
                "command": "ccm-management transmit",
                "explanation": "Enables the CCM management transfer.",
                "parameters": []
            },
            "remote-mep index 3": {
                "template": "remote-mep index [parameter3]",
                "command": "remote-mep index 3",
                "explanation": "This command configures a remote Maintenance End Point (MEP) index for a specific interface unit, enabling Ethernet OAM fault detection and monitoring.",
                "parameters": [
                    {
                        "name": "index",
                        "type": "integer",
                        "explanation": "A remote MEP index."
                    }
                ],
                "role peer": {
                    "template": "role [parameter4]",
                    "command": "role peer",
                    "explanation": "Configure remote MEP indexes and roles.",
                    "parameters": [
                        {
                            "name": "role",
                            "type": "string",
                            "explanation": "Remote MEP roles, for example, peer."
                        }
                    ]
                }
            },
            "ccm-management receive": {
                "template": "ccm-management receive",
                "command": "ccm-management receive",
                "explanation": "Enables CCM to manage receivers.",
                "parameters": []
            }
        }
    }
}