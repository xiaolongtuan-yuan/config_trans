{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.2.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.2.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set protocols bgp group external": {
        "template": "set protocols bgp group [parameter1]",
        "command": "set protocols bgp group external",
        "explanation": "This command configures a BGP group named [parameter1], defining a set of BGP peers with shared session parameters.",
        "parameters": [
            {
                "name": "group",
                "type": "string",
                "explanation": "BGP Group name."
            }
        ],
        "type external": {
            "template": "type [parameter2]",
            "command": "type external",
            "explanation": "Configure the type of BGP group to be external.",
            "parameters": [
                {
                    "name": "type",
                    "type": "string",
                    "explanation": "Type of BGP group, for example, external."
                }
            ]
        },
        "neighbor 10.2.1.2": {
            "template": "neighbor [parameter2]",
            "command": "neighbor 10.2.1.2",
            "explanation": "Configure the neighbors of the BGP team.",
            "parameters": [
                {
                    "name": "neighbor",
                    "type": "string",
                    "explanation": "Neighbor's IP address."
                }
            ],
            "peer-as 100": {
                "template": "peer-as [parameter3]",
                "command": "peer-as 100",
                "explanation": "Configure the BGP group's neighbours and their equivalents.",
                "parameters": [
                    {
                        "name": "peer-as",
                        "type": "integer",
                        "explanation": "Peer AS."
                    }
                ]
            },
            "family inet unicast": {
                "template": "family inet [parameter3]",
                "command": "family inet unicast",
                "explanation": "Configure the addresses of the BGP neighbors.",
                "parameters": [
                    {
                        "name": "address-family",
                        "type": "string",
                        "explanation": "Addresses of BGP neighbours, e.g. not unicast."
                    }
                ]
            }
        },
        "import direct": {
            "template": "import [parameter2]",
            "command": "import direct",
            "explanation": "Configure the BGP group import route policy.",
            "parameters": [
                {
                    "name": "import-policy",
                    "type": "string",
                    "explanation": "Organisation"
                }
            ]
        }
