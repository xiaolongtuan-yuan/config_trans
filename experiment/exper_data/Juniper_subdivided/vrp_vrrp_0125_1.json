{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24 standby 1 ip 10.1.1.1": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet address [parameter3]/[parameter4] standby [parameter5] ip [parameter6]",
        "command": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.2/24 standby 1 ip 10.1.1.1",
        "explanation": "配置接口的IPv4地址及子网掩码，并设置备用IP地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ip-address",
                "type": "string",
                "explanation": "分配给接口的IPv4地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "IPv4子网掩码的位数。"
            },
            {
                "name": "standby",
                "type": "integer",
                "explanation": "备用IP地址的标识号。"
            },
            {
                "name": "standby-ip",
                "type": "string",
                "explanation": "备用IP地址。"
            }
        ]
    },
    "set interfaces ge-0/0/0 unit 0 family inet dhcp": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet dhcp",
        "command": "set interfaces ge-0/0/0 unit 0 family inet dhcp",
        "explanation": "配置接口使用DHCP自动获取IPv4地址。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
    "set interfaces ge-0/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 192.168.2.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.2.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options static route 0.0.0.0/0": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 0.0.0.0/0",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop <next-hop-ip>": {
            "template": "next-hop [parameter3]",
            "command": "next-hop <next-hop-ip>",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set routing-options ospf area 0": {
        "template": "set routing-options ospf area [parameter1]",
        "command": "set routing-options ospf area 0",
        "explanation": "This command configures an OSPF area in Junos, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area number."
            }
        ],
        "interface ge-0/0/1.0": {
            "template": "interface [parameter2]",
            "command": "interface ge-0/0/1.0",
            "explanation": "Configure OSPF regions and interfaces.",
            "parameters": [
                {
                    "name": "interface",
