    "set protocols oam ethernet connectivity-fault-management maintenance-domain md1": {
        "template": "set protocols oam ethernet connectivity-fault-management maintenance-domain [parameter1]",
        "command": "set protocols oam ethernet connectivity-fault-management maintenance-domain md1",
        "explanation": "This command configures a Maintenance Domain (MD) in Ethernet Connectivity Fault Management (CFM) under OAM protocols, where `[parameter1]` specifies the MD name or level.",
        "parameters": [
            {
                "name": "maintenance-domain",
                "type": "string",
                "explanation": "Maintains the name of the domain."
            }
        ],
        "level 6": {
            "template": "level [parameter2]",
            "command": "level 6",
            "explanation": "Configure the level of OAM Ethernet connection to fail management maintenance.",
            "parameters": [
                {
                    "name": "level",
                    "type": "integer",
                    "explanation": "Maintenance level."
                }
            ]
        },
        "maintenance-association ma2": {
            "template": "maintenance-association [parameter2]",
            "command": "maintenance-association ma2",
            "explanation": "Configure the OAM Ethernet connection to the failure management maintenance domain.",
            "parameters": [
                {
                    "name": "maintenance-association",
                    "type": "string",
                    "explanation": "Maintains the name of the association."
                }
            ],
            "continuity-check interval 1s": {
                "template": "continuity-check interval [parameter3]",
                "command": "continuity-check interval 1s",
                "explanation": "Configure the intervals of continuous checks for OAM connection to failure management maintenance.",
                "parameters": [
                    {
                        "name": "interval",
                        "type": "string",
                        "explanation": "Time interval for continuous checks."
                    }
                ]
            },
            "mep 2": {
                "template": "mep [parameter3]",
                "command": "mep 2",
                "explanation": "This command configures a Maintenance End Point (MEP) within a specified Maintenance Domain and Maintenance Association for Ethernet Connectivity Fault Management (CFM) in Junos.",
                "parameters": [
                    {
                        "name": "mep",
                        "type": "integer",
                        "explanation": "Maintains the peer ID."
                    }
                ],
                "interface ge-1/0/0": {
                    "template": "interface [parameter4]",
                    "command": "interface ge-1/0/0",
                    "explanation": "This command configures a Maintenance End Point (MEP) for Ethernet Connectivity Fault Management (CFM) on a specified interface within a maintenance domain and association.",
                    "parameters": [
                        {
                            "name": "interface",
                            "type": "string",
                            "explanation": "Interface name, e.g., g-1/0/0."
                        }
                    ],
                    "direction inward": {
                        "template": "direction [parameter5]",
                        "command": "direction inward",
                        "explanation": "Configure the MEP (maintenance endpoint) of OAM to connect to the failure management maintenance linkage.",
                        "parameters": [
                            {
                                "name": "direction",
                                "type": "string",
                                "explanation": "Map direction, for example, inward."
                            }
                        ]
                    }
                }
            },
            "remote-mep 1": {
                "template": "remote-mep [parameter3]",
                "command": "remote-mep 1",
                "explanation": "Configure the remote MEP that links OAM Ethernet to fail management maintenance.",
                "parameters": [
                    {
                        "name": "remote-mep",
                        "type": "integer",
                        "explanation": "Remote MEP ID."
                    }
                ]
            }
        }
    }
