{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set routing-options ipv6 unicast-routing": {
        "template": "set routing-options ipv6 unicast-routing",
        "command": "set routing-options ipv6 unicast-routing",
        "explanation": "Enables IPv6 single route.",
        "parameters": []
    },
    "set routing-options rib inet6.0": {
        "template": "set routing-options rib [parameter1]",
        "command": "set routing-options rib inet6.0",
        "explanation": "This command fragment creates or modifies a custom Routing Information Base (RIB) named `[parameter1]` within the routing options, allowing for separate routing tables.",
        "parameters": [
            {
                "name": "rib",
                "type": "string",
                "explanation": "RIB name, e.g. not."
            }
        ],
        "static route 2001:db8:3::/64": {
            "template": "static route [parameter2]",
            "command": "static route 2001:db8:3::/64",
            "explanation": "This command adds a static route `[parameter2]` to the specified Routing Information Base (RIB) `[parameter1]` in Junos routing configuration.",
            "parameters": [
                {
                    "name": "route",
                    "type": "string",
                    "explanation": "Target IPv6 network address and prefix length."
                }
            ],
            "next-hop 2001:db8:5::1": {
                "template": "next-hop [parameter3]",
                "command": "next-hop 2001:db8:5::1",
                "explanation": "Configure IPv6 static routers.",
                "parameters": [
                    {
                        "name": "next-hop",
                        "type": "string",
                        "explanation": "Next jump IPv6 address."
                    }
                ]
            }
        }
    },
