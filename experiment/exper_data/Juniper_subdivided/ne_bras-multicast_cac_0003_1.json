                "name": "pool-name",
                "type": "string",
                "explanation": "Name of DHCP address pool."
            }
        ],
        "network 10.0.0.0/16": {
            "template": "network [parameter2]/[parameter3]",
            "command": "network 10.0.0.0/16",
            "explanation": "The address pool and its network address and subnet mask with the DHCP service.",
            "parameters": [
                {
                    "name": "network-address",
                    "type": "string",
                    "explanation": "Web address of DHCP address pool."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "_Other Organiser"
                }
            ]
        },
        "default-router 10.0.0.1": {
