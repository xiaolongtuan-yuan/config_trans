    "set system services dhcp pool bas_local": {
        "template": "set system services dhcp pool [parameter1]",
        "command": "set system services dhcp pool bas_local",
        "explanation": "This command configures a DHCP pool with the specified parameter1, defining a range of IP addresses for dynamic allocation to clients on the network.",
        "parameters": [
