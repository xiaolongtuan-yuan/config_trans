{
    "set system host-name CE3": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE3",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-0/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.3.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.3.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options autonomous-system 65430": {
        "template": "set routing-options autonomous-system [parameter1]",
        "command": "set routing-options autonomous-system 65430",
        "explanation": "Autonomy system number with equipment.",
        "parameters": [
            {
                "name": "autonomous-system",
                "type": "integer",
                "explanation": "Autonomy system number for equipment, used for route agreements such as BGP."
            }
        ]
    },
    "set protocols bgp peer-as 100 peer-address 10.3.1.2": {
        "template": "set protocols bgp peer-as [parameter1] peer-address [parameter2]",
        "command": "set protocols bgp peer-as 100 peer-address 10.3.1.2",
        "explanation": "配置BGP协议的邻居AS号和邻居地址。",
        "parameters": [
            {
                "name": "peer-as",
                "type": "integer",
                "explanation": "邻居的自治系统号。"
            },
            {
                "name": "peer-address",
                "type": "string",
                "explanation": "邻居的IP地址。"
            }
        ]
    },
    "set protocols bgp unicast vrf default": {
        "template": "set protocols bgp unicast vrf [parameter1]",
        "command": "set protocols bgp unicast vrf default",
        "explanation": "配置BGP协议的单播路由，并指定VRF实例。",
        "parameters": [
            {
                "name": "vrf",
                "type": "string",
                "explanation": "虚拟路由转发实例名称，例如default。"
            }
        ]
    },
    "commit": {
        "template": "commit",
        "command": "commit",
        "explanation": "Submits configuration changes.",
        "parameters": []
    }
}