    "set system host-name routerA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name routerA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set forwarding-options hash-key family inet per-packet-balancing": {
        "template": "set forwarding-options hash-key family [parameter1] [parameter2]",
        "command": "set forwarding-options hash-key family inet per-packet-balancing",
        "explanation": "配置转发选项的哈希键，用于指定IPv4家族的数据包平衡方式。",
        "parameters": [
            {
                "name": "family",
                "type": "string",
                "explanation": "指定协议家族，例如inet表示IPv4。"
            },
            {
                "name": "balancing-method",
                "type": "string",
                "explanation": "指定数据包平衡的方法，例如per-packet-balancing表示每个数据包都进行平衡。"
            }
        ]
    },
    "set interfaces ae0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.40.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.40.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
