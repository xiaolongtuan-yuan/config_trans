{
    "set system host-name routerE": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name routerE",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols isis level 1": {
        "template": "set protocols isis level [parameter1]",
        "command": "set protocols isis level 1",
        "explanation": "Configure the level of the ISIS protocol.",
        "parameters": [
            {
                "name": "level",
                "type": "integer",
                "explanation": "Level of IS-IS agreement, e.g. 2."
            }
        ],
        "wide-metrics-only": {
            "template": "wide-metrics-only",
            "command": "wide-metrics-only",
            "explanation": "Configure level 2 of the IS-IS protocol to use width only.",
            "parameters": []
        }
    },
    "set protocols isis network-entity 10.0000.0000.0005.00": {
        "template": "set protocols isis network-entity [parameter1]",
        "command": "set protocols isis network-entity 10.0000.0000.0005.00",
        "explanation": "Configure IS-IS network entities.",
        "parameters": [
            {
                "name": "network-entity",
                "type": "string",
                "explanation": "Network entity identifiers, e.g., 49.0001.11.11.11.1112.222.00."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.20.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.20.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/0 unit 0 isis": {
        "template": "set interfaces [parameter1] unit [parameter2] isis",
        "command": "set interfaces ge-1/0/0 unit 0 isis",
        "explanation": "在接口上启用IS-IS协议。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
