                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
                        "explanation": "Port mode, for example, trunk."
                    }
                ]
            },
            "family ethernet-switching trunk allowed-vlans 100,200": {
                "template": "family ethernet-switching trunk allowed-vlans [parameter3]",
                "command": "family ethernet-switching trunk allowed-vlans 100,200",
                "explanation": "Configure the trunk port allowed to pass VLAN.",
