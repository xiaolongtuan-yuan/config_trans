    "set protocols ospf3 area 0.0.0.0 range 2001:db8:1::/64": {
        "template": "set protocols ospf3 area [parameter1] range [parameter2]",
        "command": "set protocols ospf3 area 0.0.0.0 range 2001:db8:1::/64",
        "explanation": "配置OSPFv3协议在指定区域内的地址范围。",
