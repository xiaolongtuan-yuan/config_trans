{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols pim interface all": {
        "template": "set protocols pim interface [parameter1]",
        "command": "set protocols pim interface all",
        "explanation": "This command enables Protocol Independent Multicast (PIM) on a specified network interface (`[parameter1]`) for multicast routing in Junos OS.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "mode sparse": {
            "template": "mode [parameter2]",
            "command": "mode sparse",
            "explanation": "Configure the mode of PIM protocol on the specified interface.",
            "parameters": [
                {
                    "name": "mode",
                    "type": "string",
                    "explanation": "PIM models, for example, sparse-dense."
                }
            ]
        }
    },
