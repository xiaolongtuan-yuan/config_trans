{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces serial-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces serial-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "disable": {
                "template": "disable",
                "command": "disable",
                "explanation": "Disables the specified interface unit.",
                "parameters": []
            }
        }
    },
    "set interfaces serial-1/0/0 unit 0 dlci 100": {
        "template": "set interfaces [parameter1] unit [parameter2] dlci [parameter3]",
        "command": "set interfaces serial-1/0/0 unit 0 dlci 100",
        "explanation": "配置帧中继接口的数据链路连接标识符(DLCI)。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如serial-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "dlci",
                "type": "integer",
                "explanation": "数据链路连接标识符(DLCI)，用于标识帧中继网络中的虚拟电路。"
            }
        ]
    },
    "set interfaces serial-1/0/0.1": {
