{
    "set system host-name PE": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols igmp-snooping vlan 10": {
        "template": "set protocols igmp-snooping vlan [parameter1]",
        "command": "set protocols igmp-snooping vlan 10",
        "explanation": "在指定VLAN上启用IGMP Snooping功能。",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN的ID，用于指定启用IGMP Snooping功能的VLAN。"
            }
        ]
    },
    "set bridge-domains BD10": {
        "template": "set bridge-domains [parameter1]",
        "command": "set bridge-domains BD10",
        "explanation": "Create a bridge field.",
        "parameters": [
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "Bridge domain names, such as vlan10."
            }
        ],
        "vlan-id 10": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure the VLAN ID of the bridge domain.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID, used to identify VLAN."
                }
            ]
        }
    },
    "set bridge-domains BD10 protocols igmp-snooping": {
        "template": "set bridge-domains [parameter1] protocols igmp-snooping",
        "command": "set bridge-domains BD10 protocols igmp-snooping",
        "explanation": "在桥接域上启用IGMP Snooping协议。",
        "parameters": [
            {
                "name": "bridge-domain",
                "type": "string",
                "explanation": "桥接域的名称。"
            }
        ]
    },
    "set interfaces ge-1/0/3": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/3",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
