{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ae1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet6 bfd-liveness-detection neighbor 2001:DB8:1::2": {
                "template": "family inet6 bfd-liveness-detection neighbor [parameter3]",
                "command": "family inet6 bfd-liveness-detection neighbor 2001:DB8:1::2",
                "explanation": "Configure interfaced BFD neighboring addresses.",
                "parameters": [
                    {
                        "name": "neighbor-address",
                        "type": "string",
                        "explanation": "BFD neighbor's IPv6 address."
                    }
                ]
            }
        }
    },
    "set interfaces ge-3/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-3/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "ether-options 802.3ad ae1": {
            "template": "ether-options 802.3ad [parameter2]",
            "command": "ether-options 802.3ad ae1",
            "explanation": "Configure the Ethernet option for the interface and add it to the chain aggregation group.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Name of chain aggregate group, e.g. ae1."
                }
            ]
        }
    },
    "set interfaces ge-3/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-3/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "ether-options 802.3ad ae1": {
            "template": "ether-options 802.3ad [parameter2]",
            "command": "ether-options 802.3ad ae1",
            "explanation": "Configure the Ethernet option for the interface and add it to the chain aggregation group.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Name of chain aggregate group, e.g. ae1."
                }
            ]
        }
    },
    "set protocols bfd template AtoB": {
        "template": "set protocols bfd template [parameter1]",
        "command": "set protocols bfd template AtoB",
        "explanation": "Sets a BFD (Bidirectional Forwarding Detection) template named `[parameter1]` to configure BFD session parameters for protocols in Junos OS.",
        "parameters": [
            {
                "name": "template-name",
                "type": "string",
                "explanation": "The name of the BFD template."
            }
        ],
        "minimum-receive-interval 10": {
            "template": "minimum-receive-interval [parameter2]",
            "command": "minimum-receive-interval 10",
            "explanation": "Configures the minimum reception interval for BFD templates.",
            "parameters": [
                {
                    "name": "minimum-receive-interval",
                    "type": "integer",
                    "explanation": "The minimum time of reception of BFD is in milliseconds."
                }
            ]
        }
    }
}