        "command": "set interfaces ge-0/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members 10": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members 10",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        }
    },
    "set interfaces ge-0/0/1 switchport trunk allowed-vlan 10": {
        "template": "set interfaces [parameter1] switchport trunk allowed-vlan [parameter2]",
        "command": "set interfaces ge-0/0/1 switchport trunk allowed-vlan 10",
        "explanation": "配置交换端口的Trunk模式允许的VLAN。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID，指定Trunk模式下允许的VLAN。"
            }
        ]
    },
    "set interfaces ge-0/0/1 switchport mode trunk": {
        "template": "set interfaces [parameter1] switchport mode [parameter2]",
        "command": "set interfaces ge-0/0/1 switchport mode trunk",
        "explanation": "配置交换端口的模式为Trunk。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-0/0/1。"
