                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
                        "explanation": "Port mode, for example, trunk."
                    }
                ],
                "vlan 6": {
                    "template": "vlan [parameter4]",
                    "command": "vlan 6",
                    "explanation": "Configure the interface to access mode and specify VLAN.",
                    "parameters": [
                        {
                            "name": "vlan",
                            "type": "integer",
                            "explanation": "VLAN ID of interface."
                        }
                    ]
                }
            }
        }
    },
