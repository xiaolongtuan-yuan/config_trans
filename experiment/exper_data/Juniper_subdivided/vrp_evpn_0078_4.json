{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set ethernet-switching bridge-domain 10": {
        "template": "set ethernet-switching bridge-domain [parameter1]",
        "command": "set ethernet-switching bridge-domain 10",
        "explanation": "Configure the etho-net for bridge interfaces.",
        "parameters": [
            {
                "name": "bridge-domain",
                "type": "integer",
                "explanation": "Bridge domain number."
            }
        ]
    },
    "set interfaces eth-trunk": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces eth-trunk",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "10 ether-options": {
            "template": "ether-options [parameter2]",
            "command": "10 ether-options",
            "explanation": "Configure Etherlink Convergence Control Protocol (LACP).",
            "parameters": [
                {
                    "name": "ether-options",
                    "type": "string",
                    "explanation": "e.g. 802.3ad indicates a chain aggregation control protocol."
                }
            ]
        },
        "10.1 unit": {
            "template": "unit [parameter2]",
            "command": "10.1 unit",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "0 family ethernet-switching vlan members": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "0 family ethernet-switching vlan members",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        }
    },
    "set interfaces gigabitethernet-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces gigabitethernet-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "ether-options 802.3ad ae10": {
            "template": "ether-options [parameter2] [parameter3]",
            "command": "ether-options 802.3ad ae10",
            "explanation": "Configure the Ethernet option for the interface and bind it to the polymer interface.",
            "parameters": [
                {
                    "name": "ether-options",
                    "type": "string",
                    "explanation": "e.g. 802.3ad indicates a chain aggregation control protocol."
                },
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Aggregation interface name, e.g. ae10."
                }
            ]
        },
        "disable": {
            "template": "disable",
            "command": "disable",
            "explanation": "Disables the specified interface.",
            "parameters": []
        }
    }
}