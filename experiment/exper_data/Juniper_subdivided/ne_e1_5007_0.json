{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces e1-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces e1-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "ppp-options multilink group 1": {
                "template": "ppp-options multilink group [parameter3]",
                "command": "ppp-options multilink group 1",
                "explanation": "PPP multi-link option for unit 0 with the E1 interface, adding group 1.",
                "parameters": [
                    {
                        "name": "group",
                        "type": "integer",
                        "explanation": "Multilink group number, e.g. 1."
                    }
                ]
            }
        }
    },
    "set interfaces multilink-1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces multilink-1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.1.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
