{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode access": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode access",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            },
            "family ethernet-switching port-mode trunk": {
                "template": "family ethernet-switching port-mode [parameter3]",
                "command": "family ethernet-switching port-mode trunk",
                "explanation": "Configure the interface 's port mode is trunk.",
                "parameters": [
                    {
                        "name": "port-mode",
                        "type": "string",
                        "explanation": "Port mode, for example, trunk."
                    }
                ]
            }
        },
        "unit 10": {
            "template": "unit [parameter2]",
            "command": "unit 10",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "vlan-id 10": {
                "template": "vlan-id [parameter3]",
                "command": "vlan-id 10",
                "explanation": "Configure VLAN IDs for interface units.",
                "parameters": [
                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID, used to identify VLAN."
                    }
                ]
            },
            "family inet address 172.16.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 172.16.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}