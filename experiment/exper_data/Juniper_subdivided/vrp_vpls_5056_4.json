{
    "set interfaces eth0 unit 10 family ethernet-switching trunk-ports [Ethernet1/0/0 Ethernet1/0/1]": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching trunk-ports [parameter3]",
        "command": "set interfaces eth0 unit 10 family ethernet-switching trunk-ports [Ethernet1/0/0 Ethernet1/0/1]",
        "explanation": "配置以太网交换接口的trunk端口。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如eth0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "trunk-ports",
                "type": "list",
                "explanation": "trunk端口列表，用于指定哪些端口属于该trunk。"
            }
        ]
    },
    "set interfaces lo0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 5.5.5.5/32": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 5.5.5.5/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
