    "set protocols cfm domain md1 mep-id 2 interface xe-1/0/0 direction both ccm-send interval 1 remote-mep mep-id 3 ccm-receive": {
        "template": "set protocols cfm domain [parameter1] mep-id [parameter2] interface [parameter3] direction [parameter4] ccm-send interval [parameter5] remote-mep mep-id [parameter6] ccm-receive",
        "command": "set protocols cfm domain md1 mep-id 2 interface xe-1/0/0 direction both ccm-send interval 1 remote-mep mep-id 3 ccm-receive",
        "explanation": "配置CFM（Connectivity Fault Management）协议的域、MEP（Maintenance End Point）ID、接口、方向、CCM发送间隔以及远程MEP的MEP ID和CCM接收。",
        "parameters": [
            {
                "name": "domain",
                "type": "string",
                "explanation": "CFM域的名称。"
            },
            {
                "name": "mep-id",
                "type": "integer",
                "explanation": "MEP的ID。"
            },
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如xe-1/0/0。"
            },
            {
                "name": "direction",
                "type": "string",
                "explanation": "MEP的方向，可以是up、down或both。"
            },
            {
                "name": "ccm-send-interval",
                "type": "integer",
                "explanation": "CCM发送间隔，单位为秒。"
            },
            {
                "name": "remote-mep-id",
                "type": "integer",
                "explanation": "远程MEP的ID。"
            }
        ]
    },
