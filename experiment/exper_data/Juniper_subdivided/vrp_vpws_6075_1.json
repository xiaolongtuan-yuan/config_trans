{
    "set system name host-name <hostname>": {
        "template": "set system name host-name [parameter1]",
        "command": "set system name host-name <hostname>",
        "explanation": "配置设备的主机名。",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "设备的主机名，用于标识网络中的设备。"
            }
        ]
    },
    "set interfaces ethernet0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ethernet0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address <ip-address>/<subnet-mask>": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address <ip-address>/<subnet-mask>",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set interfaces lo0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address <loopback-ip>/32": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address <loopback-ip>/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options routes static route <destination-network>/<netmask> next-hop <next-hop-ip>": {
        "template": "set routing-options routes static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set routing-options routes static route <destination-network>/<netmask> next-hop <next-hop-ip>",
        "explanation": "配置静态路由，指定目的网络和下一跳地址。",
        "parameters": [
            {
                "name": "destination-network",
                "type": "string",
                "explanation": "目的网络的IP地址。"
            },
            {
                "name": "netmask",
                "type": "integer",
                "explanation": "目的网络的子网掩码位数。"
            },
            {
                "name": "next-hop-ip",
                "type": "string",
                "explanation": "下一跳的IP地址。"
            }
        ]
    },
    "set protocolsospf area 0 network <network-range>": {
        "template": "set protocolsospf area [parameter1] network [parameter2]",
        "command": "set protocolsospf area 0 network <network-range>",
        "explanation": "配置OSPF协议的Area 0的网络范围。",
        "parameters": [
            {
                "name": "area",
                "type": "integer",
                "explanation": "OSPF区域号，例如0。"
            },
            {
                "name": "network-range",
                "type": "string",
                "explanation": "OSPF网络范围。"
            }
        ]
    }
}