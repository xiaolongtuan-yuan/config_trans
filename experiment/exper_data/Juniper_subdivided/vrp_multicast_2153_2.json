            {
                "name": "vlan",
                "type": "string",
                "explanation": "VLAN name, for example."
            }
        ],
        "interface ge-3/0/0.0": {
            "template": "interface [parameter2]",
            "command": "interface ge-3/0/0.0",
            "explanation": "This command enables IGMP snooping on a specific VLAN (`[parameter1]`) and configures it to listen for multicast traffic on a designated interface (`[parameter2]`).",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-3/0/0.0."
                }
            ],
            "static-group 224.0.0.1": {
