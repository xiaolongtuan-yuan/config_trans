    "set protocols igmp-snooping vlan default": {
        "template": "set protocols igmp-snooping vlan [parameter1]",
        "command": "set protocols igmp-snooping vlan default",
        "explanation": "This command enables IGMP snooping for a specific VLAN (`[parameter1]`), allowing the switch to manage multicast traffic efficiently within that VLAN.",
