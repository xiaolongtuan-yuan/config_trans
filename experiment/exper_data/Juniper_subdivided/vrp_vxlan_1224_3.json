{
    "set system name my-router-name": {
        "template": "set system name [parameter1]",
        "command": "set system name my-router-name",
        "explanation": "The name of the configuration device.",
        "parameters": [
            {
                "name": "name",
                "type": "string",
                "explanation": "Name of the device, used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces lo0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 127.0.0.1/32": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 127.0.0.1/32",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options router-id 10.0.0.1": {
        "template": "set routing-options router-id [parameter1]",
        "command": "set routing-options router-id 10.0.0.1",
        "explanation": "Configure the device's Router ID.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
                "explanation": "Router ID of equipment for OSPF, BGP, etc."
            }
        ]
    },
    "set protocols static route 0.0.0.0/0 next-hop 192.168.1.1": {
        "template": "set protocols static route [parameter1]/[parameter2] next-hop [parameter3]",
        "command": "set protocols static route 0.0.0.0/0 next-hop 192.168.1.1",
        "explanation": "配置静态路由的下一跳地址。",
        "parameters": [
            {
                "name": "route",
                "type": "string",
                "explanation": "目标网络地址。"
            },
            {
                "name": "subnet-mask",
                "type": "integer",
                "explanation": "目标网络的子网掩码位数。"
            },
            {
                "name": "next-hop",
                "type": "string",
                "explanation": "下一跳的IP地址。"
            }
        ]
    }
}