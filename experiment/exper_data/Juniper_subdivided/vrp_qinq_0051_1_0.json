{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan10": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 10": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set vlans vlan20": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan20",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 20": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 20",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching interface-mode access": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode access",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan-members [ 2-500 ]": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching vlan-members [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching vlan-members [ 2-500 ]",
        "explanation": "配置接口的VLAN成员范围。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "vlan-members",
                "type": "range",
                "explanation": "VLAN成员的范围。"
            }
        ]
    },
    "set interfaces ge-1/0/1 flexible-vlan-tagging": {
        "template": "set interfaces [parameter1] flexible-vlan-tagging",
        "command": "set interfaces ge-1/0/1 flexible-vlan-tagging",
        "explanation": "启用接口的灵活VLAN标记功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            }
        ]
    },
    "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id 10 translate vlan-id 20": {
        "template": "set interfaces [parameter1] stacked-vlan-translations vlan-id [parameter2] translate vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id 10 translate vlan-id 20",
        "explanation": "配置接口的堆叠VLAN翻译，将一个VLAN ID翻译为另一个VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "原始VLAN的ID号。"
            },
            {
                "name": "translate-vlan-id",
                "type": "integer",
                "explanation": "翻译后的VLAN的ID号。"
            }
        ]
    },
    "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id-range 1000-2000 translate vlan-id 20": {
        "template": "set interfaces [parameter1] stacked-vlan-translations vlan-id-range [parameter2] translate vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/1 stacked-vlan-translations vlan-id-range 1000-2000 translate vlan-id 20",
        "explanation": "配置接口的堆叠VLAN翻译，将一个VLAN ID范围翻译为另一个VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "vlan-id-range",
                "type": "range",
                "explanation": "原始VLAN的ID范围。"
            },
            {
                "name": "translate-vlan-id",
                "type": "integer",
                "explanation": "翻译后的VLAN的ID号。"
            }
        ]
    },
