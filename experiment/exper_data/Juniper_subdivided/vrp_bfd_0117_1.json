{
    "set system host-name DeviceB": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceB",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ae1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.1.1.2/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set interfaces ge-0/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "ether-options 802.3ad ae1": {
            "template": "ether-options 802.3ad [parameter2]",
            "command": "ether-options 802.3ad ae1",
            "explanation": "Configure the Ethernet option for the interface and add it to the chain aggregation group.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Name of chain aggregate group, e.g. ae1."
                }
            ]
        }
    },
    "set interfaces ge-0/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "ether-options 802.3ad ae1": {
            "template": "ether-options 802.3ad [parameter2]",
            "command": "ether-options 802.3ad ae1",
            "explanation": "Configure the Ethernet option for the interface and add it to the chain aggregation group.",
            "parameters": [
                {
                    "name": "aggregated-interface",
                    "type": "string",
                    "explanation": "Name of chain aggregate group, e.g. ae1."
                }
            ]
        }
    },
    "set protocols bfd template btoa": {
        "template": "set protocols bfd template [parameter1]",
        "command": "set protocols bfd template btoa",
        "explanation": "Sets a BFD (Bidirectional Forwarding Detection) template named `[parameter1]` to configure BFD session parameters for protocols in Junos OS.",
        "parameters": [
            {
                "name": "template-name",
                "type": "string",
                "explanation": "The name of the BFD template."
            }
        ],
        "min-transmit-interval 10": {
            "template": "min-transmit-interval [parameter2]",
            "command": "min-transmit-interval 10",
            "explanation": "This Junos command sets the BFD template's minimum transmit interval to `[parameter2]` milliseconds, controlling the frequency of BFD control packets sent for `[parameter1]`.",
            "parameters": [
                {
                    "name": "min-transmit-interval",
                    "type": "integer",
                    "explanation": "Minimum transmission interval in milliseconds."
                }
            ],
            "min-receive-interval 10": {
                "template": "min-receive-interval [parameter3]",
                "command": "min-receive-interval 10",
                "explanation": "Configures the minimum transmission interval and the minimum receiving interval of the BFD template.",
                "parameters": [
                    {
                        "name": "min-receive-interval",
                        "type": "integer",
                        "explanation": "Minimum receiving interval in milliseconds."
                    }
                ]
            }
        }
    },
    "set protocols bfd interface ae1": {
        "template": "set protocols bfd interface [parameter1]",
        "command": "set protocols bfd interface ae1",
        "explanation": "Enables the BFD protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "family inet peer 10.1.1.1": {
            "template": "family inet peer [parameter2]",
            "command": "family inet peer 10.1.1.1",
            "explanation": "This command enables BFD (Bidirectional Forwarding Detection) on a specified interface (`[parameter1]`) for IPv4 (family inet) with a specific peer (`[parameter2]`).",
            "parameters": [
                {
                    "name": "peer-ip-address",
                    "type": "string",
                    "explanation": "Peer IPv4 address."
                }
            ],
            "source 10.1.1.2": {
                "template": "source [parameter3]",
                "command": "source 10.1.1.2",
                "explanation": "Configure peer IPv4 addresses and source addresses for BFD interfaces.",
                "parameters": [
                    {
                        "name": "source-ip-address",
                        "type": "string",
                        "explanation": "Source IPv4 address."
                    }
                ]
            }
        }
    }
}