    "set protocols isis level 1 circuit-type point-to-point": {
        "template": "set protocols isis level [parameter1] circuit-type [parameter2]",
        "command": "set protocols isis level 1 circuit-type point-to-point",
        "explanation": "配置IS-IS协议的级别和电路类型。",
        "parameters": [
            {
                "name": "level",
                "type": "integer",
                "explanation": "IS-IS协议的级别，1表示级别1。"
            },
            {
                "name": "circuit-type",
                "type": "string",
                "explanation": "电路类型，point-to-point表示点对点。"
            }
        ]
    },
