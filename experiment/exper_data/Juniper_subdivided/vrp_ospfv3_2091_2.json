{
    "set system host-name DeviceC": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-3/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-3/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet6 address 2001:DB8:3::1/64": {
                "template": "family inet6 address [parameter3]/[parameter4]",
                "command": "family inet6 address 2001:DB8:3::1/64",
                "explanation": "Configure the IPv6 address of the interface and the length of the subnet prefix.",
                "parameters": [
                    {
                        "name": "ipv6-address",
                        "type": "string",
                        "explanation": "The IPv6 address assigned to the interface."
                    },
                    {
                        "name": "prefix-length",
                        "type": "integer",
                        "explanation": "Subnet prefix length for IPv6."
                    }
                ]
            },
            "family inet6 ospf area 0.0.0.1": {
                "template": "family inet6 ospf area [parameter3]",
                "command": "family inet6 ospf area 0.0.0.1",
                "explanation": "Configure the OSF area of the interface.",
                "parameters": [
                    {
                        "name": "ospf-area",
                        "type": "string",
                        "explanation": "OSF Area ID."
                    }
                ]
            }
        }
    },
    "set protocols ospf3 instance-id 1": {
        "template": "set protocols ospf3 instance-id [parameter1]",
        "command": "set protocols ospf3 instance-id 1",
        "explanation": "配置OSPFv3实例ID。",
        "parameters": [
            {
                "name": "instance-id",
                "type": "integer",
                "explanation": "OSPFv3实例的唯一标识符。"
            }
        ]
    },
    "set protocols ospf3 area 0.0.0.1": {
        "template": "set protocols ospf3 area [parameter1]",
        "command": "set protocols ospf3 area 0.0.0.1",
        "explanation": "Configure the OSPFv3 area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPFv3 area number."
            }
        ],
        "interface ge-3/0/0.0": {
            "template": "interface [parameter2]",
            "command": "interface ge-3/0/0.0",
            "explanation": "Configure OSPFv3 regions and interfaces.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0."
                }
            ]
        }
    },
    "set protocols ospf3 router-id 4.4.4.4": {
        "template": "set protocols ospf3 router-id [parameter1]",
        "command": "set protocols ospf3 router-id 4.4.4.4",
        "explanation": "Configure OSPFv3 router ID.",
        "parameters": [
            {
                "name": "router-id",
                "type": "string",
