{
    "set system host-name CE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan2": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 2": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set interfaces vlan": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces vlan",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 2": {
            "template": "unit [parameter2]",
            "command": "unit 2",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 192.168.1.11/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.1.11/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set interfaces ae10": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae10",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "aggregated-ether-options lacp active": {
            "template": "aggregated-ether-options lacp [parameter2]",
            "command": "aggregated-ether-options lacp active",
            "explanation": "Configure the LACP option for the aggregate interface as the active mode.",
            "parameters": [
                {
                    "name": "lacp-mode",
                    "type": "string",
                    "explanation": "LACP model, activity indicates a proactive model."
                }
            ]
        },
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members vlan2": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members vlan2",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        }
    },
    "set interfaces ae10 aggregated-ether-options lacp periodic fast": {
        "template": "set interfaces [parameter1] aggregated-ether-options lacp periodic [parameter2]",
        "command": "set interfaces ae10 aggregated-ether-options lacp periodic fast",
        "explanation": "配置聚合接口的LACP周期为快速模式。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "聚合接口名称，例如ae10。"
            },
            {
                "name": "lacp-periodic",
                "type": "string",
                "explanation": "LACP的周期模式，fast表示快速模式。"
            }
        ]
    },
