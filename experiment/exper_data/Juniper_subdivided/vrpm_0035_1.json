{
    "set system name-identifier <name-identifier-value>": {
        "template": "set system name-identifier [parameter1]",
        "command": "set system name-identifier <name-identifier-value>",
        "explanation": "Configure the name identifier of the system.",
        "parameters": [
            {
                "name": "name-identifier",
                "type": "string",
                "explanation": "System name identifier for the identification system."
            }
        ]
    },
    "set interfaces ethernet0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ethernet0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address <ip-address> <subnet-mask>": {
                "template": "family inet address [parameter3] [parameter4]",
                "command": "family inet address <ip-address> <subnet-mask>",
                "explanation": "Configure the IPv4 address and subnet mask for the Ethernet interface.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "string",
                        "explanation": "IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set interfaces lo0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces lo0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address <loopback-ip> <subnet-mask>": {
                "template": "family inet address [parameter3] [parameter4]",
                "command": "family inet address <loopback-ip> <subnet-mask>",
                "explanation": "Configure the IPv4 address and subnet mask for the Ethernet interface.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "string",
                        "explanation": "IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options static route <destination-network>/<prefix-length>": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route <destination-network>/<prefix-length>",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop <next-hop-ip>": {
            "template": "next-hop [parameter3]",
            "command": "next-hop <next-hop-ip>",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set policy-instances default from ipsec esp proposal esp-proposal": {
        "template": "set policy-instances default from ipsec esp proposal [parameter1]",
        "command": "set policy-instances default from ipsec esp proposal esp-proposal",
        "explanation": "Configure the default policy example, specify the name of the proposal used from the IPSEc ESP proposal.",
        "parameters": [
            {
                "name": "proposal-name",
                "type": "string",
                "explanation": "Name of IPSec ESP proposal."
            }
        ]
    }
}