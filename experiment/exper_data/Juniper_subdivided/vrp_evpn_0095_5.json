{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces irb unit 10 family bridge": {
        "template": "set interfaces [parameter1] unit [parameter2] family bridge",
        "command": "set interfaces irb unit 10 family bridge",
        "explanation": "配置IRB接口的桥接功能。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如irb。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            }
        ]
    },
    "set interfaces ae10": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ae10",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
