                    {
                        "name": "vlan-id",
                        "type": "integer",
                        "explanation": "VLAN ID, used to identify VLAN."
                    }
                ]
            },
            "family bridge interface-mode trunk": {
                "template": "family bridge interface-mode [parameter3]",
                "command": "family bridge interface-mode trunk",
                "explanation": "Configure the bridge mode for interface units is access.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, for example, access."
                    }
                ]
            },
            "family bridge vlan-id-list 100": {
                "template": "family bridge vlan-id-list [parameter3]",
