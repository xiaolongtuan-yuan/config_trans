{
    "set system host-name CE4": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE4",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan200": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan200",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 200": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 200",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set protocols rstp": {
        "template": "set protocols [parameter1]",
        "command": "set protocols rstp",
        "explanation": "Enables RSTP protocol.",
        "parameters": [
            {
                "name": "protocol",
                "type": "string",
                "explanation": "Enables the protocol name, such as rstp."
            }
        ]
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members 200": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members 200",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            },
            "family ethernet-switching interface-mode trunk": {
                "template": "family ethernet-switching interface-mode [parameter3]",
                "command": "family ethernet-switching interface-mode trunk",
                "explanation": "Configures the interface with trunk exchange mode.",
                "parameters": [
                    {
                        "name": "interface-mode",
                        "type": "string",
                        "explanation": "Interface mode, such as trunk."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-block": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching bpdu-block",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching bpdu-block",
        "explanation": "在接口上启用BPDU阻塞。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号。"
            }
        ]
    }
}