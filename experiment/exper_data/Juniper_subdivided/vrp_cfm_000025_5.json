    "set interfaces ge-1/0/1 unit 0 family ethernet-switching native-vlan-id 10": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching native-vlan-id [parameter3]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching native-vlan-id 10",
        "explanation": "配置接口的以太网交换原生VLAN ID。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "native-vlan-id",
                "type": "integer",
                "explanation": "原生VLAN的ID号。"
            }
