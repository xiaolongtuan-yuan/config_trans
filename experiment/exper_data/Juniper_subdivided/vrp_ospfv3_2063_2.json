{
    "set system host-name DeviceC": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet6 address 2001:db8:1::2/64": {
                "template": "family inet6 address [parameter3]/[parameter4]",
                "command": "family inet6 address 2001:db8:1::2/64",
                "explanation": "Configure the IPv6 address of the interface and the length of the subnet prefix.",
                "parameters": [
                    {
                        "name": "ipv6-address",
                        "type": "string",
                        "explanation": "The IPv6 address assigned to the interface."
                    },
                    {
                        "name": "prefix-length",
                        "type": "integer",
                        "explanation": "Subnet prefix length for IPv6."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::2/64 ospfv3 disable": {
        "template": "set interfaces [parameter1] unit [parameter2] family inet6 address [parameter3]/[parameter4] ospfv3 [parameter5]",
        "command": "set interfaces ge-1/0/0 unit 0 family inet6 address 2001:db8:1::2/64 ospfv3 disable",
        "explanation": "在接口上禁用OSPFv3。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/0。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "ipv6-address",
                "type": "string",
                "explanation": "分配给接口的IPv6地址。"
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "IPv6地址的前缀长度。"
            },
            {
                "name": "ospfv3-action",
                "type": "string",
                "explanation": "OSPFv3的操作，例如disable表示禁用。"
            }
        ]
    },
