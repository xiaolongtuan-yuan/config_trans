    "set protocols ospf 1": {
        "template": "set protocols ospf [parameter1]",
        "command": "set protocols ospf 1",
        "explanation": "This command configures OSPF (Open Shortest Path First) protocol settings in Junos, where `[parameter1]` specifies the specific OSPF parameter to be defined or modified.",
        "parameters": [
            {
                "name": "ospf-instance",
                "type": "integer",
                "explanation": "OSF Example Number."
            }
        ],
        "area 0": {
            "template": "area [parameter2]",
            "command": "area 0",
            "explanation": "Configure examples and areas of the OSPF protocol.",
            "parameters": [
                {
                    "name": "area",
                    "type": "integer",
                    "explanation": "OSPF area number."
                }
            ],
            "network 192.168.3.0/24": {
                "template": "network [parameter3]/[parameter4]",
                "command": "network 192.168.3.0/24",
                "explanation": "Configure the network within the OSPF area.",
                "parameters": [
                    {
                        "name": "network",
                        "type": "string",
                        "explanation": "The address of the network belongs to the OSPF area."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "_Other Organiser"
                    }
                ]
            }
        }
    },
