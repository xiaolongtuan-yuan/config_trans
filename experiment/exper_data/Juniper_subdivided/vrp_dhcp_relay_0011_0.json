{
    "set system host-name DeviceA": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceA",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system services dhcp": {
        "template": "set system services [parameter1]",
        "command": "set system services dhcp",
        "explanation": "Enable system services such as SSH.",
        "parameters": [
            {
                "name": "service",
                "type": "string",
                "explanation": "System service name, e.g. ssh."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet dhcp-relay server 10.100.20.1": {
                "template": "family inet dhcp-relay server [parameter3]",
                "command": "family inet dhcp-relay server 10.100.20.1",
                "explanation": "Configure the DHCP relay server address.",
                "parameters": [
                    {
                        "name": "server-ip",
                        "type": "string",
                        "explanation": "IP address of DHCP server."
                    }
                ]
            }
        }
    },
    "set interfaces ge-2/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-2/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 172.16.1.1/16": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 172.16.1.1/16",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    }
}