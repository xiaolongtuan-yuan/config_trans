{
    "set system host-name PE1": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE1",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan-10": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-10",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 10": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 10",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set protocols mpls interface all": {
        "template": "set protocols mpls interface [parameter1]",
        "command": "set protocols mpls interface all",
        "explanation": "Enables the MPLS protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set protocols ldp interface all": {
        "template": "set protocols ldp interface [parameter1]",
        "command": "set protocols ldp interface all",
        "explanation": "Enables the LDP protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g. g-0/0/0."
            }
        ]
    },
    "set protocols ospf area 0": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "interface lo0.0": {
            "template": "interface [parameter2]",
            "command": "interface lo0.0",
            "explanation": "Configure interfaces in the OSPF area.",
            "parameters": [
                {
                    "name": "interface",
                    "type": "string",
                    "explanation": "Interface name, e.g., g-1/0/0.0."
                }
            ]
        }
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 1": {
            "template": "unit [parameter2]",
            "command": "unit 1",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family mpls l2circuit neighbor 2.2.2.9": {
                "template": "family mpls l2circuit neighbor [parameter3]",
                "command": "family mpls l2circuit neighbor 2.2.2.9",
                "explanation": "This command configures an L2 circuit on a Junos interface, specifying the neighbor's IP address for MPLS Layer 2 VPN connectivity.",
                "parameters": [
                    {
                        "name": "neighbor",
                        "type": "string",
                        "explanation": "Neighbor's IP address."
                    }
                ],
                "virtual-circuit-id 100": {
                    "template": "virtual-circuit-id [parameter4]",
                    "command": "virtual-circuit-id 100",
                    "explanation": "Configure MPLS L2 circuit neighbors and virtual circuit ID.",
                    "parameters": [
                        {
                            "name": "virtual-circuit-id",
                            "type": "integer",
                            "explanation": "Virtual circuit ID."
                        }
                    ]
                }
            }
        }
    },
    "set interfaces ge-2/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-2/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.1.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.1.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
