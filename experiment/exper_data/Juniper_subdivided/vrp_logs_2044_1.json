{
    "set system host-name Device": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name Device",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set system syslog host 10.1.1.1 any informational": {
        "template": "set system syslog host [parameter1] any [parameter2]",
        "command": "set system syslog host 10.1.1.1 any informational",
        "explanation": "配置系统日志服务器及日志级别。",
        "parameters": [
            {
                "name": "host-ip",
                "type": "string",
                "explanation": "系统日志服务器的IP地址。"
            },
            {
                "name": "log-level",
                "type": "string",
                "explanation": "日志级别，例如informational。"
            }
        ]
    },
    "set system syslog source-address 10.1.1.2": {
        "template": "set system syslog source-address [parameter1]",
        "command": "set system syslog source-address 10.1.1.2",
