{
    "set system host-name PE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name PE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set protocols rstp interface all": {
        "template": "set protocols rstp interface [parameter1]",
        "command": "set protocols rstp interface all",
        "explanation": "Enables RSTP protocols on all interfaces.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface range, call indicates all interfaces."
            }
        ]
    },
    "set protocols rstp vlan 10": {
        "template": "set protocols rstp vlan [parameter1]",
        "command": "set protocols rstp vlan 10",
        "explanation": "Enables RSTP protocols on specified VLAN.",
        "parameters": [
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID."
            }
        ],
        "root-priority 0": {
            "template": "root-priority [parameter2]",
            "command": "root-priority 0",
            "explanation": "Configures the VLAN root priority of the RSTP protocol.",
            "parameters": [
                {
                    "name": "root-priority",
                    "type": "integer",
                    "explanation": "Root Bridge priority."
                }
            ]
        }
    },
    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "disable false": {
            "template": "disable [parameter2]",
            "command": "disable false",
            "explanation": "Enable interfaces.",
            "parameters": [
                {
                    "name": "disable",
                    "type": "boolean",
                    "explanation": "Disables the interface, false means enabled."
                }
            ]
        }
    },
