    "set interfaces ge-1/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/1",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family ethernet-switching vlan members [10": {
                "template": "family ethernet-switching vlan members [parameter3]",
                "command": "family ethernet-switching vlan members [10",
                "explanation": "Configure the VLAN members of the interface.",
                "parameters": [
                    {
                        "name": "vlan-members",
                        "type": "string",
                        "explanation": "VLAN members, e.g. vlan 100."
                    }
                ]
            }
        }
    },
    "set interfaces ge-1/0/1 unit 0 family ethernet-switching erps ring 1 role owner": {
        "template": "set interfaces [parameter1] unit [parameter2] family ethernet-switching erps ring [parameter3] role [parameter4]",
        "command": "set interfaces ge-1/0/1 unit 0 family ethernet-switching erps ring 1 role owner",
        "explanation": "配置接口的ERPS环角色为owner。",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "接口名称，例如ge-1/0/1。"
            },
            {
                "name": "unit",
                "type": "integer",
                "explanation": "接口单元号，用于区分同一接口下的多个逻辑配置。"
            },
            {
                "name": "erps-ring",
                "type": "integer",
                "explanation": "ERPS环的ID号。"
            },
            {
                "name": "role",
                "type": "string",
                "explanation": "ERPS环的角色，例如owner。"
            }
        ]
    },
