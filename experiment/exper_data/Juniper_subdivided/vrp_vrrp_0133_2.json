    "set protocols spanning-tree vlan vlan10": {
        "template": "set protocols spanning-tree vlan [parameter1]",
        "command": "set protocols spanning-tree vlan vlan10",
        "explanation": "This command configures Spanning Tree Protocol (STP) settings for a specific VLAN (`[parameter1]`), enabling STP to prevent loops in the network for that VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, for example, vlan10."
