{
    "set system host-name DeviceC": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name DeviceC",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set interfaces ge-1/0/0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-1/0/0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 10.2.1.2/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 10.2.1.2/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            },
            "description \"GigabitEthernet1/0/0\"": {
                "template": "description [parameter3]",
                "command": "description \"GigabitEthernet1/0/0\"",
                "explanation": "Configure the description of the interface.",
                "parameters": [
                    {
                        "name": "description",
                        "type": "string",
                        "explanation": "Description of the interface."
                    }
                ]
            }
        }
    },
    "set routing-options static route 10.1.1.0/24": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 10.1.1.0/24",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop 10.2.1.1": {
            "template": "next-hop [parameter3]",
            "command": "next-hop 10.2.1.1",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set protocols bfd interface all": {
        "template": "set protocols bfd interface [parameter1]",
        "command": "set protocols bfd interface all",
        "explanation": "Enables the BFD protocol on the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "local-discriminator 20": {
            "template": "local-discriminator [parameter2]",
            "command": "local-discriminator 20",
            "explanation": "Configures the local identifier for BFD sessions.",
            "parameters": [
                {
                    "name": "local-discriminator",
                    "type": "integer",
                    "explanation": "Local identifier for BFD sessions."
                }
            ]
        },
        "remote-discriminator 10": {
            "template": "remote-discriminator [parameter2]",
            "command": "remote-discriminator 10",
            "explanation": "Configures the remote identifier for BFD sessions.",
            "parameters": [
                {
                    "name": "remote-discriminator",
                    "type": "integer",
                    "explanation": "Remote identifier for BFD sessions."
                }
            ]
        }
    },
    "set protocols bfd neighbor 10.1.1.1": {
        "template": "set protocols bfd neighbor [parameter1]",
        "command": "set protocols bfd neighbor 10.1.1.1",
        "explanation": "配置BFD邻居。",
        "parameters": [
            {
                "name": "neighbor-address",
                "type": "string",
                "explanation": "BFD邻居的IP地址。"
            }
        ]
    }
}