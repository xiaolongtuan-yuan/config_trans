        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment is used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan-2": {
        "template": "set vlans [parameter1]",
        "command": "set vlans vlan-2",
        "explanation": "Configure VLAN.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "VLAN's name, like Vlan100."
            }
        ],
        "vlan-id 2": {
            "template": "vlan-id [parameter2]",
            "command": "vlan-id 2",
            "explanation": "Configure VLAN's ID.",
            "parameters": [
                {
                    "name": "vlan-id",
                    "type": "integer",
                    "explanation": "VLAN ID for the only identification of a VLAN."
                }
            ]
        }
    },
    "set protocols cfm mep interface ge-0/0/1": {
        "template": "set protocols cfm mep interface [parameter1]",
        "command": "set protocols cfm mep interface ge-0/0/1",
        "explanation": "Configure the interface for CFM MEP.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "interface name."
            }
        ],
        "loss-measure dual-ended continual": {
            "template": "loss-measure [parameter2] [parameter3]",
            "command": "loss-measure dual-ended continual",
            "explanation": "Configures CFM MEP on an interface to measure frame loss using specified parameters for interval and threshold.",
            "parameters": [
                {
                    "name": "measurement-type",
                    "type": "string",
                    "explanation": "Type of measurement, such as dual-ended."
                },
                {
                    "name": "measurement-mode",
                    "type": "string",
                    "explanation": "Measurement patterns, such as continual."
                }
            ],
            "test-id 2": {
                "template": "test-id [parameter4]",
                "command": "test-id 2",
                "explanation": "Configures the double-end of the CFM MEP to continuously drop packages.",
                "parameters": [
                    {
                        "name": "test-id",
                        "type": "integer",
                        "explanation": "Test ID number."
                    }
                ]
            }
        }
    },
    "set interfaces ge-0/0/1": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces ge-0/0/1",
