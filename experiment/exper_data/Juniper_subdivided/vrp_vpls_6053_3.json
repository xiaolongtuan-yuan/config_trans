{
    "set interfaces eth0": {
        "template": "set interfaces [parameter1]",
        "command": "set interfaces eth0",
        "explanation": "Creates a polymer interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ],
        "unit 0": {
            "template": "unit [parameter2]",
            "command": "unit 0",
            "explanation": "Configure the unit number of the interface.",
            "parameters": [
                {
                    "name": "unit",
                    "type": "integer",
                    "explanation": "Interface unit numbers that distinguish between multiple logical configurations under the same interface."
                }
            ],
            "family inet address 192.168.1.1/24": {
                "template": "family inet address [parameter3]/[parameter4]",
                "command": "family inet address 192.168.1.1/24",
                "explanation": "Configure IPv4 addresses for interfaces and subnet masks.",
                "parameters": [
                    {
                        "name": "ip-address",
                        "type": "string",
                        "explanation": "The IPv4 address assigned to the interface."
                    },
                    {
                        "name": "subnet-mask",
                        "type": "integer",
                        "explanation": "Bits of IPv4 subnet mask."
                    }
                ]
            }
        }
    },
    "set routing-options static route 0.0.0.0/0": {
        "template": "set routing-options static route [parameter1]/[parameter2]",
        "command": "set routing-options static route 0.0.0.0/0",
        "explanation": "This command configures a static route in Junos, where `[parameter1]` is the destination network and `[parameter2]` is the subnet mask.",
        "parameters": [
            {
                "name": "destination",
                "type": "string",
                "explanation": "Target network address."
            },
            {
                "name": "prefix-length",
                "type": "integer",
                "explanation": "Prefix length of target network."
            }
        ],
        "next-hop 192.168.1.2": {
            "template": "next-hop [parameter3]",
            "command": "next-hop 192.168.1.2",
            "explanation": "Configures static routers.",
            "parameters": [
                {
                    "name": "next-hop",
                    "type": "string",
                    "explanation": "Next jump address."
                }
            ]
        }
    },
    "set protocols ospf area 0": {
        "template": "set protocols ospf area [parameter1]",
        "command": "set protocols ospf area 0",
        "explanation": "This command configures an OSPF area in Junos OS, where `[parameter1]` specifies the area ID, enabling OSPF routing within the defined area.",
        "parameters": [
            {
                "name": "area",
                "type": "string",
                "explanation": "OSPF area ID."
            }
        ],
        "network 192.168.1.0/24": {
            "template": "network [parameter2]/[parameter3]",
            "command": "network 192.168.1.0/24",
            "explanation": "Configure the network within the OSPF area.",
            "parameters": [
                {
                    "name": "network",
                    "type": "string",
                    "explanation": "Web address."
                },
                {
                    "name": "subnet-mask",
                    "type": "integer",
                    "explanation": "bits of subnet mask."
                }
            ]
        }
    }
