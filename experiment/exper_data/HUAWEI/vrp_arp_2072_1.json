{
    "interface GigabitEthernet1/0/2": {
        "template": "interface [interface-name]",
        "command": "interface GigabitEthernet1/0/2",
        "explanation": "进入GigabitEthernet1/0/2接口的配置模式",
        "parameters": [
            {
                "name": "interface-name",
                "type": "string",
                "explanation": "接口名称"
            }
        ],
        "subcommands": [
            {
                "portswitch": {
                    "template": "portswitch",
                    "command": "portswitch",
                    "explanation": "启用接口的交换功能",
                    "parameters": []
                }
            },
            {
                "undo shutdown": {
                    "template": "undo shutdown",
                    "command": "undo shutdown",
                    "explanation": "启用接口（默认情况下接口是关闭的）",
                    "parameters": []
                }
            },
            {
                "port link-type trunk": {
                    "template": "port link-type [type]",
                    "command": "port link-type trunk",
                    "explanation": "设置接口的链路类型为中继模式",
                    "parameters": [
                        {
                            "name": "type",
                            "type": "string",
                            "explanation": "链路类型，如 access 或 trunk"
                        }
                    ]
                }
            },
            {
                "port trunk allow-pass vlan 10": {
                    "template": "port trunk allow-pass vlan [vlan-id-list]",
                    "command": "port trunk allow-pass vlan 10",
                    "explanation": "允许VLAN 10通过中继接口",
                    "parameters": [
                        {
                            "name": "vlan-id-list",
                            "type": "list of integers",
                            "explanation": "允许通过的VLAN ID列表"
                        }
                    ]
                }
            }
        ]
    }
}