{
    "set system host-name CE2": {
        "template": "set system host-name [parameter1]",
        "command": "set system host-name CE2",
        "explanation": "Configure the host name of the device.",
        "parameters": [
            {
                "name": "hostname",
                "type": "string",
                "explanation": "The host name of the equipment used to identify the equipment in the network."
            }
        ]
    },
    "set vlans vlan-10 vlan-id 10": {
        "template": "set vlans [parameter1] vlan-id [parameter2]",
        "command": "set vlans vlan-10 vlan-id 10",
        "explanation": "Configure VLAN's ID.",
        "parameters": [
            {
                "name": "vlan-name",
                "type": "string",
                "explanation": "Vlan's name."
            },
            {
                "name": "vlan-id",
                "type": "integer",
                "explanation": "VLAN ID."
            }
        ]
    },
    "set interfaces ae1 aggregated-ether-options": {
        "template": "set interfaces [parameter1] aggregated-ether-options",
        "command": "set interfaces ae1 aggregated-ether-options",
        "explanation": "Configure the options for the etho-net interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Aggregation is given the name of the ethnet interface, e.g. ae1."
            }
        ]
    },
    "set interfaces ge-1/0/0 enable": {
        "template": "set interfaces [parameter1] enable",
        "command": "set interfaces ge-1/0/0 enable",
        "explanation": "Enables the specified interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            }
        ]
    },
    "set interfaces ge-1/0/0 ether-options 802.3ad ae1": {
        "template": "set interfaces [parameter1] ether-options 802.3ad [parameter2]",
        "command": "set interfaces ge-1/0/0 ether-options 802.3ad ae1",
        "explanation": "Configure the Ethernet option for the interface, and add it to the specified Convergence Ethernet interface.",
        "parameters": [
            {
                "name": "interface",
                "type": "string",
                "explanation": "Interface name, e.g., g-1/0/0."
            },
            {
                "name": "aggregated-interface",
                "type": "string",
                "explanation": "Aggregation is given the name of the ethnet interface, e.g. ae1."
            }
        ]
    }
}