        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "undo shutdown": {
            "template": "undo shutdown",
            "command": "undo shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 10.4.1.1 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.4.1.1 255.255.255.0",
            "explanation": "Configure interface IPv4 address 10.4.1.1 with subnet mask 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        }
    },
    "bgp 65440": {
        "template": "bgp [parameter1]",
        "command": "bgp 65440",
        "explanation": "Enter BGP configuration mode, AS 65440",
        "parameters": [
            {
                "name": "AS number",
                "type": "integer",
                "explanation": "Autonomy Systems (AS)"
            }
        ],
        "peer 10.4.1.2 as-number 100": {
            "template": "peer [parameter1] as-number [parameter2]",
            "command": "peer 10.4.1.2 as-number 100",
            "explanation": "Configure IP addresses and AS numbers for BGP equivalents",
            "parameters": [
                {
                    "name": "peer IP address",
                    "type": "IPv4",
                    "explanation": "IP address of peer"
                },
                {
                    "name": "AS number",
                    "type": "integer",
                    "explanation": "Symmetric AS"
                }
            ]
        },
        "ipv4-family unicast": {
            "template": "ipv4-family unicast",
            "command": "ipv4-family unicast",
            "explanation": "Enter IPv4 solo community configuration mode",
            "parameters": [],
            "undo synchronization": {
                "template": "undo synchronization",
                "command": "undo synchronization",
