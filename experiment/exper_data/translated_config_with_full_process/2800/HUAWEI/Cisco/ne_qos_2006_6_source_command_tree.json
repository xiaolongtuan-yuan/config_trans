                "parameters": []
            },
            "import-route direct": {
                "template": "import-route [parameter1]",
                "command": "import-route direct",
                "explanation": "Direct route to BGP",
                "parameters": []
            },
            "peer 10.4.1.2 enable": {
                "template": "peer [parameter1] enable",
                "command": "peer 10.4.1.2 enable",
                "explanation": "Enable BGP sessions with specified peers",
                "parameters": [
                    {
                        "name": "peer IP address",
