{
  "rule_source": [
    "set system services ssh",
    "set system services ssh ciphers [parameter1]",
    "set system services ssh ciphers [parameter1]",
    "set system services ssh ciphers [parameter1]",
    "set interfaces [interface] unit [unit] disable",
    "set system login user [parameter1] class [parameter2]",
    "set system login user [parameter1] authentication [parameter2]"
  ],
  "llm_source": [
    "set system services [service]",
    "set system login user [parameter1] class [parameter2]"
  ],
  "target": [
    "rsa local-key-pair create [parameter1]",
    "ssh server enable",
    "ssh server compatibility enable",
    "ssh server cipher [parameter1] [parameter2] [parameter3]",
    "aaa",
    "local-user [parameter1] password irreversible-cipher [parameter2]",
    "local-user [parameter1] privilege level [parameter2]",
    "local-user [parameter1] service-type ssh",
    "user-interface vty [parameter1] [parameter2]",
    "authentication-mode aaa",
    "protocol inbound ssh"
  ]
}