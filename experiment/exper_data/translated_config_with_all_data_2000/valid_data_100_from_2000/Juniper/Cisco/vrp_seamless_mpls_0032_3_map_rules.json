    "['set policy-options policy-statement [parameter1]', [{'para_map': [], 'trans_command': 'route-map policy1 permit 10', 'parent_command': [], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- The Juniper `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- `from protocol bgp` becomes `match protocol bgp`\\n- `then accept` is implied by the `permit` action in the route-map statement\\n- The sequence number (10) is maintained in the Cisco configuration\", 'trans_template': 'route-map policy1 permit 10'}, {'para_map': [], 'trans_command': 'match protocol bgp', 'parent_command': [], 'root': 'match protocol bgp', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- The Juniper `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- `from protocol bgp` becomes `match protocol bgp`\\n- `then accept` is implied by the `permit` action in the route-map statement\\n- The sequence number (10) is maintained in the Cisco configuration\", 'trans_template': 'match protocol bgp'}]]": 1,
    "['term [parameter2] from protocol [parameter3]', [{'para_map': [], 'trans_command': 'route-map policy1 permit 10', 'parent_command': ['route-map policy1 permit 10'], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- In Cisco, `route-map` is used instead of `policy-statement`\\n- `permit 10` corresponds to `term 10` with `then accept`\\n- `match protocol bgp` is the equivalent of `from protocol bgp`\", 'trans_template': 'route-map policy1 permit 10'}, {'para_map': [], 'trans_command': 'match protocol bgp', 'parent_command': ['route-map policy1 permit 10'], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- In Cisco, `route-map` is used instead of `policy-statement`\\n- `permit 10` corresponds to `term 10` with `then accept`\\n- `match protocol bgp` is the equivalent of `from protocol bgp`\", 'trans_template': 'match protocol bgp'}]]": 1,
