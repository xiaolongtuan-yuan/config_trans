["hostname DeviceA", "set system host-name DeviceA"]
["interface GigabitEthernet0/0", "set interfaces ge-0/0/0 unit 0 disable"]
["interface GigabitEthernet0/0", "set interfaces ge-0/0/0 disable"]
["no shutdown", "interfaces ge-0/0/0"]
["ip address 10.1.1.1 255.255.255.0", "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/24"]
["interface Loopback1", "set interfaces lo0.1 unit 0 disable"]
["interface Loopback1", "set interfaces lo0.1 disable"]
["ip address 1.1.1.1 255.255.255.255", "set interfaces lo0.1 unit 0 family inet address 1.1.1.1/32"]
["router ospf 1", "set protocols ospf area 0.0.0.1 interface 1"]
["network 1.1.1.1 0.0.0.0 area 0", "set protocols ospf area 0 interface ge-0/0/1.0"]
["network 10.1.1.0 0.0.0.255 area 0", "set protocols ospf area 0 interface ge-0/0/1.0"]
["end", "set protocols isis export REDIST-CONNECTED"]
