["hostname CE1", "set system host-name CE1"]
["interface GigabitEthernet1/0/0", "set interfaces ge-1/0/0 unit 0 disable"]
["interface GigabitEthernet1/0/0", "set interfaces ge-1/0/0 disable"]
["no shutdown", "interfaces ge-1/0/0.0"]
["no shutdown", "interfaces ge-2/0/0.0"]
["ip address 10.1.1.1 255.255.255.0", "set interfaces ge-1/0/0 unit 0 family inet address 10.1.1.1/24"]
["bfd interval 100 min_rx 100 multiplier 3", "set interfaces ge-1/0/0 unit 100 family inet bfd interval 100 min_rx 100 multiplier 3"]
["bfd interval 100 min_rx 100 multiplier 3", "set interfaces ge-1/0/0 aggregated-ether-options minimum-links 100"]
["bfd interval 100 min_rx 100 multiplier 3", "set interfaces ge-1/0/0 unit 3 tunnel multipoint"]
["bfd neighbor 10.1.1.2", "set interfaces ge-1/0/0 unit 0 tunnel source-address 10.1.1.2"]
["interface GigabitEthernet2/0/0", "set interfaces ge-2/0/0 unit 0 disable"]
["interface GigabitEthernet2/0/0", "set interfaces ge-2/0/0 disable"]
["ip address 10.2.1.1 255.255.255.0", "set interfaces ge-2/0/0 unit 0 family inet address 10.2.1.1/24"]
