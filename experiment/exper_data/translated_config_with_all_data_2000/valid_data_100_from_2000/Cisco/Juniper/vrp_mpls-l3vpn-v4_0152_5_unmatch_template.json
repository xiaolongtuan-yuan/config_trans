{
  "rule_source": [
    "interface [parameter1]",
    "no shutdown",
    "address-family ipv4 unicast",
    "no synchronization",
    "redistribute connected",
    "neighbor [parameter1] activate",
    "end"
  ],
  "llm_source": [
    "address-family [parameter1] [parameter2]",
    "no synchronization",
    "redistribute connected"
  ],
  "target": [
    "set protocols bgp group [parameter1] peer-as [parameter2]",
    "set protocols bgp group [parameter1] neighbor [parameter2]",
    "set protocols bgp group [parameter1] family [parameter2] [parameter3]",
    "set policy-options policy-statement [parameter1] term [parameter2] from protocol [parameter3]",
    "set policy-options policy-statement [policy_statement_name] term [term_number] then [action]"
  ]
}