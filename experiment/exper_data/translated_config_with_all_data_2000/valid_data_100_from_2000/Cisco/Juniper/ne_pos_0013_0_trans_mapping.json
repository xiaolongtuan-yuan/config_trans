["hostname DeviceA", "set system host-name DeviceA"]
["interface Serial1/0/0", "set interfaces se-1/0/0 unit 0 disable"]
["interface Serial1/0/0", "set interfaces se-1/0/0 disable"]
["no shutdown", "interfaces se-1/0/0.0"]
["physical-layer sync", "set interfaces se-1/0/0 mtu 1500"]
["encapsulation ppp", "set interfaces se-1/0/0 set interfaces se-1/0/0 encapsulation ppp"]
["ip address 10.1.1.1 255.255.255.252", "set interfaces se-1/0/0 unit 0 family inet address 10.1.1.1/30"]
["clock rate 2000000", "set interfaces se-1/0/0 unit 0 tunnel ttl 255"]
["end", "set protocols isis export REDIST-CONNECTED"]
