    "['set policy-options policy-statement [parameter1]', [{'para_map': [], 'trans_command': 'route-map policy1 permit 10', 'parent_command': [], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- Juniper's `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- `from protocol bgp` becomes `match protocol bgp`\\n- `then accept` is implied by the `permit` action in the route-map statement\\n- The sequence numbers (10) are maintained in both configurations\", 'trans_template': 'route-map policy1 permit 10'}, {'para_map': [], 'trans_command': 'match protocol bgp', 'parent_command': [], 'root': 'match protocol bgp', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- Juniper's `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- `from protocol bgp` becomes `match protocol bgp`\\n- `then accept` is implied by the `permit` action in the route-map statement\\n- The sequence numbers (10) are maintained in both configurations\", 'trans_template': 'match protocol bgp'}]]": 1,
    "['term [parameter2] from protocol [parameter3]', [{'para_map': [], 'trans_command': 'route-map policy1 permit 10', 'parent_command': ['route-map policy1 permit 10'], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': 'Here\\'s the translated Cisco equivalent command:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nThis Cisco configuration:\\n1. Creates a route-map named \"policy1\" with sequence number 10 (equivalent to Juniper\\'s term 10)\\n2. Sets the action to permit (equivalent to Juniper\\'s \"accept\")\\n3. Matches BGP routes (equivalent to Juniper\\'s \"from protocol bgp\")\\n4. The implicit \"permit\" action in Juniper\\'s term is made explicit in Cisco with \"permit\"', 'trans_template': 'route-map policy1 permit 10'}, {'para_map': [], 'trans_command': 'match protocol bgp', 'parent_command': ['route-map policy1 permit 10'], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': 'Here\\'s the translated Cisco equivalent command:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nThis Cisco configuration:\\n1. Creates a route-map named \"policy1\" with sequence number 10 (equivalent to Juniper\\'s term 10)\\n2. Sets the action to permit (equivalent to Juniper\\'s \"accept\")\\n3. Matches BGP routes (equivalent to Juniper\\'s \"from protocol bgp\")\\n4. The implicit \"permit\" action in Juniper\\'s term is made explicit in Cisco with \"permit\"', 'trans_template': 'match protocol bgp'}]]": 1,
