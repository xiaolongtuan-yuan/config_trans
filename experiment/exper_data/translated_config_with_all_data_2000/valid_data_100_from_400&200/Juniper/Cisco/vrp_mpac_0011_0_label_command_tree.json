{
    "hostname DeviceA": {
        "template": "hostname [parameter1]",
        "command": "hostname DeviceA",
        "explanation": "Sets the device's host name 'DeviceA'",
        "parameters": [
            {
                "name": "host name",
                "type": "string",
                "explanation": "Host Name"
            }
        ]
    },
    "ip access-list extended test": {
        "template": "ip access-list extended [parameter1]",
        "command": "ip access-list extended test",
        "explanation": "Create an extended access control list called 'test '",
        "parameters": [
            {
                "name": "access-list name",
                "type": "string",
                "explanation": "Access Control List Name"
            }
        ],
        "deny ip host 10.10.1.1 any": {
            "template": "deny ip host [parameter1] any",
            "command": "deny ip host 10.10.1.1 any",
            "explanation": "Deny IP traffic from a specific host to any destination",
            "parameters": [
                {
                    "name": "source host IP",
                    "type": "string",
                    "explanation": "The IP address of the source host from which traffic is denied"
                }
            ]
        }
    },
    "interface GigabitEthernet1/0/0": {
        "template": "interface [parameter1]",
        "command": "interface GigabitEthernet1/0/0",
        "explanation": "Configure interface 'GigabitEthernet1/0/0'",
        "parameters": [
            {
                "name": "interface name",
                "type": "string",
                "explanation": "Interface Name"
            }
        ],
        "no shutdown": {
            "template": "no shutdown",
            "command": "no shutdown",
            "explanation": "Enable interface (the interface is closed by default)",
            "parameters": []
        },
        "ip address 10.10.1.2 255.255.255.0": {
            "template": "ip address [parameter1] [parameter2]",
            "command": "ip address 10.10.1.2 255.255.255.0",
            "explanation": "The IPv4 address for the configuration interface is 10.10.1.2 and the subnet mask is 255.255.255.0",
            "parameters": [
                {
                    "name": "ip address",
                    "type": "IPv4",
                    "explanation": "IPv4 Address"
                },
                {
                    "name": "subnet mask",
                    "type": "IPv4",
                    "explanation": "Subnet mask"
                }
            ]
        },
        "ip access-group test in": {
            "template": "ip access-group [parameter1] [parameter2]",
            "command": "ip access-group test in",
            "explanation": "Apply access control list 'test 'to the entry direction of the interface",
            "parameters": [
                {
                    "name": "access-list name",
                    "type": "string",
                    "explanation": "Access Control List Name"
                },
                {
                    "name": "direction",
                    "type": "string",
                    "explanation": "Apply direction, 'in' for entry direction"
                }
            ]
        }
    }
}