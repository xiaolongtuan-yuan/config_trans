{
    "source_cmds": [
        {
            "id": "s1",
            "text": "set system host-name SSH-Server",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "set interfaces ge-0/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s3",
            "text": "set interfaces ge-0/0/0 unit 0 family inet address 10.1.1.1/16",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s4",
            "text": "set system services ssh",
            "description": "",
            "type": "rule"
        },
        {
