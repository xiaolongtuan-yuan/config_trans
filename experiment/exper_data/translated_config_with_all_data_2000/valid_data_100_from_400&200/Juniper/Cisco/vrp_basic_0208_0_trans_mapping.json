            "description": "",
            "type": "rule"
        },
        {
            "id": "s12",
            "text": "set system login user client001 authentication ssh-rsa \"ssh-rsa AAAAB3...\" # Optional: Add SSH public key",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "set system login user client002",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "set system login user client002 class operator",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "set system login user client002 authentication encrypted-password \"$XYZ456\" # Replace with encrypted password",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s16",
            "text": "set security zones security-zone untrust",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s17",
            "text": "set security zones security-zone untrust interfaces ge-0/0/0.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s18",
            "text": "set security zones security-zone untrust host-inbound-traffic system-services ssh",
            "description": "",
            "type": "rule"
        }
