    "['mpls static-l2vc pw-template [parameter1] [parameter2] transmit-vpn-label [parameter3] receive-vpn-label [parameter4]', [{'para_map': [0, 1], 'trans_command': 'unit [unit_number] tunnel protocol [protocol]', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}, {'para_map': [1, 0], 'trans_command': 'unit [parameter2] family [parameter3] [parameter4] [parameter5]', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}, {'para_map': [2, 0], 'trans_command': 'description [parameter2]', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}, {'para_map': [3, 0], 'trans_command': 'description [parameter2]', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}]]": 1,
