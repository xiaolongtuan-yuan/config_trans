    "['nhrp enable', [{'para_map': [], 'trans_command': 'unit [parameter2] family inet address [parameter3]/[parameter4] vrrp-group [parameter5] virtual-address [parameter6]', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}]]": 2,
