            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "ssh user client001",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "ssh user client001 authentication-type password",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s16",
            "text": "ssh user client001 sftp-directory home:/",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s17",
            "text": "return",
            "description": "",
            "type": "rule"
        }
