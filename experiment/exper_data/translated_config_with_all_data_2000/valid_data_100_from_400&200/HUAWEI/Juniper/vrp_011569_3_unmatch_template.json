{
  "rule_source": [
    "cfm enable",
    "interface [parameter1]",
    "portswitch",
    "undo shutdown",
    "cfm md [parameter1] level [parameter2]",
    "ma [parameter1]",
    "map vlan [parameter1]",
    "mep mep-id [parameter1] interface [parameter2] [parameter3]",
    "mep ccm-send mep-id [parameter1] enable",
    "remote-mep mep-id [parameter1]",
    "remote-mep ccm-receive mep-id [parameter1] enable",
    "return"
  ],
  "llm_source": [
    "cfm enable",
    "map vlan [parameter1]",
    "mep ccm-send mep-id [parameter1] [parameter2]",
    "remote-mep mep-id [parameter1]",
    "remote-mep ccm-receive mep-id [parameter1] [parameter2]"
  ],
  "target": [
    "set interfaces [parameter1] unit [parameter2] family ethernet-switching interface-mode [parameter3]"
  ]
}