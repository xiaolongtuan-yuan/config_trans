    "['sysname [parameter1]', [{'para_map': [0, 0], 'trans_command': 'hostname [parameter1]', 'parent_command': [], 'root': 'hostname [parameter1]'}]]": 1,
    "['mpls lsr-id [parameter1]', [{'para_map': [0, 0], 'trans_command': 'ethernet cfm ma [parameter1] md [parameter2]', 'parent_command': [], 'root': 'ethernet cfm ma [parameter1] md [parameter2]'}]]": 1,
    "['[parameter1]', [{'para_map': [], 'trans_command': 'mpls ip', 'parent_command': [], 'root': 'interface [parameter1]', 'source': 'llm', 'origin_reponse': \"The equivalent Cisco command for `mpls` in the interface configuration context is `mpls ip`. \\n\\nHere's the translation:\\n##\\nmpls ip\\n##\\n\\nNote: In Cisco, `mpls ip` enables MPLS forwarding on the interface, whereas Huawei's `mpls` command (without additional parameters in this context) achieves the same basic function. The Cisco command must be accompanied by global MPLS configuration (`mpls label protocol` and `mpls ldp router-id` if using LDP).\", 'trans_template': 'mpls ip'}]]": 1,
    "['mpls te', [{'para_map': [], 'trans_command': 'mpls traffic-eng tunnels', 'parent_command': [], 'root': 'interface [parameter1]', 'source': 'llm', 'origin_reponse': '##\\nmpls traffic-eng tunnels\\n##\\n\\nThe `mpls te` command in Huawei enables MPLS Traffic Engineering (TE) globally. The equivalent command in Cisco IOS is `mpls traffic-eng tunnels`, which similarly enables MPLS TE functionality on the router.', 'trans_template': 'mpls traffic-eng tunnels'}]]": 1,
    "['mpls l2vpn', [{'para_map': [], 'trans_command': 'mpls ldp remote-peer [parameter1] [parameter2]', 'parent_command': [], 'root': 'mpls ldp remote-peer [parameter1] [parameter2]'}]]": 1,
    "['bidirectional static-cr-lsp ingress [parameter1]', [{'para_map': [], 'trans_command': 'interface Tunnel10', 'parent_command': [], 'root': 'interface Tunnel10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for the HUAWEI `bidirectional static-cr-lsp ingress Tunnel10` configuration:\\n\\n##\\ninterface Tunnel10\\n mpls traffic-eng bidirectional static-cr-lsp\\n##\\n\\nNote: Cisco's implementation of bidirectional static LSPs is slightly different. The command activates the bidirectional functionality on the tunnel interface, but additional configuration would be needed for the forward and backward path labels (equivalent to the HUAWEI's `forward nexthop` and `backward in-label` statements), which would typically be configured under the tunnel interface or via MPLS TE maps in Cisco.\", 'trans_template': 'interface Tunnel10'}, {'para_map': [], 'trans_command': 'mpls traffic-eng bidirectional static-cr-lsp', 'parent_command': [], 'root': 'mpls traffic-eng bidirectional static-cr-lsp', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for the HUAWEI `bidirectional static-cr-lsp ingress Tunnel10` configuration:\\n\\n##\\ninterface Tunnel10\\n mpls traffic-eng bidirectional static-cr-lsp\\n##\\n\\nNote: Cisco's implementation of bidirectional static LSPs is slightly different. The command activates the bidirectional functionality on the tunnel interface, but additional configuration would be needed for the forward and backward path labels (equivalent to the HUAWEI's `forward nexthop` and `backward in-label` statements), which would typically be configured under the tunnel interface or via MPLS TE maps in Cisco.\", 'trans_template': 'mpls traffic-eng bidirectional static-cr-lsp'}]]": 1,
    "['forward nexthop [parameter1] out-label [parameter2]', [{'para_map': [0, 0], 'trans_command': 'tunnel destination [parameter1]', 'parent_command': [], 'root': 'tunnel destination [parameter1]'}, {'para_map': [1, 0], 'trans_command': 'mpls traffic-eng tunnel [parameter1]', 'parent_command': [], 'root': 'mpls traffic-eng tunnel [parameter1]'}]]": 1,
    "['backward in-label [parameter1]', [{'para_map': [], 'trans_command': 'mpls traffic-eng static bidirectional explicit-path name Tunnel10 in-label 20', 'parent_command': ['interface Tunnel10'], 'root': 'interface Tunnel10', 'source': 'llm', 'origin_reponse': \"##\\nmpls traffic-eng static bidirectional explicit-path name Tunnel10 in-label 20\\n##\\n\\nExplanation:\\nThe Huawei command `backward in-label 20` configures the incoming MPLS label for the reverse path of a bidirectional static CR-LSP (Constraint-based Routed Label Switched Path). In Cisco, the equivalent functionality is achieved using the `mpls traffic-eng static bidirectional` command with the `in-label` parameter under the explicit path configuration.\\n\\nThe Cisco command specifies:\\n- `mpls traffic-eng static` - indicates static MPLS TE configuration\\n- `bidirectional` - specifies this is a bidirectional LSP\\n- `explicit-path name Tunnel10` - associates this with the named tunnel\\n- `in-label 20` - sets the incoming label for the reverse path, matching Huawei's configuration\", 'trans_template': 'mpls traffic-eng static bidirectional explicit-path name Tunnel10 in-label 20'}]]": 1,
    "['pw-template [parameter1]', [{'para_map': [], 'trans_command': 'l2vpn pw-class tpatoc', 'parent_command': [], 'root': 'l2vpn pw-class tpatoc', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for `pw-template tpatoc`:\\n\\n##\\nl2vpn pw-class tpatoc\\n##\\n\\nThe `pw-template` in Huawei is roughly equivalent to `pw-class` in Cisco's L2VPN configuration. Both are used to define pseudowire templates for Layer 2 VPN services.\", 'trans_template': 'l2vpn pw-class tpatoc'}]]": 1,
    "['peer-address [parameter1]', [{'para_map': [], 'trans_command': 'neighbor 3.3.3.3', 'parent_command': ['l2vpn pw-class tpatoc'], 'root': 'l2vpn pw-class tpatoc', 'source': 'llm', 'origin_reponse': \"Here is the equivalent Cisco command for the HUAWEI `peer-address 3.3.3.3` configuration:\\n\\n##\\nneighbor 3.3.3.3\\n##\\n\\nIn Cisco's L2VPN or MPLS pseudowire context, the `neighbor` command is used to specify the peer router's IP address, which is analogous to HUAWEI's `peer-address` command.\", 'trans_template': 'neighbor 3.3.3.3'}]]": 1,
    "['[parameter1]', [{'para_map': [], 'trans_command': 'control-word', 'parent_command': [], 'root': 'pseudowire-class [parameter1]', 'source': 'llm', 'origin_reponse': \"Here is the translated Cisco equivalent for the `control-word` command:\\n\\n##\\ncontrol-word\\n##\\n\\nIn Cisco devices, the `control-word` command is used in the same way under L2VPN pseudowire configurations to enable the control word (CW) for sequencing and fragmentation handling, just like in Huawei's configuration. The command syntax remains identical between the two vendors in this case.\", 'trans_template': 'control-word'}]]": 1,
    "['tnl-policy [parameter1]', [{'para_map': [], 'trans_command': 'l2vpn xconnect context tpatoc', 'parent_command': ['l2vpn pw-class tpatoc'], 'root': 'l2vpn pw-class tpatoc', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco command for `tnl-policy tpatoc`:\\n\\n##\\nl2vpn xconnect context tpatoc\\n##\\n\\nNote: In Cisco, the tunnel policy concept is typically implemented within the L2VPN cross-connect context configuration. The `tpatoc` would be the name of the cross-connect context that references the tunnel policy. The exact tunnel binding would be configured within this context using commands like `member pseudowire` or `member mpls`.\", 'trans_template': 'l2vpn xconnect context tpatoc'}]]": 1,
