    "['ipv6 prefix [parameter1] local', [{'para_map': [0, 0], 'trans_command': 'ipv6 prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]', 'parent_command': [], 'root': 'ipv6 prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]'}]]": 1,
    "['prefix [parameter1]', [{'para_map': [], 'trans_command': 'ipv6 local pool pre1 2010:2021::/64', 'parent_command': ['ipv6 prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]'], 'root': 'ipv6 prefix-list [parameter1] seq [parameter2] [parameter3] [parameter4]', 'source': 'llm', 'origin_reponse': '##\\nipv6 local pool pre1 2010:2021::/64\\n##\\n\\nExplanation:\\nThe Huawei command `prefix 2010:2021::/64` defines an IPv6 prefix pool named \"pre1\" with the specified prefix. The equivalent Cisco command creates a local IPv6 prefix pool with the same name and prefix specification. Note that Cisco requires explicit declaration of the pool type (\"local\") in the command.', 'trans_template': 'ipv6 local pool pre1 2010:2021::/64'}]]": 1,
