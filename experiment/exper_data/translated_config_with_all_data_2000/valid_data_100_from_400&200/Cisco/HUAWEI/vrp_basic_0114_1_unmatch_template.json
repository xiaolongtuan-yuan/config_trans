{
  "rule_source": [
    "ip domain-name [parameter1]",
    "crypto key generate rsa",
    "ip ssh version [parameter1]",
    "line vty [parameter1] [parameter2]",
    "transport input ssh"
  ],
  "llm_source": [
    "ip domain-name [parameter1]",
    "crypto key generate rsa"
  ],
  "target": [
    "ip domain [parameter1]",
    "rsa local-key-pair create",
    "ssh server enable",
    "ssh authentication-type default [parameter1]",
    "user-interface vty [parameter1] [parameter2]",
    "protocol inbound [parameter1]"
  ]
}