    "['interface [parameter1]', [{'para_map': [0, 0], 'trans_command': 'set interfaces [parameter1]', 'parent_command': [], 'root': 'set interfaces [parameter1]'}, {'para_map': [], 'trans_command': 'unit [parameter2] disable', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}, {'para_map': [], 'trans_command': 'disable', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]'}]]": 1,
    "['clock source [parameter1]', [{'para_map': [], 'trans_command': 'set protocols ptp interface <interface-name> clock-type boundary', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]', 'source': 'llm', 'origin_reponse': '##\\nset protocols ptp interface <interface-name> clock-type boundary\\n##\\n\\nNote: \\n1. In Juniper, the equivalent would be setting the interface as a boundary clock under PTP configuration, as Juniper doesn\\'t have a direct \"clock source ptp\" command like Cisco.\\n2. Replace `<interface-name>` with the actual interface name (e.g., ge-0/0/0).\\n3. The boundary clock configuration in Juniper implicitly handles the synchronization hierarchy, similar to Cisco\\'s \"clock source ptp\".', 'trans_template': 'set protocols ptp interface <interface-name> clock-type boundary'}]]": 1,
    "['ptp mode [parameter1]', [{'para_map': [], 'trans_command': 'set protocols ptp clock-mode boundary', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Juniper configuration command for `ptp mode boundary`:\\n\\n##\\nset protocols ptp clock-mode boundary\\n##\\n\\nThis command configures the PTP (Precision Time Protocol) clock to operate in boundary clock mode on a Juniper device, which is the equivalent functionality to Cisco's `ptp mode boundary` interface configuration command.\", 'trans_template': 'set protocols ptp clock-mode boundary'}]]": 1,
    "['ptp clock domain [parameter1]', [{'para_map': [], 'trans_command': 'set protocols ptp clock-mode boundary clock domain 255', 'parent_command': ['set interfaces [parameter1]'], 'root': 'set interfaces [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the Juniper equivalent of the Cisco `ptp clock domain 255` command:\\n\\n##\\nset protocols ptp clock-mode boundary clock domain 255\\n##\\n\\nNote: \\n1. Juniper combines the PTP mode (boundary) with the domain configuration in a single command\\n2. The domain number (255) remains the same as in the Cisco configuration\\n3. This assumes the Juniper device is configured as a boundary clock, matching the Cisco configuration's boundary clock mode\", 'trans_template': 'set protocols ptp clock-mode boundary clock domain 255'}]]": 1,
