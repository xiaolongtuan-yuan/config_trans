    "source_cmds": [
        {
            "id": "s1",
            "text": "hostname HUAWEI",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "ip nat pool inside-pool 10.0.0.1 10.0.0.254 netmask 255.255.255.0",
