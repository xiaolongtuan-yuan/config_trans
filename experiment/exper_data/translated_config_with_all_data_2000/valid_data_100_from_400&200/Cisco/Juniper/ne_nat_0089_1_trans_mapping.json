        },
        {
            "id": "s12",
            "text": "no shutdown",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "service-policy input NAT-POLICY",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "ip nat inside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "interface GigabitEthernet2/0/1",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s16",
            "text": "ip address 11.11.11.2 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s17",
            "text": "ip nat outside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s18",
            "text": "end",
            "description": "",
            "type": "rule"
        }
