    "['radius-server host [parameter1] auth-port [parameter2] acct-port [parameter3]', [{'para_map': [], 'trans_command': 'set system radius-server 10.20.20.1 auth-port 1812 acct-port 1813', 'parent_command': [], 'root': 'set system radius-server 10.20.20.1 auth-port 1812 acct-port 1813', 'source': 'llm', 'origin_reponse': 'Here\\'s the Juniper equivalent of the Cisco RADIUS server configuration command:\\n\\n##\\nset system radius-server 10.20.20.1 auth-port 1812 acct-port 1813\\n##\\n\\nNote: In Juniper, the shared secret/key would be configured separately with:\\n`set system radius-server 10.20.20.1 secret \"<key>\"` (not shown in the ## markers as it wasn\\'t part of the specific command you asked to translate).', 'trans_template': 'set system radius-server 10.20.20.1 auth-port 1812 acct-port 1813'}]]": 1,
