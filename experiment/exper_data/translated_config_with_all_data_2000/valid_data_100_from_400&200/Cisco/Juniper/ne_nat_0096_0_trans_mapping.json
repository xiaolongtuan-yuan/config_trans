{
    "source_cmds": [
        {
            "id": "s1",
            "text": "hostname NATA",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "ip nat inside source list NAT_ACL interface GigabitEthernet1/0/1 overload",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s3",
            "text": "interface GigabitEthernet1/0/1",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s4",
            "text": "no shutdown",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s5",
            "text": "ip address 192.168.10.1 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s6",
            "text": "ip nat inside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s7",
            "text": "interface GigabitEthernet1/0/2",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s8",
            "text": "ip address 2.2.2.1 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s9",
            "text": "ip nat outside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s10",
            "text": "ip route 0.0.0.0 0.0.0.0 2.2.2.2",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s11",
            "text": "access-list 100 permit ip any any",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s12",
            "text": "route-map POLICY1 permit 10",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "match ip address 100",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "set ip next-hop 1.1.1.100",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "router ospf 1",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s16",
            "text": "network 2.2.2.0 0.0.0.255 area 0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s17",
            "text": "end",
            "description": "",
            "type": "rule"
        }
