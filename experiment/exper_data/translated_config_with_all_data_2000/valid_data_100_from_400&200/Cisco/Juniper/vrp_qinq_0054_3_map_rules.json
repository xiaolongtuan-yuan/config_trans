    "['address-family [parameter1] [parameter2]', [{'para_map': [], 'trans_command': 'family inet unicast', 'parent_command': [], 'root': 'set protocols bgp group [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Juniper configuration command for the Cisco `address-family ipv4 unicast` statement:\\n\\n##\\nfamily inet unicast\\n##\\n\\nThis command would be used within a BGP configuration context in Juniper, similar to how it's used in the address-family section of Cisco's BGP configuration.\", 'trans_template': 'family inet unicast'}]]": 1,
    "['no synchronization', [{'para_map': [], 'trans_command': 'set protocols bgp group <group_name> no-synchronize', 'parent_command': ['family inet unicast'], 'root': 'set protocols bgp group [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the Juniper equivalent of the Cisco `no synchronization` BGP command:\\n\\n##\\nset protocols bgp group <group_name> no-synchronize\\n##\\n\\nNote: You'll need to replace `<group_name>` with the appropriate BGP group name in your Juniper configuration. The command disables BGP synchronization, similar to Cisco's `no synchronization` command.\", 'trans_template': 'set protocols bgp group <group_name> no-synchronize'}]]": 1,
    "['redistribute [parameter1]', [{'para_map': [], 'trans_command': 'set policy-options policy-statement EXPORT-CONNECTED term 1 from protocol direct', 'parent_command': ['family inet unicast'], 'root': 'set protocols bgp group [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the translated Juniper equivalent command for `redistribute connected`:\\n\\n##\\nset policy-options policy-statement EXPORT-CONNECTED term 1 from protocol direct\\nset policy-options policy-statement EXPORT-CONNECTED then accept\\nset protocols bgp group <group-name> export EXPORT-CONNECTED\\n##\\n\\nNote:\\n1. In Juniper, you need to create a policy to redistribute connected routes (protocol direct)\\n2. The actual group name in the BGP configuration would need to match your Juniper BGP configuration\\n3. This creates a policy that matches directly connected routes and exports them to BGP\", 'trans_template': 'set policy-options policy-statement EXPORT-CONNECTED term 1 from protocol direct'}, {'para_map': [], 'trans_command': 'set policy-options policy-statement EXPORT-CONNECTED then accept', 'parent_command': ['family inet unicast'], 'root': 'set protocols bgp group [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the translated Juniper equivalent command for `redistribute connected`:\\n\\n##\\nset policy-options policy-statement EXPORT-CONNECTED term 1 from protocol direct\\nset policy-options policy-statement EXPORT-CONNECTED then accept\\nset protocols bgp group <group-name> export EXPORT-CONNECTED\\n##\\n\\nNote:\\n1. In Juniper, you need to create a policy to redistribute connected routes (protocol direct)\\n2. The actual group name in the BGP configuration would need to match your Juniper BGP configuration\\n3. This creates a policy that matches directly connected routes and exports them to BGP\", 'trans_template': 'set policy-options policy-statement EXPORT-CONNECTED then accept'}, {'para_map': [], 'trans_command': 'set protocols bgp group <group-name> export EXPORT-CONNECTED', 'parent_command': ['family inet unicast'], 'root': 'set protocols bgp group [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the translated Juniper equivalent command for `redistribute connected`:\\n\\n##\\nset policy-options policy-statement EXPORT-CONNECTED term 1 from protocol direct\\nset policy-options policy-statement EXPORT-CONNECTED then accept\\nset protocols bgp group <group-name> export EXPORT-CONNECTED\\n##\\n\\nNote:\\n1. In Juniper, you need to create a policy to redistribute connected routes (protocol direct)\\n2. The actual group name in the BGP configuration would need to match your Juniper BGP configuration\\n3. This creates a policy that matches directly connected routes and exports them to BGP\", 'trans_template': 'set protocols bgp group <group-name> export EXPORT-CONNECTED'}]]": 1,
