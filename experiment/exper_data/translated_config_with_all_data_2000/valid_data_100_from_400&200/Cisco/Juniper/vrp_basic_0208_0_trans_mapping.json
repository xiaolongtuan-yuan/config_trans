{
    "source_cmds": [
        {
            "id": "s1",
            "text": "hostname SSH_Server",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "interface GigabitEthernet0/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s3",
            "text": "no shutdown",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s4",
            "text": "ip address 10.1.1.1 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s5",
            "text": "crypto key generate rsa general-keys modulus 2048",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s6",
            "text": "username client001 privilege 3 secret 0 @%@%UyQs4,KTtSwJo(4QmW#K,LC:@%@%",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s7",
            "text": "username client002 privilege 3 secret 0 <password_for_client002>",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s8",
            "text": "ip ssh version 2",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s9",
            "text": "ip ssh source-interface GigabitEthernet0/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s10",
            "text": "line vty 0 4",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s11",
            "text": "transport input ssh",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s12",
            "text": "privilege level 3",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "login local",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "end",
            "description": "",
            "type": "rule"
        }
    ],
