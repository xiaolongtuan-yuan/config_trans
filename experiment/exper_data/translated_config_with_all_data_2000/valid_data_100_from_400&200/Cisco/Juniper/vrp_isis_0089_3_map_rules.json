    "['address-family [parameter1]', [{'para_map': [0, 0], 'trans_command': 'set protocols bgp local-as [parameter1]', 'parent_command': [], 'root': 'set protocols bgp local-as [parameter1]'}]]": 1,
    "['multi-topology', [{'para_map': [], 'trans_command': 'set protocols isis address-family inet6 unicast topology inet6', 'parent_command': ['set protocols bgp local-as [parameter1]'], 'root': 'set protocols bgp local-as [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the Juniper equivalent of the Cisco `multi-topology` command for IS-IS IPv6 configuration:\\n\\n##\\nset protocols isis address-family inet6 unicast topology inet6\\n##\\n\\nThis Juniper command enables multi-topology routing for IPv6 in IS-IS, which is equivalent to Cisco's `multi-topology` command under the IS-IS IPv6 address family configuration. The command creates a separate SPF calculation for the IPv6 topology.\", 'trans_template': 'set protocols isis address-family inet6 unicast topology inet6'}]]": 1,
