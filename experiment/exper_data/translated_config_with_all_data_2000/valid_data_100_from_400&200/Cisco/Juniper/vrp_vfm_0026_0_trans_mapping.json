    "source_cmds": [
        {
            "id": "s1",
            "text": "hostname SSH_Server",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "aaa new-model",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s3",
            "text": "username client001 password 0 @%@%.OuC6Vo7Z,A'y~/KB&,vmd@%@%",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s5",
            "text": "interface GigabitEthernet0/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s6",
            "text": "no shutdown",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s7",
            "text": "ip address 10.137.217.223 255.255.0.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s8",
            "text": "interface Loopback0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s9",
            "text": "ip address 10.1.1.1 255.255.255.255",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s10",
            "text": "ip ssh server source-interface Loopback0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s11",
            "text": "ip ssh version 2",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s12",
            "text": "ip scp server enable",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "line vty 0 4",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "login local",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "transport input ssh",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s16",
            "text": "end",
            "description": "",
            "type": "rule"
        }
