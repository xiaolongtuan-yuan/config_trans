            "text": "router ospf 1",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "router-id 2.2.2.9",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "passive-interface Loopback1",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "end",
            "description": "",
            "type": "rule"
        }
