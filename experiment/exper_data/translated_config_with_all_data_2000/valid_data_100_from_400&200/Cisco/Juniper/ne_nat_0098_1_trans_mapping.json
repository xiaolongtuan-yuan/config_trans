{
    "source_cmds": [
        {
            "id": "s1",
            "text": "hostname CGN2",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s2",
            "text": "license boot level ipbasek9",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s3",
            "text": "ip access-list extended NAT_ACL",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s4",
            "text": "permit ip 192.168.10.0 0.0.0.255 any",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s5",
            "text": "ip nat pool pool1 11.11.11.106 11.11.11.110 netmask 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s6",
            "text": "ip nat inside source list NAT_ACL pool pool1 overload",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s7",
            "text": "interface GigabitEthernet2/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s8",
            "text": "no shutdown",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s9",
            "text": "ip address 192.168.10.1 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s10",
            "text": "ip nat inside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s11",
            "text": "interface GigabitEthernet1/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s12",
            "text": "ip address 11.11.11.1 255.255.255.0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s13",
            "text": "ip nat outside",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s14",
            "text": "ip route 0.0.0.0 0.0.0.0 GigabitEthernet1/0/0",
            "description": "",
            "type": "rule"
        },
        {
            "id": "s15",
            "text": "end",
            "description": "",
            "type": "rule"
        }
    ],
