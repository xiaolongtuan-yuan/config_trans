{
  "rule_source": [
    "rsa local-key-pair create",
    "ssh server enable",
    "ssh authentication-type default [parameter1]",
    "user-interface vty [parameter1] [parameter2]",
    "authentication-mode [parameter1]",
    "protocol inbound [parameter1]"
  ],
  "llm_source": [],
