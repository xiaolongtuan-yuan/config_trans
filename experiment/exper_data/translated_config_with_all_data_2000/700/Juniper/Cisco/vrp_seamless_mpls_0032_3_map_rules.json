    "['interface [interface_name] passive', [{'para_map': [], 'trans_command': 'router ospf 1', 'parent_command': ['router ospf 1'], 'root': 'router ospf 1', 'source': 'llm', 'origin_reponse': 'Here\\'s the translated Cisco equivalent command for the Juniper OSPF configuration:\\n\\n##\\nrouter ospf 1\\n passive-interface Loopback0\\n##\\n\\nNote: \\n1. In Cisco, OSPF process IDs are locally significant, so \"1\" is arbitrary here (you would use whatever process ID matches your existing configuration)\\n2. Cisco doesn\\'t use unit numbers in interface names, so \"lo0.1\" becomes simply \"Loopback0\"\\n3. The \"passive\" setting is applied as a separate command under the OSPF process rather than as an interface attribute', 'trans_template': 'router ospf 1'}, {'para_map': [], 'trans_command': 'passive-interface Loopback0', 'parent_command': ['router ospf 1'], 'root': 'router ospf 1', 'source': 'llm', 'origin_reponse': 'Here\\'s the translated Cisco equivalent command for the Juniper OSPF configuration:\\n\\n##\\nrouter ospf 1\\n passive-interface Loopback0\\n##\\n\\nNote: \\n1. In Cisco, OSPF process IDs are locally significant, so \"1\" is arbitrary here (you would use whatever process ID matches your existing configuration)\\n2. Cisco doesn\\'t use unit numbers in interface names, so \"lo0.1\" becomes simply \"Loopback0\"\\n3. The \"passive\" setting is applied as a separate command under the OSPF process rather than as an interface attribute', 'trans_template': 'passive-interface Loopback0'}]]": 1,
    "['interface [interface_name]', [{'para_map': [], 'trans_command': 'interface GigabitEthernet2/0/0', 'parent_command': ['router ospf 1'], 'root': 'router ospf 1', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the specified Juniper commands:\\n\\n##\\ninterface GigabitEthernet2/0/0\\n mpls ip\\n mpls ldp autoconfig\\n ip ospf 1 area 0\\n##\\n\\nExplanation:\\n- The Juniper `mpls interface` command translates to `mpls ip` in Cisco\\n- The Juniper `ldp interface` command translates to `mpls ldp autoconfig` in Cisco (assuming global LDP is already enabled)\\n- The Juniper OSPF area assignment becomes `ip ospf <process-id> area <area>` in Cisco, where I used process ID 1 as it wasn't specified in the Juniper config\", 'trans_template': 'interface GigabitEthernet2/0/0'}, {'para_map': [], 'trans_command': 'mpls ip', 'parent_command': [], 'root': 'interface [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the specified Juniper commands:\\n\\n##\\ninterface GigabitEthernet2/0/0\\n mpls ip\\n mpls ldp autoconfig\\n ip ospf 1 area 0\\n##\\n\\nExplanation:\\n- The Juniper `mpls interface` command translates to `mpls ip` in Cisco\\n- The Juniper `ldp interface` command translates to `mpls ldp autoconfig` in Cisco (assuming global LDP is already enabled)\\n- The Juniper OSPF area assignment becomes `ip ospf <process-id> area <area>` in Cisco, where I used process ID 1 as it wasn't specified in the Juniper config\", 'trans_template': 'mpls ip'}, {'para_map': [], 'trans_command': 'mpls ldp autoconfig', 'parent_command': [], 'root': 'interface [parameter1]', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the specified Juniper commands:\\n\\n##\\ninterface GigabitEthernet2/0/0\\n mpls ip\\n mpls ldp autoconfig\\n ip ospf 1 area 0\\n##\\n\\nExplanation:\\n- The Juniper `mpls interface` command translates to `mpls ip` in Cisco\\n- The Juniper `ldp interface` command translates to `mpls ldp autoconfig` in Cisco (assuming global LDP is already enabled)\\n- The Juniper OSPF area assignment becomes `ip ospf <process-id> area <area>` in Cisco, where I used process ID 1 as it wasn't specified in the Juniper config\", 'trans_template': 'mpls ldp autoconfig'}, {'para_map': [], 'trans_command': 'ip ospf 1 area 0', 'parent_command': ['router ospf 1'], 'root': 'router ospf 1', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco IOS configuration for the specified Juniper commands:\\n\\n##\\ninterface GigabitEthernet2/0/0\\n mpls ip\\n mpls ldp autoconfig\\n ip ospf 1 area 0\\n##\\n\\nExplanation:\\n- The Juniper `mpls interface` command translates to `mpls ip` in Cisco\\n- The Juniper `ldp interface` command translates to `mpls ldp autoconfig` in Cisco (assuming global LDP is already enabled)\\n- The Juniper OSPF area assignment becomes `ip ospf <process-id> area <area>` in Cisco, where I used process ID 1 as it wasn't specified in the Juniper config\", 'trans_template': 'ip ospf 1 area 0'}]]": 1,
    "['set policy-options policy-statement [policy_name]', [{'para_map': [], 'trans_command': 'route-map policy1 permit 10', 'parent_command': [], 'root': 'route-map policy1 permit 10', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco configuration for the given Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- The Juniper `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- The `from protocol bgp` condition becomes `match protocol bgp`\\n- The `then accept` action is implied by the `permit` in the route-map statement\", 'trans_template': 'route-map policy1 permit 10'}, {'para_map': [], 'trans_command': 'match protocol bgp', 'parent_command': [], 'root': 'match protocol bgp', 'source': 'llm', 'origin_reponse': \"Here's the equivalent Cisco configuration for the given Juniper policy statement:\\n\\n##\\nroute-map policy1 permit 10\\n match protocol bgp\\n##\\n\\nExplanation:\\n- The Juniper `policy-statement policy1 term 10` translates to Cisco's `route-map policy1 permit 10`\\n- The `from protocol bgp` condition becomes `match protocol bgp`\\n- The `then accept` action is implied by the `permit` in the route-map statement\", 'trans_template': 'match protocol bgp'}]]": 1,
